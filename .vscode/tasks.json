{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: compile",
      "type": "shell",
      "problemMatcher": "$tsc",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "command": "npm",
      "args": [
        "run",
        "compile"
      ],
      "windows": {
        "command": "npm.cmd"
      }
    },
    {
      "label": "npm: test:unit",
      "type": "shell",
      "problemMatcher": "$tsc",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "command": "npm",
      "args": [
        "run",
        "test:unit"
      ],
      "windows": {
        "command": "npm.cmd"
      }
    },
    {
      "label": "npm: test:vscode",
      "type": "shell",
      "problemMatcher": "$tsc",
      "group": "test",
      "command": "npm",
      "args": [
        "run",
        "test:vscode"
      ],
      "windows": {
        "command": "npm.cmd"
      }
    }
  ]
}
