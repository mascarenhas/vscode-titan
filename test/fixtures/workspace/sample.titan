local strings = import "string"

--[=[ A long comment with [[ nested-looking brackets. ]=]
record Greeting
  const name: string
  marks?: integer
end

union Result
  ok: Greeting
  failed: string
end

local function render(greeting: Greeting): string
  local banner = [==[
Titan
]==]
  local scale: float = 0x1.8p1 + .5
  if greeting.marks is integer then
    return banner .. strings.rep("!", greeting.marks as integer)
  end
  return "Hello, " .. greeting.name
end

function describe(result: Result): string
  case result
  when ok: greeting then
    return render(greeting)
  when failed: message then
    return message
  else
    return "unknown"
  end
end
