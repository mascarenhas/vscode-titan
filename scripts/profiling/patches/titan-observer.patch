diff --git a/titan-compiler/probeprofile.lua b/titan-compiler/probeprofile.lua
new file mode 100644
index 0000000000000000000000000000000000000000..25f7b38548ab98bb98993d7dcec3d716a9c0c46a
--- /dev/null
+++ b/titan-compiler/probeprofile.lua
@@ -0,0 +1,272 @@
+-- EXPERIMENTAL evidence capture. This module is deliberately outside every
+-- source/cache identity and is enabled only by TITAN_FFI_PROFILE_DIR.
+local M = { enabled = false }
+local directory = os.getenv("TITAN_FFI_PROFILE_DIR")
+local serial, event_sequence = 0, 0
+local stream, clock, failed, closed
+local sources, contexts = {}, {}
+local object_ids = setmetatable({}, { __mode = "k" })
+local wrappers = {}
+local overhead = { wall_ms = 0, process_cpu_ms = 0, bytes = 0 }
+local clock_fields = { "monotonic_ms", "process_cpu_ms", "thread_cpu_ms",
+    "child_user_ms", "child_system_ms" }
+
+local function fail(message)
+    if failed then return end
+    failed = tostring(message)
+    M.enabled = false
+    io.stderr:write("TITAN FFI PROFILE INCOMPLETE: ", failed, "\n")
+    if directory and directory ~= "" then
+        local marker = io.open(directory .. "/INCOMPLETE", "wb")
+        if marker then marker:write(failed, "\n"); marker:close() end
+    end
+end
+
+local function sample()
+    local values = { clock.sample() }
+    local result = {}
+    for index, name in ipairs(clock_fields) do
+        local value = values[index]
+        assert(type(value) == "number", "profile clock lacks " .. name)
+        result[name] = value
+    end
+    return result
+end
+
+local function quote(value)
+    return '"' .. value:gsub('[%z\1-\31\\"]', function(byte)
+        if byte == '"' then return '\\"' end
+        if byte == '\\' then return '\\\\' end
+        return ("\\u%04x"):format(byte:byte())
+    end) .. '"'
+end
+
+local function encode(value, depth, seen)
+    local kind = type(value)
+    if kind == "nil" then return "null" end
+    if kind == "string" then return quote(value) end
+    if kind == "boolean" then return value and "true" or "false" end
+    if kind == "number" then
+        assert(value == value and math.abs(value) ~= math.huge,
+            "profile metadata contains a nonfinite number")
+        return tostring(value)
+    end
+    assert(kind == "table", "profile metadata must be plain data: " .. kind)
+    depth = (depth or 0) + 1
+    assert(depth <= 12, "profile metadata exceeds depth bound")
+    seen = seen or {}
+    assert(not seen[value], "profile metadata contains a cycle")
+    seen[value] = true
+    local count, array = 0, #value > 0
+    for key in pairs(value) do
+        count = count + 1
+        if type(key) ~= "number" or key % 1 ~= 0 or key < 1
+            or key > #value then array = false end
+    end
+    assert(count <= 8192, "profile metadata exceeds table bound")
+    local result = {}
+    if array then
+        for _, item in ipairs(value) do
+            result[#result + 1] = encode(item, depth, seen)
+        end
+    else
+        for key, item in pairs(value) do
+            assert(type(key) == "string", "profile metadata key is not a string")
+            result[#result + 1] = quote(key) .. ":" .. encode(item, depth, seen)
+        end
+    end
+    seen[value] = nil
+    return (array and "[" or "{") .. table.concat(result, ",")
+        .. (array and "]" or "}")
+end
+
+local function capture(operation)
+    if not M.enabled then return end
+    local before = sample()
+    local ok, result = pcall(operation)
+    local after = sample()
+    overhead.wall_ms = overhead.wall_ms + after.monotonic_ms - before.monotonic_ms
+    overhead.process_cpu_ms = overhead.process_cpu_ms
+        + after.process_cpu_ms - before.process_cpu_ms
+    if not ok then fail(result) end
+    return ok and result or nil
+end
+
+function M.id(prefix)
+    if not M.enabled then return nil end
+    serial = serial + 1
+    return (prefix or "id") .. ":" .. serial
+end
+
+function M.object_id(object, prefix)
+    if not M.enabled or type(object) ~= "table" then return nil end
+    local id = object_ids[object]
+    if not id then id = M.id(prefix); object_ids[object] = id end
+    return id
+end
+
+function M.location(loc)
+    if not M.enabled or type(loc) ~= "table" then return nil end
+    return { file = loc.filename or loc.file, line = loc.line,
+        column = loc.col or loc.column }
+end
+
+function M.type_summary(typ, resolved)
+    if not M.enabled or type(typ) ~= "table" then return nil end
+    resolved = resolved or typ
+    return { type_id = M.object_id(typ, "type"), tag = typ._tag,
+        spelling = typ.spelling, name = typ.name,
+        resolved_type_id = M.object_id(resolved, "type"), resolved_tag = resolved._tag,
+        resolved_spelling = resolved.spelling, signed = resolved.signed,
+        bits = resolved.bits, rank = resolved.rank,
+        enum_identity = resolved._c_enum_identity,
+        enumerator = resolved._c_enum_enumerator }
+end
+
+function M.declaration(declaration)
+    if not M.enabled or type(declaration) ~= "table" then return nil end
+    local origin, provenance = declaration.origin_header, declaration.provenance
+    return { origin = origin and (origin.rendered or origin.original),
+        location = M.location(provenance),
+        device = provenance and provenance.device,
+        inode = provenance and provenance.inode,
+        qualifiers = declaration.qualifiers }
+end
+
+function M.wrapper(name, raw)
+    if not M.enabled then return nil end
+    local by_contents = wrappers[name]
+    if by_contents and by_contents[raw] then return by_contents[raw] end
+    local path = "wrappers/" .. M.id("wrapper"):gsub(":", "-") .. ".h"
+    local written = capture(function()
+        local file = assert(io.open(directory .. "/" .. path, "wb"))
+        local ok, err = file:write(raw)
+        local close_ok, close_err = file:close()
+        assert(ok, err); assert(close_ok, close_err)
+        overhead.bytes = overhead.bytes + #raw
+        return true
+    end)
+    if written then
+        if not by_contents then by_contents = {}; wrappers[name] = by_contents end
+        by_contents[raw] = path
+        M.event("wrapper", { name = name, path = path, bytes = #raw })
+        return path
+    end
+end
+
+function M.event(name, fields)
+    if not M.enabled then return end
+    capture(function()
+        local record = {}
+        for key, value in pairs(fields or {}) do record[key] = value end
+        event_sequence = event_sequence + 1
+        record.event, record.sequence, record.schema_version = name, event_sequence, 1
+        record.producer = "compiler"
+        record.sample = sample()
+        local line = encode(record) .. "\n"
+        assert(stream:write(line))
+        overhead.bytes = overhead.bytes + #line
+        if event_sequence % 256 == 0 then assert(stream:flush()) end
+    end)
+end
+
+local span_meta = { __close = function(span, err)
+    if not span.finished and span.on_close then span.on_close(err) end
+    if not span.finished then
+        M.finish(span, { scope_exit = err == nil and "return" or "error",
+            error = err ~= nil and tostring(err) or nil })
+    end
+end }
+
+function M.begin(name, fields)
+    if not M.enabled then return nil end
+    local span = setmetatable({ id = M.id("span"), name = name,
+        start = sample() }, span_meta)
+    span.span_id = span.id
+    local record = { name = name, span_id = span.id, fields = fields }
+    M.event("span_begin", record)
+    return span
+end
+
+function M.finish(span, fields)
+    if not span or span.finished then return end
+    span.finished = true
+    span.on_close = nil
+    if not M.enabled then return end
+    local ending, delta = sample(), {}
+    for _, name in ipairs(clock_fields) do
+        delta[name] = ending[name] - span.start[name]
+    end
+    M.event("span_end", { name = span.name, span_id = span.id,
+        fields = fields, start = span.start, finish = ending, delta = delta })
+end
+
+-- Artifacts use caller-provided identity. Never hash/normalize source here.
+function M.source(key, raw)
+    if not M.enabled then return nil end
+    local path = "sources/" .. key .. ".c"
+    if sources[key] then return path end
+    local written = capture(function()
+        assert(type(key) == "string" and key:match("^[0-9a-f]+$") and #key == 64,
+            "profile source key must be the existing SHA256")
+        local file = assert(io.open(directory .. "/" .. path, "wb"))
+        local ok, err = file:write(raw)
+        local close_ok, close_err = file:close()
+        assert(ok, err); assert(close_ok, close_err)
+        overhead.bytes = overhead.bytes + #raw
+        return true
+    end)
+    if written then
+        sources[key] = true
+        M.event("source", { key = key, path = path, bytes = #raw })
+        return path
+    end
+end
+
+function M.context(id, fields)
+    if not M.enabled or contexts[id] then return end
+    contexts[id] = true
+    M.event("context", { context_id = id, fields = fields })
+end
+
+function M.close(fields)
+    if closed then return end
+    closed = true
+    M.event("profile_end", { fields = fields, overhead = overhead,
+        events_before_end = event_sequence, complete = not failed })
+    if stream then
+        local ok, err = stream:flush()
+        if not ok then fail(err) end
+        ok, err = stream:close()
+        if not ok then fail(err) end
+    end
+    M.enabled = false
+    return not failed, failed
+end
+
+if directory and directory ~= "" then
+    local ok, err = pcall(function()
+        clock = require "probe_profile_clock"
+        sample()
+        local lfs = require "lfs"
+        local function mkdir(path)
+            if lfs.attributes(path, "mode") == "directory" then return end
+            local parent = path:match("^(.*)/[^/]+$")
+            if parent and parent ~= "" then mkdir(parent) end
+            assert(lfs.mkdir(path))
+        end
+        mkdir(directory)
+        assert(not lfs.attributes(directory .. "/events.jsonl"),
+            "profile directory already contains events.jsonl; choose a fresh directory")
+        mkdir(directory .. "/sources")
+        mkdir(directory .. "/wrappers")
+        stream = assert(io.open(directory .. "/events.jsonl", "wb"))
+        assert(stream:setvbuf("full", 65536))
+        M.enabled = true
+        M.event("profile_start", { directory = directory, lua_version = _VERSION,
+            clock = "CLOCK_MONOTONIC/process/thread/rusage_children" })
+    end)
+    if not ok then fail(err) end
+end
+
+return M
diff --git a/titan-compiler/probeprofile_demand.lua b/titan-compiler/probeprofile_demand.lua
new file mode 100644
index 0000000000000000000000000000000000000000..e5af58d9396cb4a5956e3f19ac0037106c7adae9
--- /dev/null
+++ b/titan-compiler/probeprofile_demand.lua
@@ -0,0 +1,119 @@
+-- EXPERIMENTAL post-check observations, not an elimination/compatibility rule.
+-- Walk syntax edges only. Never turn an imported module's complete members or
+-- a C provenance/cache graph into evidence that the source used every member.
+local profile = require "titan-compiler.probeprofile"
+local types = require "titan-compiler.types"
+local M = {}
+
+function M.capture(ast, module_name, fields)
+    if not profile.enabled then return end
+    local span <close> = profile.begin("ffi_demand_observation", {
+        module_name = module_name, parent_span_id = fields and fields.parent_span_id,
+        scope = "syntax roots and selected C signature edges; no reachability claim",
+    })
+    local seen_syntax, seen_types = {}, {}
+    local roots, syntax_nodes, type_nodes = 0, 0, 0
+    local function ctype(typ)
+        return type(typ) == "table" and type(typ._tag) == "string"
+            and typ._tag:match("^Type%.C") and typ._tag ~= "Type.CModule"
+    end
+    local function observe_type(typ)
+        if not ctype(typ) or seen_types[typ] then return end
+        seen_types[typ] = true
+        type_nodes = type_nodes + 1
+        local edges = {}
+        local function edge(role, child, index)
+            if not ctype(child) then return end
+            edges[#edges + 1] = { role = role, index = index,
+                type_id = profile.object_id(child, "type") }
+            observe_type(child)
+        end
+        local tag = typ._tag
+        if tag == "Type.CTypedef" then edge("target", typ.target)
+        elseif tag == "Type.CPointer" or tag == "Type.COwned" then
+            edge("pointee_spelling", typ.pointee)
+        elseif tag == "Type.CArray" then edge("element", typ.elem)
+        elseif tag == "Type.CFunction" then
+            edge("return", typ.ret)
+            for index, param in ipairs(typ.params or {}) do edge("parameter", param, index) end
+        elseif tag == "Type.CField" then
+            edge("selected_field_type", typ.type)
+        end
+        -- Aggregate fields are intentionally excluded here: a pointer's tag
+        -- spelling does not establish demand for every field's full layout.
+        profile.event("demand_type", { module_name = module_name,
+            type = profile.type_summary(typ, types.resolve_c_typedef(typ)),
+            edges = edges, aggregate_fields_traversed = false })
+    end
+    local function root(node, role, typ, member, foreign_module)
+        if not ctype(typ) and not (foreign_module and type(typ) == "table") then return end
+        roots = roots + 1
+        observe_type(typ)
+        profile.event("demand_root", {
+            module_name = module_name, demand_id = profile.id("demand"),
+            ast_tag = node._tag, role = role, name = node.name,
+            written_module = type(node.module) == "string" and node.module or nil,
+            location = profile.location(node.loc),
+            type = profile.type_summary(typ, types.resolve_c_typedef(typ)),
+            member_name = member and member.name,
+            member_module = member and member.modname,
+            member_id = member and profile.object_id(member, "member"),
+            direct_foreign_use = foreign_module ~= nil,
+            foreign_header = foreign_module and foreign_module.name,
+            ordinary_name = foreign_module and node.name,
+            layout_closure = "unknown",
+            parent_span_id = span and span.id,
+        })
+    end
+    local function visit(node)
+        if type(node) ~= "table" or seen_syntax[node] then return end
+        seen_syntax[node] = true
+        local tag = node._tag
+        if tag == nil then
+            for _, child in ipairs(node) do visit(child) end
+            return
+        end
+        if type(tag) ~= "string" or not tag:match("^Ast%.") then return end
+        syntax_nodes = syntax_nodes + 1
+        if tag ~= "Ast.TopLevelImport" and tag ~= "Ast.TopLevelForeignImport" then
+            root(node, "annotated_syntax_type", node._type)
+            local declaration = node._decl
+            if type(declaration) == "table" then
+                local receiver_type = tag == "Ast.VarDot" and node.exp
+                    and node.exp._type
+                local foreign_module = receiver_type
+                    and receiver_type._tag == "Type.CModule" and receiver_type or nil
+                root(node, "resolved_member", declaration.type, declaration, foreign_module)
+            end
+            if tag == "Ast.TypeQualName" then
+                local module_decl = node._module_decl
+                local module_type = module_decl and module_decl._type
+                if module_type and module_type._tag == "Type.CModule" then
+                    -- This is one resolved syntax-selected type namespace slot,
+                    -- including aliases whose selected type is a Titan primitive.
+                    local selected = module_type.type_members and module_type.type_members[node.name]
+                    root(node, "resolved_foreign_type_name", selected, nil, module_type)
+                end
+            end
+            root(node, "direct_c_call", node._c_pointer_call)
+            -- Top-level and local Titan callable annotations have explicit
+            -- parameter/result lists. Record only C entries in that signature.
+            local typ = node._type
+            if type(typ) == "table" and (typ._tag == "Type.Function"
+                    or typ._tag == "Type.Method") then
+                for _, param in ipairs(typ.params or {}) do root(node, "signature_parameter", param) end
+                for _, ret in ipairs(typ.rettypes or {}) do root(node, "signature_return", ret) end
+            end
+        end
+        for name, child in pairs(node) do
+            if type(name) == "string" and name:sub(1, 1) ~= "_" and name ~= "loc" then
+                visit(child)
+            end
+        end
+    end
+    visit(ast)
+    profile.finish(span, { module_name = module_name, syntax_nodes = syntax_nodes,
+        roots = roots, type_nodes = type_nodes, fields = fields })
+end
+
+return M
