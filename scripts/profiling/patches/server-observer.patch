index 9d2b23a70a53ef19fbd057784acafba8d804fdef..9adb8041297205abb3062f62a3c9ead650910bf5 100644
--- a/src/server/compiler_io_clock.c
+++ b/src/server/compiler_io_clock.c
@@ -9,6 +9,9 @@
 
 #endif
 
+#include <sys/resource.h>
+#include <time.h>
+
 #include "compiler_io_clock.h"
 
 double vscode_titan_monotonic_ms(void) {
@@ -27,3 +30,26 @@ double vscode_titan_monotonic_ms(void) {
     return (double)now.tv_sec * 1000.0 + (double)now.tv_nsec / 1000000.0;
 #endif
 }
+
+/* Experimental profile clocks: child counters cover authoritatively reaped
+ * children only. CPU clocks must not be interpreted as elapsed wall time. */
+double vscode_titan_process_cpu_ms(void) {
+    struct timespec now;
+    if (clock_gettime(CLOCK_PROCESS_CPUTIME_ID, &now) != 0) return -1.0;
+    return (double)now.tv_sec * 1000.0 + (double)now.tv_nsec / 1000000.0;
+}
+double vscode_titan_thread_cpu_ms(void) {
+    struct timespec now;
+    if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &now) != 0) return -1.0;
+    return (double)now.tv_sec * 1000.0 + (double)now.tv_nsec / 1000000.0;
+}
+double vscode_titan_child_user_ms(void) {
+    struct rusage usage;
+    if (getrusage(RUSAGE_CHILDREN, &usage) != 0) return -1.0;
+    return (double)usage.ru_utime.tv_sec * 1000.0 + (double)usage.ru_utime.tv_usec / 1000.0;
+}
+double vscode_titan_child_system_ms(void) {
+    struct rusage usage;
+    if (getrusage(RUSAGE_CHILDREN, &usage) != 0) return -1.0;
+    return (double)usage.ru_stime.tv_sec * 1000.0 + (double)usage.ru_stime.tv_usec / 1000.0;
+}
