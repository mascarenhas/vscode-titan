+
+-- Experimental evidence-only spans. Each async Task has its own parent chain;
+-- overlapping Tasks never become each other's children merely by interleaving.
+local record ProfileSample
+  monotonic_ms: float
+  process_cpu_ms: float
+  thread_cpu_ms: float
+  child_user_ms: float
+  child_system_ms: float
+end
+
+record ProfileSpan
+  id: string
+  local name: string
+  local owner: async.Task<value, value>
+  local started: ProfileSample
+  local finished: boolean
+end
+
+local profile_spans: {ProfileSpan} = {}
+local profile_serial = 0
+local profile_sequence = 0
+local profile_overhead_wall_ms = 0.0
+local profile_overhead_cpu_ms = 0.0
+local profile_bytes = 0
+local profile_directory?: string = nil
+local profile_configured = false
+
+function profile_is_enabled(): boolean
+  if not profile_configured then
+    profile_directory = os.getenv("TITAN_FFI_PROFILE_DIR")
+    profile_configured = true
+  end
+  return profile_directory ~= nil and profile_directory ~= ""
+end
+
+local function profile_sample(): ProfileSample
+  return ProfileSample.new(
+    profile_clock.vscode_titan_monotonic_ms(),
+    profile_clock.vscode_titan_process_cpu_ms(),
+    profile_clock.vscode_titan_thread_cpu_ms(),
+    profile_clock.vscode_titan_child_user_ms(),
+    profile_clock.vscode_titan_child_system_ms())
+end
+
+local function profile_sample_fields(sample: ProfileSample): wire.Object
+  return {
+    ["monotonic_ms"] = sample.monotonic_ms,
+    ["process_cpu_ms"] = sample.process_cpu_ms,
+    ["thread_cpu_ms"] = sample.thread_cpu_ms,
+    ["child_user_ms"] = sample.child_user_ms,
+    ["child_system_ms"] = sample.child_system_ms,
+  }
+end
+
+local function profile_write(event: string, fields: wire.Object)
+  local before = profile_sample()
+  do
+    profile_sequence = profile_sequence + 1
+    fields["event"] = event
+    fields["producer"] = "server"
+    fields["schema_version"] = 1
+    fields["sequence"] = profile_sequence
+    fields["sample"] = profile_sample_fields(before)
+    local rendered = "titan-language-server-profile " .. wire.encode(fields)
+    local queue? = output
+    if queue ~= nil then queue:push(rendered) end
+    profile_bytes = profile_bytes + #rendered + 1
+  catch
+    return
+  end
+  local after = profile_sample()
+  profile_overhead_wall_ms = profile_overhead_wall_ms + after.monotonic_ms - before.monotonic_ms
+  profile_overhead_cpu_ms = profile_overhead_cpu_ms + after.process_cpu_ms - before.process_cpu_ms
+end
+
+function profile_begin(name: string, fields: wire.Object?): ProfileSpan?
+  if not profile_is_enabled() then return nil end
+  local owner = async.running()
+  local parent?: string = nil
+  for index = #profile_spans, 1, -1 do
+    local candidate = profile_spans[index]
+    if not candidate.finished and candidate.owner == owner then
+      parent = candidate.id
+      break
+    end
+  end
+  local metadata: wire.Object = {}
+  if parent ~= nil then metadata["parent_span_id"] = parent end
+  if fields ~= nil then
+    for key, item in iteration.pairs<string, value>(fields) do metadata[key] = item end
+  end
+  profile_serial = profile_serial + 1
+  local span = ProfileSpan.new("server-span:" .. strings.tostring(profile_serial),
+    name, owner, profile_sample(), false)
+  profile_spans[#profile_spans + 1] = span
+  profile_write("span_begin", {
+    ["name"] = name, ["span_id"] = span.id, ["fields"] = metadata,
+  })
+  return span
+end
+
+function profile_finish(span: ProfileSpan?, fields: wire.Object?)
+  if span == nil or span.finished then return end
+  local ending = profile_sample()
+  span.finished = true
+  while #profile_spans > 0 and profile_spans[#profile_spans].finished do
+    profile_spans[#profile_spans] = nil
+  end
+  local metadata: wire.Object = {}
+  if fields ~= nil then metadata = fields end
+  local start = span.started
+  profile_write("span_end", {
+    ["name"] = span.name, ["span_id"] = span.id, ["fields"] = metadata,
+    ["start"] = profile_sample_fields(start), ["finish"] = profile_sample_fields(ending),
+    ["delta"] = {
+      ["monotonic_ms"] = ending.monotonic_ms - start.monotonic_ms,
+      ["process_cpu_ms"] = ending.process_cpu_ms - start.process_cpu_ms,
+      ["thread_cpu_ms"] = ending.thread_cpu_ms - start.thread_cpu_ms,
+      ["child_user_ms"] = ending.child_user_ms - start.child_user_ms,
+      ["child_system_ms"] = ending.child_system_ms - start.child_system_ms,
+    } as wire.Object,
+  })
+end
+
+function profile_summary()
+  if not profile_is_enabled() then return end
+  profile_write("profile_summary", {
+    ["spans_started"] = profile_serial, ["active_spans"] = #profile_spans,
+    ["observer_wall_ms"] = profile_overhead_wall_ms,
+    ["observer_process_cpu_ms"] = profile_overhead_cpu_ms,
+    ["observer_bytes"] = profile_bytes,
+    ["observer_excludes"] = "clock sampling and async stderr writer",
+  })
+end
