{
  "comments": {
    "lineComment": "--",
    "blockComment": [
      "--[[",
      "]]"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "<|",
      "|>"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "<|",
      "close": "|>",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "<|",
      "|>"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:local\\s+)?(?:function|record|union|interface)\\s+[A-Za-z_][A-Za-z0-9_]*|function\\s*\\(|foreign\\s+function\\s+[A-Za-z_][A-Za-z0-9_]*|(?:(?:defer\\s+)?(?:if|for|while)|elseif)\\b.*\\b(?:then|do)\\s*(?:--.*)?$|(?:(?:defer\\s+)?(?:do|repeat)|else)\\b\\s*(?:--.*)?$|(?:defer\\s+)?case\\b.*$|when\\b.*\\bthen\\s*(?:--.*)?$|catch\\b\\s*(?:--.*)?$)",
    "decreaseIndentPattern": "^\\s*(?:end|until|elseif|else|when|catch)\\b(?!\\s*[:=])"
  }
}
