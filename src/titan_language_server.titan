--- Native Titan language-server entrypoint over framed stdio with compiler Lua modules loaded externally.
-- @module titan_language_server

local os = import "os"
local io = import "io"
local async = import "async"
local fs = import "fs"
local strings = import "string"
local application = import "server.application"
local bridge = import "server.compiler_bridge"
local diagnostics = import "server.diagnostics"
local dispatcher = import "server.dispatcher"
local lsp = import "server.lsp_types"
local framing = import "server.framing"
local indexing_status = import "server.indexing_status"
local logging = import "server.logging"
local lua_paths = import "server.lua_paths"
local outbound_requests = import "server.outbound_requests"
local protocol = import "server.protocol"
local project_config = import "server.project_config"
local root_settings = import "server.root_settings"
local roots = import "server.roots"
local router = import "server.router"
local source_text = import "server.source_text"
local wire = import "server.wire"
local workspace_cache = import "server.workspace_cache"

local const UNAVAILABLE_DOCUMENT_METHOD = "titan/documentUnavailable"
local const INVALID_PARAMS = -32602

local record Options
  const worker: boolean
  const root: string?
  const compiler_root: string?
  const print_paths: boolean
  const target: string?
end

local function parse_options(args: {string}): Options
  local worker = false
  local root: string?
  local compiler_root: string?
  local print_paths = false
  local target: string?
  local index = 1
  while index <= #args do
    local argument = args[index]
    if argument == "--print-paths" then
      print_paths = true
    elseif argument == "--worker" then
      worker = true
    elseif argument == "--root" then
      index = index + 1
      if index <= #args then root = args[index] end
    elseif argument == "--compiler-root" then
      index = index + 1
      if index <= #args then compiler_root = args[index] end
    elseif argument == "--target" then
      index = index + 1
      target = args[index]
      if target ~= "native" and target ~= "browser" then
        raise "--target must be native or browser"
      end
    end
    index = index + 1
  end
  return Options {
    worker = worker,
    root = root,
    compiler_root = compiler_root,
    print_paths = print_paths,
    target = target,
  }
end

local function absolute_root(candidate: string?): string
  if candidate == nil then return fs.pwd() end
  local resolved?, failure? = source_text.resolve_path(fs.pwd(), candidate)
  if resolved == nil then
    raise "invalid --root path: " .. failure.message
  end
  return resolved
end

-- A worker reports the process identity the router publishes as workerPid,
-- plus the SDK and probe prefix its own environment resolved. The router
-- consumes this notification and never forwards it to the client, so an agent
-- reading titan/workspaceStatus sees each root's observed isolation rather than
-- the router's intention.
local function info_envelope(): wire.Object
  local params: wire.Object = {
    ["pid"] = os.pid(),
    ["titanRoot"] = os.getenv("TITAN_ROOT") or "",
    ["probePrefix"] = os.getenv("TITAN_PREFIX") or "",
  }
  return {
    ["jsonrpc"] = "2.0",
    ["method"] = "titan/workerInfo",
    ["params"] = params,
  }
end

-- The router keeps editor text for replay under the same limits this process
-- applies. When it could not retain a buffer it opens the document here as an
-- unavailable contributor instead of pretending the saved bytes are the buffer.
local function unavailable_document(request: dispatcher.SemanticRequest,
                                   server: application.Application):
    dispatcher.SemanticOutcome
  local params? = wire.as_object(request.params)
  if params == nil then
    return dispatcher.SemanticOutcome.failure(INVALID_PARAMS,
      "params must be an object")
  end
  local document?, document_error? = lsp.parse_document(params)
  if document == nil then
    return dispatcher.SemanticOutcome.failure(INVALID_PARAMS,
      document_error.message)
  end
  local version? = wire.as_integer(params["version"])
  if version == nil then
    return dispatcher.SemanticOutcome.failure(INVALID_PARAMS,
      "params.version must be an integer")
  end
  server:on_unavailable_document(document, version)
  return dispatcher.SemanticOutcome.result(wire.null())
end

local function log_server_failure(err: value, trace: string)
  if err is protocol.ProtocolError then
    local failure: protocol.ProtocolError = err
    logging.emit("error", "server.failure", {
      ["message"] = failure.message,
    })
  elseif err is framing.FrameError then
    local failure: framing.FrameError = err
    logging.emit("error", "server.failure", {
      ["message"] = failure.message,
    })
  elseif err is async.OperationError then
    local failure: async.OperationError = err
    logging.emit("error", "server.failure", {
      ["operation"] = failure.operation,
      ["message"] = failure.message,
      ["name"] = failure.name,
    })
  else
    local details = strings.tostring(err)
    if #trace > 0 then
      details = details .. "\nstack traceback:\n" .. trace
    end
    logging.emit("error", "server.failure", {
      ["message"] = details,
    })
  end
end

local function serve(root: string): integer
  logging.emit("info", "server.start", {
    ["root"] = root,
    ["log_level"] = logging.level(),
    ["probe_cache_prefix"] = os.getenv("TITAN_PREFIX"),
    ["compiler_root"] = bridge.compiler_root(),
  })
  defer logging.emit("info", "server.stop", nil)
  do
    local server = application.create(root)
    defer server:close()
    local diagnostic_listener: diagnostics.Listener?
    return protocol.run {
      source = os.stdin,
      target = os.stdout,
      handler = function (request: dispatcher.SemanticRequest): dispatcher.SemanticOutcome
        if request.method == UNAVAILABLE_DOCUMENT_METHOD then
          return unavailable_document(request, server)
        end
        if request.method == "titan/republishDiagnostics" then
          -- Reattachment replays the currently publishable saved diagnostics,
          -- using the same path as initial protocol attachment.
          server:set_diagnostics_listener(diagnostic_listener)
          return dispatcher.SemanticOutcome.result(wire.null())
        end
        return server:handle(request)
      end,
      initialized_handler = server:start_indexing,
      notification_binder = function (sink: protocol.NotificationSink)
        server:set_indexing_listener(function (status: indexing_status.Status)
          sink(indexing_status.notification(status))
        end)
        diagnostic_listener = function (publication: diagnostics.Publication)
          sink(diagnostics.notification(publication))
        end
        server:set_diagnostics_listener(diagnostic_listener)
      end,
      shutdown_handler = server:stop_diagnostics,
      document_handler = server:on_document,
      completion_capture = server:capture_completion,
      hover_capture = server:capture_hover,
      startup_notification = wire.encode(info_envelope()),
      client_binder = function (requests: outbound_requests.OutboundRequests,
                                capabilities: lsp.CapabilitiesReader)
        server:set_client_channel(requests, capabilities)
      end,
    }
  catch
    log_server_failure(error, traceback)
    return 1
  end
end

local function serve_router(root: string, executable: string): integer
  local inherited_probe? = os.getenv("TITAN_PREFIX")
  if inherited_probe == "" then inherited_probe = nil end
  local titan_root? = os.getenv("TITAN_ROOT")
  if titan_root == "" then titan_root = nil end
  local launch_root = roots.canonical(root)
  logging.emit("info", "server.start", {
    ["root"] = launch_root,
    ["log_level"] = logging.level(),
    ["probe_cache_prefix"] = root_settings.probe_prefix(
      inherited_probe, launch_root),
  })
  defer logging.emit("info", "server.stop", nil)
  do
    return router.run(
      os.stdin, os.stdout,
      router.LaunchOptions {
        executable = executable,
        root = launch_root,
        probe_prefix = inherited_probe,
        titan_root = titan_root,
      })
  catch
    log_server_failure(error, traceback)
    return 1
  end
end

--- Configure the compiler environment and serve the requested mode.
function main(args: {string}): integer
  local options = parse_options(args)
  if options.print_paths then
    local path, cpath = lua_paths.configure()
    local selected? = options.compiler_root
    if selected ~= nil then
      path, cpath = lua_paths.select_compiler_root(selected)
    end
    io.print("package.path=" .. path)
    io.print("package.cpath=" .. cpath)
    return 0
  end
  local requested_level? = os.getenv("TITAN_LANGUAGE_SERVER_LOG_LEVEL")
  local valid_level = logging.configure(requested_level)
  local invalid_level = ""
  if not valid_level then
    if requested_level ~= nil then invalid_level = requested_level end
    logging.configure("info")
  end
  logging.start()
  defer logging.close()
  if not valid_level then
    logging.emit("error", "logging.invalid_level", {
      ["requested"] = invalid_level,
      ["fallback"] = "info",
    })
  end
  if options.worker then
    local root = absolute_root(options.root)
    -- A worker owns its root as its process workspace, exactly like the
    -- single-root server this mode replaces.
    os.chdir(root)
    local selected? = options.compiler_root
    local target? = options.target
    if target == nil then
      -- Direct --worker launches do not have a router's accepted selection.
      -- Only --compiler-root opts that launcher into loading another SDK.
      local configuration? = project_config.load_compiler_root(root)
      if configuration ~= nil then target = configuration.target end
    elseif target == "native" then
      target = nil
    end
    if selected ~= nil then
      lua_paths.select_compiler_root(selected)
      bridge.select_compiler_root(selected, target)
    else
      lua_paths.configure()
      bridge.select_compiler_root(nil, target)
    end
    local probe_prefix? = os.getenv("TITAN_PREFIX")
    if probe_prefix == nil or probe_prefix == "" then
      -- Each native process owns its startup working directory as its workspace.
      -- Set the compiler's cache-only prefix before its Lua driver first loads;
      -- TITAN_PREFIX does not choose compiler source, providers, or SDK headers.
      os.setenv("TITAN_PREFIX", workspace_cache.directory(root))
    end
    return serve(root)
  end
  return serve_router(fs.pwd(), os.exepath())
end
