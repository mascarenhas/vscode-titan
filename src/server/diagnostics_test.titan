local test = import "test"
local fs = import "fs"
local stores = import "server.workspace_store"
local published = import "server.published_diagnostics"
local source_text = import "server.source_text"
local test_runtime = import "server.test_runtime"
local bridge = import "server.compiler_bridge"
local diagnostics = import "server.diagnostics"
local wire = import "server.wire"
local project_config = import "server.project_config"
local project_discovery = import "server.project_discovery"
local project_graph = import "server.project_graph"
local project_service = import "server.project_service"
local test_paths = import "server.test_paths"
foreign import "compiler_io_platform.h"

local function sdk_root(): string
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then return "C:/sdk" end
  return "/sdk"
end

local function snapshot(filename: string, contents: string,
                        items: {bridge.Diagnostic}): project_service.Snapshot
  local source = project_service.SourceFileSnapshot.new(
    filename, contents,
    project_graph.FileStamp.new(filename, 1, 2, #contents))
  local module = project_service.ProjectModule.new(
    "main", {source}, nil, items,
    project_service.ProjectAnalysisState.failed())
  return project_service.Snapshot.new(
    1,
    project_config.ProjectConfig.new(
      test_paths.workspace_root(), nil, {test_paths.workspace_root()}, {}, {test_paths.workspace_root()},
      sdk_root(), {}, nil),
    {}, {test_paths.workspace_root()}, {module}, {}, {})
end

function test_diagnostics_publish_and_clear_unmapped_source_warnings(
    _context: test.Context)
  local saved = snapshot(test_paths.workspace_root() .. "/src/main.titan", "", {})
  local issues = {
    project_discovery.Issue.new(
      test_paths.workspace_root() .. "/loose.titan", "outside source_module_roots",
      project_discovery.IssueKind.unmapped_source()),
    project_discovery.Issue.new(
      test_paths.workspace_root() .. "/other.titan", "outside source_module_roots",
      project_discovery.IssueKind.unmapped_source()),
    project_discovery.Issue.new(
      test_paths.workspace_root() .. "/src/invalid.name.titan", "invalid logical module name",
      project_discovery.IssueKind.invalid_module()),
  }
  local with_issues = project_service.Snapshot.new(
    saved.generation, saved.config, issues, saved.project_directories,
    saved.project_modules, saved.external_modules, saved.dirty_modules)
  local publications = diagnostics.from_snapshot(with_issues)
  test.assert(#publications == 2 and #publications[1].items == 1 and
              publications[1].uri == test_paths.workspace_uri() .. "/loose.titan" and
              publications[2].uri == test_paths.workspace_uri() .. "/other.titan",
              "discovery did not publish one warning per unmapped saved source")
  local envelope? = wire.as_object(wire.decode(
    diagnostics.notification(publications[1])))
  local params? = wire.as_object(envelope["params"])
  local items? = wire.as_array(params["diagnostics"])
  local item? = wire.as_object(items[1])
  test.assert(wire.as_integer(item["severity"]) == 2 and
              wire.as_string(item["code"]) == "unmapped-source" and
              wire.as_string(item["source"]) == "Titan" and
              publications[1].items[1].range.start.line == 0 and
              publications[1].items[1].range.start.character == 0,
              "unmapped diagnostic lost its warning severity or file anchor")

  local publisher = diagnostics.create()
  local observed: {diagnostics.Publication} = {}
  publisher:set_listener(function (publication: diagnostics.Publication)
    observed[#observed + 1] = publication
  end)
  publisher:publish(publications)
  publisher:publish(diagnostics.from_snapshot(saved))
  test.assert(#observed == 4 and #observed[3].items == 0 and
              observed[3].uri == publications[1].uri and
              #observed[4].items == 0 and
              observed[4].uri == publications[2].uri,
              "ordinary discovery did not clear resolved unmapped warnings")
end

function test_diagnostics_publish_persist_and_clear_inactive_variant_information(
    _context: test.Context)
  test_runtime.run(function ()
    local saved = snapshot(test_paths.workspace_root() .. "/src/foo.linux.titan", "", {})
    local message = "not analyzed: inactive for host target 'linux'; " ..
      "'foo.titan' selects 'foo.linux.titan'"
    local issues = {
      project_discovery.Issue.new(
        test_paths.workspace_root() .. "/src/foo.windows.titan", message,
        project_discovery.IssueKind.inactive_variant()),
      project_discovery.Issue.new(
        test_paths.workspace_root() .. "/src/foo.titan", message,
        project_discovery.IssueKind.inactive_variant()),
      project_discovery.Issue.new(
        test_paths.workspace_root() .. "/src/invalid.name.titan",
        "invalid logical module name",
        project_discovery.IssueKind.invalid_module()),
    }
    local with_issues = project_service.Snapshot.new(
      saved.generation, saved.config, issues, saved.project_directories,
      saved.project_modules, saved.external_modules, saved.dirty_modules)
    local publications = diagnostics.from_snapshot(with_issues)
    test.assert(#publications == 2 and
                publications[1].uri ==
                  test_paths.workspace_uri() .. "/src/foo.windows.titan" and
                publications[2].uri ==
                  test_paths.workspace_uri() .. "/src/foo.titan",
                "inactive variants did not produce one diagnostic publication each")
    local envelope? = wire.as_object(wire.decode(
      diagnostics.notification(publications[1])))
    local params? = wire.as_object(envelope["params"])
    local items? = wire.as_array(params["diagnostics"])
    local item? = wire.as_object(items[1])
    test.assert(wire.as_integer(item["severity"]) == 3 and
                wire.as_string(item["code"]) == "inactive-variant" and
                wire.as_string(item["source"]) == "Titan" and
                wire.as_string(item["message"]) == message and
                publications[1].items[1].range.start.line == 0 and
                publications[1].items[1].range.start.character == 0,
                "inactive variant diagnostic lost information severity, code, or message")

    local path = fs.tmpname()
    defer fs.unlink(path)
    local store = stores.open(path)
    defer store:close()
    do
      local access = store:acquire()
      defer access:release()
      published.initialize_schema(access.connection)
      access.connection:set_autocommit(false)
      published.publish(access.connection, publications)
      stores.execute(access.connection,
        "UPDATE main.store_state SET published_generation=3 WHERE singleton=1")
      access.connection:commit()
    end
    local persisted = published.read(store, 3)
    test.assert(#persisted == 2 and #persisted[1].items == 1 and
                persisted[1].items[1].message == message,
                "persisted inactive-variant diagnostic did not round-trip")
    local reencoded? = wire.as_object(wire.decode(
      diagnostics.notification(persisted[1])))
    local reencoded_params? = wire.as_object(reencoded["params"])
    local reencoded_items? = wire.as_array(reencoded_params["diagnostics"])
    local reencoded_item? = wire.as_object(reencoded_items[1])
    test.assert(wire.as_integer(reencoded_item["severity"]) == 3 and
                wire.as_string(reencoded_item["code"]) == "inactive-variant",
                "replayed inactive-variant diagnostic lost its kind code")

    local publisher = diagnostics.create()
    local observed: {diagnostics.Publication} = {}
    publisher:set_listener(function (publication: diagnostics.Publication)
      observed[#observed + 1] = publication
    end)
    publisher:publish(persisted)
    publisher:publish(diagnostics.from_snapshot(saved))
    test.assert(#observed == 4 and #observed[3].items == 0 and
                observed[3].uri == publications[1].uri and
                #observed[4].items == 0 and
                observed[4].uri == publications[2].uri,
                "removing inactive variants did not clear their diagnostics")
  end)
end

function test_diagnostics_map_saved_compiler_byte_locations_to_lsp(
    _context: test.Context)
  local filename = test_paths.workspace_root() .. "/main.titan"
  local publications = diagnostics.from_snapshot(snapshot(
    filename, "\u{10400}broken\n", {
      bridge.Diagnostic.new(
        bridge.DiagnosticKind.type_error(), "wrong result type",
        bridge.SourceLocation.new(filename, 1, 5)),
      bridge.Diagnostic.new(
        bridge.DiagnosticKind.type_error(), "wrong result type",
        bridge.SourceLocation.new(filename, 1, 5)),
    }))
  test.assert(#publications == 1 and #publications[1].items == 1,
              "saved compiler diagnostic was not assigned or deduplicated")
  local item = publications[1].items[1]
  test.assert(publications[1].uri == test_paths.workspace_uri() .. "/main.titan" and
              item.range.start.line == 0 and
              item.range.start.character == 2 and
              item.range.finish.line == 0 and
              item.range.finish.character == 2,
              "compiler byte column was not converted to the LSP position")

  local encoded = wire.decode(
    diagnostics.notification(publications[1]))
  local envelope? = wire.as_object(encoded)
  local params? = wire.as_object(envelope["params"])
  local values? = wire.as_array(params["diagnostics"])
  local diagnostic? = wire.as_object(values[1])
  test.assert(envelope ~= nil and params ~= nil and
              wire.as_string(envelope["method"]) ==
                "textDocument/publishDiagnostics" and
              wire.as_integer(diagnostic["severity"]) == 1 and
              wire.as_string(diagnostic["code"]) == "type" and
              wire.as_string(diagnostic["source"]) == "Titan" and
              wire.as_string(diagnostic["message"]) ==
                "wrong result type",
              "LSP diagnostic notification lost compiler metadata")
end

function test_diagnostics_anchor_location_free_compiler_failures_to_first_constituent(
    _context: test.Context)
  local first_filename = test_paths.workspace_root() .. "/z-first.titan"
  local second_filename = test_paths.workspace_root() .. "/a-second.titan"
  local message = "compiler boundary failed"
  local failure = bridge.Diagnostic.new(
    bridge.DiagnosticKind.compiler(), message, nil)
  local saved = snapshot(first_filename, "first\n", {failure})
  local second_contents = "second\n"
  local second = project_service.SourceFileSnapshot.new(
    second_filename, second_contents,
    project_graph.FileStamp.new(second_filename, 1, 2, #second_contents))
  local module = project_service.ProjectModule.new(
    "main", {saved.project_modules[1].source_files[1], second}, nil, {failure},
    project_service.ProjectAnalysisState.failed())
  local multiple = project_service.Snapshot.new(
    saved.generation, saved.config, saved.discovery_issues,
    saved.project_directories, {module}, saved.external_modules, saved.dirty_modules)
  local publications = diagnostics.from_snapshot(multiple)
  test.assert(#publications == 1 and #publications[1].items == 1 and
              publications[1].uri == test_paths.workspace_uri() .. "/z-first.titan",
              "location-free compiler failure did not select only the first saved constituent")
  local item = publications[1].items[1]
  test.assert(item.message == message and
              item.range.start.line == 0 and item.range.start.character == 0 and
              item.range.finish.line == 0 and item.range.finish.character == 0,
              "location-free compiler failure lost its zero-width document anchor")

  local envelope? = wire.as_object(wire.decode(
    diagnostics.notification(publications[1])))
  local params? = wire.as_object(envelope["params"])
  local values? = wire.as_array(params["diagnostics"])
  local diagnostic? = wire.as_object(values[1])
  test.assert(wire.as_integer(diagnostic["severity"]) == 1 and
              wire.as_string(diagnostic["code"]) == "compiler" and
              wire.as_string(diagnostic["message"]) == message,
              "location-free compiler failure lost its published severity or code")
end

function test_diagnostics_filter_external_locations_and_clear_stale_files(
    _context: test.Context)
  local filename = test_paths.workspace_root() .. "/main.titan"
  local publisher = diagnostics.create()
  local observed: {diagnostics.Publication} = {}
  publisher:set_listener(function (publication: diagnostics.Publication)
    observed[#observed + 1] = publication
  end)

  local external = diagnostics.from_snapshot(snapshot(
    filename, "function answer(): integer return 1 end\n", {
      bridge.Diagnostic.new(
        bridge.DiagnosticKind.compiler(), "external failure",
        bridge.SourceLocation.new(sdk_root() .. "/vendor.titan", 1, 1)),
    }))
  test.assert(#external == 0,
              "external source diagnostic was published as a project error")

  publisher:publish(diagnostics.from_snapshot(snapshot(
    filename, "function broken(\n", {
      bridge.Diagnostic.new(
        bridge.DiagnosticKind.syntax(), "syntax error: malformed",
        bridge.SourceLocation.new(filename, 1, 1)),
    })))
  publisher:publish(diagnostics.from_snapshot(snapshot(
    test_paths.workspace_root() .. "/new-root/main.titan",
    "function answer(): integer return 1 end\n", {})))
  test.assert(#observed == 2 and #observed[1].items == 1 and
              observed[1].uri == test_paths.workspace_uri() .. "/main.titan" and
              #observed[2].items == 0 and
              observed[2].uri == test_paths.workspace_uri() .. "/main.titan",
              "root replacement did not clear the stale diagnostic URI")

  publisher:publish(diagnostics.from_snapshot(snapshot(
    filename, "function broken(\n", {
      bridge.Diagnostic.new(
        bridge.DiagnosticKind.syntax(), "syntax error: malformed",
        bridge.SourceLocation.new(filename, 1, 1)),
    })))
  publisher:stop()
  test.assert(#observed == 4 and #observed[4].items == 0 and
              observed[4].uri == test_paths.workspace_uri() .. "/main.titan",
              "publisher shutdown did not clear its active diagnostic URI")
end

function test_diagnostics_replays_published_rows_after_file_reopen(
    _context: test.Context)
  test_runtime.run(function ()
    local path = fs.tmpname()
    defer fs.unlink(path)
    local input: {diagnostics.Publication} = {}
    for index = 1, 101 do
      local items: {diagnostics.Item} = {}
      if index ~= 100 then
        local position = source_text.Position.new(index, 3)
        items[1] = diagnostics.Item.new(diagnostics.Kind.unmapped_source(),
          "binary message\0\255" .. index, source_text.Span.new(position, position))
      end
      input[index] = diagnostics.Publication.new(test_paths.workspace_uri() .. "/source" .. index .. ".titan", items)
    end
    do
      local store = stores.open(path)
      defer store:close()
      local access = store:acquire()
      defer access:release()
      published.initialize_schema(access.connection)
      access.connection:set_autocommit(false)
      published.publish(access.connection, input)
      stores.execute(access.connection,
        "UPDATE main.store_state SET published_generation=7 WHERE singleton=1")
      access.connection:commit()
    end
    local store = stores.open(path)
    defer store:close()
    local rows = published.read(store, 7)
    test.assert(#rows == 101 and rows[1].uri == input[1].uri and
      #rows[100].items == 0 and rows[101].items[1].message == input[101].items[1].message and
      rows[101].items[1].range.start.line == 101,
      "published diagnostic order, empty replacement, or BLOB batch did not survive reopen")
    local before = 0
    do
      local access = store:acquire()
      defer access:release()
      before = stores.scalar_integer(access.connection, "SELECT total_changes()")
    end
    local listener_count = 0
    local publisher = diagnostics.create()
    publisher:set_listener(function (_publication: diagnostics.Publication)
      listener_count = listener_count + 1
    end)
    publisher:publish(published.read(store, 7))
    local access = store:acquire()
    defer access:release()
    test.assert(listener_count == 101 and before ==
      stores.scalar_integer(access.connection, "SELECT total_changes()"),
      "diagnostic listener replay mutated the workspace database")
  end)
end

local function typed_item(message: string, line: integer): diagnostics.Item
  return diagnostics.Item.new(
    diagnostics.Kind.compiler(bridge.DiagnosticKind.type_error()), message,
    source_text.Span.new(
      source_text.Position.new(line, 1), source_text.Position.new(line, 4)))
end

function test_diagnostics_result_id_is_stable_and_answers_unchanged(
    _context: test.Context)
  local first = typed_item("expected integer", 3)
  local items = {first}
  local id = diagnostics.result_id(items)
  test.assert(#id == 64, "diagnostic result id was not a hex SHA-256 digest")
  test.assert(diagnostics.result_id({first}) == id,
    "diagnostic result id was not stable for equal items")
  test.assert(diagnostics.result_id({}) ~= id,
    "diagnostic result id ignored the item set")

  local full? = wire.as_object(diagnostics.report(items, nil))
  test.assert(full ~= nil and wire.as_string(full["kind"]) == "full" and
    wire.as_string(full["resultId"]) == id,
    "pull report was not a full report with its result id")
  local encoded? = wire.as_array(full["items"])
  test.assert(encoded ~= nil and #encoded == 1,
    "pull report lost its diagnostics")

  -- Push and pull describe the same item exactly.
  local pushed? = wire.as_object(wire.decode(diagnostics.notification(
    diagnostics.Publication.new(test_paths.workspace_uri() .. "/main.titan",
      items))))
  local params? = wire.as_object(pushed["params"])
  local pushed_items? = wire.as_array(params["diagnostics"])
  local pushed_item? = wire.as_object(pushed_items[1])
  local pulled_item? = wire.as_object(encoded[1])
  test.assert(pushed_item ~= nil and pulled_item ~= nil,
    "push or pull lost its encoded diagnostic")
  test.assert(wire.as_string(pushed_item["code"]) ==
                wire.as_string(pulled_item["code"]) and
              wire.as_string(pushed_item["source"]) ==
                wire.as_string(pulled_item["source"]) and
              wire.as_integer(pushed_item["severity"]) ==
                wire.as_integer(pulled_item["severity"]) and
              wire.as_string(pushed_item["message"]) ==
                wire.as_string(pulled_item["message"]),
    "push and pull encoded the same diagnostic differently")
  local pushed_range? = wire.as_object(pushed_item["range"])
  local pulled_range? = wire.as_object(pulled_item["range"])
  local pushed_start? = wire.as_object(pushed_range["start"])
  local pulled_start? = wire.as_object(pulled_range["start"])
  test.assert(wire.as_integer(pushed_start["line"]) ==
                wire.as_integer(pulled_start["line"]) and
              wire.as_integer(pushed_start["character"]) ==
                wire.as_integer(pulled_start["character"]),
    "push and pull encoded different diagnostic coordinates")

  local unchanged? = wire.as_object(diagnostics.report(items, id))
  test.assert(unchanged ~= nil and
    wire.as_string(unchanged["kind"]) == "unchanged" and
    wire.as_string(unchanged["resultId"]) == id and
    unchanged["items"] == nil,
    "unchanged report did not omit its items")
  local changed? = wire.as_object(
    diagnostics.report({first, typed_item("other failure", 9)}, id))
  test.assert(changed ~= nil and wire.as_string(changed["kind"]) == "full" and
    wire.as_string(changed["resultId"]) ~= id,
    "changed item set retained the previous result id")
end
