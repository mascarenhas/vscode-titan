local function preserves_cached_manifest_callable_hover_signatures()
  preload_real_compiler()
  local external_root = test_paths.temporary_name()
  fs.unlink(external_root)
  fs.mkdir(external_root)
  local external_file = external_root .. "/hover_manifest.titan"
  fs.write_file(external_file, [[record Parcel
  amount: integer
end
function Parcel.create(initial: integer): Parcel
  return Parcel.new(initial)
end
function Parcel:increase(delta: integer): integer
  return self.amount + delta
end
union Choice
  numbered(integer)
  empty()
end
function Choice.from_ordinal(ordinal: integer): Choice
  return Choice.numbered(ordinal)
end
function Choice:label(prefix: string): string
  return prefix
end
interface Formatter
  prefix: string
  function format(subject: string, maximum: integer?): string
end
function combine(left: integer, right: integer): integer
  return left + right
end
]])
  defer do
    fs.unlink(external_file)
    fs.rmdir(external_root)
  end

  local seed_filename = test_paths.workspace_root() .. "/hover_manifest_seed.titan"
  local seed = bridge.ProjectModule.new("hover_manifest_seed", {
    bridge.SourceFile.new(seed_filename,
      "local cached = import \"hover_manifest\"\n" ..
      "function seed(): integer return cached.combine(1, 2) end\n"),
  })
  local initial_compiler = bridge.load()
  initial_compiler:configure(bridge.CompilerConfiguration.new { source_roots = {external_root} })
  local initial = initial_compiler:analyze("hover_manifest_seed", {seed})
  local initial_external? = initial:find_module("hover_manifest")
  test.assert(#initial.diagnostics == 0 and initial_external ~= nil and
              initial_external.manifest ~= nil,
              "initial external callable manifest was not serialized")
  local external_module = initial_external as bridge.ModuleSnapshot
  local external_manifest = external_module.manifest as bridge.Manifest
  test.assert(external_manifest.source_serialized ~= nil,
              "external callable cache seed lost its source manifest")
  local cached_external = bridge.CachedSourceInterface.new(
    "hover_manifest", external_manifest.serialized,
    external_manifest.source_serialized,
    external_file, {external_file}, external_module.imports,
    external_module.c_header_dependencies)

  -- A syntax error makes an accidental source reload observable. The second
  -- Compiler must resolve every declaration below from the serialized cache.
  fs.write_file(external_file, "function broken(: integer) end\n")
  local filename = test_paths.workspace_root() .. "/hover_manifest_consumer.titan"
  local source = [[local cached = import "hover_manifest"
function use(formatter: cached.Formatter,
             parcel: cached.Parcel,
             choice: cached.Choice): integer
  local combined = cached.combine(1, 2)
  local created = cached.Parcel.create(3)
  local grown = parcel:increase(4)
  local selected = cached.Choice.from_ordinal(5)
  local variant = cached.Choice.numbered(6)
  local label = choice:label(">")
  local text = formatter:format(label, 20)
  return 0
end
]]
  local consumer = bridge.ProjectModule.new("hover_manifest_consumer", {
    bridge.SourceFile.new(filename, source),
  })
  local reloaded_compiler = bridge.load()
  reloaded_compiler:configure(bridge.CompilerConfiguration.new { source_roots = {external_root} })
  local reloaded = reloaded_compiler:analyze_incremental(
    {consumer}, {"hover_manifest_consumer"}, {cached_external})
  local diagnostic_messages = strings.writer()
  for index = 1, #reloaded.diagnostics do
    diagnostic_messages:write(reloaded.diagnostics[index].message .. "\n")
  end
  test.assert(#reloaded.diagnostics == 0,
              "compiler did not use serialized callable manifest: " ..
              diagnostic_messages:drain())
  local cached_snapshot? = reloaded:find_module("hover_manifest")
  test.assert(cached_snapshot ~= nil and #cached_snapshot.nodes == 0 and
              #cached_snapshot.symbols == 0 and
              cached_snapshot.manifest ~= nil and
              cached_snapshot.manifest.source_serialized ==
                external_manifest.source_serialized,
              "serialized external manifest unexpectedly retained an AST")
  local cached_summaries? = cached_snapshot.hover_summaries
  test.assert(cached_summaries == nil or #cached_summaries == 0,
              "serialized external snapshot retained hover summaries")
  local model = features.build({consumer}, reloaded.modules)
  defer model:close()

  local module_hover? = model:hover(
    filename, source_text.Position.new(0, 7))
  test.assert(module_hover ~= nil and module_hover:markdown() ==
                "**module** `hover_manifest`\n\n" ..
                "Members\n\n" ..
                "- `union Choice`\n" ..
                "- `record Parcel`\n" ..
                "- `hover_manifest.combine(" ..
                  "left: integer, right: integer): integer`\n" ..
                "- `interface Formatter`\n\n" ..
                "- Visibility: module\n" and
              strings.find(module_hover:markdown(), "Variants") == nil and
              strings.find(module_hover:markdown(), ".new") == nil,
              "cached module hover expanded or lost manifest members")

  local interface_hover? = model:hover(
    filename, source_text.Position.new(1, 32))
  test.assert(interface_hover ~= nil and interface_hover:markdown() ==
                "**interface** `hover_manifest.Formatter`\n\n" ..
                "Fields\n\n" ..
                "- `const prefix: string`\n\n" ..
                "Methods\n\n" ..
                "- `hover_manifest.Formatter:format(" ..
                  "subject: string, maximum: integer?): string`\n\n" ..
                "- Visibility: exported\n",
              "cached interface hover lost fields or named methods")

  local parcel_hover? = model:hover(
    filename, source_text.Position.new(2, 29))
  test.assert(parcel_hover ~= nil and parcel_hover:markdown() ==
                "**record** `hover_manifest.Parcel`\n\n" ..
                "Fields\n\n" ..
                "- `amount: integer`\n\n" ..
                "Functions\n\n" ..
                "- `hover_manifest.Parcel.create(" ..
                  "initial: integer): hover_manifest.Parcel`\n" ..
                "- `hover_manifest.Parcel.new(" ..
                  "amount: integer): hover_manifest.Parcel`\n\n" ..
                "Methods\n\n" ..
                "- `hover_manifest.Parcel:increase(" ..
                  "delta: integer): integer`\n\n" ..
                "- Visibility: exported\n",
              "cached record hover lost normalized manifest members")

  local choice_hover? = model:hover(
    filename, source_text.Position.new(3, 29))
  test.assert(choice_hover ~= nil and choice_hover:markdown() ==
                "**union** `hover_manifest.Choice`\n\n" ..
                "Variants\n\n" ..
                "- `empty()`\n" ..
                "- `numbered(value: integer)`\n\n" ..
                "Functions\n\n" ..
                "- `hover_manifest.Choice.from_ordinal(" ..
                  "ordinal: integer): hover_manifest.Choice`\n\n" ..
                "Methods\n\n" ..
                "- `hover_manifest.Choice:label(" ..
                  "prefix: string): string`\n\n" ..
                "- Visibility: exported\n" and
              strings.find(choice_hover:markdown(),
                           "Choice.numbered") == nil,
              "cached union hover duplicated synthesized constructors")

  local ordinary? = model:hover(filename, source_text.Position.new(4, 29))
  test.assert(ordinary ~= nil and ordinary:markdown() ==
                "- Signature: `hover_manifest.combine(" ..
                "left: integer, right: integer): integer`\n" ..
                "- Visibility: exported\n",
              "deserialized ModuleMember lost parameter labels")

  local record_static? = model:hover(
    filename, source_text.Position.new(5, 33))
  test.assert(record_static ~= nil and record_static:markdown() ==
                "- Signature: `hover_manifest.Parcel.create(" ..
                "initial: integer): hover_manifest.Parcel`\n" ..
                "- Visibility: exported\n",
              "deserialized record StaticMethod lost parameter labels")

  local record_method? = model:hover(
    filename, source_text.Position.new(6, 25))
  test.assert(record_method ~= nil and record_method:markdown() ==
                "- Signature: `hover_manifest.Parcel:increase(" ..
                "delta: integer): integer`\n" ..
                "- Visibility: exported\n",
              "deserialized record Method lost parameter labels")

  local union_static? = model:hover(
    filename, source_text.Position.new(7, 36))
  test.assert(union_static ~= nil and union_static:markdown() ==
                "- Signature: `hover_manifest.Choice.from_ordinal(" ..
                "ordinal: integer): hover_manifest.Choice`\n" ..
                "- Visibility: exported\n",
              "deserialized union StaticMethod lost parameter labels")

  local variant? = model:hover(filename, source_text.Position.new(8, 34))
  test.assert(variant ~= nil and variant:markdown() ==
                "- Signature: `hover_manifest.Choice.numbered(" ..
                "value: integer): hover_manifest.Choice`\n" ..
                "- Visibility: exported\n",
              "legacy union payload lost its canonical value parameter label")

  local union_method? = model:hover(filename, source_text.Position.new(9, 24))
  test.assert(union_method ~= nil and union_method:markdown() ==
                "- Signature: `hover_manifest.Choice:label(" ..
                "prefix: string): string`\n" ..
                "- Visibility: exported\n",
              "deserialized union Method lost parameter labels")

  local interface_method? = model:hover(
    filename, source_text.Position.new(10, 27))
  test.assert(interface_method ~= nil and interface_method:markdown() ==
                "- Signature: `hover_manifest.Formatter:format(" ..
                "subject: string, maximum: integer?): string`\n" ..
                "- Visibility: exported\n",
              "deserialized interface Method lost parameter labels")
end

function test_compiler_bridge_preserves_cached_manifest_callable_hover_signatures(
    _context: test.Context)
  test_runtime.run(preserves_cached_manifest_callable_hover_signatures)
end

local function assert_metadata_symbol_types(project: bridge.ModuleSnapshot,
                                            phase: string)
  local expected_types: {string: string} = {
    ["mutable_result"] = "{ integer }",
    ["immutable_result"] = "const { integer }",
    ["mutable_view"] = "const? { integer }",
    ["immutable_view"] = "const? { integer }",
    ["optional_view"] = "const? { integer }?",
    ["relayed"] = "foreign function (*lua_State, const *char): int",
  }
  local checked_types = 0
  for index = 1, #project.symbols do
    local symbol = project.symbols[index]
    local expected? = expected_types[symbol.name]
    if expected ~= nil then
      test.assert(symbol.type_info ~= nil and
                  symbol.type_info.display == expected,
                  phase .. " metadata changed the type of '" .. symbol.name .. "'")
      expected_types[symbol.name] = nil
      checked_types = checked_types + 1
    end
  end
  test.assert(checked_types == 6,
              phase .. " metadata fixture lost inferred local symbols")
end

local function preserves_current_metadata_types_in_cached_external_manifests()
  preload_real_compiler()
  local external_root = test_paths.temporary_name()
  fs.unlink(external_root)
  fs.mkdir(external_root)
  local external_file = external_root .. "/bridge_metadata.titan"
  fs.write_file(external_file, [[
function mutable(items: { integer }): { integer }
  return items
end
function immutable(items: const { integer }): const { integer }
  return items
end
function view(items: const? { integer }): const? { integer }
  return items
end
function optional(items: (const? { integer })?): (const? { integer })?
  return items
end
function relay(callback: foreign function (*lua_State, const *char): int):
    foreign function (*lua_State, const *char): int
  return callback
end
]])
  defer do
    fs.unlink(external_file)
    fs.rmdir(external_root)
  end

  local filename = test_paths.workspace_root() .. "/bridge_metadata_consumer.titan"
  local source = [[local cached = import "bridge_metadata"
function use(callback: foreign function (*lua_State, const *char): int,
             mutable: { integer }, immutable: const { integer }): integer
  local mutable_result = cached.mutable(mutable)
  local immutable_result = cached.immutable(immutable)
  local mutable_view = cached.view(mutable)
  local immutable_view = cached.view(immutable)
  local optional_view? = cached.optional(nil)
  local relayed = cached.relay(callback)
  local result: integer = relayed(L, "fixture")
  return result
end
]]
  local consumer = bridge.ProjectModule.new("bridge_metadata_consumer", {
    bridge.SourceFile.new(filename, source),
  })
  local initial_compiler = bridge.load()
  initial_compiler:configure(bridge.CompilerConfiguration.new { source_roots = {external_root} })
  local initial = initial_compiler:analyze("bridge_metadata_consumer", {consumer})
  local diagnostic_messages = strings.writer()
  for index = 1, #initial.diagnostics do
    diagnostic_messages:write(initial.diagnostics[index].message .. "\n")
  end
  test.assert(#initial.diagnostics == 0,
              "compiler rejected current metadata fixture: " ..
                diagnostic_messages:drain())
  local initial_project? = initial:find_module("bridge_metadata_consumer")
  test.assert(initial_project ~= nil, "fresh metadata consumer was not analyzed")
  assert_metadata_symbol_types(initial_project, "fresh")
  local external? = initial:find_module("bridge_metadata")
  test.assert(external ~= nil and external.manifest ~= nil and
              #external.nodes == 0 and #external.symbols == 0 and
              not initial_compiler:has_project_entry("bridge_metadata"),
              "external metadata seed retained project semantic state")
  local manifest: bridge.Manifest = external.manifest
  test.assert(manifest.source_serialized ~= nil and
              strings.find(manifest.serialized, 'Array(Integer(),{tag="no"})') ~= nil and
              strings.find(manifest.serialized, 'Array(Integer(),{tag="yes"})') ~= nil and
              strings.find(manifest.serialized, 'Array(Integer(),{tag="maybe"})') ~= nil and
              strings.find(manifest.serialized, "CFunction(") ~= nil and
              strings.find(manifest.serialized, "CStruct(") ~= nil,
              "current Array and portable C metadata were not serialized")
  local cached_external = bridge.CachedSourceInterface.new(
    "bridge_metadata", manifest.serialized, manifest.source_serialized,
    external_file, {external_file}, external.imports,
    external.c_header_dependencies)

  -- Make source fallback fail so this analysis proves manifest rehydration.
  fs.write_file(external_file, "function broken(: integer) end\n")
  local reloaded_compiler = bridge.load()
  reloaded_compiler:configure(bridge.CompilerConfiguration.new { source_roots = {external_root} })
  local reloaded = reloaded_compiler:analyze_incremental(
    {consumer}, {"bridge_metadata_consumer"}, {cached_external})
  for index = 1, #reloaded.diagnostics do
    diagnostic_messages:write(reloaded.diagnostics[index].message .. "\n")
  end
  test.assert(#reloaded.diagnostics == 0,
              "compiler could not rehydrate current metadata: " ..
                diagnostic_messages:drain())
  local project? = reloaded:find_module("bridge_metadata_consumer")
  test.assert(project ~= nil and #project.nodes > 0 and
              reloaded_compiler:has_project_entry("bridge_metadata_consumer"),
              "manifest consumer lost its fresh snapshot or retained declarations")
  assert_metadata_symbol_types(project, "cached")
  local cached_snapshot? = reloaded:find_module("bridge_metadata")
  test.assert(cached_snapshot ~= nil and #cached_snapshot.nodes == 0 and
              #cached_snapshot.symbols == 0 and cached_snapshot.manifest ~= nil and
              cached_snapshot.manifest.serialized == manifest.serialized and
              cached_snapshot.manifest.source_serialized == manifest.source_serialized and
              not reloaded_compiler:has_project_entry("bridge_metadata"),
              "rehydrated external metadata retained an AST or changed its manifest")
end

function test_compiler_bridge_preserves_current_metadata_in_cached_external_manifests(
    _context: test.Context)
  run_bridge(preserves_current_metadata_types_in_cached_external_manifests)
end

local function preserves_direct_c_callable_hover_signatures()
  preload_real_compiler()
  local include_root = test_paths.temporary_name()
  fs.unlink(include_root)
  fs.mkdir(include_root)
  local header = include_root .. "/hover_callable.h"
  fs.write_file(header,
    "int hover_named_sum(int left, int right);\n" ..
    "int hover_unnamed_sum(int, int);\n")
  defer do
    fs.unlink(header)
    fs.rmdir(include_root)
  end

  local filename = test_paths.workspace_root() .. "/hover_c_consumer.titan"
  local source = [[foreign import "hover_callable.h"
function run(): integer
  local named: integer = ffi.hover_named_sum(1, 2)
  local unnamed: integer = ffi.hover_unnamed_sum(3, 4)
  return named + unnamed
end
]]
  local project = bridge.ProjectModule.new("hover_c_consumer", {
    bridge.SourceFile.new(filename, source),
  })
  local compiler = bridge.load()
  compiler:configure(bridge.CompilerConfiguration.new { include_roots = {include_root} })
  local analysis = compiler:analyze("hover_c_consumer", {project})
  local diagnostic_messages = strings.writer()
  for index = 1, #analysis.diagnostics do
    diagnostic_messages:write(analysis.diagnostics[index].message .. "\n")
  end
  test.assert(#analysis.diagnostics == 0,
              "compiler rejected direct-C hover fixture: " ..
              diagnostic_messages:drain())
  local model = features.build({project}, analysis.modules)
  defer model:close()

  local named? = model:hover(filename, source_text.Position.new(2, 40))
  test.assert(named ~= nil and named:markdown() ==
                "- Signature: `ffi.hover_named_sum(" ..
                "left: foreign int, right: foreign int): foreign int`\n" ..
                "- Visibility: module\n",
              "direct C function lost its FFI namespace or parameter names")

  local unnamed? = model:hover(filename, source_text.Position.new(3, 42))
  test.assert(unnamed ~= nil and unnamed:markdown() ==
                "- Signature: `ffi.hover_unnamed_sum(foreign int, foreign int): foreign int`\n" ..
                "- Visibility: module\n",
              "unnamed C prototype invented parameter labels")
end

function test_compiler_bridge_preserves_direct_c_callable_hover_signatures(
    _context: test.Context)
  test_runtime.run(preserves_direct_c_callable_hover_signatures)
end

local function symbol_identity(module: bridge.ModuleSnapshot,
                               name: string): string?
  local identity?: string = nil
  for index = 1, #module.symbols do
    local symbol = module.symbols[index]
    if symbol.name == name and symbol.declaration_id ~= nil then
      if identity == nil then identity = symbol.declaration_id end
      test.assert(symbol.declaration_id == identity,
                  "symbol '" .. name .. "' split inside one module")
    end
  end
  return identity
end

local function preserves_source_manifest_across_trivia_shifts()
  preload_real_compiler()
  local filename = test_paths.workspace_root() .. "/private_identity.titan"
  local source = [[local secret = 41
local function hidden(increment: integer): integer
  return secret + increment
end
function answer(): integer return hidden(1) end
]]
  local initial = bridge.load():analyze("private_identity", {
    bridge.ProjectModule.new("private_identity", {
      bridge.SourceFile.new(filename, source),
    }),
  })
  local shifted = bridge.load():analyze("private_identity", {
    bridge.ProjectModule.new("private_identity", {
      bridge.SourceFile.new(filename, "-- leading comment\n" .. source),
    }),
  })
  test.assert(#initial.diagnostics == 0 and #shifted.diagnostics == 0,
              "private identity fixtures did not compile")
  local initial_module? = initial:find_module("private_identity")
  local shifted_module? = shifted:find_module("private_identity")
  test.assert(initial_module ~= nil and shifted_module ~= nil and
              initial_module.manifest ~= nil and
              shifted_module.manifest ~= nil,
              "private identity fixtures lost their module snapshots")
  test.assert(initial_module.manifest.source_serialized ==
                shifted_module.manifest.source_serialized,
              "leading trivia changed the source-visible interface")
end

function test_compiler_bridge_preserves_source_manifest_across_leading_comments(
    _context: test.Context)
  test_runtime.run(preserves_source_manifest_across_trivia_shifts)
end

local function preserves_alias_and_named_parameter_rename_metadata()
  preload_real_compiler()
  local provider_file = test_paths.workspace_root() .. "/named_provider.titan"
  local consumer_file = test_paths.workspace_root() .. "/named_consumer.titan"
  local provider_source = [[record Box
  amount: integer
end
type Alias = Box
function choose(first: integer, second: integer): integer
  return first + second
end
]]
  local consumer_source = [[local p = import "named_provider"
function run(): integer
  local box: p.Alias = p.Alias.new { amount = 3 }
  return p.choose { second = box.amount, first = 1 }
end
]]
  local projects = {
    bridge.ProjectModule.new("named_provider", {
      bridge.SourceFile.new(provider_file, provider_source),
    }),
    bridge.ProjectModule.new("named_consumer", {
      bridge.SourceFile.new(consumer_file, consumer_source),
    }),
  }
  local compiler = bridge.load()
  local analysis = compiler:analyze("named_consumer", projects)
  test.assert(#analysis.diagnostics == 0,
              "named-argument semantic fixture did not compile")
  local provider? = analysis:find_module("named_provider")
  local consumer? = analysis:find_module("named_consumer")
  test.assert(provider ~= nil and consumer ~= nil,
              "named-argument semantic snapshots were incomplete")
  local provider_module: bridge.ModuleSnapshot = provider
  local consumer_module: bridge.ModuleSnapshot = consumer
  test.assert(symbol_identity(provider_module, "Alias") ==
                symbol_identity(consumer_module, "Alias"),
              "qualified alias namespace did not join its declaration")
  test.assert(symbol_identity(provider_module, "first") ==
                symbol_identity(consumer_module, "first"),
              "named label did not join its formal parameter")

  local model = features.build(projects, analysis.modules)
  defer model:close()
  local candidate?, candidate_error? = model:rename(
    provider_file, source_text.Position.new(4, 17), "primary")
  test.assert(candidate_error == nil and candidate ~= nil,
              "formal parameter did not produce a rename candidate")
  local edited = candidate:edited_project_modules()
  local checked = bridge.load():analyze("named_consumer", edited)
  local verified?, verification_error? = candidate:preflight(checked)
  test.assert(verification_error == nil and verified ~= nil,
              "named-argument parameter rename failed compiler preflight")
  local documents = verified:document_edits()
  test.assert(#documents == 2 and
              documents[1].uri == test_paths.workspace_uri() .. "/named_consumer.titan" and
              #documents[1].edits == 1 and
              documents[2].uri == test_paths.workspace_uri() .. "/named_provider.titan" and
              #documents[2].edits == 2,
              "parameter rename did not edit its definition, uses, and label")
end

function test_compiler_bridge_preserves_alias_and_named_parameter_rename_metadata(
    _context: test.Context)
  test_runtime.run(preserves_alias_and_named_parameter_rename_metadata)
end

local function marked_name_position(source: string, marker: string,
                                     name: string): source_text.Position
  local first? = strings.find(source, marker)
  test.assert(first ~= nil, "semantic fixture lost marker '" .. marker .. "'")
  local name_start? = strings.find(marker, name)
  test.assert(name_start ~= nil, "semantic fixture marker lost its identifier")
  local position?, position_error? = source_text.position_for_offset(
    source, first + name_start - 2)
  test.assert(position_error == nil and position ~= nil,
              "semantic fixture marker has no source position")
  return position
end

local function assert_namespace_definition_and_references(
    model: features.Features, provider_file: string, consumer_file: string,
    definition_position: source_text.Position,
    provider_reference: source_text.Position,
    consumer_reference: source_text.Position)
  local provider_uri = test_paths.workspace_uri() .. "/namespace_provider.titan"
  local consumer_uri = test_paths.workspace_uri() .. "/namespace_consumer.titan"
  local definition? = model:definition(consumer_file, consumer_reference)
  test.assert(definition ~= nil and definition.uri == provider_uri and
              definition.range.start.line == definition_position.line and
              definition.range.start.character == definition_position.character,
              "same-spelled declarations resolved to the wrong namespace")
  local references = model:references(consumer_file, consumer_reference, false)
  test.assert(#references == 2 and
              references[1].uri == consumer_uri and
              references[1].range.start.line == consumer_reference.line and
              references[1].range.start.character == consumer_reference.character and
              references[2].uri == provider_uri and
              references[2].range.start.line == provider_reference.line and
              references[2].range.start.character == provider_reference.character and
              #model:references(consumer_file, consumer_reference, true) == 3,
              "references merged different namespaces or lost a same-namespace use")
end

local function assert_namespace_rename(model: features.Features,
                                       filename: string,
                                       position: source_text.Position)
  local candidate?, candidate_error? = model:rename(filename, position, "Updated")
  test.assert(candidate_error == nil and candidate ~= nil,
              "namespace declaration did not produce a rename candidate")
  local analysis = bridge.load():analyze(
    "namespace_consumer", candidate:edited_project_modules())
  local verified?, verification_error? = candidate:preflight(analysis)
  test.assert(#analysis.diagnostics == 0 and verification_error == nil and
              verified ~= nil,
              "namespace-preserving rename failed compiler preflight")
  local documents = verified:document_edits()
  test.assert(#documents == 2 and
              documents[1].uri == test_paths.workspace_uri() .. "/namespace_consumer.titan" and
              #documents[1].edits == 1 and
              documents[2].uri == test_paths.workspace_uri() .. "/namespace_provider.titan" and
              #documents[2].edits == 2,
              "rename crossed the type/value or lexical shadow boundary")
end

local function separates_declaration_namespaces(is_interface: boolean,
                                                is_local: boolean)
  preload_real_compiler()
  local provider_file = test_paths.workspace_root() .. "/namespace_provider.titan"
  local consumer_file = test_paths.workspace_root() .. "/namespace_consumer.titan"
  local local_prefix = is_local and "local " or ""
  local type_declaration = local_prefix .. "type Shared = integer\n"
  local value_declaration = local_prefix .. "Shared = 7\n"
  local value_use = "Shared"
  if is_interface then
    type_declaration = "interface Shared\n  function read(): integer\nend\n"
    value_declaration = "function Shared(): integer return 7 end\n"
    value_use = "Shared()"
  end
  local provider_source = type_declaration .. value_declaration ..
    "function consume(input: Shared): integer\n" ..
    "  return " .. value_use .. "\nend\n" ..
    "function shadow(): integer\n" ..
    "  local Shared = 5\n  return Shared + 1\nend\n"
  local consumer_source = "local provider = import \"namespace_provider" ..
    (is_local and ".titan" or "") .. "\"\n" ..
    "function consume(input: provider.Shared): integer\n" ..
    "  return provider." .. value_use .. "\nend\n"
  local projects = {
    bridge.ProjectModule.new("namespace_provider", {
      bridge.SourceFile.new(provider_file, provider_source),
    }),
    bridge.ProjectModule.new("namespace_consumer", {
      bridge.SourceFile.new(consumer_file, consumer_source),
    }),
  }
  local analysis = bridge.load():analyze("namespace_consumer", projects)
  test.assert(#analysis.diagnostics == 0,
              "compiler rejected same-spelled type and value declarations")
  local model = features.build(projects, analysis.modules)
  defer model:close()
  local type_definition = marked_name_position(
    provider_source, is_interface and "interface Shared" or "type Shared", "Shared")
  local value_definition = marked_name_position(
    provider_source, is_interface and "function Shared" or "Shared = 7", "Shared")
  local type_use = marked_name_position(
    consumer_source, "input: provider.Shared", "Shared")
  local value_reference = marked_name_position(
    consumer_source, "return provider.Shared", "Shared")
  assert_namespace_definition_and_references(
    model, provider_file, consumer_file, type_definition,
    marked_name_position(provider_source, "input: Shared", "Shared"), type_use)
  assert_namespace_definition_and_references(
    model, provider_file, consumer_file, value_definition,
    marked_name_position(provider_source, "return Shared", "Shared"),
    value_reference)

  local shadow_use = marked_name_position(
    provider_source, "return Shared + 1", "Shared")
  local shadow_definition? = model:definition(provider_file, shadow_use)
  local expected_shadow = marked_name_position(
    provider_source, "  local Shared", "Shared")
  test.assert(shadow_definition ~= nil and
              shadow_definition.range.start.line == expected_shadow.line and
              shadow_definition.range.start.character == expected_shadow.character and
              #model:references(provider_file, shadow_use, false) == 1,
              "module namespace identity absorbed a lexical shadow")

  local type_hover? = model:hover(consumer_file, type_use)
  local value_hover? = model:hover(consumer_file, value_reference)
  test.assert(type_hover ~= nil and value_hover ~= nil,
              "namespace distinction lost a hover target")
  if is_interface then
    test.assert(type_hover.summary_markdown ~= nil and
                strings.find(type_hover.summary_markdown, "**interface**") ~= nil and
                type_hover.callable_signature == nil and
                value_hover.callable_signature ~= nil,
                "Interface hover merged with its same-spelled callable")
  end
  local visibility = is_local and "module" or "exported"
  test.assert(strings.find(type_hover:markdown(), "Visibility: " .. visibility) ~= nil and
              strings.find(value_hover:markdown(), "Visibility: " .. visibility) ~= nil,
              "namespace identity changed declaration visibility")
  assert_namespace_rename(model, consumer_file, type_use)
  assert_namespace_rename(model, consumer_file, value_reference)
end

function test_compiler_bridge_separates_type_and_value_namespaces(
    context: test.Context)
  context:run("exported_alias_and_variable", function(_child: test.Context)
    run_bridge(function() separates_declaration_namespaces(false, false) end)
  end)
  context:run("interface_and_function", function(_child: test.Context)
    run_bridge(function() separates_declaration_namespaces(true, false) end)
  end)
  context:run("source_visible_alias_and_variable", function(_child: test.Context)
    run_bridge(function() separates_declaration_namespaces(false, true) end)
  end)
end

local function renames_into_the_other_namespace(rename_type: boolean)
  preload_real_compiler()
  local filename = test_paths.workspace_root() .. "/namespace_rename.titan"
  local source = [[type Input = integer
Shared = 7
function read(input: Input): integer
  return Shared
end
]]
  local projects = {bridge.ProjectModule.new("namespace_rename", {
    bridge.SourceFile.new(filename, source),
  })}
  local analysis = bridge.load():analyze("namespace_rename", projects)
  test.assert(#analysis.diagnostics == 0, "namespace rename fixture did not compile")
  local model = features.build(projects, analysis.modules)
  defer model:close()
  local position = marked_name_position(
    source, rename_type and "input: Input" or "return Shared",
    rename_type and "Input" or "Shared")
  local candidate?, candidate_error? = model:rename(
    filename, position, rename_type and "Shared" or "Input")
  test.assert(candidate_error == nil and candidate ~= nil,
              "legal cross-namespace rename did not produce a candidate")
  local checked = bridge.load():analyze(
    "namespace_rename", candidate:edited_project_modules())
  local verified?, verification_error? = candidate:preflight(checked)
  test.assert(#checked.diagnostics == 0 and verification_error == nil and
              verified ~= nil and #verified:document_edits() == 1 and
              #verified:document_edits()[1].edits == 2,
              "rename confused the opposite namespace with a declaration collision")
end

function test_compiler_bridge_allows_rename_into_the_other_namespace(
    context: test.Context)
  context:run("type_into_value_name", function(_child: test.Context)
    run_bridge(function() renames_into_the_other_namespace(true) end)
  end)
  context:run("value_into_type_name", function(_child: test.Context)
    run_bridge(function() renames_into_the_other_namespace(false) end)
  end)
end

local function joins_nominal_type_and_constructor_namespaces()
  preload_real_compiler()
  local projects = {
    bridge.ProjectModule.new("nominal_provider", {bridge.SourceFile.new(
      test_paths.workspace_root() .. "/nominal_provider.titan", [[record Box
  amount: integer
end
union Choice
  some(integer)
  none()
end
type BoxAlias = Box
type ChoiceAlias = Choice
]])}),
    bridge.ProjectModule.new("nominal_consumer", {bridge.SourceFile.new(
      test_paths.workspace_root() .. "/nominal_consumer.titan", [[local p = import "nominal_provider"
function make(box: p.Box): p.Choice
  local other: p.BoxAlias = p.BoxAlias.new(box.amount)
  local choice: p.ChoiceAlias = p.ChoiceAlias.some(other.amount)
  return p.Choice.some(p.Box.new(other.amount).amount)
end
]])}),
  }
  local analysis = bridge.load():analyze("nominal_consumer", projects)
  test.assert(#analysis.diagnostics == 0,
              "compiler rejected nominal namespace fixture")
  local provider? = analysis:find_module("nominal_provider")
  local consumer? = analysis:find_module("nominal_consumer")
  test.assert(provider ~= nil and consumer ~= nil,
              "nominal namespace fixture lost a module")
  local names = {"Box", "Choice", "BoxAlias", "ChoiceAlias"}
  for index = 1, #names do
    local identity? = symbol_identity(provider, names[index])
    test.assert(identity ~= nil and identity == symbol_identity(consumer, names[index]),
                "type and constructor uses split their nominal or alias declaration")
  end
  test.assert(symbol_identity(provider, "Box") ~= symbol_identity(provider, "BoxAlias") and
              symbol_identity(provider, "Choice") ~= symbol_identity(provider, "ChoiceAlias"),
              "a transparent alias merged with its target declaration")
  local model = features.build(projects, analysis.modules)
  model:close()
end

function test_compiler_bridge_joins_nominal_type_and_constructor_namespaces(
    _context: test.Context)
  run_bridge(joins_nominal_type_and_constructor_namespaces)
end

local function overlays_current_header_observations_on_project_payloads()
  preload_real_compiler()
  local root = test_paths.temporary_name()
  fs.unlink(root)
  fs.mkdir(root)
  local header = root .. "/observed.h"
  fs.write_file(header,"typedef long project_observed_word;\n")
  defer do fs.unlink(header); fs.rmdir(root) end
  local name = "project_observed_header"
  local projects = {bridge.ProjectModule.new(name,{
    bridge.SourceFile.new(root .. "/project_observed_header.titan",
      "foreign import \"" .. header .. "\"\n" ..
      "function answer(): integer return 42 end\n")})}
  local compiler = bridge.load()
  local analysis = compiler:analyze(name,projects)
  test.assert(#analysis.diagnostics == 0,"header observation payload fixture failed")
  local snapshot = analysis:find_module(name) as bridge.ModuleSnapshot
  local current: {bridge.CHeaderDependency} = {}
  local expected: bridge.HeaderObservation? = nil
  for index = 1, #snapshot.c_header_dependencies do
    local input = snapshot.c_header_dependencies[index]
    local observation? = input.observation
    if input.path == header and observation ~= nil then
      observation = bridge.HeaderObservation.new(observation.modified_seconds + 1,
        observation.modified_nanoseconds,observation.physical_identity,
        observation.precision,observation.size,observation.changed_seconds,observation.changed_nanoseconds)
      expected = observation
    end
    current[index] = bridge.CHeaderDependency.new(
      input.kind,input.path,input.identity,observation)
  end
  test.assert(expected ~= nil,"header fixture omitted its physical observation")
  local payloads = compiler:export_projects(projects,{name})
  test.assert(#payloads == 1,"header fixture did not encode its project declarations")
  local bytes = payloads[1].payload
  local observed = bridge.ProjectPayload.new(name,bytes,current)
  local restarted = bridge.load()
  local restored = restarted:restore_projects(projects,{observed})
  test.assert(#restored == 1 and restored[1] == name and observed.payload == bytes,
    "observation overlay changed or rejected the saved manifest bytes")
  assert_declared_project_entry(restarted, name)
  local inputs = retained_header_inputs(restarted, name)
  local matched = false
  for index = 1, #inputs do
    local input = inputs[index]
    local observation? = input.observation
    if input.path == header and observation ~= nil then
      matched = observation.modified_seconds ==
        (expected as bridge.HeaderObservation).modified_seconds and
        observation.modified_nanoseconds ==
          (expected as bridge.HeaderObservation).modified_nanoseconds
    end
  end
  test.assert(matched,"manifest restoration discarded current SQL header observations")
end

function test_compiler_bridge_overlays_current_header_observations_on_project_payloads(
    _context: test.Context)
  run_bridge(overlays_current_header_observations_on_project_payloads)
end

local function assert_clean_ffi_analysis(analysis: bridge.Analysis,
                                         subject: string)
  local messages = strings.writer()
  for index = 1, #analysis.diagnostics do
    messages:write(analysis.diagnostics[index].message .. "\n")
  end
  test.assert(#analysis.diagnostics == 0, subject .. ": " .. messages:drain())
end

local function preserves_combined_ffi_namespace_semantics()
  preload_real_compiler()
  local root = test_paths.temporary_name()
  fs.unlink(root)
  fs.mkdir(root)
  local first_header = root .. "/ordered_base.h"
  local second_header = root .. "/ordered_api.h"
  fs.write_file(first_header,
    "#ifndef BRIDGE_ORDERED_BASE_H\n#define BRIDGE_ORDERED_BASE_H\n" ..
    "typedef int ordered_word;\n#define ORDERED_BIAS 4\n#endif\n")
  fs.write_file(second_header,
    "enum ordered_code { ORDERED_CODE = ORDERED_BIAS + 3 };\n" ..
    "int ordered_call(ordered_word amount);\n")
  defer do
    fs.unlink(second_header)
    fs.unlink(first_header)
    fs.rmdir(root)
  end
  local source = "foreign import \"" .. first_header .. "\"\n" ..
    "foreign import \"" .. second_header .. "\"\n" ..
    "local function use(input: foreign ordered_word): integer\n" ..
    "  local left: integer = ffi.ordered_call { amount = input }\n" ..
    "  return left + ffi.ordered_call(input) + ffi.ORDERED_CODE\n" ..
    "end\n"
  local first_file = root .. "/ordered_first.titan"
  local second_file = root .. "/ordered_second.titan"
  local projects = {
    bridge.ProjectModule.new("ordered_first", {
      bridge.SourceFile.new(first_file, source),
    }),
    bridge.ProjectModule.new("ordered_second", {
      bridge.SourceFile.new(second_file, source),
    }),
  }
  local compiler = bridge.load()
  local analysis = compiler:analyze("ordered_first", projects)
  assert_clean_ffi_analysis(analysis, "combined header namespace failed")
  local first: bridge.ModuleSnapshot = analysis:find_module("ordered_first")
  local second: bridge.ModuleSnapshot = analysis:find_module("ordered_second")
  test.assert(#first.imports == 0 and #second.imports == 0,
              "foreign directives became Titan dependency aliases")
  test.assert(symbol_identity(first, "ffi") ~= nil and
              symbol_identity(first, "ffi") ~= symbol_identity(second, "ffi") and
              symbol_identity(first, "ordered_call") ~= nil and
              symbol_identity(first, "ordered_call") ~=
                symbol_identity(second, "ordered_call") and
              symbol_identity(first, "amount") ~= nil and
              symbol_identity(first, "amount") ~= symbol_identity(second, "amount"),
              "different modules shared a builtin, C member, or parameter identity")
  local directives = 0
  for index = 1, #first.nodes do
    local node = first.nodes[index]
    if node.tag == "Ast.TopLevelForeignImport" then
      directives = directives + 1
      test.assert(node.name == nil,
                  "a foreign directive invented a local binding")
    end
  end
  test.assert(directives == 2, "ordered foreign directives disappeared")
  local model = features.build(projects, analysis.modules)
  defer model:close()
  local root_position = marked_name_position(
    source, "ffi.ordered_call {", "ffi")
  local root_hover? = model:hover(first_file, root_position)
  test.assert(root_hover ~= nil and
              strings.find(root_hover:markdown(), "C module ffi") ~= nil,
              "value root lost builtin namespace hover")
  local references = model:references(first_file, root_position, true)
  test.assert(#references == 3,
              "builtin references included an unqualified foreign type or definition")
  local first_uri: string = source_text.path_to_file_uri(first_file)
  for index = 1, #references do
    test.assert(references[index].uri == first_uri,
                "builtin references crossed module environments")
  end
  local renamed?, rename_error? = model:rename(
    first_file, root_position, "native")
  test.assert(model:definition(first_file, root_position) == nil and
              renamed == nil and rename_error ~= nil,
              "builtin FFI namespace became a navigation or rename target")
  local call_position = marked_name_position(
    source, "ffi.ordered_call {", "ordered_call")
  local call_hover? = model:hover(first_file, call_position)
  test.assert(call_hover ~= nil and call_hover.callable_signature ~= nil and
              strings.find(call_hover.callable_signature.display,
                "ffi.ordered_call(amount:") ~= nil and
              #model:references(first_file, call_position, true) == 2 and
              model:definition(first_file, call_position) == nil,
              "combined C calls lost named hover or module-scoped references")
  local enum_position = marked_name_position(source, "ffi.ORDERED_CODE", "ORDERED_CODE")
  test.assert(model:hover(first_file, enum_position) ~= nil,
              "combined-header enum lost its saved semantic occurrence")
  local parameter_position = marked_name_position(source, "amount = input", "amount")
  test.assert(#model:references(first_file, parameter_position, true) == 1 and
              model:definition(first_file, parameter_position) == nil,
              "C parameter references crossed module environments or navigated into C")
end

function test_compiler_bridge_preserves_combined_ffi_namespace_semantics(
    _context: test.Context)
  run_bridge(preserves_combined_ffi_namespace_semantics)
end

local function preserves_foreign_type_and_current_module_metadata()
  preload_real_compiler()
  local filename = test_paths.workspace_root() .. "/foreign_type_metadata.titan"
  local source = [[foreign type Word = int
record Word
  amount: integer
end
local function inspect(input: foreign Word): integer
  local storage: owned Word[] = foreign Word.new_array(2)
  storage[0] = input
  local copied: foreign Word = storage[0]
  return copied + foreign Word.sizeof
end
function make(Word: integer): Word
  local made: M.Word = M.Word.new(Word)
  return made
end
]]
  local projects = {bridge.ProjectModule.new("foreign_type_metadata", {
    bridge.SourceFile.new(filename, source),
  })}
  local analysis = bridge.load():analyze("foreign_type_metadata", projects)
  assert_clean_ffi_analysis(analysis, "foreign type and current-module fixture")
  local snapshot: bridge.ModuleSnapshot = analysis:find_module("foreign_type_metadata")
  local seen: {string: boolean} = {}
  local foreign_identity: string? = nil
  local record_identity: string? = nil
  local owner_type = false
  for index = 1, #snapshot.nodes do
    local node = snapshot.nodes[index]
    seen[node.tag] = true
    if node.tag == "Ast.TopLevelForeignTypeAlias" then
      test.assert(node.name == "Word" and node.is_local,
                  "foreign alias lost its name or source-local visibility")
    end
  end
  for index = 1, #snapshot.symbols do
    local symbol = snapshot.symbols[index]
    if symbol.name == "Word" then
      if symbol.location.line == 1 then
        foreign_identity = symbol.declaration_id
        test.assert(symbol.exact_span == nil,
                    "foreign type declaration became a navigation anchor")
      elseif symbol.location.line == 2 then
        record_identity = symbol.declaration_id
      elseif symbol.location.line == 5 or symbol.location.line == 6 then
        test.assert(symbol.declaration_id == foreign_identity,
                    "foreign type mention lost its alias identity")
      elseif symbol.location.line == 12 and symbol.location.column < 34 then
        test.assert(symbol.declaration_id == record_identity,
                    "M.Word resolved to a shadowing value or the foreign alias")
      end
    elseif symbol.name == "storage" and symbol.type_info ~= nil then
      owner_type = symbol.type_info.tag == "Type.COwned" and
        symbol.type_info.display == "owned Word[]"
    end
  end
  test.assert(seen["Ast.TypeForeignName"] and seen["Ast.TypeOwned"] and
              seen["Ast.ExpForeignType"] and
              seen["Ast.TopLevelForeignTypeAlias"] and owner_type,
              "new foreign type nodes or their owned type metadata were dropped")
  test.assert(foreign_identity ~= nil and record_identity ~= nil and
              foreign_identity ~= record_identity,
              "foreign and Titan type declarations shared one identity")
  local model = features.build(projects, analysis.modules)
  defer model:close()
  local foreign_position = marked_name_position(source, "input: foreign Word", "Word")
  local nominal_position = marked_name_position(source, "M.Word.new", "Word")
  test.assert(model:definition(filename, foreign_position) == nil and
              model:definition(filename, nominal_position) ~= nil,
              "foreign and current-module references lost their navigation boundaries")
end

function test_compiler_bridge_preserves_foreign_type_and_current_module_metadata(
    _context: test.Context)
  run_bridge(preserves_foreign_type_and_current_module_metadata)
end

local function assert_inherited_header_inputs(inputs: {bridge.CHeaderDependency},
                                              first: string, second: string)
  local saw_first, saw_second = false, false
  for index = 1, #inputs do
    local input = inputs[index]
    case input.kind
    when file() then
      if input.path == first then saw_first = true end
      if input.path == second then saw_second = true end
    else
    end
  end
  test.assert(saw_first and saw_second,
              "source-imported C environment lost its physical header closure")
end

local function preserves_inherited_ffi_payloads(external_provider: boolean)
  preload_real_compiler()
  local root = test_paths.temporary_name()
  fs.unlink(root)
  fs.mkdir(root)
  local first_header = root .. "/inherited_base.h"
  local second_header = root .. "/inherited_api.h"
  local provider_file = root .. "/ffi_provider.titan"
  local consumer_file = root .. "/ffi_consumer.titan"
  fs.write_file(first_header,
    "#ifndef BRIDGE_INHERITED_BASE_H\n#define BRIDGE_INHERITED_BASE_H\n" ..
    "typedef int inherited_word;\n#define INHERITED_BIAS 4\n#endif\n")
  fs.write_file(second_header,
    "#ifndef BRIDGE_INHERITED_API_H\n#define BRIDGE_INHERITED_API_H\n" ..
    "enum inherited_code { INHERITED_CODE = INHERITED_BIAS + 3 };\n" ..
    "int inherited_call(inherited_word amount);\n#endif\n")
  local provider_source = "foreign import \"" .. first_header .. "\"\n" ..
    "foreign import \"" .. second_header .. "\"\n" ..
    "foreign function native_add(input: inherited_word): inherited_word\n" ..
    "  return input + 1\n" ..
    "end\n"
  fs.write_file(provider_file, provider_source)
  defer do
    fs.unlink(provider_file)
    fs.unlink(second_header)
    fs.unlink(first_header)
    fs.rmdir(root)
  end
  local consumer_source: function (integer): string = function (extra: integer): string
    return "local provider = import \"ffi_provider.titan\"\n" ..
      "local function answer(input: foreign inherited_word): integer\n" ..
      "  local native: integer = provider.native_add(input)\n" ..
      "  return native + ffi.inherited_call(input) + ffi.INHERITED_CODE + " .. extra .. "\n" ..
      "end\n"
  end
  local consumer = bridge.ProjectModule.new("ffi_consumer", {
    bridge.SourceFile.new(consumer_file, consumer_source(0)),
  })
  local projects: {bridge.ProjectModule} = {consumer}
  local selected = {"ffi_consumer"}
  if not external_provider then
    projects[#projects + 1] = bridge.ProjectModule.new("ffi_provider", {
      bridge.SourceFile.new(provider_file, provider_source),
    })
    selected[#selected + 1] = "ffi_provider"
  end
  local compiler = bridge.load()
  compiler:configure(bridge.CompilerConfiguration.new { source_roots = {root} })
  local initial = compiler:analyze("ffi_consumer", projects)
  assert_clean_ffi_analysis(initial, "inherited FFI source context failed")
  local consumer_snapshot: bridge.ModuleSnapshot = initial:find_module("ffi_consumer")
  local provider_snapshot: bridge.ModuleSnapshot = initial:find_module("ffi_provider")
  assert_inherited_header_inputs(consumer_snapshot.c_header_dependencies, first_header, second_header)
  assert_inherited_header_inputs(provider_snapshot.c_header_dependencies, first_header, second_header)
  if external_provider then
    test.assert(#provider_snapshot.nodes == 0 and #provider_snapshot.symbols == 0 and
                not compiler:has_project_entry("ffi_provider"),
                "inherited FFI metadata retained an external provider AST")
  end
  local model = features.build(projects, initial.modules)
  defer model:close()
  local native_position = marked_name_position(
    consumer_source(0), "provider.native_add", "native_add")
  local inherited_position = marked_name_position(
    consumer_source(0), "ffi.inherited_call", "inherited_call")
  local native_hover? = model:hover(consumer_file, native_position)
  local inherited_hover? = model:hover(consumer_file, inherited_position)
  test.assert(native_hover ~= nil and native_hover.callable_signature ~= nil and
              strings.find(native_hover.callable_signature.display,
                "ffi_provider.native_add(input:") ~= nil and
              inherited_hover ~= nil and inherited_hover.callable_signature ~= nil and
              strings.find(inherited_hover.callable_signature.display,
                "ffi.inherited_call(amount:") ~= nil,
              "source-private and inherited C callables lost their distinct hover owners")
  local payloads = compiler:export_projects(projects, selected)
  test.assert(#payloads == #selected,
              "inherited C declarations prevented project manifest export")
  local restarted = bridge.load()
  restarted:configure(bridge.CompilerConfiguration.new { source_roots = {root} })
  local restored = restarted:restore_projects(projects, payloads)
  test.assert(#restored == #selected,
              "inherited C declarations prevented project manifest restoration")
  for index = 1, #restored do
    assert_declared_project_entry(compiler, restored[index])
    assert_declared_project_entry(restarted, restored[index])
    assert_inherited_header_inputs(retained_header_inputs(restarted, restored[index]),
      first_header, second_header)
  end
  test.assert(restarted:has_project_entry("ffi_provider") == not external_provider,
              "manifest restoration changed the project/external ownership boundary")
  projects[1] = bridge.ProjectModule.new("ffi_consumer", {
    bridge.SourceFile.new(consumer_file, consumer_source(1)),
  })
  local changed = restarted:analyze_incremental(projects, {"ffi_consumer"}, {})
  assert_clean_ffi_analysis(changed, "editing a restored inherited FFI consumer failed")
  local edited: bridge.ModuleSnapshot = changed:find_module("ffi_consumer")
  assert_inherited_header_inputs(edited.c_header_dependencies, first_header, second_header)
  local replayed = features.build(projects, {provider_snapshot, edited})
  defer replayed:close()
  local replayed_native? = replayed:hover(consumer_file, native_position)
  local replayed_inherited? = replayed:hover(consumer_file, inherited_position)
  test.assert(replayed_native ~= nil and replayed_inherited ~= nil and
              replayed_native:markdown() == native_hover:markdown() and
              replayed_inherited:markdown() == inherited_hover:markdown(),
              "checking restored inherited C declarations changed callable semantics")
  assert_declared_project_entry(restarted, "ffi_consumer")
  if not external_provider then
    test.assert(changed:find_module("ffi_provider") == nil,
                "consumer body edit rechecked its unchanged project C environment")
  else
    local external: bridge.ModuleSnapshot = changed:find_module("ffi_provider")
    test.assert(#external.nodes == 0 and #external.symbols == 0 and
                not restarted:has_project_entry("ffi_provider"),
                "consumer body edit retained its external provider AST")
  end
end

function test_compiler_bridge_restores_inherited_project_ffi_context(_context: test.Context)
  run_bridge(function () preserves_inherited_ffi_payloads(false) end)
end

function test_compiler_bridge_restores_inherited_external_ffi_metadata(_context: test.Context)
  run_bridge(function () preserves_inherited_ffi_payloads(true) end)
end

local function assert_contextual_ffi_rename(model: features.Features,
                                            filename: string, source: string,
                                            marker: string, name: string)
  local candidate?, candidate_error? = model:rename(
    filename, marked_name_position(source, marker, name), "ffi")
  test.assert(candidate ~= nil and candidate_error == nil,
              "contextual ffi rename was rejected before compiler preflight")
  local analysis = bridge.load():analyze(
    "ffi_rename_consumer", candidate:edited_project_modules())
  local verified?, verification_error? = candidate:preflight(analysis)
  assert_clean_ffi_analysis(analysis, "rename to shadowable ffi failed")
  test.assert(verified ~= nil and verification_error == nil,
              "rename to ffi changed the selected binding")
end

local function allows_ffi_member_and_shadowing_binding_renames()
  preload_real_compiler()
  local filename = test_paths.workspace_root() .. "/ffi_rename_consumer.titan"
  local source = [[local provider = import "ffi_rename_provider"
record Item
  amount: integer
end
function Item:read(): integer return self.amount end
function answer(): integer
  local selected = Item.new { amount = 1 }
  return selected:read() + provider.answer()
end
]]
  local projects = {
    bridge.ProjectModule.new("ffi_rename_provider", {
      bridge.SourceFile.new(test_paths.workspace_root() .. "/ffi_rename_provider.titan",
        "function answer(): integer return 41 end\n"),
    }),
    bridge.ProjectModule.new("ffi_rename_consumer", {
      bridge.SourceFile.new(filename, source),
    }),
  }
  local analysis = bridge.load():analyze("ffi_rename_consumer", projects)
  assert_clean_ffi_analysis(analysis, "contextual ffi rename fixture failed")
  local model = features.build(projects, analysis.modules)
  defer model:close()
  assert_contextual_ffi_rename(model, filename, source, "amount: integer", "amount")
  assert_contextual_ffi_rename(model, filename, source, "Item:read", "read")
  assert_contextual_ffi_rename(model, filename, source, "local selected", "selected")
  assert_contextual_ffi_rename(model, filename, source, "local provider", "provider")
  assert_contextual_ffi_rename(model, filename, source, "function answer", "answer")
  assert_contextual_ffi_rename(model, filename, source, "record Item", "Item")
end

function test_compiler_bridge_allows_ffi_member_and_shadowing_binding_renames(
    _context: test.Context)
  run_bridge(allows_ffi_member_and_shadowing_binding_renames)
end

local function union_parts_fixture():
    ({bridge.ProjectModule}, string, string, string, string)
  local provider_file = test_paths.workspace_root() .. "/union_parts_provider.titan"
  local consumer_file = test_paths.workspace_root() .. "/union_parts_consumer.titan"
  local provider = [[union Packet<|T|>
  moved(x: T, text: string, end: integer, note: string?)
  other(x: T)
  legacy(T)
  empty()
end
]]
  local consumer = [[local p = import "union_parts_provider"
function create(): p.Packet<|integer|>
  return p.Packet<|integer|>.moved {text = "ready", x = 1, end = 2}
end
function named<|T|>(candidate: p.Packet<|integer|>, fallback: T): integer
  case candidate
  when moved{word = text; x; finish = end} then
    local observed = word
    return x + finish
  catch
    return x
  else
    return 0
  end
end
function positional(candidate: p.Packet<|integer|>): integer
  case candidate
  when moved(coordinate) then return coordinate
  else return 0
  end
end
function generic_create<|T|>(item: T): p.Packet<|T|>
  return p.Packet<|T|>.other(item)
end
type IntPacket = p.Packet<|integer|>
function alias_create(): IntPacket
  return IntPacket.other(1)
end
]]
  return {
    bridge.ProjectModule.new("union_parts_provider", {
      bridge.SourceFile.new(provider_file, provider),
    }),
    bridge.ProjectModule.new("union_parts_consumer", {
      bridge.SourceFile.new(consumer_file, consumer),
    }),
  }, provider_file, consumer_file, provider, consumer
end

local function assert_union_part_definition(model: features.Features,
                                            source_file: string,
                                            source: string, marker: string,
                                            name: string,
                                            provider_file: string,
                                            provider: string,
                                            declaration_marker: string)
  local definition? = model:definition(source_file,
    marked_name_position(source, marker, name))
  local expected = marked_name_position(provider, declaration_marker, name)
  local provider_uri?, provider_uri_error? =
    source_text.path_to_file_uri(provider_file)
  test.assert(provider_uri_error == nil and provider_uri ~= nil,
    "named union provider path did not become a file URI")
  test.assert(definition ~= nil and definition.uri == provider_uri and
    definition.range.start.line == expected.line and
    definition.range.start.character == expected.character,
    "named union part did not resolve to its own variant declaration: " .. marker)
end

local function preserves_named_union_part_semantics()
  preload_real_compiler()
  local projects, provider_file, consumer_file, provider, consumer = union_parts_fixture()
  local analysis = bridge.load():analyze("union_parts_consumer", projects)
  assert_clean_ffi_analysis(analysis, "named union part fixture failed")
  local model = features.build(projects, analysis.modules)
  defer model:close()
  assert_union_part_definition(model, consumer_file, consumer, "x = 1", "x",
    provider_file, provider, "x: T")
  assert_union_part_definition(model, consumer_file, consumer, "word = text", "text",
    provider_file, provider, "text: string")
  assert_union_part_definition(model, consumer_file, consumer, "finish = end", "end",
    provider_file, provider, "end: integer")
  local references = model:references(provider_file,
    marked_name_position(provider, "x: T", "x"), true)
  test.assert(#references == 3,
    "part references lost constructor/shorthand or included the other variant's x")
  local other = model:references(provider_file,
    marked_name_position(provider, "other(x", "x"), true)
  test.assert(#other == 1, "same-spelled union parts shared a declaration identity")
  local local_references = model:references(consumer_file,
    marked_name_position(consumer, "; x;", "x"), true)
  test.assert(#local_references == 3,
    "shorthand local binding lost its body/catch references or included part labels")
  local catch_hover? = model:hover(consumer_file,
    marked_name_position(consumer, "    return x\n", "x"))
  test.assert(catch_hover ~= nil and strings.find(catch_hover:markdown(), "integer") ~= nil,
    "generic case binder lost its specialized type inside catch")
  local positional? = model:definition(consumer_file,
    marked_name_position(consumer, "return coordinate", "coordinate"))
  local positional_decl = marked_name_position(consumer, "moved(coordinate)", "coordinate")
  test.assert(positional ~= nil and positional.range.start.line == positional_decl.line and
    positional.range.start.character == positional_decl.character,
    "positional prefix binder lost its source declaration")
  local union_hover? = model:hover(consumer_file,
    marked_name_position(consumer, "candidate: p.Packet", "Packet"))
  test.assert(union_hover ~= nil and
    strings.find(union_hover:markdown(), "moved(x: integer, text: string, end: integer, note: string?)") ~= nil and
    strings.find(union_hover:markdown(), "legacy(value: integer)") ~= nil,
    "union hover lost named parts, generic specialization, or the legacy value part")
  local constructor? = model:hover(consumer_file,
    marked_name_position(consumer, ".moved {", "moved"))
  test.assert(constructor ~= nil and constructor.callable_signature ~= nil and
    constructor.callable_signature.display ==
      "union_parts_provider.Packet<|integer|>.moved(x: integer, text: string, " ..
      "end: integer, note: string?): union_parts_provider.Packet<|integer|>",
    "variant constructor hover lost its applied named signature: " ..
      (constructor ~= nil and constructor:markdown() or "missing hover"))
  local create? = model:hover(consumer_file,
    marked_name_position(consumer, "function create", "create"))
  test.assert(create ~= nil and create.callable_signature ~= nil and
    create.callable_signature.display ==
      "union_parts_consumer.create(): union_parts_provider.Packet<|integer|>",
    "analysis-only checking erased the constructor caller's return type")
  local generic_constructor? = model:hover(consumer_file,
    marked_name_position(consumer, ".other(item)", "other"))
  test.assert(generic_constructor ~= nil and generic_constructor.callable_signature ~= nil and
    generic_constructor.callable_signature.display ==
      "union_parts_provider.Packet<|T|>.other(x: T): union_parts_provider.Packet<|T|>",
    "generic function constructor hover lost its checked type parameter")
  local fixed_constructor? = model:hover(consumer_file,
    marked_name_position(consumer, "IntPacket.other", "other"))
  test.assert(fixed_constructor ~= nil and fixed_constructor.callable_signature ~= nil and
    fixed_constructor.callable_signature.display ==
      "union_parts_provider.Packet<|integer|>.other(x: integer): " ..
      "union_parts_provider.Packet<|integer|>",
    "fixed alias constructor hover lost its applied signature")
  local generic_parameter = marked_name_position(consumer, "generic_create<|T|>", "T")
  local parameter_uses = model:references(consumer_file, generic_parameter, true)
  test.assert(#parameter_uses == 4,
    "written constructor namespace type argument was not indexed exactly once")
end

function test_compiler_bridge_preserves_named_union_part_semantics(_context: test.Context)
  run_bridge(preserves_named_union_part_semantics)
end

local function renames_named_union_part(rename_part: boolean, keyword_part: boolean)
  preload_real_compiler()
  local projects, provider_file, consumer_file, provider, consumer = union_parts_fixture()
  local analysis = bridge.load():analyze("union_parts_consumer", projects)
  assert_clean_ffi_analysis(analysis, "named union rename fixture failed")
  local model = features.build(projects, analysis.modules)
  defer model:close()
  local filename = rename_part and provider_file or consumer_file
  local source = rename_part and provider or consumer
  local marker = rename_part and (keyword_part and "end: integer" or "x: T") or "; x;"
  local name = keyword_part and "end" or "x"
  local candidate?, failure? = model:rename(filename,
    marked_name_position(source, marker, name), "axis")
  test.assert(candidate ~= nil and failure == nil, "named union rename had no candidate")
  local edited = candidate:edited_project_modules()
  local edited_provider = edited[1].files[1].contents
  local edited_consumer = edited[2].files[1].contents
  if rename_part and keyword_part then
    test.assert(strings.find(edited_provider, "axis: integer") ~= nil and
      strings.find(edited_consumer, "finish = axis") ~= nil and
      strings.find(edited_consumer, "axis = 2") ~= nil,
      "keyword part rename lost its declaration, constructor key, or case selector")
  elseif rename_part then
    test.assert(strings.find(edited_provider, "moved(axis: T") ~= nil and
      strings.find(edited_provider, "other(x: T)") ~= nil and
      strings.find(edited_consumer, "text; x = axis;") ~= nil and
      strings.find(edited_consumer, "axis = 1") ~= nil and
      strings.find(edited_consumer, "return x + finish") ~= nil,
      "part rename changed its local shorthand binder or another variant")
  else
    test.assert(edited_provider == provider and
      strings.find(edited_consumer, "text; axis = x;") ~= nil and
      strings.find(edited_consumer, "return axis + finish") ~= nil and
      strings.find(edited_consumer, "    return axis\n") ~= nil and
      strings.find(edited_consumer, "x = 1") ~= nil,
      "local shorthand rename changed the selected part")
  end
  local checked = bridge.load():analyze("union_parts_consumer", edited)
  assert_clean_ffi_analysis(checked, "named union rename did not compile")
  local verified?, verify_failure? = candidate:preflight(checked)
  test.assert(verified ~= nil and verify_failure == nil,
    "named union rename failed identity preflight: " ..
      (verify_failure ~= nil and verify_failure.message or "no verified result"))
end

function test_compiler_bridge_renames_named_union_parts(context: test.Context)
  context:run("shorthand_local", function(_child: test.Context)
    run_bridge(function() renames_named_union_part(false, false) end)
  end)
  context:run("shorthand_part", function(_child: test.Context)
    run_bridge(function() renames_named_union_part(true, false) end)
  end)
  context:run("keyword_part", function(_child: test.Context)
    run_bridge(function() renames_named_union_part(true, true) end)
  end)
end

local function restores_named_union_part_descriptors()
  preload_real_compiler()
  local projects, provider_file, consumer_file, provider, consumer = union_parts_fixture()
  local compiler = bridge.load()
  local initial = compiler:analyze("union_parts_consumer", projects)
  assert_clean_ffi_analysis(initial, "cached union part fixture failed")
  local provider_snapshot = initial:find_module("union_parts_provider") as bridge.ModuleSnapshot
  local payloads = compiler:export_projects(projects, {"union_parts_provider", "union_parts_consumer"})
  local restored = bridge.load()
  test.assert(#restored:restore_projects(projects, payloads) == 2,
    "named union declaration descriptors did not restore")
  local changed = restored:analyze_incremental(projects, {"union_parts_consumer"}, {})
  assert_clean_ffi_analysis(changed, "restored union part descriptors were not usable")
  test.assert(changed:find_module("union_parts_provider") == nil,
    "unchanged union provider was rechecked after descriptor restoration")
  local consumer_snapshot = changed:find_module("union_parts_consumer") as bridge.ModuleSnapshot
  local model = features.build(projects, {provider_snapshot, consumer_snapshot})
  defer model:close()
  assert_union_part_definition(model, consumer_file, consumer, "x = 1", "x",
    provider_file, provider, "x: T")
  assert_union_part_definition(model, consumer_file, consumer, "word = text", "text",
    provider_file, provider, "text: string")
  test.assert(#model:references(provider_file,
    marked_name_position(provider, "x: T", "x"), true) == 3,
    "restored constructor/case metadata changed union part identities")
end

function test_compiler_bridge_restores_named_union_part_descriptors(_context: test.Context)
  run_bridge(restores_named_union_part_descriptors)
end

function test_compiler_bridge_native_windows_header_paths(_context: test.Context)
  if ffi.VSCODE_TITAN_WINDOWS == 0 then test.skip("native Windows paths") end
  local file: {string: value} = {
    ["kind"] = "file", ["path"] = "w:\\live\\api.h", ["identity"] = "file bytes",
  }
  local search: {string: value} = {
    ["kind"] = "search", ["path"] = "\\\\server\\share\\api.h",
    ["identity"] = "missing candidate",
  }
  local entries: {integer: value} = {file, search}
  local decoded = bridge.normalize_c_header_dependencies(entries, "test headers")
  test.assert(#decoded == 2 and decoded[1].path == "w:\\live\\api.h" and
              decoded[1].identity == "file bytes" and
              decoded[2].path == "\\\\server\\share\\api.h",
              "absolute native header paths changed their compiler provenance")
  file["path"] = "W:relative.h"
  local rejected = false
  do
    bridge.normalize_c_header_dependencies(entries, "test headers")
  catch
    rejected = error is bridge.BridgeError
  end
  test.assert(rejected, "drive-relative compiler header metadata was accepted")
end

local function add_windows_metadata_root(context: test.Context, name: string,
                                         path: string, expected: boolean)
  context:run(name, function(_child: test.Context)
    test.assert(bridge.metadata_absolute_path(path) == expected,
      "compiler metadata root classification disagreed: " .. path)
  end)
end

