foreign import "compiler_io_platform.h"
local fs = import "fs"
local test = import "test"
local lua = import "lua"
local strings = import "string"
local bridge = import "server.compiler_bridge.titan"
local embedded_interfaces = import "server.embedded_interfaces"
local features = import "server.semantic_features"
local logging = import "server.logging"
local source_text = import "server.source_text"
local test_runtime = import "server.test_runtime"
local content_identity = import "server.content_identity"
local test_paths = import "server.test_paths"
local completion_types = import "server.completion_types"
local system = import "os"


local function fixture_headers_root(): string
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then return "C:/headers" end
  return "/headers"
end

local function fixture_sdk_root(): string
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then return "C:/opt/titan/lib/titan/0.6" end
  return "/opt/titan/lib/titan/0.6"
end

local type EmptyFunction = function (): ()
local type FixtureInstaller =
  function (string, string?, string, string, string): value

local function run_bridge(body: EmptyFunction)
  do
    test_runtime.run(body)
  catch
    if error is bridge.BridgeError then
      local failure = error as bridge.BridgeError
      raise failure.module_name .. ": " .. failure.message
    end
    raise
  end
end

local function new_fixture_installer(): FixtureInstaller
  return lua.load([==[
return function(mode, contextual_provider_file, workspace_root, headers_root, sdk_root)
  local names = {
    "titan-compiler.parser",
    "titan-compiler.checker",
    "titan-compiler.types",
    "titan-compiler.driver",
    "titan-compiler.completion",
    "titan-compiler.documentation",
  }
  local old_path, old_cpath = package.path, package.cpath
  local old_loaded = {}
  for _, name in ipairs(names) do old_loaded[name] = package.loaded[name] end

  local integer = { _tag = "Type.Integer" }
  local float = { _tag = "Type.Float" }
  local function module_type(name)
    return { _tag = "Type.Module", name = name }
  end
  local function source_manifest(name)
    if name == "fixture" then
      if mode == "missing-source-manifest" then return nil end
      if mode == "empty-source-manifest" then return "" end
      if mode == "wrong-source-manifest" then return 42 end
    end
    return "Source(" .. string.format("%q", name) .. ")"
  end
  local parser = {
    parse = function() return {} end,
    error_to_string = function(value) return tostring(value) end,
  }
  local checker = { check = function() return module_type("unused"), {} end }
  local types = {
    registry = {},
    tostring = function(value)
      if value._tag == "Type.Integer" then return "integer" end
      if value._tag == "Type.Float" then return "float" end
      return value._tag
    end,
    serialize = function(value)
      return "Module(" .. string.format("%q", value.name) .. ",{}, {})"
    end,
  }
  local driver = {
    TITAN_ABI_VERSION = mode == "incompatible" and "99" or "2",
    TITAN_VERSION = "0.6.0",
    TITAN_LIBRARY_VERSION = "0.6",
    LANGUAGE_SERVER_API_VERSION =
      mode == "wrong-language-server-api" and 2 or 1,
    TITAN_SOURCE_PATH = ".",
    TITAN_BIN_PATH = "",
    INSTALL_PATHS = { titan_bin = sdk_root },
    imported = {},
  }
  driver.SOURCE_LABELS = { "windows", "darwin", "linux", "browser", "native" }
  local source_labels = {}
  for _, label in ipairs(driver.SOURCE_LABELS) do source_labels[label] = true end
  if mode ~= "same-api-missing-classify-source-filename" then
    driver.classify_source_filename = function(basename)
      local stem = basename:match("^(.*)%.titan$")
      if not stem then return nil end
      local base, label = stem:match("^(.+)%.([^.]+)$")
      if not label or not source_labels[label:lower()] then return basename end
      if label ~= label:lower() then
        return nil, nil, "mis-cased target label in source '" .. basename .. "'"
      end
      local previous_base, previous = base:match("^(.+)%.([^.]+)$")
      if previous_base and source_labels[previous:lower()] then
        return nil, nil, "stacked target labels in source '" .. basename .. "'"
      end
      return base .. ".titan", label
    end
  end
  driver.target_selection_labels = function(target)
    if target == "linux" or target == "darwin" or target == "windows" then
      return { target, "native" }
    end
    return { target }
  end
  driver.target_label_applies = function(target, label)
    return label == target or (label == "native" and
      (target == "linux" or target == "darwin" or target == "windows"))
  end
  driver.context_target = function() return "linux" end
  if mode == "missing-abi" then driver.TITAN_ABI_VERSION = nil end
  driver.encode_project_entry = function(entry, options)
    assert(type(options.sha256_binary) == "function")
    assert(type(options.yield) == "function")
    return "fixture-descriptor:" .. assert(entry.type.name)
  end
  driver.decode_project_entry = function() return nil, "fixture has no graph codec" end
  driver.project_entries_registry = function() return {} end
  driver.completion_binary_catalog = function(context)
    assert(type(context) == "table")
    assert(type(context.io) == "userdata")
    if mode == "completion-catalog" then
      local name = context.checked_source_modules[1]
      if name == "fixture.first" or name == "fixture.second" then
        local provider = contextual_provider_file ..
          (name == "fixture.second" and ".second" or "")
        assert(context.io:lstat(provider))
        local suffix = context.catalog_replacement and ".fresh" or ".old"
        return { [name .. suffix] = {
          serialized = "interface:" .. name .. suffix,
          kind = "static", filename = provider,
        } }
      end
    end
    return {}
  end
  -- These tests supply deliberately minimal AST/type fixtures. Descriptor
  -- normalization must use the same fake compiler boundary, rather than the
  -- real completion module's richer compiler representation.
  local completion = {
    describe = function(entry)
      assert(type(entry.type) == "table")
      return { candidates = {} }
    end,
  }
  if mode ~= "same-api-missing-compact-project-entry" then
    driver.compact_project_entry = function(entry, options)
      assert(type(options.yield) == "function")
      local compact = {}
      for key, value in pairs(entry) do
        if key ~= "ast" then compact[key] = value end
      end
      return compact
    end
  end
  driver.language_server_cache_identity = function() return "fixture-cache-identity" end
  driver.compiler_cache_stats = function()
    return { headers = { lookups = 0, hits = 0, misses = 0,
        file_reads = 0, file_hashes = 0, metadata_reuses = 0,
        search_checks = 0, memo_reuses = 0 },
      conversion = { lookups = 0, hits = 0, misses = 0 } }
  end
  if mode == "older-same-abi" then
    driver.LANGUAGE_SERVER_API_VERSION = nil
  end
  if mode ~= "same-api-missing-split-shell-words" then
    driver.split_shell_words = function(source)
      if source == "'unterminated" then
        return nil, "unfinished single-quoted string"
      end
      local result = {}
      for word in source:gmatch("%S+") do result[#result + 1] = word end
      return result
    end
  end
  local c_header_analysis_count = 0
  local c_header_analyses = {}
  if mode ~= "same-api-missing-c-header-analysis" then
    driver.new_c_header_analysis = function()
      c_header_analysis_count = c_header_analysis_count + 1
      if mode == "c-header-analysis-lifetime" then
        assert(c_header_analysis_count <= 2)
      elseif mode == "bad-c-header-analysis" then
        return 42
      end
      local analysis = { id = c_header_analysis_count }
      c_header_analyses[c_header_analysis_count] = analysis
      return analysis
    end
  end
  local c_header_context_count = 0
  driver.new_resolver_context = function(options)
    assert(type(options.io) == "userdata")
    assert(type(options.embedded_interface_provider) == "table")
    assert(type(options.embedded_interface_provider.provider_file) == "string")
    assert(type(options.embedded_interface_provider.entries) == "table")
    if mode == "c-header-analysis-lifetime" then
      c_header_context_count = c_header_context_count + 1
      local expected = c_header_context_count <= 2 and 1 or 2
      assert(options.c_header_analysis ~= nil)
      assert(options.c_header_analysis == c_header_analyses[expected])
      assert(options.c_header_analysis.id == expected)
    end
    return {
      options = options,
      io = options.io,
      contextual_resolutions = {},
      checked_source_modules = {},
    }
  end
  local contextual_finalize_count = 0
  local binary_load_count = 0
  driver.finalize_resolver_context = function(context)
    if mode == "contextual-resolution" or
       mode == "contextual-resolution-once" then
      contextual_finalize_count = contextual_finalize_count + 1
      local provider_file = assert(contextual_provider_file)
      if mode ~= "contextual-resolution-once" or
         contextual_finalize_count == 1 then
        local metadata, metadata_error = context.io:lstat(provider_file)
        assert(metadata and metadata_error == nil)
      end
      context.contextual_resolutions["fixture.facade\0fixture.owner"] = {
        owner = "fixture.owner",
        exposer = "fixture.facade",
        kind = "static",
        provider_file = provider_file,
        ordinary_lookup = true,
      }
    end
    return context
  end
  driver.close_resolver_context = function() return true end
  driver.close_loader = function() return true end
  driver.resolve_external_modules = function(requests, known_sources, options)
    assert(type(options.context) == "table")
    assert(type(options.context.io) == "userdata")
    if mode ~= "external-resolution" then return {} end
    assert(driver.TITAN_SOURCE_PATH ==
             "/configured/first;/configured/second")
    assert(driver.TITAN_BIN_PATH == "/configured/binary")
    assert(options.context.options.extra_ffi_include_dirs[1] == "/configured/include")
    assert(known_sources.app == true)
    assert(requests["vendor.source"] == true)
    assert(requests["vendor.dynamic"] == false)
    assert(requests["vendor.static"] == false)
    assert(requests["vendor.missing"] == false)
    assert(requests["vendor.broken"] == false)
    return {
      ["vendor.source"] = {
        kind = "source",
        main_file = "/external/vendor/vendor.titan",
        source_files = {
          "/external/vendor/vendor.titan",
          "/external/vendor/part.titan",
        },
      },
      ["vendor.dynamic"] = {
        kind = "dynamic",
        provider_file = "/binary/vendor.so",
      },
      ["vendor.static"] = {
        kind = "static",
        provider_file = "/binary/vendor.a",
      },
      ["vendor.missing"] = { kind = "missing" },
      ["vendor.broken"] = {
        kind = "error",
        message = "invalid provider metadata",
      },
    }
  end
  if mode ~= "same-api-missing-restat" then
    driver.restat_c_header_dependencies = function(inputs, options)
      assert(type(options.context) == "table")
      assert(type(options.context.io) == "userdata")
      local result = {}
      for index, input in ipairs(inputs) do
        result[index] = {
          kind = input.kind,
          path = input.path,
          observation = input.observation,
          identity = mode == "header-metadata"
            and input.identity .. ":restatted" or input.identity,
        }
      end
      return result, nil, mode == "header-metadata"
    end
  end
  driver.defaultloader = function(_, options)
    if mode == "bad-loader" then return 42 end
    return function(name)
      if mode == "invalid-source" then
        return false,
          workspace_root .. "/fixture.titan:2:7: syntax error: expected expression"
      end
      if mode == "location-free-diagnostic" then
        return false, "cannot load " .. name
      end
      if mode == "bad-errors" then
        return true, module_type(name), "not an error array", {}
      end
      if mode == "missing-root" then
        return true, module_type(name), {}, {}
      end

      local decl = {
        _tag = "Ast.Decl",
        loc = { filename = workspace_root .. "/fixture.titan", line = 2, col = 7 },
        name = "count",
        type = {
          _tag = "Ast.TypeInteger",
          loc = { filename = workspace_root .. "/fixture.titan", line = 2, col = 14 },
        },
        _type = integer,
      }
      local declaration = {
        _tag = "Ast.TopLevelVar",
        loc = { filename = workspace_root .. "/fixture.titan", line = 2, col = 1 },
        islocal = true,
        decl = decl,
        value = {
          _tag = "Ast.ExpInteger",
          loc = { filename = workspace_root .. "/fixture.titan", line = 2, col = 24 },
          value = 1,
          _type = integer,
        },
        _type = integer,
      }
      local reference = {
        _tag = "Ast.VarName",
        loc = { filename = workspace_root .. "/fixture.titan", line = 3, col = 24 },
        name = "count",
        _decl = declaration,
        _type = integer,
      }
      local cast = {
        _tag = "Ast.ExpCast",
        loc = { filename = workspace_root .. "/fixture.titan", line = 3, col = 24 },
        exp = {
          _tag = "Ast.ExpVar",
          loc = { filename = workspace_root .. "/fixture.titan", line = 3, col = 24 },
          var = reference,
          _type = integer,
        },
        target = {
          _tag = "Ast.TypeFloat",
          loc = { filename = workspace_root .. "/fixture.titan", line = 3, col = 17 },
        },
        _type = float,
        _implicit_coercion = true,
        _adjustment = {
          kind = "direct_coercion",
          source = integer,
          target = float,
          coercion = { op = "integer_to_float" },
        },
      }
      local local_decl = {
        _tag = "Ast.Decl",
        loc = { filename = workspace_root .. "/fixture.titan", line = 3, col = 9 },
        name = "widened",
        type = {
          _tag = "Ast.TypeFloat",
          loc = { filename = workspace_root .. "/fixture.titan", line = 3, col = 17 },
        },
        _type = float,
      }
      local ast = {
        {
          _tag = "Ast.TopLevelImport",
          loc = { filename = workspace_root .. "/fixture.titan", line = 1, col = 1 },
          _name_loc = {
            filename = workspace_root .. "/fixture.titan", line = 1, col = 7,
          },
          _type = module_type("fixture.external"),
          localname = "dependency",
          modname = "fixture.external",
          source_required = true,
        },
        declaration,
        {
          _tag = "Ast.TopLevelFunc",
          loc = { filename = workspace_root .. "/fixture.titan", line = 3, col = 1 },
          islocal = false,
          name = "widen",
          params = {},
          rettypes = {},
          typeparams = {},
          block = {
            _tag = "Ast.StatBlock",
            loc = { filename = workspace_root .. "/fixture.titan", line = 3, col = 3 },
            stats = {
              {
                _tag = "Ast.StatDecl",
                loc = {
                  filename = workspace_root .. "/fixture.titan", line = 3, col = 3,
                },
                decls = { local_decl },
                exps = { cast },
              },
              {
                _tag = "Ast.StatReturn",
                loc = {
                  filename = workspace_root .. "/fixture.titan", line = 4, col = 3,
                },
                exps = {{
                  _tag = "Ast.ExpInitList",
                  loc = {
                    filename = workspace_root .. "/fixture.titan", line = 4, col = 10,
                  },
                  fields = {{
                    _tag = "Ast.Field",
                    loc = {
                      filename = workspace_root .. "/fixture.titan", line = 4, col = 11,
                    },
                    name = {
                      _tag = "Ast.ExpString",
                      loc = {
                        filename = workspace_root .. "/fixture.titan",
                        line = 4,
                        col = 12,
                      },
                      value = "computed",
                    },
                    exp = {
                      _tag = "Ast.ExpInteger",
                      loc = {
                        filename = workspace_root .. "/fixture.titan",
                        line = 4,
                        col = 27,
                      },
                      value = 1,
                      _type = integer,
                    },
                  }},
                }},
              },
            },
          },
          _paramnames = {},
          _type = {
            _tag = "Type.Function",
            params = {},
            rettypes = {},
          },
        },
      }
      -- Ordinary optional metadata has exactly one absent value: nil. These
      -- malformed fixtures exercise the real normalization paths, including
      -- fields that used to silently accept false and omit semantic facts.
      if mode == "false-optional-location" then
        declaration.loc = false
      elseif mode == "false-optional-name-location" then
        declaration._name_loc = false
      elseif mode == "false-optional-type" then
        decl._type = false
      elseif mode == "false-optional-declared-type" then
        ast[3]._declared_type = false
      elseif mode == "false-optional-name" then
        decl.name = false
      elseif mode == "false-optional-parameter-names" then
        ast[3]._paramnames = false
      elseif mode == "false-optional-vararg" then
        ast[3]._type.varargtype = false
      elseif mode == "false-optional-flex-result" then
        ast[3]._type.flexrettype = false
      elseif mode == "false-optional-adjustment" then
        cast._adjustment = false
      elseif mode == "nonpositive-location" then
        declaration.loc.line = 0
      elseif mode == "structure-without-start" then
        ast[3].loc = nil
        ast[3]._end_loc = {
          filename = workspace_root .. "/fixture.titan", line = 5, col = 1,
        }
      elseif mode == "structure-across-files" then
        ast[3]._end_loc = {
          filename = workspace_root .. "/other.titan", line = 5, col = 1,
        }
      elseif mode == "structure-before-start" then
        ast[3]._end_loc = {
          filename = workspace_root .. "/fixture.titan", line = 2, col = 1,
        }
      end
      local header_dependencies = {}
      if mode == "header-false" then
        header_dependencies = false
      elseif mode == "header-metadata" then
        header_dependencies = {
          { kind = "file", path = headers_root .. "/direct.h",
            identity = "direct bytes", observation = {
              modified_seconds = 123, modified_nanoseconds = 456,
              physical_identity = "device:inode:target",
              precision = "ns", size = 12, changed_seconds = 122, changed_nanoseconds = 7,
            } },
          { kind = "search", path = headers_root .. "/earlier.h",
            identity = "missing candidate" },
          { kind = "origin", path = headers_root .. "/direct.h",
            identity = "c-header-origin-v1;real=" .. headers_root .. "/direct.h" },
        }
      elseif mode == "header-relative-path" then
        header_dependencies = {
          { kind = "file", path = "headers/direct.h",
            identity = "direct bytes" },
        }
      elseif mode == "header-duplicate" then
        header_dependencies = {
          { kind = "file", path = headers_root .. "/direct.h",
            identity = "first" },
          { kind = "file", path = headers_root .. "/direct.h",
            identity = "second" },
        }
      elseif mode == "header-unknown-kind" then
        header_dependencies = {
          { kind = "directory", path = headers_root,
            identity = "directory state" },
        }
      elseif mode == "header-empty-identity" then
        header_dependencies = {
          { kind = "search", path = headers_root .. "/earlier.h",
            identity = "" },
        }
      end
      driver.imported[name] = {
        kind = "source",
        ast = ast,
        type = module_type(name),
        source_manifest = source_manifest(name),
        filename = workspace_root .. "/fixture.titan",
        source_files = { workspace_root .. "/fixture.titan" },
        c_header_dependencies = header_dependencies,
      }
      driver.imported["fixture.external"] = {
        kind = "source",
        ast = {{
          _tag = "Ast.TopLevelFunc",
          loc = { filename = "/external/main.titan", line = 1, col = 1 },
          islocal = false,
          name = "hidden_raw_ast",
          params = {}, rettypes = {}, typeparams = {},
          block = { _tag = "Ast.StatBlock",
                    loc = { filename = "/external/main.titan", line = 1, col = 1 },
                    stats = {} },
          _paramnames = {},
          _type = {
            _tag = "Type.Function",
            params = {},
            rettypes = {},
          },
        }},
        type = module_type("fixture.external"),
        source_manifest = source_manifest("fixture.external"),
        filename = "/external/main.titan",
        source_files = { "/external/main.titan", "/external/part.titan" },
        c_header_dependencies = {},
      }
      if mode == "dependency-diagnostic" then
        driver.imported[name].source_manifest = nil
        driver.imported[name].deps = {["fixture.dependency"] = true}
        driver.imported["fixture.dependency"] = {
          kind = "source",
          ast = ast,
          type = module_type("fixture.dependency"),
          filename = workspace_root .. "/dependency.titan",
          source_files = { workspace_root .. "/dependency.titan" },
          c_header_dependencies = {},
        }
      end
      if mode == "binary-manifest" or
         mode == "embedded-provider" or
         mode == "ordinary-executable-provider" or
         mode == "binary-provider-switch" or
         mode == "binary-provider-to-source" then
        binary_load_count = binary_load_count + 1
        local provider_file = contextual_provider_file or
          "/binary/fixture.so"
        if mode == "embedded-provider" or
           mode == "ordinary-executable-provider" then
          provider_file = assert(
            options.embedded_interface_provider).provider_file
        end
        if mode == "binary-provider-switch" and binary_load_count > 1 then
          provider_file = provider_file .. ".second"
        end
        local source_provider =
          mode == "binary-provider-to-source" and binary_load_count > 1
        if contextual_provider_file and not source_provider and
           mode ~= "embedded-provider" then
          local metadata, metadata_error =
            assert(options.context).io:lstat(provider_file)
          assert(metadata and metadata_error == nil)
        end
        if source_provider then
          driver.imported["fixture.binary"] = {
            kind = "source",
            ast = {},
            type = module_type("fixture.binary"),
            source_manifest = source_manifest("fixture.binary"),
            filename = provider_file ..
              (mode == "binary-provider-to-source" and ".second" or ""),
            source_files = {provider_file ..
              (mode == "binary-provider-to-source" and ".second" or "")},
            c_header_dependencies = {},
          }
        else
          driver.imported["fixture.binary"] = {
            kind = mode == "embedded-provider" and "embedded" or "dynamic",
            type = module_type("fixture.binary"),
            filename = provider_file,
            c_header_dependencies = {},
          }
        end
      end
      local context = assert(options.context)
      if mode == "completion-catalog" then
        local source = options.source_overrides[name]
        context.catalog_replacement = source and
          source.contents[source.main] == "replacement"
      end
      context.checked_source_modules[
        #context.checked_source_modules + 1] = name
      if mode == "dependency-diagnostic" then
        context.checked_source_modules[
          #context.checked_source_modules + 1] = "fixture.dependency"
        return true, module_type(name), {
          workspace_root .. "/dependency.titan:1:1: unknown variable 'missing'",
        }, {}
      end
      if mode == "progress" then
        -- The real compiler reports every completed source module. Exercise
        -- both noise classes the bridge must exclude from saved-file counts:
        -- an external module and a duplicate project checkpoint.
        context.io:yield("fixture.external")
        context.io:yield(name)
        context.io:yield(name)
      end
      if mode == "source-profiling" then
        assert(type(options.source_process_trace) == "function")
        options.source_process_trace(
          name, workspace_root .. "/fixture.titan", "complete",
          7.0, 9.0, 2.0, 3.0)
      end
      if mode == "probe-tracing" then
        assert(type(options.c_probe_semantic_trace) == "function")
        assert(type(options.c_probe_execution_trace) == "function")
        local semantic_ok = pcall(options.c_probe_semantic_trace, {
          event = "semantic_result",
          module = name,
          key = string.rep("a", 64),
          probe_kind = "unsafe_object_pointer",
          header_identity = string.rep("b", 64),
          header_label = "lua.h + uv.h",
          outcome = "compiler_rejection",
          cache_tier = "persistent",
          repeated = true,
          publication = "existing",
          source = "must not cross the bridge",
          argv = { "must", "not", "cross" },
          diagnostic = "must not cross the bridge",
        })
        assert(semantic_ok)
        local diagnostic_publication_ok =
          pcall(options.c_probe_semantic_trace, {
            event = "semantic_result",
            module = name,
            key = string.rep("9", 64),
            probe_kind = "unsafe_object_pointer",
            header_identity = string.rep("8", 64),
            header_label = "lua.h + uv.h",
            outcome = "success",
            cache_tier = "compiler",
            repeated = false,
            publication = "diagnostic_not_persisted",
          })
        assert(diagnostic_publication_ok)
        local execution_ok = pcall(options.c_probe_execution_trace, {
          event = "compiler_execution",
          module = name,
          key = string.rep("c", 64),
          probe_kind = "declaration_compatibility",
          batch_kind = "batch",
          header_identity = string.rep("d", 64),
          header_label = "lua.h + uv.h",
          outcome = "success",
          persistent_lookup = "miss",
          publication = "published",
          started = true,
          wall_ms = 12.5,
          command = "must not cross the bridge",
          source = "must not cross the bridge",
        })
        assert(execution_ok)
        local oversized_ok = pcall(options.c_probe_semantic_trace, {
          event = "semantic_result",
          module = name,
          key = string.rep("e", 64),
          probe_kind = "c_operator",
          header_identity = "",
          header_label = string.rep("x", 4097),
          outcome = "success",
          cache_tier = "compiler",
          repeated = false,
          publication = "not_applicable",
        })
        assert(not oversized_ok)
        local duration_ok = pcall(options.c_probe_execution_trace, {
          event = "compiler_execution",
          module = name,
          key = string.rep("f", 64),
          probe_kind = "c_operator",
          batch_kind = "single",
          header_identity = "",
          header_label = "",
          outcome = "success",
          persistent_lookup = "disabled",
          publication = "not_applicable",
          started = true,
          wall_ms = 0 / 0,
        })
        assert(not duration_ok)
        local started_ok = pcall(options.c_probe_execution_trace, {
          event = "compiler_execution",
          module = name,
          key = string.rep("f", 64),
          probe_kind = "c_operator",
          batch_kind = "single",
          header_identity = "",
          header_label = "",
          outcome = "infrastructure_failure",
          persistent_lookup = "not_applicable",
          publication = "not_applicable",
          started = "yes",
        })
        assert(not started_ok)
      end
      return true, module_type(name), {}, {}
    end
  end

  if mode == "malformed-parser" then parser.parse = 42 end
  local replacements = {
    [names[1]] = parser,
    [names[2]] = checker,
    [names[3]] = types,
    [names[4]] = driver,
    [names[5]] = completion,
    -- AST fixtures carry no documentation. Supply the entire lazy boundary
    -- so a cold filtered run does not depend on another case loading it first.
    [names[6]] = { for_node = function() return nil end },
  }
  if mode == "missing-parser" then replacements[names[1]] = nil end
  package.path, package.cpath = "", ""
  for _, name in ipairs(names) do package.loaded[name] = replacements[name] end
  return function()
    package.path, package.cpath = old_path, old_cpath
    for _, name in ipairs(names) do package.loaded[name] = old_loaded[name] end
  end
end
]==], "=compiler_bridge_fixture", nil)() as FixtureInstaller
end

local function with_fixture(mode: string, body: EmptyFunction,
                            contextual_provider_file: string?)
  local restore = new_fixture_installer()(
    mode, contextual_provider_file, test_paths.workspace_root(),
    fixture_headers_root(), fixture_sdk_root()) as EmptyFunction
  defer restore()
  body()
catch
  if error is bridge.BridgeError then
    local failure = error as bridge.BridgeError
    raise failure.module_name .. ": " .. failure.message
  end
  raise
end

local function expect_bridge_error(mode: string, expected: string)
  with_fixture(mode, function ()
    local rejected = false
    do
      bridge.load()
    catch
      rejected = true
      test.assert(error is bridge.BridgeError,
                  "bridge raised an untyped loading error")
      local failure = error as bridge.BridgeError
      test.assert(strings.find(failure.message, expected) ~= nil,
                  failure.message)
    end
    test.assert(rejected, "malformed compiler API was accepted")
  end)
end

function test_compiler_bridge_rejects_missing_incompatible_and_malformed_modules(
    _context: test.Context)
  expect_bridge_error("missing-parser", "cannot load compiler module")
  expect_bridge_error("missing-abi", "TITAN_ABI_VERSION")
  expect_bridge_error("incompatible", "incompatible Titan compiler ABI")
  expect_bridge_error("older-same-abi",
                      "matching Titan ABI alone is insufficient")
  expect_bridge_error("wrong-language-server-api",
                      "requires LANGUAGE_SERVER_API_VERSION 1")
  expect_bridge_error("same-api-missing-restat",
                      "'restat_c_header_dependencies' must be a function, " ..
                      "found nil. Install a Titan compiler implementing " ..
                      "LANGUAGE_SERVER_API_VERSION 1")
  expect_bridge_error("same-api-missing-c-header-analysis",
                      "'new_c_header_analysis' must be a function, found nil")
  expect_bridge_error("same-api-missing-split-shell-words",
                      "'split_shell_words' must be a function, found nil")
  expect_bridge_error("same-api-missing-compact-project-entry",
                      "'compact_project_entry' must be a function, found nil")
  expect_bridge_error("same-api-missing-classify-source-filename",
                      "'classify_source_filename' must be a function, found nil")
  expect_bridge_error("malformed-parser", "'parse' must be a function")
end

function test_compiler_bridge_rejects_false_for_optional_metadata(
    context: test.Context)
  local modes = {
    "false-optional-location", "false-optional-name-location",
    "false-optional-type", "false-optional-declared-type",
    "false-optional-name", "false-optional-parameter-names",
    "false-optional-vararg", "false-optional-flex-result",
    "false-optional-adjustment",
  }
  local messages = {
    ".loc must be a Lua table", "._name_loc must be a Lua table",
    "._type must be a Lua table", "._declared_type must be a Lua table",
    ".name must be a string", ".paramnames must be a Lua array",
    ".varargtype must be a Lua table", ".flexrettype must be a Lua table",
    "adjustment must be a Lua table",
  }
  for index = 1, #modes do
    local mode = modes[index]
    local expected = messages[index]
    context:run(mode, function (_context: test.Context)
      with_fixture(mode, function ()
        local compiler = bridge.load()
        local rejected = false
        do
          compiler:analyze("fixture", {
            bridge.ProjectModule.new("fixture", {bridge.SourceFile.new(
              test_paths.workspace_root() .. "/fixture.titan", "saved fixture")}),
          })
        catch
          rejected = true
          test.assert(error is bridge.BridgeError,
                      "invalid optional metadata raised an untyped error")
          local failure = error as bridge.BridgeError
          test.assert(strings.find(failure.message, expected) ~= nil,
                      failure.message)
        end
        test.assert(rejected, "false was accepted as absent metadata")
      end)
    end)
  end
end

