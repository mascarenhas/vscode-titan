end

local function rejects_changed_transitive_private_nominal_method()
  preload_real_compiler()
  local compiler = bridge.load()
  local projects = transitive_private_nominal_projects(nil, nil)
  local initial = compiler:analyze("private_nominal_consumer", projects)
  test.assert(#initial.diagnostics == 0,
    "initial transitive private nominal method fixture failed")
  local changed_projects = transitive_private_nominal_projects([[
record BufferStore
  local text: string
end
function create(): BufferStore return { text = "ok" } end
]], nil)
  local changed = compiler:analyze_incremental(changed_projects, {
    "private_nominal_buffer", "private_nominal_consumer",
  }, {})
  local missing_method = false
  for index = 1, #changed.diagnostics do
    if strings.find(changed.diagnostics[index].message,
        "method 'inputs' not found") ~= nil then
      missing_method = true
    end
  end
  test.assert(missing_method and
    changed:find_module("private_nominal_buffer") ~= nil and
    changed:find_module("private_nominal_application") == nil,
    "retained application declarations hid a removed BufferStore method")
end

