  local diagnostic_messages = strings.writer()
  for index = 1, #analysis.diagnostics do
    diagnostic_messages:write(analysis.diagnostics[index].message .. "\n")
  end
  test.assert(#analysis.diagnostics == 0,
              "compiler rejected nontransitive visibility fixture: " ..
              diagnostic_messages:drain())
  local model = features.build(projects, analysis.modules)

  local reexported? = model:hover(
    consumer_filename, source_text.Position.new(2, 31))
  local reexported_markdown = reexported ~= nil and
    reexported:markdown() or "<nil>"
  test.assert(reexported ~= nil and
              strings.find(reexported_markdown, "shown: integer") ~= nil and
              strings.find(reexported_markdown, ":visible()") ~= nil and
              strings.find(reexported_markdown, "hidden") == nil and
              strings.find(reexported_markdown, ":secret()") == nil,
              "source visibility leaked through a facade alias:\n" ..
              reexported_markdown)

  local direct? = model:hover(
    consumer_filename, source_text.Position.new(2, 50))
  local direct_markdown = direct ~= nil and direct:markdown() or "<nil>"
  test.assert(direct ~= nil and
              strings.find(direct_markdown, "local hidden: integer") ~= nil and
              strings.find(direct_markdown, "local " ..
                "summary_visibility_provider.Box:secret()") ~= nil,
              "direct source import lost owner-local members:\n" ..
              direct_markdown)
end

function test_compiler_bridge_keeps_source_visibility_nontransitive_through_aliases(
    _context: test.Context)
  run_bridge(keeps_source_visibility_nontransitive_through_aliases)
end

local function keeps_function_valued_module_variables_as_bare_types()
  preload_real_compiler()
  local provider_filename =
    "/workspace/function_variable_provider.titan"
  local provider_source = [[callback: (integer) -> integer =
  function(item) return item + 1 end
function declared(item: integer): integer
  return item * 2
end
]]
  local consumer_filename =
    "/workspace/function_variable_consumer.titan"
  local consumer_source =
    [[local provider = import "function_variable_provider"
function apply(item: integer): integer
  return provider.callback(provider.declared(item))
end
]]
  local projects = {
    bridge.ProjectModule.new("function_variable_provider", {
      bridge.SourceFile.new(provider_filename, provider_source),
    }),
    bridge.ProjectModule.new("function_variable_consumer", {
      bridge.SourceFile.new(consumer_filename, consumer_source),
    }),
  }
  local analysis = bridge.load():analyze(
    "function_variable_consumer", projects)
  local diagnostic_messages = strings.writer()
  for index = 1, #analysis.diagnostics do
    diagnostic_messages:write(analysis.diagnostics[index].message .. "\n")
  end
  test.assert(#analysis.diagnostics == 0,
              "compiler rejected function-valued module-variable fixture: " ..
              diagnostic_messages:drain())

  local model = features.build(projects, analysis.modules)
  local module_hover? = model:hover(
    consumer_filename, source_text.Position.new(0, 7))
  local markdown = module_hover ~= nil and
    module_hover:markdown() or "<nil>"
  test.assert(module_hover ~= nil and markdown ==
                "**module** `function_variable_provider`\n\n" ..
                "Members\n\n" ..
                "- `callback: (integer) -> integer`\n" ..
                "- `function_variable_provider.declared(" ..
                  "item: integer): integer`\n\n" ..
                "- Visibility: module\n",
              "module hover confused a function-valued variable with " ..
              "a named function declaration:\n" .. markdown)
end

function test_compiler_bridge_keeps_function_valued_module_variables_as_bare_types(
    _context: test.Context)
  run_bridge(keeps_function_valued_module_variables_as_bare_types)
end

local function preserves_cached_manifest_callable_hover_signatures()
  preload_real_compiler()
  local external_root = fs.tmpname()
  fs.unlink(external_root)
  fs.mkdir(external_root)
  local external_file = external_root .. "/hover_manifest.titan"
  fs.write_file(external_file, [[record Parcel
  amount: integer
end
function Parcel.create(initial: integer): Parcel
  return Parcel.new(initial)
end
function Parcel:increase(delta: integer): integer
  return self.amount + delta
end
union Choice
  numbered: integer
  empty
end
function Choice.from_ordinal(ordinal: integer): Choice
  return Choice.numbered(ordinal)
end
function Choice:label(prefix: string): string
  return prefix
end
interface Formatter
  prefix: string
  function format(subject: string, maximum: integer?): string
end
function combine(left: integer, right: integer): integer
  return left + right
end
]])
  defer do
    fs.unlink(external_file)
    fs.rmdir(external_root)
  end

  local seed_filename = "/workspace/hover_manifest_seed.titan"
  local seed = bridge.ProjectModule.new("hover_manifest_seed", {
    bridge.SourceFile.new(seed_filename,
      "local cached = import \"hover_manifest\"\n" ..
      "function seed(): integer return cached.combine(1, 2) end\n"),
  })
  local initial_compiler = bridge.load()
  initial_compiler:configure_paths(external_root, nil, nil)
  local initial = initial_compiler:analyze("hover_manifest_seed", {seed})
  local initial_external? = initial:find_module("hover_manifest")
  test.assert(#initial.diagnostics == 0 and initial_external ~= nil and
              initial_external.manifest ~= nil,
              "initial external callable manifest was not serialized")
  local external_module = initial_external as bridge.ModuleSnapshot
  local external_manifest = external_module.manifest as bridge.Manifest
  test.assert(external_manifest.source_serialized ~= nil,
              "external callable cache seed lost its source manifest")
  local cached_external = bridge.CachedSourceInterface.new(
    "hover_manifest", external_manifest.serialized,
    external_manifest.source_serialized,
    external_file, {external_file}, external_module.imports,
    external_module.c_header_dependencies)

  -- A syntax error makes an accidental source reload observable. The second
  -- Compiler must resolve every declaration below from the serialized cache.
  fs.write_file(external_file, "function broken(: integer) end\n")
  local filename = "/workspace/hover_manifest_consumer.titan"
  local source = [[local cached = import "hover_manifest"
function use(formatter: cached.Formatter,
             parcel: cached.Parcel,
             choice: cached.Choice): integer
  local combined = cached.combine(1, 2)
  local created = cached.Parcel.create(3)
  local grown = parcel:increase(4)
  local selected = cached.Choice.from_ordinal(5)
  local variant = cached.Choice.numbered(6)
  local label = choice:label(">")
  local text = formatter:format(label, 20)
  return 0
end
]]
  local consumer = bridge.ProjectModule.new("hover_manifest_consumer", {
    bridge.SourceFile.new(filename, source),
  })
  local reloaded_compiler = bridge.load()
  reloaded_compiler:configure_paths(external_root, nil, nil)
  local reloaded = reloaded_compiler:analyze_incremental(
    {consumer}, {"hover_manifest_consumer"}, {cached_external})
  local diagnostic_messages = strings.writer()
  for index = 1, #reloaded.diagnostics do
    diagnostic_messages:write(reloaded.diagnostics[index].message .. "\n")
  end
  test.assert(#reloaded.diagnostics == 0,
              "compiler did not use serialized callable manifest: " ..
              diagnostic_messages:drain())
  local cached_snapshot? = reloaded:find_module("hover_manifest")
  test.assert(cached_snapshot ~= nil and #cached_snapshot.nodes == 0 and
              #cached_snapshot.symbols == 0 and
              cached_snapshot.manifest ~= nil and
              cached_snapshot.manifest.source_serialized ==
                external_manifest.source_serialized,
              "serialized external manifest unexpectedly retained an AST")
  local cached_summaries? = cached_snapshot.hover_summaries
  test.assert(cached_summaries == nil or #cached_summaries == 0,
              "serialized external snapshot retained hover summaries")
  local model = features.build({consumer}, reloaded.modules)

  local module_hover? = model:hover(
    filename, source_text.Position.new(0, 7))
  test.assert(module_hover ~= nil and module_hover:markdown() ==
                "**module** `hover_manifest`\n\n" ..
                "Members\n\n" ..
                "- `union Choice`\n" ..
                "- `record Parcel`\n" ..
                "- `hover_manifest.combine(" ..
                  "left: integer, right: integer): integer`\n" ..
                "- `interface Formatter`\n\n" ..
                "- Visibility: module\n" and
              strings.find(module_hover:markdown(), "Variants") == nil and
              strings.find(module_hover:markdown(), ".new") == nil,
              "cached module hover expanded or lost manifest members")

  local interface_hover? = model:hover(
    filename, source_text.Position.new(1, 32))
  test.assert(interface_hover ~= nil and interface_hover:markdown() ==
                "**interface** `hover_manifest.Formatter`\n\n" ..
                "Fields\n\n" ..
                "- `const prefix: string`\n\n" ..
                "Methods\n\n" ..
                "- `hover_manifest.Formatter:format(" ..
                  "subject: string, maximum: integer?): string`\n\n" ..
                "- Visibility: exported\n",
              "cached interface hover lost fields or named methods")

  local parcel_hover? = model:hover(
    filename, source_text.Position.new(2, 29))
  test.assert(parcel_hover ~= nil and parcel_hover:markdown() ==
                "**record** `hover_manifest.Parcel`\n\n" ..
                "Fields\n\n" ..
                "- `amount: integer`\n\n" ..
                "Functions\n\n" ..
                "- `hover_manifest.Parcel.create(" ..
                  "initial: integer): hover_manifest.Parcel`\n" ..
                "- `hover_manifest.Parcel.new(" ..
                  "amount: integer): hover_manifest.Parcel`\n\n" ..
                "Methods\n\n" ..
                "- `hover_manifest.Parcel:increase(" ..
                  "delta: integer): integer`\n\n" ..
                "- Visibility: exported\n",
              "cached record hover lost normalized manifest members")

  local choice_hover? = model:hover(
    filename, source_text.Position.new(3, 29))
  test.assert(choice_hover ~= nil and choice_hover:markdown() ==
                "**union** `hover_manifest.Choice`\n\n" ..
                "Variants\n\n" ..
                "- `empty`\n" ..
                "- `numbered(payload: integer)`\n\n" ..
                "Functions\n\n" ..
                "- `hover_manifest.Choice.from_ordinal(" ..
                  "ordinal: integer): hover_manifest.Choice`\n\n" ..
                "Methods\n\n" ..
                "- `hover_manifest.Choice:label(" ..
                  "prefix: string): string`\n\n" ..
                "- Visibility: exported\n" and
              strings.find(choice_hover:markdown(),
                           "Choice.numbered") == nil,
              "cached union hover duplicated synthesized constructors")

  local ordinary? = model:hover(filename, source_text.Position.new(4, 29))
  test.assert(ordinary ~= nil and ordinary:markdown() ==
                "- Signature: `hover_manifest.combine(" ..
                "left: integer, right: integer): integer`\n" ..
                "- Visibility: exported\n",
              "deserialized ModuleMember lost parameter labels")

  local record_static? = model:hover(
    filename, source_text.Position.new(5, 33))
  test.assert(record_static ~= nil and record_static:markdown() ==
                "- Signature: `hover_manifest.Parcel.create(" ..
                "initial: integer): hover_manifest.Parcel`\n" ..
                "- Visibility: exported\n",
              "deserialized record StaticMethod lost parameter labels")

  local record_method? = model:hover(
    filename, source_text.Position.new(6, 25))
  test.assert(record_method ~= nil and record_method:markdown() ==
                "- Signature: `hover_manifest.Parcel:increase(" ..
                "delta: integer): integer`\n" ..
                "- Visibility: exported\n",
              "deserialized record Method lost parameter labels")

  local union_static? = model:hover(
    filename, source_text.Position.new(7, 36))
  test.assert(union_static ~= nil and union_static:markdown() ==
                "- Signature: `hover_manifest.Choice.from_ordinal(" ..
                "ordinal: integer): hover_manifest.Choice`\n" ..
                "- Visibility: exported\n",
              "deserialized union StaticMethod lost parameter labels")

  local variant? = model:hover(filename, source_text.Position.new(8, 34))
  test.assert(variant ~= nil and variant:markdown() ==
                "- Signature: `hover_manifest.Choice.numbered(" ..
                "integer): hover_manifest.Choice`\n" ..
                "- Visibility: exported\n",
              "union variant constructor invented a parameter label")

  local union_method? = model:hover(filename, source_text.Position.new(9, 24))
  test.assert(union_method ~= nil and union_method:markdown() ==
                "- Signature: `hover_manifest.Choice:label(" ..
                "prefix: string): string`\n" ..
                "- Visibility: exported\n",
              "deserialized union Method lost parameter labels")

  local interface_method? = model:hover(
    filename, source_text.Position.new(10, 27))
  test.assert(interface_method ~= nil and interface_method:markdown() ==
                "- Signature: `hover_manifest.Formatter:format(" ..
                "subject: string, maximum: integer?): string`\n" ..
                "- Visibility: exported\n",
              "deserialized interface Method lost parameter labels")
end

function test_compiler_bridge_preserves_cached_manifest_callable_hover_signatures(
    _context: test.Context)
  test_runtime.run(preserves_cached_manifest_callable_hover_signatures)
end

local function preserves_direct_c_callable_hover_signatures()
  preload_real_compiler()
  local include_root = fs.tmpname()
  fs.unlink(include_root)
  fs.mkdir(include_root)
  local header = include_root .. "/hover_callable.h"
  fs.write_file(header,
    "int hover_named_sum(int left, int right);\n" ..
    "int hover_unnamed_sum(int, int);\n")
  defer do
    fs.unlink(header)
    fs.rmdir(include_root)
  end

  local filename = "/workspace/hover_c_consumer.titan"
  local source = [[local native = foreign import "hover_callable.h"
function run(): integer
  local named: integer = native.hover_named_sum(1, 2)
  local unnamed: integer = native.hover_unnamed_sum(3, 4)
  return named + unnamed
end
]]
  local project = bridge.ProjectModule.new("hover_c_consumer", {
    bridge.SourceFile.new(filename, source),
  })
  local compiler = bridge.load()
  compiler:configure_paths(nil, nil, {include_root})
  local analysis = compiler:analyze("hover_c_consumer", {project})
  local diagnostic_messages = strings.writer()
  for index = 1, #analysis.diagnostics do
    diagnostic_messages:write(analysis.diagnostics[index].message .. "\n")
  end
  test.assert(#analysis.diagnostics == 0,
              "compiler rejected direct-C hover fixture: " ..
              diagnostic_messages:drain())
  local model = features.build({project}, analysis.modules)

  local named? = model:hover(filename, source_text.Position.new(2, 40))
  test.assert(named ~= nil and named:markdown() ==
                "- Signature: `native.hover_named_sum(" ..
                "left: int, right: int): int`\n" ..
                "- Visibility: exported\n",
              "direct C function lost its written alias or parameter names")

  local unnamed? = model:hover(filename, source_text.Position.new(3, 42))
  test.assert(unnamed ~= nil and unnamed:markdown() ==
                "- Signature: `native.hover_unnamed_sum(int, int): int`\n" ..
                "- Visibility: exported\n",
              "unnamed C prototype invented parameter labels")
end

function test_compiler_bridge_preserves_direct_c_callable_hover_signatures(
    _context: test.Context)
  test_runtime.run(preserves_direct_c_callable_hover_signatures)
end

local function symbol_identity(module: bridge.ModuleSnapshot,
                               name: string): string?
  local identity?: string = nil
  for index = 1, #module.symbols do
    local symbol = module.symbols[index]
    if symbol.name == name and symbol.declaration_id ~= nil then
      if identity == nil then identity = symbol.declaration_id end
      test.assert(symbol.declaration_id == identity,
                  "symbol '" .. name .. "' split inside one module")
    end
  end
  return identity
end

local function preserves_source_manifest_across_trivia_shifts()
  preload_real_compiler()
  local filename = "/workspace/private_identity.titan"
  local source = [[local secret = 41
local function hidden(increment: integer): integer
  return secret + increment
end
function answer(): integer return hidden(1) end
]]
  local initial = bridge.load():analyze("private_identity", {
    bridge.ProjectModule.new("private_identity", {
      bridge.SourceFile.new(filename, source),
    }),
  })
  local shifted = bridge.load():analyze("private_identity", {
    bridge.ProjectModule.new("private_identity", {
      bridge.SourceFile.new(filename, "-- leading comment\n" .. source),
    }),
  })
  test.assert(#initial.diagnostics == 0 and #shifted.diagnostics == 0,
              "private identity fixtures did not compile")
  local initial_module? = initial:find_module("private_identity")
  local shifted_module? = shifted:find_module("private_identity")
  test.assert(initial_module ~= nil and shifted_module ~= nil and
              initial_module.manifest ~= nil and
              shifted_module.manifest ~= nil,
              "private identity fixtures lost their module snapshots")
  test.assert(initial_module.manifest.source_serialized ==
                shifted_module.manifest.source_serialized,
              "leading trivia changed the source-visible interface")
end

function test_compiler_bridge_preserves_source_manifest_across_leading_comments(
    _context: test.Context)
  test_runtime.run(preserves_source_manifest_across_trivia_shifts)
end

local function preserves_alias_and_named_parameter_rename_metadata()
  preload_real_compiler()
  local provider_file = "/workspace/named_provider.titan"
  local consumer_file = "/workspace/named_consumer.titan"
  local provider_source = [[record Box
  amount: integer
end
type Alias = Box
function choose(first: integer, second: integer): integer
  return first + second
end
]]
  local consumer_source = [[local p = import "named_provider"
function run(): integer
  local box: p.Alias = p.Alias.new { amount = 3 }
  return p.choose { second = box.amount, first = 1 }
end
]]
  local projects = {
    bridge.ProjectModule.new("named_provider", {
      bridge.SourceFile.new(provider_file, provider_source),
    }),
    bridge.ProjectModule.new("named_consumer", {
      bridge.SourceFile.new(consumer_file, consumer_source),
    }),
  }
  local compiler = bridge.load()
  local analysis = compiler:analyze("named_consumer", projects)
  test.assert(#analysis.diagnostics == 0,
              "named-argument semantic fixture did not compile")
  local provider? = analysis:find_module("named_provider")
  local consumer? = analysis:find_module("named_consumer")
  test.assert(provider ~= nil and consumer ~= nil,
              "named-argument semantic snapshots were incomplete")
  local provider_module: bridge.ModuleSnapshot = provider
  local consumer_module: bridge.ModuleSnapshot = consumer
  test.assert(symbol_identity(provider_module, "Alias") ==
                symbol_identity(consumer_module, "Alias"),
              "qualified alias namespace did not join its declaration")
  test.assert(symbol_identity(provider_module, "first") ==
                symbol_identity(consumer_module, "first"),
              "named label did not join its formal parameter")

  local model = features.build(projects, analysis.modules)
  local candidate?, candidate_error? = model:rename(
    provider_file, source_text.Position.new(4, 17), "primary")
  test.assert(candidate_error == nil and candidate ~= nil,
              "formal parameter did not produce a rename candidate")
  local edited = candidate:edited_project_modules()
  local checked = bridge.load():analyze("named_consumer", edited)
  local verified?, verification_error? = candidate:preflight(checked)
  test.assert(verification_error == nil and verified ~= nil,
              "named-argument parameter rename failed compiler preflight")
  local documents = verified:document_edits()
  test.assert(#documents == 2 and
              documents[1].uri == "file:///workspace/named_consumer.titan" and
              #documents[1].edits == 1 and
              documents[2].uri == "file:///workspace/named_provider.titan" and
              #documents[2].edits == 2,
              "parameter rename did not edit its definition, uses, and label")
end

function test_compiler_bridge_preserves_alias_and_named_parameter_rename_metadata(
    _context: test.Context)
  test_runtime.run(preserves_alias_and_named_parameter_rename_metadata)
end
