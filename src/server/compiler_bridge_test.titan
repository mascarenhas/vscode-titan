function test_compiler_bridge_accepts_missing_manifest_after_dependency_error(
    _context: test.Context)
  run_bridge(function ()
    with_fixture("dependency-diagnostic", function ()
      local compiler = bridge.load()
      local analysis = compiler:analyze("fixture", {
        bridge.ProjectModule.new("fixture", {bridge.SourceFile.new(
          test_paths.workspace_root() .. "/fixture.titan", "saved fixture")}),
        bridge.ProjectModule.new("fixture.dependency", {bridge.SourceFile.new(
          test_paths.workspace_root() .. "/dependency.titan", "invalid dependency")}),
      })
      local root? = analysis:find_module("fixture")
      local dependency? = analysis:find_module("fixture.dependency")
      test.assert(#analysis.diagnostics == 1 and root ~= nil and
                  dependency ~= nil,
                  "dependency error did not produce failed project snapshots")
      test.assert(root.manifest == nil and dependency.manifest == nil,
                  "failed dependency closure acquired a valid manifest")
      test.assert(not compiler:has_project_entry("fixture") and
                  not compiler:has_project_entry("fixture.dependency"),
                  "failed dependency closure entered the incremental cache")
    end)
  end)
end

function test_compiler_bridge_keeps_source_manifests_off_binary_snapshots(
    _context: test.Context)
  run_bridge(function ()
    local provider = test_paths.temporary_name()
    defer fs.unlink(provider)
    fs.write_file(provider, "fixture binary provider")
    with_fixture("binary-manifest", function ()
      local compiler = bridge.load()
      local analysis = compiler:analyze("fixture", {
        bridge.ProjectModule.new("fixture", {bridge.SourceFile.new(
          test_paths.workspace_root() .. "/fixture.titan", "saved fixture")}),
      })
      local binary? = analysis:find_module("fixture.binary")
      test.assert(binary ~= nil and binary.manifest ~= nil and
                  binary.manifest.source_serialized == nil and
                  binary.provider_identity ~= nil and
                  binary.provider_identity.path == provider and
                  binary.provider_identity.size ==
                    #"fixture binary provider",
                  "binary snapshot lost its compiler-observed provider")
      case binary.provenance
      when dynamic_binary{provider_file} then
        test.assert(provider_file == provider,
                    "binary manifest fixture lost its provider provenance")
      else
        test.assert(false, "binary manifest fixture used source provenance")
      end
    end, provider)
  end)
end

function test_compiler_bridge_observes_embedded_provider_identity(
    _context: test.Context)
  run_bridge(function ()
    local raw_provider, raw_identity = embedded_interfaces.provider()
    local provider: string = raw_provider["provider_file"]
    local provider_size: integer = raw_identity["size"]
    with_fixture("embedded-provider", function ()
      local compiler = bridge.load()
      local analysis = compiler:analyze("fixture", {
        bridge.ProjectModule.new("fixture", {bridge.SourceFile.new(
          test_paths.workspace_root() .. "/fixture.titan", "saved fixture")}),
      })
      local embedded? = analysis:find_module("fixture.binary")
      test.assert(embedded ~= nil and
                  embedded.provider_identity ~= nil and
                  embedded.provider_identity.path == provider and
                  embedded.provider_identity.size == provider_size and
                  #analysis.binary_provider_observations == 1 and
                  analysis.binary_provider_observations[1].module_name ==
                    "fixture.binary" and
                  analysis.binary_provider_observations[1].kind == "static" and
                  analysis.binary_provider_observations[1].provider_file ==
                    provider and
                  analysis.binary_provider_observations[1].provider_identity ~=
                    nil,
                  "embedded provider was not stamped as an observed binary")
      case embedded.provenance
      when static_binary{provider_file} then
        test.assert(provider_file == provider,
                    "embedded provider lost its executable provenance")
      else
        test.assert(false,
                    "embedded provider used non-static bridge provenance")
      end
    end, nil)
  end)
end

function test_compiler_bridge_does_not_treat_an_ordinary_executable_path_as_embedded(
    _context: test.Context)
  run_bridge(function ()
    local raw_provider, _raw_identity = embedded_interfaces.provider()
    local provider: string = raw_provider["provider_file"]
    with_fixture("ordinary-executable-provider", function ()
      local compiler = bridge.load()
      local analysis = compiler:analyze("fixture", {
        bridge.ProjectModule.new("fixture", {bridge.SourceFile.new(
          test_paths.workspace_root() .. "/fixture.titan", "saved fixture")}),
      })
      local ordinary? = analysis:find_module("fixture.binary")
      test.assert(ordinary ~= nil and ordinary.provider_identity == nil and
                  #analysis.binary_provider_observations == 1 and
                  analysis.binary_provider_observations[1].provider_file ==
                    provider and
                  analysis.binary_provider_observations[1].provider_identity ==
                    nil,
                  "ordinary executable-path provider bypassed lstat evidence")
      case ordinary.provenance
      when dynamic_binary{provider_file} then
        test.assert(provider_file == provider,
                    "ordinary executable-path provider lost its provenance")
      else
        test.assert(false,
                    "ordinary executable-path provider became embedded/static")
      end
    end, nil)
  end)
end

function test_compiler_bridge_rejects_mixed_binary_providers_across_attempts(
    _context: test.Context)
  run_bridge(function ()
    local first_provider = test_paths.temporary_name()
    local second_provider = first_provider .. ".second"
    defer do
      fs.unlink(second_provider)
      fs.unlink(first_provider)
    end
    fs.write_file(first_provider, "first provider")
    fs.write_file(second_provider, "fallback provider")
    with_fixture("binary-provider-switch", function ()
      local compiler = bridge.load()
      local analysis = compiler:analyze_incremental({
        bridge.ProjectModule.new("fixture.first", {
          bridge.SourceFile.new(test_paths.workspace_root() .. "/first.titan", ""),
        }),
        bridge.ProjectModule.new("fixture.second", {
          bridge.SourceFile.new(test_paths.workspace_root() .. "/second.titan", ""),
        }),
      }, {"fixture.first", "fixture.second"}, {})
      local binary? = analysis:find_module("fixture.binary")
      test.assert(binary ~= nil and binary.provider_identity == nil and
                  #analysis.provider_conflicts == 1 and
                  analysis.provider_conflicts[1] == "fixture.binary" and
                  #analysis.binary_provider_observations == 2 and
                  analysis.binary_provider_observations[1].provider_file ==
                    first_provider and
                  analysis.binary_provider_observations[2].provider_file ==
                    second_provider and
                  analysis.binary_provider_observations[1].provider_identity ~=
                    nil and
                  analysis.binary_provider_observations[2].provider_identity ~=
                    nil,
                  "mixed binary providers acquired a publishable identity")
      case binary.provenance
      when dynamic_binary{provider_file} then
        test.assert(provider_file == second_provider,
                    "provider-switch fixture did not retain its final result")
      else
        test.assert(false, "provider-switch fixture used source provenance")
      end
    end, first_provider)
  end)
end

function test_compiler_bridge_completion_catalog_owns_complete_pending_providers(_context: test.Context)
  run_bridge(function ()
    local provider = test_paths.temporary_name()
    local second = provider .. ".second"
    defer do fs.unlink(second); fs.unlink(provider) end
    fs.write_file(provider, "first provider")
    fs.write_file(second, "second provider")
    with_fixture("completion-catalog", function ()
      local compiler = bridge.load()
      local projects = {
        bridge.ProjectModule.new("fixture.first", {bridge.SourceFile.new(test_paths.workspace_root() .. "/first.titan", "old")}),
        bridge.ProjectModule.new("fixture.second", {bridge.SourceFile.new(test_paths.workspace_root() .. "/second.titan", "old")}),
        bridge.ProjectModule.new("fixture.last", {bridge.SourceFile.new(test_paths.workspace_root() .. "/last.titan", "old")}),
      }
      compiler:analyze_incremental(projects, {"fixture.first", "fixture.second", "fixture.last"}, {})
      test.assert(#compiler:completion_binary_catalog() == 2,
        "independent root attempts replaced earlier provider siblings")
      compiler:analyze_incremental(projects, {"fixture.last"}, {})
      test.assert(#compiler:completion_binary_catalog() == 2,
        "a later fixed-point iteration lost an unpublished provider")
      projects[1] = bridge.ProjectModule.new("fixture.first", {
        bridge.SourceFile.new(test_paths.workspace_root() .. "/first.titan", "replacement"),
      })
      compiler:analyze_incremental(projects, {"fixture.first"}, {})
      local catalog = compiler:completion_binary_catalog()
      test.assert(#catalog == 2)
      local fresh = false
      for index = 1, #catalog do
        test.assert(catalog[index].module_name ~= "fixture.first.old",
          "recaptured provider kept its removed sibling")
        if catalog[index].module_name == "fixture.first.fresh" then fresh = true end
      end
      test.assert(fresh, "recaptured provider lost its replacement inventory")
      fs.write_file(provider, "same pathname now contains a replaced archive")
      catalog = compiler:completion_binary_catalog()
      test.assert(#catalog == 1 and catalog[1].filename == second,
        "stale pending provider bytes survived a same-path replacement")
      compiler:release_completion_exports()
      test.assert(#compiler:completion_binary_catalog() == 0,
        "accepted publication retained pending compiler catalog memory")
      compiler:analyze_incremental(projects, {"fixture.second"}, {})
      compiler:configure(bridge.CompilerConfiguration.new { binary_root = "/different/providers" })
      test.assert(#compiler:completion_binary_catalog() == 0,
        "configuration change retained an old provider selection")
    end, provider)
  end)
end

local function preserves_binary_observation_when_final_snapshot_is_source()
  local first_provider = test_paths.temporary_name()
  local second_provider = first_provider .. ".second"
  defer do
    fs.unlink(second_provider)
    fs.unlink(first_provider)
  end
  fs.write_file(first_provider, "first provider")
  fs.write_file(second_provider, "final source provider")
  with_fixture("binary-provider-to-source", function ()
    local compiler = bridge.load()
    local analysis = compiler:analyze_incremental({
      bridge.ProjectModule.new("fixture.first", {
        bridge.SourceFile.new(test_paths.workspace_root() .. "/first.titan", ""),
      }),
      bridge.ProjectModule.new("fixture.second", {
        bridge.SourceFile.new(test_paths.workspace_root() .. "/second.titan", ""),
      }),
    }, {"fixture.first", "fixture.second"}, {})
    local provider? = analysis:find_module("fixture.binary")
    test.assert(provider ~= nil and #analysis.provider_conflicts == 0 and
                #analysis.binary_provider_observations == 1 and
                analysis.binary_provider_observations[1].module_name ==
                  "fixture.binary" and
                analysis.binary_provider_observations[1].kind == "dynamic" and
                analysis.binary_provider_observations[1].provider_file ==
                  first_provider and
                analysis.binary_provider_observations[1].provider_identity ~=
                  nil,
                "source-final result lost its earlier binary observation")
    case provider.provenance
    when external_source{main_file, source_files} then
      test.assert(main_file == second_provider,
                  "source-final fixture lost its final provider")
    else
      test.assert(false, "source-final fixture retained binary provenance")
    end
  end, first_provider)
end

function test_compiler_bridge_preserves_binary_observation_before_source_result(
    _context: test.Context)
  run_bridge(function ()
    preserves_binary_observation_when_final_snapshot_is_source()
  end)
end

function test_compiler_bridge_normalizes_external_resolution_fingerprints(
    _context: test.Context)
  with_fixture("external-resolution", function ()
    local compiler = bridge.load()
    local roots = {"/configured/first", "/configured/second"}
    local includes = {"/configured/include"}
    compiler:configure(bridge.CompilerConfiguration.new {
      source_roots = roots,
      binary_root = "/configured/binary",
      include_roots = includes,
    })
    roots[1] = "/mutated/source"
    includes[1] = "/mutated/include"
    local resolutions = compiler:resolve_external_modules({"app"}, {
      bridge.ExternalResolutionRequest.new("vendor.source", true),
      bridge.ExternalResolutionRequest.new("vendor.dynamic", false),
      bridge.ExternalResolutionRequest.new("vendor.static", false),
      bridge.ExternalResolutionRequest.new("vendor.missing", false),
      bridge.ExternalResolutionRequest.new("vendor.broken", false),
    })
    test.assert(#resolutions == 5,
                "external resolver result count changed at the bridge")
    test.assert(resolutions[1].module_name == "vendor.source" and
                resolutions[1].error == nil and
                resolutions[1].provenance ~= nil,
                "external source resolution lost typed identity")
    case resolutions[1].provenance as bridge.Provenance
    when external_source{main_file, source_files} then
      test.assert(main_file == "/external/vendor/vendor.titan" and
                  #source_files == 2 and
                  source_files[2] ==
                    "/external/vendor/part.titan",
                  "folder resolution lost a constituent")
    else test.assert(false, "external source used a binary provenance")
    end
    case resolutions[2].provenance as bridge.Provenance
    when dynamic_binary{provider_file} then
      test.assert(provider_file == "/binary/vendor.so",
                  "dynamic provider path was not normalized")
    else test.assert(false, "dynamic provider used the wrong provenance")
    end
    case resolutions[3].provenance as bridge.Provenance
    when static_binary{provider_file} then
      test.assert(provider_file == "/binary/vendor.a",
                  "static provider path was not normalized")
    else test.assert(false, "static provider used the wrong provenance")
    end
    test.assert(resolutions[4].provenance == nil and
                resolutions[4].error == nil and
                resolutions[5].provenance == nil and
                resolutions[5].error == "invalid provider metadata",
                "missing/error resolution escaped the typed contract")
  end)
end

function test_compiler_bridge_reuses_unchanged_preprocessing_configuration(
    _context: test.Context)
  with_fixture("external-resolution", function ()
    local compiler = bridge.load()
    local split = compiler.driver["split_shell_words"] as
      function (string): (value, value)
    local parses = 0
    compiler.driver["split_shell_words"] = function (input: string): (value, value)
      parses = parses + 1
      return split(input)
    end
    compiler:configure(bridge.CompilerConfiguration.new {
      source_roots = {"/first"}, cppflags = "-DPROJECT=1",
    })
    compiler:configure(bridge.CompilerConfiguration.new {
      source_roots = {"/first"}, cppflags = "-DPROJECT=1",
    })
    compiler:configure(bridge.CompilerConfiguration.new {
      source_roots = {"/second"}, cppflags = "-DPROJECT=1",
    })
    test.assert(parses == 1,
                "unchanged project flags were reparsed during reconfiguration")
  end)
end

function test_compiler_bridge_normalizes_contextual_owner_provenance(
    _context: test.Context)
  run_bridge(function ()
    local provider = test_paths.temporary_name()
    defer fs.unlink(provider)
    fs.write_file(provider, "fixture static provider")
    with_fixture("contextual-resolution", function ()
      local compiler = bridge.load()
      local analysis = compiler:analyze("fixture", {
        bridge.ProjectModule.new("fixture", {bridge.SourceFile.new(
          test_paths.workspace_root() .. "/fixture.titan", "saved fixture")}),
      })
      test.assert(#analysis.contextual_resolutions == 1,
                  "contextual owner metadata was not normalized")
      local resolution = analysis.contextual_resolutions[1]
      test.assert(resolution.owner_module == "fixture.owner" and
                  resolution.exposer_module == "fixture.facade" and
                  resolution.ordinary_lookup and
                  resolution.provider_identity ~= nil and
                  resolution.provider_identity.path == provider and
                  resolution.provider_identity.kind == "file" and
                  resolution.provider_identity.size ==
                    #"fixture static provider",
                  "contextual owner graph identity was changed")
      case resolution.provenance
      when static_binary{provider_file} then
        test.assert(provider_file == provider,
                    "contextual owner provider path was lost")
      else
        test.assert(false,
                    "contextual owner used the wrong provenance variant")
      end
    end, provider)
  end)
end

function test_compiler_bridge_resets_contextual_provider_observations_between_analyses(
    _context: test.Context)
  run_bridge(function ()
    local provider = test_paths.temporary_name()
    defer fs.unlink(provider)
    fs.write_file(provider, "fixture static provider")
    with_fixture("contextual-resolution-once", function ()
      local compiler = bridge.load()
      local project = bridge.ProjectModule.new(
        "fixture", {bridge.SourceFile.new(
          test_paths.workspace_root() .. "/fixture.titan", "saved fixture")})
      local first = compiler:analyze("fixture", {project})
      local second = compiler:analyze("fixture", {project})
      test.assert(#first.contextual_resolutions == 1 and
                  first.contextual_resolutions[1].provider_identity ~= nil,
                  "first analysis lost its observed provider identity")
      test.assert(#second.contextual_resolutions == 1 and
                  second.contextual_resolutions[1].provider_identity == nil,
                  "second analysis reused a stale provider observation")
    end, provider)
  end)
end

function test_compiler_bridge_normalizes_and_restats_c_header_dependencies(
    _context: test.Context)
  with_fixture("header-metadata", function ()
    local compiler = bridge.load()
    local analysis = compiler:analyze("fixture", {
      bridge.ProjectModule.new("fixture", {bridge.SourceFile.new(
        test_paths.workspace_root() .. "/fixture.titan", "saved fixture")}),
    })
    local module? = analysis:find_module("fixture")
    test.assert(module ~= nil and #module.c_header_dependencies == 3,
                "per-module C header metadata was not normalized")
    local snapshot: bridge.ModuleSnapshot = module
    case snapshot.c_header_dependencies[1].kind
    when file() then
    else test.assert(false, "direct C header used search-input kind")
    end
    case snapshot.c_header_dependencies[2].kind
    when search() then
    else test.assert(false, "include candidate used file-input kind")
    end
    case snapshot.c_header_dependencies[3].kind
    when origin() then
    else test.assert(false, "declaring header origin was collapsed into file content")
    end
    local current, changed = compiler:restat_c_header_dependencies(
      snapshot.c_header_dependencies,bridge.header_validation())
    local observation = current[1].observation as bridge.HeaderObservation
    test.assert(changed and observation.modified_seconds == 123 and
      observation.modified_nanoseconds == 456 and
      observation.physical_identity == "device:inode:target" and
      observation.precision == "ns" and observation.size == 12 and
      observation.changed_seconds == 122 and observation.changed_nanoseconds == 7,
      "header restat lost its observation or explicit change result")
    test.assert(current[1].path == fixture_headers_root() .. "/direct.h" and
                current[1].identity == "direct bytes:restatted" and
                current[2].path == fixture_headers_root() .. "/earlier.h" and
                current[2].identity == "missing candidate:restatted" and
                current[3].path == current[1].path and
                current[3].identity == snapshot.c_header_dependencies[3].identity .. ":restatted",
                "typed restat changed ownership/order or lost identities")
    case current[3].kind
    when origin() then
    else test.assert(false, "typed restat did not round-trip the origin input")
    end
  end)
end

local function expect_c_header_metadata_error(mode: string,
                                              expected: string)
  with_fixture(mode, function ()
    local compiler = bridge.load()
    local rejected = false
    do
      compiler:analyze("fixture", {
        bridge.ProjectModule.new("fixture", {bridge.SourceFile.new(
          test_paths.workspace_root() .. "/fixture.titan", "saved fixture")}),
      })
    catch
      rejected = true
      test.assert(error is bridge.BridgeError,
                  "malformed C header metadata raised an untyped error")
      local failure = error as bridge.BridgeError
      test.assert(strings.find(failure.message, expected) ~= nil,
                  failure.message)
    end
    test.assert(rejected, "malformed C header metadata was accepted")
  end)
end

function test_compiler_bridge_rejects_malformed_c_header_dependencies(
    _context: test.Context)
  expect_c_header_metadata_error(
    "header-relative-path", "path must be absolute")
  expect_c_header_metadata_error(
    "header-duplicate", "repeats file input")
  expect_c_header_metadata_error(
    "header-unknown-kind", "unknown kind 'directory'")
  expect_c_header_metadata_error(
    "header-empty-identity", "identity must be nonempty")
end

function test_compiler_bridge_rejects_false_c_header_dependencies(
    _context: test.Context)
  expect_c_header_metadata_error("header-false", "must be a Lua array")
end

function test_compiler_bridge_normalizes_annotated_ast_and_provenance(
    _context: test.Context)
  with_fixture("valid", function ()
    local compiler = bridge.load()
    test.assert(compiler:installed_binary_modules_root() ==
                  fixture_sdk_root(),
                "compiler installation library directory was not exposed")
    local analysis = compiler:analyze("fixture", {bridge.ProjectModule.new(
      "fixture", {bridge.SourceFile.new(
        test_paths.workspace_root() .. "/fixture.titan", "saved fixture")})})
    test.assert(#analysis.diagnostics == 0, "valid fixture had diagnostics")
    test.assert(compiler:has_project_entry("fixture"),
                "project declarations were not retained behind the bridge")
    test.assert(not compiler:has_project_entry("fixture.external"),
                "external annotated AST leaked into retained project state")

    local project? = analysis:find_module("fixture")
    local external? = analysis:find_module("fixture.external")
    test.assert(project ~= nil and external ~= nil,
                "compiler imported modules were not normalized")
    test.assert(project.manifest ~= nil and
                strings.find(project.manifest.serialized, "fixture") ~= nil and
                project.manifest.source_serialized ==
                  "Source(\"fixture\")",
                "project public/source manifests were not serialized")
    test.assert(#project.imports == 1 and
                project.imports[1].module_name == "fixture.external" and
                project.imports[1].source_required,
                "Titan import metadata was not normalized")
    test.assert(#external.nodes == 0 and #external.symbols == 0,
                "external source AST was exposed as project semantic state")
    test.assert(external.manifest ~= nil and
                external.manifest.source_serialized ==
                  "Source(\"fixture.external\")",
                "external source-visible manifest was not normalized")
    case external.provenance
    when external_source{main_file, source_files} then
      test.assert(#source_files == 2 and
                  source_files[2] == "/external/part.titan",
                  "external folder source provenance lost member paths")
    else
      test.assert(false, "external source used the wrong provenance variant")
    end

    local saw_cast = false
    local saw_computed_field = false
    local saw_computed_key = false
    for index = 1, #project.nodes do
      local node = project.nodes[index]
      if node.tag == "Ast.ExpCast" then
        saw_cast = node.synthetic and node.original_type ~= nil and
          node.original_type.display == "integer" and
          node.coerced_type ~= nil and node.coerced_type.display == "float"
      elseif node.tag == "Ast.Field" then
        saw_computed_field = node.name == nil
      elseif node.tag == "Ast.ExpString" and node.parent_id ~= nil then
        saw_computed_key =
          project.nodes[node.parent_id].tag == "Ast.Field"
      end
    end
    test.assert(saw_cast, "implicit compiler coercion was not normalized")
    test.assert(saw_computed_field and saw_computed_key,
                "computed initializer key was not normalized as an AST child")

    local definition_id: string? = nil
    local reference_id: string? = nil
    local saw_local_import = false
    for index = 1, #project.symbols do
      local symbol = project.symbols[index]
      if symbol.name == "count" then
        case symbol.role
        when definition() then definition_id = symbol.declaration_id
        when reference() then reference_id = symbol.declaration_id
        else
        end
      elseif symbol.name == "dependency" then
        case symbol.role
        when import_alias() then
          saw_local_import = symbol.is_local and symbol.type_info ~= nil and
            symbol.type_info.display == "module fixture.external"
        else
        end
      end
    end
    test.assert(definition_id ~= nil and definition_id == reference_id,
                "local definition and reference identities did not join")
    test.assert(saw_local_import,
                "compiler import alias was not normalized as a local term")
  end)
end

function test_compiler_bridge_normalizes_invalid_source_diagnostic(
    _context: test.Context)
  with_fixture("invalid-source", function ()
    local compiler = bridge.load()
    local analysis = compiler:analyze("fixture", {bridge.ProjectModule.new(
      "fixture", {bridge.SourceFile.new(test_paths.workspace_root() .. "/fixture.titan", "bad")})})
    test.assert(#analysis.diagnostics == 1,
                "invalid fixture did not produce one diagnostic")
    local diagnostic = analysis.diagnostics[1]
    case diagnostic.kind
    when syntax() then
    else test.assert(false, "syntax diagnostic used the wrong kind")
    end
    test.assert(diagnostic.location ~= nil and
                diagnostic.location.line == 2 and
                diagnostic.location.column == 7,
                "diagnostic location was not normalized")
  end)
end

local function preload_real_compiler()
  local preload = lua.load([==[
return function()
  require("titan-compiler.parser")
  require("titan-compiler.checker")
  require("titan-compiler.types")
  require("titan-compiler.driver")
end
]==], "=compiler_bridge_real_compiler", nil)() as EmptyFunction
  preload()
end

local function assert_declared_project_entry(compiler: bridge.Compiler,
                                             module_name: string)
  -- The compiler owns the opaque Lua entry. Keep the recursive representation
  -- assertion at that boundary instead of teaching the typed server its shape.
  local inspect = lua.load([==[
return function(entry, name)
  assert(type(entry) == "table", name .. " has no retained declarations")
  assert(entry.ast == nil, name .. " retained its checked source AST")
  local pending, seen = {entry}, {}
  while #pending > 0 do
    local node = table.remove(pending)
    if type(node) == "table" and not seen[node] then
      seen[node] = true
      local tag = rawget(node, "_tag")
      if type(tag) == "string" then
        assert(not tag:match("^Ast%."),
               name .. " retained a source syntax node: " .. tag)
      end
      for key, item in pairs(node) do
        if type(key) == "table" then pending[#pending + 1] = key end
        if type(item) == "table" then pending[#pending + 1] = item end
      end
    end
  end
end
]==], "=compiler_bridge_declared_entry", nil)() as function (value, string): ()
  inspect(compiler.project_entries[module_name], module_name)
end

local function retained_header_inputs(compiler: bridge.Compiler,
                                      module_name: string): {bridge.CHeaderDependency}
  local entry = compiler.project_entries[module_name] as {string: value}
  return bridge.normalize_c_header_dependencies(
    entry["c_header_dependencies"], "restored project header observations")
end

local function executes_installed_compiler_on_valid_and_invalid_source()
  preload_real_compiler()
  local compiler = bridge.load()
  local valid = compiler:analyze("bridge.fixture.valid", {
    bridge.ProjectModule.new("bridge.fixture.valid", {bridge.SourceFile.new(
      test_paths.workspace_root() .. "/bridge_fixture_valid.titan",
      "function widen(n: integer): float\n" ..
      "  local result: float = n\n" ..
      "  return result\n" ..
      "end\n")})
  })
  test.assert(#valid.diagnostics == 0,
              "installed compiler rejected representative valid source")
  local module? = valid:find_module("bridge.fixture.valid")
  test.assert(module ~= nil and module.manifest ~= nil and #module.nodes > 0,
              "installed compiler result was not normalized")

  local invalid = compiler:analyze("bridge.fixture.invalid", {
    bridge.ProjectModule.new("bridge.fixture.invalid", {bridge.SourceFile.new(
      test_paths.workspace_root() .. "/bridge_fixture_invalid.titan",
      "function broken(: integer)\nend\n")})
  })
  test.assert(#invalid.diagnostics > 0 and
              invalid.diagnostics[1].location ~= nil,
              "installed compiler syntax failure was not normalized")
catch
  if error is bridge.BridgeError then
    local failure = error as bridge.BridgeError
    raise failure.module_name .. ": " .. failure.message
  end
  raise
end

function test_compiler_bridge_executes_installed_compiler_on_valid_and_invalid_source(
    _context: test.Context)
  test_runtime.run(executes_installed_compiler_on_valid_and_invalid_source)
end

local function recovers_after_dependency_checking_errors()
  preload_real_compiler()
  local compiler = bridge.load()
  local consumer = bridge.ProjectModule.new("manifest_consumer", {
    bridge.SourceFile.new(test_paths.workspace_root() .. "/manifest_consumer.titan", [[
local dependency = import "manifest_middle.titan"
local healthy = import "manifest_healthy"
function answer(): integer return dependency.answer() + healthy.answer() end
]]),
  })
  local middle = bridge.ProjectModule.new("manifest_middle", {
    bridge.SourceFile.new(test_paths.workspace_root() .. "/manifest_middle.titan", [[
local dependency = import "manifest_dependency"
function answer(): integer return dependency.answer() end
]]),
  })
  local healthy = bridge.ProjectModule.new("manifest_healthy", {
    bridge.SourceFile.new(test_paths.workspace_root() .. "/manifest_healthy.titan",
      "function answer(): integer return 1 end\n"),
  })
  local filename = test_paths.workspace_root() .. "/manifest_dependency.titan"
  local dependency = bridge.ProjectModule.new("manifest_dependency", {
    bridge.SourceFile.new(filename,
      "function answer(): integer return 'invalid' end\n"),
  })
  local failed = compiler:analyze("manifest_consumer", {
    consumer, middle, dependency, healthy,
  })
  local failed_consumer? = failed:find_module("manifest_consumer")
  local failed_middle? = failed:find_module("manifest_middle")
  local failed_dependency? = failed:find_module("manifest_dependency")
  local healthy_snapshot? = failed:find_module("manifest_healthy")
  test.assert(#failed.diagnostics > 0 and failed_consumer ~= nil and
              failed_middle ~= nil and failed_dependency ~= nil,
              "dependency checking error prevented project normalization")
  test.assert(failed_consumer.manifest == nil and
              failed_middle.manifest == nil and
              failed_dependency.manifest == nil and
              not compiler:has_project_entry("manifest_consumer") and
              not compiler:has_project_entry("manifest_middle") and
              not compiler:has_project_entry("manifest_dependency"),
              "failed dependency closure retained reusable interfaces")
  test.assert(healthy_snapshot ~= nil and healthy_snapshot.manifest ~= nil,
              "dependency error discarded a healthy sibling interface")
  assert_declared_project_entry(compiler, "manifest_healthy")
  local diagnostic = failed.diagnostics[1]
  test.assert(diagnostic.location ~= nil and
              diagnostic.location.filename == filename and
              strings.find(diagnostic.message, "could not serialize") == nil,
              "ordinary checking error was replaced by a serialization failure")

  dependency = bridge.ProjectModule.new("manifest_dependency", {
    bridge.SourceFile.new(filename,
      "function answer(): integer return 42 end\n"),
  })
  local recovered = compiler:analyze("manifest_consumer", {
    consumer, middle, dependency, healthy,
  })
  local recovered_consumer? = recovered:find_module("manifest_consumer")
  local recovered_dependency? = recovered:find_module("manifest_dependency")
  test.assert(#recovered.diagnostics == 0 and
              recovered_consumer ~= nil and recovered_consumer.manifest ~= nil and
              recovered_dependency ~= nil and recovered_dependency.manifest ~= nil,
              "repairing the dependency did not recover valid manifests")
  assert_declared_project_entry(compiler, "manifest_consumer")
  assert_declared_project_entry(compiler, "manifest_middle")
  assert_declared_project_entry(compiler, "manifest_dependency")
end

function test_compiler_bridge_recovers_after_dependency_checking_errors(
    _context: test.Context)
  test_runtime.run(recovers_after_dependency_checking_errors)
end

local function runs_incremental_declared_interface_cache()
  preload_real_compiler()
  local compiler = bridge.load()
  local provider = bridge.ProjectModule.new("bridge_cache_provider", {
    bridge.SourceFile.new(
      test_paths.workspace_root() .. "/bridge_cache_provider.titan",
      "local function secret(): integer\n" ..
      "  local body_only_answer = 41\n" ..
      "  return body_only_answer\n" ..
      "end\n")
  })
  local consumer = bridge.ProjectModule.new("bridge_cache_consumer", {
    bridge.SourceFile.new(
      test_paths.workspace_root() .. "/bridge_cache_consumer.titan",
      "local provider = import \"bridge_cache_provider.titan\"\n" ..
      "function answer(): integer return provider.secret() end\n")
  })

  local initial = compiler:analyze(
    "bridge_cache_consumer", {provider, consumer})
  test.assert(#initial.diagnostics == 0 and
              initial:find_module("bridge_cache_provider") ~= nil and
              initial:find_module("bridge_cache_consumer") ~= nil,
              "initial source-required project closure did not compile")
  assert_declared_project_entry(compiler, "bridge_cache_provider")
  assert_declared_project_entry(compiler, "bridge_cache_consumer")

  local edited_consumer = bridge.ProjectModule.new(
    "bridge_cache_consumer", {bridge.SourceFile.new(
      test_paths.workspace_root() .. "/bridge_cache_consumer.titan",
      "local provider = import \"bridge_cache_provider.titan\"\n" ..
      "function answer(): integer return provider.secret() + 1 end\n")})
  local incremental = compiler:analyze_incremental(
    {provider, edited_consumer}, {"bridge_cache_consumer"}, {})
  test.assert(#incremental.diagnostics == 0,
              "dirty consumer failed against its retained source-visible declarations")
  test.assert(incremental:find_module("bridge_cache_consumer") ~= nil and
              incremental:find_module("bridge_cache_provider") == nil,
              "unchanged source-required provider was reparsed or rechecked")
  test.assert(compiler:has_project_entry("bridge_cache_provider"),
              "clean project declarations disappeared from the private bridge cache")
  assert_declared_project_entry(compiler, "bridge_cache_provider")
  assert_declared_project_entry(compiler, "bridge_cache_consumer")
end

function test_compiler_bridge_reuses_unchanged_declared_interface_incrementally(
    _context: test.Context)
  test_runtime.run(runs_incremental_declared_interface_cache)
end

local function transitive_private_nominal_projects(
    buffer_source: string?, consumer_source: string?): {bridge.ProjectModule}
  local root = test_paths.workspace_root()
  return {
    bridge.ProjectModule.new("private_nominal_buffer", {
      bridge.SourceFile.new(root .. "/private_nominal_buffer.titan",
        buffer_source or [[
record BufferStore
  local text: string
end
function create(): BufferStore return { text = "ok" } end
function BufferStore:inputs(): string return self.text end
]])}),
    bridge.ProjectModule.new("private_nominal_application", {
      bridge.SourceFile.new(root .. "/private_nominal_application.titan", [[
local buffer = import "private_nominal_buffer"
record Application
  local const buffers: buffer.BufferStore
end
function create(): Application return { buffers = buffer.create() } end
]])}),
    bridge.ProjectModule.new("private_nominal_consumer", {
      bridge.SourceFile.new(root .. "/private_nominal_consumer.titan",
        consumer_source or [[
local application = import "private_nominal_application.titan"
function answer(): string return application.create().buffers:inputs() end
]])}),
  }
end

local function reuses_transitive_private_nominal_incrementally()
  preload_real_compiler()
  local compiler = bridge.load()
  local projects = transitive_private_nominal_projects(nil, nil)
  local initial = compiler:analyze("private_nominal_consumer", projects)
  test.assert(#initial.diagnostics == 0,
    "initial transitive private nominal fixture failed")
  assert_declared_project_entry(compiler, "private_nominal_buffer")
  assert_declared_project_entry(compiler, "private_nominal_application")

  local edited = transitive_private_nominal_projects(nil, [[
local application = import "private_nominal_application.titan"
function answer(): string return application.create().buffers:inputs() .. "!" end
]])
  local changed = compiler:analyze_incremental(
    edited, {"private_nominal_consumer"}, {})
  test.assert(#changed.diagnostics == 0 and
    changed:find_module("private_nominal_consumer") ~= nil,
    "dirty source importer lost the ordinary dependency owning its private field type")
  test.assert(changed:find_module("private_nominal_buffer") == nil and
    changed:find_module("private_nominal_application") == nil,
    "consumer-only analysis rechecked unchanged nominal owners")
  assert_declared_project_entry(compiler, "private_nominal_buffer")
  assert_declared_project_entry(compiler, "private_nominal_application")
end

function test_compiler_bridge_reuses_transitive_private_nominal_incrementally(
    _context: test.Context)
  run_bridge(reuses_transitive_private_nominal_incrementally)
end

local function restores_transitive_private_nominal_payloads()
  preload_real_compiler()
  local compiler = bridge.load()
  local projects = transitive_private_nominal_projects(nil, nil)
  local initial = compiler:analyze("private_nominal_consumer", projects)
  test.assert(#initial.diagnostics == 0,
    "initial transitive private nominal payload fixture failed")
  local payloads = compiler:export_projects(projects, {
    "private_nominal_buffer", "private_nominal_application", "private_nominal_consumer",
  })
  test.assert(#payloads == 3,
    "transitive private nominal project closure did not encode")
  local restarted = bridge.load()
  local restored = restarted:restore_projects(projects, payloads)
  test.assert(#restored == 3,
    "transitive private nominal project closure did not restore")
  assert_declared_project_entry(restarted, "private_nominal_buffer")
  assert_declared_project_entry(restarted, "private_nominal_application")

  local edited = transitive_private_nominal_projects(nil, [[
local application = import "private_nominal_application.titan"
function answer(): string return application.create().buffers:inputs() .. "!" end
]])
  local changed = restarted:analyze_incremental(
    edited, {"private_nominal_consumer"}, {})
  test.assert(#changed.diagnostics == 0 and
    changed:find_module("private_nominal_consumer") ~= nil and
    changed:find_module("private_nominal_buffer") == nil and
    changed:find_module("private_nominal_application") == nil,
    "restored source-private field could not call its ordinary dependency's method")
end

