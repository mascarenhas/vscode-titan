local fs = import "fs"
local test = import "test"
local lua = import "titan.lua"
local strings = import "string"
local bridge = import "server.compiler_bridge"
local features = import "server.semantic_features"
local source_text = import "server.source_text"
local test_runtime = import "server.test_runtime"

local type EmptyFunction = () -> ()
local type FixtureInstaller = (string, string?) -> value

local function run_bridge(body: EmptyFunction)
  do
    test_runtime.run(body)
  catch
    if error is bridge.BridgeError then
      local failure = error as bridge.BridgeError
      raise failure.module_name .. ": " .. failure.message
    end
    raise
  end
end

local function new_fixture_installer(): FixtureInstaller
  return lua.load([==[
return function(mode, contextual_provider_file)
  local names = {
    "titan-compiler.parser",
    "titan-compiler.checker",
    "titan-compiler.types",
    "titan-compiler.driver",
  }
  local old_path, old_cpath = package.path, package.cpath
  local old_loaded = {}
  for _, name in ipairs(names) do old_loaded[name] = package.loaded[name] end

  local integer = { _tag = "Type.Integer" }
  local float = { _tag = "Type.Float" }
  local function module_type(name)
    return { _tag = "Type.Module", name = name }
  end
  local function source_manifest(name)
    if name == "fixture" then
      if mode == "missing-source-manifest" then return nil end
      if mode == "empty-source-manifest" then return "" end
      if mode == "wrong-source-manifest" then return 42 end
    end
    return "Source(" .. string.format("%q", name) .. ")"
  end
  local parser = {
    parse = function() return {} end,
    error_to_string = function(value) return tostring(value) end,
  }
  local checker = { check = function() return module_type("unused"), {} end }
  local types = {
    registry = {},
    tostring = function(value)
      if value._tag == "Type.Integer" then return "integer" end
      if value._tag == "Type.Float" then return "float" end
      return value._tag
    end,
    serialize = function(value)
      return "Module(" .. string.format("%q", value.name) .. ",{}, {})"
    end,
  }
  local driver = {
    TITAN_ABI_VERSION = mode == "incompatible" and "99" or "2",
    TITAN_VERSION = "0.6.0",
    TITAN_LIBRARY_VERSION = "0.6",
    LANGUAGE_SERVER_API_VERSION =
      mode == "wrong-language-server-api" and 2 or 3,
    TITAN_SOURCE_PATH = ".",
    TITAN_BIN_PATH = "",
    INSTALL_PATHS = { titan_bin = "/opt/titan/lib/titan/0.6" },
    imported = {},
  }
  if mode == "missing-abi" then driver.TITAN_ABI_VERSION = nil end
  if mode == "older-same-abi" then
    driver.LANGUAGE_SERVER_API_VERSION = nil
  end
  driver.new_resolver_context = function(options)
    assert(type(options.io) == "userdata")
    return {
      options = options,
      io = options.io,
      contextual_resolutions = {},
      checked_source_modules = {},
    }
  end
  local contextual_finalize_count = 0
  local binary_load_count = 0
  driver.finalize_resolver_context = function(context)
    if mode == "contextual-resolution" or
       mode == "contextual-resolution-once" then
      contextual_finalize_count = contextual_finalize_count + 1
      local provider_file = assert(contextual_provider_file)
      if mode ~= "contextual-resolution-once" or
         contextual_finalize_count == 1 then
        local metadata, metadata_error = context.io:lstat(provider_file)
        assert(metadata and metadata_error == nil)
      end
      context.contextual_resolutions["fixture.facade\0fixture.owner"] = {
        owner = "fixture.owner",
        exposer = "fixture.facade",
        kind = "static",
        provider_file = provider_file,
        ordinary_lookup = true,
      }
    end
    return context
  end
  driver.close_resolver_context = function() return true end
  driver.close_loader = function() return true end
  driver.resolve_external_modules = function(requests, known_sources, options)
    assert(type(options.context) == "table")
    assert(type(options.context.io) == "userdata")
    if mode ~= "external-resolution" then return {} end
    assert(driver.TITAN_SOURCE_PATH == "/configured/source")
    assert(driver.TITAN_BIN_PATH == "/configured/binary")
    assert(known_sources.app == true)
    assert(requests["vendor.source"] == true)
    assert(requests["vendor.dynamic"] == false)
    assert(requests["vendor.static"] == false)
    assert(requests["vendor.missing"] == false)
    assert(requests["vendor.broken"] == false)
    return {
      ["vendor.source"] = {
        kind = "source",
        main_file = "/external/vendor/vendor.titan",
        source_files = {
          "/external/vendor/vendor.titan",
          "/external/vendor/part.titan",
        },
      },
      ["vendor.dynamic"] = {
        kind = "dynamic",
        provider_file = "/binary/vendor.so",
      },
      ["vendor.static"] = {
        kind = "static",
        provider_file = "/binary/vendor.a",
      },
      ["vendor.missing"] = { kind = "missing" },
      ["vendor.broken"] = {
        kind = "error",
        message = "invalid provider metadata",
      },
    }
  end
  if mode ~= "same-api-missing-restat" then
    driver.restat_c_header_dependencies = function(inputs, options)
      assert(type(options.context) == "table")
      assert(type(options.context.io) == "userdata")
      local result = {}
      for index, input in ipairs(inputs) do
        result[index] = {
          kind = input.kind,
          path = input.path,
          identity = mode == "header-metadata"
            and input.identity .. ":restatted" or input.identity,
        }
      end
      return result
    end
  end
  driver.defaultloader = function(_, options)
    if mode == "bad-loader" then return 42 end
    return function(name)
      if mode == "invalid-source" then
        return false,
          "/workspace/fixture.titan:2:7: syntax error: expected expression"
      end
      if mode == "bad-errors" then
        return true, module_type(name), "not an error array", {}
      end
      if mode == "missing-root" then
        return true, module_type(name), {}, {}
      end

      local decl = {
        _tag = "Ast.Decl",
        loc = { filename = "/workspace/fixture.titan", line = 2, col = 7 },
        name = "count",
        type = {
          _tag = "Ast.TypeInteger",
          loc = { filename = "/workspace/fixture.titan", line = 2, col = 14 },
        },
        _type = integer,
      }
      local declaration = {
        _tag = "Ast.TopLevelVar",
        loc = { filename = "/workspace/fixture.titan", line = 2, col = 1 },
        islocal = true,
        decl = decl,
        value = {
          _tag = "Ast.ExpInteger",
          loc = { filename = "/workspace/fixture.titan", line = 2, col = 24 },
          value = 1,
          _type = integer,
        },
        _type = integer,
      }
      local reference = {
        _tag = "Ast.VarName",
        loc = { filename = "/workspace/fixture.titan", line = 3, col = 24 },
        name = "count",
        _decl = declaration,
        _type = integer,
      }
      local cast = {
        _tag = "Ast.ExpCast",
        loc = { filename = "/workspace/fixture.titan", line = 3, col = 24 },
        exp = {
          _tag = "Ast.ExpVar",
          loc = { filename = "/workspace/fixture.titan", line = 3, col = 24 },
          var = reference,
          _type = integer,
        },
        target = {
          _tag = "Ast.TypeFloat",
          loc = { filename = "/workspace/fixture.titan", line = 3, col = 17 },
        },
        _type = float,
        _implicit_coercion = true,
        _adjustment = {
          kind = "direct_coercion",
          source = integer,
          target = float,
          coercion = { op = "integer_to_float" },
        },
      }
      local local_decl = {
        _tag = "Ast.Decl",
        loc = { filename = "/workspace/fixture.titan", line = 3, col = 9 },
        name = "widened",
        type = {
          _tag = "Ast.TypeFloat",
          loc = { filename = "/workspace/fixture.titan", line = 3, col = 17 },
        },
        _type = float,
      }
      local ast = {
        {
          _tag = "Ast.TopLevelImport",
          loc = { filename = "/workspace/fixture.titan", line = 1, col = 1 },
          _name_loc = {
            filename = "/workspace/fixture.titan", line = 1, col = 7,
          },
          _type = module_type("fixture.external"),
          localname = "dependency",
          modname = "fixture.external",
          source_required = true,
        },
        declaration,
        {
          _tag = "Ast.TopLevelFunc",
          loc = { filename = "/workspace/fixture.titan", line = 3, col = 1 },
          islocal = false,
          name = "widen",
          params = {},
          rettypes = {},
          typeparams = {},
          block = {
            _tag = "Ast.StatBlock",
            loc = { filename = "/workspace/fixture.titan", line = 3, col = 3 },
            stats = {
              {
                _tag = "Ast.StatDecl",
                loc = {
                  filename = "/workspace/fixture.titan", line = 3, col = 3,
                },
                decls = { local_decl },
                exps = { cast },
              },
              {
                _tag = "Ast.StatReturn",
                loc = {
                  filename = "/workspace/fixture.titan", line = 4, col = 3,
                },
                exps = {{
                  _tag = "Ast.ExpInitList",
                  loc = {
                    filename = "/workspace/fixture.titan", line = 4, col = 10,
                  },
                  fields = {{
                    _tag = "Ast.Field",
                    loc = {
                      filename = "/workspace/fixture.titan", line = 4, col = 11,
                    },
                    name = {
                      _tag = "Ast.ExpString",
                      loc = {
                        filename = "/workspace/fixture.titan",
                        line = 4,
                        col = 12,
                      },
                      value = "computed",
                    },
                    exp = {
                      _tag = "Ast.ExpInteger",
                      loc = {
                        filename = "/workspace/fixture.titan",
                        line = 4,
                        col = 27,
                      },
                      value = 1,
                      _type = integer,
                    },
                  }},
                }},
              },
            },
          },
          _paramnames = {},
          _type = {
            _tag = "Type.Function",
            params = {},
            rettypes = {},
            varargtype = false,
            flexrettype = false,
          },
        },
      }
      local header_dependencies = {}
      if mode == "header-metadata" then
        header_dependencies = {
          { kind = "file", path = "/headers/direct.h",
            identity = "direct bytes" },
          { kind = "search", path = "/headers/earlier.h",
            identity = "missing candidate" },
        }
      elseif mode == "header-relative-path" then
        header_dependencies = {
          { kind = "file", path = "headers/direct.h",
            identity = "direct bytes" },
        }
      elseif mode == "header-duplicate" then
        header_dependencies = {
          { kind = "file", path = "/headers/direct.h",
            identity = "first" },
          { kind = "file", path = "/headers/direct.h",
            identity = "second" },
        }
      elseif mode == "header-unknown-kind" then
        header_dependencies = {
          { kind = "directory", path = "/headers",
            identity = "directory state" },
        }
      elseif mode == "header-empty-identity" then
        header_dependencies = {
          { kind = "search", path = "/headers/earlier.h",
            identity = "" },
        }
      end
      driver.imported[name] = {
        kind = "source",
        ast = ast,
        type = module_type(name),
        source_manifest = source_manifest(name),
        filename = "/workspace/fixture.titan",
        source_files = { "/workspace/fixture.titan" },
        c_header_dependencies = header_dependencies,
      }
      driver.imported["fixture.external"] = {
        kind = "source",
        ast = {{
          _tag = "Ast.TopLevelFunc",
          loc = { filename = "/external/main.titan", line = 1, col = 1 },
          islocal = false,
          name = "hidden_raw_ast",
          params = {}, rettypes = {}, typeparams = {},
          block = { _tag = "Ast.StatBlock",
                    loc = { filename = "/external/main.titan", line = 1, col = 1 },
                    stats = {} },
          _paramnames = {},
          _type = {
            _tag = "Type.Function",
            params = {},
            rettypes = {},
            varargtype = false,
            flexrettype = false,
          },
        }},
        type = module_type("fixture.external"),
        source_manifest = source_manifest("fixture.external"),
        filename = "/external/main.titan",
        source_files = { "/external/main.titan", "/external/part.titan" },
        c_header_dependencies = {},
      }
      if mode == "dependency-diagnostic" then
        driver.imported[name].source_manifest = nil
        driver.imported["fixture.dependency"] = {
          kind = "source",
          ast = ast,
          type = module_type("fixture.dependency"),
          filename = "/workspace/dependency.titan",
          source_files = { "/workspace/dependency.titan" },
          c_header_dependencies = {},
        }
      end
      if mode == "binary-manifest" or
         mode == "binary-provider-switch" or
         mode == "binary-provider-to-source" then
        binary_load_count = binary_load_count + 1
        local provider_file = contextual_provider_file or
          "/binary/fixture.so"
        if mode == "binary-provider-switch" and binary_load_count > 1 then
          provider_file = provider_file .. ".second"
        end
        local source_provider =
          mode == "binary-provider-to-source" and binary_load_count > 1
        if contextual_provider_file and not source_provider then
          local metadata, metadata_error =
            assert(options.context).io:lstat(provider_file)
          assert(metadata and metadata_error == nil)
        end
        if source_provider then
          driver.imported["fixture.binary"] = {
            kind = "source",
            ast = {},
            type = module_type("fixture.binary"),
            source_manifest = source_manifest("fixture.binary"),
            filename = provider_file ..
              (mode == "binary-provider-to-source" and ".second" or ""),
            source_files = {provider_file ..
              (mode == "binary-provider-to-source" and ".second" or "")},
            c_header_dependencies = {},
          }
        else
          driver.imported["fixture.binary"] = {
            kind = "dynamic",
            type = module_type("fixture.binary"),
            filename = provider_file,
            c_header_dependencies = {},
          }
        end
      end
      local context = assert(options.context)
      context.checked_source_modules[
        #context.checked_source_modules + 1] = name
      if mode == "dependency-diagnostic" then
        context.checked_source_modules[
          #context.checked_source_modules + 1] = "fixture.dependency"
        return true, module_type(name), {
          "/workspace/dependency.titan:1:1: unknown variable 'missing'",
        }, {}
      end
      if mode == "progress" then
        -- The real compiler reports every completed source module. Exercise
        -- both noise classes the bridge must exclude from saved-file counts:
        -- an external module and a duplicate project checkpoint.
        context.io:yield("fixture.external")
        context.io:yield(name)
        context.io:yield(name)
      end
      return true, module_type(name), {}, {}
    end
  end

  if mode == "malformed-parser" then parser.parse = 42 end
  local replacements = {
    [names[1]] = parser,
    [names[2]] = checker,
    [names[3]] = types,
    [names[4]] = driver,
  }
  if mode == "missing-parser" then replacements[names[1]] = nil end
  package.path, package.cpath = "", ""
  for _, name in ipairs(names) do package.loaded[name] = replacements[name] end
  return function()
    package.path, package.cpath = old_path, old_cpath
    for _, name in ipairs(names) do package.loaded[name] = old_loaded[name] end
  end
end
]==], "=compiler_bridge_fixture", nil)() as FixtureInstaller
end

local function with_fixture(mode: string, body: EmptyFunction,
                            contextual_provider_file: string?)
  local restore = new_fixture_installer()(
    mode, contextual_provider_file) as EmptyFunction
  defer restore()
  body()
catch
  if error is bridge.BridgeError then
    local failure = error as bridge.BridgeError
    raise failure.module_name .. ": " .. failure.message
  end
  raise
end

local function expect_bridge_error(mode: string, expected: string)
  with_fixture(mode, function ()
    local rejected = false
    do
      bridge.load()
    catch
      rejected = true
      test.assert(error is bridge.BridgeError,
                  "bridge raised an untyped loading error")
      local failure = error as bridge.BridgeError
      test.assert(strings.find(failure.message, expected) ~= nil,
                  failure.message)
    end
    test.assert(rejected, "malformed compiler API was accepted")
  end)
end

function test_compiler_bridge_rejects_missing_incompatible_and_malformed_modules(
    _context: test.Context)
  expect_bridge_error("missing-parser", "cannot load compiler module")
  expect_bridge_error("missing-abi", "TITAN_ABI_VERSION")
  expect_bridge_error("incompatible", "incompatible Titan compiler ABI")
  expect_bridge_error("older-same-abi",
                      "matching Titan ABI alone is insufficient")
  expect_bridge_error("wrong-language-server-api",
                      "requires LANGUAGE_SERVER_API_VERSION 3")
  expect_bridge_error("same-api-missing-restat",
                      "'restat_c_header_dependencies' must be a function, " ..
                      "found nil. Install a Titan compiler implementing " ..
                      "LANGUAGE_SERVER_API_VERSION 3")
  expect_bridge_error("malformed-parser", "'parse' must be a function")
end

function test_compiler_bridge_rejects_malformed_compiler_results(
    _context: test.Context)
  with_fixture("bad-loader", function ()
    local compiler = bridge.load()
    local rejected = false
    do
      compiler:analyze("fixture", {bridge.ProjectModule.new(
        "fixture", {bridge.SourceFile.new("/workspace/fixture.titan", "")})})
    catch
      rejected = true
      test.assert(error is bridge.BridgeError,
                  "bad loader result raised an untyped error")
    end
    test.assert(rejected, "non-function defaultloader result was accepted")
  end)
  with_fixture("bad-errors", function ()
    local compiler = bridge.load()
    local rejected = false
    do
      compiler:analyze("fixture", {bridge.ProjectModule.new(
        "fixture", {bridge.SourceFile.new("/workspace/fixture.titan", "")})})
    catch
      rejected = true
      test.assert(error is bridge.BridgeError,
                  "bad diagnostics result raised an untyped error")
    end
    test.assert(rejected, "non-table compiler diagnostics were accepted")
  end)
end

local function expect_source_manifest_error(mode: string, expected: string)
  with_fixture(mode, function ()
    local compiler = bridge.load()
    local rejected = false
    do
      compiler:analyze("fixture", {bridge.ProjectModule.new(
        "fixture", {bridge.SourceFile.new(
          "/workspace/fixture.titan", "saved fixture")})})
    catch
      rejected = true
      test.assert(error is bridge.BridgeError,
                  "malformed source manifest raised an untyped error")
      local failure = error as bridge.BridgeError
      test.assert(strings.find(failure.message, expected) ~= nil,
                  failure.message)
    end
    test.assert(rejected, "malformed compiler source manifest was accepted")
  end)
end

function test_compiler_bridge_rejects_missing_empty_and_wrong_source_manifests(
    _context: test.Context)
  expect_source_manifest_error(
    "missing-source-manifest", "source manifest for 'fixture' must be a string")
  expect_source_manifest_error(
    "empty-source-manifest", "source manifest for 'fixture' must not be empty")
  expect_source_manifest_error(
    "wrong-source-manifest", "source manifest for 'fixture' must be a string")
end

function test_compiler_bridge_accepts_missing_manifest_after_dependency_error(
    _context: test.Context)
  with_fixture("dependency-diagnostic", function ()
    local compiler = bridge.load()
    local analysis = compiler:analyze("fixture", {
      bridge.ProjectModule.new("fixture", {bridge.SourceFile.new(
        "/workspace/fixture.titan", "saved fixture")}),
      bridge.ProjectModule.new("fixture.dependency", {bridge.SourceFile.new(
        "/workspace/dependency.titan", "invalid dependency")}),
    })
    local root? = analysis:find_module("fixture")
    local dependency? = analysis:find_module("fixture.dependency")
    test.assert(#analysis.diagnostics == 1 and root ~= nil and
                dependency ~= nil,
                "dependency error did not produce failed project snapshots")
    test.assert(root.manifest == nil and dependency.manifest == nil,
                "failed dependency closure acquired a valid manifest")
    test.assert(not compiler:has_project_ast("fixture") and
                not compiler:has_project_ast("fixture.dependency"),
                "failed dependency closure entered the incremental cache")
  end)
end

function test_compiler_bridge_keeps_source_manifests_off_binary_snapshots(
    _context: test.Context)
  run_bridge(function ()
    local provider = fs.tmpname()
    defer fs.unlink(provider)
    fs.write_file(provider, "fixture binary provider")
    with_fixture("binary-manifest", function ()
      local compiler = bridge.load()
      local analysis = compiler:analyze("fixture", {
        bridge.ProjectModule.new("fixture", {bridge.SourceFile.new(
          "/workspace/fixture.titan", "saved fixture")}),
      })
      local binary? = analysis:find_module("fixture.binary")
      test.assert(binary ~= nil and binary.manifest ~= nil and
                  binary.manifest.source_serialized == nil and
                  binary.provider_identity ~= nil and
                  binary.provider_identity.path == provider and
                  binary.provider_identity.size ==
                    #"fixture binary provider",
                  "binary snapshot lost its compiler-observed provider")
      case binary.provenance
      when dynamic_binary: provenance then
        test.assert(provenance.provider_file == provider,
                    "binary manifest fixture lost its provider provenance")
      else
        test.assert(false, "binary manifest fixture used source provenance")
      end
    end, provider)
  end)
end

function test_compiler_bridge_rejects_mixed_binary_providers_across_attempts(
    _context: test.Context)
  run_bridge(function ()
    local first_provider = fs.tmpname()
    local second_provider = first_provider .. ".second"
    defer do
      fs.unlink(second_provider)
      fs.unlink(first_provider)
    end
    fs.write_file(first_provider, "first provider")
    fs.write_file(second_provider, "fallback provider")
    with_fixture("binary-provider-switch", function ()
      local compiler = bridge.load()
      local analysis = compiler:analyze_incremental({
        bridge.ProjectModule.new("fixture.first", {
          bridge.SourceFile.new("/workspace/first.titan", ""),
        }),
        bridge.ProjectModule.new("fixture.second", {
          bridge.SourceFile.new("/workspace/second.titan", ""),
        }),
      }, {"fixture.first", "fixture.second"}, {})
      local binary? = analysis:find_module("fixture.binary")
      test.assert(binary ~= nil and binary.provider_identity == nil and
                  #analysis.provider_conflicts == 1 and
                  analysis.provider_conflicts[1] == "fixture.binary" and
                  #analysis.binary_provider_observations == 2 and
                  analysis.binary_provider_observations[1].provider_file ==
                    first_provider and
                  analysis.binary_provider_observations[2].provider_file ==
                    second_provider and
                  analysis.binary_provider_observations[1].provider_identity ~=
                    nil and
                  analysis.binary_provider_observations[2].provider_identity ~=
                    nil,
                  "mixed binary providers acquired a publishable identity")
      case binary.provenance
      when dynamic_binary: provenance then
        test.assert(provenance.provider_file == second_provider,
                    "provider-switch fixture did not retain its final result")
      else
        test.assert(false, "provider-switch fixture used source provenance")
      end
    end, first_provider)
  end)
end

local function preserves_binary_observation_when_final_snapshot_is_source()
  local first_provider = fs.tmpname()
  local second_provider = first_provider .. ".second"
  defer do
    fs.unlink(second_provider)
    fs.unlink(first_provider)
  end
  fs.write_file(first_provider, "first provider")
  fs.write_file(second_provider, "final source provider")
  with_fixture("binary-provider-to-source", function ()
    local compiler = bridge.load()
    local analysis = compiler:analyze_incremental({
      bridge.ProjectModule.new("fixture.first", {
        bridge.SourceFile.new("/workspace/first.titan", ""),
      }),
      bridge.ProjectModule.new("fixture.second", {
        bridge.SourceFile.new("/workspace/second.titan", ""),
      }),
    }, {"fixture.first", "fixture.second"}, {})
    local provider? = analysis:find_module("fixture.binary")
    test.assert(provider ~= nil and #analysis.provider_conflicts == 0 and
                #analysis.binary_provider_observations == 1 and
                analysis.binary_provider_observations[1].module_name ==
                  "fixture.binary" and
                analysis.binary_provider_observations[1].kind == "dynamic" and
                analysis.binary_provider_observations[1].provider_file ==
                  first_provider and
                analysis.binary_provider_observations[1].provider_identity ~=
                  nil,
                "source-final result lost its earlier binary observation")
    case provider.provenance
    when external_source: source then
      test.assert(source.main_file == second_provider,
                  "source-final fixture lost its final provider")
    else
      test.assert(false, "source-final fixture retained binary provenance")
    end
  end, first_provider)
end

function test_compiler_bridge_preserves_binary_observation_before_source_result(
    _context: test.Context)
  run_bridge(function ()
    preserves_binary_observation_when_final_snapshot_is_source()
  end)
end

function test_compiler_bridge_normalizes_external_resolution_fingerprints(
    _context: test.Context)
  with_fixture("external-resolution", function ()
    local compiler = bridge.load()
    compiler:configure_paths(
      "/configured/source", "/configured/binary", {})
    local resolutions = compiler:resolve_external_modules({"app"}, {
      bridge.ExternalResolutionRequest.new("vendor.source", true),
      bridge.ExternalResolutionRequest.new("vendor.dynamic", false),
      bridge.ExternalResolutionRequest.new("vendor.static", false),
      bridge.ExternalResolutionRequest.new("vendor.missing", false),
      bridge.ExternalResolutionRequest.new("vendor.broken", false),
    })
    test.assert(#resolutions == 5,
                "external resolver result count changed at the bridge")
    test.assert(resolutions[1].module_name == "vendor.source" and
                resolutions[1].error == nil and
                resolutions[1].provenance ~= nil,
                "external source resolution lost typed identity")
    case resolutions[1].provenance as bridge.Provenance
    when external_source: source then
      test.assert(source.main_file == "/external/vendor/vendor.titan" and
                  #source.source_files == 2 and
                  source.source_files[2] ==
                    "/external/vendor/part.titan",
                  "folder resolution lost a constituent")
    else test.assert(false, "external source used a binary provenance")
    end
    case resolutions[2].provenance as bridge.Provenance
    when dynamic_binary: binary then
      test.assert(binary.provider_file == "/binary/vendor.so",
                  "dynamic provider path was not normalized")
    else test.assert(false, "dynamic provider used the wrong provenance")
    end
    case resolutions[3].provenance as bridge.Provenance
    when static_binary: binary then
      test.assert(binary.provider_file == "/binary/vendor.a",
                  "static provider path was not normalized")
    else test.assert(false, "static provider used the wrong provenance")
    end
    test.assert(resolutions[4].provenance == nil and
                resolutions[4].error == nil and
                resolutions[5].provenance == nil and
                resolutions[5].error == "invalid provider metadata",
                "missing/error resolution escaped the typed contract")
  end)
end

function test_compiler_bridge_normalizes_contextual_owner_provenance(
    _context: test.Context)
  run_bridge(function ()
    local provider = fs.tmpname()
    defer fs.unlink(provider)
    fs.write_file(provider, "fixture static provider")
    with_fixture("contextual-resolution", function ()
      local compiler = bridge.load()
      local analysis = compiler:analyze("fixture", {
        bridge.ProjectModule.new("fixture", {bridge.SourceFile.new(
          "/workspace/fixture.titan", "saved fixture")}),
      })
      test.assert(#analysis.contextual_resolutions == 1,
                  "contextual owner metadata was not normalized")
      local resolution = analysis.contextual_resolutions[1]
      test.assert(resolution.owner_module == "fixture.owner" and
                  resolution.exposer_module == "fixture.facade" and
                  resolution.ordinary_lookup and
                  resolution.provider_identity ~= nil and
                  resolution.provider_identity.path == provider and
                  resolution.provider_identity.kind == "file" and
                  resolution.provider_identity.size ==
                    #"fixture static provider",
                  "contextual owner graph identity was changed")
      case resolution.provenance
      when static_binary: binary then
        test.assert(binary.provider_file == provider,
                    "contextual owner provider path was lost")
      else
        test.assert(false,
                    "contextual owner used the wrong provenance variant")
      end
    end, provider)
  end)
end

function test_compiler_bridge_resets_contextual_provider_observations_between_analyses(
    _context: test.Context)
  run_bridge(function ()
    local provider = fs.tmpname()
    defer fs.unlink(provider)
    fs.write_file(provider, "fixture static provider")
    with_fixture("contextual-resolution-once", function ()
      local compiler = bridge.load()
      local project = bridge.ProjectModule.new(
        "fixture", {bridge.SourceFile.new(
          "/workspace/fixture.titan", "saved fixture")})
      local first = compiler:analyze("fixture", {project})
      local second = compiler:analyze("fixture", {project})
      test.assert(#first.contextual_resolutions == 1 and
                  first.contextual_resolutions[1].provider_identity ~= nil,
                  "first analysis lost its observed provider identity")
      test.assert(#second.contextual_resolutions == 1 and
                  second.contextual_resolutions[1].provider_identity == nil,
                  "second analysis reused a stale provider observation")
    end, provider)
  end)
end

function test_compiler_bridge_normalizes_and_restats_c_header_dependencies(
    _context: test.Context)
  with_fixture("header-metadata", function ()
    local compiler = bridge.load()
    local analysis = compiler:analyze("fixture", {
      bridge.ProjectModule.new("fixture", {bridge.SourceFile.new(
        "/workspace/fixture.titan", "saved fixture")}),
    })
    local module? = analysis:find_module("fixture")
    test.assert(module ~= nil and #module.c_header_dependencies == 2,
                "per-module C header metadata was not normalized")
    local snapshot: bridge.ModuleSnapshot = module
    case snapshot.c_header_dependencies[1].kind
    when file then
    else test.assert(false, "direct C header used search-input kind")
    end
    case snapshot.c_header_dependencies[2].kind
    when search then
    else test.assert(false, "include candidate used file-input kind")
    end
    local current = compiler:restat_c_header_dependencies(
      snapshot.c_header_dependencies)
    test.assert(current[1].path == "/headers/direct.h" and
                current[1].identity == "direct bytes:restatted" and
                current[2].path == "/headers/earlier.h" and
                current[2].identity == "missing candidate:restatted",
                "typed restat changed ownership/order or lost identities")
  end)
end

local function expect_c_header_metadata_error(mode: string,
                                              expected: string)
  with_fixture(mode, function ()
    local compiler = bridge.load()
    local rejected = false
    do
      compiler:analyze("fixture", {
        bridge.ProjectModule.new("fixture", {bridge.SourceFile.new(
          "/workspace/fixture.titan", "saved fixture")}),
      })
    catch
      rejected = true
      test.assert(error is bridge.BridgeError,
                  "malformed C header metadata raised an untyped error")
      local failure = error as bridge.BridgeError
      test.assert(strings.find(failure.message, expected) ~= nil,
                  failure.message)
    end
    test.assert(rejected, "malformed C header metadata was accepted")
  end)
end

function test_compiler_bridge_rejects_malformed_c_header_dependencies(
    _context: test.Context)
  expect_c_header_metadata_error(
    "header-relative-path", "path must be absolute")
  expect_c_header_metadata_error(
    "header-duplicate", "repeats file input")
  expect_c_header_metadata_error(
    "header-unknown-kind", "unknown kind 'directory'")
  expect_c_header_metadata_error(
    "header-empty-identity", "identity must be nonempty")
end

function test_compiler_bridge_normalizes_annotated_ast_and_provenance(
    _context: test.Context)
  with_fixture("valid", function ()
    local compiler = bridge.load()
    test.assert(compiler:installed_binary_modules_root() ==
                  "/opt/titan/lib/titan/0.6",
                "compiler installation library directory was not exposed")
    local analysis = compiler:analyze("fixture", {bridge.ProjectModule.new(
      "fixture", {bridge.SourceFile.new(
        "/workspace/fixture.titan", "saved fixture")})})
    test.assert(#analysis.diagnostics == 0, "valid fixture had diagnostics")
    test.assert(compiler:has_project_ast("fixture"),
                "project annotated AST was not retained behind the bridge")
    test.assert(not compiler:has_project_ast("fixture.external"),
                "external annotated AST leaked into retained project state")

    local project? = analysis:find_module("fixture")
    local external? = analysis:find_module("fixture.external")
    test.assert(project ~= nil and external ~= nil,
                "compiler imported modules were not normalized")
    test.assert(project.manifest ~= nil and
                strings.find(project.manifest.serialized, "fixture") ~= nil and
                project.manifest.source_serialized ==
                  "Source(\"fixture\")",
                "project public/source manifests were not serialized")
    test.assert(#project.imports == 1 and
                project.imports[1].module_name == "fixture.external" and
                project.imports[1].source_required,
                "Titan import metadata was not normalized")
    test.assert(#external.nodes == 0 and #external.symbols == 0,
                "external source AST was exposed as project semantic state")
    test.assert(external.manifest ~= nil and
                external.manifest.source_serialized ==
                  "Source(\"fixture.external\")",
                "external source-visible manifest was not normalized")
    case external.provenance
    when external_source: source then
      test.assert(#source.source_files == 2 and
                  source.source_files[2] == "/external/part.titan",
                  "external folder source provenance lost member paths")
    else
      test.assert(false, "external source used the wrong provenance variant")
    end

    local saw_cast = false
    local saw_computed_field = false
    local saw_computed_key = false
    for index = 1, #project.nodes do
      local node = project.nodes[index]
      if node.tag == "Ast.ExpCast" then
        saw_cast = node.synthetic and node.original_type ~= nil and
          node.original_type.display == "integer" and
          node.coerced_type ~= nil and node.coerced_type.display == "float"
      elseif node.tag == "Ast.Field" then
        saw_computed_field = node.name == nil
      elseif node.tag == "Ast.ExpString" and node.parent_id ~= nil then
        saw_computed_key =
          project.nodes[node.parent_id].tag == "Ast.Field"
      end
    end
    test.assert(saw_cast, "implicit compiler coercion was not normalized")
    test.assert(saw_computed_field and saw_computed_key,
                "computed initializer key was not normalized as an AST child")

    local definition_id: string? = nil
    local reference_id: string? = nil
    local saw_local_import = false
    for index = 1, #project.symbols do
      local symbol = project.symbols[index]
      if symbol.name == "count" then
        case symbol.role
        when definition then definition_id = symbol.declaration_id
        when reference then reference_id = symbol.declaration_id
        else
        end
      elseif symbol.name == "dependency" then
        case symbol.role
        when import_alias then
          saw_local_import = symbol.is_local and symbol.type_info ~= nil and
            symbol.type_info.display == "module fixture.external"
        else
        end
      end
    end
    test.assert(definition_id ~= nil and definition_id == reference_id,
                "local definition and reference identities did not join")
    test.assert(saw_local_import,
                "compiler import alias was not normalized as a local term")
  end)
end

function test_compiler_bridge_normalizes_invalid_source_diagnostic(
    _context: test.Context)
  with_fixture("invalid-source", function ()
    local compiler = bridge.load()
    local analysis = compiler:analyze("fixture", {bridge.ProjectModule.new(
      "fixture", {bridge.SourceFile.new("/workspace/fixture.titan", "bad")})})
    test.assert(#analysis.diagnostics == 1,
                "invalid fixture did not produce one diagnostic")
    local diagnostic = analysis.diagnostics[1]
    case diagnostic.kind
    when syntax then
    else test.assert(false, "syntax diagnostic used the wrong kind")
    end
    test.assert(diagnostic.location ~= nil and
                diagnostic.location.line == 2 and
                diagnostic.location.column == 7,
                "diagnostic location was not normalized")
  end)
end

local function preload_real_compiler()
  local preload = lua.load([==[
return function()
  require("titan-compiler.parser")
  require("titan-compiler.checker")
  require("titan-compiler.types")
  require("titan-compiler.driver")
end
]==], "=compiler_bridge_real_compiler", nil)() as EmptyFunction
  preload()
end

local function executes_installed_compiler_on_valid_and_invalid_source()
  preload_real_compiler()
  local compiler = bridge.load()
  local valid = compiler:analyze("bridge.fixture.valid", {
    bridge.ProjectModule.new("bridge.fixture.valid", {bridge.SourceFile.new(
      "/workspace/bridge_fixture_valid.titan",
      "function widen(n: integer): float\n" ..
      "  local result: float = n\n" ..
      "  return result\n" ..
      "end\n")})
  })
  test.assert(#valid.diagnostics == 0,
              "installed compiler rejected representative valid source")
  local module? = valid:find_module("bridge.fixture.valid")
  test.assert(module ~= nil and module.manifest ~= nil and #module.nodes > 0,
              "installed compiler result was not normalized")

  local invalid = compiler:analyze("bridge.fixture.invalid", {
    bridge.ProjectModule.new("bridge.fixture.invalid", {bridge.SourceFile.new(
      "/workspace/bridge_fixture_invalid.titan",
      "function broken(: integer)\nend\n")})
  })
  test.assert(#invalid.diagnostics > 0 and
              invalid.diagnostics[1].location ~= nil,
              "installed compiler syntax failure was not normalized")
catch
  if error is bridge.BridgeError then
    local failure = error as bridge.BridgeError
    raise failure.module_name .. ": " .. failure.message
  end
  raise
end

function test_compiler_bridge_executes_installed_compiler_on_valid_and_invalid_source(
    _context: test.Context)
  test_runtime.run(executes_installed_compiler_on_valid_and_invalid_source)
end

local function runs_incremental_full_ast_cache()
  preload_real_compiler()
  local compiler = bridge.load()
  local provider = bridge.ProjectModule.new("bridge_cache_provider", {
    bridge.SourceFile.new(
      "/workspace/bridge_cache_provider.titan",
      "local function secret(): integer return 41 end\n")
  })
  local consumer = bridge.ProjectModule.new("bridge_cache_consumer", {
    bridge.SourceFile.new(
      "/workspace/bridge_cache_consumer.titan",
      "local provider = import \"bridge_cache_provider.titan\"\n" ..
      "function answer(): integer return provider.secret() end\n")
  })

  local initial = compiler:analyze(
    "bridge_cache_consumer", {provider, consumer})
  test.assert(#initial.diagnostics == 0 and
              initial:find_module("bridge_cache_provider") ~= nil and
              initial:find_module("bridge_cache_consumer") ~= nil,
              "initial source-required project closure did not compile")

  local edited_consumer = bridge.ProjectModule.new(
    "bridge_cache_consumer", {bridge.SourceFile.new(
      "/workspace/bridge_cache_consumer.titan",
      "local provider = import \"bridge_cache_provider.titan\"\n" ..
      "function answer(): integer return provider.secret() + 1 end\n")})
  local incremental = compiler:analyze_incremental(
    {provider, edited_consumer}, {"bridge_cache_consumer"}, {})
  test.assert(#incremental.diagnostics == 0,
              "dirty consumer failed against retained full project AST")
  test.assert(incremental:find_module("bridge_cache_consumer") ~= nil and
              incremental:find_module("bridge_cache_provider") == nil,
              "unchanged source-required provider was reparsed or rechecked")
  test.assert(compiler:has_project_ast("bridge_cache_provider"),
              "clean project AST disappeared from the private bridge cache")
end

function test_compiler_bridge_reuses_unchanged_full_ast_incrementally(
    _context: test.Context)
  test_runtime.run(runs_incremental_full_ast_cache)
end

local function reports_dirty_saved_file_progress()
  with_fixture("progress", function ()
    local compiler = bridge.load()
    local first = bridge.ProjectModule.new("fixture.first", {
      bridge.SourceFile.new("/workspace/first.titan", ""),
      bridge.SourceFile.new("/workspace/first_part.titan", ""),
    })
    local second = bridge.ProjectModule.new("fixture.second", {
      bridge.SourceFile.new("/workspace/second.titan", ""),
    })
    local observed: {bridge.AnalysisProgress} = {}
    local analysis = compiler:analyze_incremental(
      {first, second},
      {"fixture.first", "fixture.first", "fixture.second"}, {},
      function (progress: bridge.AnalysisProgress)
        observed[#observed + 1] = progress
      end)

    test.assert(#analysis.diagnostics == 0,
                "progress fixture compiler analysis failed")
    test.assert(#observed == 3 and
                observed[1].completed_files == 0 and
                observed[1].total_files == 3 and
                observed[2].completed_files == 2 and
                observed[2].total_files == 3 and
                observed[3].completed_files == 3 and
                observed[3].total_files == 3,
                "dirty progress did not count saved files exactly once")
  end)
end

function test_compiler_bridge_reports_exact_dirty_saved_file_progress(
    _context: test.Context)
  test_runtime.run(reports_dirty_saved_file_progress)
end

local function completes_progress_for_failed_root_without_yield()
  with_fixture("invalid-source", function ()
    local compiler = bridge.load()
    local observed: {bridge.AnalysisProgress} = {}
    local analysis = compiler:analyze_incremental({
      bridge.ProjectModule.new("fixture.failed", {
        bridge.SourceFile.new("/workspace/failed.titan", ""),
        bridge.SourceFile.new("/workspace/failed_part.titan", ""),
      }),
    }, {"fixture.failed"}, {}, function (progress: bridge.AnalysisProgress)
      observed[#observed + 1] = progress
    end)
    test.assert(#analysis.diagnostics == 1,
                "failed progress fixture lost its compiler diagnostic")
    test.assert(#observed == 2 and
                observed[1].completed_files == 0 and
                observed[1].total_files == 2 and
                observed[2].completed_files == 2 and
                observed[2].total_files == 2,
                "failed root vanished before saved-file progress completed")
  end)
end

function test_compiler_bridge_completes_progress_for_nonyielding_failed_root(
    _context: test.Context)
  test_runtime.run(completes_progress_for_failed_root_without_yield)
end

local function reparses_source_required_external_for_cached_project()
  preload_real_compiler()
  local external_root = fs.tmpname()
  fs.unlink(external_root)
  fs.mkdir(external_root)
  local external_file =
    external_root .. "/bridge_cached_external.titan"
  fs.write_file(external_file,
    "local function secret(): integer return 41 end\n")
  defer do
    fs.unlink(external_file)
    fs.rmdir(external_root)
  end

  local compiler = bridge.load()
  compiler:configure_paths(external_root, nil, nil)
  local provider = bridge.ProjectModule.new("bridge_cached_provider", {
    bridge.SourceFile.new(
      "/workspace/bridge_cached_provider.titan",
      "local external = import \"bridge_cached_external.titan\"\n" ..
      "function answer(): integer return external.secret() end\n")
  })
  local initial = compiler:analyze("bridge_cached_provider", {provider})
  test.assert(#initial.diagnostics == 0,
              "initial source-required external closure did not compile")
  local external? = initial:find_module("bridge_cached_external")
  test.assert(external ~= nil and external.manifest ~= nil,
              "initial external source manifest was not normalized")
  local external_module: bridge.ModuleSnapshot = external
  local external_manifest: bridge.Manifest = external_module.manifest
  test.assert(external_manifest.source_serialized ~= nil,
              "external cache seed lost its source-visible manifest")
  local cached_external = bridge.CachedSourceInterface.new(
    "bridge_cached_external", external_manifest.serialized,
    external_manifest.source_serialized,
    external_file, {external_file}, external_module.imports,
    external_module.c_header_dependencies)

  local consumer = bridge.ProjectModule.new("bridge_cached_consumer", {
    bridge.SourceFile.new(
      "/workspace/bridge_cached_consumer.titan",
      "local provider = import \"bridge_cached_provider.titan\"\n" ..
      "function result(): integer return provider.answer() + 1 end\n")
  })
  local incremental = compiler:analyze_incremental(
    {provider, consumer}, {"bridge_cached_consumer"}, {cached_external})
  test.assert(#incremental.diagnostics == 0,
              "cached project failed with source-required external cache")
  test.assert(incremental:find_module("bridge_cached_provider") == nil,
              "clean project provider was unexpectedly rechecked")
  local refreshed_external? =
    incremental:find_module("bridge_cached_external")
  test.assert(refreshed_external ~= nil and
              #refreshed_external.nodes == 0 and
              #refreshed_external.symbols == 0 and
              refreshed_external.manifest ~= nil and
              refreshed_external.manifest.source_serialized ==
                external_manifest.source_serialized,
              "external source was not transiently reparsed and discarded")
  test.assert(not compiler:has_project_ast("bridge_cached_external"),
              "external annotated AST leaked into the project cache")
end

function test_compiler_bridge_rechecks_source_required_external_dependencies_of_cached_projects(
    _context: test.Context)
  test_runtime.run(reparses_source_required_external_for_cached_project)
end

local function uses_analysis_local_ffi_include_dirs()
  preload_real_compiler()
  local include_root = fs.tmpname()
  fs.unlink(include_root)
  fs.mkdir(include_root)
  local header = include_root .. "/vscode_titan_lsp_project_only.h"
  fs.write_file(header, "typedef int vscode_titan_lsp_project_only_int;\n")
  defer do
    fs.unlink(header)
    fs.rmdir(include_root)
  end

  local module = bridge.ProjectModule.new("bridge_ffi_include", {
    bridge.SourceFile.new(
      "/workspace/bridge_ffi_include.titan",
      "local c = foreign import \"vscode_titan_lsp_project_only.h\"\n" ..
      "function answer(): integer return 42 end\n")
  })
  local missing = bridge.load()
  local rejected = missing:analyze("bridge_ffi_include", {module})
  test.assert(#rejected.diagnostics > 0,
              "project-only FFI header unexpectedly resolved globally")

  local configured = bridge.load()
  configured:configure_paths(nil, nil, {include_root})
  local accepted = configured:analyze("bridge_ffi_include", {module})
  local messages = strings.writer()
  for index = 1, #accepted.diagnostics do
    messages:write(accepted.diagnostics[index].message .. "\n")
  end
  test.assert(#accepted.diagnostics == 0 and
              accepted:find_module("bridge_ffi_include") ~= nil,
              "analysis-local FFI include directory did not reach compiler: " ..
              messages:drain())
  local accepted_module: bridge.ModuleSnapshot =
    accepted:find_module("bridge_ffi_include")
  local observed?: bridge.CHeaderDependency = nil
  for index = 1, #accepted_module.c_header_dependencies do
    local dependency = accepted_module.c_header_dependencies[index]
    case dependency.kind
    when file then
      if dependency.path == header then observed = dependency end
    else
    end
  end
  test.assert(observed ~= nil,
              "compiler bridge lost the resolved project FFI header")
  fs.write_file(header,
    "typedef long vscode_titan_lsp_project_only_int;\n")
  local restatted = configured:restat_c_header_dependencies(
    accepted_module.c_header_dependencies)
  local changed = false
  for index = 1, #restatted do
    if restatted[index].path == header and
       restatted[index].identity ~=
         (observed as bridge.CHeaderDependency).identity then
      changed = true
    end
  end
  test.assert(changed,
              "compiler bridge reused a changed header content identity")
end

function test_compiler_bridge_uses_analysis_local_ffi_include_directories(
    _context: test.Context)
  test_runtime.run(uses_analysis_local_ffi_include_dirs)
end

local function assert_joined_symbol(module: bridge.ModuleSnapshot,
                                    name: string, minimum: integer)
  local identity?: string = nil
  local count = 0
  for index = 1, #module.symbols do
    local symbol = module.symbols[index]
    if symbol.name == name and symbol.declaration_id ~= nil then
      count = count + 1
      test.assert(symbol.exact_span ~= nil,
                  "compiler-backed symbol '" .. name .. "' lost exact span")
      if identity == nil then identity = symbol.declaration_id end
      test.assert(symbol.declaration_id == identity,
                  "compiler-backed symbol '" .. name .. "' did not join")
    end
  end
  test.assert(count >= minimum,
              "compiler-backed symbol '" .. name .. "' was under-indexed")
end

local function normalizes_generic_nominal_member_metadata()
  preload_real_compiler()
  local compiler = bridge.load()
  local source = [[record Box<T>
  item: T
end
union Maybe
  Some: Box<integer>
  None
end
function Box:get(): T return self.item end
function inspect<T>(box: Box<T>, maybe: Maybe): T
  local field = box.item
  local bound = box:get
  local got = box:get()
  local made: Box<T> = { item = field }
  case maybe
  when Some: some then
  else
  end
  return field
end
]]
  local analysis = compiler:analyze("bridge_metadata", {
    bridge.ProjectModule.new("bridge_metadata", {bridge.SourceFile.new(
      "/workspace/bridge_metadata.titan", source)})
  })
  test.assert(#analysis.diagnostics == 0,
              "representative semantic metadata fixture did not compile")
  local module? = analysis:find_module("bridge_metadata")
  test.assert(module ~= nil, "semantic metadata module was not normalized")
  assert_joined_symbol(module, "Box", 5)
  assert_joined_symbol(module, "item", 4)
  assert_joined_symbol(module, "get", 3)
  assert_joined_symbol(module, "Maybe", 2)
  assert_joined_symbol(module, "Some", 2)

  local record_parameter?: string = nil
  local function_parameter?: string = nil
  local record_count = 0
  local function_count = 0
  for index = 1, #module.symbols do
    local symbol = module.symbols[index]
    if symbol.name == "T" and symbol.declaration_id ~= nil then
      if symbol.location.line <= 8 then
        record_count = record_count + 1
        if record_parameter == nil then
          record_parameter = symbol.declaration_id
        end
        test.assert(symbol.declaration_id == record_parameter,
                    "record type parameter references did not join")
      else
        function_count = function_count + 1
        if function_parameter == nil then
          function_parameter = symbol.declaration_id
        end
        test.assert(symbol.declaration_id == function_parameter,
                    "function type parameter references did not join")
      end
    end
  end
  test.assert(record_count >= 3 and function_count >= 3 and
              record_parameter ~= function_parameter,
              "generic type parameters lost lexical declaration identity")
end

function test_compiler_bridge_normalizes_generic_nominal_and_member_metadata(
    _context: test.Context)
  run_bridge(normalizes_generic_nominal_member_metadata)
end

local function excludes_lowered_generic_case_payloads_from_exact_spans()
  preload_real_compiler()
  local filename = "/workspace/generic_case_payload.titan"
  local source = [[union Maybe<T>
  present: T
  absent
end
function make<T>(item: T): Maybe<T>
  return Maybe<T>.present(item)
end
function number(): integer
  local candidate = make(42)
  case candidate
  when present: item then
    return item
  else
    return 0
  end
end
]]
  local projects = {bridge.ProjectModule.new("generic_case_payload", {
    bridge.SourceFile.new(filename, source),
  })}
  local analysis = bridge.load():analyze("generic_case_payload", projects)
  test.assert(#analysis.diagnostics == 0,
              "generic case payload fixture did not compile")
  local module? = analysis:find_module("generic_case_payload")
  test.assert(module ~= nil, "generic case payload module was not normalized")
  local saw_lowered_payload = false
  local source_item_spans = 0
  for index = 1, #module.symbols do
    local symbol = module.symbols[index]
    if strings.find(symbol.name, "__generic_case_payload_", 1) == 1 then
      saw_lowered_payload = true
      test.assert(symbol.exact_span == nil,
                  "lowered generic case payload gained a source span")
    elseif symbol.name == "item" and symbol.exact_span ~= nil then
      source_item_spans = source_item_spans + 1
    end
  end
  test.assert(saw_lowered_payload,
              "fixture did not exercise generic case payload lowering")
  test.assert(source_item_spans >= 4,
              "source-written generic bindings lost their exact spans")
  features.build(projects, analysis.modules)
end

function test_compiler_bridge_excludes_lowered_generic_case_payloads_from_exact_spans(
    _context: test.Context)
  run_bridge(excludes_lowered_generic_case_payloads_from_exact_spans)
end

local function drives_shadowing_and_record_definition_features_from_compiler()
  preload_real_compiler()
  local filename = "/workspace/semantic_acceptance.titan"
  local source = [[record Parcel
  amount: integer
end
function inspect(parcel: Parcel): integer
  local count = parcel.amount
  local observed = count
  do
    local count = parcel.amount + 1
    local nested = count
  end
  return count + observed
end
]]
  local projects = {bridge.ProjectModule.new("semantic_acceptance", {
    bridge.SourceFile.new(filename, source),
  })}
  local compiler = bridge.load()
  local analysis = compiler:analyze("semantic_acceptance", projects)
  test.assert(#analysis.diagnostics == 0,
              "compiler rejected source-grounded semantic acceptance fixture")
  local model = features.build(projects, analysis.modules)

  local outer_definition? = model:definition(
    filename, source_text.Position.new(5, 20))
  local inner_definition? = model:definition(
    filename, source_text.Position.new(8, 20))
  test.assert(outer_definition ~= nil and
              outer_definition.range.start.line == 4 and
              outer_definition.range.start.character == 8 and
              outer_definition.range.finish.character == 13 and
              inner_definition ~= nil and
              inner_definition.range.start.line == 7 and
              inner_definition.range.start.character == 10 and
              inner_definition.range.finish.character == 15,
              "compiler-backed shadowed locals resolved to the wrong declaration")

  local outer_references = model:references(
    filename, source_text.Position.new(5, 20), false)
  local inner_references = model:references(
    filename, source_text.Position.new(8, 20), false)
  test.assert(#outer_references == 2 and
              outer_references[1].range.start.line == 5 and
              outer_references[2].range.start.line == 10 and
              #inner_references == 1 and
              inner_references[1].range.start.line == 8,
              "references merged compiler-distinct shadowed locals")

  local field_definition? = model:definition(
    filename, source_text.Position.new(4, 24))
  local field_references = model:references(
    filename, source_text.Position.new(4, 24), false)
  test.assert(field_definition ~= nil and
              field_definition.range.start.line == 1 and
              field_definition.range.start.character == 2 and
              field_definition.range.finish.character == 8 and
              #field_references == 2 and
              field_references[1].range.start.line == 4 and
              field_references[2].range.start.line == 7,
              "record member use did not resolve to its source declaration")

  local candidate?, candidate_error? = model:rename(
    filename, source_text.Position.new(5, 20), "total")
  test.assert(candidate_error == nil and candidate ~= nil,
              "outer shadowed local did not produce a rename candidate")
  local edited = candidate:edited_project_modules()
  local expected = [[record Parcel
  amount: integer
end
function inspect(parcel: Parcel): integer
  local total = parcel.amount
  local observed = total
  do
    local count = parcel.amount + 1
    local nested = count
  end
  return total + observed
end
]]
  test.assert(#edited == 1 and #edited[1].files == 1 and
              edited[1].files[1].contents == expected,
              "rename crossed the compiler's shadowing boundary")
  local checked = bridge.load():analyze("semantic_acceptance", edited)
  local verified?, verification_error? = candidate:preflight(checked)
  test.assert(#checked.diagnostics == 0 and verification_error == nil and
              verified ~= nil and
              #verified:document_edits() == 1 and
              #verified:document_edits()[1].edits == 3,
              "shadow-preserving rename failed compiler preflight")
end

function test_compiler_bridge_drives_shadowing_and_record_definition_features_from_compiler(
    _context: test.Context)
  test_runtime.run(drives_shadowing_and_record_definition_features_from_compiler)
end

local function excludes_foreign_and_external_declarations_from_features()
  preload_real_compiler()
  local external_root = fs.tmpname()
  fs.unlink(external_root)
  fs.mkdir(external_root)
  local external_file =
    external_root .. "/semantic_acceptance_external.titan"
  fs.write_file(external_file,
    "function external_value(): integer return 17 end\n")
  defer do
    fs.unlink(external_file)
    fs.rmdir(external_root)
  end

  local filename = "/workspace/semantic_boundaries.titan"
  local source = [[local c = foreign import "string.h"
local external = import "semantic_acceptance_external"
function ffi_use(): integer
  return c.strlen("Titan")
end
function external_use(): integer
  return external.external_value()
end
]]
  local projects = {bridge.ProjectModule.new("semantic_boundaries", {
    bridge.SourceFile.new(filename, source),
  })}
  local compiler = bridge.load()
  compiler:configure_paths(external_root, nil, nil)
  local analysis = compiler:analyze("semantic_boundaries", projects)
  local diagnostic_messages = strings.writer()
  for index = 1, #analysis.diagnostics do
    diagnostic_messages:write(analysis.diagnostics[index].message .. "\n")
  end
  test.assert(#analysis.diagnostics == 0,
              "compiler rejected foreign/external semantic fixture: " ..
              diagnostic_messages:drain())
  local external? = analysis:find_module("semantic_acceptance_external")
  test.assert(external ~= nil and #external.nodes == 0 and
              #external.symbols == 0,
              "external source AST escaped the compiler boundary")
  local model = features.build(projects, analysis.modules)

  local foreign_definition? = model:definition(
    filename, source_text.Position.new(3, 12))
  local foreign_references = model:references(
    filename, source_text.Position.new(3, 12), true)
  local foreign_rename?, foreign_rename_error? = model:rename(
    filename, source_text.Position.new(3, 12), "renamed_native")
  test.assert(foreign_definition == nil and
              #foreign_references == 1 and
              foreign_references[1].range.start.line == 3 and
              foreign_references[1].range.start.character == 11 and
              foreign_references[1].range.finish.character == 17 and
              foreign_rename == nil and foreign_rename_error ~= nil and
              strings.find(foreign_rename_error.message,
                           "outside project") ~= nil,
              "C FFI header declaration entered project results or allowed rename")

  local external_definition? = model:definition(
    filename, source_text.Position.new(6, 19))
  local external_references = model:references(
    filename, source_text.Position.new(6, 19), true)
  local external_rename?, external_rename_error? = model:rename(
    filename, source_text.Position.new(6, 19), "renamed_external")
  test.assert(external_definition == nil and
              #external_references == 1 and
              external_references[1].range.start.line == 6 and
              external_references[1].range.start.character == 18 and
              external_references[1].range.finish.character == 32 and
              external_rename == nil and external_rename_error ~= nil and
              strings.find(external_rename_error.message,
                           "outside project") ~= nil,
              "external declaration escaped project-only semantic features")
end

function test_compiler_bridge_excludes_foreign_and_external_declarations_from_features(
    _context: test.Context)
  test_runtime.run(excludes_foreign_and_external_declarations_from_features)
end

local function preserves_imported_callable_hover_signatures()
  preload_real_compiler()
  local external_root = fs.tmpname()
  fs.unlink(external_root)
  fs.mkdir(external_root)
  local external_file = external_root .. "/hover_external.titan"
  fs.write_file(external_file, [[local ffi = foreign import "titan/ffi.h"
record Counter
  amount: integer
end
function Counter:add(delta: integer): integer
  return self.amount + delta
end
function Counter.create(initial: integer): Counter
  return Counter.new(initial)
end
function choose(first: integer, second: integer): integer
  return first + second
end
foreign function native_add(left: ffi.titan_ffi_int,
                            right: ffi.titan_ffi_int): ffi.titan_ffi_int
  return left + right
end
]])
  defer do
    fs.unlink(external_file)
    fs.rmdir(external_root)
  end

  local filename = "/workspace/hover_consumer.titan"
  local source = [[local external = import "hover_external.titan"
function run(): integer
  local counter = external.Counter.create(1)
  local selected = external.choose(1, 2)
  local advanced = counter:add(3)
  local native: integer = external.native_add(4, 5)
  return selected + advanced + native
end
]]
  local projects = {bridge.ProjectModule.new("hover_consumer", {
    bridge.SourceFile.new(filename, source),
  })}
  local compiler = bridge.load()
  compiler:configure_paths(external_root, nil, nil)
  local analysis = compiler:analyze("hover_consumer", projects)
  local diagnostic_messages = strings.writer()
  for index = 1, #analysis.diagnostics do
    diagnostic_messages:write(analysis.diagnostics[index].message .. "\n")
  end
  test.assert(#analysis.diagnostics == 0,
              "compiler rejected callable-hover fixture: " ..
              diagnostic_messages:drain())
  local external? = analysis:find_module("hover_external")
  test.assert(external ~= nil and #external.nodes == 0 and
              #external.symbols == 0,
              "external callable AST escaped the compiler boundary")

  local model = features.build(projects, analysis.modules)
  local top_level? = model:hover(
    filename, source_text.Position.new(1, 10))
  test.assert(top_level ~= nil and top_level:markdown() ==
                "- Signature: `hover_consumer.run(): integer`\n" ..
                "- Visibility: exported\n",
              "top-level function declaration hover lost its signature")

  local associated? = model:hover(
    filename, source_text.Position.new(2, 37))
  test.assert(associated ~= nil and associated:markdown() ==
                "- Signature: `hover_external.Counter.create(" ..
                "initial: integer): hover_external.Counter`\n" ..
                "- Visibility: exported\n",
              "imported record-function hover lost its named signature")

  local ordinary? = model:hover(
    filename, source_text.Position.new(3, 30))
  test.assert(ordinary ~= nil and ordinary:markdown() ==
                "- Signature: `hover_external.choose(" ..
                "first: integer, second: integer): integer`\n" ..
                "- Visibility: exported\n",
              "imported function hover lost its named signature")

  local method? = model:hover(
    filename, source_text.Position.new(4, 28))
  test.assert(method ~= nil and method:markdown() ==
                "- Signature: `hover_external.Counter:add(" ..
                "delta: integer): integer`\n" ..
                "- Visibility: exported\n",
              "method-call name hover lost its resolved method signature")

  local foreign_hover? = model:hover(
    filename, source_text.Position.new(5, 37))
  test.assert(foreign_hover ~= nil and
              foreign_hover.callable_signature ~= nil and
              foreign_hover.callable_signature.display ==
                "hover_external.native_add(left: titan_ffi_int, " ..
                "right: titan_ffi_int): titan_ffi_int",
              "source-imported foreign function lost its exact signature")
end

function test_compiler_bridge_preserves_imported_callable_hover_signatures(
    _context: test.Context)
  test_runtime.run(preserves_imported_callable_hover_signatures)
end

local function preserves_generic_callable_hover_signatures()
  preload_real_compiler()
  local filename = "/workspace/generic_callable_hover.titan"
  local source = [[record Box<T>
  item: T
end
function Box:get(): T
  return self.item
end
function identity<T>(item: T): T
  return item
end
function use(box: Box<integer>): integer
  return box:get()
end
]]
  local project = bridge.ProjectModule.new("generic_callable_hover", {
    bridge.SourceFile.new(filename, source),
  })
  local analysis = bridge.load():analyze(
    "generic_callable_hover", {project})
  local diagnostic_messages = strings.writer()
  for index = 1, #analysis.diagnostics do
    diagnostic_messages:write(analysis.diagnostics[index].message .. "\n")
  end
  test.assert(#analysis.diagnostics == 0,
              "compiler rejected generic callable-hover fixture: " ..
              diagnostic_messages:drain())
  local model = features.build({project}, analysis.modules)

  local owner? = model:hover(
    filename, source_text.Position.new(0, 8))
  local receiver? = model:hover(
    filename, source_text.Position.new(4, 10))
  local owner_summary: string? = nil
  local receiver_summary: string? = nil
  if owner ~= nil then owner_summary = owner.summary_markdown end
  if receiver ~= nil then receiver_summary = receiver.summary_markdown end
  test.assert(owner_summary ~= nil and receiver_summary == owner_summary,
              "implicit self did not reuse its aggregate hover summary")
  test.assert(receiver ~= nil and receiver_summary ~= nil and
              receiver:markdown() == receiver_summary ..
                "\n- Visibility: block\n",
              "implicit self hover lost its members or block visibility")

  local declaration? = model:hover(
    filename, source_text.Position.new(6, 10))
  test.assert(declaration ~= nil and declaration:markdown() ==
                "- Signature: `generic_callable_hover.identity<T>(" ..
                  "item: T): T`\n" ..
                "- Visibility: exported\n",
              "generic function declaration hover lost its surface signature")

  local method_declaration? = model:hover(
    filename, source_text.Position.new(3, 14))
  test.assert(method_declaration ~= nil and
              method_declaration:markdown() ==
                "- Signature: `generic_callable_hover.Box:get(): T`\n" ..
                "- Visibility: exported\n",
              "generic owner method declaration hover was erased")

  local method_call? = model:hover(
    filename, source_text.Position.new(10, 14))
  test.assert(method_call ~= nil and method_call:markdown() ==
                "- Signature: `generic_callable_hover.Box:get(): integer`\n" ..
                "- Visibility: exported\n",
              "generic method-call name hover lost its applied signature")
end

function test_compiler_bridge_preserves_generic_callable_hover_signatures(
    _context: test.Context)
  run_bridge(preserves_generic_callable_hover_signatures)
end

local function preserves_contextual_aggregate_and_module_hover_summaries()
  preload_real_compiler()
  local provider_filename = "/workspace/summary_provider.titan"
  local provider_source = [[local const secret: integer = 7
answer = 42
record Box<T>
  item: T
end
type BoxAlias = Box
local type Hidden = integer
local type HiddenBox = Box
local function Box:hidden(): T return self.item end
function Box:get(): T return self.item end
function exposed(): integer return answer end
]]
  local consumer_filename = "/workspace/summary_consumer.titan"
  local consumer_source = [[local public = import "summary_provider"
local source = import "summary_provider.titan"
function compare(left: public.Box<integer>, right: source.Box<integer>): public.Box<integer>
  return left
end
]]
  local projects = {
    bridge.ProjectModule.new("summary_provider", {
      bridge.SourceFile.new(provider_filename, provider_source),
    }),
    bridge.ProjectModule.new("summary_consumer", {
      bridge.SourceFile.new(consumer_filename, consumer_source),
    }),
  }
  local compiler = bridge.load()
  local analysis = compiler:analyze("summary_consumer", projects)
  local diagnostic_messages = strings.writer()
  for index = 1, #analysis.diagnostics do
    diagnostic_messages:write(analysis.diagnostics[index].message .. "\n")
  end
  test.assert(#analysis.diagnostics == 0,
              "compiler rejected contextual hover-summary fixture: " ..
              diagnostic_messages:drain())
  local consumer_snapshot? = analysis:find_module("summary_consumer")
  test.assert(consumer_snapshot ~= nil and
              consumer_snapshot.hover_summaries ~= nil and
              #consumer_snapshot.hover_summaries == 4,
              "contextual hover views were not snapshot-interned")
  local public_box: integer? = nil
  local source_box: integer? = nil
  local repeated_box: integer? = nil
  local public_module: integer? = nil
  local source_module: integer? = nil
  local repeated_public_module: integer? = nil
  local repeated_source_module: integer? = nil
  for index = 1, #consumer_snapshot.symbols do
    local symbol = consumer_snapshot.symbols[index]
    if symbol.location.filename == consumer_filename then
      if symbol.name == "Box" and symbol.location.line == 3 then
        if symbol.location.column == 31 then public_box = symbol.summary_id
        elseif symbol.location.column == 59 then source_box = symbol.summary_id
        elseif symbol.location.column == 81 then
          repeated_box = symbol.summary_id
        end
      elseif symbol.name == "public" then
        if symbol.location.line == 1 and symbol.location.column == 7 then
          public_module = symbol.summary_id
        elseif symbol.location.line == 3 and symbol.location.column == 24 then
          repeated_public_module = symbol.summary_id
        end
      elseif symbol.name == "source" then
        if symbol.location.line == 2 and symbol.location.column == 7 then
          source_module = symbol.summary_id
        elseif symbol.location.line == 3 and symbol.location.column == 52 then
          repeated_source_module = symbol.summary_id
        end
      end
    end
  end
  test.assert(public_box ~= nil and public_box == repeated_box and
              source_box ~= nil and source_box ~= public_box and
              public_module ~= nil and
              public_module == repeated_public_module and
              source_module ~= nil and
              source_module == repeated_source_module and
              source_module ~= public_module,
              "repeated or contextual occurrences used the wrong summary id")
  local model = features.build(projects, analysis.modules)

  local defining? = model:hover(
    provider_filename, source_text.Position.new(2, 8))
  local defining_markdown = defining ~= nil and defining:markdown() or "<nil>"
  test.assert(defining ~= nil and defining:markdown() ==
                "**record** `summary_provider.Box<T>`\n\n" ..
                "Fields\n\n" ..
                "- `item: T`\n\n" ..
                "Functions\n\n" ..
                "- `summary_provider.Box<T>.new(" ..
                  "item: T): summary_provider.Box<T>`\n\n" ..
                "Methods\n\n" ..
                "- `summary_provider.Box<T>:get(): T`\n" ..
                "- `local summary_provider.Box<T>:hidden(): T`\n\n" ..
                "- Visibility: exported\n",
              "defining aggregate hover lost its full generic view:\n" ..
              defining_markdown)

  local ordinary? = model:hover(
    consumer_filename, source_text.Position.new(2, 31))
  local ordinary_markdown = ordinary ~= nil and ordinary:markdown() or "<nil>"
  local expected_public =
    "**record** `summary_provider.Box<integer>`\n\n" ..
    "Fields\n\n" ..
    "- `item: integer`\n\n" ..
    "Functions\n\n" ..
    "- `summary_provider.Box<integer>.new(" ..
      "item: integer): summary_provider.Box<integer>`\n\n" ..
    "Methods\n\n" ..
    "- `summary_provider.Box<integer>:get(): integer`\n\n" ..
    "- Visibility: exported\n"
  test.assert(ordinary ~= nil and ordinary:markdown() == expected_public,
              "ordinary import exposed local or unspecialized members:\n" ..
              ordinary_markdown)

  local source? = model:hover(
    consumer_filename, source_text.Position.new(2, 59))
  local source_markdown = source ~= nil and source:markdown() or "<nil>"
  test.assert(source ~= nil and source:markdown() ==
                "**record** `summary_provider.Box<integer>`\n\n" ..
                "Fields\n\n" ..
                "- `item: integer`\n\n" ..
                "Functions\n\n" ..
                "- `summary_provider.Box<integer>.new(" ..
                  "item: integer): summary_provider.Box<integer>`\n\n" ..
                "Methods\n\n" ..
                "- `summary_provider.Box<integer>:get(): integer`\n" ..
                "- `local summary_provider.Box<integer>:hidden(): integer`\n\n" ..
                "- Visibility: exported\n",
              "direct-source import lost its local specialized members:\n" ..
              source_markdown)

  local public_module? = model:hover(
    consumer_filename, source_text.Position.new(0, 7))
  local public_module_markdown = public_module ~= nil and
    public_module:markdown() or "<nil>"
  local expected_public_module =
    "**module** `summary_provider`\n\n" ..
    "Members\n\n" ..
    "- `record Box<T>`\n" ..
    "- `answer: integer`\n" ..
    "- `summary_provider.exposed(): integer`\n" ..
    "- `type BoxAlias<T> = summary_provider.Box<T>`\n\n" ..
    "- Visibility: module\n"
  test.assert(public_module ~= nil and
              public_module:markdown() == expected_public_module and
              strings.find(public_module:markdown(), "Fields") == nil and
              strings.find(public_module:markdown(), ".new") == nil,
              "module hover recursively expanded or reordered members:\n" ..
              public_module_markdown)

  local source_module? = model:hover(
    consumer_filename, source_text.Position.new(1, 7))
  local source_module_markdown = source_module ~= nil and
    source_module:markdown() or "<nil>"
  test.assert(source_module ~= nil and source_module:markdown() ==
                "**module** `summary_provider`\n\n" ..
                "Members\n\n" ..
                "- `record Box<T>`\n" ..
                "- `answer: integer`\n" ..
                "- `summary_provider.exposed(): integer`\n" ..
                "- `local const secret: integer`\n" ..
                "- `type BoxAlias<T> = summary_provider.Box<T>`\n" ..
                "- `local type Hidden = integer`\n" ..
                "- `local type HiddenBox<T> = summary_provider.Box<T>`\n\n" ..
                "- Visibility: module\n",
              "direct-source module hover lost its source-only members:\n" ..
              source_module_markdown)

  local repeated? = model:hover(
    consumer_filename, source_text.Position.new(2, 81))
  test.assert(repeated ~= nil and repeated:markdown() == expected_public,
              "repeated generic view did not reuse normalized summary text")
end

function test_compiler_bridge_preserves_contextual_aggregate_and_module_hover_summaries(
    _context: test.Context)
  run_bridge(
    preserves_contextual_aggregate_and_module_hover_summaries)
end

local function keeps_source_visibility_nontransitive_through_aliases()
  preload_real_compiler()
  local provider_filename =
    "/workspace/summary_visibility_provider.titan"
  local provider_source = [[record Box
