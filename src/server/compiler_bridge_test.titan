function test_compiler_bridge_native_windows_extended_header_paths(_context: test.Context)
  if ffi.VSCODE_TITAN_WINDOWS == 0 then test.skip("native Windows metadata") end
  local paths: {string} = {
    "\\\\?\\c:\\literal\\..\\api.h",
    "\\\\?\\uNc\\sérver\\share name\\api.h",
    "\\\\?\\vOlUmE{01234567-89ab-CDEF-0123-456789abcdef}\\api.h",
  }
  local entries: {integer: value} = {}
  for index = 1, #paths do
    local path = paths[index]
    local item: {string: value} = {
      ["kind"] = "file", ["path"] = path, ["identity"] = "exact identity " .. index,
    }
    entries[index] = item
  end
  local decoded = bridge.normalize_c_header_dependencies(entries, "test headers")
  test.assert(#decoded == #paths, "extended compiler metadata inputs were lost")
  for index = 1, #paths do
    local path = paths[index]
    test.assert(decoded[index].path == path and
      decoded[index].identity == "exact identity " .. index,
      "extended compiler path or physical identity bytes changed")
  end
  local raw = bridge.raw_c_header_dependencies(decoded)
  for index = 1, #paths do
    local path = paths[index]
    local item = raw[index] as {string: value}
    test.assert(item["path"] == path and item["identity"] == "exact identity " .. index,
      "extended compiler provenance changed when exported")
  end
end

local function completion_named_candidate(source: string, needle: string,
    label: string): completion_types.Candidate
  preload_real_compiler()
  local filename = test_paths.workspace_root() .. "/completion_presentation.titan"
  local _, caret? = strings.find(source, needle)
  test.assert(caret ~= nil, "completion test caret missing")
  local hole? = bridge.prepare_completion(filename, source, caret)
  test.assert(hole ~= nil, "completion test hole excluded")
  local module = lua.require("titan-compiler.completion") as {string: value}
  local original: value = module["fact"]
  local analysis = bridge.load():analyze_completion("completion_presentation", {
    bridge.ProjectModule.new("completion_presentation", {
      bridge.SourceFile.new(filename, hole.contents),
    }),
  }, {}, hole)
  test.assert(module["fact"] == original, "private completion retained its fact observer")
  for index = 1, #analysis.candidates do
    if analysis.candidates[index].label == label then return analysis.candidates[index] end
  end
  raise "missing completion candidate " .. label
end

function test_compiler_bridge_completion_named_function_signature(_context: test.Context)
  run_bridge(function ()
    local candidate = completion_named_candidate([[
function choose(first: integer, second: string?): (integer, string?)
  return first, second
end

function use(): integer
  return cho
end
]], "return cho", "choose")
    test.assert(candidate.detail == "choose(first: integer, second: string?): (integer, string?)",
      "completion lost declared names or multiple result types: " .. candidate.detail)
    test.assert(candidate.call_snippet == "choose(${1:first}, ${2:second})$0",
      "completion placeholders do not use declared names")
  end)
end

function test_compiler_bridge_completion_variadic_function_without_fixed_arguments(
    _context: test.Context)
  run_bridge(function ()
    local candidate = completion_named_candidate([[
function choose(...: integer): (...: integer)
  return ...
end
function use(): integer return cho end
]], "return cho", "choose")
    test.assert(candidate.detail == "choose(...: integer): (...: integer)",
      "completion lost the variadic input or flexible results: " .. candidate.detail)
    test.assert(candidate.call_snippet == "choose($1)$0",
      "variadic completion did not leave an editable argument position")
  end)
end

function test_compiler_bridge_documentation_is_typed_and_rejects_malformed_tags(context: test.Context)
  context:run("detached", function (_child: test.Context)
    local tag: {string: value} = {["name"] = "param", ["value"] = "item Original bytes."}
    local raw: {string: value} = {["summary"] = "Read bytes.", ["description"] = "Preserve NUL.",
      ["tags"] = {[1] = tag} as {integer: value}}
    local document? = bridge.normalize_documentation(raw)
    tag["value"] = "Changed"
    test.assert(document ~= nil and document.tags[1].value == "item Original bytes.",
      "documentation retained compiler-owned tag tables")
    test.assert(bridge.normalize_documentation(nil) == nil)
  end)
  context:run("invalid", function (_child: test.Context)
    local rejected = false
    do
      local raw: {string: value} = {["summary"] = "Read bytes.", ["description"] = "",
        ["tags"] = {[1] = {["name"] = "param", ["value"] = false} as {string: value}} as {integer: value}}
      bridge.normalize_documentation(raw)
    catch
      rejected = error is bridge.BridgeError
    end
    test.assert(rejected, "malformed documentation crossed the typed compiler boundary")
  end)
end

function test_compiler_bridge_completion_retains_doc_comments(_context: test.Context)
  run_bridge(function ()
    local candidate = completion_named_candidate([[
--- Choose a count.
-- @param first The returned count.
-- @return The selected integer.
-- @usage functions.md#named-calls
function choose(first: integer): integer return first end
function use(): integer return cho end
]], "return cho", "choose")
    test.assert(candidate.documentation ~= nil and
      strings.find(candidate.documentation, "Choose a count.") ~= nil and
      strings.find(candidate.documentation, "`first`") ~= nil and
      strings.find(candidate.documentation, "doc/language/functions.md#named-calls") ~= nil,
      "completion lost declaration documentation or relative manual link")
  end)
end

function test_compiler_bridge_completion_function_alias_in_type_position(_context: test.Context)
  run_bridge(function ()
    local candidate = completion_named_candidate([[
type Callback = function (integer): integer
function use(value: Call) end
]], "value: Call", "Callback")
    test.assert(candidate.lookup_domain == "type",
      "function alias was not selected as a type")
    test.assert(candidate.call_snippet == nil,
      "type completion inserted a function call")
    test.assert(strings.sub(candidate.detail, 1, 8) == "function",
      "type completion replaced the compiler's function type presentation")
  end)
end

function test_compiler_bridge_completion_specialized_method_signature(_context: test.Context)
  run_bridge(function ()
    local candidate = completion_named_candidate([[
record Box<|T|>
  item: T
end
function Box:replace(item: T): T
  return item
end
function use(box: Box<|integer|>): integer
  return box:rep
end
]], "box:rep", "replace")
    test.assert(candidate.detail == "replace(item: integer): integer",
      "completion lost receiver specialization: " .. candidate.detail)
    test.assert(candidate.call_snippet == "replace(${1:item})$0",
      "bound method dropped its first explicit parameter")
  end)
end

function test_compiler_bridge_completion_constructor_and_generic_signature(_context: test.Context)
  run_bridge(function ()
    local constructor = completion_named_candidate([[
record Counter
  amount: integer
end
function Counter.new(initial: integer?): Counter
  return {amount = initial or 0}
end
function use(): Counter
  return Counter.ne
end
]], "return Counter.ne", "new")
    test.assert(constructor.detail == "new(initial: integer?): completion_presentation.Counter",
      "constructor completion used field names instead of override parameters")
    test.assert(constructor.call_snippet == "new(${1:initial})$0")
    local generic = completion_named_candidate([[
function identity<|T|>(item: T): T
  return item
end
function use(): integer
  return ide
end
]], "return ide", "identity")
    test.assert(generic.detail == "identity<|T|>(item: T): T",
      "completion erased generic signature: " .. generic.detail)
    test.assert(generic.call_snippet == "identity(${1:item})$0")
  end)
end

function test_compiler_bridge_completion_interface_method_signature(_context: test.Context)
  run_bridge(function ()
    local candidate = completion_named_candidate([[
interface Writer
  function write(contents: string)
end
function use(writer: Writer)
  writer:wri
end
]], "writer:wri", "write")
    test.assert(candidate.detail == "write(contents: string): ()",
      "interface method completion lost declaration names")
    test.assert(candidate.call_snippet == "write(${1:contents})$0")
  end)
end

function test_compiler_bridge_completion_restores_observer_after_failure(_context: test.Context)
  run_bridge(function ()
    preload_real_compiler()
    local module = lua.require("titan-compiler.completion") as {string: value}
    local original: value = module["fact"]
    defer module["fact"] = original
    local observed = false
    local rejected = function (...: value): value
      observed = true
      raise "completion observation rejected"
    end
    module["fact"] = rejected
    local filename = test_paths.workspace_root() .. "/completion_failure.titan"
    local source = "function visible() end\nfunction use() vis end\n"
    local _, caret? = strings.find(source, "vis end")
    local hole? = bridge.prepare_completion(filename, source, caret - 4)
    do
      bridge.load():analyze_completion("completion_failure", {
        bridge.ProjectModule.new("completion_failure", {
          bridge.SourceFile.new(filename, hole.contents),
        }),
      }, {}, hole)
    catch
      -- The ordinary compiler may surface or classify the observation error.
    end
    test.assert(observed, "completion did not exercise the failing observer")
    test.assert(module["fact"] == rejected,
      "completion failure did not restore the exact original observer")
  end)
end

function test_compiler_bridge_completion_preserves_candidates_without_optional_hover_snapshot(_context: test.Context)
  run_bridge(function ()
    preload_real_compiler()
    local driver = lua.require("titan-compiler.driver") as {string: value}
    local original: value = driver["defaultloader"]
    local factory = original as function (value, value): value
    local close_loader = driver["close_loader"] as function (value): (value, value)
    defer driver["defaultloader"] = original
    local corrupted = false
    driver["defaultloader"] = function (static_deps: value, options: value): value
      local loader = factory(static_deps, options)
      local invoke = loader as function (string): (value, value, value, value)
      return function (name: string): (value, value, value, value)
        defer close_loader(loader)
        local first, second, third, fourth = invoke(name)
        local imported = driver["imported"] as {string: value}
        local root = imported[name] as {string: value}
        test.assert(root["completion"] ~= nil,
          "fixture corrupted the AST before caret facts were available")
        root["ast"] = false
        corrupted = true
        return first, second, third, fourth
      end
    end
    local filename = test_paths.workspace_root() .. "/hover_failure.titan"
    local source = "function visible() end\nfunction use() vis end\n"
    local start? = strings.find(source, "vis end")
    local hole? = bridge.prepare_completion(filename, source, start - 1 + 3)
    local analysis = bridge.load():analyze_completion("hover_failure", {
      bridge.ProjectModule.new("hover_failure", {bridge.SourceFile.new(filename, hole.contents)}),
    }, {}, hole)
    test.assert(corrupted and analysis.snapshot == nil,
      "invalid optional AST was not omitted")
    local found = false
    for index = 1, #analysis.candidates do
      if analysis.candidates[index].label == "visible" then found = true end
    end
    test.assert(found, "optional hover normalization discarded valid compiler candidates")
  end)
end

function test_compiler_bridge_private_source_analysis_preserves_real_call_occurrences(_context: test.Context)
  run_bridge(function ()
    preload_real_compiler()
    local driver = lua.require("titan-compiler.driver") as {string: value}
    local types = lua.require("titan-compiler.types") as {string: value}
    local completion = lua.require("titan-compiler.completion") as {string: value}
    local imported: value = driver["imported"]
    local registry: value = types["registry"]
    local observer: value = completion["fact"]
    local filename = test_paths.workspace_root() .. "/continuous_hover.titan"
    local source = "function choose(count: integer): integer return count end\n" ..
      "function use(): integer return choose(1) end\n"
    local analysis = bridge.load():analyze_completion("continuous_hover", {
      bridge.ProjectModule.new("continuous_hover", {bridge.SourceFile.new(filename, source)}),
    }, {}, nil)
    test.assert(analysis.snapshot ~= nil and analysis.quality == "complete" and analysis.kind == "source",
      "exact private source did not yield a usable semantic snapshot")
    test.assert(#analysis.candidates == 0 and #analysis.scopes == 0,
      "source-only preparation fabricated a caret completion context")
    local found = false
    for index = 1, #analysis.snapshot.symbols do
      local occurrence = analysis.snapshot.symbols[index]
      case occurrence.role
      when reference() then
        if occurrence.name == "choose" then
          found = true
          test.assert(occurrence.callable_signature ~= nil and
            occurrence.callable_signature.display == "continuous_hover.choose(count: integer): integer" and
            occurrence.exact_span ~= nil,
            "inserted call reference lost its real callable signature or span")
        end
      end
    end
    test.assert(found, "source-only preparation omitted the real call as if it were a dummy")
    test.assert(driver["imported"] == imported and types["registry"] == registry and
      completion["fact"] == observer,
      "source-only preparation retained private compiler globals")
    local broken = bridge.load():analyze_completion("continuous_hover", {
      bridge.ProjectModule.new("continuous_hover", {bridge.SourceFile.new(filename, "function unfinished(")}),
    }, {}, nil)
    test.assert(broken.snapshot == nil and broken.quality == "unresolved",
      "syntax failure was represented as a usable empty hover replacement")
    test.assert(driver["imported"] == imported and types["registry"] == registry and
      completion["fact"] == observer,
      "failed source-only preparation retained private compiler globals")
  end)
end

function test_compiler_bridge_completion_foreign_callable_signature(_context: test.Context)
  run_bridge(function ()
    preload_real_compiler()
    local include_root = test_paths.temporary_name()
    fs.unlink(include_root)
    fs.mkdir(include_root)
    local header = include_root .. "/completion_callable.h"
    fs.write_file(header, "int native_choose(int left, int right);\n" ..
      "int native_unnamed(int, int);\n")
    defer do fs.unlink(header); fs.rmdir(include_root) end
    local filename = test_paths.workspace_root() .. "/completion_c.titan"
    local source = "foreign import \"completion_callable.h\"\n" ..
      "function run(): integer return ffi.native_ch end\n"
    local _, caret? = strings.find(source, "ffi.native_ch")
    local hole? = bridge.prepare_completion(filename, source, caret)
    local compiler = bridge.load()
    compiler:configure(bridge.CompilerConfiguration.new {include_roots = {include_root}})
    local analysis = compiler:analyze_completion("completion_c", {
      bridge.ProjectModule.new("completion_c", {bridge.SourceFile.new(filename, hole.contents)}),
    }, {}, hole)
    local found = false
    local found_unnamed = false
    for index = 1, #analysis.candidates do
      local candidate = analysis.candidates[index]
      if candidate.label == "native_choose" then
        found = true
        test.assert(candidate.detail == "native_choose(left: foreign int, right: foreign int): foreign int",
          "C completion lost named prototype: " .. candidate.detail)
        test.assert(candidate.call_snippet == "native_choose(${1:left}, ${2:right})$0")
      elseif candidate.label == "native_unnamed" then
        found_unnamed = true
        test.assert(candidate.detail == "native_unnamed(foreign int, foreign int): foreign int",
          "unnamed C completion invented declaration names: " .. candidate.detail)
        test.assert(candidate.call_snippet == "native_unnamed(${1:arg1}, ${2:arg2})$0",
          "unnamed C completion did not provide positional placeholders")
      end
    end
    test.assert(found, "named C completion missing")
    test.assert(found_unnamed, "unnamed C completion missing")
  end)
end

function test_compiler_bridge_native_process_dependency_fences_cache(
    _context: test.Context)
  run_bridge(function()
    preload_real_compiler()
    local resolve = lua.load([[
return function() return assert(package.searchpath("luv", package.cpath)) end
]], "=compiler_bridge_process_dependency", nil)() as function (): string
    local dependency = resolve()
    local compiler = bridge.load()
    local observed = false
    local revision = "first native transport bytes"
    local fingerprint = function(filename: string): string
      if filename == dependency then
        observed = true
        return revision
      end
      return filename
    end
    local first = compiler:cache_identity(fingerprint)
    revision = "replacement native transport bytes"
    local replacement = compiler:cache_identity(fingerprint)
    test.assert(observed and first ~= replacement,
                "changed native process transport retained compatible workspace facts")
  end)
end

function test_compiler_bridge_raw_source_descriptor_uses_canonical_native_output(
    _context: test.Context)
  preload_real_compiler()
  local host = bridge.host_target()
  local root = test_paths.workspace_root() .. "/src"
  local flat_main = root .. "/pkg/service." .. host .. ".titan"
  local flat_descriptor = bridge.ProjectModule("pkg.service", {
    bridge.SourceFile(flat_main, "function run(): integer return 1 end\n"),
  }):raw_source_descriptor() as {string: value}
  test.assert(flat_descriptor["kind"] == "flat" and
              flat_descriptor["main"] == flat_main and
              flat_descriptor["native_output"] == root .. "/pkg/service.titan",
              "flat variant descriptor did not use canonical logical native_output")

  local folder_main = root .. "/pkg/folder/folder." .. host .. ".titan"
  local folder_contrib = root .. "/pkg/folder/ops.native.titan"
  local folder_descriptor = bridge.ProjectModule("pkg.folder", {
    bridge.SourceFile(folder_main, "function run(): integer return 1 end\n"),
    bridge.SourceFile(folder_contrib, "function extra(): integer return 2 end\n"),
  }):raw_source_descriptor() as {string: value}
  test.assert(folder_descriptor["kind"] == "folder" and
              folder_descriptor["main"] == folder_main and
              folder_descriptor["native_output"] ==
                root .. "/pkg/folder/folder.titan",
              "folder variant descriptor did not use canonical logical native_output")

  local single_folder = bridge.ProjectModule("pkg.folder", {
    bridge.SourceFile(folder_main, "function run(): integer return 1 end\n"),
  }):raw_source_descriptor() as {string: value}
  test.assert(single_folder["native_output"] ==
              root .. "/pkg/folder/folder.titan",
              "one-file folder variant descriptor lost canonical logical native_output")
end

function test_compiler_bridge_analyzes_variant_modules_and_ignores_titan_target_env(
    _context: test.Context)
  run_bridge(function ()
    preload_real_compiler()
    local previous_target? = system.getenv("TITAN_TARGET")
    defer do
      if previous_target ~= nil then
        system.setenv("TITAN_TARGET", previous_target as string)
      else
        system.unsetenv("TITAN_TARGET")
      end
    end
    system.setenv("TITAN_TARGET", "browser")
    local host = bridge.host_target()
    test.assert(host ~= "browser",
                "TITAN_TARGET environment variable changed language-server host target")
    system.setenv("TITAN_TARGET", "invalid-target-name")
    test.assert(bridge.host_target() == host,
                "invalid TITAN_TARGET environment variable affected host_target")

    local root = test_paths.temporary_name()
    fs.unlink(root)
    fs.mkdir(root)
    fs.mkdir(root .. "/pkg")
    local main_path = root .. "/pkg/pkg." .. host .. ".titan"
    local ops_path = root .. "/pkg/ops.native.titan"
    local consumer_path = root .. "/consumer." .. host .. ".titan"
    local main_text = "foreign function variant_c_add(x: int): int return x + 1 end\n" ..
      "local function private_base(): integer return 40 end\n"
    local ops_text = "function public_total(): integer return private_base() + 2 end\n"
    local consumer_text = "local pkg = import \"pkg.titan\"\n" ..
      "function answer(): integer return pkg.private_base() + pkg.public_total() end\n"
    fs.write_file(main_path, main_text)
    fs.write_file(ops_path, ops_text)
    fs.write_file(consumer_path, consumer_text)
    defer do
      if fs.lstat(consumer_path) ~= nil then fs.unlink(consumer_path) end
      if fs.lstat(ops_path) ~= nil then fs.unlink(ops_path) end
      if fs.lstat(main_path) ~= nil then fs.unlink(main_path) end
      if fs.lstat(root .. "/pkg") ~= nil then fs.rmdir(root .. "/pkg") end
      if fs.lstat(root) ~= nil then fs.rmdir(root) end
    end

    local compiler = bridge.load()
    compiler:configure(bridge.CompilerConfiguration.new {source_roots = {root}})
    local projects = {
      bridge.ProjectModule.new("pkg", {
        bridge.SourceFile.new(main_path, main_text),
        bridge.SourceFile.new(ops_path, ops_text),
      }),
      bridge.ProjectModule.new("consumer", {
        bridge.SourceFile.new(consumer_path, consumer_text),
      }),
    }
    local first = compiler:analyze_incremental(projects, {"pkg", "consumer"}, {})
    test.assert(#first.diagnostics == 0 and
                first:find_module("pkg") ~= nil and
                first:find_module("consumer") ~= nil and
                compiler:has_project_entry("pkg"),
                "variant folder and source-import consumer failed initial analysis")
    local second = compiler:analyze_incremental(projects, {"consumer"}, {})
    test.assert(#second.diagnostics == 0 and
                second:find_module("consumer") ~= nil,
                "cached variant source entry failed incremental reuse")
  end)
end

function test_compiler_bridge_header_dependency_kind_codecs(_context: test.Context)
  local file_kind = bridge.CHeaderDependencyKind.file()
  local search_kind = bridge.CHeaderDependencyKind.search()
  local origin_kind = bridge.CHeaderDependencyKind.origin()
  test.assert(file_kind:name() == "file" and file_kind:code() == 0,
              "file kind codec mismatch")
  test.assert(search_kind:name() == "search" and search_kind:code() == 1,
              "search kind codec mismatch")
  test.assert(origin_kind:name() == "origin" and origin_kind:code() == 2,
              "origin kind codec mismatch")
  local decoded_file? = bridge.header_dependency_kind_from_name("file")
  local decoded_search? = bridge.header_dependency_kind_from_name("search")
  local decoded_origin? = bridge.header_dependency_kind_from_name("origin")
  test.assert(decoded_file ~= nil and decoded_file:code() == 0 and
              decoded_search ~= nil and decoded_search:code() == 1 and
              decoded_origin ~= nil and decoded_origin:code() == 2 and
              bridge.header_dependency_kind_from_name("unknown") == nil,
              "header_dependency_kind_from_name mismatch")
  local from_zero? = bridge.header_dependency_kind_from_code(0)
  local from_one? = bridge.header_dependency_kind_from_code(1)
  local from_two? = bridge.header_dependency_kind_from_code(2)
  test.assert(from_zero ~= nil and from_zero:name() == "file" and
              from_one ~= nil and from_one:name() == "search" and
              from_two ~= nil and from_two:name() == "origin" and
              bridge.header_dependency_kind_from_code(-1) == nil and
              bridge.header_dependency_kind_from_code(3) == nil,
              "header_dependency_kind_from_code mismatch")
end
