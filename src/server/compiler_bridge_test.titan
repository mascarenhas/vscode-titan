local function preserves_mixed_sparse_project_payloads()
  preload_real_compiler()
  local compiler = bridge.load()
  local provider_name = "sparse_provider"
  local consumer_name = "sparse_consumer"
  local provider_file = test_paths.workspace_root() .. "/sparse_provider.titan"
  local consumer_file = test_paths.workspace_root() .. "/sparse_consumer.titan"
  local provider = bridge.ProjectModule.new(provider_name,{bridge.SourceFile.new(provider_file,
    "record Box<|A|> item: A local hidden: A end\n" ..
    "local function secret<|A|>(item: A): A\n" ..
    "  local body_only_result = item\n" ..
    "  return body_only_result\n" ..
    "end\n")})
  local consumer_source: function (integer): string = function (extra: integer): string
    return "local provider = import \"sparse_provider.titan\"\n" ..
      "function answer(): integer\n" ..
      "  local box = provider.Box<|integer|>.new(42, 7)\n" ..
      "  return provider.secret<|integer|>(box.item) + box.hidden + " .. extra .. "\n" ..
      "end\n"
  end
  local consumer = bridge.ProjectModule.new(consumer_name,{
    bridge.SourceFile.new(consumer_file,consumer_source(0))})
  local projects = {provider,consumer}
  local initial = compiler:analyze(consumer_name,projects)
  test.assert(#initial.diagnostics == 0,"initial generic source-private payload fixture failed")
  local original_provider: bridge.ModuleSnapshot = initial:find_module(provider_name)
  assert_declared_project_entry(compiler, provider_name)
  assert_declared_project_entry(compiler, consumer_name)
  local original = features.build(projects,initial.modules)
  defer original:close()
  local secret_position = source_text.Position.new(3,20)
  local owner_position = source_text.Position.new(2,24)
  local initial_secret? = original:hover(consumer_file,secret_position)
  local initial_owner? = original:hover(consumer_file,owner_position)
  test.assert(initial_secret ~= nil and initial_owner ~= nil,
    "initial payload fixture had no source-private or generic hover")
  local complete = compiler:export_projects(projects,{provider_name,consumer_name})
  test.assert(#complete == 2 and complete[1].module_name == provider_name and
    complete[2].module_name == consumer_name,"initial project payloads were not encoded")

  local edited = bridge.ProjectModule.new(consumer_name,{
    bridge.SourceFile.new(consumer_file,consumer_source(1))})
  local current = {provider,edited}
  local changed = compiler:analyze_incremental(current,{consumer_name},{})
  test.assert(#changed.diagnostics == 0 and changed:find_module(provider_name) == nil,
    "body-only consumer edit reparsed/rechecked its unchanged provider")
  -- A sparse export selects only changed declarations while retaining the
  -- complete project file allowlist for their source locations.
  local sparse = compiler:export_projects(current,{consumer_name})
  test.assert(#sparse == 1 and sparse[1].module_name == consumer_name,
    "sparse export encoded an unchanged provider or narrowed the project file allowlist")
  test.assert(#compiler:export_projects(current,{}) == 0,
    "empty sparse selection re-encoded project state")
  test.assert(#compiler:export_projects({edited},{provider_name}) == 0,
    "sparse selection exported an entry outside the current project set")
  local restarted = bridge.load()
  local restored = restarted:restore_projects(current,{complete[1],sparse[1]})
  test.assert(#restored == 2 and restored[1] == provider_name and
    restored[2] == consumer_name,"mixed unchanged/new manifests did not restore together")
  assert_declared_project_entry(restarted, provider_name)
  assert_declared_project_entry(restarted, consumer_name)
  local next_consumer = bridge.ProjectModule.new(consumer_name,{
    bridge.SourceFile.new(consumer_file,consumer_source(2))})
  local next_projects = {provider,next_consumer}
  local next_change = restarted:analyze_incremental(next_projects,{consumer_name},{})
  test.assert(#next_change.diagnostics == 0 and next_change:find_module(provider_name) == nil,
    "restored provider was not reusable on the next source-private generic edit")
  local fresh: bridge.ModuleSnapshot = next_change:find_module(consumer_name)
  local secret_identity? = symbol_identity(fresh,"secret")
  local field_identity? = symbol_identity(fresh,"hidden")
  test.assert(secret_identity ~= nil and field_identity ~= nil and
    secret_identity == symbol_identity(original_provider,"secret") and
    field_identity == symbol_identity(original_provider,"hidden"),
    "checking against restored declarations changed private function or field identities")
  -- Only fresh checking produces consumer facts. The original provider facts
  -- stand in for its unchanged published rows, whose reuse has separate tests.
  local replayed = features.build(next_projects,{original_provider,fresh})
  defer replayed:close()
  local secret? = replayed:hover(consumer_file,secret_position)
  local owner? = replayed:hover(consumer_file,owner_position)
  test.assert(secret ~= nil and owner ~= nil and
    secret:markdown() == (initial_secret as features.Hover):markdown() and
    owner:markdown() == (initial_owner as features.Hover):markdown(),
    "checking against restored manifests changed source-private or generic owner metadata")
  local definition? = replayed:definition(consumer_file,secret_position)
  test.assert(definition ~= nil and definition.uri ==
    test_paths.workspace_uri() .. "/sparse_provider.titan" and
    definition.range.start.line == 1 and definition.range.start.character == 15,
    "checking against restored declarations lost the provider's definition target")
  assert_declared_project_entry(restarted, provider_name)
  assert_declared_project_entry(restarted, consumer_name)

  local public_consumer = bridge.ProjectModule.new(consumer_name,{
    bridge.SourceFile.new(consumer_file,
      "local provider = import \"sparse_provider\"\n" ..
      "function answer(box: provider.Box<|integer|>): integer\n" ..
      "  return box.hidden\nend\n")})
  local public_result = restarted:analyze_incremental(
    {provider,public_consumer},{consumer_name},{})
  local hidden_field_rejected = false
  for index = 1, #public_result.diagnostics do
    if strings.find(public_result.diagnostics[index].message,
        "field 'hidden' not found") ~= nil then
      hidden_field_rejected = true
    end
  end
  test.assert(#public_result.diagnostics > 0 and
    hidden_field_rejected and public_result:find_module(provider_name) == nil,
    "restored source-visible fields leaked into an ordinary public import")
end

function test_compiler_bridge_preserves_mixed_sparse_project_payloads(_context: test.Context)
  run_bridge(preserves_mixed_sparse_project_payloads)
end

function test_compiler_bridge_native_sha_matches_the_compiler_binary_digest(_context: test.Context)
  test_runtime.run(function ()
    preload_real_compiler()
    local compiler_digest = lua.load(
      "return require('titan-compiler.sha256').binary",
      "=compiler_bridge_sha256_equivalence",nil)() as function (string): string
    local sources = {"", "a\0b\255", "\0\255boundary0123456789abcdefghijklmnopqrstuvwxyz" ..
      "0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"}
    for index = 1, #sources do
      local source = sources[index]
      local native = content_identity.digest(source)
      test.assert(#native == 32 and native == compiler_digest(source),
        "native SHA callback differs from the compiler's binary graph checksum")
    end
  end)
end

local function joins_source_imported_local_function_definition_identity()
  local generated_archive = "bridge_source_definition_consumer.a"
  local generated_shared = "bridge_source_definition_consumer.so"
  do fs.unlink(generated_archive) catch end
  do fs.unlink(generated_shared) catch end
  defer do
    do fs.unlink(generated_archive) catch end
    do fs.unlink(generated_shared) catch end
  end
  preload_real_compiler()
  -- Source-defined foreign functions require a writable sibling directory for
  -- the compiler's temporary checking header, even though project source reads
  -- themselves come from the bridge overlay.
  local fixture_root = test_paths.temporary_name()
  fs.unlink(fixture_root)
  fs.mkdir(fixture_root)
  defer fs.rmdir(fixture_root)
  local provider_file =
    fixture_root .. "/bridge_source_definition_provider.titan"
  local consumer_file =
    fixture_root .. "/bridge_source_definition_consumer.titan"
  local provider = bridge.ProjectModule.new(
    "bridge_source_definition_provider", {bridge.SourceFile.new(
      provider_file,
      "foreign import \"titan/ffi.h\"\n" ..
      "local secret_value: integer = 1\n" ..
      "local function secret(): integer return 41 end\n" ..
      "foreign function native_add(left: int,\n" ..
      "                            right: int): int\n" ..
      "  return left + right\n" ..
      "end\n" ..
      "local type SecretAlias = integer\n")})
  local consumer = bridge.ProjectModule.new(
    "bridge_source_definition_consumer", {bridge.SourceFile.new(
      consumer_file,
      "local provider = import \"bridge_source_definition_provider.titan\"\n" ..
      "function answer(): integer return provider.secret() end\n" ..
      "function read_value(): integer return provider.secret_value end\n" ..
      "function call_native(): integer return " ..
      "provider.native_add(1, 2) end\n" ..
      "function alias_identity(input: provider.SecretAlias): integer " ..
      "return input end\n")})
  local projects = {provider, consumer}
  local analysis = bridge.load():analyze(
    "bridge_source_definition_consumer", projects)
  local diagnostic_messages = strings.writer()
  for index = 1, #analysis.diagnostics do
    diagnostic_messages:write(analysis.diagnostics[index].message .. "\n")
  end
  test.assert(#analysis.diagnostics == 0,
              "compiler rejected source-import definition fixture: " ..
                diagnostic_messages:drain())
  local provider_snapshot? =
    analysis:find_module("bridge_source_definition_provider")
  local consumer_snapshot? =
    analysis:find_module("bridge_source_definition_consumer")
  test.assert(provider_snapshot ~= nil and consumer_snapshot ~= nil,
              "source-import definition fixture lost a project snapshot")

  local provider_identity?: string = nil
  local consumer_identity?: string = nil
  local provider_variable_identity?: string = nil
  local consumer_variable_identity?: string = nil
  local provider_foreign_identity?: string = nil
  local consumer_foreign_identity?: string = nil
  local provider_alias_identity?: string = nil
  local consumer_alias_identity?: string = nil
  for index = 1, #provider_snapshot.symbols do
    local symbol = provider_snapshot.symbols[index]
    if symbol.name == "secret" and symbol.exact_span ~= nil then
      provider_identity = symbol.declaration_id
    elseif symbol.name == "secret_value" and symbol.exact_span ~= nil then
      provider_variable_identity = symbol.declaration_id
    elseif symbol.name == "native_add" then
      provider_foreign_identity = symbol.declaration_id
    elseif symbol.name == "SecretAlias" and symbol.exact_span ~= nil then
      provider_alias_identity = symbol.declaration_id
    end
  end
  for index = 1, #consumer_snapshot.symbols do
    local symbol = consumer_snapshot.symbols[index]
    if symbol.name == "secret" and symbol.exact_span ~= nil then
      consumer_identity = symbol.declaration_id
    elseif symbol.name == "secret_value" and symbol.exact_span ~= nil then
      consumer_variable_identity = symbol.declaration_id
    elseif symbol.name == "native_add" then
      consumer_foreign_identity = symbol.declaration_id
    elseif symbol.name == "SecretAlias" and symbol.exact_span ~= nil then
      consumer_alias_identity = symbol.declaration_id
    end
  end
  test.assert(provider_identity ~= nil and
              provider_identity == consumer_identity,
              "source-imported local function did not join its declaration")
  test.assert(provider_variable_identity ~= nil and
              provider_variable_identity == consumer_variable_identity,
              "source-imported local variable did not join its declaration")
  test.assert(provider_foreign_identity ~= nil and
              provider_foreign_identity == consumer_foreign_identity,
              "source-imported foreign function did not join its references")
  test.assert(provider_alias_identity ~= nil and
              provider_alias_identity == consumer_alias_identity and
              provider_alias_identity ==
                "source:bridge_source_definition_provider:type:SecretAlias",
              "source-imported local type alias did not join its declaration")

  local saved_features = features.build(projects, analysis.modules)
  defer saved_features:close()
  local definition? = saved_features:definition(
    consumer_file, source_text.Position.new(1, 44))
  local provider_uri?, provider_uri_error? =
    source_text.path_to_file_uri(provider_file)
  test.assert(provider_uri_error == nil and provider_uri ~= nil,
              "source-import provider path did not become a file URI")
  if provider_uri == nil then raise "source-import provider URI is missing" end
  test.assert(definition ~= nil and
              definition.uri == provider_uri and
              definition.range.start.line == 2 and
              definition.range.start.character == 15 and
              definition.range.finish.character == 21,
              "source-imported local function resolved to no exact definition")

  local variable_definition? =
    saved_features:definition(
      consumer_file, source_text.Position.new(2, 49))
  test.assert(variable_definition ~= nil and
              variable_definition.uri == provider_uri and
              variable_definition.range.start.line == 1 and
              variable_definition.range.start.character == 6 and
              variable_definition.range.finish.character == 18,
              "source-imported local variable resolved to no exact definition")

  local foreign_definition? =
    saved_features:definition(
      consumer_file, source_text.Position.new(3, 50))
  test.assert(foreign_definition == nil,
              "source-imported foreign function became a definition target")
end

function test_compiler_bridge_joins_source_imported_local_function_definition_identity(
    _context: test.Context)
  test_runtime.run(joins_source_imported_local_function_definition_identity)
end

local function preserves_foreign_function_visibility()
  preload_real_compiler()
  local compiler = bridge.load()
  local parse = compiler.parser["parse"] as function (string, string): (value, value)
  local public_source = "foreign function visible(input: int): int return input end\n"
  local parsed: value, _ = parse("foreign_visibility.titan", public_source)
  local declarations = parsed as {integer: value}
  local declaration = declarations[1] as {string: value}
  local modern = declaration["islocal"] ~= nil
  local root = test_paths.temporary_name()
  fs.unlink(root)
  fs.mkdir(root)
  defer fs.rmdir(root)
  local provider_file = root .. "/foreign_visibility_provider.titan"
  local consumer_file = root .. "/foreign_visibility_consumer.titan"
  local ordinary_file = root .. "/foreign_visibility_ordinary.titan"
  local provider_source = public_source .. (modern and "local " or "") ..
    "foreign function hidden(input: int): int return input + 1 end\n"
  local consumer_source = [[local provider = import "foreign_visibility_provider.titan"
function answer(): integer
  return provider.visible(1) + provider.hidden(2)
end
]]
  local projects = {
    bridge.ProjectModule.new("foreign_visibility_provider", {
      bridge.SourceFile.new(provider_file, provider_source),
    }),
    bridge.ProjectModule.new("foreign_visibility_consumer", {
      bridge.SourceFile.new(consumer_file, consumer_source),
    }),
  }
  if modern then
    projects[#projects + 1] = bridge.ProjectModule.new("foreign_visibility_ordinary", {
      bridge.SourceFile.new(ordinary_file,
        "local provider = import \"foreign_visibility_provider\"\n" ..
        "function answer(): integer return provider.visible(3) end\n"),
    })
  end
  local analysis = compiler:analyze("foreign_visibility_consumer", projects)
  local diagnostics = strings.writer()
  for index = 1, #analysis.diagnostics do
    diagnostics:write(analysis.diagnostics[index].message .. "\n")
  end
  test.assert(#analysis.diagnostics == 0,
              "compiler rejected foreign visibility fixture: " .. diagnostics:drain())
  local visible_id = (modern and "export:" or "source:") ..
    "foreign_visibility_provider:value:visible"
  local hidden_id = "source:foreign_visibility_provider:value:hidden"
  local seen_visible = 0
  local seen_hidden = 0
  for module_index = 1, #analysis.modules do
    local snapshot = analysis.modules[module_index]
    for index = 1, #snapshot.symbols do
      local symbol = snapshot.symbols[index]
      if symbol.name == "visible" or symbol.name == "hidden" then
        local is_visible = symbol.name == "visible"
        test.assert(symbol.declaration_id == (is_visible and visible_id or hidden_id) and
                    symbol.is_local == (not is_visible or not modern),
                    "foreign function lost its declared visibility or cross-module identity")
        if is_visible then seen_visible = seen_visible + 1 else seen_hidden = seen_hidden + 1 end
        if snapshot.module_name == "foreign_visibility_provider" then
          test.assert(symbol.exact_span == nil,
                      "foreign function declaration became a navigation anchor")
        end
      end
    end
  end
  test.assert(seen_visible == (modern and 3 or 2) and seen_hidden == 2,
              "foreign function fixture lost its declarations or calls")
  local model = features.build(projects, analysis.modules)
  defer model:close()
  local visible_position = marked_name_position(consumer_source, "provider.visible", "visible")
  local hidden_position = marked_name_position(consumer_source, "provider.hidden", "hidden")
  local visible_hover? = model:hover(consumer_file, visible_position)
  local hidden_hover? = model:hover(consumer_file, hidden_position)
  test.assert(visible_hover ~= nil and hidden_hover ~= nil and
              visible_hover.callable_signature ~= nil and
              hidden_hover.callable_signature ~= nil and
              visible_hover.callable_signature.display ==
                "foreign_visibility_provider.visible(input: foreign int): foreign int" and
              hidden_hover.callable_signature.display ==
                "foreign_visibility_provider.hidden(input: foreign int): foreign int" and
              strings.find(visible_hover:markdown(), "Visibility: " ..
                (modern and "exported" or "module")) ~= nil and
              strings.find(hidden_hover:markdown(), "Visibility: module") ~= nil,
              "foreign function hover lost its canonical owner or compiler visibility")
  local renamed?, rename_error? = model:rename(consumer_file, visible_position, "renamed")
  test.assert(model:definition(consumer_file, visible_position) == nil and
              model:definition(consumer_file, hidden_position) == nil and
              renamed == nil and rename_error ~= nil,
              "foreign function became a definition or rename target")
end

function test_compiler_bridge_preserves_foreign_function_visibility(_context: test.Context)
  run_bridge(preserves_foreign_function_visibility)
end

local function reports_dirty_saved_file_progress()
  with_fixture("progress", function ()
    local compiler = bridge.load()
    local first = bridge.ProjectModule.new("fixture.first", {
      bridge.SourceFile.new(test_paths.workspace_root() .. "/first.titan", ""),
      bridge.SourceFile.new(test_paths.workspace_root() .. "/first_part.titan", ""),
    })
    local second = bridge.ProjectModule.new("fixture.second", {
      bridge.SourceFile.new(test_paths.workspace_root() .. "/second.titan", ""),
    })
    local observed: {bridge.AnalysisProgress} = {}
    local analysis = compiler:analyze_incremental(
      {first, second},
      {"fixture.first", "fixture.first", "fixture.second"}, {},
      function (progress: bridge.AnalysisProgress)
        observed[#observed + 1] = progress
      end)

    test.assert(#analysis.diagnostics == 0,
                "progress fixture compiler analysis failed")
    test.assert(#observed == 3 and
                observed[1].completed_files == 0 and
                observed[1].total_files == 3 and
                observed[2].completed_files == 2 and
                observed[2].total_files == 3 and
                observed[3].completed_files == 3 and
                observed[3].total_files == 3,
                "dirty progress did not count saved files exactly once")
  end)
end

function test_compiler_bridge_reports_exact_dirty_saved_file_progress(
    _context: test.Context)
  test_runtime.run(reports_dirty_saved_file_progress)
end

local function completes_progress_for_failed_root_without_yield()
  with_fixture("invalid-source", function ()
    local compiler = bridge.load()
    local observed: {bridge.AnalysisProgress} = {}
    local analysis = compiler:analyze_incremental({
      bridge.ProjectModule.new("fixture.failed", {
        bridge.SourceFile.new(test_paths.workspace_root() .. "/failed.titan", ""),
        bridge.SourceFile.new(test_paths.workspace_root() .. "/failed_part.titan", ""),
      }),
    }, {"fixture.failed"}, {}, function (progress: bridge.AnalysisProgress)
      observed[#observed + 1] = progress
    end)
    test.assert(#analysis.diagnostics == 1,
                "failed progress fixture lost its compiler diagnostic")
    test.assert(#observed == 2 and
                observed[1].completed_files == 0 and
                observed[1].total_files == 2 and
                observed[2].completed_files == 2 and
                observed[2].total_files == 2,
                "failed root vanished before saved-file progress completed")
  end)
end

function test_compiler_bridge_completes_progress_for_nonyielding_failed_root(
    _context: test.Context)
