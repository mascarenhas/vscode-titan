local function invalid_location_case(context: test.Context, mode: string,
                                     expected: string)
  context:run(mode, function (_child: test.Context)
    run_bridge(function ()
      with_fixture(mode, function ()
        local compiler = bridge.load()
        local rejected = false
        do
          compiler:analyze("fixture", {bridge.ProjectModule.new(
            "fixture", {bridge.SourceFile.new(
              test_paths.workspace_root() .. "/fixture.titan", "saved fixture")})})
        catch
          rejected = true
          test.assert(error is bridge.BridgeError,
            "invalid compiler coordinates raised an untyped error")
          local failure = error as bridge.BridgeError
          test.assert(failure.module_name == "titan-compiler.driver" and
            failure.message == expected, failure.message)
        end
        test.assert(rejected, "invalid compiler coordinates were accepted")
      end)
    end)
  end)
end

function test_compiler_bridge_rejects_invalid_semantic_and_structural_locations(
    context: test.Context)
  invalid_location_case(context, "nonpositive-location",
    "Ast.TopLevelVar.loc must use positive line and column values")
  invalid_location_case(context, "structure-without-start",
    "Ast.TopLevelFunc has _end_loc without a structural start")
  invalid_location_case(context, "structure-across-files",
    "Ast.TopLevelFunc structural span crosses source files")
  invalid_location_case(context, "structure-before-start",
    "Ast.TopLevelFunc structural span finishes before it starts")
end

function test_compiler_bridge_scopes_one_c_header_analysis_to_all_root_attempts(
    _context: test.Context)
  with_fixture("c-header-analysis-lifetime", function ()
    local compiler = bridge.load()
    local first = compiler:analyze_incremental({
      bridge.ProjectModule.new("fixture.first", {
        bridge.SourceFile.new(test_paths.workspace_root() .. "/first.titan", ""),
      }),
      bridge.ProjectModule.new("fixture.second", {
        bridge.SourceFile.new(test_paths.workspace_root() .. "/second.titan", ""),
      }),
    }, {"fixture.first", "fixture.second"}, {})
    test.assert(#first.modules >= 2,
                "multi-root analysis did not run both fixture roots")

    local second = compiler:analyze_incremental({
      bridge.ProjectModule.new("fixture.first", {
        bridge.SourceFile.new(test_paths.workspace_root() .. "/first.titan", ""),
      }),
    }, {"fixture.first"}, {})
    test.assert(#second.modules >= 1,
                "second analysis did not run its fixture root")
  end)
end

function test_compiler_bridge_attributes_location_free_diagnostics_to_each_root(
    _context: test.Context)
  with_fixture("location-free-diagnostic", function ()
    local compiler = bridge.load()
    local analysis = compiler:analyze_incremental({
      bridge.ProjectModule.new("fixture.first", {
        bridge.SourceFile.new(test_paths.workspace_root() .. "/first.titan", ""),
      }),
      bridge.ProjectModule.new("fixture.second", {
        bridge.SourceFile.new(test_paths.workspace_root() .. "/second.titan", ""),
      }),
    }, {"fixture.first", "fixture.second"}, {})
    test.assert(#analysis.diagnostics == 2 and
                analysis.diagnostics[1].location == nil and
                analysis.diagnostics[1].owner_module == "fixture.first" and
                analysis.diagnostics[2].location == nil and
                analysis.diagnostics[2].owner_module == "fixture.second",
                "location-free compiler errors lost their root-attempt owner")
  end)
end

