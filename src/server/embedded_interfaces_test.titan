foreign import "compiler_io_platform.h"
local async = import "async"
local fs = import "fs"
local os = import "os"
local selected = import "server.selected_interfaces.titan"
local test_runtime = import "server.test_runtime"
local timer = import "timer"
local test = import "test"
local iteration = import "iteration"
local lua = import "lua"
local strings = import "string"
local paths = import "path"
local embedded_interfaces = import "server.embedded_interfaces"

local EXPECTED: {string: boolean} = {
  ["titan.async"] = true,
  ["titan.coroutine"] = true,
  ["titan.fs"] = true,
  ["titan.gc"] = true,
  ["titan.http"] = true,
  ["titan.io"] = true,
  ["titan.iteration"] = true,
  ["titan.json"] = true,
  ["titan.lua"] = true,
  ["titan.math"] = true,
  ["titan.net"] = true,
  ["titan.os"] = true,
  ["titan.path"] = true,
  ["titan.peg"] = true,
  ["titan.protobuf"] = true,
  ["titan.reflect"] = true,
  ["titan.sqlite3"] = true,
  ["titan.ssl"] = true,
  ["titan.string"] = true,
  ["titan.test"] = true,
  ["titan.thread"] = true,
  ["titan.timer"] = true,
  ["titan.transfer"] = true,
  ["titan.url"] = true,
  ["titan.uv"] = true,
  ["titan.websocket"] = true,
}

function test_embedded_interfaces_expose_the_complete_metadata_only_provider(
    _context: test.Context)
  local provider, identity = embedded_interfaces.provider()
  local provider_file: string = provider["provider_file"]
  local absolute = paths.is_absolute(provider_file)
  test.assert(#provider_file > 0 and absolute,
              "embedded interface provider path is not absolute: " .. provider_file)
  local identity_path: string = identity["path"]
  local identity_kind: string = identity["kind"]
  local identity_size: integer = identity["size"]
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then
    local native: string = identity["native_identity"]
    test.assert(#native > 0 and identity["device"] == nil and identity["inode"] == nil,
                "Windows provider identity was truncated to integers")
  else
    local identity_device: integer = identity["device"]
    local identity_inode: integer = identity["inode"]
    test.assert(identity["native_identity"] == nil, "Unix identity unexpectedly changed")
  end
  local identity_seconds: integer = identity["modified_seconds"]
  local identity_nanoseconds: integer = identity["modified_nanoseconds"]
  test.assert(identity_path == provider_file and identity_kind == "file" and
              identity_size > 0 and identity_nanoseconds >= 0 and
              identity_nanoseconds < 1000000000,
              "embedded provider identity is incomplete or mismatched")

  local raw_entries: value = provider["entries"]
  test.assert(raw_entries is {string: value},
              "embedded interface provider has no entry table")
  local entries = raw_entries as {string: value}
  local count = 0
  for name, raw_entry in iteration.pairs<|string, value|>(entries) do
    count = count + 1
    test.assert(EXPECTED[name] == true,
                "embedded interface provider exposed unexpected " .. name)
    test.assert(raw_entry is {string: value},
                "embedded interface entry is not a table")
    local entry = raw_entry as {string: value}
    local abi: string = entry["abi"]
    local types: string = entry["types"]
    test.assert(abi == "2" and #types > 0,
                "embedded interface entry has invalid ABI/types")
  end
  local modern = entries["titan.protobuf"] ~= nil or
                 entries["titan.thread"] ~= nil or entries["titan.transfer"] ~= nil
  test.assert((not modern and count == 23) or
              (modern and count == 26 and entries["titan.protobuf"] ~= nil and
               entries["titan.thread"] ~= nil and entries["titan.transfer"] ~= nil),
              "embedded interface provider did not expose a complete 23- or 26-module inventory")

  -- Discard any support table an earlier compiler test loaded from an ambient
  -- installation. The provider's registry preload must be sufficient by
  -- itself, and requiring it must expose the metadata-probing helper.
  local clear_loaded = lua.load([[
return function()
  package.loaded["titan"] = nil
end
]], "=embedded_interfaces_clear_titan", nil)() as function (): ()
  clear_loaded()
  local support = lua.require("titan")
  local inspect_support = lua.load([[
return function(module)
  return type(package.preload["titan"]),
         type(module),
         type(module._loadlib)
end
]], "=embedded_interfaces_inspect_titan", nil)() as
    function (value): (string, string, string)
  local preload_kind, support_kind, loadlib_kind = inspect_support(support)
  test.assert(preload_kind == "function" and support_kind == "table" and
              loadlib_kind == "function",
              "embedded provider did not preload Titan compiler support")
end

function test_embedded_target_profile_reconstructs_native_numeric_traits(
    _context: test.Context)
  local provider = embedded_interfaces.provider()
  local check_profile = lua.load([[
return function(data)
  local semantics = require "titan-compiler.csemantics"
  local profile, message = semantics.import_profile(data)
  if not profile then return false, tostring(message) end
  local integer = profile.integers["int"].type
  if integer._c_numeric == nil or integer._c_numeric_carriers == nil then
    return false, "embedded C int lost its numeric lowering traits"
  end
  local exported, export_error = semantics.export_profile(profile)
  if not exported then return false, tostring(export_error) end
  return exported.identity == data.identity and
         profile.identity == data.identity and
         integer._c_numeric_carriers.identity == data.identity,
         "embedded target profile identity changed during reconstruction"
end
]], "=embedded_interfaces_target_profile", nil)() as
    function (value): (boolean, string)
  local valid, message = check_profile(provider["target_profile"])
  test.assert(valid, message)
end

function test_unused_http_interface_does_not_load_its_runtime(_context: test.Context)
  local runtime_is_absent = lua.load([[
return function(name)
  return package.preload[name] == nil and package.loaded[name] == nil
end
]], "=embedded_interfaces_unused_runtime", nil)() as function (string): boolean
  -- SQLite is used by the workspace store. HTTP remains an unused runtime
  -- whose metadata must still be available for analysis.
  local names: {string} = {"titan.http"}
  for _, name in iteration.ipairs<|string|>(names) do
    test.assert(runtime_is_absent(name),
                name .. " runtime is unexpectedly linked or loaded")

    local provider = embedded_interfaces.provider()
    local entries: {string: value} = provider["entries"]
    local entry: {string: value} = entries[name]
    local types: string = entry["types"]
    test.assert(#types > 0, name .. " typechecking metadata is missing")
    test.assert(runtime_is_absent(name),
                "reading " .. name .. " metadata registered or loaded its runtime")
  end
end

function test_embedded_interfaces_native_windows_identity_is_complete(_context: test.Context)
  if ffi.VSCODE_TITAN_WINDOWS == 0 then test.skip("native Windows image identity") end
  local provider, first = embedded_interfaces.provider()
  local native: string = first["native_identity"]
  local complete = false
  if strings.sub(native, 1, 13) == "win32-volume:" then
    complete = #native == 73 and strings.sub(native, 30, 30) == "\0" and
               strings.sub(native, 31, 41) == "win32-file:"
  elseif strings.sub(native, 1, 18) == "win32-volume-guid:" then
    complete = #native == 102 and strings.sub(native, 68, 68) == "\0" and
               strings.sub(native, 69, 86) == "win32-legacy-file:"
  end
  test.assert(complete and first["device"] == nil and first["inode"] == nil,
              "embedded Windows image identity lost its complete opaque native ID")
  local nanoseconds: integer = first["modified_nanoseconds"]
  test.assert(nanoseconds % 100 == 0,
              "embedded image timestamp lost native 100ns precision")
  local current = embedded_interfaces.identity()
  local fields = {"path", "size", "kind", "native_identity", "modified_seconds",
                  "modified_nanoseconds"}
  for index = 1, #fields do
    test.assert(current[fields[index]] == first[fields[index]],
                "repeated embedded image identity changed " .. fields[index])
  end
  test.assert(current["path"] == provider["provider_file"],
              "embedded inventory and identity used different mapped images")
end

local function copy_file(source: string, destination: string)
  local input = fs.open(source, "r")
  defer input:close()
  local output = fs.open(destination, "w")
  defer output:close()
  for bytes in input:read do output:write(bytes) end
end

local function with_selected_provider(
    body: function (string, string, string): ())
  local prefix = os.getenv("TITAN_ROOT")
  local folder = fs.tmpname()
  fs.unlink(folder)
  fs.mkdir(folder)
  defer fs.rmdir(folder)
  local basename = "titan.so"
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then basename = "titan.dll" end
  local provider = paths.to_slash(paths.join(folder, "selected é " .. basename))
  copy_file(paths.join(prefix, "lib/titan/0.6/" .. basename), provider)
  defer fs.unlink(provider)
  body(prefix, provider, folder)
end

function test_embedded_provider_helper_transfers_real_interfaces_as_binary(
    _context: test.Context)
  test_runtime.run(function ()
    with_selected_provider(function (prefix: string, provider: string, _: string)
      local source = selected.helper_source()
      local bytes = selected.extract(prefix, provider, source)
      local snapshot = selected.decode(bytes, provider, source)
      test.assert(snapshot["provider_file"] == provider and
                  snapshot["target_profile"] == nil,
                  "helper changed provider path or supplied a build C profile")
      local entries = snapshot["entries"] as {string: value}
      local runtime = embedded_interfaces.provider()
      local runtime_entries = runtime["entries"] as {string: value}
      for name, raw in iteration.pairs<|string, value|>(runtime_entries) do
        local expected = raw as {string: value}
        local actual = entries[name] as {string: value}
        test.assert(actual["types"] == expected["types"],
                    "binary transport changed exact serialized types for " .. name)
      end
      local rejected = false
      do
        selected.decode(bytes .. "garbage", provider, source)
      catch
        rejected = true
      end
      test.assert(rejected, "decoder accepted trailing bytes after a valid inventory")
    end)
  end)
end

function test_embedded_provider_helper_reports_failure_and_retires_cancelled_child(
    _context: test.Context)
  test_runtime.run(function ()
    local prefix = os.getenv("TITAN_ROOT")
    local marker = fs.tmpname()
    defer fs.unlink(marker)
    local rejected = false
    do
      selected.read(prefix, marker)
    catch
      rejected = strings.find(strings.tostring(error), "SDK Lua exited", 1, true) ~= nil
    end
    test.assert(rejected, "an invalid selected native image was not reported as a child failure")

    local slow = [=[
return { extract = function(_, marker, output)
  local file = assert(io.open(marker, "wb"))
  assert(file:write(output))
  assert(file:close())
  while true do end
end }
]=]
    local request = async.run<|nil, value|>(function (): nil
      selected.extract(prefix, marker, slow)
      return nil
    end)
    defer request:cancel(async.CancellationReason.simple("cleanup"))
    local output = ""
    for attempt = 1, 1000 do
      output = fs.read_file(marker)
      if #output > 0 then break end
      timer.sleep(5)
    end
    test.assert(#output > 0, "the owned helper never started")
    request:cancel(async.CancellationReason.simple("cancel selected interfaces"))
    test.assert(request:status():has_finished() == false,
                "cancellation retired an active helper before joining")
    local status = async.join(request)
    test.assert(status:has_cancelled(), "the caller lost its cancellation")
    test.assert(fs.lstat(output) == nil,
                "the helper result was still present after cancellation returned")
  end)
end
