local function rejects_external_change_during_analysis()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    fixture:mkdir("src/app")
    fixture:mkdir("external")
    configure_source_root(fixture)
    fixture:write("src/app/main.titan", "-- app main\n")
    fixture:write("external/main.titan", "-- external one\n")

    local external_main = fixture:path("external/main.titan")
    local analyzer = new_analyzer()
    analyzer.external_main = external_main
    analyzer.external_files = {external_main}
    local resolver = new_resolver()
    resolver.provenance["vendor.source"] =
      compiler_bridge.Provenance.external_source(
        compiler_bridge.SourceProvenance.new(
          external_main, {external_main}))
    local service = require_resolved_service(fixture, analyzer, resolver)
    local before = service:counters()

    fixture:write("src/app/main.titan", "-- app changed\n")
    analyzer.write_during_analysis = external_main
    analyzer.write_during_analysis_contents =
      "-- external changed while compiler result was in flight\n"
    local report?, failure? = service:refresh()
    local after = service:counters()
    local external? = service:external_module("vendor.source")
    test.assert(failure == nil and report ~= nil and report.stale and
                #report.committed_modules == 1 and
                report.committed_modules[1] == "app.main" and
                #report.dirty_modules == 0 and
                after.analysis_runs == before.analysis_runs + 2 and
                after.project_modules_submitted ==
                  before.project_modules_submitted + 2 and
                analyzer.last_cached_count == 0 and external ~= nil and
                external.stamps[1].size ==
                  #"-- external changed while compiler result was in flight\n",
                "compiler-read external identity was paired with a later stamp")
  end)
end

function test_project_service_retries_external_change_during_analysis(
    _context: test.Context)
  test_runtime.run(rejects_external_change_during_analysis)
end

local function isolates_unrelated_dirty_failure()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    configure_source_root(fixture)
    fixture:write("src/a.titan", "-- a valid\n")
    fixture:write("src/b.titan", "-- b valid\n")
    local analyzer = new_analyzer()
    local service = require_service(fixture, analyzer)
    local before = service:counters()

    fixture:write("src/a.titan", "MALFORMED and longer\n")
    fixture:write("src/b.titan", "-- PUBLIC_TWO and longer\n")
    local report?, failure? = service:refresh()
    test.assert(failure == nil and report ~= nil and
                #report.committed_modules == 1 and
                report.committed_modules[1] == "b" and
                #report.failed_modules == 1 and
                report.failed_modules[1] == "a" and
                #report.dirty_modules == 0,
                "failed dirty module was not isolated from unrelated success")
    local snapshot = service:latest()
    local a? = find_project(snapshot, "a")
    local b? = find_project(snapshot, "b")
    test.assert(a ~= nil and project_is_failed(a) and #a.diagnostics == 1 and
                b ~= nil and project_is_clean(b) and #b.diagnostics == 0 and
                b.compiler_snapshot ~= nil and
                b.compiler_snapshot.manifest ~= nil and
                b.compiler_snapshot.manifest.serialized == "public:b:two",
                "partial error publication corrupted the unrelated module")
    local after = service:counters()
    test.assert(after.analysis_runs == before.analysis_runs + 1 and
                after.project_modules_submitted ==
                  before.project_modules_submitted + 2,
                "unrelated failure caused a retry or whole-project resubmission")
  end)
end

function test_project_service_isolates_unrelated_dirty_module_errors(
    _context: test.Context)
  test_runtime.run(isolates_unrelated_dirty_failure)
end

local function attributes_location_free_diagnostics_to_attempted_modules()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    configure_source_root(fixture)
    fixture:write("src/a.titan", "-- first root\n")
    fixture:write("src/b.titan", "-- later root\n")
    local analyzer: project_service.Analyzer =
      function (request: project_service.AnalysisRequest):
          compiler_bridge.Analysis
        local modules: {compiler_bridge.ModuleSnapshot} = {}
        local diagnostics: {compiler_bridge.Diagnostic} = {}
        for index = 1, #request.dirty_modules do
          local name = request.dirty_modules[index]
          local module? = find_bridge_project(request.project_modules, name)
          test.assert(module ~= nil,
                      "owned-diagnostic analyzer lost a project module")
          if module == nil then raise "owned project module is missing" end
          modules[#modules + 1] = failed_project(module, {})
          diagnostics[#diagnostics + 1] = compiler_bridge.Diagnostic.new(
            compiler_bridge.DiagnosticKind.compiler(),
            "cannot load " .. name, nil, name)
        end
        local b? = find_bridge_project(request.project_modules, "b")
        test.assert(b ~= nil,
                    "owned-diagnostic analyzer lost the located module")
        if b == nil then raise "located project module is missing" end
        diagnostics[#diagnostics + 1] = compiler_bridge.Diagnostic.new(
          compiler_bridge.DiagnosticKind.type_error(),
          "located failure in b", location(b), "a")
        return compiler_bridge.Analysis.new(
          request.root_module, diagnostics, modules, {}, {}, {})
      end
    local service?, failure? = test_service.load {
      project_root = fixture.root,
      installed_binary_modules_root = "/sdk/lib/titan/0.6",
      analyzer = analyzer,
      header_restater = restat_test_headers,
    }
    if service ~= nil then fixture.services[#fixture.services + 1] = service end
    test.assert(failure == nil and service ~= nil,
                "owned-diagnostic project did not load")
    if service == nil then raise "owned-diagnostic Service is missing" end
    local a? = find_project(service:latest(), "a")
    local b? = find_project(service:latest(), "b")
    test.assert(a ~= nil and b ~= nil and project_is_failed(a) and
                project_is_failed(b) and #a.diagnostics == 1 and
                #b.diagnostics == 2 and
                a.diagnostics[1].message == "cannot load a" and
                b.diagnostics[1].message == "cannot load b" and
                b.diagnostics[2].message == "located failure in b",
                "diagnostic ownership ignored its attempt or exact location")
  end)
end

function test_project_service_attributes_location_free_diagnostics_to_attempted_modules(
    _context: test.Context)
  test_runtime.run(attributes_location_free_diagnostics_to_attempted_modules)
end

local function failed_fallback_retains_dependency_and_header_inputs()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    fixture:mkdir("include")
    configure_source_root(fixture)
    fixture:write("src/dep.titan", "-- dependency\n")
    fixture:write("src/client.titan", "-- client\n")
    fixture:write("include/value.h", "#define VALUE 1\n")
    local header = fixture:path("include/value.h")
    local analyzer = new_analyzer()
    analyzer.project_header_inputs["client"] = {
      header_input(compiler_bridge.CHeaderDependencyKind.file(), header),
    }
    local service = require_service(fixture, analyzer)
    local initial = service:counters()
    test.assert(#service:direct_imports("client") == 1,
                "clean client did not establish its dependency edge")

    -- Model the bridge fallback used when the loader fails before publishing
    -- its dependency/header frame: the failed snapshot contains neither, but
    -- the service must retain the last authoritative closure.
    analyzer.project_header_inputs["client"] = {}
    fixture:write("src/client.titan", "MALFORMED client revision\n")
    local failed?, failed_error? = service:refresh()
    local failed_client? = find_project(service:latest(), "client")
    test.assert(failed_error == nil and failed ~= nil and
                contains(failed.failed_modules, "client") and
                failed_client ~= nil and project_is_failed(failed_client) and
                #service:direct_imports("client") == 1,
                "fallback failure discarded its previous dependency frame")
    local after_failure = service:counters()

    local unchanged?, unchanged_error? = service:refresh()
    test.assert(unchanged_error == nil and unchanged ~= nil and
                not unchanged.analyzed and
                service:counters().analysis_runs ==
                  after_failure.analysis_runs,
                "unchanged fallback failure re-entered compiler work")

    fixture:write("include/value.h", "#define VALUE 2\n")
    local header_retry?, header_error? = service:refresh()
    local after_header = service:counters()
    test.assert(header_error == nil and header_retry ~= nil and
                contains(header_retry.failed_modules, "client") and
                after_header.analysis_runs ==
                  after_failure.analysis_runs + 1,
                "retained header closure did not retry the failed client")

    fixture:write("src/dep.titan", "-- PUBLIC_TWO dependency\n")
    local dependency_retry?, dependency_error? = service:refresh()
    local after_dependency = service:counters()
    test.assert(dependency_error == nil and dependency_retry ~= nil and
                contains(dependency_retry.committed_modules, "dep") and
                contains(dependency_retry.failed_modules, "client") and
                after_dependency.analysis_runs ==
                  after_header.analysis_runs + 2,
                "retained dependency edge did not retry the failed client")

    analyzer.project_header_inputs["client"] = {
      header_input(compiler_bridge.CHeaderDependencyKind.file(), header),
    }
    fixture:write("src/client.titan", "-- repaired client revision\n")
    local recovered?, recovery_error? = service:refresh()
    local recovered_client? = find_project(service:latest(), "client")
    test.assert(recovery_error == nil and recovered ~= nil and
                contains(recovered.committed_modules, "client") and
                recovered_client ~= nil and project_is_clean(recovered_client) and
                service:counters().analysis_runs ==
                  after_dependency.analysis_runs + 1 and
                initial.analysis_runs == 1,
                "saved repair did not replace the conservative fallback frame")
  end)
end

function test_project_service_retains_failed_fallback_invalidation_inputs(
    _context: test.Context)
  test_runtime.run(failed_fallback_retains_dependency_and_header_inputs)
end

local function rejects_save_completed_during_analysis()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    configure_source_root(fixture)
    fixture:write("src/main.titan", "-- initial\n")
    local analyzer = new_analyzer()
    local service = require_service(fixture, analyzer)
    local before = service:counters()

    fixture:write("src/main.titan", "-- intermediate saved source\n")
    analyzer.write_during_analysis = fixture:path("src/main.titan")
    analyzer.write_during_analysis_contents = "-- PUBLIC_TWO newest save\n"
    local report?, failure? = service:refresh()
    test.assert(failure == nil and report ~= nil and report.stale and
                #report.committed_modules == 1 and
                report.committed_modules[1] == "main" and
                #report.dirty_modules == 0,
                "mid-analysis save was not rejected and retried")
    local main? = find_project(service:latest(), "main")
    test.assert(main ~= nil and
                main.source_files[1].contents ==
                  "-- PUBLIC_TWO newest save\n" and
                main.compiler_snapshot ~= nil and
                main.compiler_snapshot.manifest ~= nil and
                main.compiler_snapshot.manifest.serialized ==
                  "public:main:two",
                "obsolete bytes were published after a mid-analysis save")
    local after = service:counters()
    test.assert(after.file_reads == before.file_reads + 2 and
                after.analysis_runs == before.analysis_runs + 2 and
                after.project_modules_submitted ==
                  before.project_modules_submitted + 2,
                "mid-analysis save did not perform exactly one stale retry")
  end)
end

function test_project_service_restats_saved_inputs_before_publication(
    _context: test.Context)
  test_runtime.run(rejects_save_completed_during_analysis)
end

local function invalidated_inflight_importer_rechecks_once()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    configure_source_root(fixture)
    fixture:write("src/dep.titan", "-- dep one\n")
    fixture:write("src/friend.titan", "-- friend one\n")
    local analyzer = new_analyzer()
    local service = require_service(fixture, analyzer)
    local before = service:counters()
    local checked_before = #analyzer.checked_modules

    fixture:write("src/dep.titan",
                  "-- dep private declaration changed\nSOURCE_TWO\n")
    fixture:write("src/friend.titan", "-- friend implementation changed\n")
    local report?, failure? = service:refresh()
    test.assert(failure == nil and report ~= nil and
                #report.committed_modules == 2 and
                report.committed_modules[1] == "dep" and
                report.committed_modules[2] == "friend" and
                #report.dirty_modules == 0,
                "same-generation importer did not reach a fixed point")
    local after = service:counters()
    test.assert(after.analysis_runs == before.analysis_runs + 2 and
                after.project_modules_submitted ==
                  before.project_modules_submitted + 3 and
                #analyzer.checked_modules == checked_before + 3 and
                analyzer.checked_modules[checked_before + 1] == "dep" and
                analyzer.checked_modules[checked_before + 2] == "friend" and
                analyzer.checked_modules[checked_before + 3] == "friend",
                "invalidated importer token churned or published its old result")
  end)
end

function test_project_service_rechecks_same_generation_invalidated_token_once(
    _context: test.Context)
  test_runtime.run(invalidated_inflight_importer_rechecks_once)
end

local function project_header_edit_delete_and_recovery()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    fixture:mkdir("include")
    configure_source_root(fixture)
    fixture:write("src/dep.titan", "-- dependency\n")
    fixture:write("src/client.titan", "-- ordinary importer\n")
    fixture:write("src/friend.titan", "-- source importer\n")
    fixture:write("src/top.titan", "-- transitive importer\n")
    fixture:write("include/direct.h", "#define DIRECT 1\n")
    fixture:write("include/nested.h", "#define NESTED 1\n")
    local direct = fixture:path("include/direct.h")
    local nested = fixture:path("include/nested.h")
    local analyzer = new_analyzer()
    analyzer.project_header_inputs["dep"] = {
      header_input(compiler_bridge.CHeaderDependencyKind.file(), direct),
      header_input(compiler_bridge.CHeaderDependencyKind.file(), nested),
    }
    local service = require_service(fixture, analyzer)
    local initial = service:counters()

    -- Changed header timestamps trigger content validation and the owner retry.
    fixture:write("include/direct.h", "#define DIRECT 2\n")
    local edited?, edit_error? = service:refresh()
    test.assert(edit_error == nil and edited ~= nil and not edited.stale and
                #edited.committed_modules == 2 and
                edited.committed_modules[1] == "dep" and
                edited.committed_modules[2] == "friend",
                "direct-header edit did not reach exactly its owner and source importer")
    local after_edit = service:counters()
    test.assert(after_edit.file_reads == initial.file_reads and
                after_edit.analysis_runs == initial.analysis_runs + 2 and
                after_edit.project_modules_submitted ==
                  initial.project_modules_submitted + 2,
                "header edit skipped source validation or selected unrelated modules")

    fs.unlink(direct)
    local deleted?, delete_error? = service:refresh()
    local dep_after_delete? = find_project(service:latest(), "dep")
    test.assert(delete_error == nil and deleted ~= nil and
                #deleted.failed_modules == 1 and
                deleted.failed_modules[1] == "dep" and
                dep_after_delete ~= nil and
                project_is_failed(dep_after_delete),
                "direct-header deletion did not publish the current diagnostic")
    fixture:write("include/direct.h", "#define DIRECT 3\n")
    local recovered?, recovery_error? = service:refresh()
    local dep_after_recovery? = find_project(service:latest(), "dep")
    test.assert(recovery_error == nil and recovered ~= nil and
                contains(recovered.committed_modules, "dep") and
                dep_after_recovery ~= nil and
                project_is_clean(dep_after_recovery),
                "direct-header restoration did not recover without a Titan save")

    fs.unlink(nested)
    local nested_deleted?, nested_delete_error? = service:refresh()
    test.assert(nested_delete_error == nil and nested_deleted ~= nil and
                contains(nested_deleted.failed_modules, "dep"),
                "transitive-header deletion did not invalidate its owner")
    fixture:write("include/nested.h", "#define NESTED 2\n")
    local nested_recovered?, nested_recovery_error? = service:refresh()
    test.assert(nested_recovery_error == nil and nested_recovered ~= nil and
                contains(nested_recovered.committed_modules, "dep") and
                service:counters().file_reads == initial.file_reads,
                "transitive-header restoration required a Titan source change")
  end)
end

function test_project_service_restats_direct_and_transitive_headers_through_deletion(
    _context: test.Context)
  test_runtime.run(project_header_edit_delete_and_recovery)
end

local function include_shadow_addition_and_removal()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    fixture:mkdir("early")
    fixture:mkdir("late")
    configure_source_root(fixture)
    fixture:write("src/main.titan", "-- header consumer\n")
    fixture:write("late/value.h", "#define VALUE 1\n")
    local early = fixture:path("early/value.h")
    local late = fixture:path("late/value.h")
    local analyzer = new_analyzer()
    analyzer.project_header_inputs["main"] = {
      header_input(compiler_bridge.CHeaderDependencyKind.search(), early),
      header_input(compiler_bridge.CHeaderDependencyKind.search(), late),
      header_input(compiler_bridge.CHeaderDependencyKind.file(), late),
    }
    local service = require_service(fixture, analyzer)
    local before = service:counters()

    fixture:write("early/value.h", "#define VALUE 2\n")
    analyzer.project_header_inputs["main"] = {
      header_input(compiler_bridge.CHeaderDependencyKind.search(), early),
      header_input(compiler_bridge.CHeaderDependencyKind.file(), early),
    }
    local shadowed?, shadow_error? = service:refresh()
    local selected? = service:project_ast("main")
    test.assert(shadow_error == nil and shadowed ~= nil and
                #shadowed.committed_modules == 1 and selected ~= nil and
                #selected.c_header_dependencies == 2 and
                selected.c_header_dependencies[2].path == early,
                "new earlier include candidate did not replace the old winner")

    fs.unlink(early)
    analyzer.project_header_inputs["main"] = {
      header_input(compiler_bridge.CHeaderDependencyKind.search(), early),
      header_input(compiler_bridge.CHeaderDependencyKind.search(), late),
      header_input(compiler_bridge.CHeaderDependencyKind.file(), late),
    }
    local restored?, restore_error? = service:refresh()
    selected = service:project_ast("main")
    test.assert(restore_error == nil and restored ~= nil and selected ~= nil and
                selected.c_header_dependencies[3].path == late and
                service:counters().file_reads == before.file_reads,
                "removing the earlier shadow did not restore the later winner")
  end)
end

function test_project_service_rechecks_ordered_include_shadow_topology(
    _context: test.Context)
  test_runtime.run(include_shadow_addition_and_removal)
end

local function external_header_invalidation_avoids_cached_interface()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    fixture:mkdir("src/app")
    fixture:mkdir("vendor")
    configure_source_root(fixture)
    fixture:write("src/app/main.titan", "-- external consumer\n")
    fixture:write("vendor/source.titan", "-- external source\n")
    fixture:write("vendor/source.h", "#define EXTERNAL 1\n")
    local source = fixture:path("vendor/source.titan")
    local header = fixture:path("vendor/source.h")
    local analyzer = new_analyzer()
    analyzer.external_main = source
    analyzer.external_files = {source}
    analyzer.external_header_inputs = {
      header_input(compiler_bridge.CHeaderDependencyKind.file(), header),
    }
    local service = require_service(fixture, analyzer)
    test.assert(service:external_module("vendor.source") ~= nil and
                service:project_ast("vendor.source") == nil,
                "initial external metadata retained an AST or lost the module")

    fixture:write("vendor/source.h", "#define EXTERNAL 2\n")
    local edited?, edit_error? = service:refresh()
    local external? = service:external_module("vendor.source")
    test.assert(edit_error == nil and edited ~= nil and
                contains(edited.committed_modules, "app.main") and
                analyzer.last_cached_count == 0 and external ~= nil and
                #external.c_header_dependencies == 1 and
                service:project_ast("vendor.source") == nil,
                "external-header edit reused a stale interface or retained its AST")

    fs.unlink(header)
    local deleted?, delete_error? = service:refresh()
    test.assert(delete_error == nil and deleted ~= nil and
                contains(deleted.failed_modules, "app.main") and
                analyzer.last_cached_count == 0,
                "deleted external header reused the cached interface")
    fixture:write("vendor/source.h", "#define EXTERNAL 3\n")
    local recovered?, recovery_error? = service:refresh()
    test.assert(recovery_error == nil and recovered ~= nil and
                contains(recovered.committed_modules, "app.main") and
                analyzer.last_cached_count == 0 and
                service:project_ast("vendor.source") == nil,
                "external header recovery did not force a current-source analysis")
  end)
end

function test_project_service_invalidates_external_source_header_cache_without_ast(
    _context: test.Context)
  test_runtime.run(external_header_invalidation_avoids_cached_interface)
end

