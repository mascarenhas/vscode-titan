local function preserves_malformed_module_diagnostics()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    configure_source_root(fixture)
    fixture:write("src/good.titan", "-- valid module\n")
    fixture:write("src/bad.titan", "MALFORMED\n")
    local analyzer = new_analyzer()
    local service = require_service(fixture, analyzer)
    local snapshot = service:latest()
    local bad? = find_project(snapshot, "bad")
    local good? = find_project(snapshot, "good")

    test.assert(bad ~= nil and #bad.source_files == 1 and
                bad.source_files[1].contents == "MALFORMED\n",
                "malformed module lost its saved source snapshot")
    test.assert(bad.compiler_snapshot ~= nil and
                bad.compiler_snapshot.manifest == nil and
                #bad.diagnostics == 1 and project_is_failed(bad),
                "failed module snapshot or diagnostic was not preserved")
    test.assert(bad.diagnostics[1].location ~= nil and
                bad.diagnostics[1].location.filename ==
                  fixture:path("src/bad.titan"),
                "failed module diagnostic was assigned to the wrong module")
    test.assert(service:project_ast("bad") == nil,
                "failed project analysis published an annotated cache entry")
    test.assert(good ~= nil and good.compiler_snapshot ~= nil and
                #good.diagnostics == 0 and project_is_clean(good) and
                service:project_ast("good") ~= nil,
                "one malformed module poisoned an unrelated valid module")
    local counters = service:counters()
    test.assert(counters.analysis_runs == 1 and
                counters.project_modules_submitted == 2 and
                #analyzer.checked_modules == 2,
                "error isolation retried or skipped unrelated initial work")
  end)
end

function test_project_service_preserves_failed_module_diagnostics_and_source(
    _context: test.Context)
  test_runtime.run(preserves_malformed_module_diagnostics)
end

local function rejects_omitted_attempted_project_result()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    configure_source_root(fixture)
    fixture:write("src/main.titan", "-- saved project\n")
    local runs = 0
    local service?, create_error? = test_service.create {
      project_root = fixture.root,
      installed_binary_modules_root = "/sdk/lib/titan/0.6",
      analyzer = function (request: project_service.AnalysisRequest):
          compiler_bridge.Analysis
        runs = runs + 1
        return compiler_bridge.Analysis.new(
          request.root_module, {}, {}, {}, {}, {})
      end,
    }
    if service ~= nil then fixture.services[#fixture.services + 1] = service end
    test.assert(create_error == nil and service ~= nil,
                "omitted-result fixture did not initialize")
    if service == nil then raise "omitted-result Service is missing" end

    local report?, refresh_error? = service:refresh()
    local main? = find_project(service:latest(), "main")
    test.assert(report == nil and refresh_error ~= nil and
                strings.find(
                  refresh_error.message,
                  "omitted the attempted project module") ~= nil and
                runs == 1 and main ~= nil and project_is_dirty(main) and
                not project_is_failed(main) and
                #service:latest().dirty_modules == 1,
                "missing compiler output became a current failed revision")
  end)
end

function test_project_service_rejects_omitted_attempted_project_result(
    _context: test.Context)
  test_runtime.run(rejects_omitted_attempted_project_result)
end

local function rejects_stale_generation_commit()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    configure_source_root(fixture)
    fixture:write("src/main.titan", "-- first\n")
    local analyzer = new_analyzer()
    local service?, failure? = test_service.create {
      project_root = fixture.root,
      installed_binary_modules_root = "/sdk/lib/titan/0.6",
      analyzer = analyzer:analyze,
    }
    if service ~= nil then fixture.services[#fixture.services + 1] = service end
    test.assert(failure == nil and service ~= nil,
                "stale-generation fixture did not initialize")
    local request? = service:prepare_work()
    test.assert(request ~= nil, "initial dirty work was not exposed")
    local analysis = analyzer:analyze(request)

    fixture:write("src/main.titan", "-- second generation is longer\n")
    local scanned?, scan_error? = service:scan()
    test.assert(scan_error == nil and scanned ~= nil and
                scanned.generation ~= request.generation,
                "new saved source did not advance the project generation")
    local report?, commit_error? = service:commit(request, analysis)
    test.assert(commit_error == nil and report ~= nil and report.stale,
                "older compiler result was not rejected as stale")
    local latest = service:latest()
    local main? = find_project(latest, "main")
    test.assert(main ~= nil and main.compiler_snapshot == nil and
                project_is_dirty(main) and
                main.source_files[1].contents ==
                  "-- second generation is longer\n",
                "stale result overwrote the newest saved-file generation")
  end)
end

function test_project_service_rejects_stale_generation_before_publication(
    _context: test.Context)
  test_runtime.run(rejects_stale_generation_commit)
end

local function stops_propagation_at_unchanged_manifests()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    configure_source_root(fixture)
    fixture:write("src/dep.titan", "-- dependency body one\n")
    fixture:write("src/client.titan", "-- ordinary importer\n")
    fixture:write("src/friend.titan", "-- source importer\n")
    fixture:write("src/top.titan", "-- transitive importer\n")
    local analyzer = new_analyzer()
    local service = require_service(fixture, analyzer)
    local before = service:counters()
    test.assert(before.file_reads == 4 and before.analysis_runs == 1 and
                before.project_modules_submitted == 4,
                "initial dependency fixture was not analyzed once")

    fixture:write("src/dep.titan",
                  "-- dependency implementation body changed and grew\n")
    local report?, failure? = service:refresh()
    test.assert(failure == nil and report ~= nil and not report.stale,
                "body-only dependency refresh failed")
    test.assert(#report.committed_modules == 1 and
                report.committed_modules[1] == "dep" and
                #report.dirty_modules == 0,
                "body-only edit propagated beyond its provider")
    local after = service:counters()
    test.assert(after.file_reads == before.file_reads + 1,
                "refresh reread a source whose timestamp and physical input were unchanged")
    test.assert(after.analysis_runs == before.analysis_runs + 1 and
                after.project_modules_submitted ==
                  before.project_modules_submitted + 1 and
                analyzer.last_module_count == 4 and
                #analyzer.last_dirty == 1 and
                analyzer.last_dirty[1] == "dep" and
                analyzer.last_cached_count == 0,
                "body-only edit did not analyze exactly dep")
    local checked = analyzer.checked_modules
    test.assert(#checked == 5 and checked[5] == "dep",
                "body-only refresh rechecked an importer")

    fixture:write("src/dep.titan",
                  "-- private declaration changed\nSOURCE_TWO\n")
    local source_report?, source_failure? = service:refresh()
    test.assert(source_failure == nil and source_report ~= nil and
                not source_report.stale and
                #source_report.committed_modules == 2 and
                source_report.committed_modules[1] == "dep" and
                source_report.committed_modules[2] == "friend" and
                #source_report.dirty_modules == 0,
                "source-visible edit selected the wrong importers")
    local after_source = service:counters()
    test.assert(after_source.analysis_runs == after.analysis_runs + 2 and
                after_source.project_modules_submitted ==
                  after.project_modules_submitted + 2 and
                #analyzer.checked_modules == 7 and
                analyzer.checked_modules[6] == "dep" and
                analyzer.checked_modules[7] == "friend" and
                #analyzer.last_dirty == 1 and
                analyzer.last_dirty[1] == "friend",
                "source-visible edit did not stop after the direct source importer")

    fixture:write("src/dep.titan",
                  "-- public declaration changed\nSOURCE_TWO\nPUBLIC_TWO\n")
    local public_report?, public_failure? = service:refresh()
    test.assert(public_failure == nil and public_report ~= nil and
                not public_report.stale and
                #public_report.committed_modules == 3 and
                public_report.committed_modules[1] == "client" and
                public_report.committed_modules[2] == "dep" and
                public_report.committed_modules[3] == "friend" and
                #public_report.dirty_modules == 0,
                "public edit selected the wrong importer set: " ..
                display_names(public_report.committed_modules))
    local after_public = service:counters()
    test.assert(after_public.analysis_runs == after_source.analysis_runs + 2 and
                after_public.project_modules_submitted ==
                  after_source.project_modules_submitted + 3 and
                #analyzer.checked_modules == 10 and
                analyzer.checked_modules[8] == "dep" and
                analyzer.checked_modules[9] == "client" and
                analyzer.checked_modules[10] == "friend" and
                #analyzer.last_dirty == 2 and
                analyzer.last_dirty[1] == "client" and
                analyzer.last_dirty[2] == "friend",
                "public edit did not check both direct importers in one pass")

    local ordinary = service:direct_imports("client")
    local source = service:direct_imports("friend")
    test.assert(#ordinary == 1 and #source == 1,
                "dependency imports disappeared after fixed-point refresh")
    assert_visibility(ordinary[1], false)
    assert_visibility(source[1], true)
    local reverse = service:reverse_imports("friend")
    test.assert(#reverse == 1 and reverse[1].importer == "top",
                "unchanged friend manifest lost its transitive reverse edge")
  end)
end

function test_project_service_reuses_disk_snapshots_and_stops_unchanged_manifest_propagation(
    _context: test.Context)
  test_runtime.run(stops_propagation_at_unchanged_manifests)
end

local function rechecks_real_compiler_source_dependants_selectively()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    configure_source_root(fixture)
    local dependency = [[local function hidden(increment: integer): integer
  return increment + 1
end
function answer(): integer return hidden(41) end
]]
    fixture:write("src/dep.titan", dependency)
    fixture:write("src/client.titan", [[local dep = import "dep"
function run(): integer return dep.answer() end
]])
    fixture:write("src/friend.titan", [[local dep = import "dep.titan"
function run(): integer return dep.hidden(1) end
]])

    local service?, failure? = fixture:load_compiler()
    if service ~= nil then fixture.services[#fixture.services + 1] = service end
    test.assert(failure == nil and service ~= nil,
                "real compiler project fixture did not load")
    local initial = service:latest()
    local initial_dep? = find_project(initial, "dep")
    local initial_client? = find_project(initial, "client")
    local initial_friend? = find_project(initial, "friend")
    test.assert(initial_dep ~= nil and
                initial_dep.compiler_snapshot ~= nil and
                initial_dep.compiler_snapshot.manifest ~= nil and
                initial_dep.compiler_snapshot.manifest.source_serialized ~=
                  nil and
                initial_client ~= nil and
                initial_client.compiler_snapshot ~= nil and
                initial_friend ~= nil and
                initial_friend.compiler_snapshot ~= nil,
                "real compiler fixture lost an initial module snapshot")
    local before = service:counters()

    fixture:write("src/dep.titan", "-- leading comment\n" .. dependency)
    local comment_report?, comment_failure? = service:refresh()
    test.assert(comment_failure == nil and comment_report ~= nil,
                "comment-only real compiler refresh failed")
    local after_comment = service:counters()
    local comment_snapshot = service:latest()
    local comment_dep? = find_project(comment_snapshot, "dep")
    local comment_client? = find_project(comment_snapshot, "client")
    local comment_friend? = find_project(comment_snapshot, "friend")
    test.assert(comment_dep ~= nil and
                comment_dep.compiler_snapshot ~= nil and
                comment_dep.compiler_snapshot.manifest ~= nil and
                comment_dep.compiler_snapshot.manifest.source_serialized ~= nil,
                "comment-only refresh lost the provider source manifest")
    local source_equal =
      comment_dep.compiler_snapshot.manifest.source_serialized ==
        initial_dep.compiler_snapshot.manifest.source_serialized
    test.assert(not comment_report.stale and source_equal and
                #comment_report.committed_modules == 1 and
                comment_report.committed_modules[1] == "dep" and
                #comment_report.dirty_modules == 0,
                "comment-only edit committed " ..
                display_names(comment_report.committed_modules) ..
                " with dirty " ..
                display_names(comment_report.dirty_modules) ..
                "; analysis runs +" ..
                (after_comment.analysis_runs - before.analysis_runs) ..
                "; modules submitted +" ..
                (after_comment.project_modules_submitted -
                  before.project_modules_submitted) ..
                "; source token equal=" .. strings.tostring(source_equal))
    test.assert(after_comment.analysis_runs == before.analysis_runs + 1 and
                after_comment.project_modules_submitted ==
                  before.project_modules_submitted + 1 and
                comment_client ~= nil and
                comment_client.compiler_snapshot ==
                  initial_client.compiler_snapshot and
                comment_friend ~= nil and
                comment_friend.compiler_snapshot ==
                  initial_friend.compiler_snapshot,
                "comment-only edit replaced an unchanged importer snapshot")

    fixture:write("src/dep.titan", [[-- leading comment
local function extra(): integer
  return 0
end
]] .. dependency)
    local private_report?, private_failure? = service:refresh()
    test.assert(private_failure == nil and private_report ~= nil and
                not private_report.stale and
                #private_report.committed_modules == 2 and
                private_report.committed_modules[1] == "dep" and
                private_report.committed_modules[2] == "friend" and
                #private_report.dirty_modules == 0,
                "private-surface edit selected the wrong real compiler importers")
    local after_private = service:counters()
    local private_snapshot = service:latest()
    local private_dep? = find_project(private_snapshot, "dep")
    local private_client? = find_project(private_snapshot, "client")
    local private_friend? = find_project(private_snapshot, "friend")
    test.assert(private_dep ~= nil and
                private_dep.compiler_snapshot ~= nil and
                private_dep.compiler_snapshot.manifest ~= nil and
                private_dep.compiler_snapshot.manifest.source_serialized ~= nil,
                "private-surface refresh lost the provider source manifest")
    test.assert(private_dep.compiler_snapshot.manifest.source_serialized ~=
                  comment_dep.compiler_snapshot.manifest.source_serialized and
                after_private.analysis_runs ==
                  after_comment.analysis_runs + 2 and
                after_private.project_modules_submitted ==
                  after_comment.project_modules_submitted + 2 and
                private_client ~= nil and
                private_client.compiler_snapshot ==
                  initial_client.compiler_snapshot and
                private_friend ~= nil and
                private_friend.compiler_snapshot ~=
                  comment_friend.compiler_snapshot,
                "private-surface edit did not recheck only its source importer")
  end)
end

function test_project_service_uses_real_compiler_source_interfaces_for_selective_rechecking(
    _context: test.Context)
  test_runtime.run(rechecks_real_compiler_source_dependants_selectively)
end

local function publishes_and_recovers_source_serialization_diagnostics()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    configure_source_root(fixture)
    fixture:write("src/main.titan",
      "function answer(): integer return 41 end\n")
    local service?, failure? = fixture:load_compiler()
    if service ~= nil then fixture.services[#fixture.services + 1] = service end
    test.assert(service ~= nil and failure == nil,
                "serialization fixture did not load with valid source")
    test.assert(service:project_ast("main") ~= nil,
                "serialization fixture had no initial semantic snapshot")

    -- Fault injection stays at the external compiler's documented Lua result
    -- boundary. The real checker, bridge and SQL publication run unchanged.
    local driver = lua.require("titan-compiler.driver") as {string: value}
    local serialize = driver["serialize_source_interface"] as
      function (value): (value, value)
    defer driver["serialize_source_interface"] = serialize
    driver["serialize_source_interface"] = function (entry: value): (value, value)
      local raw = entry as {string: value}
      local module_type = raw["type"] as {string: value}
      if module_type["name"] == "main" then
        return nil, "forced source-interface failure"
      end
      return serialize(entry)
    end

    fixture:write("src/main.titan",
      "function answer(): integer return 42 end\n")
    local failed?, failed_error? = service:refresh()
    test.assert(failed ~= nil and failed_error == nil and
                #failed.failed_modules == 1 and failed.failed_modules[1] == "main",
                "serialization error failed the analyzer instead of its source module")
    local invalid? = find_project(service:latest(), "main")
    test.assert(invalid ~= nil and #invalid.diagnostics == 1 and
                invalid.compiler_snapshot ~= nil and
                invalid.compiler_snapshot.manifest == nil and
                service:project_ast("main") == nil,
                "serialization failure kept stale semantics or lost its diagnostic")
    local diagnostic = invalid.diagnostics[1]
    test.assert(diagnostic.location ~= nil and
                diagnostic.location.filename == fixture:path("src/main.titan") and
                diagnostic.location.line == 1 and diagnostic.location.column == 1 and
                diagnostic.owner_module == "main" and
                strings.find(diagnostic.message,
                  "could not serialize source interface for module 'main'") ~= nil and
                strings.find(diagnostic.message, "forced source-interface failure") ~= nil,
                "serialization diagnostic lost its source attribution or error detail")
    case diagnostic.kind
    when compiler() then
    else test.assert(false, "serialization failure used the wrong diagnostic kind")
    end

    driver["serialize_source_interface"] = serialize
    fixture:write("src/main.titan",
      "function answer(): integer return 43 end\n")
    local recovered?, recovery_error? = service:refresh()
    local repaired? = find_project(service:latest(), "main")
    test.assert(recovered ~= nil and recovery_error == nil and
                #recovered.failed_modules == 0 and #recovered.committed_modules == 1 and
                repaired ~= nil and #repaired.diagnostics == 0 and
                repaired.compiler_snapshot ~= nil and
                repaired.compiler_snapshot.manifest ~= nil and
                service:project_ast("main") ~= nil,
                "a later saved edit did not clear serialization diagnostics and restore semantics")
  end)
end

function test_project_service_publishes_and_recovers_source_serialization_diagnostics(
    _context: test.Context)
  test_runtime.run(publishes_and_recovers_source_serialization_diagnostics)
end

local function analyzes_source_qualified_modules_from_narrow_watch_root()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("titan")
    fixture:mkdir("titan/uv")
    fixture:write("titan-config.lua", [[
include = { "titan" }
source_module_roots = { "." }
]])
    fixture:write("titan/uv/uv.titan", [[function answer(): integer
  return private_answer()
end
]])
    fixture:write("titan/uv/task.titan", [[local function private_answer(): integer
  return 42
end
]])
    fixture:write("titan/async.titan", [[local uv = import "uv.titan"
function answer(): integer return uv.private_answer() end
]])

    local service?, failure? = fixture:load_compiler()
    if service ~= nil then fixture.services[#fixture.services + 1] = service end
    local detail = ""
    if failure ~= nil then detail = ": " .. failure.message end
    test.assert(failure == nil and service ~= nil,
                "real compiler rejected source-root project identity" .. detail)
    local snapshot = service:latest()
    local async_module? = find_project(snapshot, "titan.async")
    local uv? = find_project(snapshot, "titan.uv")
    test.assert(#snapshot.project_modules == 2 and
                async_module ~= nil and
                async_module.compiler_snapshot ~= nil and
                uv ~= nil and uv.compiler_snapshot ~= nil and
                find_project(snapshot, "async") == nil and
                find_project(snapshot, "uv") == nil,
                "real compiler catalog retained include-relative identities")
  end)
end

function test_project_service_real_compiler_matches_divergent_watch_and_source_roots(
    _context: test.Context)
  test_runtime.run(analyzes_source_qualified_modules_from_narrow_watch_root)
end

local function revalidates_external_source_when_encountered_again()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    fixture:mkdir("src/app")
    fixture:mkdir("external")
    configure_source_root(fixture)
    fixture:write("src/app/main.titan", "-- app main imports external\n")
    fixture:write("external/main.titan", "-- external one\n")
    fixture:write("external/part.titan", "-- external part\n")
    local analyzer = new_analyzer()
    analyzer.external_main = fixture:path("external/main.titan")
    analyzer.external_files = {
      fixture:path("external/main.titan"),
      fixture:path("external/part.titan"),
    }
    local service = require_service(fixture, analyzer)
    local before = service:counters()
    local old_external? = service:external_module("vendor.source")
    test.assert(old_external ~= nil and #old_external.stamps == 2,
                "initial external source metadata was absent")

    fixture:write("external/part.titan",
                  "-- external part changed with a longer body\n")
    local report?, failure? = service:refresh()
    test.assert(failure == nil and report ~= nil and report.analyzed and
                not report.stale,
                "external mtime change did not schedule a project refresh")
    local after = service:counters()
    test.assert(after.file_reads == before.file_reads and
                after.analysis_runs == before.analysis_runs + 1 and
                analyzer.last_cached_count == 0,
                "external revalidation did not validate saved sources and analyze once")
    local updated? = service:external_module("vendor.source")
    test.assert(updated ~= nil and #updated.stamps == 2 and
                updated.stamps[2].size ~= old_external.stamps[2].size,
                "encountered external source did not refresh all file stamps")
    test.assert(service:project_ast("vendor.source") == nil,
                "external revalidation retained compiler semantic nodes")

    fixture:write("src/app/main.titan",
                  "-- unrelated saved app edit after external refresh\n")
    local cached_report?, cached_failure? = service:refresh()
    test.assert(cached_failure == nil and cached_report ~= nil and
                not cached_report.stale and
                analyzer.last_cached_count == 1,
                "freshly reanalyzed external source did not become cacheable")
  end)
end

function test_project_service_revalidates_external_mtimes_without_external_asts(
    _context: test.Context)
  test_runtime.run(revalidates_external_source_when_encountered_again)
end

local function revalidates_transitive_external_dependency()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    fixture:mkdir("src/app")
    fixture:mkdir("external")
    configure_source_root(fixture)
    fixture:write("src/app/main.titan", "-- app main\n")
    fixture:write("external/outer.titan", "-- outer\n")
    fixture:write("external/inner.titan", "-- inner one\n")
    local analyzer = new_analyzer()
    analyzer.external_main = fixture:path("external/outer.titan")
    analyzer.external_files = {fixture:path("external/outer.titan")}
    analyzer.external_dependency_main = fixture:path("external/inner.titan")
    analyzer.external_dependency_files = {fixture:path("external/inner.titan")}
    local service = require_service(fixture, analyzer)
    local before = service:counters()

    fixture:write("external/inner.titan",
                  "-- inner changed with a longer body\n")
    local report?, failure? = service:refresh()
    test.assert(failure == nil and report ~= nil and report.analyzed and
                #report.committed_modules == 1 and
                report.committed_modules[1] == "app.main" and
                #report.dirty_modules == 0,
                "transitive external change did not recheck its project root")
    local after = service:counters()
    test.assert(after.file_reads == before.file_reads and
                after.analysis_runs == before.analysis_runs + 1 and
                after.project_modules_submitted ==
                  before.project_modules_submitted + 1 and
                analyzer.last_cached_count == 1,
                "transitive external refresh did not validate sources or rechecked unrelated modules")
    local inner? = service:external_module("vendor.inner")
    test.assert(inner ~= nil and
                inner.stamps[1].size ==
                  #"-- inner changed with a longer body\n" and
                service:project_ast("vendor.inner") == nil,
                "transitive external metadata was not refreshed narrowly")
  end)
end

function test_project_service_invalidates_through_external_dependency_chain(
    _context: test.Context)
  test_runtime.run(revalidates_transitive_external_dependency)
end

local function rekeys_externals_after_any_config_change()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    fixture:mkdir("src/app")
    fixture:mkdir("external")
    fixture:mkdir("include")
    configure_source_root(fixture)
    fixture:write("src/app/main.titan", "-- app main\n")
    fixture:write("external/main.titan", "-- external main\n")

    local external_main = fixture:path("external/main.titan")
    local analyzer = new_analyzer()
    analyzer.external_main = external_main
    analyzer.external_files = {external_main}
    local resolver = new_resolver()
    resolver.provenance["vendor.source"] =
      compiler_bridge.Provenance.external_source(
        compiler_bridge.SourceProvenance.new(
          external_main, {external_main}))
    local service = require_resolved_service(fixture, analyzer, resolver)
    local before = service:counters()

    fixture:write("titan-config.lua", [[
include = { "src" }
binary_modules_root = "binary-modules"
extra_ffi_include_dirs = { "include" }
]])
    local report?, failure? = service:refresh()
    test.assert(failure == nil and report ~= nil and report.stale and
                #report.committed_modules == 1 and
                report.committed_modules[1] == "app.main" and
                analyzer.last_cached_count == 0,
                "configuration change reused an external source interface")
    local after = service:counters()
    test.assert(after.analysis_runs == before.analysis_runs + 2 and
                after.project_modules_submitted ==
                  before.project_modules_submitted + 2 and
                service:external_module("vendor.source") ~= nil,
                "configuration change did not re-key and republish externals")
  end)
end

function test_project_service_clears_external_cache_on_any_config_change(
    _context: test.Context)
  test_runtime.run(rekeys_externals_after_any_config_change)
end

local function configuration_change_recovers_failed_revision()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    fixture:mkdir("include")
    configure_source_root(fixture)
    fixture:write("titan-config.lua", [[
include = { "src" }
binary_modules_root = "binary-modules"
extra_ffi_include_dirs = { "include" }
extra_ffi_cppflags = "-DPROJECT_SERVICE_FFI=0"
]])
    fixture:write("src/main.titan", "-- configuration-dependent module\n")
    local runs = 0
    local analyzer: project_service.Analyzer =
      function (request: project_service.AnalysisRequest):
          compiler_bridge.Analysis
        runs = runs + 1
        local module? = find_bridge_project(
          request.project_modules, request.root_module)
        test.assert(module ~= nil,
                    "configuration analyzer lost its project root")
        if module == nil then raise "configuration project is absent" end
        local configured = #request.config.extra_ffi_include_dirs == 1 and
          request.config.extra_ffi_cppflags == "-DPROJECT_SERVICE_FFI=1"
        local manifest?: compiler_bridge.Manifest = nil
        local diagnostics: {compiler_bridge.Diagnostic} = {}
        if configured then
          manifest = compiler_bridge.Manifest.new(
            "main", "main-public", "main-source")
        else
          diagnostics[1] = compiler_bridge.Diagnostic.new(
            compiler_bridge.DiagnosticKind.type_error(),
            "required include directory is not configured", location(module))
        end
        return compiler_bridge.Analysis.new(
          request.root_module, diagnostics, {
            compiler_bridge.ModuleSnapshot.new(
              module.module_name, project_provenance(module), manifest,
              {}, {}, {}, {}, nil, nil),
          }, {}, {}, {})
      end
    local service?, load_error? = test_service.load {
      project_root = fixture.root,
      installed_binary_modules_root = "/sdk/lib/titan/0.6",
      analyzer = analyzer,
    }
    if service ~= nil then fixture.services[#fixture.services + 1] = service end
    test.assert(load_error == nil and service ~= nil,
                "configuration recovery fixture did not load")
    if service == nil then raise "configuration recovery Service is absent" end
    local initial? = find_project(service:latest(), "main")
    test.assert(runs == 1 and initial ~= nil and project_is_failed(initial) and
                #service:latest().dirty_modules == 0,
                "configuration-dependent diagnostic remained pending work")

    local unchanged?, unchanged_error? = service:refresh()
    test.assert(unchanged_error == nil and unchanged ~= nil and
                not unchanged.analyzed and runs == 1,
                "unchanged configuration retried the failed revision")

    fixture:write("titan-config.lua", [[
include = { "src" }
binary_modules_root = "binary-modules"
extra_ffi_include_dirs = { "include" }
extra_ffi_cppflags = "-DPROJECT_SERVICE_FFI=1"
]])
    local recovered?, recovery_error? = service:refresh()
    local current? = find_project(service:latest(), "main")
    test.assert(recovery_error == nil and recovered ~= nil and
                recovered.analyzed and #recovered.committed_modules == 1 and
                recovered.committed_modules[1] == "main" and runs == 2 and
                current ~= nil and project_is_clean(current),
                "configuration change did not recover the failed revision")
  end)
end

function test_project_service_retries_failed_revision_after_configuration_change(
    _context: test.Context)
  test_runtime.run(configuration_change_recovers_failed_revision)
end

local function detects_external_provider_and_folder_topology_changes()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    fixture:mkdir("src/app")
    fixture:mkdir("external")
    fixture:mkdir("binary-modules")
    configure_source_root(fixture)
    fixture:write("src/app/main.titan", "-- app main\n")
    fixture:write("src/other.titan", "-- unrelated\n")
    fixture:write("external/main.titan", "-- external main\n")
    fixture:write("binary-modules/first.so", "first provider")
    fixture:write("binary-modules/second.so", "second provider")

    local external_main = fixture:path("external/main.titan")
    local first = fixture:path("binary-modules/first.so")
    local second = fixture:path("binary-modules/second.so")
    local analyzer = new_analyzer()
    analyzer.external_main = external_main
    analyzer.external_files = {external_main}
    analyzer.binary_file = first
    local resolver = new_resolver()
    resolver.provenance["vendor.source"] =
      compiler_bridge.Provenance.external_source(
        compiler_bridge.SourceProvenance.new(
          external_main, {external_main}))
    resolver.provenance["vendor.binary"] =
      compiler_bridge.Provenance.dynamic_binary(
        compiler_bridge.BinaryProvenance.new(first))
    local service = require_resolved_service(fixture, analyzer, resolver)
    local before = service:counters()

    -- No old provider file changed: only exact resolution precedence selects
    -- the new physical provider.
    analyzer.binary_file = second
    resolver.provenance["vendor.binary"] =
      compiler_bridge.Provenance.dynamic_binary(
        compiler_bridge.BinaryProvenance.new(second))
    local switched?, switch_error? = service:refresh()
    local after_switch = service:counters()
    local binary? = service:external_module("vendor.binary")
    test.assert(switch_error == nil and switched ~= nil and
                not switched.stale and
                #switched.committed_modules == 1 and
                switched.committed_modules[1] == "app.main" and
                after_switch.analysis_runs == before.analysis_runs + 1 and
                after_switch.project_modules_submitted ==
                  before.project_modules_submitted + 1 and
                binary ~= nil,
                "new external provider did not narrowly recheck its consumer")
    case binary.origin
    when dynamic_binary(origin) then
      test.assert(origin.provider_file == second,
                  "external provider switch retained the old identity")
    else test.assert(false, "dynamic provider changed provenance kind")
    end

    fixture:write("external/part.titan", "-- new constituent\n")
    local part = fixture:path("external/part.titan")
    analyzer.external_files = {external_main, part}
    resolver.provenance["vendor.source"] =
      compiler_bridge.Provenance.external_source(
        compiler_bridge.SourceProvenance.new(
          external_main, {external_main, part}))
    local added?, add_error? = service:refresh()
    local after_add = service:counters()
    local source? = service:external_module("vendor.source")
    test.assert(add_error == nil and added ~= nil and not added.stale and
                after_add.analysis_runs == after_switch.analysis_runs + 1 and
                after_add.project_modules_submitted ==
                  after_switch.project_modules_submitted + 1 and
                source ~= nil and #source.stamps == 2,
                "new folder constituent was invisible to topology validation")

    fs.unlink(part)
    analyzer.external_files = {external_main}
    resolver.provenance["vendor.source"] =
      compiler_bridge.Provenance.external_source(
        compiler_bridge.SourceProvenance.new(
          external_main, {external_main}))
    local removed?, remove_error? = service:refresh()
    local after_remove = service:counters()
    source = service:external_module("vendor.source")
    test.assert(remove_error == nil and removed ~= nil and
                not removed.stale and
                after_remove.analysis_runs == after_add.analysis_runs + 1 and
                after_remove.project_modules_submitted ==
                  after_add.project_modules_submitted + 1 and
                source ~= nil and #source.stamps == 1,
                "removed folder constituent retained a stale cache identity")
  end)
end

function test_project_service_resolves_provider_and_folder_topology_exactly(
    _context: test.Context)
  test_runtime.run(detects_external_provider_and_folder_topology_changes)
end

local function invalidates_a_compiled_facade_when_its_contextual_owner_moves()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    fixture:mkdir("src/app")
    fixture:mkdir("binary-modules")
    configure_source_root(fixture)
    fixture:write("src/app/main.titan", "-- compiled facade consumer\n")
    fixture:write("src/other.titan", "-- unrelated project\n")
    fixture:write("binary-modules/facade.so", "compiled facade")
    fixture:write("binary-modules/owner-one.so", "first owner provider")
    fixture:write("binary-modules/owner-two.so", "second owner provider")

    local facade = fixture:path("binary-modules/facade.so")
    local first_owner = fixture:path("binary-modules/owner-one.so")
    local second_owner = fixture:path("binary-modules/owner-two.so")
    local analyzer = new_analyzer()
    analyzer.binary_file = facade
    analyzer.contextual_owner_file = first_owner
    local resolver = new_resolver()
    resolver.provenance["vendor.binary"] =
      compiler_bridge.Provenance.dynamic_binary(
        compiler_bridge.BinaryProvenance.new(facade))
    resolver.provenance["vendor.owner"] =
      compiler_bridge.Provenance.dynamic_binary(
        compiler_bridge.BinaryProvenance.new(first_owner))
    local service = require_resolved_service(fixture, analyzer, resolver)

    local facade_imports = service:direct_imports("vendor.binary")
    test.assert(#facade_imports == 1 and
                facade_imports[1].module_name == "vendor.owner" and
                service:external_module("vendor.owner") == nil,
                "contextual owner became ordinary cached module state")
    local before = service:counters()

    -- The facade file and project are unchanged. Replacing only the ordinary
    -- interface provider used for contextual owner recovery must traverse the
    -- metadata-only owner -> facade -> project reverse path.
    analyzer.contextual_owner_file = second_owner
    resolver.provenance["vendor.owner"] =
      compiler_bridge.Provenance.dynamic_binary(
        compiler_bridge.BinaryProvenance.new(second_owner))
    local report?, failure? = service:refresh()
    local after = service:counters()
    test.assert(failure == nil and report ~= nil and not report.stale and
                #report.committed_modules == 1 and
                report.committed_modules[1] == "app.main" and
                after.analysis_runs == before.analysis_runs + 1 and
                after.project_modules_submitted ==
                  before.project_modules_submitted + 1 and
                contains(resolver.requested, "vendor.owner"),
                "contextual owner provider replacement left facade semantics stale")
    test.assert(service:external_module("vendor.owner") == nil and
                #service:direct_imports("vendor.binary") == 1,
                "contextual owner leaked into ordinary external module cache")
  end)
end

function test_project_service_tracks_contextual_owner_provider_replacement(
    _context: test.Context)
  test_runtime.run(
    invalidates_a_compiled_facade_when_its_contextual_owner_moves)
end

local function missing_provider_appearance_recovers_failed_revision()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    fixture:mkdir("src/app")
    fixture:mkdir("binary-modules")
    configure_source_root(fixture)
    fixture:write("src/app/main.titan", "-- binary consumer\n")
    local provider = fixture:path("binary-modules/provider.so")
    local available = false
    local runs = 0
    local analyzer: project_service.Analyzer =
      function (request: project_service.AnalysisRequest):
          compiler_bridge.Analysis
        runs = runs + 1
        local module? = find_bridge_project(
          request.project_modules, request.root_module)
        test.assert(module ~= nil,
                    "missing-provider analyzer lost its project root")
        if module == nil then raise "missing provider project is absent" end
        local imports = {
          one_import(module, "binary", "vendor.binary", false),
        }
        local project_manifest?: compiler_bridge.Manifest = nil
        local diagnostics: {compiler_bridge.Diagnostic} = {}
        if available then
          project_manifest = compiler_bridge.Manifest.new(
            "app.main", "app-public", "app-source")
        else
          diagnostics[1] = compiler_bridge.Diagnostic.new(
            compiler_bridge.DiagnosticKind.type_error(),
            "cannot resolve vendor.binary", location(module))
        end
        local modules: {compiler_bridge.ModuleSnapshot} = {
          compiler_bridge.ModuleSnapshot.new(
            module.module_name, project_provenance(module), project_manifest,
            {}, {}, imports, {}, nil, nil),
        }
        local binary_observations:
          {compiler_bridge.BinaryProviderObservation} = {}
        if available then
          local provider_identity? = observed_provider_identity(provider)
          modules[2] = compiler_bridge.ModuleSnapshot.new(
            "vendor.binary",
            compiler_bridge.Provenance.dynamic_binary(
              compiler_bridge.BinaryProvenance.new(provider)),
            compiler_bridge.Manifest.new(
              "vendor.binary", "binary-public", nil),
            {}, {}, {}, {}, nil, provider_identity)
          binary_observations[1] =
            compiler_bridge.BinaryProviderObservation.new(
              "vendor.binary", "dynamic", provider, provider_identity)
        end
        return compiler_bridge.Analysis.new(
          request.root_module, diagnostics, modules, {},
          binary_observations, {})
      end
    local resolver = new_resolver()
    local service?, load_error? =
      test_service.load {
        project_root = fixture.root,
        installed_binary_modules_root = "/sdk/lib/titan/0.6",
        analyzer = analyzer,
        external_resolver = resolver:resolve,
        header_restater = restat_test_headers,
      }
    if service ~= nil then fixture.services[#fixture.services + 1] = service end
    test.assert(load_error == nil and service ~= nil,
                "missing-provider fixture did not load a partial project")
    if service == nil then raise "missing-provider Service is absent" end
    local initial? = find_project(service:latest(), "app.main")
    test.assert(runs == 1 and initial ~= nil and project_is_failed(initial) and
                #service:latest().dirty_modules == 0 and
                #service:direct_imports("app.main") == 1,
                "initial missing provider remained dirty or lost its import")

    local unchanged?, unchanged_error? = service:refresh()
    test.assert(unchanged_error == nil and unchanged ~= nil and
                not unchanged.analyzed and runs == 1,
                "unchanged missing provider retried its failed importer")

    fixture:write("binary-modules/provider.so", "available provider")
    resolver.provenance["vendor.binary"] =
      compiler_bridge.Provenance.dynamic_binary(
        compiler_bridge.BinaryProvenance.new(provider))
    available = true
    local recovered?, recovery_error? = service:refresh()
    local current? = find_project(service:latest(), "app.main")
    test.assert(recovery_error == nil and recovered ~= nil and
                not recovered.stale and
                #recovered.committed_modules == 1 and
                recovered.committed_modules[1] == "app.main" and
                runs == 2 and current ~= nil and project_is_clean(current) and
                service:external_module("vendor.binary") ~= nil,
                "new external provider did not recover the failed importer")
  end)
end

function test_project_service_recovers_failed_importer_when_missing_provider_appears(
    _context: test.Context)
