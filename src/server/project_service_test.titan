function test_project_service_uses_accepted_configuration_until_the_next_scan(
    _context: test.Context)
  test_runtime.run(function ()
    with_fixture(function (fixture: Fixture)
      fixture:mkdir("first")
      fixture:mkdir("second")
      fixture:write("first/initial.titan", "-- initial saved source\n")
      fixture:write("second/replacement.titan", "-- replacement saved source\n")
      fixture:write("titan-config.lua",
        'include = { "first" }\nsource_module_roots = { "first" }\n')
      local accepted?, config_error? = project_config.load(
        fixture.root, "/sdk/lib/titan/0.6")
      test.assert(accepted ~= nil and config_error == nil,
        "initial configuration did not load")
      fixture:write("titan-config.lua",
        'include = { "second" }\nsource_module_roots = { "second" }\n')
      local analyzer = new_analyzer()
      local service?, failure? = project_service.create {
        settings = accepted,
        installed_binary_modules_root = "/sdk/lib/titan/0.6",
        analyzer = analyzer:analyze,
      }
      if service ~= nil then fixture.services[#fixture.services + 1] = service end
      test.assert(service ~= nil and failure == nil,
        "service rejected the accepted configuration")
      accepted.include[1] = fixture:path("second")
      local initial = service:latest()
      test.assert(initial.config.include[1] == fixture:path("first") and
        #initial.project_modules == 1 and
        initial.project_modules[1].module_name == "initial",
        "construction reloaded or aliased its accepted configuration")
      local current?, scan_error? = service:scan()
      test.assert(current ~= nil and scan_error == nil and
        current.config.include[1] == fixture:path("second") and
        #current.project_modules == 1 and
        current.project_modules[1].module_name == "replacement",
        "the next scan did not load the current saved configuration")
    end)
  end)
end

function test_project_service_preserves_sqlite_failure_details_and_caller_store(
    _context: test.Context)
  test_runtime.run(function ()
    with_fixture(function (fixture: Fixture)
      fixture:mkdir("src")
      local store = stores.open(":memory:")
      defer store:close()
      local access = store:acquire()
      defer access:release()
      stores.execute(access.connection, "CREATE TABLE main.graph_modules(bad INTEGER)")
      access:release()
      local analyzer = new_analyzer()
      local service?, failure? = test_service.create {
        project_root = fixture.root,
        installed_binary_modules_root = "/sdk/lib/titan/0.6",
        analyzer = analyzer:analyze,
        store = store,
      }
      test.assert(service == nil and failure ~= nil and
        strings.find(failure.message, "no such column") ~= nil and
        strings.find(failure.message, "metatable") == nil,
        "constructor replaced SQLite's diagnostic with an opaque record label")
      local retained = store:acquire()
      defer retained:release()
      test.assert(stores.scalar_integer(retained.connection, "SELECT 1") == 1,
        "failed construction closed the caller's Store")
    end)
  end)
end

function test_project_service_trusts_unchanged_saved_source_observations(
    _context: test.Context)
  test_runtime.run(function ()
    with_fixture(function (fixture: Fixture)
      fixture:mkdir("src")
      configure_source_root(fixture)
      fixture:write("src/main.titan", "-- body one\n")
      local path = fixture:path("src/main.titan")
      fixed_modified_time(path)
      local analyzer = new_analyzer()
      local service = require_service(fixture, analyzer)
      local before = service:latest()
      local previous = before.project_modules[1].source_files[1]
      local counters = service:counters()
      fixture:write("src/main.titan", "-- body two\n")
      fixed_modified_time(path)
      local report?, failure? = service:refresh()
      local after = service:latest()
      local current = after.project_modules[1].source_files[1]
      test.assert(failure == nil and report ~= nil and not report.analyzed and
        #report.committed_modules == 0 and service:counters().file_reads == counters.file_reads,
        "unchanged timestamps unexpectedly read or hashed the saved source")
      test.assert(previous.stamp.modified_seconds == current.stamp.modified_seconds and
        previous.stamp.modified_nanoseconds == current.stamp.modified_nanoseconds and
        previous.stamp.size == current.stamp.size and
        previous.stamp.identity == current.stamp.identity and
        current.contents == "-- body one\n",
        "unchanged metadata did not preserve its previously certified source bytes")
      set_modified_time(path, 1700000001)
      local changed?, change_error? = service:refresh()
      current = service:latest().project_modules[1].source_files[1]
      test.assert(change_error == nil and changed ~= nil and changed.analyzed and
        #changed.committed_modules == 1 and changed.committed_modules[1] == "main" and
        current.contents == "-- body two\n" and current.stamp.identity ~= previous.stamp.identity and
        service:counters().file_reads == counters.file_reads + 1,
        "changed timestamp did not validate and publish the current saved bytes once")
    end)
  end)
end

function test_project_service_same_content_external_touch_preserves_cached_interfaces(
    _context: test.Context)
  test_runtime.run(function ()
    for mode = 1, 2 do
      with_fixture(function (fixture: Fixture)
        fixture:mkdir("src")
        fixture:mkdir("src/app")
        fixture:mkdir("external")
        configure_source_root(fixture)
        fixture:write("src/app/main.titan", "-- app main\n")
        fixture:write("external/main.titan", "-- external source\n")
        local path = fixture:path("external/main.titan")
        fixed_modified_time(path)
        local analyzer = new_analyzer()
        analyzer.external_main = path
        analyzer.external_files = {path}
        local service: project_service.Service?
        if mode == 1 then
          service = require_service(fixture, analyzer)
        else
          local resolver = new_resolver()
          resolver.provenance["vendor.source"] = compiler_bridge.Provenance.external_source(
            compiler_bridge.SourceProvenance.new(path, {path}))
          service = require_resolved_service(fixture, analyzer, resolver)
        end
        if service == nil then raise "external touch fixture Service is missing" end
        local before = service:counters()
        local generation = service:latest().generation
        local revision = work_revision(service, "app.main")
        local ast? = service:project_ast("app.main")
        local external? = service:external_module("vendor.source")
        test.assert(external ~= nil, "external touch fixture has no accepted metadata")
        local unchanged?, unchanged_error? = service:refresh()
        test.assert(unchanged ~= nil and unchanged_error == nil and not unchanged.analyzed and
          service:counters().file_reads == before.file_reads and
          service:counters().external_file_reads == before.external_file_reads and
          service:counters().external_file_hashes == before.external_file_hashes,
          "unchanged external validation read or hashed source content")
        set_modified_time(path, 1700000001)
        local touched?, touch_error? = service:refresh()
        local current? = service:external_module("vendor.source")
        local after = service:counters()
        test.assert(touched ~= nil and touch_error == nil and not touched.analyzed and
          current ~= nil and current.stamps[1].modified_seconds == 1700000001 and
          current.stamps[1].identity == external.stamps[1].identity and
          current.analyzed_input_identity == external.analyzed_input_identity and
          service:latest().generation == generation and work_revision(service, "app.main") == revision and
          service:project_ast("app.main") == ast and after.file_reads == before.file_reads and
          after.external_file_reads == before.external_file_reads + 1 and
          after.external_file_hashes == before.external_file_hashes + 1,
          "same-content external touch invalidated semantics or failed to refresh its observation once")
        local repeated?, repeated_error? = service:refresh()
        test.assert(repeated ~= nil and repeated_error == nil and not repeated.analyzed and
          service:counters().external_file_reads == after.external_file_reads and
          service:counters().external_file_hashes == after.external_file_hashes,
          "refreshed external observation was read again on the next pass")
        fixture:write("src/app/main.titan", "-- app main changed body\n")
        local edited?, edit_error? = service:refresh()
        test.assert(edited ~= nil and edit_error == nil and edited.analyzed and
          analyzer.last_cached_count == 1 and
          service:counters().external_file_reads == after.external_file_reads,
          "harmless external touch revoked its cached source interface on a later importer edit")
      end)
    end
  end)
end

function test_project_service_same_timestamp_physical_replacement_reads_fresh_source(
    _context: test.Context)
  test_runtime.run(function ()
    with_fixture(function (fixture: Fixture)
      fixture:mkdir("src")
      configure_source_root(fixture)
      fixture:write("src/main.titan", "-- identical bytes\n")
      local path = fixture:path("src/main.titan")
      fixed_modified_time(path)
      local analyzer = new_analyzer()
      local service = require_service(fixture, analyzer)
      local before = service:counters()
      local previous = service:latest().project_modules[1].source_files[1].stamp
      fixture:write("replacement.titan", "-- identical bytes\n")
      local replacement = fixture:path("replacement.titan")
      fixed_modified_time(replacement)
      fs.rename(replacement, path)
      local report?, failure? = service:refresh()
      local current = service:latest().project_modules[1].source_files[1].stamp
      test.assert(report ~= nil and failure == nil and report.analyzed and
        service:counters().file_reads == before.file_reads + 1 and
        service:counters().file_hashes == before.file_hashes + 1 and
        previous.identity == current.identity and
        previous.modified_seconds == current.modified_seconds and
        previous.modified_nanoseconds == current.modified_nanoseconds and
        previous.physical_identity ~= current.physical_identity,
        "same-timestamp physical replacement reused the previous input observation")
    end)
  end)
end

function test_project_service_keeps_reads_available_during_analysis_and_drains_close(
    _context: test.Context)
  test_runtime.run(function ()
    with_fixture(function (fixture: Fixture)
      fixture:mkdir("src")
      configure_source_root(fixture)
      fixture:write("src/main.titan", "-- body one\n")
      local started, await_started, close_started = async.channel<|boolean|>(1)
      defer close_started()
      local resume, await_resume, close_resume = async.channel<|boolean|>(1)
      defer close_resume()
      local block = false
      local recorder = new_analyzer()
      local analyzer: project_service.Analyzer = function (
          request: project_service.AnalysisRequest): compiler_bridge.Analysis
        if block then
          started(true)
          await_resume()
        end
        return recorder:analyze(request)
      end
      local service?, failure? = test_service.load {
        project_root = fixture.root,
        installed_binary_modules_root = "/sdk/lib/titan/0.6",
        analyzer = analyzer,
      }
      if service ~= nil then fixture.services[#fixture.services + 1] = service end
      test.assert(service ~= nil and failure == nil, "drain fixture did not load")
      if service == nil then raise "drain fixture Service is missing" end
      fixture:write("src/main.titan", "-- body two\n")
      local scanned?, scan_error? = service:scan()
      test.assert(scanned ~= nil and scan_error == nil, "drain fixture scan failed")
      local request? = service:prepare_work()
      test.assert(request ~= nil, "saved edit did not prepare analysis")
      block = true
      local worker = async.run<|nil, value|>(function (): nil
        local report?, commit_error? = service:analyze(request)
        test.assert(report ~= nil and commit_error == nil and
          #report.committed_modules == 1, "accepted analysis failed while close waited")
        return nil
      end)
      await_started()
      -- This read would deadlock if compiler work retained the SQLite lease.
      local during = service:latest()
      test.assert(#during.project_modules == 1 and
        during.project_modules[1].compiler_snapshot ~= nil,
        "last compiler snapshot disappeared while refresh was active")
      local closed = false
      local closer = async.run<|nil, value|>(function (): nil
        service:close()
        closed = true
        return nil
      end)
      async.yield()
      test.assert(not closed, "Service closed before accepted analysis drained")
      resume(true)
      test.assert(async.join<|nil, value|>(worker):has_succeeded(), "analysis worker failed")
      test.assert(async.join<|nil, value|>(closer):has_succeeded() and closed,
        "Service did not close after its accepted update finished")
    end)
  end)
end

function test_project_service_rolls_back_earlier_modules_when_later_result_is_missing(
    _context: test.Context)
  test_runtime.run(function ()
    with_fixture(function (fixture: Fixture)
      fixture:mkdir("src")
      configure_source_root(fixture)
      fixture:write("src/a.titan", "-- first a\n")
      fixture:write("src/b.titan", "-- first b\n")
      local malformed = false
      local recorder = new_analyzer()
      local analyzer: project_service.Analyzer = function (
          request: project_service.AnalysisRequest): compiler_bridge.Analysis
        local result = recorder:analyze(request)
        if malformed then
          test.assert(#result.modules == 2, "rollback fixture lost its two project results")
          result.modules[2] = nil
        end
        return result
      end
      local service?, failure? = test_service.load {
        project_root = fixture.root,
        installed_binary_modules_root = "/sdk/lib/titan/0.6",
        analyzer = analyzer,
      }
      if service ~= nil then fixture.services[#fixture.services + 1] = service end
      test.assert(service ~= nil and failure == nil, "rollback fixture did not load")
      if service == nil then raise "rollback fixture Service is missing" end
      local before = service:latest()
      local original? = before.project_modules[1].compiler_snapshot
      fixture:write("src/a.titan", "-- PUBLIC_TWO a\n")
      fixture:write("src/b.titan", "-- PUBLIC_TWO b\n")
      malformed = true
      local report?, failure? = service:refresh()
      test.assert(report == nil and failure ~= nil,
        "incomplete multi-module analysis unexpectedly committed")
      local after = service:latest()
      test.assert(#after.dirty_modules == 2 and
        after.project_modules[1].compiler_snapshot == original and
        #after.project_modules[1].diagnostics == 0,
        "failed publication kept an earlier module's new handle or diagnostics")
      malformed = false
      local recovered?, recovery_error? = service:run_pending()
      test.assert(recovered ~= nil and recovery_error == nil and
        #recovered.committed_modules == 2 and #recovered.dirty_modules == 0,
        "rolled-back publication could not retry both modules")
    end)
  end)
end

function test_project_service_restores_only_projects_revalidated_after_store_reopen(
    _context: test.Context)
  test_runtime.run(function ()
    with_fixture(function (fixture: Fixture)
      fixture:mkdir("src")
      fixture:mkdir("include")
      configure_source_root(fixture)
      fixture:write("src/main.titan", "-- saved header consumer\n")
      fixture:write("include/value.h", "#define VALUE 1\n")
      fixed_modified_time(fixture:path("src/main.titan"))
      fixed_modified_time(fixture:path("include/value.h"))
      fixture:write("cache.sqlite3", "")
      local path = fixture:path("cache.sqlite3")
      local header = fixture:path("include/value.h")
      local analyzer = new_analyzer()
      analyzer.project_header_inputs["main"] = {
        header_input(compiler_bridge.CHeaderDependencyKind.file(), header),
      }
      local store = stores.open(path)
      local initial?, initial_error? = test_service.create {
        project_root = fixture.root,
        installed_binary_modules_root = "/sdk/lib/titan/0.6",
        analyzer = analyzer:analyze,
        header_restater = restat_test_headers,
        store = store,
      }
      if initial ~= nil then fixture.services[#fixture.services + 1] = initial end
      test.assert(initial ~= nil and initial_error == nil, "persistent fixture did not initialize")
      if initial == nil then store:close() raise "persistent fixture Service is missing" end
      local checked?, check_error? = initial:run_pending()
      local snapshot? = initial:project_ast("main")
      test.assert(checked ~= nil and check_error == nil and snapshot ~= nil,
        "persistent fixture did not produce a checked project handle")
      local revision = work_revision(initial, "main")
      local generation = initial:latest().generation
      do
        local access = initial:workspace_store():acquire()
        defer access:release()
        test.assert(stores.scalar_integer(access.connection,
          "SELECT length(public_digest)+length(source_digest) " ..
          "FROM main.graph_modules WHERE name='main'") == 64,
          "graph persisted complete comparison manifests instead of fixed-size digests")
      end
      local before_touch = initial:counters()
      set_modified_time(fixture:path("src/main.titan"), 1700000001)
      set_modified_time(header, 1700000001)
      local touched?, touch_error? = initial:refresh()
      test.assert(touched ~= nil and touch_error == nil and not touched.analyzed and
        initial:latest().generation == generation and work_revision(initial, "main") == revision and
        initial:project_ast("main") == snapshot and
        initial:counters().file_reads == before_touch.file_reads + 1 and
        initial:counters().file_hashes == before_touch.file_hashes + 1,
        "same-content source/header touches changed semantic work or skipped source validation")
      initial:close()

      local reopened_store = stores.open(path)
      local reopened?, reopen_error? = test_service.create {
        project_root = fixture.root,
        installed_binary_modules_root = "/sdk/lib/titan/0.6",
        analyzer = analyzer:analyze,
        header_restater = restat_test_headers,
        store = reopened_store,
      }
      if reopened ~= nil then fixture.services[#fixture.services + 1] = reopened end
      test.assert(reopened ~= nil and reopen_error == nil, "unchanged persistent fixture did not reopen")
      if reopened == nil then reopened_store:close() raise "reopened Service is missing" end
      test.assert(reopened:project_ast("main") == nil and
        #reopened:latest().dirty_modules == 0 and
        reopened:counters().file_reads == 0 and reopened:counters().file_hashes == 0 and
        not reopened:accepts_project_manifest("main", revision + 1) and
        reopened:accepts_project_manifest("main", revision),
        "reopen fabricated a compiler body or rejected a validated clean manifest")
      local warm?, warm_error? = reopened:run_pending()
      test.assert(warm ~= nil and warm_error == nil and not warm.analyzed and
        reopened:counters().analysis_runs == 0 and reopened:counters().file_reads == 0 and
        reopened:counters().file_hashes == 0,
        "unchanged restored project was submitted to the compiler again")
      reopened:close()

      fixture:write("include/value.h", "#define VALUE 2\n")
      local changed_store = stores.open(path)
      local changed?, change_error? = test_service.create {
        project_root = fixture.root,
        installed_binary_modules_root = "/sdk/lib/titan/0.6",
        analyzer = analyzer:analyze,
        header_restater = restat_test_headers,
        store = changed_store,
      }
      if changed ~= nil then fixture.services[#fixture.services + 1] = changed end
      test.assert(changed ~= nil and change_error == nil, "changed-header persistent fixture did not reopen")
      if changed == nil then changed_store:close() raise "changed-header Service is missing" end
      test.assert(contains(changed:latest().dirty_modules, "main") and
        not changed:accepts_project_manifest("main", revision),
        "persisted header inputs were not revalidated before manifest restoration")
    end)
  end)
end

function test_project_service_rolls_back_header_baseline_with_its_invalidated_revision(
    _context: test.Context)
  test_runtime.run(function ()
    with_fixture(function (fixture: Fixture)
      fixture:mkdir("src")
      fixture:mkdir("include")
      configure_source_root(fixture)
      fixture:write("src/main.titan", "-- header consumer\n")
      fixture:write("include/value.h", "#define VALUE 1\n")
      local header = fixture:path("include/value.h")
      local analyzer = new_analyzer()
      analyzer.project_header_inputs["main"] = {
        header_input(compiler_bridge.CHeaderDependencyKind.file(), header),
      }
      local service = require_service(fixture, analyzer)
      local store = service:workspace_store()
      local access = store:acquire()
      defer access:release()
      local old = stores.rows(access.connection,
        "SELECT d.identity FROM main.header_inputs AS i " ..
        "JOIN main.header_owners AS o ON o.id=i.owner_id " ..
        "JOIN main.header_dependencies AS d ON d.id=i.dependency_id " ..
        "WHERE o.scope=0 AND o.key=? ORDER BY i.ordinal",
        sqlite3.Blob.new("main"))
      local original_identity = stores.bytes(old[1], 1)
      stores.execute(access.connection,
        "CREATE TRIGGER main.reject_header_invalidation BEFORE UPDATE OF state " ..
        "ON graph_modules WHEN NEW.state=0 AND NEW.name='main' " ..
        "BEGIN SELECT RAISE(ABORT,'injected invalidation failure'); END")
      access:release()
      fixture:write("include/value.h", "#define VALUE 2\n")
      local scanned?, scan_error? = service:scan()
      test.assert(scanned == nil and scan_error ~= nil,
        "injected metadata invalidation failure was ignored")
      local read = store:acquire()
      defer read:release()
      local restored = stores.rows(read.connection,
        "SELECT d.identity FROM main.header_inputs AS i " ..
        "JOIN main.header_owners AS o ON o.id=i.owner_id " ..
        "JOIN main.header_dependencies AS d ON d.id=i.dependency_id " ..
        "WHERE o.scope=0 AND o.key=? ORDER BY i.ordinal",
        sqlite3.Blob.new("main"))
      test.assert(stores.bytes(restored[1], 1) == original_identity and
        stores.scalar_integer(read.connection,
          "SELECT state FROM main.graph_modules WHERE name='main'") == 2,
        "failed invalidation advanced its observation baseline independently")
      stores.execute(read.connection, "DROP TRIGGER main.reject_header_invalidation")
      read:release()
      local retried?, retry_error? = service:scan()
      test.assert(retried ~= nil and retry_error == nil and
        contains(retried.dirty_modules, "main"),
        "rolled-back header observation could not invalidate its project on retry")
    end)
  end)
end

function test_project_service_persists_configuration_with_interrupted_graph_work(
    _context: test.Context)
  test_runtime.run(function ()
    with_fixture(function (fixture: Fixture)
      fixture:mkdir("src")
      fixture:mkdir("include")
      fixture:write("src/clean.titan", "-- saved clean module\n")
      fixture:write("src/failed.titan", "-- saved configuration-dependent module\n")
      fixture:write("include/config.h", "/* unchanged header bytes */\n")
      fixture:write("cache.sqlite3", "")
      local configuration_a = [[
include = { "src" }
binary_modules_root = "binary-modules"
extra_ffi_cppflags = "-DVARIANT=1"
]]
      local configuration_b = [[
include = { "src" }
binary_modules_root = "binary-modules"
extra_ffi_cppflags = "-DVARIANT=2"
]]
      fixture:write("titan-config.lua", configuration_a)
      local headers = {header_input(compiler_bridge.CHeaderDependencyKind.file(),
        fixture:path("include/config.h"))}
      local analyzer: project_service.Analyzer = function (
          request: project_service.AnalysisRequest): compiler_bridge.Analysis
        local snapshots: {compiler_bridge.ModuleSnapshot} = {}
        local diagnostics: {compiler_bridge.Diagnostic} = {}
        for index = 1, #request.dirty_modules do
          local module = find_bridge_project(request.project_modules,
            request.dirty_modules[index])
          if module.module_name == "failed" and
             request.config.extra_ffi_cppflags == "-DVARIANT=2" then
            snapshots[#snapshots + 1] = failed_project(module, headers)
            diagnostics[#diagnostics + 1] = compiler_bridge.Diagnostic.new(
              compiler_bridge.DiagnosticKind.type_error(),
              "configuration B rejects this saved module", location(module))
          else
            snapshots[#snapshots + 1] = successful_project(module, headers)
          end
        end
        return compiler_bridge.Analysis.new(request.root_module, diagnostics,
          snapshots, {}, {}, {})
      end
      local reopen: function (): project_service.Service = function (): project_service.Service
        local store = stores.open(fixture:path("cache.sqlite3"))
        local service?, failure? = test_service.create {
          project_root = fixture.root,
          installed_binary_modules_root = "/sdk/lib/titan/0.6",
          analyzer = analyzer,
          header_restater = restat_test_headers,
          store = store,
        }
        if service == nil then
          store:close()
          raise "persistent configuration fixture failed: " .. failure.message
        end
        fixture.services[#fixture.services + 1] = service
        return service
      end
      local service = reopen()
      local initial?, initial_error? = service:run_pending()
      test.assert(initial ~= nil and initial_error == nil and
        #initial.committed_modules == 2, "configuration A did not check both modules")
      local original? = service:project_ast("clean")
      local access = service:workspace_store():acquire()
      defer access:release()
      local old_identity = stores.bytes(stores.rows(access.connection,
        "SELECT value FROM main.cache_meta WHERE key=?",
        sqlite3.Blob.new("graph_configuration"))[1], 1)
      stores.execute(access.connection,
        "CREATE TRIGGER main.reject_graph_configuration BEFORE UPDATE OF value " ..
        "ON cache_meta WHEN NEW.key=CAST('graph_configuration' AS BLOB) " ..
        "BEGIN SELECT RAISE(ABORT,'injected configuration failure'); END")
      access:release()
      fixture:write("titan-config.lua", configuration_b)
      local aborted?, abort_error? = service:scan()
      test.assert(aborted == nil and abort_error ~= nil,
        "configuration identity write failure did not abort graph invalidation")
      local rolled_back = service:workspace_store():acquire()
      defer rolled_back:release()
      local retained = stores.bytes(stores.rows(rolled_back.connection,
        "SELECT value FROM main.cache_meta WHERE key=?",
        sqlite3.Blob.new("graph_configuration"))[1], 1)
      test.assert(retained == old_identity and
        stores.scalar_integer(rolled_back.connection,
          "SELECT count(*) FROM main.graph_modules WHERE state=2") == 2 and
        stores.scalar_integer(rolled_back.connection,
          "SELECT count(*) FROM main.header_inputs AS i " ..
          "JOIN main.header_owners AS o ON o.id=i.owner_id WHERE o.scope=0") == 2,
        "failed configuration transaction changed graph or header baselines")
      stores.execute(rolled_back.connection, "DROP TRIGGER main.reject_graph_configuration")
      rolled_back:release()
      test.assert(service:project_ast("clean") == original,
        "failed configuration transaction discarded the live checked handle")

      local changed?, change_error? = service:refresh()
      test.assert(changed ~= nil and change_error == nil and
        #changed.committed_modules == 1 and #changed.failed_modules == 1,
        "configuration B did not commit its clean and failed graph states")
      local snapshot_b? = service:project_ast("clean")
      local before_close = service:workspace_store():acquire()
      defer before_close:release()
      test.assert(stores.scalar_integer(before_close.connection,
        "SELECT published_generation FROM main.store_state WHERE singleton=1") == 0,
        "fixture accidentally published a completed feature view")
      before_close:release()
      service:close()

      -- The process stopped after B's graph commit, before a completed-view
      -- publication could update any cache compatibility marker.
      fixture:write("titan-config.lua", configuration_a)
      local recovered = reopen()
      local pending = recovered:latest().dirty_modules
      test.assert(#pending == 2 and contains(pending, "clean") and
        contains(pending, "failed") and snapshot_b ~= nil and
        not recovered:accepts_project_manifest("clean", work_revision(recovered, "clean")),
        "restart trusted clean or failed graph work from configuration B")
      local after_reopen = recovered:workspace_store():acquire()
      defer after_reopen:release()
      test.assert(stores.scalar_integer(after_reopen.connection,
        "SELECT count(*) FROM main.header_inputs") == 0,
        "restart retained a header baseline from configuration B")
      after_reopen:release()
      local checked?, check_error? = recovered:run_pending()
      test.assert(checked ~= nil and check_error == nil and
        #checked.committed_modules == 2 and #checked.failed_modules == 0,
        "restored configuration A did not recheck both unchanged sources")
    end)
  end)
end
