local function retries_conflicting_binary_against_existing_baseline()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    fixture:mkdir("src/app")
    fixture:mkdir("binary-modules")
    configure_source_root(fixture)
    fixture:write("src/app/main.titan", "-- binary consumer\n")
    fixture:write("src/bad.titan", "-- initially valid\n")
    fixture:write("binary-modules/provider.so", "stable provider")

    local provider = fixture:path("binary-modules/provider.so")
    local analyzer = new_analyzer()
    analyzer.binary_file = provider
    local resolver = new_resolver()
    resolver.provenance["vendor.binary"] =
      compiler_bridge.Provenance.dynamic_binary(
        compiler_bridge.BinaryProvenance.new(provider))
    local service = require_resolved_service(fixture, analyzer, resolver)
    local before = service:counters()

    -- Model a successful early root which selected another provider followed
    -- by a failing root that returned to this baseline and therefore omitted
    -- the external manifest. Neither the unchanged final fingerprint nor the
    -- nil manifest may hide the bridge's explicit cross-attempt conflict.
    analyzer.suppress_binary_identity_once = true
    analyzer.omit_binary_manifest_once = true
    analyzer.report_provider_conflict_once = true
    fixture:write(
      "src/app/main.titan", "-- changed binary consumer is longer\n")
    fixture:write("src/bad.titan", "MALFORMED later root\n")
    local report?, report_error? = service:refresh()
    local after = service:counters()
    test.assert(report_error == nil and report ~= nil and report.stale and
                after.analysis_runs == before.analysis_runs + 2 and
                after.project_modules_submitted ==
                  before.project_modules_submitted + 4 and
                contains(report.committed_modules, "app.main") and
                contains(report.failed_modules, "bad") and
                #service:latest().dirty_modules == 0,
                "existing provider baseline hid a mixed compiler analysis")
  end)
end

function test_project_service_retries_binary_conflict_against_existing_baseline(
    _context: test.Context)
  test_runtime.run(retries_conflicting_binary_against_existing_baseline)
end

