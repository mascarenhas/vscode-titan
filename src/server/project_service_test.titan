local function accepts_stable_first_binary_provider()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    fixture:mkdir("src/app")
    fixture:mkdir("binary-modules")
    configure_source_root(fixture)
    fixture:write("src/app/main.titan", "-- binary consumer\n")
    fixture:write("binary-modules/provider.so", "stable provider")

    local provider = fixture:path("binary-modules/provider.so")
    local analyzer = new_analyzer()
    analyzer.binary_file = provider
    local resolver = new_resolver()
    resolver.provenance["vendor.binary"] =
      compiler_bridge.Provenance.dynamic_binary(
        compiler_bridge.BinaryProvenance.new(provider))

    local service = require_resolved_service(fixture, analyzer, resolver)
    local counters = service:counters()
    test.assert(counters.analysis_runs == 1 and
                counters.project_modules_submitted == 1 and
                service:external_module("vendor.binary") ~= nil and
                #service:latest().dirty_modules == 0,
                "stable first binary provider forced a duplicate analysis")

    local unchanged?, unchanged_error? = service:refresh()
    test.assert(unchanged_error == nil and unchanged ~= nil and
                not unchanged.analyzed and not unchanged.stale and
                service:counters().analysis_runs == counters.analysis_runs,
                "stable first binary provider was not retained as the baseline")
  end)
end

function test_project_service_accepts_stable_first_binary_provider_once(
    _context: test.Context)
  test_runtime.run(accepts_stable_first_binary_provider)
end

local function validates_binary_observation_before_source_result()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    fixture:mkdir("src/app")
    fixture:mkdir("external")
    fixture:mkdir("binary-modules")
    configure_source_root(fixture)
    fixture:write("src/app/main.titan", "-- mixed provider consumer\n")
    fixture:write("external/provider.titan", "-- source provider\n")
    fixture:write("binary-modules/provider.so", "first binary provider")

    local source_provider = fixture:path("external/provider.titan")
    local binary_provider = fixture:path("binary-modules/provider.so")
    local replace_binary = false
    local runs = 0
    local analyzer: project_service.Analyzer =
      function (request: project_service.AnalysisRequest):
          compiler_bridge.Analysis
        runs = runs + 1
        local module? = find_bridge_project(
          request.project_modules, request.root_module)
        test.assert(module ~= nil,
                    "mixed-provider analyzer lost its project root")
        if module == nil then raise "mixed-provider project is absent" end

        local identity? = observed_provider_identity(binary_provider)
        local modules: {compiler_bridge.ModuleSnapshot} = {
          compiler_bridge.ModuleSnapshot.new(
            module.module_name, project_provenance(module),
            compiler_bridge.Manifest.new(
              module.module_name, public_manifest(module),
              source_manifest(module, {})),
            {}, {}, {
              one_import(module, "mixed", "vendor.mixed", false),
            }, {}, nil, nil),
          compiler_bridge.ModuleSnapshot.new(
            "vendor.mixed",
            compiler_bridge.Provenance.external_source(
              compiler_bridge.SourceProvenance.new(
                source_provider, {source_provider})),
            compiler_bridge.Manifest.new(
              "vendor.mixed", "mixed-public",
              external_source_manifest(
                "vendor.mixed", "mixed-public", {})),
            {external_node(source_provider)}, {}, {}, {}, nil, nil),
        }
        if replace_binary then
          fs.write_file(
            binary_provider,
            "replacement binary provider with different bytes")
          replace_binary = false
        end
        return compiler_bridge.Analysis.new(
          request.root_module, {}, modules, {}, {
            compiler_bridge.BinaryProviderObservation.new(
              "vendor.mixed", "dynamic", binary_provider, identity),
          }, {})
      end

    local service?, load_error? = test_service.load {
      project_root = fixture.root,
      installed_binary_modules_root = "/sdk/lib/titan/0.6",
      analyzer = analyzer,
      header_restater = restat_test_headers,
    }
    if service ~= nil then fixture.services[#fixture.services + 1] = service end
    test.assert(load_error == nil and service ~= nil,
                "mixed-provider project service did not load")
    if service == nil then raise "mixed-provider Service is absent" end
    local before = service:counters()
    test.assert(before.analysis_runs == 1 and
                before.project_modules_submitted == 1 and
                service:external_module("vendor.mixed") ~= nil and
                #service:latest().dirty_modules == 0,
                "stable binary-to-source observation forced a retry")

    replace_binary = true
    fixture:write(
      "src/app/main.titan", "-- changed mixed provider consumer\n")
    local report?, report_error? = service:refresh()
    local after = service:counters()
    test.assert(report_error == nil and report ~= nil and report.stale and
                runs == 3 and
                after.analysis_runs == before.analysis_runs + 2 and
                after.project_modules_submitted ==
                  before.project_modules_submitted + 2 and
                contains(report.committed_modules, "app.main") and
                service:external_module("vendor.mixed") ~= nil and
                #service:latest().dirty_modules == 0,
                "changed transient binary observation was published")
  end)
end

function test_project_service_validates_binary_observation_before_source_result(
    _context: test.Context)
  test_runtime.run(validates_binary_observation_before_source_result)
end

