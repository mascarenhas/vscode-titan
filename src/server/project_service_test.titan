local test_service = import "server.test_service"
local fs = import "fs"
local lua = import "lua"
local async = import "async"
local sqlite3 = import "sqlite3"
foreign import "utime.h"
local test = import "test"
local strings = import "string"
local compiler_bridge = import "server.compiler_bridge"
local compiler_io = import "server.compiler_io"
local content_identity = import "server.content_identity"
local project_config = import "server.project_config"
local project_service = import "server.project_service"
local project_graph = import "server.project_graph"
local project_loader = import "server.project_loader"
local workspace_cache = import "server.workspace_cache"
local stores = import "server.workspace_store"
local test_runtime = import "server.test_runtime"

local function same_paths(left: {string}, right: {string}): boolean
  if #left ~= #right then return false end
  for index = 1, #left do
    if left[index] ~= right[index] then return false end
  end
  return true
end

local function set_modified_time(path: string, seconds: integer)
  local times = foreign utimbuf.new()
  times.actime = seconds
  times.modtime = seconds
  test.assert(ffi.utime(path, times) == 0,
    "could not set deterministic saved-file timestamp")
end

local function fixed_modified_time(path: string)
  set_modified_time(path, 1700000000)
end

local function work_revision(service: project_service.Service, name: string): integer
  local access = service:workspace_store():acquire()
  defer access:release()
  return stores.scalar_integer(access.connection,
    "SELECT revision FROM main.graph_modules WHERE name=?", name)
end

local record Fixture
  root: string
  files: {string}
  directories: {string}
  known_files: {string: boolean}
  known_directories: {string: boolean}
  services: {project_service.Service}
  restorations: {project_loader.Restoration}
end

local type FixtureBody = function (Fixture): ()

local function new_fixture(): Fixture
  local root = fs.tmpname()
  fs.unlink(root)
  fs.mkdir(root)
  return Fixture.new(root, {}, {root}, {}, {[root] = true}, {}, {})
end

local function Fixture:load_compiler(): (project_service.Service?, project_service.Error?)
  local loaded?, failure?, restoration? = project_loader.load(self.root)
  if restoration ~= nil then
    self.restorations[#self.restorations + 1] = restoration
  end
  return loaded, failure
end

local function remove_cache(path: string)
  local metadata? = fs.lstat(path)
  if metadata == nil then return end
  if metadata.kind == "directory" then
    local names = fs.list(path)
    for index = 1, #names do remove_cache(path .. "/" .. names[index]) end
    fs.rmdir(path)
  else
    fs.unlink(path)
  end
end

local function Fixture:path(relative: string): string
  return self.root .. "/" .. relative
end

local function Fixture:mkdir(relative: string)
  local path = self:path(relative)
  fs.mkdir(path)
  if self.known_directories[path] == nil then
    self.known_directories[path] = true
    self.directories[#self.directories + 1] = path
  end
end

local function Fixture:write(relative: string, contents: string)
  local path = self:path(relative)
  fs.write_file(path, contents)
  if self.known_files[path] == nil then
    self.known_files[path] = true
    self.files[#self.files + 1] = path
  end
end

local function Fixture:cleanup()
  for index = #self.restorations, 1, -1 do self.restorations[index]:close() end
  for index = #self.services, 1, -1 do self.services[index]:close() end
  remove_cache(workspace_cache.directory(self.root))
  for index = #self.files, 1, -1 do
    if fs.lstat(self.files[index]) ~= nil then fs.unlink(self.files[index]) end
  end
  for index = #self.directories, 1, -1 do
    if fs.lstat(self.directories[index]) ~= nil then
      fs.rmdir(self.directories[index])
    end
  end
end

local function with_fixture(body: FixtureBody)
  local fixture = new_fixture()
  defer fixture:cleanup()
  body(fixture)
end

local function configure_source_root(fixture: Fixture)
  fixture:write("titan-config.lua", [[
include = { "src" }
binary_modules_root = "binary-modules"
]])
end

local function project_provenance(
    module: compiler_bridge.ProjectModule): compiler_bridge.Provenance
  local files: {string} = {}
  for index = 1, #module.files do files[index] = module.files[index].filename end
  return compiler_bridge.Provenance.project_source(
    compiler_bridge.SourceProvenance.new(files[1], files))
end

local function location(module: compiler_bridge.ProjectModule):
    compiler_bridge.SourceLocation
  return compiler_bridge.SourceLocation.new(module.files[1].filename, 1, 1)
end

local function one_import(module: compiler_bridge.ProjectModule,
                          alias: string, imported: string,
                          source_required: boolean): compiler_bridge.Import
  return compiler_bridge.Import.new(
    alias, imported, source_required, location(module))
end

local function imports_for(module: compiler_bridge.ProjectModule):
    {compiler_bridge.Import}
  if module.module_name == "app.main" then
    local result = {one_import(module, "pkg", "pkg", false)}
    if strings.find(module_contents(module), "NO_EXTERNALS") == nil then
      result[#result + 1] =
        one_import(module, "vendor", "vendor.source", false)
      result[#result + 1] =
        one_import(module, "vendor_binary", "vendor.binary", false)
    end
    return result
  end
  if module.module_name == "client" then
    return {one_import(module, "dep", "dep", false)}
  end
  if module.module_name == "friend" then
    return {one_import(module, "dep", "dep", true)}
  end
  if module.module_name == "top" then
    return {one_import(module, "friend", "friend", false)}
  end
  return {}
end

local function module_contents(module: compiler_bridge.ProjectModule): string
  local output = strings.writer()
  for index = 1, #module.files do output:write(module.files[index].contents) end
  return output:drain()
end

local function public_manifest(module: compiler_bridge.ProjectModule): string
  if strings.find(module_contents(module), "PUBLIC_TWO") ~= nil then
    return "public:" .. module.module_name .. ":two"
  end
  return "public:" .. module.module_name .. ":one"
end

local function source_manifest(
    module: compiler_bridge.ProjectModule,
    headers: {compiler_bridge.CHeaderDependency}): string
  local output = strings.writer()
  local public = public_manifest(module)
  output:write(#public .. ":" .. public)
  if strings.find(module_contents(module), "SOURCE_TWO") ~= nil then
    output:write("10:source:two")
  else
    output:write("10:source:one")
  end
  for index = 1, #headers do
    local header = headers[index]
    output:write(#header.identity .. ":" .. header.identity)
  end
  return output:drain()
end

local function external_source_manifest(
    name: string, public: string,
    headers: {compiler_bridge.CHeaderDependency}): string
  local output = strings.writer()
  output:write(#public .. ":" .. public)
  output:write(#name .. ":" .. name)
  for index = 1, #headers do
    local header = headers[index]
    output:write(#header.identity .. ":" .. header.identity)
  end
  return output:drain()
end

local function search_header_identity(path: string): string
  local link? = fs.lstat(path)
  local target? = fs.stat(path)
  local link_state = "missing"
  local target_state = "missing"
  if link ~= nil then
    link_state = link.kind .. ":" .. link.mode
  end
  if target ~= nil then
    target_state = target.kind .. ":" .. target.mode
  end
  return "search:lstat=" .. link_state .. ";stat=" .. target_state
end

local function current_header_identity(
    kind: compiler_bridge.CHeaderDependencyKind, path: string): string
  case kind
  when search() then return search_header_identity(path)
  when file() then
    local metadata? = fs.stat(path)
    if metadata == nil or metadata.kind ~= "file" then
      return "file:unreadable:" .. search_header_identity(path)
    end
    local contents = fs.read_file(path)
    return "file:bytes=" .. #contents .. ":" .. contents
  end
end

local function observed_provider_identity(
    path: string): compiler_io.LstatIdentity?
  local metadata? = fs.stat(path)
  if metadata == nil then return nil end
  return compiler_io.LstatIdentity.new(
    path, metadata.size, metadata.kind, metadata.device, metadata.inode,
    metadata.modified_seconds, metadata.modified_nanoseconds)
end


local function header_observation(path: string): compiler_bridge.HeaderObservation?
  local observed? = content_identity.observe(path)
  if observed == nil or observed.kind ~= "file" then return nil end
  return compiler_bridge.HeaderObservation.new(observed.modified_seconds,
    observed.modified_nanoseconds, observed.physical_identity)
end

local function restat_test_headers(
    dependencies: {compiler_bridge.CHeaderDependency},
    _validation: compiler_bridge.HeaderValidation?):
    ({compiler_bridge.CHeaderDependency}, boolean)
  local result: {compiler_bridge.CHeaderDependency} = {}
  local changed = false
  for index = 1, #dependencies do
    local dependency = dependencies[index]
    local kind = compiler_bridge.CHeaderDependencyKind.file()
    case dependency.kind
    when search() then kind = compiler_bridge.CHeaderDependencyKind.search()
    when file() then
    end
    local observed? = header_observation(dependency.path)
    local previous? = dependency.observation
    local reuse = previous ~= nil and observed ~= nil and
      previous.modified_seconds == observed.modified_seconds and
      previous.modified_nanoseconds == observed.modified_nanoseconds and
      previous.physical_identity == observed.physical_identity
    local identity = dependency.identity
    if not reuse then identity = current_header_identity(dependency.kind, dependency.path) end
    if identity ~= dependency.identity then changed = true end
    result[index] = compiler_bridge.CHeaderDependency.new(
      kind, dependency.path, identity, observed)
  end
  return result, changed
end

local function header_input(kind: compiler_bridge.CHeaderDependencyKind,
                            path: string): compiler_bridge.CHeaderDependency
  return compiler_bridge.CHeaderDependency.new(
    kind, path, current_header_identity(kind, path), header_observation(path))
end

local function has_missing_file_header(
    dependencies: {compiler_bridge.CHeaderDependency}): boolean
  for index = 1, #dependencies do
    local dependency = dependencies[index]
    case dependency.kind
    when file() then
      local metadata? = fs.stat(dependency.path)
      if metadata == nil or metadata.kind ~= "file" then return true end
    when search() then
    end
  end
  return false
end

local function successful_project(
    module: compiler_bridge.ProjectModule,
    headers: {compiler_bridge.CHeaderDependency}):
    compiler_bridge.ModuleSnapshot
  return compiler_bridge.ModuleSnapshot.new(
    module.module_name, project_provenance(module),
    compiler_bridge.Manifest.new(
      module.module_name, public_manifest(module),
      source_manifest(module, headers)),
    {}, {}, imports_for(module), headers, nil, nil)
end

local function failed_project(
    module: compiler_bridge.ProjectModule,
    headers: {compiler_bridge.CHeaderDependency}):
    compiler_bridge.ModuleSnapshot
  return compiler_bridge.ModuleSnapshot.new(
    module.module_name, project_provenance(module), nil, {}, {}, {}, headers,
    nil, nil)
end

local function external_node(filename: string): compiler_bridge.Node
  return compiler_bridge.Node.new(
    1, nil, "Ast.TopLevelFunc", compiler_bridge.NodeKind.declaration(),
    compiler_bridge.SourceLocation.new(filename, 1, 1), nil,
    "must_not_escape",
    false, false, nil, nil, nil, nil, nil)
end

local record RecordingAnalyzer
  runs: integer
  last_module_count: integer
  last_dirty: {string}
  last_cached_count: integer
  checked_modules: {string}
  expected_source_roots: {string}?
  external_main: string?
  external_files: {string}
  external_dependency_main: string?
  external_dependency_files: {string}
  binary_file: string?
  contextual_owner_file: string?
  project_header_inputs: {string: {compiler_bridge.CHeaderDependency}}
  external_header_inputs: {compiler_bridge.CHeaderDependency}
  write_during_analysis: string?
  write_during_analysis_contents: string?
  suppress_binary_identity_once: boolean
  omit_binary_manifest_once: boolean
  report_provider_conflict_once: boolean
end

local function find_bridge_project(
    modules: {compiler_bridge.ProjectModule}, module_name: string):
    compiler_bridge.ProjectModule?
  for index = 1, #modules do
    if modules[index].module_name == module_name then return modules[index] end
  end
  return nil
end

local function contains(names: {string}, name: string): boolean
  for index = 1, #names do
    if names[index] == name then return true end
  end
  return false
end

local function display_names(names: {string}): string
  local output = strings.writer()
  output:write("[")
  for index = 1, #names do
    if index > 1 then output:write(", ") end
    output:write(names[index])
  end
  output:write("]")
  return output:drain()
end

local function RecordingAnalyzer:analyze(
    request: project_service.AnalysisRequest): compiler_bridge.Analysis
  self.runs = self.runs + 1
  self.last_module_count = #request.project_modules
  self.last_dirty = {}
  for index = 1, #request.dirty_modules do
    self.last_dirty[index] = request.dirty_modules[index]
    self.checked_modules[#self.checked_modules + 1] =
      request.dirty_modules[index]
  end
  self.last_cached_count = #request.cached_sources
  if self.expected_source_roots ~= nil then
    test.assert(same_paths(request.config.source_module_roots, self.expected_source_roots),
                "analysis request lost the normalized source root")
  end

  local snapshots: {compiler_bridge.ModuleSnapshot} = {}
  local diagnostics: {compiler_bridge.Diagnostic} = {}
  for index = 1, #request.dirty_modules do
    local name = request.dirty_modules[index]
    local module? = find_bridge_project(request.project_modules, name)
    test.assert(module ~= nil, "dirty analysis module was absent from catalog")
    local configured_headers? = self.project_header_inputs[name]
    local headers: {compiler_bridge.CHeaderDependency} = {}
    if configured_headers ~= nil then
      headers = restat_test_headers(configured_headers)
    end
    if strings.find(module_contents(module), "MALFORMED") ~= nil then
      snapshots[#snapshots + 1] = failed_project(module, headers)
      diagnostics[#diagnostics + 1] = compiler_bridge.Diagnostic.new(
        compiler_bridge.DiagnosticKind.syntax(), "syntax error: malformed",
        compiler_bridge.SourceLocation.new(
          module.files[1].filename, 1, 1))
    elseif has_missing_file_header(headers) then
      snapshots[#snapshots + 1] = failed_project(module, headers)
      diagnostics[#diagnostics + 1] = compiler_bridge.Diagnostic.new(
        compiler_bridge.DiagnosticKind.type_error(),
        "cannot preprocess required C header",
        compiler_bridge.SourceLocation.new(
          module.files[1].filename, 1, 1))
    else
      snapshots[#snapshots + 1] = successful_project(module, headers)
    end
  end

  local app_uses_externals = false
  if contains(request.dirty_modules, "app.main") then
    local app? = find_bridge_project(request.project_modules, "app.main")
    app_uses_externals = app ~= nil and
      strings.find(module_contents(app), "NO_EXTERNALS") == nil
  end
  if app_uses_externals and self.external_main ~= nil then
    local external_headers = restat_test_headers(self.external_header_inputs)
    local external_imports: {compiler_bridge.Import} = {}
    if self.external_dependency_main ~= nil then
      external_imports[1] = compiler_bridge.Import.new(
        "inner", "vendor.inner", false,
        compiler_bridge.SourceLocation.new(self.external_main, 1, 1))
    end
    if has_missing_file_header(external_headers) then
      diagnostics[#diagnostics + 1] = compiler_bridge.Diagnostic.new(
        compiler_bridge.DiagnosticKind.type_error(),
        "cannot preprocess external C header",
        compiler_bridge.SourceLocation.new(
          self.external_main, 1, 1))
    else
      snapshots[#snapshots + 1] = compiler_bridge.ModuleSnapshot.new(
        "vendor.source",
        compiler_bridge.Provenance.external_source(
          compiler_bridge.SourceProvenance.new(
            self.external_main, self.external_files)),
        compiler_bridge.Manifest.new(
          "vendor.source", "vendor-public",
          external_source_manifest(
            "vendor.source", "vendor-public", external_headers)),
        {external_node(self.external_main)}, {}, external_imports,
        external_headers, nil, nil)
    end
  end
  if app_uses_externals and self.external_dependency_main ~= nil then
    snapshots[#snapshots + 1] = compiler_bridge.ModuleSnapshot.new(
      "vendor.inner",
      compiler_bridge.Provenance.external_source(
        compiler_bridge.SourceProvenance.new(
          self.external_dependency_main, self.external_dependency_files)),
      compiler_bridge.Manifest.new(
        "vendor.inner", "inner-public",
        external_source_manifest("vendor.inner", "inner-public", {})),
      {external_node(self.external_dependency_main)}, {}, {}, {}, nil, nil)
  end
  local binary_observations:
    {compiler_bridge.BinaryProviderObservation} = {}
  if app_uses_externals and self.binary_file ~= nil then
    local provider_identity? = observed_provider_identity(self.binary_file)
    if self.suppress_binary_identity_once then
      provider_identity = nil
      self.suppress_binary_identity_once = false
    end
    local binary_manifest?: compiler_bridge.Manifest =
      compiler_bridge.Manifest.new("vendor.binary", "binary-public", nil)
    if self.omit_binary_manifest_once then
      binary_manifest = nil
      self.omit_binary_manifest_once = false
    end
    snapshots[#snapshots + 1] = compiler_bridge.ModuleSnapshot.new(
      "vendor.binary",
      compiler_bridge.Provenance.dynamic_binary(
        compiler_bridge.BinaryProvenance.new(self.binary_file)),
      binary_manifest,
      {external_node(self.binary_file)}, {}, {}, {}, nil,
      provider_identity)
    binary_observations[1] = compiler_bridge.BinaryProviderObservation.new(
      "vendor.binary", "dynamic", self.binary_file, provider_identity)
  end
  local contextual: {compiler_bridge.ContextualResolution} = {}
  if app_uses_externals and self.binary_file ~= nil and
     self.contextual_owner_file ~= nil then
    local owner_file = self.contextual_owner_file as string
    contextual[1] = compiler_bridge.ContextualResolution.new(
      "vendor.owner", "vendor.binary",
      compiler_bridge.Provenance.dynamic_binary(
        compiler_bridge.BinaryProvenance.new(owner_file)),
      true, observed_provider_identity(owner_file))
  end
  if self.write_during_analysis ~= nil then
    fs.write_file(self.write_during_analysis,
                  self.write_during_analysis_contents or "")
    self.write_during_analysis = nil
  end
  local provider_conflicts: {string} = {}
  if self.report_provider_conflict_once then
    provider_conflicts[1] = "vendor.binary"
    self.report_provider_conflict_once = false
  end
  return compiler_bridge.Analysis.new(
    request.root_module, diagnostics, snapshots, contextual,
    binary_observations, provider_conflicts)
end

local function new_analyzer(): RecordingAnalyzer
  return RecordingAnalyzer.new(
    0, 0, {}, 0, {}, nil, nil, {}, nil, {}, nil, nil, {}, {}, nil, nil,
    false, false, false)
end

local record RecordingResolver
  runs: integer
  provenance: {string: compiler_bridge.Provenance}
  requested: {string}
end

local function new_resolver(): RecordingResolver
  return RecordingResolver.new(0, {}, {})
end

local function RecordingResolver:resolve(
    _config: project_config.ProjectConfig,
    _projects: {string},
    requests: {compiler_bridge.ExternalResolutionRequest}):
    {compiler_bridge.ExternalResolution}
  self.runs = self.runs + 1
  self.requested = {}
  local result: {compiler_bridge.ExternalResolution} = {}
  for index = 1, #requests do
    local request = requests[index]
    self.requested[index] = request.module_name
    result[index] = compiler_bridge.ExternalResolution.new(
      request.module_name, self.provenance[request.module_name], nil)
  end
  return result
end

local function require_service(
    fixture: Fixture, analyzer: RecordingAnalyzer): project_service.Service
  local service?, failure? = test_service.load {
    project_root = fixture.root,
    installed_binary_modules_root = "/sdk/lib/titan/0.6",
    analyzer = analyzer:analyze,
    header_restater = restat_test_headers,
  }
  if service ~= nil then fixture.services[#fixture.services + 1] = service end
  local detail = ""
  if failure ~= nil then
    detail = ": " .. failure.path .. ": " .. failure.message
  end
  test.assert(failure == nil and service ~= nil,
              "valid project service fixture did not load" .. detail)
  return service
end


local function require_resolved_service(
    fixture: Fixture, analyzer: RecordingAnalyzer,
    resolver: RecordingResolver): project_service.Service
  local service?, failure? =
    test_service.load {
      project_root = fixture.root,
      installed_binary_modules_root = "/sdk/lib/titan/0.6",
      analyzer = analyzer:analyze,
      external_resolver = resolver:resolve,
      header_restater = restat_test_headers,
    }
  if service ~= nil then fixture.services[#fixture.services + 1] = service end
  local detail = ""
  if failure ~= nil then
    detail = ": " .. failure.path .. ": " .. failure.message
  end
  test.assert(failure == nil and service ~= nil,
              "valid resolved project service fixture did not load" .. detail)
  return service
end

local function find_project(snapshot: project_service.Snapshot,
                            module_name: string): project_service.ProjectModule?
  for index = 1, #snapshot.project_modules do
    if snapshot.project_modules[index].module_name == module_name then
      return snapshot.project_modules[index]
    end
  end
  return nil
end

local function project_is_clean(module: project_service.ProjectModule): boolean
  case module.analysis_state
  when clean() then return true
  else return false
  end
end

local function project_is_failed(module: project_service.ProjectModule): boolean
  case module.analysis_state
  when failed() then return true
  else return false
  end
end

local function project_is_dirty(module: project_service.ProjectModule): boolean
  case module.analysis_state
  when dirty() then return true
  else return false
  end
end

local function find_external(snapshot: project_service.Snapshot,
                             module_name: string):
    project_service.ExternalModule?
  for index = 1, #snapshot.external_modules do
    if snapshot.external_modules[index].module_name == module_name then
      return snapshot.external_modules[index]
    end
  end
  return nil
end

local function assert_visibility(edge: project_graph.ImportEdge,
                                 required: boolean)
  case edge.visibility
  when ordinary() then
    test.assert(not required, "source-required edge became ordinary")
  when source_required() then
    test.assert(required, "ordinary edge became source-required")
  end
end

local function loads_multi_module_folder_and_external_metadata()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    fixture:mkdir("src/app")
    fixture:mkdir("src/pkg")
    fixture:mkdir("external")
    fixture:mkdir("binary-modules")
    configure_source_root(fixture)
    fixture:write("src/app/main.titan", "-- app main\n")
    fixture:write("src/pkg/pkg.titan", "-- folder main\n")
    fixture:write("src/pkg/part.titan", "-- folder part\n")
    fixture:write("external/main.titan", "-- external main\n")
    fixture:write("external/part.titan", "-- external part\n")
    fixture:write("binary-modules/vendor.so", "binary provider")

    local analyzer = new_analyzer()
    analyzer.expected_source_roots = {fixture:path("src")}
    analyzer.external_main = fixture:path("external/main.titan")
    analyzer.external_files = {
      fixture:path("external/main.titan"),
      fixture:path("external/part.titan"),
    }
    analyzer.binary_file = fixture:path("binary-modules/vendor.so")
    local service = require_service(fixture, analyzer)
    local snapshot = service:latest()

    test.assert(#snapshot.project_modules == 2 and
                snapshot.project_modules[1].module_name == "app.main" and
                snapshot.project_modules[2].module_name == "pkg",
                "project service lost deterministic discovered modules")
    test.assert(#snapshot.project_directories == 3 and
                snapshot.project_directories[1] == fixture:path("src") and
                snapshot.project_directories[2] == fixture:path("src/app") and
                snapshot.project_directories[3] == fixture:path("src/pkg"),
                "project directory scope included an external directory")
    local folder? = find_project(snapshot, "pkg")
    test.assert(folder ~= nil and #folder.source_files == 2 and
                folder.source_files[1].filename ==
                  fixture:path("src/pkg/pkg.titan") and
                folder.source_files[2].filename ==
                  fixture:path("src/pkg/part.titan"),
                "folder module did not retain every saved constituent")
    test.assert(folder.compiler_snapshot ~= nil and project_is_clean(folder),
                "valid folder module did not retain its compiler snapshot")

    local counters = service:counters()
    test.assert(counters.file_reads == 3 and
                counters.analysis_runs == 1 and
                counters.project_modules_submitted == 2 and
                analyzer.runs == 1 and analyzer.last_module_count == 2,
                "initial project snapshot did not analyze each discovered module")

    local direct = service:direct_imports("app.main")
    local reverse = service:reverse_imports("pkg")
    test.assert(#direct == 3 and direct[1].module_name == "pkg" and
                direct[2].module_name == "vendor.binary" and
                direct[3].module_name == "vendor.source" and
                #reverse == 1 and reverse[1].importer == "app.main",
                "direct or reverse import graph was not built")
    assert_visibility(direct[1], false)

    local source? = find_external(snapshot, "vendor.source")
    local binary? = find_external(snapshot, "vendor.binary")
    test.assert(source ~= nil and #source.stamps == 2 and
                binary ~= nil and #binary.stamps == 1,
                "external source files or binary provider stamps were lost")
    case source.origin
    when source(origin) then
      test.assert(#origin.source_files == 2 and
                  origin.source_files[2] == fixture:path("external/part.titan"),
                  "external source provenance lost a folder constituent")
    else test.assert(false, "external source used a binary origin")
    end
    test.assert(service:project_ast("app.main") ~= nil and
                service:project_ast("vendor.source") == nil and
                service:project_ast("vendor.binary") == nil,
                "external compiler nodes crossed the metadata-only boundary")

    fixture:write("src/pkg/part.titan", "-- changed folder part is longer\n")
    local partial?, partial_error? = service:refresh()
    test.assert(partial_error == nil and partial ~= nil and
                #partial.committed_modules == 1 and
                partial.committed_modules[1] == "pkg" and
                find_external(service:latest(), "vendor.source") ~= nil and
                find_external(service:latest(), "vendor.binary") ~= nil,
                "partial project analysis pruned another module's externals")

    fixture:write("src/app/main.titan", "-- changed app main\n")
    local cached?, cached_error? = service:refresh()
    test.assert(cached_error == nil and cached ~= nil and
                analyzer.last_cached_count == 1,
                "unchanged external source was not cached or a binary was cached")

    fixture:write("src/app/main.titan", "-- NO_EXTERNALS\n")
    local pruned?, prune_error? = service:refresh()
    local pruned_snapshot = service:latest()
    test.assert(prune_error == nil and pruned ~= nil and
                find_external(pruned_snapshot, "vendor.source") == nil and
                find_external(pruned_snapshot, "vendor.binary") == nil,
                "unreachable external metadata was not pruned at fixed point")
  end)
end

function test_project_service_loads_saved_multi_module_and_folder_snapshot(
    _context: test.Context)
  test_runtime.run(loads_multi_module_folder_and_external_metadata)
end

local function loads_ordered_roots_and_watch_exclusions()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("first")
    fixture:mkdir("second")
    fixture:mkdir("second/ignored")
    fixture:mkdir("lookup")
    fixture:mkdir("binary-modules")
    fixture:write("titan-config.lua", [[
include = { "first", "second" }
exclude = { "second/ignored", "first/excluded_file.titan" }
source_module_roots = { "first", "second", "lookup" }
binary_modules_root = "binary-modules"
]])
    fixture:write("first/shared.titan", "-- first shared\n")
    fixture:write("first/excluded_file.titan", "-- unwatched file\n")
    fixture:write("second/shared.titan", "-- shadowed shared\n")
    fixture:write("second/only.titan", "-- second root\n")
    fixture:write("second/ignored/hidden.titan", "-- unwatched subtree\n")
    fixture:write("lookup/external.titan", "-- source-only external\n")

    local analyzer = new_analyzer()
    analyzer.expected_source_roots = {fixture:path("first"),
      fixture:path("second"), fixture:path("lookup")}
    local service = require_service(fixture, analyzer)
    local snapshot = service:latest()
    test.assert(same_paths(snapshot.config.source_module_roots,
                  analyzer.expected_source_roots) and
                #snapshot.project_modules == 4 and
                find_project(snapshot, "excluded_file") ~= nil and
                find_project(snapshot, "ignored.hidden") ~= nil and
                find_project(snapshot, "external") == nil and
                find_project(snapshot, "only") ~= nil and
                find_project(snapshot, "shared") ~= nil,
                "watch ownership or compiler lookup roots were conflated")
    local shared? = find_project(snapshot, "shared")
    test.assert(shared ~= nil and
                shared.source_files[1].filename ==
                  fixture:path("first/shared.titan"),
                "later source root replaced the first matching module")
    test.assert(#snapshot.project_directories == 2 and
                snapshot.project_directories[1] == fixture:path("first") and
                snapshot.project_directories[2] == fixture:path("second"),
                "excluded watch subtree remained in project directories")
  end)
end

function test_project_service_preserves_ordered_roots_and_watch_exclusions(
    _context: test.Context)
  test_runtime.run(loads_ordered_roots_and_watch_exclusions)
end

local function loads_project_identity_from_divergent_source_roots()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("titan")
    fixture:mkdir("titan/uv")
    fixture:mkdir("spec")
    fixture:mkdir("spec/stdlib")
    fixture:mkdir("spec/stdlib/titan")
    fixture:mkdir("spec/stdlib/titan/support")
    fixture:mkdir("lookup")
    fixture:mkdir("binary-modules")
    fixture:write("titan-config.lua", [[
include = { "titan", "spec/stdlib/titan" }
source_module_roots = { ".", "spec/stdlib/titan", "lookup" }
binary_modules_root = "binary-modules"
]])
    fixture:write("titan/fs.titan", "-- standard library module\n")
    fixture:write("titan/uv/uv.titan", "-- uv folder main\n")
    fixture:write("titan/uv/task.titan", "-- uv constituent\n")
    fixture:write(
      "spec/stdlib/titan/support/runtime.titan", "-- test module\n")
    fixture:write("lookup/external.titan", "-- source-only external\n")

    local analyzer = new_analyzer()
    analyzer.expected_source_roots = {fixture.root,
      fixture:path("spec/stdlib/titan"), fixture:path("lookup")}
    local service = require_service(fixture, analyzer)
    local snapshot = service:latest()
    test.assert(#snapshot.project_modules == 3 and
                find_project(snapshot, "titan.fs") ~= nil and
                find_project(snapshot, "titan.uv") ~= nil and
                find_project(snapshot, "support.runtime") ~= nil and
                find_project(snapshot, "fs") == nil and
                find_project(snapshot, "uv") == nil and
                find_project(snapshot, "external") == nil,
                "service catalog used watcher roots as module roots")
    local uv? = find_project(snapshot, "titan.uv")
    test.assert(uv ~= nil and #uv.source_files == 2 and
                uv.source_files[1].filename ==
                  fixture:path("titan/uv/uv.titan") and
                uv.source_files[2].filename ==
                  fixture:path("titan/uv/task.titan"),
                "service lost source-root-qualified folder inputs")
    test.assert(#snapshot.project_directories == 4,
                "source-only root leaked into watched project directories")
  end)
end

function test_project_service_uses_source_roots_for_project_module_identity(
    _context: test.Context)
  test_runtime.run(loads_project_identity_from_divergent_source_roots)
end

local function reconciles_exclude_without_reanalysis()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    fixture:mkdir("src/generated")
    configure_source_root(fixture)
    fixture:write("src/main.titan", "-- watched source\n")
    fixture:write("src/generated/hidden.titan", "-- unwatched source\n")

    local analyzer = new_analyzer()
    local service = require_service(fixture, analyzer)
    local before = service:counters()
    fixture:write("titan-config.lua", [[
include = { "src" }
exclude = { "src/generated" }
binary_modules_root = "binary-modules"
]])

    local report?, failure? = service:refresh()
    local after = service:counters()
    local snapshot = service:latest()
    test.assert(failure == nil and report ~= nil and
                not report.analyzed and not report.stale and
                after.analysis_runs == before.analysis_runs and
                after.project_modules_submitted ==
                  before.project_modules_submitted,
                "exclude-only change invalidated compatible analysis")
    test.assert(#snapshot.config.exclude == 1 and
                snapshot.config.exclude[1] ==
                  fixture:path("src/generated") and
                #snapshot.project_directories == 1 and
                snapshot.project_directories[1] == fixture:path("src") and
                #snapshot.project_modules == 2 and
                find_project(snapshot, "generated.hidden") ~= nil,
                "exclude-only change did not reconcile watcher policy")
  end)
end

function test_project_service_reconciles_exclude_without_reanalysis(
    _context: test.Context)
  test_runtime.run(reconciles_exclude_without_reanalysis)
end

