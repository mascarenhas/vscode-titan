local async = import "async"
local test = import "test"
local strings = import "string"
local scheduler = import "server.compiler_scheduler"
local test_runtime = import "server.test_runtime"

local function joins(task: async.Task<|nil, value|>, subject: string)
  case async.join<|nil, value|>(task)
  when succeeded() then
  when failed(failure) then
    raise subject .. ": " .. strings.tostring(failure.error)
  when cancelled() then
  else raise subject .. " did not finish"
  end
end

local function serializes_fifo_and_survives_cancelled_waiter()
  local gate = scheduler.create()
  local first = gate:acquire()
  local trace = ""

  local cancelled = async.run<|nil, value|>(function (): nil
    local permit = gate:acquire()
    defer permit:release()
    trace = trace .. "cancelled>"
    return nil
  end)
  async.yield()
  local second = async.run<|nil, value|>(function (): nil
    local permit = gate:acquire()
    defer permit:release()
    trace = trace .. "second>"
    return nil
  end)
  async.yield()
  local third = async.run<|nil, value|>(function (): nil
    local permit = gate:acquire()
    defer permit:release()
    trace = trace .. "third>"
    return nil
  end)

  async.yield()
  cancelled:cancel(async.CancellationReason.simple(
    "cancel queued compiler request"))
  first:release()
  joins(cancelled, "cancelled compiler waiter")
  joins(second, "second compiler waiter")
  joins(third, "third compiler waiter")
  test.assert(trace == "second>third>",
              "compiler permits were not FIFO after queued cancellation: " ..
              trace)

  local final = gate:acquire()
  final:release()

  local held = gate:acquire()
  local granted = async.run<|nil, value|>(function (): nil
    local permit = gate:acquire()
    defer permit:release()
    trace = trace .. "must-not-run>"
    return nil
  end)
  async.yield()
  local successor = async.run<|nil, value|>(function (): nil
    local permit = gate:acquire()
    defer permit:release()
    trace = trace .. "successor>"
    return nil
  end)
  async.yield()
  held:release()
  -- release grants the first waiter by scheduling its next turn. Cancel in
  -- this same turn to exercise ownership transfer before it resumes.
  granted:cancel(async.CancellationReason.simple(
    "cancel granted compiler request before resume"))
  joins(granted, "granted compiler waiter")
  joins(successor, "successor compiler waiter")
  test.assert(trace == "second>third>successor>",
              "cancelled granted permit did not hand off ownership: " .. trace)
end

function test_compiler_scheduler_serializes_and_hands_off_cancelled_waiters(
    _context: test.Context)
  test_runtime.run(serializes_fifo_and_survives_cancelled_waiter)
end
