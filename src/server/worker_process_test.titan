local test = import "test"
local worker_process = import "server.worker_process.titan"

function test_worker_process_keys_distinct_request_identifiers(
    _context: test.Context)
  test.assert(worker_process.id_key(7) ~= worker_process.id_key("7"),
    "an integer and a string request id shared one key")
  test.assert(worker_process.id_key(7) == worker_process.id_key(7),
    "the same request id produced different keys")
  test.assert(worker_process.id_key("a\"b") ~= worker_process.id_key("a"),
    "a quoted string id collided with its prefix")
  test.assert(worker_process.id_key("titan-ls-worker:1") ~=
    worker_process.id_key("titan-ls-worker:10"),
    "two router-allocated request ids shared one key")
end
