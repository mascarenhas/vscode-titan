local strings = import "string"
local iteration = import "iteration"
local bridge = import "server.compiler_bridge"
local json = import "server.json"
local logging = import "server.logging"
local source_text = import "server.source_text"

-- Symbol identity is nominal at the server boundary even though the compiler
-- bridge supplies its stable representation as a string.
record SymbolId
  const declaration_id: string
end

record Occurrence
  const symbol_id: SymbolId
  const module_name: string
  const filename: string
  const name: string
  const role: bridge.OccurrenceRole
  const span: source_text.Span
  const byte_span: source_text.ByteSpan
  const is_local: boolean
  const visibility: bridge.DeclarationVisibility
  const type_info: bridge.TypeInfo?
  const callable_signature: bridge.CallableSignature?
  const summary_id: integer?
end

record Error
  const module_name: string?
  const filename: string?
  const message: string
end

type Yield = () -> ()

local YIELD_CADENCE = 1024

local record YieldState
  const yield_now: Yield?
  work: integer
end

local record SavedFile
  const module_name: string
  const contents: string
  const coordinates: source_text.CoordinateIndex
end

record Index
  local by_file: {string: {Occurrence}}
  local by_symbol: {string: {Occurrence}}
  local definitions: {string: Occurrence}
  local filenames: {string}
  local coordinates: {string: source_text.CoordinateIndex}
  local summaries: {string: string}
end

local function fail<T>(module_name: string?, filename: string?,
                        message: string): T
  raise Error.new(module_name, filename, message)
end

local function fail_span(module_name: string?, filename: string?,
                         message: string):
    (source_text.Span, source_text.ByteSpan)
  raise Error.new(module_name, filename, message)
end

local function account_work(state: YieldState)
  if state.yield_now == nil then return end
  state.work = state.work + 1
  if state.work < YIELD_CADENCE then return end
  state.work = 0
  state.yield_now()
end

local function role_rank(role: bridge.OccurrenceRole): integer
  case role
  when definition then return 0
  when import_alias then return 1
  when write then return 2
  when reference then return 3
  when type_reference then return 4
  end
end

local function same_role(left: bridge.OccurrenceRole,
                         right: bridge.OccurrenceRole): boolean
  return role_rank(left) == role_rank(right)
end

local function declaration_role(role: bridge.OccurrenceRole): boolean
  case role
  when definition then return true
  when import_alias then return true
  else return false
  end
end

local function same_type(left: bridge.TypeInfo?,
                         right: bridge.TypeInfo?): boolean
  if left == nil or right == nil then return left == nil and right == nil end
  return left.tag == right.tag and left.display == right.display
end

local function optional_type_key(info: bridge.TypeInfo?): string
  if info == nil then return "" end
  return "\1" .. info.tag .. "\0" .. info.display
end

local function optional_signature_key(
    signature: bridge.CallableSignature?): string
  if signature == nil then return "" end
  return "\1" .. signature.display
end

local function optional_summary_key(summary_id: integer?): integer
  if summary_id == nil then return 0 end
  return summary_id
end

local function visibility_rank(
    visibility: bridge.DeclarationVisibility): integer
  case visibility
  when block then return 0
  when module then return 1
  when exported then return 2
  end
end

local function occurrence_less(left: Occurrence,
                               right: Occurrence): boolean
  if left.filename ~= right.filename then
    return left.filename < right.filename
  end
  if left.byte_span.start ~= right.byte_span.start then
    return left.byte_span.start < right.byte_span.start
  end
  if left.byte_span.finish ~= right.byte_span.finish then
    return left.byte_span.finish < right.byte_span.finish
  end
  if left.symbol_id.declaration_id ~= right.symbol_id.declaration_id then
    return left.symbol_id.declaration_id < right.symbol_id.declaration_id
  end
  local left_role = role_rank(left.role)
  local right_role = role_rank(right.role)
  if left_role ~= right_role then return left_role < right_role end
  if left.module_name ~= right.module_name then
    return left.module_name < right.module_name
  end
  if left.name ~= right.name then return left.name < right.name end
  if left.is_local ~= right.is_local then return not left.is_local end
  local left_visibility = visibility_rank(left.visibility)
  local right_visibility = visibility_rank(right.visibility)
  if left_visibility ~= right_visibility then
    return left_visibility < right_visibility
  end
  local left_type = optional_type_key(left.type_info)
  local right_type = optional_type_key(right.type_info)
  if left_type ~= right_type then return left_type < right_type end
  local left_signature = optional_signature_key(left.callable_signature)
  local right_signature = optional_signature_key(right.callable_signature)
  if left_signature ~= right_signature then
    return left_signature < right_signature
  end
  return optional_summary_key(left.summary_id) <
    optional_summary_key(right.summary_id)
end

local function same_occurrence(left: Occurrence,
                               right: Occurrence): boolean
  return left.symbol_id.declaration_id == right.symbol_id.declaration_id and
         left.module_name == right.module_name and
         left.filename == right.filename and
         left.name == right.name and
         same_role(left.role, right.role) and
         left.byte_span.start == right.byte_span.start and
         left.byte_span.finish == right.byte_span.finish and
         left.is_local == right.is_local and
         visibility_rank(left.visibility) ==
           visibility_rank(right.visibility) and
         same_type(left.type_info, right.type_info) and
         optional_signature_key(left.callable_signature) ==
           optional_signature_key(right.callable_signature) and
         left.summary_id == right.summary_id
end

-- Stable bottom-up merge sort avoids both recursion depth and the quadratic
-- shifts of insertion sort. Returning the comparison count gives the
-- source-collaborating regression test a deterministic complexity oracle.
local function sort_occurrences(items: {Occurrence},
                                yield_state: YieldState?): integer
  local count = #items
  if count < 2 then return 0 end

  local source = items
  local target: {Occurrence} = {}
  local source_is_input = true
  local comparisons = 0
  local width = 1
  while width < count do
    local first = 1
    while first <= count do
      local left = first
      local left_finish = first + width - 1
      if left_finish > count then left_finish = count end
      local right = left_finish + 1
      local right_finish = right + width - 1
      if right_finish > count then right_finish = count end
      local output = first

      while left <= left_finish and right <= right_finish do
        if yield_state ~= nil then account_work(yield_state) end
        comparisons = comparisons + 1
        if occurrence_less(source[right], source[left]) then
          target[output] = source[right]
          right = right + 1
        else
          -- Equal values stay in input order, making the sort stable even
          -- before exact duplicates are collapsed.
          target[output] = source[left]
          left = left + 1
        end
        output = output + 1
      end
      while left <= left_finish do
        if yield_state ~= nil then account_work(yield_state) end
        target[output] = source[left]
        left = left + 1
        output = output + 1
      end
      while right <= right_finish do
        if yield_state ~= nil then account_work(yield_state) end
        target[output] = source[right]
        right = right + 1
        output = output + 1
      end
      first = right_finish + 1
    end

    local swap = source
    source = target
    target = swap
    source_is_input = not source_is_input
    if width > count // 2 then
      width = count
    else
      width = width * 2
    end
  end

  if not source_is_input then
    for index = 1, count do
      if yield_state ~= nil then account_work(yield_state) end
      items[index] = source[index]
    end
  end
  return comparisons
end

-- Compiler locations are one-based byte columns. Convert them to a zero-based
-- byte offset first; SourceText remains the sole owner of UTF-8/UTF-16
-- validation and conversion.
local function location_offset(coordinates: source_text.CoordinateIndex,
                               location: bridge.SourceLocation,
                               module_name: string): integer
  if location.line < 1 then
    return fail<integer>(module_name, location.filename,
      "compiler span has a non-positive line")
  end
  if location.column < 1 then
    return fail<integer>(module_name, location.filename,
      "compiler span has a non-positive column")
  end
  local start_offset? = coordinates:lf_line_start(location.line)
  if start_offset == nil then
    return fail<integer>(module_name, location.filename,
      "compiler span line is outside the saved source")
  end
  local target_offset? = coordinates:offset_for_lf_byte_position(
    location.line, location.column)
  if target_offset == nil then
    return fail<integer>(module_name, location.filename,
      "compiler span column is outside its saved source line")
  end
  return target_offset
end

local function validate_span(module_name: string, saved: SavedFile,
                             symbol: bridge.SymbolOccurrence):
    (source_text.Span, source_text.ByteSpan)
  local exact? = symbol.exact_span
  if exact == nil then
    return fail_span(
      module_name, symbol.location.filename,
      "internal error: missing exact compiler span reached validation")
  end
  if exact.start.filename ~= symbol.location.filename or
     exact.finish.filename ~= symbol.location.filename then
    return fail_span(
      module_name, symbol.location.filename,
      "exact compiler span crosses or changes source files")
  end
  if exact.start.line ~= symbol.location.line or
     exact.start.column ~= symbol.location.column then
    return fail_span(
      module_name, symbol.location.filename,
      "exact compiler span does not start at the occurrence location")
  end
  if exact.finish.line ~= exact.start.line then
    return fail_span(
      module_name, symbol.location.filename,
      "identifier span crosses a source line")
  end

  local start_offset = location_offset(
    saved.coordinates, exact.start, module_name)
  local finish_offset = location_offset(
    saved.coordinates, exact.finish, module_name)
  if finish_offset < start_offset then
    return fail_span(
      module_name, symbol.location.filename,
      "identifier span finishes before it starts")
  end
  local actual = strings.sub(saved.contents, start_offset + 1, finish_offset)
  if actual ~= symbol.name then
    return fail_span(
      module_name, symbol.location.filename,
      "saved source does not contain identifier '" .. symbol.name ..
      "' at the compiler's exact span")
  end

  local span?, span_error? = saved.coordinates:span_for_offsets(
    start_offset, finish_offset)
  if span == nil then
    local detail = "invalid UTF-8 boundary"
    if span_error ~= nil then detail = span_error.message end
    return fail_span(
      module_name, symbol.location.filename,
      "cannot convert compiler span to LSP coordinates: " .. detail)
  end
  return span, source_text.ByteSpan.new(start_offset, finish_offset)
end

local function index_coordinates(contents: string,
                                 yield_state: YieldState):
    source_text.CoordinateIndex
  if yield_state.yield_now ~= nil then
    return source_text.coordinate_index_with_account(
      contents, function () account_work(yield_state) end)
  end
  return source_text.coordinate_index(contents)
end

local function project_files(projects: {bridge.ProjectModule},
                             yield_state: YieldState):
    ({string: SavedFile}, {string: boolean},
     {string: source_text.CoordinateIndex})
  local files: {string: SavedFile} = {}
  local modules: {string: boolean} = {}
  local coordinates: {string: source_text.CoordinateIndex} = {}
  for project_index = 1, #projects do
    account_work(yield_state)
    local project = projects[project_index]
    if modules[project.module_name] then
      fail<value>(project.module_name, nil,
        "duplicate saved project module")
    end
    modules[project.module_name] = true
    for file_index = 1, #project.files do
      account_work(yield_state)
      local file = project.files[file_index]
      if files[file.filename] ~= nil then
        fail<value>(project.module_name, file.filename,
          "saved source file belongs to more than one project module")
      end
      local indexed = index_coordinates(file.contents, yield_state)
      files[file.filename] = SavedFile.new(
        project.module_name, file.contents, indexed)
      coordinates[file.filename] = indexed
    end
  end
  return files, modules, coordinates
end

local function summary_key(module_name: string, summary_id: integer): string
  return module_name .. "\0" .. strings.tostring(summary_id)
end

local function summary_kind_label(kind: bridge.HoverSummaryKind): string
  case kind
  when module_summary then return "module"
  when record_summary then return "record"
  when union_summary then return "union"
  when interface_summary then return "interface"
  end
end

local function render_hover_summary(summary: bridge.HoverSummary,
                                    yield_state: YieldState): string
  local output = strings.writer()
  output:write("**")
  output:write(summary_kind_label(summary.kind))
  output:write("** `")
  output:write(summary.title)
  output:write("`\n")
  for section_index = 1, #summary.sections do
    account_work(yield_state)
    local section = summary.sections[section_index]
    output:write("\n")
    output:write(section.heading)
    output:write("\n\n")
    for line_index = 1, #section.lines do
      account_work(yield_state)
      output:write("- `")
      output:write(section.lines[line_index])
      output:write("`\n")
    end
  end
  return output:drain()
end

local function project_snapshot(snapshot: bridge.ModuleSnapshot): boolean
  case snapshot.provenance
  when project_source then return true
  else return false
  end
end

local function append_snapshot_summaries(
    target: {string: string}, snapshot: bridge.ModuleSnapshot,
    projects: {string: boolean}, yield_state: YieldState)
  if not project_snapshot(snapshot) then return end
  if not projects[snapshot.module_name] then
    fail<value>(snapshot.module_name, nil,
      "project compiler snapshot has no matching saved project module")
  end
  local summaries? = snapshot.hover_summaries
  if summaries == nil then return end
  for index = 1, #summaries do
    account_work(yield_state)
    local summary = summaries[index]
    if summary.id ~= index then
      fail<value>(snapshot.module_name, nil,
        "hover summary id does not match its snapshot-local registry slot")
    end
    local key = summary_key(snapshot.module_name, summary.id)
    if target[key] ~= nil then
      fail<value>(snapshot.module_name, nil,
        "duplicate snapshot-local hover summary id")
    end
    target[key] = render_hover_summary(summary, yield_state)
  end
end

local function validated_summary_id(snapshot: bridge.ModuleSnapshot,
                                    symbol: bridge.SymbolOccurrence): integer?
  local id? = symbol.summary_id
  if id == nil then return nil end
  if id <= 0 then
    return fail<integer>(snapshot.module_name, symbol.location.filename,
      "compiler occurrence has a non-positive hover summary id")
  end
  local summaries? = snapshot.hover_summaries
  if summaries == nil or id > #summaries or summaries[id].id ~= id then
    return fail<integer>(snapshot.module_name, symbol.location.filename,
      "compiler occurrence references an unknown hover summary id")
  end
  return id
end

local function append_snapshot_occurrences(
    target: {Occurrence}, snapshot: bridge.ModuleSnapshot,
    files: {string: SavedFile}, projects: {string: boolean},
    yield_state: YieldState)
  case snapshot.provenance
  when project_source then
  else
    -- External source and binary snapshots never contribute source locations.
    return
  end
  if not projects[snapshot.module_name] then
    fail<value>(snapshot.module_name, nil,
      "project compiler snapshot has no matching saved project module")
  end

  for index = 1, #snapshot.symbols do
    account_work(yield_state)
    local symbol = snapshot.symbols[index]
    local summary_id? = validated_summary_id(snapshot, symbol)
    local saved? = files[symbol.location.filename]
    -- A compiler declaration object from an imported module can be reachable
    -- from a project AST. It is not owned by this snapshot and must not leak
    -- external or duplicate project declarations into the index.
    if saved ~= nil and saved.module_name == snapshot.module_name and
       symbol.declaration_id ~= nil and symbol.exact_span ~= nil then
      if symbol.declaration_id == "" then
        fail<value>(snapshot.module_name, symbol.location.filename,
          "compiler occurrence has an empty declaration identity")
      end
      if symbol.name == "" then
        fail<value>(snapshot.module_name, symbol.location.filename,
          "compiler occurrence has an empty identifier")
      end
      local span, bytes = validate_span(snapshot.module_name, saved, symbol)
      target[#target + 1] = Occurrence.new(
        SymbolId.new(symbol.declaration_id), snapshot.module_name,
        symbol.location.filename, symbol.name, symbol.role, span, bytes,
        symbol.is_local, symbol.visibility, symbol.type_info,
        symbol.callable_signature,
        summary_id)
    end
  end
end

local function normalize_occurrences(items: {Occurrence},
                                     yield_state: YieldState): {Occurrence}
  local result: {Occurrence} = {}
  for index = 1, #items do
    account_work(yield_state)
    local item = items[index]
    local previous? = result[#result]
    if previous ~= nil and same_occurrence(previous, item) then
      -- The bridge may encounter one AST table through multiple paths. One
      -- physical semantic occurrence is indexed once.
    else
      if previous ~= nil and previous.filename == item.filename and
         item.byte_span.start < previous.byte_span.finish then
        return fail<{Occurrence}>(item.module_name, item.filename,
          "compiler symbol spans overlap in saved source")
      end
      result[#result + 1] = item
    end
  end
  return result
end

local function build_internal(projects: {bridge.ProjectModule},
                              snapshots: {bridge.ModuleSnapshot},
                              yield_now: Yield?): Index
  local started = logging.clock()
  logging.emit("debug", "semantic_index.build.start", {
    json.Member.new("project_modules", json.from_integer(#projects)),
    json.Member.new("snapshots", json.from_integer(#snapshots)),
  })
  local yield_state = YieldState.new(yield_now, 0)
  local files, project_names, coordinates =
    project_files(projects, yield_state)
  local raw: {Occurrence} = {}
  local summaries: {string: string} = {}
  for index = 1, #snapshots do
    account_work(yield_state)
    append_snapshot_summaries(
      summaries, snapshots[index], project_names, yield_state)
    append_snapshot_occurrences(
      raw, snapshots[index], files, project_names, yield_state)
  end
  local comparisons = sort_occurrences(raw, yield_state)
  local occurrences = normalize_occurrences(raw, yield_state)
  local by_file: {string: {Occurrence}} = {}
  local by_symbol: {string: {Occurrence}} = {}
  local definitions: {string: Occurrence} = {}
  local filenames: {string} = {}

  for index = 1, #occurrences do
    account_work(yield_state)
    local occurrence = occurrences[index]
    local file_bucket? = by_file[occurrence.filename]
    if file_bucket == nil then
      file_bucket = {}
      by_file[occurrence.filename] = file_bucket
      filenames[#filenames + 1] = occurrence.filename
    end
    file_bucket[#file_bucket + 1] = occurrence

    local key = occurrence.symbol_id.declaration_id
    local symbol_bucket? = by_symbol[key]
    if symbol_bucket == nil then
      symbol_bucket = {}
      by_symbol[key] = symbol_bucket
    end
    symbol_bucket[#symbol_bucket + 1] = occurrence

    if declaration_role(occurrence.role) then
      local old? = definitions[key]
      if old ~= nil then
        return fail<Index>(occurrence.module_name, occurrence.filename,
          "symbol '" .. key .. "' has more than one exact declaration")
      end
      definitions[key] = occurrence
    end
  end
  logging.emit("info", "semantic_index.build.complete", {
    json.Member.new("files", json.from_integer(#filenames)),
    json.Member.new("raw_occurrences", json.from_integer(#raw)),
    json.Member.new("occurrences", json.from_integer(#occurrences)),
    json.Member.new("comparisons", json.from_integer(comparisons)),
    json.Member.new("cpu_ms", json.from_number(
      logging.elapsed_ms(started))),
  })
  return Index.new(
    by_file, by_symbol, definitions, filenames, coordinates, summaries)
end

function build(projects: {bridge.ProjectModule},
               snapshots: {bridge.ModuleSnapshot}): Index
  return build_internal(projects, snapshots, nil)
end

function build_with_yield(projects: {bridge.ProjectModule},
                          snapshots: {bridge.ModuleSnapshot},
                          yield_now: Yield): Index
  return build_internal(projects, snapshots, yield_now)
end

local function copy_occurrences(items: {Occurrence}): {Occurrence}
  local result: {Occurrence} = {}
  for index = 1, #items do result[index] = items[index] end
  return result
end

function Index:file_names(): {string}
  local result: {string} = {}
  for index = 1, #self.filenames do result[index] = self.filenames[index] end
  return result
end

function Index:coordinate_index(filename: string):
    source_text.CoordinateIndex?
  return self.coordinates[filename]
end

function Index:hover_summary(occurrence: Occurrence): string?
  local summary_id? = occurrence.summary_id
  if summary_id == nil then return nil end
  return self.summaries[summary_key(occurrence.module_name, summary_id)]
end

function Index:hover_summary_count(): integer
  local count = 0
  for _ in iteration.pairs<string, string>(self.summaries) do
    count = count + 1
  end
  return count
end

function Index:file_occurrences(filename: string): {Occurrence}
  local items? = self.by_file[filename]
  if items == nil then return {} end
  return copy_occurrences(items)
end

local function position_less(left: source_text.Position,
                             right: source_text.Position): boolean
  return left.line < right.line or
         (left.line == right.line and left.character < right.character)
end

local function position_equal(left: source_text.Position,
                              right: source_text.Position): boolean
  return left.line == right.line and left.character == right.character
end

function Index:occurrence_at(filename: string,
                             position: source_text.Position): Occurrence?
  local items? = self.by_file[filename]
  if items == nil then return nil end
  for index = 1, #items do
    local item = items[index]
    if position_less(position, item.span.start) then return nil end
    if (position_equal(position, item.span.start) or
        position_less(item.span.start, position)) and
       position_less(position, item.span.finish) then
      return item
    end
  end
  return nil
end

function Index:definition(symbol_id: SymbolId): Occurrence?
  return self.definitions[symbol_id.declaration_id]
end

function Index:occurrences(symbol_id: SymbolId,
                           include_declaration: boolean): {Occurrence}
  local items? = self.by_symbol[symbol_id.declaration_id]
  if items == nil then return {} end
  if include_declaration then return copy_occurrences(items) end
  local result: {Occurrence} = {}
  for index = 1, #items do
    if not declaration_role(items[index].role) then
      result[#result + 1] = items[index]
    end
  end
  return result
end
