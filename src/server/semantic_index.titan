local strings = import "string"
local iteration = import "iteration"
local bridge = import "server.compiler_bridge"
local source_text = import "server.source_text"
local sqlite3 = import "sqlite3"
local workspace_store = import "server.workspace_store"

-- Symbol identity is nominal at the server boundary even though the compiler
-- bridge supplies its stable representation as a string.
record SymbolId
  const declaration_id: string
end

record Occurrence
  const symbol_id: SymbolId
  const module_name: string
  const filename: string
  const name: string
  const role: bridge.OccurrenceRole
  const span: source_text.Span
  const byte_span: source_text.ByteSpan
  const is_local: boolean
  const visibility: bridge.DeclarationVisibility
  const type_info: bridge.TypeInfo?
  const callable_signature: bridge.CallableSignature?
  const summary_id: integer?
end

record Error
  const module_name: string?
  const filename: string?
  const message: string
end

type Yield = () -> ()

local YIELD_CADENCE = 1024

local record YieldState
  const yield_now: Yield?
  work: integer
end

local record SavedFile
  const module_name: string
  const contents: string
  const coordinates: source_text.CoordinateIndex
end

-- Prepared data belongs only to one publication attempt. Query facades retain
-- neither source/AST maps nor occurrence buckets after that attempt finishes.
record Prepared
  const projects: {bridge.ProjectModule}
  const occurrences: {Occurrence}
  local const files: {string: SavedFile}
  local const summaries: {string: string}
end

record Index
  local const store: workspace_store.Store
  local const published_generation: integer
  local const owns_store: boolean
end

record StaleView
  const expected_generation: integer
  const actual_generation: integer
end

local function fail<T>(module_name: string?, filename: string?,
                        message: string): T
  raise Error.new(module_name, filename, message)
end

local function fail_span(module_name: string?, filename: string?,
                         message: string):
    (source_text.Span, source_text.ByteSpan)
  raise Error.new(module_name, filename, message)
end

local function account_work(state: YieldState)
  if state.yield_now == nil then return end
  state.work = state.work + 1
  if state.work < YIELD_CADENCE then return end
  state.work = 0
  state.yield_now()
end

local function role_rank(role: bridge.OccurrenceRole): integer
  case role
  when definition then return 0
  when import_alias then return 1
  when write then return 2
  when reference then return 3
  when type_reference then return 4
  end
end

-- Compiler locations are one-based byte columns. Convert them to a zero-based
-- byte offset first; SourceText remains the sole owner of UTF-8/UTF-16
-- validation and conversion.
local function location_offset(coordinates: source_text.CoordinateIndex,
                               location: bridge.SourceLocation,
                               module_name: string): integer
  if location.line < 1 then
    return fail<integer>(module_name, location.filename,
      "compiler span has a non-positive line")
  end
  if location.column < 1 then
    return fail<integer>(module_name, location.filename,
      "compiler span has a non-positive column")
  end
  local start_offset? = coordinates:lf_line_start(location.line)
  if start_offset == nil then
    return fail<integer>(module_name, location.filename,
      "compiler span line is outside the saved source")
  end
  local target_offset? = coordinates:offset_for_lf_byte_position(
    location.line, location.column)
  if target_offset == nil then
    return fail<integer>(module_name, location.filename,
      "compiler span column is outside its saved source line")
  end
  return target_offset
end

local function validate_span(module_name: string, saved: SavedFile,
                             symbol: bridge.SymbolOccurrence):
    (source_text.Span, source_text.ByteSpan)
  local exact? = symbol.exact_span
  if exact == nil then
    return fail_span(
      module_name, symbol.location.filename,
      "internal error: missing exact compiler span reached validation")
  end
  if exact.start.filename ~= symbol.location.filename or
     exact.finish.filename ~= symbol.location.filename then
    return fail_span(
      module_name, symbol.location.filename,
      "exact compiler span crosses or changes source files")
  end
  if exact.start.line ~= symbol.location.line or
     exact.start.column ~= symbol.location.column then
    return fail_span(
      module_name, symbol.location.filename,
      "exact compiler span does not start at the occurrence location")
  end
  if exact.finish.line ~= exact.start.line then
    return fail_span(
      module_name, symbol.location.filename,
      "identifier span crosses a source line")
  end

  local start_offset = location_offset(
    saved.coordinates, exact.start, module_name)
  local finish_offset = location_offset(
    saved.coordinates, exact.finish, module_name)
  if finish_offset < start_offset then
    return fail_span(
      module_name, symbol.location.filename,
      "identifier span finishes before it starts")
  end
  local actual = strings.sub(saved.contents, start_offset + 1, finish_offset)
  if actual ~= symbol.name then
    return fail_span(
      module_name, symbol.location.filename,
      "saved source does not contain identifier '" .. symbol.name ..
      "' at the compiler's exact span")
  end

  local span?, span_error? = saved.coordinates:span_for_offsets(
    start_offset, finish_offset)
  if span == nil then
    local detail = "invalid UTF-8 boundary"
    if span_error ~= nil then detail = span_error.message end
    return fail_span(
      module_name, symbol.location.filename,
      "cannot convert compiler span to LSP coordinates: " .. detail)
  end
  return span, source_text.ByteSpan.new(start_offset, finish_offset)
end

local function index_coordinates(contents: string,
                                 yield_state: YieldState):
    source_text.CoordinateIndex
  if yield_state.yield_now ~= nil then
    return source_text.coordinate_index_with_account(
      contents, function () account_work(yield_state) end)
  end
  return source_text.coordinate_index(contents)
end

local function project_files(projects: {bridge.ProjectModule},
                             yield_state: YieldState):
    ({string: SavedFile}, {string: boolean},
     {string: source_text.CoordinateIndex})
  local files: {string: SavedFile} = {}
  local modules: {string: boolean} = {}
  local coordinates: {string: source_text.CoordinateIndex} = {}
  for project_index = 1, #projects do
    account_work(yield_state)
    local project = projects[project_index]
    if modules[project.module_name] then
      fail<value>(project.module_name, nil,
        "duplicate saved project module")
    end
    modules[project.module_name] = true
    for file_index = 1, #project.files do
      account_work(yield_state)
      local file = project.files[file_index]
      if files[file.filename] ~= nil then
        fail<value>(project.module_name, file.filename,
          "saved source file belongs to more than one project module")
      end
      local indexed = index_coordinates(file.contents, yield_state)
      files[file.filename] = SavedFile.new(
        project.module_name, file.contents, indexed)
      coordinates[file.filename] = indexed
    end
  end
  return files, modules, coordinates
end

local function summary_key(module_name: string, summary_id: integer): string
  return module_name .. "\0" .. strings.tostring(summary_id)
end

local function summary_kind_label(kind: bridge.HoverSummaryKind): string
  case kind
  when module_summary then return "module"
  when record_summary then return "record"
  when union_summary then return "union"
  when interface_summary then return "interface"
  end
end

local function render_hover_summary(summary: bridge.HoverSummary,
                                    yield_state: YieldState): string
  local output = strings.writer()
  output:write("**")
  output:write(summary_kind_label(summary.kind))
  output:write("** `")
  output:write(summary.title)
  output:write("`\n")
  for section_index = 1, #summary.sections do
    account_work(yield_state)
    local section = summary.sections[section_index]
    output:write("\n")
    output:write(section.heading)
    output:write("\n\n")
    for line_index = 1, #section.lines do
      account_work(yield_state)
      output:write("- `")
      output:write(section.lines[line_index])
      output:write("`\n")
    end
  end
  return output:drain()
end

local function project_snapshot(snapshot: bridge.ModuleSnapshot): boolean
  case snapshot.provenance
  when project_source then return true
  else return false
  end
end

local function append_snapshot_summaries(
    target: {string: string}, snapshot: bridge.ModuleSnapshot,
    projects: {string: boolean}, yield_state: YieldState)
  if not project_snapshot(snapshot) then return end
  if not projects[snapshot.module_name] then
    fail<value>(snapshot.module_name, nil,
      "project compiler snapshot has no matching saved project module")
  end
  local summaries? = snapshot.hover_summaries
  if summaries == nil then return end
  for index = 1, #summaries do
    account_work(yield_state)
    local summary = summaries[index]
    if summary.id ~= index then
      fail<value>(snapshot.module_name, nil,
        "hover summary id does not match its snapshot-local registry slot")
    end
    local key = summary_key(snapshot.module_name, summary.id)
    if target[key] ~= nil then
      fail<value>(snapshot.module_name, nil,
        "duplicate snapshot-local hover summary id")
    end
    target[key] = render_hover_summary(summary, yield_state)
  end
end

local function validated_summary_id(snapshot: bridge.ModuleSnapshot,
                                    symbol: bridge.SymbolOccurrence): integer?
  local id? = symbol.summary_id
  if id == nil then return nil end
  if id <= 0 then
    return fail<integer>(snapshot.module_name, symbol.location.filename,
      "compiler occurrence has a non-positive hover summary id")
  end
  local summaries? = snapshot.hover_summaries
  if summaries == nil or id > #summaries or summaries[id].id ~= id then
    return fail<integer>(snapshot.module_name, symbol.location.filename,
      "compiler occurrence references an unknown hover summary id")
  end
  return id
end

local function append_snapshot_occurrences(
    target: {Occurrence}, snapshot: bridge.ModuleSnapshot,
    files: {string: SavedFile}, projects: {string: boolean},
    yield_state: YieldState)
  case snapshot.provenance
  when project_source then
  else
    -- External source and binary snapshots never contribute source locations.
    return
  end
  if not projects[snapshot.module_name] then
    fail<value>(snapshot.module_name, nil,
      "project compiler snapshot has no matching saved project module")
  end

  for index = 1, #snapshot.symbols do
    account_work(yield_state)
    local symbol = snapshot.symbols[index]
    local summary_id? = validated_summary_id(snapshot, symbol)
    local saved? = files[symbol.location.filename]
    -- A compiler declaration object from an imported module can be reachable
    -- from a project AST. It is not owned by this snapshot and must not leak
    -- external or duplicate project declarations into the index.
    if saved ~= nil and saved.module_name == snapshot.module_name and
       symbol.declaration_id ~= nil and symbol.exact_span ~= nil then
      if symbol.declaration_id == "" then
        fail<value>(snapshot.module_name, symbol.location.filename,
          "compiler occurrence has an empty declaration identity")
      end
      if symbol.name == "" then
        fail<value>(snapshot.module_name, symbol.location.filename,
          "compiler occurrence has an empty identifier")
      end
      local span, bytes = validate_span(snapshot.module_name, saved, symbol)
      target[#target + 1] = Occurrence.new(
        SymbolId.new(symbol.declaration_id), snapshot.module_name,
        symbol.location.filename, symbol.name, symbol.role, span, bytes,
        symbol.is_local, symbol.visibility, symbol.type_info,
        symbol.callable_signature,
        summary_id)
    end
  end
end

function prepare(projects: {bridge.ProjectModule},
                 snapshots: {bridge.ModuleSnapshot},
                 yield_now: Yield?): Prepared
  local state = YieldState.new(yield_now, 0)
  local files, project_names = project_files(projects, state)
  local occurrences: {Occurrence} = {}
  local summaries: {string: string} = {}
  for index = 1, #snapshots do
    account_work(state)
    append_snapshot_summaries(summaries, snapshots[index], project_names, state)
    append_snapshot_occurrences(
      occurrences, snapshots[index], files, project_names, state)
  end
  return Prepared.new(projects, occurrences, files, summaries)
end

function Prepared:coordinate_index(filename: string):
    source_text.CoordinateIndex?
  local saved? = self.files[filename]
  if saved == nil then return nil end
  return saved.coordinates
end

function execute(connection: sqlite3.Connection, sql: string)
  local statement = connection:prepare(sql)
  defer statement:close()
  statement:execute()
end

function bytes(row: sqlite3.Row, column: integer): string
  return (row:get(column) as sqlite3.Blob).bytes
end

function optional_bytes(row: sqlite3.Row, column: integer): string?
  local item = row:get(column)
  if item == nil then return nil end
  return (item as sqlite3.Blob).bytes
end

function blob(item: string?): sqlite3.Blob?
  if item == nil then return nil end
  return sqlite3.Blob.new(item)
end

function type_tag(info: bridge.TypeInfo?): sqlite3.Blob?
  if info == nil then return nil end
  return blob(info.tag)
end

function type_display(info: bridge.TypeInfo?): sqlite3.Blob?
  if info == nil then return nil end
  return blob(info.display)
end

function row_type(row: sqlite3.Row, column: integer): bridge.TypeInfo?
  local tag? = optional_bytes(row, column)
  if tag == nil then return nil end
  return bridge.TypeInfo.new(tag, bytes(row, column + 1))
end

local function signature_blob(signature: bridge.CallableSignature?):
    sqlite3.Blob?
  if signature == nil then return nil end
  return blob(signature.display)
end

local OCCURRENCE_COLUMNS = "declaration_id,module_name,filename,name,role," ..
  "start_line,start_character,finish_line,finish_character,byte_start," ..
  "byte_finish,is_local,visibility,type_tag,type_display,callable,summary_id"
local SOURCE_ORDER = " ORDER BY filename,byte_start,byte_finish,declaration_id,role"

function initialize_schema(connection: sqlite3.Connection)
  execute(connection, "CREATE TABLE IF NOT EXISTS main.semantic_projects(" ..
    "module_name BLOB PRIMARY KEY,module_order INTEGER NOT NULL)")
  execute(connection, "CREATE TABLE IF NOT EXISTS main.semantic_files(" ..
    "filename BLOB PRIMARY KEY,module_name BLOB NOT NULL,contents BLOB NOT NULL," ..
    "module_order INTEGER NOT NULL,file_order INTEGER NOT NULL," ..
    "FOREIGN KEY(module_name) REFERENCES semantic_projects(module_name))")
  execute(connection, "CREATE TABLE IF NOT EXISTS main.semantic_summaries(" ..
    "identity BLOB PRIMARY KEY,markdown BLOB NOT NULL)")
  execute(connection, "CREATE TABLE IF NOT EXISTS main.semantic_occurrences(" ..
    "declaration_id BLOB NOT NULL,module_name BLOB NOT NULL," ..
    "filename BLOB NOT NULL,name BLOB NOT NULL,role INTEGER NOT NULL," ..
    "start_line INTEGER NOT NULL,start_character INTEGER NOT NULL," ..
    "finish_line INTEGER NOT NULL,finish_character INTEGER NOT NULL," ..
    "byte_start INTEGER NOT NULL,byte_finish INTEGER NOT NULL," ..
    "is_local INTEGER NOT NULL,visibility INTEGER NOT NULL," ..
    "type_tag BLOB,type_display BLOB,callable BLOB,summary_id INTEGER)")
  execute(connection, "CREATE TABLE IF NOT EXISTS main.semantic_occurrence_inputs AS " ..
    "SELECT " .. OCCURRENCE_COLUMNS .. " FROM main.semantic_occurrences WHERE 0")
  execute(connection, "CREATE INDEX IF NOT EXISTS main.semantic_occurrences_file " ..
    "ON semantic_occurrences(filename,start_line,start_character)")
  execute(connection, "CREATE INDEX IF NOT EXISTS main.semantic_occurrences_symbol " ..
    "ON semantic_occurrences(declaration_id,filename,byte_start)")
  execute(connection, "CREATE UNIQUE INDEX IF NOT EXISTS main.semantic_declarations " ..
    "ON semantic_occurrences(declaration_id) WHERE role IN (0,1)")
end

local function visibility_rank(visibility: bridge.DeclarationVisibility): integer
  case visibility
  when block then return 0
  when module then return 1
  when exported then return 2
  end
end

-- Arrays use nil assignment to clear positions, so NULL belongs in SQL syntax
-- rather than a variadic binding array. Every non-NULL value remains bound.
function binding(parameters: {value}, item: value): string
  if item == nil then return "NULL" end
  parameters[#parameters + 1] = item
  return "?"
end

-- Eleven rows stay below Titan's 200-position variadic-call limit even when
-- all seventeen columns are non-NULL. SQL orders and normalizes the rows.
local function publish_occurrences(connection: sqlite3.Connection,
                                   items: {Occurrence})
  local offset = 1
  while offset <= #items do
    local finish = offset + 10
    if finish > #items then finish = #items end
    local parameters: {value} = {}
    local sql = "INSERT INTO main.semantic_occurrence_inputs VALUES "
    for index = offset, finish do
      if index > offset then sql = sql .. "," end
      local item = items[index]
      sql = sql .. "(" .. binding(parameters, blob(item.symbol_id.declaration_id)) .. "," ..
        binding(parameters, blob(item.module_name)) .. "," ..
        binding(parameters, blob(item.filename)) .. "," ..
        binding(parameters, blob(item.name)) .. "," ..
        binding(parameters, role_rank(item.role)) .. "," ..
        binding(parameters, item.span.start.line) .. "," ..
        binding(parameters, item.span.start.character) .. "," ..
        binding(parameters, item.span.finish.line) .. "," ..
        binding(parameters, item.span.finish.character) .. "," ..
        binding(parameters, item.byte_span.start) .. "," ..
        binding(parameters, item.byte_span.finish) .. "," ..
        binding(parameters, item.is_local) .. "," ..
        binding(parameters, visibility_rank(item.visibility)) .. "," ..
        binding(parameters, type_tag(item.type_info)) .. "," ..
        binding(parameters, type_display(item.type_info)) .. "," ..
        binding(parameters, signature_blob(item.callable_signature)) .. "," ..
        binding(parameters, item.summary_id) .. ")"
    end
    local statement = connection:prepare(sql)
    defer statement:close()
    statement:execute(...parameters)
    offset = finish + 1
  end
end

local function validate_published(connection: sqlite3.Connection)
  execute(connection, "DELETE FROM main.semantic_occurrence_inputs WHERE rowid NOT IN " ..
    "(SELECT MIN(rowid) FROM main.semantic_occurrence_inputs GROUP BY " ..
    OCCURRENCE_COLUMNS .. ")")
  do
    local statement = connection:prepare(
      "SELECT module_name,filename FROM (SELECT module_name,filename,byte_start," ..
      "LAG(byte_finish) OVER (PARTITION BY filename ORDER BY byte_start," ..
      "byte_finish,declaration_id,role) AS previous_finish " ..
      "FROM main.semantic_occurrence_inputs) WHERE byte_start < previous_finish LIMIT 1")
    defer statement:close()
    local cursor = statement:query()
    defer cursor:close()
    local row? = cursor:fetch()
    if row ~= nil then
      fail<value>(bytes(row, 1), bytes(row, 2),
        "compiler symbol spans overlap in saved source")
    end
  end
  do
    local statement = connection:prepare(
      "SELECT module_name,filename,declaration_id FROM main.semantic_occurrence_inputs " ..
      "WHERE role IN (0,1) GROUP BY declaration_id HAVING COUNT(*) > 1 LIMIT 1")
    defer statement:close()
    local cursor = statement:query()
    defer cursor:close()
    local row? = cursor:fetch()
    if row ~= nil then
      fail<value>(bytes(row, 1), bytes(row, 2),
        "symbol '" .. bytes(row, 3) .. "' has more than one exact declaration")
    end
  end
end

function Prepared:publish(connection: sqlite3.Connection)
  execute(connection, "DELETE FROM main.semantic_occurrences")
  execute(connection, "DELETE FROM main.semantic_occurrence_inputs")
  execute(connection, "DELETE FROM main.semantic_files")
  execute(connection, "DELETE FROM main.semantic_projects")
  execute(connection, "DELETE FROM main.semantic_summaries")
  do
    local insert = connection:prepare("INSERT INTO main.semantic_projects VALUES (?,?)")
    defer insert:close()
    for module_index = 1, #self.projects do
      insert:execute(blob(self.projects[module_index].module_name), module_index)
    end
  end
  -- Build fixed-size file batches without retaining a second file registry.
  local file_bindings: {value} = {}
  local file_sql = "INSERT INTO main.semantic_files VALUES "
  local file_count = 0
  for module_index = 1, #self.projects do
    local project = self.projects[module_index]
    for file_index = 1, #project.files do
      local file = project.files[file_index]
      if file_count > 0 then file_sql = file_sql .. "," end
      file_sql = file_sql .. "(" .. binding(file_bindings, blob(file.filename)) .. "," ..
        binding(file_bindings, blob(project.module_name)) .. "," ..
        binding(file_bindings, blob(file.contents)) .. "," ..
        binding(file_bindings, module_index) .. "," ..
        binding(file_bindings, file_index) .. ")"
      file_count = file_count + 1
      if file_count == 40 then
        local statement = connection:prepare(file_sql)
        defer statement:close()
        statement:execute(...file_bindings)
        file_bindings = {}
        file_sql = "INSERT INTO main.semantic_files VALUES "
        file_count = 0
      end
    end
  end
  if file_count > 0 then
    local statement = connection:prepare(file_sql)
    defer statement:close()
    statement:execute(...file_bindings)
  end
  local summary_bindings: {value} = {}
  local summary_sql = "INSERT INTO main.semantic_summaries VALUES "
  local summary_count = 0
  for key, markdown in iteration.pairs<string, string>(self.summaries) do
    if summary_count > 0 then summary_sql = summary_sql .. "," end
    summary_sql = summary_sql .. "(" .. binding(summary_bindings, blob(key)) .. "," ..
      binding(summary_bindings, blob(markdown)) .. ")"
    summary_count = summary_count + 1
    if summary_count == 100 then
      local statement = connection:prepare(summary_sql)
      defer statement:close()
      statement:execute(...summary_bindings)
      summary_bindings = {}
      summary_sql = "INSERT INTO main.semantic_summaries VALUES "
      summary_count = 0
    end
  end
  if summary_count > 0 then
    local statement = connection:prepare(summary_sql)
    defer statement:close()
    statement:execute(...summary_bindings)
  end
  publish_occurrences(connection, self.occurrences)
  validate_published(connection)
  execute(connection, "INSERT INTO main.semantic_occurrences SELECT " ..
    OCCURRENCE_COLUMNS .. " FROM main.semantic_occurrence_inputs")
  execute(connection, "DELETE FROM main.semantic_occurrence_inputs")
end

function check_generation(connection: sqlite3.Connection, expected: integer)
  local statement = connection:prepare(
    "SELECT published_generation FROM main.store_state WHERE singleton=1")
  defer statement:close()
  local cursor = statement:query()
  defer cursor:close()
  local row? = cursor:fetch()
  local actual = -1
  if row ~= nil then actual = row:get(1) as integer end
  if actual ~= expected then raise StaleView.new(expected, actual) end
end

function open(store: workspace_store.Store, published_generation: integer): Index
  return Index.new(store, published_generation, false)
end

function Index:close()
  if self.owns_store then self.store:close() end
end

local function build_internal(projects: {bridge.ProjectModule},
                              snapshots: {bridge.ModuleSnapshot},
                              yield_now: Yield?): Index
  local prepared = prepare(projects, snapshots, yield_now)
  local store = workspace_store.open(":memory:")
  local completed = false
  defer do
    if not completed then store:close() end
  end
  do
    local access = store:acquire()
    defer access:release()
    local connection = access.connection
    initialize_schema(connection)
    prepared:publish(connection)
  end
  completed = true
  return Index.new(store, 0, true)
end

function build(projects: {bridge.ProjectModule}, snapshots: {bridge.ModuleSnapshot}): Index
  return build_internal(projects, snapshots, nil)
end

function build_with_yield(projects: {bridge.ProjectModule},
                          snapshots: {bridge.ModuleSnapshot}, yield_now: Yield): Index
  return build_internal(projects, snapshots, yield_now)
end

local function row_role(row: sqlite3.Row, column: integer): bridge.OccurrenceRole
  local role = row:get(column) as integer
  if role == 0 then return bridge.OccurrenceRole.definition() end
  if role == 1 then return bridge.OccurrenceRole.import_alias() end
  if role == 2 then return bridge.OccurrenceRole.write() end
  if role == 3 then return bridge.OccurrenceRole.reference() end
  return bridge.OccurrenceRole.type_reference()
end

function row_visibility(row: sqlite3.Row, column: integer): bridge.DeclarationVisibility
  local visibility = row:get(column) as integer
  if visibility == 0 then return bridge.DeclarationVisibility.block() end
  if visibility == 1 then return bridge.DeclarationVisibility.module() end
  return bridge.DeclarationVisibility.exported()
end

function row_signature(row: sqlite3.Row, column: integer): bridge.CallableSignature?
  local display? = optional_bytes(row, column)
  if display == nil then return nil end
  return bridge.CallableSignature.new(display)
end

local function row_occurrence(row: sqlite3.Row): Occurrence
  return Occurrence.new(SymbolId.new(bytes(row, 1)), bytes(row, 2),
    bytes(row, 3), bytes(row, 4), row_role(row, 5),
    source_text.Span.new(
      source_text.Position.new(row:get(6) as integer, row:get(7) as integer),
      source_text.Position.new(row:get(8) as integer, row:get(9) as integer)),
    source_text.ByteSpan.new(row:get(10) as integer, row:get(11) as integer),
    (row:get(12) as integer) ~= 0, row_visibility(row, 13),
    row_type(row, 14), row_signature(row, 16), row:get(17) as integer?)
end

local function collect(cursor: sqlite3.Cursor): {Occurrence}
  local result: {Occurrence} = {}
  for row in cursor:fetch do result[#result + 1] = row_occurrence(row) end
  return result
end

function Index:file_names(): {string}
  local access = self.store:acquire()
  defer access:release()
  check_generation(access.connection, self.published_generation)
  local statement = access.connection:prepare(
    "SELECT DISTINCT filename FROM main.semantic_occurrences ORDER BY filename")
  defer statement:close()
  local cursor = statement:query()
  defer cursor:close()
  local result: {string} = {}
  for row in cursor:fetch do result[#result + 1] = bytes(row, 1) end
  return result
end

function Index:project_modules(): {bridge.ProjectModule}
  local access = self.store:acquire()
  defer access:release()
  check_generation(access.connection, self.published_generation)
  local statement = access.connection:prepare(
    "SELECT p.module_name,f.filename,f.contents FROM main.semantic_projects AS p " ..
    "LEFT JOIN main.semantic_files AS f ON f.module_name=p.module_name " ..
    "ORDER BY p.module_order,f.file_order")
  defer statement:close()
  local cursor = statement:query()
  defer cursor:close()
  local result: {bridge.ProjectModule} = {}
  local current: bridge.ProjectModule? = nil
  for row in cursor:fetch do
    local module_name = bytes(row, 1)
    if current == nil or current.module_name ~= module_name then
      current = bridge.ProjectModule.new(module_name, {})
      result[#result + 1] = current
    end
    local filename? = optional_bytes(row, 2)
    if filename ~= nil then
      current.files[#current.files + 1] = bridge.SourceFile.new(filename, bytes(row, 3))
    end
  end
  return result
end

function Index:coordinate_index(filename: string): source_text.CoordinateIndex?
  local access = self.store:acquire()
  defer access:release()
  check_generation(access.connection, self.published_generation)
  local statement = access.connection:prepare(
    "SELECT contents FROM main.semantic_files WHERE filename=?")
  defer statement:close()
  local cursor = statement:query(blob(filename))
  defer cursor:close()
  local row? = cursor:fetch()
  if row == nil then return nil end
  return source_text.coordinate_index(bytes(row, 1))
end

function Index:hover_summary(occurrence: Occurrence): string?
  local summary_id? = occurrence.summary_id
  if summary_id == nil then return nil end
  local access = self.store:acquire()
  defer access:release()
  check_generation(access.connection, self.published_generation)
  local statement = access.connection:prepare(
    "SELECT markdown FROM main.semantic_summaries WHERE identity=?")
  defer statement:close()
  local cursor = statement:query(blob(summary_key(occurrence.module_name, summary_id)))
  defer cursor:close()
  local row? = cursor:fetch()
  if row == nil then return nil end
  return bytes(row, 1)
end

function Index:hover_summary_count(): integer
  local access = self.store:acquire()
  defer access:release()
  check_generation(access.connection, self.published_generation)
  local statement = access.connection:prepare("SELECT COUNT(*) FROM main.semantic_summaries")
  defer statement:close()
  local cursor = statement:query()
  defer cursor:close()
  local row = cursor:fetch() as sqlite3.Row
  return row:get(1) as integer
end

function Index:file_occurrences(filename: string): {Occurrence}
  local access = self.store:acquire()
  defer access:release()
  check_generation(access.connection, self.published_generation)
  local statement = access.connection:prepare("SELECT " .. OCCURRENCE_COLUMNS ..
    " FROM main.semantic_occurrences WHERE filename=?" .. SOURCE_ORDER)
  defer statement:close()
  local cursor = statement:query(blob(filename))
  defer cursor:close()
  return collect(cursor)
end

function Index:occurrence_at(filename: string, position: source_text.Position): Occurrence?
  local access = self.store:acquire()
  defer access:release()
  check_generation(access.connection, self.published_generation)
  local statement = access.connection:prepare("SELECT " .. OCCURRENCE_COLUMNS ..
    " FROM main.semantic_occurrences WHERE filename=? AND start_line=? " ..
    "AND start_character<=? AND finish_character>? ORDER BY start_character DESC LIMIT 1")
  defer statement:close()
  local cursor = statement:query(blob(filename), position.line, position.character, position.character)
  defer cursor:close()
  local row? = cursor:fetch()
  if row == nil then return nil end
  return row_occurrence(row)
end

function Index:definition(symbol_id: SymbolId): Occurrence?
  local access = self.store:acquire()
  defer access:release()
  check_generation(access.connection, self.published_generation)
  local statement = access.connection:prepare("SELECT " .. OCCURRENCE_COLUMNS ..
    " FROM main.semantic_occurrences WHERE declaration_id=? AND role IN (0,1)")
  defer statement:close()
  local cursor = statement:query(blob(symbol_id.declaration_id))
  defer cursor:close()
  local row? = cursor:fetch()
  if row == nil then return nil end
  return row_occurrence(row)
end

function Index:occurrences(symbol_id: SymbolId, include_declaration: boolean): {Occurrence}
  local access = self.store:acquire()
  defer access:release()
  check_generation(access.connection, self.published_generation)
  local predicate = " WHERE declaration_id=?"
  if not include_declaration then predicate = predicate .. " AND role NOT IN (0,1)" end
  local statement = access.connection:prepare("SELECT " .. OCCURRENCE_COLUMNS ..
    " FROM main.semantic_occurrences" .. predicate .. SOURCE_ORDER)
  defer statement:close()
  local cursor = statement:query(blob(symbol_id.declaration_id))
  defer cursor:close()
  return collect(cursor)
end
