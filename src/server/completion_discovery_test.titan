local test = import "test"
local bridge = import "server.compiler_bridge"
local discovery = import "server.completion_discovery"
local test_paths = import "server.test_paths"
foreign import "compiler_io_platform.h"

local function external_root(): string
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then return "C:/external" end
  return "/external"
end

local function module(name: string, filename: string): bridge.ProjectModule
  return bridge.ProjectModule.new(name, {bridge.SourceFile.new(filename, "saved")})
end

function test_completion_discovery_retains_saved_membership_even_when_unwatched(
    _context: test.Context)
  local saved = module("pkg", test_paths.workspace_root() .. "/src/pkg/pkg.titan")
  saved.files[2] = bridge.SourceFile.new(test_paths.workspace_root() .. "/src/pkg/private.titan", "saved")
  test.assert(discovery.find(test_paths.workspace_root() .. "/src/pkg/private.titan", {saved},
    {test_paths.workspace_root() .. "/src"}, {test_paths.workspace_root() .. "/src"}, {test_paths.workspace_root() .. "/src/pkg"}, {}) == "pkg")
  test.assert(#saved.files == 2 and saved.files[2].contents == "saved",
    "ephemeral lookup altered saved project membership or bytes")
end

function test_completion_discovery_adds_sibling_to_one_file_folder(_context: test.Context)
  local saved = module("pkg", test_paths.workspace_root() .. "/src/pkg/pkg.titan")
  test.assert(discovery.find(test_paths.workspace_root() .. "/src/pkg/new-part.titan", {saved},
    {test_paths.workspace_root() .. "/src"}, {test_paths.workspace_root() .. "/src"}, {},
    {test_paths.workspace_root() .. "/src/pkg/new-part.titan"}) == "pkg",
    "a folder was misclassified as flat because it had only its main file")
  test.assert(#saved.files == 1, "unsaved contributor entered saved membership")
end

function test_completion_discovery_groups_new_folder_buffers_independent_of_open_order(
    _context: test.Context)
  local roots = {test_paths.workspace_root() .. "/src"}
  local first: const {string} = {
    test_paths.workspace_root() .. "/src/pkg/part.titan", test_paths.workspace_root() .. "/src/pkg/pkg.titan",
  }
  local second: const {string} = {
    test_paths.workspace_root() .. "/src/pkg/pkg.titan", test_paths.workspace_root() .. "/src/pkg/part.titan",
  }
  test.assert(discovery.find(first[1], {}, roots, roots, {}, first) == "pkg" and
    discovery.find(first[2], {}, roots, roots, {}, first) == "pkg" and
    discovery.find(second[1], {}, roots, roots, {}, second) == "pkg" and
    discovery.find(second[2], {}, roots, roots, {}, second) == "pkg")
end

function test_completion_discovery_uses_deepest_root_for_new_flat_identity(
    _context: test.Context)
  local roots = {test_paths.workspace_root() .. "/src", test_paths.workspace_root() .. "/src/nested"}
  local path = test_paths.workspace_root() .. "/src/nested/new.titan"
  test.assert(discovery.find(path, {}, roots, {test_paths.workspace_root() .. "/src"}, {}, {path}) == "new")
  local saved = module("new", test_paths.workspace_root() .. "/src/new.titan")
  test.assert(discovery.find(path, {saved}, roots, {test_paths.workspace_root() .. "/src"}, {}, {path}) == nil,
    "deepest naming overrode earlier-root provider selection")
end

function test_completion_discovery_obeys_folder_provider_and_root_precedence(
    _context: test.Context)
  local roots = {test_paths.workspace_root() .. "/first", test_paths.workspace_root() .. "/second"}
  local saved = module("pkg", test_paths.workspace_root() .. "/first/pkg/pkg.titan")
  saved.files[2] = bridge.SourceFile.new(test_paths.workspace_root() .. "/first/pkg/part.titan", "saved")
  local late = test_paths.workspace_root() .. "/second/pkg/part.titan"
  test.assert(discovery.find(late, {saved}, roots, {test_paths.workspace_root()}, {}, {late}) == nil,
    "a later source root bypassed an earlier folder contributor blocker")
  local flat = test_paths.workspace_root() .. "/first/pkg.titan"
  test.assert(discovery.find(flat, {saved}, roots, {test_paths.workspace_root()}, {}, {flat}) == nil,
    "a new flat provider displaced a selected folder")
  local new_main = test_paths.workspace_root() .. "/second/new/new.titan"
  local old_flat = module("new", test_paths.workspace_root() .. "/second/new.titan")
  test.assert(discovery.find(new_main, {old_flat}, roots, {test_paths.workspace_root()}, {}, {new_main}) == nil,
    "new folder provider was mixed with the captured flat module")
end

function test_completion_discovery_defers_new_folder_that_reassigns_saved_modules(
    _context: test.Context)
  local old_part = module("pkg.part", test_paths.workspace_root() .. "/src/pkg/part.titan")
  local main = test_paths.workspace_root() .. "/src/pkg/pkg.titan"
  test.assert(discovery.find(main, {old_part}, {test_paths.workspace_root() .. "/src"}, {test_paths.workspace_root()}, {},
    {main, test_paths.workspace_root() .. "/src/pkg/part.titan"}) == nil,
    "new folder silently stole another saved logical module's contributor")
end

function test_completion_discovery_defers_uncaptured_earlier_root(_context: test.Context)
  local path = test_paths.workspace_root() .. "/src/new.titan"
  test.assert(discovery.find(path, {}, {external_root(), test_paths.workspace_root() .. "/src"},
    {test_paths.workspace_root() .. "/src"}, {}, {path}) == nil,
    "uncaptured external source root was assumed to contain no provider")
end

local function rejects(context: test.Context, name: string, path: string,
                        roots: {string}, include: {string}, exclude: {string})
  context:run(name, function (_child: test.Context)
    test.assert(discovery.find(path, {}, roots, include, exclude, {path}) == nil,
      "unsupported new-file path acquired a logical module identity")
  end)
end

function test_completion_discovery_rejects_unmapped_or_excluded_paths(context: test.Context)
  local roots = {test_paths.workspace_root() .. "/src"}
  rejects(context, "untitled", "untitled:Untitled-1", roots, roots, {})
  rejects(context, "outside_source_root", test_paths.workspace_root() .. "/other/new.titan", roots,
    {test_paths.workspace_root()}, {})
  rejects(context, "outside_include", test_paths.workspace_root() .. "/src/new.titan", roots,
    {test_paths.workspace_root() .. "/tests"}, {})
  rejects(context, "excluded_new", test_paths.workspace_root() .. "/src/generated/new.titan", roots,
    roots, {test_paths.workspace_root() .. "/src/generated"})
  rejects(context, "invalid_component", test_paths.workspace_root() .. "/src/bad.name/new.titan", roots, roots, {})
  rejects(context, "reserved_terminal", test_paths.workspace_root() .. "/src/pkg/titan.titan", roots, roots, {})
  rejects(context, "private_database", test_paths.workspace_root() .. "/src/.titan-ls/new.titan", roots, roots, {})
end

function test_completion_discovery_selects_active_variants_and_rejects_inactive_variants(
    _context: test.Context)
  local host = bridge.host_target()
  local root = test_paths.workspace_root() .. "/src"
  local roots = {root}
  local saved_flat = module("foo", root .. "/foo." .. host .. ".titan")
  local saved_folder = bridge.ProjectModule.new("pkg", {
    bridge.SourceFile.new(root .. "/pkg/pkg." .. host .. ".titan", "saved main"),
    bridge.SourceFile.new(root .. "/pkg/ops.native.titan", "saved ops"),
  })
  local sources = {saved_flat, saved_folder}
  local open_paths: const {string} = {
    root .. "/foo." .. host .. ".titan",
    root .. "/foo.native.titan",
    root .. "/foo.titan",
    root .. "/foo.browser.titan",
    root .. "/pkg/pkg." .. host .. ".titan",
    root .. "/pkg/pkg.native.titan",
    root .. "/pkg/pkg.titan",
    root .. "/pkg/pkg.browser.titan",
    root .. "/pkg/ops." .. host .. ".titan",
    root .. "/pkg/ops.native.titan",
    root .. "/pkg/ops.titan",
    root .. "/pkg/ops.browser.titan",
    root .. "/pkg/extra." .. host .. ".titan",
    root .. "/pkg/extra.native.titan",
    root .. "/pkg/extra.browser.titan",
    root .. "/fresh." .. host .. ".titan",
    root .. "/fresh.native.titan",
    root .. "/fresh.browser.titan",
    root .. "/stacked.linux.native.titan",
    root .. "/miscased.Linux.titan",
  }
  test.assert(discovery.find(
    root .. "/foo." .. host .. ".titan", sources, roots, roots, {}, open_paths) == "foo")
  test.assert(discovery.find(
    root .. "/foo.native.titan", sources, roots, roots, {}, open_paths) == nil and
    discovery.find(
      root .. "/foo.titan", sources, roots, roots, {}, open_paths) == nil and
    discovery.find(
      root .. "/foo.browser.titan", sources, roots, roots, {}, open_paths) == nil,
    "open inactive flat variant was accepted into completion")

  test.assert(discovery.find(
    root .. "/pkg/pkg." .. host .. ".titan", sources, roots, roots, {}, open_paths) == "pkg" and
    discovery.find(
      root .. "/pkg/ops.native.titan", sources, roots, roots, {}, open_paths) == "pkg")
  test.assert(discovery.find(
    root .. "/pkg/pkg.native.titan", sources, roots, roots, {}, open_paths) == nil and
    discovery.find(
      root .. "/pkg/pkg.titan", sources, roots, roots, {}, open_paths) == nil and
    discovery.find(
      root .. "/pkg/pkg.browser.titan", sources, roots, roots, {}, open_paths) == nil and
    discovery.find(
      root .. "/pkg/ops." .. host .. ".titan", sources, roots, roots, {}, open_paths) == nil and
    discovery.find(
      root .. "/pkg/ops.titan", sources, roots, roots, {}, open_paths) == nil and
    discovery.find(
      root .. "/pkg/ops.browser.titan", sources, roots, roots, {}, open_paths) == nil,
    "open inactive or unindexed folder variant displaced saved selection")

  test.assert(discovery.find(
    root .. "/pkg/extra." .. host .. ".titan", sources, roots, roots, {}, open_paths) == "pkg" and
    discovery.find(
      root .. "/pkg/extra.native.titan", sources, roots, roots, {}, open_paths) == nil and
    discovery.find(
      root .. "/pkg/extra.browser.titan", sources, roots, roots, {}, open_paths) == nil,
    "new unsaved contributor family did not select only the winning host variant")

  test.assert(discovery.find(
    root .. "/fresh." .. host .. ".titan", sources, roots, roots, {}, open_paths) == "fresh" and
    discovery.find(
      root .. "/fresh.native.titan", sources, roots, roots, {}, open_paths) == nil and
    discovery.find(
      root .. "/fresh.browser.titan", sources, roots, roots, {}, open_paths) == nil,
    "new unsaved flat family did not select only the winning host variant")

  test.assert(discovery.find(
    root .. "/stacked.linux.native.titan", sources, roots, roots, {}, open_paths) == nil and
    discovery.find(
      root .. "/miscased.Linux.titan", sources, roots, roots, {}, open_paths) == nil,
    "reserved stacked or mis-cased variant acquired a completion module")
end
