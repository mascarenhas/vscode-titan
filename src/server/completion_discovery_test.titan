local test = import "test"
local bridge = import "server.compiler_bridge"
local discovery = import "server.completion_discovery"

local function module(name: string, filename: string): bridge.ProjectModule
  return bridge.ProjectModule.new(name, {bridge.SourceFile.new(filename, "saved")})
end

function test_completion_discovery_retains_saved_membership_even_when_unwatched(
    _context: test.Context)
  local saved = module("pkg", "/workspace/src/pkg/pkg.titan")
  saved.files[2] = bridge.SourceFile.new("/workspace/src/pkg/private.titan", "saved")
  test.assert(discovery.find("/workspace/src/pkg/private.titan", {saved},
    {"/workspace/src"}, {"/workspace/src"}, {"/workspace/src/pkg"}, {}) == "pkg")
  test.assert(#saved.files == 2 and saved.files[2].contents == "saved",
    "ephemeral lookup altered saved project membership or bytes")
end

function test_completion_discovery_adds_sibling_to_one_file_folder(_context: test.Context)
  local saved = module("pkg", "/workspace/src/pkg/pkg.titan")
  test.assert(discovery.find("/workspace/src/pkg/new-part.titan", {saved},
    {"/workspace/src"}, {"/workspace/src"}, {},
    {"/workspace/src/pkg/new-part.titan"}) == "pkg",
    "a folder was misclassified as flat because it had only its main file")
  test.assert(#saved.files == 1, "unsaved contributor entered saved membership")
end

function test_completion_discovery_groups_new_folder_buffers_independent_of_open_order(
    _context: test.Context)
  local roots = {"/workspace/src"}
  local first: const {string} = {
    "/workspace/src/pkg/part.titan", "/workspace/src/pkg/pkg.titan",
  }
  local second: const {string} = {
    "/workspace/src/pkg/pkg.titan", "/workspace/src/pkg/part.titan",
  }
  test.assert(discovery.find(first[1], {}, roots, roots, {}, first) == "pkg" and
    discovery.find(first[2], {}, roots, roots, {}, first) == "pkg" and
    discovery.find(second[1], {}, roots, roots, {}, second) == "pkg" and
    discovery.find(second[2], {}, roots, roots, {}, second) == "pkg")
end

function test_completion_discovery_uses_deepest_root_for_new_flat_identity(
    _context: test.Context)
  local roots = {"/workspace/src", "/workspace/src/nested"}
  local path = "/workspace/src/nested/new.titan"
  test.assert(discovery.find(path, {}, roots, {"/workspace/src"}, {}, {path}) == "new")
  local saved = module("new", "/workspace/src/new.titan")
  test.assert(discovery.find(path, {saved}, roots, {"/workspace/src"}, {}, {path}) == nil,
    "deepest naming overrode earlier-root provider selection")
end

function test_completion_discovery_obeys_folder_provider_and_root_precedence(
    _context: test.Context)
  local roots = {"/workspace/first", "/workspace/second"}
  local saved = module("pkg", "/workspace/first/pkg/pkg.titan")
  saved.files[2] = bridge.SourceFile.new("/workspace/first/pkg/part.titan", "saved")
  local late = "/workspace/second/pkg/part.titan"
  test.assert(discovery.find(late, {saved}, roots, {"/workspace"}, {}, {late}) == nil,
    "a later source root bypassed an earlier folder contributor blocker")
  local flat = "/workspace/first/pkg.titan"
  test.assert(discovery.find(flat, {saved}, roots, {"/workspace"}, {}, {flat}) == nil,
    "a new flat provider displaced a selected folder")
  local new_main = "/workspace/second/new/new.titan"
  local old_flat = module("new", "/workspace/second/new.titan")
  test.assert(discovery.find(new_main, {old_flat}, roots, {"/workspace"}, {}, {new_main}) == nil,
    "new folder provider was mixed with the captured flat module")
end

function test_completion_discovery_defers_new_folder_that_reassigns_saved_modules(
    _context: test.Context)
  local old_part = module("pkg.part", "/workspace/src/pkg/part.titan")
  local main = "/workspace/src/pkg/pkg.titan"
  test.assert(discovery.find(main, {old_part}, {"/workspace/src"}, {"/workspace"}, {},
    {main, "/workspace/src/pkg/part.titan"}) == nil,
    "new folder silently stole another saved logical module's contributor")
end

function test_completion_discovery_defers_uncaptured_earlier_root(_context: test.Context)
  local path = "/workspace/src/new.titan"
  test.assert(discovery.find(path, {}, {"/external", "/workspace/src"},
    {"/workspace/src"}, {}, {path}) == nil,
    "uncaptured external source root was assumed to contain no provider")
end

local function rejects(context: test.Context, name: string, path: string,
                        roots: {string}, include: {string}, exclude: {string})
  context:run(name, function (_child: test.Context)
    test.assert(discovery.find(path, {}, roots, include, exclude, {path}) == nil,
      "unsupported new-file path acquired a logical module identity")
  end)
end

function test_completion_discovery_rejects_unmapped_or_excluded_paths(context: test.Context)
  local roots = {"/workspace/src"}
  rejects(context, "untitled", "untitled:Untitled-1", roots, roots, {})
  rejects(context, "outside_source_root", "/workspace/other/new.titan", roots,
    {"/workspace"}, {})
  rejects(context, "outside_include", "/workspace/src/new.titan", roots,
    {"/workspace/tests"}, {})
  rejects(context, "excluded_new", "/workspace/src/generated/new.titan", roots,
    roots, {"/workspace/src/generated"})
  rejects(context, "invalid_component", "/workspace/src/bad.name/new.titan", roots, roots, {})
  rejects(context, "reserved_terminal", "/workspace/src/pkg/titan.titan", roots, roots, {})
  rejects(context, "private_database", "/workspace/src/.titan-ls/new.titan", roots, roots, {})
end
