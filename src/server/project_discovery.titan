local async = import "async"
local fs = import "fs"
local iteration = import "iteration"
local strings = import "string"
local source_text = import "server.source_text"

union ModuleKind
  flat
  folder
end

record Module
  name: string
  kind: ModuleKind
  main_file: string
  files: {string}
end

function Module:is_folder(): boolean
  case self.kind
  when folder then return true
  else return false
  end
end

union IssueKind
  invalid_module
  unmapped_source
end

record Issue
  path: string
  message: string
  kind: IssueKind
end

record Error
  path: string
  message: string
end

record Discovery
  include_roots: {string}
  source_roots: {string}
  directories: {string}
  modules: {Module}
  owner_by_file: {string: string}
  issues: {Issue}
end

function Discovery:find_module(name: string): Module?
  for index = 1, #self.modules do
    if self.modules[index].name == name then return self.modules[index] end
  end
  return nil
end

function Discovery:owner_for_file(path: string): string?
  if strings.sub(path, 1, 1) == "/" then
    local normalized? = source_text.normalize_absolute_path(path)
    if normalized == nil then return nil end
    return self.owner_by_file[normalized]
  end
  for index = 1, #self.source_roots do
    local normalized? = source_text.resolve_path(self.source_roots[index], path)
    if normalized ~= nil then
      local owner? = self.owner_by_file[normalized]
      if owner ~= nil then return owner end
    end
  end
  for index = 1, #self.include_roots do
    local normalized? = source_text.resolve_path(self.include_roots[index], path)
    if normalized ~= nil then
      local owner? = self.owner_by_file[normalized]
      if owner ~= nil then return owner end
    end
  end
  return nil
end

local record FileEntry
  path: string
  source_path: string
  canonical_path: string
  relative: string
  directory: string
  basename: string
end

local record IncludeRoot
  lexical: string
  canonical: string
end

local record SourceRoot
  lexical: string
  canonical: string
end

local record Scan
  files: {FileEntry}
  directories: {string}
end

local record ModuleCatalog
  modules: {Module}
  owner_by_file: {string: string}
  issues: {Issue}
end

local record Candidate
  module: Module
  owner_by_file: {string: string}
end

local record PhysicalSource
  kind: ModuleKind
  main_file: string
  files: {string}
end

local union SourceResolution
  found: PhysicalSource
  blocked: string
end

local record SourceSelection
  root_index: integer
  relative: string
  source_path: string
  depth: integer
end

local function fail<T>(path: string, message: string): T
  raise Error.new(path, message)
end

local function bytewise_less(left: string, right: string): boolean
  local limit = #left
  if #right < limit then limit = #right end
  for index = 1, limit do
    local left_byte: integer = strings.byte(left, index)
    local right_byte: integer = strings.byte(right, index)
    if left_byte < right_byte then return true end
    if left_byte > right_byte then return false end
  end
  return #left < #right
end

local function sort_strings(items: {string})
  for index = 2, #items do
    local item = items[index]
    local target = index
    while target > 1 and bytewise_less(item, items[target - 1]) do
      items[target] = items[target - 1]
      target = target - 1
    end
    items[target] = item
  end
end

local function sort_files(items: {FileEntry})
  for index = 2, #items do
    local item = items[index]
    local target = index
    while target > 1 and
          bytewise_less(item.basename, items[target - 1].basename) do
      items[target] = items[target - 1]
      target = target - 1
    end
    items[target] = item
  end
end

local function sort_modules(items: {Module})
  for index = 2, #items do
    local item = items[index]
    local target = index
    while target > 1 and bytewise_less(item.name, items[target - 1].name) do
      items[target] = items[target - 1]
      target = target - 1
    end
    items[target] = item
  end
end

local function sort_issues(items: {Issue})
  for index = 2, #items do
    local item = items[index]
    local target = index
    while target > 1 and bytewise_less(item.path, items[target - 1].path) do
      items[target] = items[target - 1]
      target = target - 1
    end
    items[target] = item
  end
end

local function join(root: string, name: string): string
  if root == "/" then return "/" .. name end
  return root .. "/" .. name
end

local function parent_directory(path: string): string
  if path == "/" then return "/" end
  local slash = 0
  for index = 1, #path do
    if strings.byte(path, index) == 47 then slash = index end
  end
  if slash <= 1 then return "/" end
  return strings.sub(path, 1, slash - 1)
end

local function leaf_name(path: string): string
  local parent = parent_directory(path)
  if parent == "/" then return strings.sub(path, 2) end
  return strings.sub(path, #parent + 2)
end

-- Resolve every existing ancestor so deleted/future exclusion leaves retain
-- the same physical identity as an include root reached through a symlink.
local function canonical_path(path: string): string
  local suffix: {string} = {}
  local candidate = path
  while true do
    do
      local canonical = fs.realpath(candidate)
      for index = #suffix, 1, -1 do
        canonical = join(canonical, suffix[index])
      end
      return canonical
    catch
      if error is async.CancellationReason then raise end
    end
    if candidate == "/" then return path end
    suffix[#suffix + 1] = leaf_name(candidate)
    candidate = parent_directory(candidate)
  end
  return path
end

local function rebase_path(path: string, source_root: string,
                           observed_root: string): string
  if path == source_root then return observed_root end
  if source_root == "/" then
    if observed_root == "/" then return path end
    return observed_root .. path
  end
  return observed_root .. strings.sub(path, #source_root + 1)
end

local function titan_source(name: string): boolean
  return #name >= 6 and strings.sub(name, #name - 5) == ".titan"
end

local function source_stem(name: string): string
  return strings.sub(name, 1, #name - 6)
end

-- This is the single lexical predicate for one filesystem directory/module
-- component. Watcher filtering shares it so an event under a path discovery
-- would prune (for example `build.debug` or `.editor`) cannot invalidate the
-- project, while valid names such as `build` and `tmp` remain observable.
function valid_module_component(component: string): boolean
  if component == "" then return false end
  local first: integer = strings.byte(component, 1)
  local first_valid = first == 95
  if first >= 65 and first <= 90 then first_valid = true end
  if first >= 97 and first <= 122 then first_valid = true end
  if not first_valid then
    return false
  end
  for index = 2, #component do
    local byte: integer = strings.byte(component, index)
    local valid = byte == 95
    if byte == 45 then valid = true end
    if byte >= 65 and byte <= 90 then valid = true end
    if byte >= 97 and byte <= 122 then valid = true end
    if byte >= 48 and byte <= 57 then valid = true end
    if not valid then
      return false
    end
  end
  return true
end

local function path_within(root: string, path: string): boolean
  if path == root then return true end
  if root == "/" then return strings.sub(path, 1, 1) == "/" end
  return strings.sub(path, 1, #root + 1) == root .. "/"
end

local function pruned(path: string, roots: {string}): boolean
  for index = 1, #roots do
    if path_within(roots[index], path) then return true end
  end
  return false
end

local function relative_to_root(root: string, path: string): string
  if root == "/" then return strings.sub(path, 2) end
  return strings.sub(path, #root + 2)
end

local function valid_path_components(path: string): boolean
  if path == "" then return true end
  local start = 1
  for index = 1, #path + 1 do
    if index == #path + 1 or strings.byte(path, index) == 47 then
      if not valid_module_component(
          strings.sub(path, start, index - 1)) then
        return false
      end
      start = index + 1
    end
  end
  return true
end

-- Native directory watches cover mapped source trees and the ancestors needed
-- to observe a configured source root appearing later. Unmapped branches are
-- still scanned below, but changes there do not initiate another scan.
local function mapped_directory_relevant(observed: string, canonical: string,
                                         source_roots: {SourceRoot}): boolean
  for index = 1, #source_roots do
    local root = source_roots[index]
    if path_within(observed, root.lexical) or
       path_within(canonical, root.canonical) or
       path_within(root.lexical, observed) or
       path_within(root.canonical, canonical) then
      return true
    end
  end
  return false
end

-- Include roots decide membership, while a nested source root can reset the
-- logical path after an include-relative component such as `vendor.foo` that
-- is not itself a valid module component. Preserve the old tooling-tree prune
-- everywhere that cannot lead to such a configured source root.
local function source_directory_relevant(observed: string, canonical: string,
                                         include_relative: string,
                                         source_roots: {SourceRoot}): boolean
  for index = 1, #source_roots do
    local root = source_roots[index]
    if path_within(observed, root.lexical) or
       path_within(canonical, root.canonical) then
      return true
    end
    if path_within(root.lexical, observed) and
       valid_path_components(relative_to_root(root.lexical, observed)) then
      return true
    end
    if path_within(root.canonical, canonical) and
       valid_path_components(relative_to_root(root.canonical, canonical)) then
      return true
    end
  end
  return valid_path_components(include_relative)
end

local function collect(directory: string, relative_directory: string,
                       files: {FileEntry}, directories: {string},
                       excluded: {string}, boundaries: {string},
                       observed_root: string, canonical_root: string,
                       source_roots: {SourceRoot})
  -- The workspace-owned database is never a source or watcher subtree, even
  -- when configuration explicitly names this otherwise hidden directory.
  if strings.sub(directory,-10) == "/.titan-ls" or
     strings.sub(rebase_path(directory, observed_root, canonical_root),-10) == "/.titan-ls" then
    return
  end
  if pruned(directory, boundaries) then return end
  -- Exclusions affect only the returned watcher set. Discovery still scans
  -- their saved sources so compiler/project ownership remains unchanged.
  if not pruned(directory, excluded) and mapped_directory_relevant(
      directory, rebase_path(directory, observed_root, canonical_root),
      source_roots) then
    directories[#directories + 1] = directory
  end
  local entries = fs.list(directory)
  sort_strings(entries)
  for index = 1, #entries do
    local name = entries[index]
    local path = join(directory, name)
    local relative = name
    if relative_directory ~= "" then
      relative = relative_directory .. "/" .. name
    end
    -- A nested include root is a scan boundary so the physical subtree and its
    -- watcher directories are collected only once. Source roots name modules.
    if not pruned(path, boundaries) then
      local metadata? = fs.lstat(path)
      if metadata ~= nil then
        local canonical = rebase_path(
          path, observed_root, canonical_root)
        if metadata.kind == "directory" and source_directory_relevant(
            path, canonical, relative, source_roots) then
          collect(path, relative, files, directories, excluded, boundaries,
                  observed_root, canonical_root, source_roots)
        elseif metadata.kind == "file" and titan_source(name) then
          files[#files + 1] = FileEntry.new(
            path, path, canonical, relative,
            relative_directory, name)
        end
        -- Symlinks are deliberately not followed. The project identity is the
        -- lexical source tree, and a watch must not escape it through a link.
      end
    end
  end
end

local function path_components(path: string): {string}
  local result: {string} = {}
  local start = 1
  local index = 1
  while index <= #path + 1 do
    if index == #path + 1 or strings.byte(path, index) == 47 then
      result[#result + 1] = strings.sub(path, start, index - 1)
      start = index + 1
    end
    index = index + 1
  end
  return result
end

local function dotted(components: {string}, count: integer): string
  local output = strings.writer()
  for index = 1, count do
    if index > 1 then output:write(".") end
    output:write(components[index])
  end
  return output:drain()
end

function valid_module_name(name: string): boolean
  local components: {string} = {}
  local start = 1
  local index = 1
  while index <= #name + 1 do
    if index == #name + 1 or strings.byte(name, index) == 46 then
      local component = strings.sub(name, start, index - 1)
      if not valid_module_component(component) then return false end
      components[#components + 1] = component
      start = index + 1
    end
    index = index + 1
  end
  if #components == 0 then return false end
  if #components == 1 then return true end
  return components[#components] ~= "titan"
end

local function flat_module_name(entry: FileEntry): string
  local stem = strings.sub(entry.relative, 1, #entry.relative - 6)
  local components = path_components(stem)
  return dotted(components, #components)
end

local function folder_module_name(entry: FileEntry): string?
  if entry.directory == "" then return nil end
  if not valid_path_components(entry.directory) then return nil end
  local components = path_components(entry.directory)
  local stem = source_stem(entry.basename)
  if components[#components] ~= stem then return nil end
  local name = dotted(components, #components)
  if not valid_module_name(name) then return nil end
  return name
end

local function absolute_root(path: string): string
  local candidate = path
  if candidate == "" then candidate = "." end
  if strings.sub(candidate, 1, 1) == "/" then
    local normalized?, failure? =
      source_text.normalize_absolute_path(candidate)
    if normalized == nil then return fail<string>(path, failure.message) end
    return normalized
  end
  local normalized?, failure? =
    source_text.resolve_path(fs.pwd(), candidate)
  if normalized == nil then return fail<string>(path, failure.message) end
  return normalized
end

local function validated_include_root(root: string): IncludeRoot
  do
    local metadata? = fs.stat(root)
    if metadata == nil then
      return fail<IncludeRoot>(root, "include root does not exist")
    end
    if metadata.kind ~= "directory" then
      return fail<IncludeRoot>(root, "include root is not a directory")
    end
    return IncludeRoot.new(root, canonical_path(root))
  catch
    if error is async.CancellationReason then raise end
    if error is Error then raise end
    return fail<IncludeRoot>(root, strings.tostring(error))
  end
end

local function own(owner_by_file: {string: string}, entry: FileEntry,
                   module_name: string)
  owner_by_file[entry.path] = module_name
  owner_by_file[entry.source_path] = module_name
  owner_by_file[entry.canonical_path] = module_name
end

local function discover_entries(entries: {FileEntry}): ModuleCatalog
  local modules: {Module} = {}
  local modules_by_name: {string: Module} = {}
  local folders_by_directory: {string: Module} = {}
  local owner_by_file: {string: string} = {}
  local issues: {Issue} = {}

  -- Folder mains are selected before flat files, exactly as driver.lua does.
  for index = 1, #entries do
    local entry = entries[index]
    local name? = folder_module_name(entry)
    if name ~= nil then
      local module = Module.new(
        name, ModuleKind.folder(), entry.path, {entry.path})
      modules[#modules + 1] = module
      modules_by_name[name] = module
      folders_by_directory[entry.directory] = module
      own(owner_by_file, entry, name)
    end
  end

  -- Every immediate .titan sibling belongs to the folder module. Contributor
  -- basenames use the compiler's raw byte ordering, while the main stays first.
  for directory, module in iteration.pairs(folders_by_directory) do
    local contributors: {FileEntry} = {}
    for index = 1, #entries do
      local entry = entries[index]
      if entry.directory == directory and entry.path ~= module.main_file then
        contributors[#contributors + 1] = entry
      end
    end
    sort_files(contributors)
    for index = 1, #contributors do
      local contributor = contributors[index]
      module.files[#module.files + 1] = contributor.path
      own(owner_by_file, contributor, module.name)
    end
  end

  for index = 1, #entries do
    local entry = entries[index]
    if owner_by_file[entry.path] == nil then
      local name = flat_module_name(entry)
      local stem = strings.sub(entry.relative, 1, #entry.relative - 6)
      if stem == "" or not valid_path_components(stem) or
         not valid_module_name(name) then
        issues[#issues + 1] = Issue.new(
          entry.path,
          "invalid logical Titan module name '" .. name .. "'",
          IssueKind.invalid_module())
      elseif modules_by_name[name] == nil then
        local module = Module.new(
          name, ModuleKind.flat(), entry.path, {entry.path})
        modules[#modules + 1] = module
        modules_by_name[name] = module
        own(owner_by_file, entry, name)
      end
      -- A same-name flat file is shadowed by the already selected folder main.
    end
  end

  sort_modules(modules)
  sort_issues(issues)
  return ModuleCatalog.new(modules, owner_by_file, issues)
end

local function scan_root_or_raise(root: IncludeRoot, excluded: {string},
                                  boundaries: {string},
                                  source_roots: {SourceRoot}): Scan
  local root_metadata? = fs.stat(root.lexical)
  if root_metadata == nil then
    return fail<Scan>(root.lexical, "include root does not exist")
  end
  if root_metadata.kind ~= "directory" then
    return fail<Scan>(root.lexical, "include root is not a directory")
  end
  local entries: {FileEntry} = {}
  local directories: {string} = {}
  collect(root.lexical, "", entries, directories, excluded, boundaries,
          root.lexical, root.canonical, source_roots)
  return Scan.new(entries, directories)
end

local function scan_root(root: IncludeRoot, excluded: {string},
                         boundaries: {string},
                         source_roots: {SourceRoot}): Scan
  do
    return scan_root_or_raise(root, excluded, boundaries, source_roots)
  catch
    if error is async.CancellationReason then raise end
    if error is Error then raise end
    return fail<Scan>(root.lexical, strings.tostring(error))
  end
end

local function relative_parent(path: string): string
  local slash = 0
  for index = 1, #path do
    if strings.byte(path, index) == 47 then slash = index end
  end
  if slash == 0 then return "" end
  return strings.sub(path, 1, slash - 1)
end

local function path_depth(path: string): integer
  if path == "" then return 0 end
  local depth = 1
  for index = 1, #path do
    if strings.byte(path, index) == 47 then depth = depth + 1 end
  end
  return depth
end

local function consider_source_selection(selected: SourceSelection?,
                                         root_index: integer,
                                         relative: string,
                                         source_path: string):
    SourceSelection
  local candidate = SourceSelection.new(
    root_index, relative, source_path, path_depth(relative))
  if selected == nil or candidate.depth < selected.depth then
    return candidate
  end
  return selected
end

-- The lexical check preserves a configured source root above a symlinked
-- include (for example /workspace containing /workspace/link -> /actual).
-- Canonical containment then handles the inverse alias. The shortest relative
-- path is the physically most-specific source root; declaration order breaks
-- ties without making include order part of module identity.
local function selected_source_root(entry: FileEntry,
                                    roots: {SourceRoot}): SourceSelection?
  local selected: SourceSelection? = nil
  for index = 1, #roots do
    local root = roots[index]
    if path_within(root.lexical, entry.path) then
      local relative = relative_to_root(root.lexical, entry.path)
      selected = consider_source_selection(
        selected, index, relative, entry.path)
    end
    if path_within(root.canonical, entry.canonical_path) then
      local relative = relative_to_root(root.canonical, entry.canonical_path)
      selected = consider_source_selection(
        selected, index, relative,
        rebase_path(entry.canonical_path, root.canonical, root.lexical))
    end
  end
  return selected
end

local function map_to_source_root(entry: FileEntry,
                                  selection: SourceSelection): FileEntry
  return FileEntry.new(
    entry.path, selection.source_path, entry.canonical_path,
    selection.relative, relative_parent(selection.relative), entry.basename)
end

local function module_path(name: string): string
  local output = strings.writer()
  for index = 1, #name do
    local byte: integer = strings.byte(name, index)
    if byte == 46 then
      output:write("/")
    else
      output:write(strings.sub(name, index, index))
    end
  end
  return output:drain()
end

local function terminal_component(name: string): string
  local start = 1
  for index = 1, #name do
    if strings.byte(name, index) == 46 then start = index + 1 end
  end
  return strings.sub(name, start)
end

local function module_owner(name: string): string?
  local finish = 0
  for index = 1, #name do
    if strings.byte(name, index) == 46 then finish = index - 1 end
  end
  if finish == 0 then return nil end
  return strings.sub(name, 1, finish)
end

local function regular_file(path: string): boolean
  do
    local metadata? = fs.stat(path)
    return metadata ~= nil and metadata.kind == "file"
  catch
    if error is async.CancellationReason then raise end
    -- The compiler treats a failed source-candidate stat as a miss and keeps
    -- searching. Only a selected folder whose contents cannot be listed is a
    -- resolver error.
    return false
  end
end

local function source_resolution_in_root(root: SourceRoot, name: string):
    SourceResolution?
  local relative = module_path(name)
  local basename = terminal_component(name)
  local folder = join(root.lexical, relative)
  local folder_main = join(folder, basename .. ".titan")
  if regular_file(folder_main) then
    local contributor_names: {string} = {}
    local entries = fs.list(folder)
    for index = 1, #entries do
      local entry = entries[index]
      if entry ~= basename .. ".titan" and titan_source(entry) and
         regular_file(join(folder, entry)) then
        contributor_names[#contributor_names + 1] = entry
      end
    end
    sort_strings(contributor_names)
    local files = {folder_main}
    for index = 1, #contributor_names do
      files[#files + 1] = join(folder, contributor_names[index])
    end
    return SourceResolution.found(
      PhysicalSource.new(ModuleKind.folder(), folder_main, files))
  end

  local flat = join(root.lexical, relative .. ".titan")
  if not regular_file(flat) then return nil end
  local owner? = module_owner(name)
  if owner ~= nil then
    local owner_main = join(
      join(root.lexical, module_path(owner)),
      terminal_component(owner) .. ".titan")
    if regular_file(owner_main) then
      return SourceResolution.blocked(owner_main)
    end
  end
  return SourceResolution.found(
    PhysicalSource.new(ModuleKind.flat(), flat, {flat}))
end


local function resolve_source(roots: {SourceRoot}, name: string):
    SourceResolution?
  for index = 1, #roots do
    local resolved? = source_resolution_in_root(roots[index], name)
    if resolved ~= nil then return resolved end
  end
  return nil
end

local function module_is_folder(module: Module): boolean
  return module:is_folder()
end

local function physical_is_folder(source: PhysicalSource): boolean
  case source.kind
  when folder then return true
  else return false
  end
end

local function same_physical_source(module: Module,
                                    source: PhysicalSource): boolean
  if module_is_folder(module) ~= physical_is_folder(source) or
     #module.files ~= #source.files then
    return false
  end
  for index = 1, #module.files do
    if canonical_path(module.files[index]) ~= canonical_path(source.files[index])
       then
      return false
    end
  end
  return true
end

local function discover_or_raise(include: {string}, exclude: {string},
                                 source_module_roots: {string}): Discovery
  local roots: {IncludeRoot} = {}
  local present: {string: boolean} = {}
  for index = 1, #include do
    local root = absolute_root(include[index])
    local identity = validated_include_root(root)
    if not present[identity.canonical] then
      present[identity.canonical] = true
      roots[#roots + 1] = identity
    end
  end

  local source_roots: {SourceRoot} = {}
  local source_present: {string: boolean} = {}
  for index = 1, #source_module_roots do
    local root = absolute_root(source_module_roots[index])
    local canonical = canonical_path(root)
    if not source_present[canonical] then
      source_present[canonical] = true
      source_roots[#source_roots + 1] = SourceRoot.new(root, canonical)
    end
  end

  local excluded: {string} = {}
  local excluded_present: {string: boolean} = {}
  for index = 1, #exclude do
    local path = canonical_path(absolute_root(exclude[index]))
    if not excluded_present[path] then
      excluded_present[path] = true
      excluded[#excluded + 1] = path
    end
  end

  local directories: {string} = {}
  local directory_present: {string: boolean} = {}
  local entries: {FileEntry} = {}
  local modules: {Module} = {}
  local owner_by_file: {string: string} = {}
  local issues: {Issue} = {}

  for root_index = 1, #roots do
    local root = roots[root_index]
    local boundaries: {string} = {}
    for candidate_index = 1, #roots do
      local candidate = roots[candidate_index]
      if candidate.canonical ~= root.canonical and
         path_within(root.canonical, candidate.canonical) then
        boundaries[#boundaries + 1] = rebase_path(
          candidate.canonical, root.canonical, root.lexical)
      end
    end
    local root_excluded: {string} = {}
    for excluded_index = 1, #excluded do
      local excluded_path = excluded[excluded_index]
      if path_within(excluded_path, root.canonical) then
        root_excluded[#root_excluded + 1] = root.lexical
      elseif path_within(root.canonical, excluded_path) then
        root_excluded[#root_excluded + 1] = rebase_path(
          excluded_path, root.canonical, root.lexical)
      end
    end
    local found = scan_root(root, root_excluded, boundaries, source_roots)
    for index = 1, #found.directories do
      local directory = found.directories[index]
      if not directory_present[directory] then
        directory_present[directory] = true
        directories[#directories + 1] = directory
      end
    end
    for index = 1, #found.files do
      entries[#entries + 1] = found.files[index]
    end
  end

  local entries_by_source_root: {{FileEntry}} = {}
  for index = 1, #source_roots do entries_by_source_root[index] = {} end
  for index = 1, #entries do
    local entry = entries[index]
    local selection? = selected_source_root(entry, source_roots)
    if selection == nil then
      issues[#issues + 1] = Issue.new(
        entry.path,
        "saved Titan source is not beneath any source_module_roots entry; " ..
        "it is excluded from project analysis and watching",
        IssueKind.unmapped_source())
    else
      local bucket = entries_by_source_root[selection.root_index]
      bucket[#bucket + 1] = map_to_source_root(entry, selection)
    end
  end

  -- A candidate is named from its most-specific source root. Validate that
  -- identity against root-major compiler lookup before publishing it. This is
  -- essential for overlapping roots and earlier unwatched roots: either can
  -- make the compiler select a different physical provider for the same name.
  local candidates: {string: Candidate} = {}
  local candidate_names: {string} = {}
  for root_index = 1, #source_roots do
    local catalog = discover_entries(entries_by_source_root[root_index])
    for index = 1, #catalog.modules do
      local module = catalog.modules[index]
      if candidates[module.name] == nil then
        candidates[module.name] = Candidate.new(
          module, catalog.owner_by_file)
        candidate_names[#candidate_names + 1] = module.name
      else
        local selected = candidates[module.name]
        issues[#issues + 1] = Issue.new(
          module.main_file,
          "logical Titan module '" .. module.name ..
          "' is shadowed by earlier source_module_roots provider '" ..
          selected.module.main_file .. "'", IssueKind.invalid_module())
      end
    end
    for index = 1, #catalog.issues do
      issues[#issues + 1] = catalog.issues[index]
    end
  end

  sort_strings(candidate_names)
  for index = 1, #candidate_names do
    local name = candidate_names[index]
    local candidate = candidates[name]
    local resolved? = resolve_source(source_roots, name)
    if resolved == nil then
      issues[#issues + 1] = Issue.new(
        candidate.module.main_file,
        "logical Titan module '" .. name ..
        "' is not resolvable through source_module_roots",
        IssueKind.invalid_module())
    else
      case resolved
      when blocked: blocking_source then
        issues[#issues + 1] = Issue.new(
          candidate.module.main_file,
          "logical Titan module '" .. name ..
          "' is blocked by folder source '" .. blocking_source .. "'",
          IssueKind.invalid_module())
      when found: source then
        if same_physical_source(candidate.module, source) then
          modules[#modules + 1] = candidate.module
          for file, owner in iteration.pairs(candidate.owner_by_file) do
            if owner == name then owner_by_file[file] = name end
          end
        else
          issues[#issues + 1] = Issue.new(
            candidate.module.main_file,
            "logical Titan module '" .. name ..
            "' resolves to a different physical provider through " ..
            "source_module_roots: '" .. source.main_file .. "'",
            IssueKind.invalid_module())
        end
      end
    end
  end

  sort_modules(modules)
  sort_issues(issues)
  local include_roots: {string} = {}
  for index = 1, #roots do include_roots[index] = roots[index].lexical end
  local source_root_paths: {string} = {}
  for index = 1, #source_roots do
    source_root_paths[index] = source_roots[index].lexical
  end
  return Discovery.new(
    include_roots, source_root_paths, directories,
    modules, owner_by_file, issues)
end

function discover(include: {string}, exclude: {string},
                  source_module_roots: {string}): (Discovery?, Error?)
  do
    return discover_or_raise(include, exclude, source_module_roots), nil
  catch
    if error is async.CancellationReason then raise end
    if error is Error then return nil, error as Error end
    local path = ""
    if #include > 0 then path = include[1] end
    return nil, Error.new(path, strings.tostring(error))
  end
end
