local async = import "async"
local fs = import "fs"
local iteration = import "iteration"
local strings = import "string"
local source_text = import "server.source_text"

union ModuleKind
  flat
  folder
end

record Module
  name: string
  kind: ModuleKind
  main_file: string
  files: {string}
end

function Module:is_folder(): boolean
  case self.kind
  when folder then return true
  else return false
  end
end

record Issue
  path: string
  message: string
end

record Error
  path: string
  message: string
end

record Discovery
  include_roots: {string}
  directories: {string}
  modules: {Module}
  owner_by_file: {string: string}
  issues: {Issue}
end

function Discovery:find_module(name: string): Module?
  for index = 1, #self.modules do
    if self.modules[index].name == name then return self.modules[index] end
  end
  return nil
end

function Discovery:owner_for_file(path: string): string?
  if strings.sub(path, 1, 1) == "/" then
    local normalized? = source_text.normalize_absolute_path(path)
    if normalized == nil then return nil end
    return self.owner_by_file[normalized]
  end
  for index = 1, #self.include_roots do
    local normalized? = source_text.resolve_path(self.include_roots[index], path)
    if normalized ~= nil then
      local owner? = self.owner_by_file[normalized]
      if owner ~= nil then return owner end
    end
  end
  return nil
end

local record FileEntry
  path: string
  relative: string
  directory: string
  basename: string
end

local record IncludeRoot
  lexical: string
  canonical: string
end

local function fail<T>(path: string, message: string): T
  raise Error.new(path, message)
end

local function bytewise_less(left: string, right: string): boolean
  local limit = #left
  if #right < limit then limit = #right end
  for index = 1, limit do
    local left_byte: integer = strings.byte(left, index)
    local right_byte: integer = strings.byte(right, index)
    if left_byte < right_byte then return true end
    if left_byte > right_byte then return false end
  end
  return #left < #right
end

local function sort_strings(items: {string})
  for index = 2, #items do
    local item = items[index]
    local target = index
    while target > 1 and bytewise_less(item, items[target - 1]) do
      items[target] = items[target - 1]
      target = target - 1
    end
    items[target] = item
  end
end

local function sort_files(items: {FileEntry})
  for index = 2, #items do
    local item = items[index]
    local target = index
    while target > 1 and
          bytewise_less(item.basename, items[target - 1].basename) do
      items[target] = items[target - 1]
      target = target - 1
    end
    items[target] = item
  end
end

local function sort_modules(items: {Module})
  for index = 2, #items do
    local item = items[index]
    local target = index
    while target > 1 and bytewise_less(item.name, items[target - 1].name) do
      items[target] = items[target - 1]
      target = target - 1
    end
    items[target] = item
  end
end

local function sort_issues(items: {Issue})
  for index = 2, #items do
    local item = items[index]
    local target = index
    while target > 1 and bytewise_less(item.path, items[target - 1].path) do
      items[target] = items[target - 1]
      target = target - 1
    end
    items[target] = item
  end
end

local function join(root: string, name: string): string
  if root == "/" then return "/" .. name end
  return root .. "/" .. name
end

local function parent_directory(path: string): string
  if path == "/" then return "/" end
  local slash = 0
  for index = 1, #path do
    if strings.byte(path, index) == 47 then slash = index end
  end
  if slash <= 1 then return "/" end
  return strings.sub(path, 1, slash - 1)
end

local function leaf_name(path: string): string
  local parent = parent_directory(path)
  if parent == "/" then return strings.sub(path, 2) end
  return strings.sub(path, #parent + 2)
end

-- Resolve every existing ancestor so deleted/future exclusion leaves retain
-- the same physical identity as an include root reached through a symlink.
local function canonical_path(path: string): string
  local suffix: {string} = {}
  local candidate = path
  while true do
    do
      local canonical = fs.realpath(candidate)
      for index = #suffix, 1, -1 do
        canonical = join(canonical, suffix[index])
      end
      return canonical
    catch
      if error is async.CancellationReason then raise end
    end
    if candidate == "/" then return path end
    suffix[#suffix + 1] = leaf_name(candidate)
    candidate = parent_directory(candidate)
  end
  return path
end

local function rebase_path(path: string, source_root: string,
                           observed_root: string): string
  if path == source_root then return observed_root end
  if source_root == "/" then
    if observed_root == "/" then return path end
    return observed_root .. path
  end
  return observed_root .. strings.sub(path, #source_root + 1)
end

local function titan_source(name: string): boolean
  return #name >= 6 and strings.sub(name, #name - 5) == ".titan"
end

local function source_stem(name: string): string
  return strings.sub(name, 1, #name - 6)
end

-- This is the single lexical predicate for one filesystem directory/module
-- component. Watcher filtering shares it so an event under a path discovery
-- would prune (for example `build.debug` or `.editor`) cannot invalidate the
-- project, while valid names such as `build` and `tmp` remain observable.
function valid_module_component(component: string): boolean
  if component == "" then return false end
  local first: integer = strings.byte(component, 1)
  local first_valid = first == 95
  if first >= 65 and first <= 90 then first_valid = true end
  if first >= 97 and first <= 122 then first_valid = true end
  if not first_valid then
    return false
  end
  for index = 2, #component do
    local byte: integer = strings.byte(component, index)
    local valid = byte == 95
    if byte == 45 then valid = true end
    if byte >= 65 and byte <= 90 then valid = true end
    if byte >= 97 and byte <= 122 then valid = true end
    if byte >= 48 and byte <= 57 then valid = true end
    if not valid then
      return false
    end
  end
  return true
end

local function path_within(root: string, path: string): boolean
  if path == root then return true end
  if root == "/" then return strings.sub(path, 1, 1) == "/" end
  return strings.sub(path, 1, #root + 1) == root .. "/"
end

local function pruned(path: string, roots: {string}): boolean
  for index = 1, #roots do
    if path_within(roots[index], path) then return true end
  end
  return false
end

local function collect(directory: string, relative_directory: string,
                       files: {FileEntry}, directories: {string},
                       excluded: {string}, boundaries: {string})
  if pruned(directory, boundaries) then return end
  -- Exclusions affect only the returned watcher set. Discovery still scans
  -- their saved sources so compiler/project ownership remains unchanged.
  if not pruned(directory, excluded) then
    directories[#directories + 1] = directory
  end
  local entries = fs.list(directory)
  sort_strings(entries)
  for index = 1, #entries do
    local name = entries[index]
    local path = join(directory, name)
    local relative = name
    if relative_directory ~= "" then
      relative = relative_directory .. "/" .. name
    end
    -- A nested include root is a scan boundary: that more-specific root owns
    -- the physical files once, under module names relative to itself.
    if not pruned(path, boundaries) then
      local metadata? = fs.lstat(path)
      if metadata ~= nil then
        -- A directory component that cannot occur in a logical Titan module
        -- cannot contain a resolvable descendant either. Pruning it here keeps
        -- build/tooling trees such as .build, .titan, and .git out of both
        -- project discovery and the watcher set.
        if metadata.kind == "directory" and valid_module_component(name) then
          collect(path, relative, files, directories, excluded, boundaries)
        elseif metadata.kind == "file" and titan_source(name) then
          files[#files + 1] =
            FileEntry.new(path, relative, relative_directory, name)
        end
        -- Symlinks are deliberately not followed. The project identity is the
        -- lexical source tree, and a watch must not escape it through a link.
      end
    end
  end
end

local function path_components(path: string): {string}
  local result: {string} = {}
  local start = 1
  local index = 1
  while index <= #path + 1 do
    if index == #path + 1 or strings.byte(path, index) == 47 then
      result[#result + 1] = strings.sub(path, start, index - 1)
      start = index + 1
    end
    index = index + 1
  end
  return result
end

local function dotted(components: {string}, count: integer): string
  local output = strings.writer()
  for index = 1, count do
    if index > 1 then output:write(".") end
    output:write(components[index])
  end
  return output:drain()
end

function valid_module_name(name: string): boolean
  local components: {string} = {}
  local start = 1
  local index = 1
  while index <= #name + 1 do
    if index == #name + 1 or strings.byte(name, index) == 46 then
      local component = strings.sub(name, start, index - 1)
      if not valid_module_component(component) then return false end
      components[#components + 1] = component
      start = index + 1
    end
    index = index + 1
  end
  if #components == 0 then return false end
  if #components == 1 then return true end
  return components[#components] ~= "titan"
end

local function flat_module_name(entry: FileEntry): string
  local stem = strings.sub(entry.relative, 1, #entry.relative - 6)
  local components = path_components(stem)
  return dotted(components, #components)
end

local function folder_module_name(entry: FileEntry): string?
  if entry.directory == "" then return nil end
  local components = path_components(entry.directory)
  local stem = source_stem(entry.basename)
  if components[#components] ~= stem then return nil end
  local name = dotted(components, #components)
  if not valid_module_name(name) then return nil end
  return name
end

local function absolute_root(path: string): string
  local candidate = path
  if candidate == "" then candidate = "." end
  if strings.sub(candidate, 1, 1) == "/" then
    local normalized?, failure? =
      source_text.normalize_absolute_path(candidate)
    if normalized == nil then return fail<string>(path, failure.message) end
    return normalized
  end
  local normalized?, failure? =
    source_text.resolve_path(fs.pwd(), candidate)
  if normalized == nil then return fail<string>(path, failure.message) end
  return normalized
end

local function validated_include_root(root: string): IncludeRoot
  do
    local metadata? = fs.stat(root)
    if metadata == nil then
      return fail<IncludeRoot>(root, "include root does not exist")
    end
    if metadata.kind ~= "directory" then
      return fail<IncludeRoot>(root, "include root is not a directory")
    end
    return IncludeRoot.new(root, canonical_path(root))
  catch
    if error is async.CancellationReason then raise end
    if error is Error then raise end
    return fail<IncludeRoot>(root, strings.tostring(error))
  end
end

local function discover_root(root: string, excluded: {string},
                             boundaries: {string}): Discovery
  local root_metadata? = fs.stat(root)
  if root_metadata == nil then
    return fail<Discovery>(root, "include root does not exist")
  end
  if root_metadata.kind ~= "directory" then
    return fail<Discovery>(root, "include root is not a directory")
  end

  local entries: {FileEntry} = {}
  local directories: {string} = {}
  collect(root, "", entries, directories, excluded, boundaries)

  local modules: {Module} = {}
  local modules_by_name: {string: Module} = {}
  local folders_by_directory: {string: Module} = {}
  local owner_by_file: {string: string} = {}
  local issues: {Issue} = {}

  -- Folder mains are selected before flat files, exactly as driver.lua does.
  for index = 1, #entries do
    local entry = entries[index]
    local name? = folder_module_name(entry)
    if name ~= nil then
      local module = Module.new(
        name, ModuleKind.folder(), entry.path, {entry.path})
      modules[#modules + 1] = module
      modules_by_name[name] = module
      folders_by_directory[entry.directory] = module
      owner_by_file[entry.path] = name
    end
  end

  -- Every immediate .titan sibling belongs to the folder module. Contributor
  -- basenames use the compiler's raw byte ordering, while the main stays first.
  for directory, module in iteration.pairs(folders_by_directory) do
    local contributors: {FileEntry} = {}
    for index = 1, #entries do
      local entry = entries[index]
      if entry.directory == directory and entry.path ~= module.main_file then
        contributors[#contributors + 1] = entry
      end
    end
    sort_files(contributors)
    for index = 1, #contributors do
      local contributor = contributors[index]
      module.files[#module.files + 1] = contributor.path
      owner_by_file[contributor.path] = module.name
    end
  end

  for index = 1, #entries do
    local entry = entries[index]
    if owner_by_file[entry.path] == nil then
      local name = flat_module_name(entry)
      if not valid_module_name(name) then
        issues[#issues + 1] = Issue.new(
          entry.path,
          "invalid logical Titan module name '" .. name .. "'")
      elseif modules_by_name[name] == nil then
        local module = Module.new(
          name, ModuleKind.flat(), entry.path, {entry.path})
        modules[#modules + 1] = module
        modules_by_name[name] = module
        owner_by_file[entry.path] = name
      end
      -- A same-name flat file is shadowed by the already selected folder main.
    end
  end

  sort_modules(modules)
  sort_issues(issues)
  return Discovery.new({root}, directories, modules, owner_by_file, issues)
end

local function scan_root(root: string, excluded: {string},
                         boundaries: {string}): Discovery
  do
    return discover_root(root, excluded, boundaries)
  catch
    if error is async.CancellationReason then raise end
    if error is Error then raise end
    return fail<Discovery>(root, strings.tostring(error))
  end
end

local function discover_or_raise(include: {string}, exclude: {string}): Discovery
  local roots: {IncludeRoot} = {}
  local present: {string: boolean} = {}
  for index = 1, #include do
    local root = absolute_root(include[index])
    local identity = validated_include_root(root)
    if not present[identity.canonical] then
      present[identity.canonical] = true
      roots[#roots + 1] = identity
    end
  end

  local excluded: {string} = {}
  local excluded_present: {string: boolean} = {}
  for index = 1, #exclude do
    local path = canonical_path(absolute_root(exclude[index]))
    if not excluded_present[path] then
      excluded_present[path] = true
      excluded[#excluded + 1] = path
    end
  end

  local directories: {string} = {}
  local directory_present: {string: boolean} = {}
  local modules: {Module} = {}
  local modules_by_name: {string: Module} = {}
  local owner_by_file: {string: string} = {}
  local issues: {Issue} = {}

  for root_index = 1, #roots do
    local root = roots[root_index]
    local boundaries: {string} = {}
    for candidate_index = 1, #roots do
      local candidate = roots[candidate_index]
      if candidate.canonical ~= root.canonical and
         path_within(root.canonical, candidate.canonical) then
        boundaries[#boundaries + 1] = rebase_path(
          candidate.canonical, root.canonical, root.lexical)
      end
    end
    local root_excluded: {string} = {}
    for excluded_index = 1, #excluded do
      local excluded_path = excluded[excluded_index]
      if path_within(excluded_path, root.canonical) then
        root_excluded[#root_excluded + 1] = root.lexical
      elseif path_within(root.canonical, excluded_path) then
        root_excluded[#root_excluded + 1] = rebase_path(
          excluded_path, root.canonical, root.lexical)
      end
    end
    local found = scan_root(root.lexical, root_excluded, boundaries)
    for index = 1, #found.directories do
      local directory = found.directories[index]
      if not directory_present[directory] then
        directory_present[directory] = true
        directories[#directories + 1] = directory
      end
    end
    for index = 1, #found.modules do
      local module = found.modules[index]
      if modules_by_name[module.name] == nil then
        modules_by_name[module.name] = module
        modules[#modules + 1] = module
        for file_index = 1, #module.files do
          owner_by_file[module.files[file_index]] = module.name
        end
      end
    end
    for index = 1, #found.issues do
      issues[#issues + 1] = found.issues[index]
    end
  end

  sort_modules(modules)
  sort_issues(issues)
  local include_roots: {string} = {}
  for index = 1, #roots do include_roots[index] = roots[index].lexical end
  return Discovery.new(
    include_roots, directories, modules, owner_by_file, issues)
end

function discover(include: {string}, exclude: {string}): (Discovery?, Error?)
  do
    return discover_or_raise(include, exclude), nil
  catch
    if error is async.CancellationReason then raise end
    if error is Error then return nil, error as Error end
    local path = ""
    if #include > 0 then path = include[1] end
    return nil, Error.new(path, strings.tostring(error))
  end
end
