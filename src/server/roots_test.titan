foreign import "compiler_io_platform.h"
local fs = import "fs"
local test = import "test"
local roots = import "server.roots.titan"
local source_text = import "server.source_text"
local strings = import "string"
local test_links = import "server.test_links"
local test_paths = import "server.test_paths"
local test_runtime = import "server.test_runtime"

local type Body = function (string): ()

-- A missing intermediate directory is a setup mistake, not a subject here.
local function make_directory(path: string)
  fs.mkdir(path)
end

local function remove_tree(path: string)
  local metadata? = fs.lstat(path)
  if metadata == nil then return end
  if metadata.kind == "directory" then
    local names = fs.list(path)
    for index = 1, #names do remove_tree(path .. "/" .. names[index]) end
    fs.rmdir(path)
    return
  end
  fs.unlink(path)
end

-- Filesystem work is a Runtime operation, so every case owns one Runtime
-- session exactly as the other server test owners do. These cases compare
-- roots.canonical's answer with the fixture root, so the fixture root takes the
-- canonical spelling: a host temporary directory may be spelled with an 8.3
-- short name (Windows) or reach the tree through a link, and realpath does not.
local function with_tree(body: Body)
  test_runtime.run(function ()
    local base = test_paths.temporary_name()
    defer remove_tree(base)
    local existing? = fs.lstat(base)
    if existing ~= nil then fs.unlink(base) end
    make_directory(base)
    make_directory(base .. "/outer")
    make_directory(base .. "/outer/inner")
    make_directory(base .. "/plain")
    fs.write_file(base .. "/outer/titan-config.lua", "include = { \"src\" }\n")
    fs.write_file(base .. "/outer/inner/titan-config.lua",
                  "include = { \"src\" }\n")
    base = test_paths.canonical_path(base)
    body(base)
  end)
end

local function describe(entry: roots.Root?): string
  if entry == nil then return "<none>" end
  return (entry as roots.Root).path
end

local function run_contains_boundary(base: string)
  test.assert(roots.contains(base .. "/outer", base .. "/outer"),
    "a root did not contain itself")
  test.assert(roots.contains(base .. "/outer", base .. "/outer/src/a.titan"),
    "a root did not contain an ordinary child path")
  test.assert(not roots.contains(base .. "/outer", base .. "/outermost/a.titan"),
    "a root contained a sibling whose name shares its prefix")
end

function test_roots_contain_only_component_boundaries(_context: test.Context)
  with_tree(run_contains_boundary)
end

local function run_most_specific(base: string)
  local registry = roots.create()
  local outer = roots.canonical(base .. "/outer")
  local inner = roots.canonical(base .. "/outer/inner")
  registry:add_folder(outer)
  registry:add_folder(inner)
  test.assert(describe(registry:owner(outer .. "/main.titan")) == outer,
    "an outer root did not own its own file")
  test.assert(describe(registry:owner(inner .. "/main.titan")) == inner,
    "a nested root did not own its own file")
  test.assert(describe(registry:owner(inner .. "/src/deep/main.titan")) == inner,
    "a nested root lost a deeply nested file")
  test.assert(registry:owner(base .. "/plain/other.titan") == nil,
    "a file outside every root acquired one")
  test.assert(registry:count() == 2, "duplicate registration created roots")
end

function test_roots_route_to_the_most_specific_root(_context: test.Context)
  with_tree(run_most_specific)
end

function test_roots_route_mixed_case_windows_drive_uris(_context: test.Context)
  if ffi.VSCODE_TITAN_WINDOWS == 0 then test.skip("native Windows paths") end
  with_tree(function (base: string)
    local expected = roots.canonical(base .. "/outer")
    local upper_uri: string = source_text.path_to_file_uri(expected)
    local drive = strings.sub(upper_uri, 9, 9)
    local lower_uri = strings.sub(upper_uri, 1, 8) ..
      strings.lower(drive) .. "%3A" .. strings.sub(upper_uri, 11)
    test.assert(lower_uri ~= upper_uri and
                strings.lower(drive) ~= drive,
                "fixture must exercise a mixed-case drive")
    local registry = roots.create()
    local root_path: string = source_text.file_uri_to_path(lower_uri)
    local document_path: string = source_text.file_uri_to_path(
      upper_uri .. "/src/NewFile.titan")
    registry:add_folder(roots.canonical(root_path))
    local document = roots.canonical(document_path)
    test.assert(document == expected .. "/src/NewFile.titan",
                "canonicalization changed the path suffix")
    test.assert(describe(registry:owner(document)) == expected,
                "a document spelled with the opposite drive case lost its root")
    local removed_path: string = source_text.file_uri_to_path(upper_uri)
    test.assert(registry:remove_folder(roots.canonical(removed_path)),
                "the equivalent folder spelling did not release the root")
    test.assert(registry:owner(document) == nil,
                "the released folder still owns the document")
  end)
end

local function run_folder_claims(base: string)
  local registry = roots.create()
  local outer = roots.canonical(base .. "/outer")
  registry:add_folder(outer)
  registry:add_folder(outer)
  test.assert(registry:count() == 1, "one canonical root was registered twice")
  test.assert(not registry:remove_folder(outer),
    "the first folder removal released a twice-claimed root")
  test.assert(registry:count() == 1, "a still-claimed root was released")
  test.assert(not registry:drop(outer),
    "a claimed root was dropped")
  test.assert(registry:remove_folder(outer),
    "the final folder removal did not release the root")
  -- A released root stays registered so its warm worker can be reused.
  test.assert(registry:count() == 1, "a released root was dropped immediately")
  test.assert(registry:owner(outer .. "/main.titan") == nil,
    "a released root kept owning documents")
  do
    local entry? = registry:find(outer)
    test.assert(entry ~= nil, "a released root disappeared from the registry")
    local reported = (entry as roots.Root):origin()
    local released = false
    case reported
    when folder() then released = false
    when discovered() then released = false
    when released() then released = true
    end
    test.assert(released, "a released root did not report a released origin")
  end
  test.assert(registry:drop(outer), "dropping a released root failed")
  test.assert(registry:count() == 0, "a dropped root remained registered")

  -- Re-adding the same canonical root reclaims the same entry.
  registry:add_folder(outer)
  test.assert(registry:count() == 1, "re-adding a released root registered a second entry")
  test.assert(describe(registry:owner(outer .. "/main.titan")) == outer,
    "a re-added root did not own its documents again")
end

function test_roots_refcount_duplicate_folders(_context: test.Context)
  with_tree(run_folder_claims)
end

local function run_symlink_folders(base: string)
  test_links.directory(base .. "/outer", base .. "/link",
    "cannot create the directory-symlink fixture")
  defer fs.unlink(base .. "/link")
  local registry = roots.create()
  local outer = roots.canonical(base .. "/outer")
  local linked = roots.canonical(base .. "/link")
  test.assert(linked == outer,
    "a symlinked folder did not canonicalize to its physical root")
  registry:add_folder(outer)
  registry:add_folder(linked)
  test.assert(registry:count() == 1,
    "a symlinked folder created a second root")
  test.assert(not registry:remove_folder(outer),
    "removing the physical spelling released a still-claimed root")
  test.assert(describe(registry:owner(
    roots.canonical(base .. "/link/src/a.titan"))) == outer,
    "a document below the symlink lost its physical root")
  test.assert(registry:remove_folder(linked),
    "removing the final claim did not release the root")
  test.assert(registry:owner(
    roots.canonical(base .. "/link/src/a.titan")) == nil,
    "a released root kept owning documents through a symlink")
  test.assert(registry:drop(outer), "a released symlinked root was not droppable")
end

function test_roots_share_one_root_for_symlinked_folders(
    _context: test.Context)
  with_tree(run_symlink_folders)
end

local function run_discovery(base: string)
  make_directory(base .. "/outer/inner/deep")
  defer fs.rmdir(base .. "/outer/inner/deep")
  test.assert(roots.discover(base .. "/plain/missing.titan") == nil,
    "discovery invented a root without an ancestor configuration")
  local inner = roots.canonical(base .. "/outer/inner")
  local outer = roots.canonical(base .. "/outer")
  test.assert(roots.discover(base .. "/outer/inner/deep/new.titan") == inner,
    "discovery did not select the nearest ancestor configuration")
  test.assert(roots.discover(base .. "/outer/new.titan") == outer,
    "discovery did not select the enclosing configuration")
end

function test_roots_discover_nearest_configuration(_context: test.Context)
  with_tree(run_discovery)
end

local function run_discovered_claims(base: string)
  local registry = roots.create()
  local inner = roots.canonical(base .. "/outer/inner")
  local outer = roots.canonical(base .. "/outer")
  registry:attach_discovery(inner)
  local owner = registry:owner(inner .. "/a.titan")
  test.assert(describe(owner) == inner,
    "a discovered root did not own its document")
  test.assert(registry:count() == 1, "discovery did not register a root")
  test.assert(not registry:remove_folder(inner),
    "removing an absent folder claim released a discovered root")
  test.assert(registry:count() == 1,
    "a discovered root disappeared after an unrelated folder removal")
  test.assert(registry:owner(inner .. "/a.titan") ~= nil,
    "a discovered root stopped owning its document")

  -- A folder claim and a discovery claim are independent: re-adding the folder
  -- and removing it again leaves the discovered root routing its documents.
  registry:add_folder(inner)
  test.assert(roots.contains(inner, inner .. "/a.titan"),
    "the re-claimed root lost containment")
  test.assert(not registry:remove_folder(inner),
    "a discovered root was released while its document still routed there")
  test.assert(registry:count() == 1, "re-claiming dropped the discovered root")

  -- A discovered root reports itself as discovered, never as released, and a
  -- drop is refused while it still owns documents.
  do
    local entry? = registry:find(inner)
    test.assert(entry ~= nil, "the discovered root disappeared")
    local discovered = false
    case (entry as roots.Root):origin()
    when discovered() then discovered = true
    when folder() then discovered = false
    when released() then discovered = false
    end
    test.assert(discovered, "a discovered root did not report a discovered origin")
  end
  test.assert(not registry:drop(inner), "a discovered root was dropped")

  -- A plain folder root is released at its final claim and droppable.
  registry:add_folder(outer)
  test.assert(registry:remove_folder(outer),
    "the final folder removal did not release the root")
  test.assert(registry:count() == 2,
    "releasing a folder root released the discovered root too")
  test.assert(registry:drop(outer), "a released folder root was not droppable")
  test.assert(registry:count() == 1, "dropping a released root removed another root")
end

function test_roots_keep_discovered_roots_after_folder_removal(
    _context: test.Context)
  with_tree(run_discovered_claims)
end

local function run_canonical_suffix(base: string)
  test.assert(roots.canonical(base .. "/outer/missing/a.titan") ==
    base .. "/outer/missing/a.titan",
    "canonicalizing a missing path did not preserve its suffix")
  test_links.directory(base .. "/outer", base .. "/link",
    "cannot create the directory-symlink fixture")
  defer fs.unlink(base .. "/link")
  test.assert(roots.canonical(base .. "/link/missing/a.titan") ==
    base .. "/outer/missing/a.titan",
    "canonicalizing below a symlink did not resolve its physical ancestor")
end

function test_roots_canonicalize_absent_paths_through_existing_ancestors(
    _context: test.Context)
  with_tree(run_canonical_suffix)
end
