local function buffers_before_saved_service_readiness()
  local root = test_paths.workspace_root()
  local server = application.create(root)
  defer server:close()
  local document = lsp.TextDocument.new(
    test_paths.workspace_uri() .. "/src/new.titan", root .. "/src/new.titan")
  server:on_document(lsp.DocumentNotification.opened(
    lsp.OpenDocument.new(document, 1, "unsaved")))
  server:on_document(lsp.DocumentNotification.saved(document))
  server:on_document(lsp.DocumentNotification.opened(lsp.OpenDocument.new(
    lsp.TextDocument.new(test_paths.elsewhere_uri() .. "/new.titan",
      test_paths.elsewhere_root() .. "/new.titan"), 1, "outside")))
  test.assert(#server.buffers:inputs() == 1 and
    server.buffers:inputs()[1].text == "unsaved",
    "early sync lost editor text or accepted another workspace's buffer")
  local request = dispatcher.CompletionRequest.new(
    dispatcher.RequestId.integer_id(1), lsp.CompletionParams.new(
      lsp.DocumentPosition.new(document.uri, document.path,
        source_text.Position.new(0, 3)), 1, nil))
  local work = server:capture_completion(request)
  test.assert(server.service == nil and server.refresh_task == nil and
    server.completion == nil,
    "early completion started or waited for saved workspace hydration")
  case work()
  when result(result) then
    local object? = wire.as_object(result)
    local items? = wire.as_array(object["items"])
    test.assert(wire.as_boolean(object["isIncomplete"]) == true and #items == 0)
  else test.assert(false, "early completion did not return a bounded fallback")
  end
end

function test_application_buffers_before_saved_service_readiness(_context: test.Context)
  test_runtime.run(buffers_before_saved_service_readiness)
end

local function captures_document_buffers_for_native_project_root()
  local root = "/workspace Ω"
  local path = "/workspace Ω/src/main.titan"
  local uri = "file:///workspace%20%CE%A9/src/main.titan"
  local sibling_uri = "file:///workspace%20%CE%A9-other/src/main.titan"
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then
    root = "c:\\workspace Ω"
    path = "C:/workspace Ω/src/main.titan"
    uri = "file:///c%3A/workspace%20%CE%A9/src/main.titan"
    sibling_uri = "file:///c%3A/workspace%20%CE%A9-other/src/main.titan"
  end
  local server = application.create(root)
  defer server:close()
  local saved = "local helper = import \"helper\"\n\n" ..
    "function main(): integer\n  return helper.answer()\nend\n"
  local dirty = "local helper = import \"helper\"\n\n" ..
    "function main(): integer\n  return helper.a()\nend\n"
  local document: wire.Object = {
    ["uri"] = uri, ["languageId"] = "titan", ["version"] = 4, ["text"] = saved,
  }
  local open_params: wire.Object = {["textDocument"] = document}
  local opened?, open_error? = lsp.parse_open(open_params)
  test.assert(opened ~= nil and open_error == nil and opened.document.path == path,
    "native workspace document URI did not parse to its normalized path")
  server:on_document(lsp.DocumentNotification.opened(opened))
  local inputs = server.buffers:inputs()
  test.assert(#inputs == 1 and inputs[1].path == path and
    inputs[1].version == 4 and inputs[1].text == saved,
    "native constructor path dropped the parsed open notification")

  local changed_document: wire.Object = {["uri"] = uri, ["version"] = 5}
  local replacement: wire.Object = {["text"] = dirty}
  local changes: wire.Array = {replacement}
  local change_params: wire.Object = {
    ["textDocument"] = changed_document, ["contentChanges"] = changes,
  }
  local changed?, change_error? = lsp.parse_change(change_params)
  test.assert(changed ~= nil and change_error == nil,
    "full-sync native workspace document change did not parse")
  server:on_document(lsp.DocumentNotification.changed(changed))
  local capture? = server.buffers:capture(path, source_text.Position.new(3, 17))
  test.assert(capture ~= nil and capture.document.path == path and
    capture.document.version == 5 and capture.document.text == dirty and
    capture.position.line == 3 and capture.position.character == 17 and
    #capture.inputs == 1 and capture.inputs[1] == capture.document and
    server.buffers:current(capture),
    "parsed dirty editor text was unavailable for the completion capture")

  local sibling_document: wire.Object = {
    ["uri"] = sibling_uri, ["languageId"] = "titan",
    ["version"] = 1, ["text"] = "outside",
  }
  local sibling_params: wire.Object = {["textDocument"] = sibling_document}
  local sibling?, sibling_error? = lsp.parse_open(sibling_params)
  test.assert(sibling ~= nil and sibling_error == nil,
    "sibling workspace document URI did not parse")
  server:on_document(lsp.DocumentNotification.opened(sibling))
  test.assert(#server.buffers:inputs() == 1 and server.buffers:current(capture) and
    server.buffers:capture(sibling.document.path, source_text.Position.new(0, 0)) == nil,
    "same-prefix sibling workspace entered the completion buffer store")
  test.assert(server.service == nil and server.refresh_task == nil and
    server.completion == nil,
    "document bookkeeping unexpectedly started saved workspace indexing")
end

function test_application_captures_document_buffers_for_native_project_root(
    _context: test.Context)
  test_runtime.run(captures_document_buffers_for_native_project_root)
end

local function preserves_nonabsolute_constructor_roots()
  local relative = "workspace\\Ω/../project"
  local server = application.create(relative)
  defer server:close()
  test.assert(server.project_root == relative,
    "construction changed a relative workspace root")
  if ffi.VSCODE_TITAN_WINDOWS == 0 then
    local root = "/workspace//Ω/../project\\root/"
    local unix_server = application.create(root)
    defer unix_server:close()
    test.assert(unix_server.project_root == root,
      "construction changed the original Unix workspace path bytes")
  end
end

function test_application_preserves_nonabsolute_constructor_roots(
    _context: test.Context)
  test_runtime.run(preserves_nonabsolute_constructor_roots)
end

local record YieldingAnalyzer
  runs: integer
  block: boolean
  started: boolean
  finished: boolean
  fail: boolean
end

local record RecoveringAnalyzer
  fail: boolean
  runs: integer
end

local record SavingRenameAnalyzer
  filename: string
  runs: integer
end

local function observed_provider_identity(
    path: string): compiler_io.LstatIdentity?
  local metadata? = fs.stat(path)
  if metadata == nil then return nil end
  return compiler_io.LstatIdentity.new(
    path, metadata.size, metadata.kind, metadata.device, metadata.inode,
    metadata.modified_seconds, metadata.modified_nanoseconds)
end

local function occurrence(filename: string, line: integer,
                          start_column: integer, finish_column: integer,
                          name: string, declaration_id: string,
                          role: bridge.OccurrenceRole):
    bridge.SymbolOccurrence
  local start = bridge.SourceLocation.new(filename, line, start_column)
  return bridge.SymbolOccurrence.new(
    name, declaration_id, role, start,
    bridge.SourceSpan.new(
      start,
      bridge.SourceLocation.new(filename, line, finish_column)),
    true, bridge.DeclarationVisibility.block(), nil)
end

local function find_project(request: project_service.AnalysisRequest,
                            name: string): bridge.ProjectModule?
  for index = 1, #request.project_modules do
    if request.project_modules[index].module_name == name then
      return request.project_modules[index]
    end
  end
  return nil
end

local function project_is_clean(
    module: project_service.ProjectModule): boolean
  case module.analysis_state
  when clean() then return true
  else return false
  end
end

local function project_is_failed(
    module: project_service.ProjectModule): boolean
  case module.analysis_state
  when failed() then return true
  else return false
  end
end

local function snapshot_project(snapshot: project_service.Snapshot,
                                name: string):
    project_service.ProjectModule?
  for index = 1, #snapshot.project_modules do
    if snapshot.project_modules[index].module_name == name then
      return snapshot.project_modules[index]
    end
  end
  return nil
end

local function project_snapshot(module: bridge.ProjectModule):
    bridge.ModuleSnapshot
  local filenames: {string} = {}
  for index = 1, #module.files do
    filenames[index] = module.files[index].filename
  end
  local nodes: {bridge.Node} = {}
  -- Make the fixture's completed generation observably different: only the
  -- initial three-line function contributes a structural folding node.
  if strings.find(module.files[1].contents, "  return 1\n") ~= nil then
    local start = bridge.SourceLocation.new(filenames[1], 1, 1)
    nodes[1] = bridge.Node.new(
      1, nil, "Ast.TopLevelFunc", bridge.NodeKind.declaration(), start,
      bridge.SourceSpan.new(
        start, bridge.SourceLocation.new(filenames[1], 3, 1)),
      "answer", false, false, nil, nil, nil, nil, nil)
  end
  local symbols: {bridge.SymbolOccurrence} = {}
  if strings.find(
      module.files[1].contents,
      "local answer = 1\nlocal copy = answer\n") ~= nil then
    local declaration_id =
      "ast:" .. module.module_name .. ":" .. filenames[1] ..
      ":1:7:answer"
    symbols[1] = occurrence(
      filenames[1], 1, 7, 13, "answer", declaration_id,
      bridge.OccurrenceRole.definition())
    symbols[2] = occurrence(
      filenames[1], 2, 14, 20, "answer", declaration_id,
      bridge.OccurrenceRole.reference())
  end
  return bridge.ModuleSnapshot.new(
    module.module_name,
    bridge.Provenance.project_source(
      filenames[1], filenames),
    bridge.Manifest.new(
      module.module_name, "public:" .. module.module_name,
      "source:" .. module.module_name),
    nodes, symbols, {}, {}, nil, nil)
end

local function SavingRenameAnalyzer:analyze(
    snapshot: project_service.Snapshot,
    projects: {bridge.ProjectModule}): bridge.Analysis
  self.runs = self.runs + 1
  test.assert(#projects == 1 and #projects[1].files == 1 and
              projects[1].files[1].filename == self.filename and
              projects[1].files[1].contents ==
                "local renamed = 1\nlocal copy = renamed\n",
              "rename preflight did not receive the edited saved project")

  -- Simulate a concurrent editor save after compiler preflight has started.
  -- Application must rediscover this disk generation before returning edits.
  local saved = fs.read_file(self.filename)
  fs.write_file(self.filename, saved .. "-- saved during rename\n")

  local module = projects[1]
  local declaration_id =
    "ast:" .. module.module_name .. ":" .. self.filename ..
    ":1:7:renamed"
  local checked = bridge.ModuleSnapshot.new(
    module.module_name,
    bridge.Provenance.project_source(
      self.filename, {self.filename}),
    bridge.Manifest.new(
      module.module_name, "public:" .. module.module_name,
      "source:" .. module.module_name),
    {}, {
      occurrence(self.filename, 1, 7, 14, "renamed", declaration_id,
                 bridge.OccurrenceRole.definition()),
      occurrence(self.filename, 2, 14, 21, "renamed", declaration_id,
                 bridge.OccurrenceRole.reference()),
    }, {}, {}, nil, nil)
  return bridge.Analysis.new(snapshot.project_modules[1].module_name,
                             {}, {checked}, {}, {}, {})
end

local function YieldingAnalyzer:analyze(
    request: project_service.AnalysisRequest): bridge.Analysis
  self.runs = self.runs + 1
  local should_fail = self.fail
  if self.block then
    self.started = true
    while self.block do timer.yield() end
    self.finished = true
  end
  if should_fail then raise "deliberate project recheck failure" end

  local snapshots: {bridge.ModuleSnapshot} = {}
  for index = 1, #request.dirty_modules do
    local name = request.dirty_modules[index]
    local module? = find_project(request, name)
    test.assert(module ~= nil,
                "application analyzer lost a dirty project module")
    if module == nil then raise "dirty project module is missing" end
    snapshots[index] = project_snapshot(module)
  end
  return bridge.Analysis.new(request.root_module, {}, snapshots, {}, {}, {})
end

local function RecoveringAnalyzer:analyze(
    request: project_service.AnalysisRequest): bridge.Analysis
  self.runs = self.runs + 1
  local module? = find_project(
    request, request.dirty_modules[1])
  test.assert(module ~= nil,
              "recovering analyzer lost its dirty project module")
  if module == nil then raise "recovering analyzer module is missing" end
  if self.fail then
    return bridge.Analysis.new(request.root_module, {
      bridge.Diagnostic.new(
        bridge.DiagnosticKind.syntax(), "deliberate saved-source error",
        bridge.SourceLocation.new(module.files[1].filename, 1, 1)),
    }, {}, {}, {}, {})
  end

  local snapshots: {bridge.ModuleSnapshot} = {}
  for index = 1, #request.dirty_modules do
    local dirty? = find_project(
      request, request.dirty_modules[index])
    test.assert(dirty ~= nil,
                "recovering analyzer lost a repaired project module")
    if dirty == nil then raise "repaired project module is missing" end
    snapshots[#snapshots + 1] = project_snapshot(dirty)
  end
  return bridge.Analysis.new(request.root_module, {}, snapshots, {}, {}, {})
end

local function request_for(path: string, id: integer,
                           method: string): dispatcher.SemanticRequest
  local uri?, uri_error? = source_text.path_to_file_uri(path)
  test.assert(uri_error == nil and uri ~= nil,
              "application fixture path did not become a file URI")
  if uri == nil then raise "application fixture URI is missing" end
  local actual_uri: string = uri
  local document: wire.Object = {
    ["uri"] = actual_uri,
  }
  local params: wire.Object = {
    ["textDocument"] = document,
  }
  if method == "textDocument/rename" then
    local position: wire.Object = {
      ["line"] = 0,
      ["character"] = 0,
    }
    params["position"] = position
    params["newName"] = "renamed"
  end
  return dispatcher.SemanticRequest.new(
    dispatcher.RequestId.integer_id(id), method, params)
end

local function rename_request_for(path: string, id: integer,
                                  character: integer):
    dispatcher.SemanticRequest
  local uri?, uri_error? = source_text.path_to_file_uri(path)
  test.assert(uri_error == nil and uri ~= nil,
              "application fixture path did not become a file URI")
  if uri == nil then raise "application fixture URI is missing" end
  local document: wire.Object = {
    ["uri"] = uri,
  }
  local position: wire.Object = {
    ["line"] = 0,
    ["character"] = character,
  }
  local params: wire.Object = {
    ["textDocument"] = document,
    ["position"] = position,
    ["newName"] = "renamed",
  }
  return dispatcher.SemanticRequest.new(
    dispatcher.RequestId.integer_id(id), "textDocument/rename", params)
end

local function position_request_for(path: string, id: integer,
                                    method: string, character: integer):
    dispatcher.SemanticRequest
  local uri?, uri_error? = source_text.path_to_file_uri(path)
  test.assert(uri_error == nil and uri ~= nil,
              "application fixture path did not become a file URI")
  if uri == nil then raise "application fixture URI is missing" end
  local document: wire.Object = {
    ["uri"] = uri,
  }
  local position: wire.Object = {
    ["line"] = 0,
    ["character"] = character,
  }
  local params: wire.Object = {
    ["textDocument"] = document,
    ["position"] = position,
  }
  return dispatcher.SemanticRequest.new(
    dispatcher.RequestId.integer_id(id), method, params)
end

local function result_array_length(
    outcome: dispatcher.SemanticOutcome, subject: string): integer
  case outcome
  when result(item) then
    local array? = wire.as_array(item)
    if array == nil then raise subject .. " did not return a JSON array" end
    return #array
  when failure{message} then
    test.assert(false, subject .. ": " .. message)
  end
  return -1
end

local function assert_result(outcome: dispatcher.SemanticOutcome,
                             subject: string)
  case outcome
  when result() then
  when failure{message} then
    test.assert(false, subject .. ": " .. message)
  end
end

local function assert_failure(outcome: dispatcher.SemanticOutcome,
                              subject: string)
  case outcome
  when result() then test.assert(false, subject .. " unexpectedly succeeded")
  when failure() then
  end
end

local function assert_null_result(outcome: dispatcher.SemanticOutcome,
                                  subject: string)
  case outcome
  when result(item) then
    test.assert(wire.is_null(item), subject .. " did not return null")
  when failure{message} then
    test.assert(false, subject .. ": " .. message)
  end
end

local function wait_until(predicate: function (): boolean, message: string)
  -- Worker-pool filesystem operations need a wall-clock allowance. Counting
  -- immediate scheduler turns made this expire in well under a second under
  -- load, without indicating a product liveness failure.
  for _attempt = 1, 5000 do
    if predicate() then return end
    timer.sleep(1)
  end
  test.assert(false, message)
end

-- Manual-hint policy cases retain the production registration/reconciliation
-- owner while excluding duplicate or delayed kernel events from their oracle.
local function use_manual_watch_delivery(app: application.Application)
  app:stop_watching_for_testing()
  local watching: {string: boolean} = {}
  local backend = project_watcher.Backend.new(
    function (path: string): string
      local canonical = test_paths.canonical_path(path)
      local metadata? = fs.stat(canonical)
      test.assert(metadata ~= nil and metadata.kind == "directory",
                  "manual watcher registration is not a directory")
      return canonical
    end,
    function (path: string) watching[path] = true end,
    function (path: string) watching[path] = nil end,
    function (path: string): boolean return watching[path] == true end,
    function () watching = {} end,
    function (): {project_watcher.BackendEvent}
      -- Reconciliation/close owns cancellation and joins the parked poll Task.
      async.suspend(async.ResumeToken.new("application manual watcher"))
      return {}
    end)
  local snapshot? = app:snapshot_for_testing()
  local scope = project_watcher.DirectoryScope.new({}, {app.project_root})
  if snapshot ~= nil then scope = application.watcher_scope(snapshot) end
  app.watcher = project_watcher.start_with_backend(
    backend, scope,
    function (batch: project_watcher.RediscoveryBatch) app:watch_callback(batch) end)
end

local function contains_string(items: {string}, expected: string): boolean
  for index = 1, #items do
    if items[index] == expected then return true end
  end
  return false
end

local function join_outcome(
    task: async.Task<|dispatcher.SemanticOutcome, value|>,
    subject: string): dispatcher.SemanticOutcome
  case async.join<|dispatcher.SemanticOutcome, value|>(task)
  when succeeded(outcome) then return outcome
  when failed(failure) then
    raise subject .. ": " .. strings.tostring(failure.error)
  when cancelled() then raise subject .. " was cancelled"
  else raise subject .. " did not finish"
  end
  return dispatcher.SemanticOutcome.failure(-32603, subject .. " had no outcome")
end

local function with_application_state(
    indexed: boolean,
    body: function (string, YieldingAnalyzer, application.Application): ())
  local root = test_paths.temporary_name()
  fs.unlink(root)
  fs.mkdir(root)
  local source_root = root .. "/src"
  fs.mkdir(source_root)
  local filename = source_root .. "/main.titan"
  fs.write_file(filename,
    "function answer(): integer\n" ..
    "  return 1\n" ..
    "end\n")
  defer do
    if fs.lstat(filename) ~= nil then fs.unlink(filename) end
    if fs.lstat(source_root) ~= nil then fs.rmdir(source_root) end
    if fs.lstat(root) ~= nil then fs.rmdir(root) end
  end

  local analyzer = YieldingAnalyzer.new(0, false, false, false, false)
  local service?, service_error? = test_service.load {
    project_root = root,
    installed_binary_modules_root = test_paths.sdk_binary_root(),
    analyzer = analyzer:analyze,
  }
  test.assert(service_error == nil and service ~= nil,
              "application fixture project did not load")
  if service == nil then raise "application fixture Service is missing" end
  local app?: application.Application
  if indexed then
    app = application.create_with_service(root, service)
  else
    app = application.create_unindexed_with_service(root, service)
  end
  local actual = app as application.Application
  defer do
    analyzer.block = false
    actual:close()
  end
  body(filename, analyzer, actual)
end

local function with_application(
    body: function (string, YieldingAnalyzer, application.Application): ())
  with_application_state(true, body)
end

local function with_unindexed_application(
    body: function (string, YieldingAnalyzer, application.Application): ())
  with_application_state(false, body)
end

function test_application_hover_receipt_fences_open_change_and_reopen(_context: test.Context)
  test_runtime.run(function ()
    with_application(function (filename: string, _analyzer: YieldingAnalyzer,
        app: application.Application)
      app:stop_watching_for_testing()
      local text = "local answer = 1\nlocal copy = answer\n"
      fs.write_file(filename, text)
      app:note_saved_change()
      wait_until(function (): boolean return not app:indexing_metrics().refresh_chain_active end,
        "hover capture fixture did not publish saved occurrences")
      local request = position_request_for(filename, 600, "textDocument/hover", 8)
      local document = lsp.TextDocument.new(source_text.path_to_file_uri(filename), filename)
      local assert_hover = function ()
        case app:handle(request)
        when result(value) then test.assert(wire.as_object(value) ~= nil, "saved hover fixture had no occurrence")
        when failure{message} then raise message
        end
      end
      local assert_retired = function (work: function (): dispatcher.SemanticOutcome)
        case work()
        when result(value) then test.assert(wire.is_null(value), "hover sampled a later editor session or version")
        when failure{message} then raise message
        end
      end
      assert_hover()
      local closed = app:capture_hover(request)
      app:on_document(lsp.DocumentNotification.opened(lsp.OpenDocument.new(document, 1, text)))
      assert_retired(closed)
      assert_hover()
      local changed = app:capture_hover(request)
      app:on_document(lsp.DocumentNotification.changed(lsp.ChangeDocument.new(document, 2, text)))
      assert_retired(changed)
      assert_hover()
      local reopened = app:capture_hover(request)
      app:on_document(lsp.DocumentNotification.closed(document))
      app:on_document(lsp.DocumentNotification.opened(lsp.OpenDocument.new(document, 2, text)))
      assert_retired(reopened)
      assert_hover()
    end)
  end)
end

local function remove_application_cache(path: string)
  local metadata? = fs.lstat(path)
  if metadata == nil then return end
  if metadata.kind == "directory" then
    local names = fs.list(path)
    for index = 1, #names do remove_application_cache(path .. "/" .. names[index]) end
    fs.rmdir(path)
  else
    fs.unlink(path)
  end
end

local function join_hover_owner(completion: completion_service.Service)
  if completion.debounce ~= nil then
    case async.join(completion.debounce)
    when succeeded() then
    when failed(failure) then raise failure.error
    else raise "application hover debounce did not finish"
    end
  end
  if completion.worker ~= nil then
    case async.join(completion.worker)
    when succeeded() then
    when failed(failure) then raise failure.error
    else raise "application hover worker did not finish"
    end
  end
end

function test_application_accepted_hover_survives_save_and_watcher_publication(_context: test.Context)
  test_runtime.run(function ()
    local root = test_paths.temporary_name()
    fs.unlink(root)
    fs.mkdir(root)
    local source_root = root .. "/src"
    fs.mkdir(source_root)
    local filename = source_root .. "/main.titan"
    local declaration = "function combine(count: integer): integer return count end\n"
    local saved = declaration .. "function read(): integer return 1 end\n"
    local editing = declaration .. "function read(): integer local count = 1 return comb end\n"
    local accepted = declaration .. "function read(): integer local count = 1 return combine(count) end\n"
    fs.write_file(filename, saved)
    defer do
      remove_application_cache(workspace_cache.directory(root))
      if fs.lstat(filename) ~= nil then fs.unlink(filename) end
      if fs.lstat(source_root) ~= nil then fs.rmdir(source_root) end
      if fs.lstat(root) ~= nil then fs.rmdir(root) end
    end
    local app = application.create(root)
    defer app:close()
    app:start_indexing()
    local initial_task? = app.refresh_task
    local initial_view?, initial_error? = application.joined_view(initial_task)
    test.assert(initial_view ~= nil and initial_error == nil,
      "real application fixture did not publish its initial saved index")
    local initial_generation = initial_view.published_generation
    local uri? = source_text.path_to_file_uri(filename)
    local document = lsp.TextDocument.new(uri, filename)
    app:on_document(lsp.DocumentNotification.opened(lsp.OpenDocument.new(document, 1, editing)))
    local needle? = strings.find(editing, "return comb", 1, true)
    local position? = source_text.position_for_offset(editing, needle - 1 + #"return comb")
    local request = dispatcher.CompletionRequest.new(dispatcher.RequestId.integer_id(620),
      lsp.CompletionParams.new(lsp.DocumentPosition.new(uri, filename, position), 1, nil),
      lsp.CompletionOptions.new(true, true, true))
    local work = app:capture_completion(request)
    work()
    local completion? = app.completion
    join_hover_owner(completion)
    local saw_snippet = false
    case work()
    when result(value) then
      local object? = wire.as_object(value)
      local items? = wire.as_array(object["items"])
      for index = 1, #items do
        local item? = wire.as_object(items[index])
        if wire.as_string(item["label"]) == "combine" then
          local edit? = wire.as_object(item["textEdit"])
          saw_snippet = wire.as_string(edit["newText"]) == "combine(${1:count})$0"
        end
      end
    when failure{message} then raise message
    end
    test.assert(saw_snippet, "real application did not prepare the accepted call snippet")
    app:on_document(lsp.DocumentNotification.changed(lsp.ChangeDocument.new(document, 2, accepted)))
    join_hover_owner(completion)
    local accepted_context? = completion.hover_context
    test.assert(accepted_context.source,
      "accepting a call did not autonomously replace the completion hole with real source")
    local accepted_id = accepted_context.id
    local hover = position_request_for(filename, 621, "textDocument/hover", 49)
    local params? = wire.as_object(hover.params)
    local hover_position: wire.Object = {["line"] = 1, ["character"] = 49}
    params["position"] = hover_position
    local assert_accepted_hover = function ()
      case app:handle(hover)
      when result(value) then
        local object? = wire.as_object(value)
        local contents? = wire.as_object(object["contents"])
        local markdown? = wire.as_string(contents["value"])
        test.assert(strings.find(markdown, "combine(count: integer)") ~= nil,
          "accepted call hover disappeared during the saved-index handoff")
      when failure{message} then raise message
      end
    end
    assert_accepted_hover()

    -- Native watcher timing is excluded from this regression. didSave only
    -- records editor lifecycle; the explicit saved hint owns the publication.
    use_manual_watch_delivery(app)
    fs.write_file(filename, accepted)
    app:on_document(lsp.DocumentNotification.saved(document))
    assert_accepted_hover()
    test.assert(completion.hover_context.id == accepted_id and
      app.completed_view.published_generation == initial_generation,
      "didSave retired accepted hover or promoted its private source")
    local store = app.service:workspace_store()
    do
      local access = store:acquire()
      defer access:release()
      local rows = stores.rows(access.connection,
        "SELECT contents FROM main.semantic_files WHERE filename=?", sqlite3.Blob.new(filename))
      test.assert(#rows == 1 and stores.bytes(rows[1], 1) == saved,
        "didSave wrote unsaved editor facts into the committed saved index")
    end

    local callback_saw_retention = false
    local callback_saw_debounce = false
    app:set_indexing_listener(function (status: indexing_status.Status)
      if indexing_status.state_name(status.state) == "ready" and
          status.generation ~= nil and status.generation > initial_generation then
        callback_saw_retention = completion.hover_context ~= nil and
          completion.hover_context.id == accepted_id
        callback_saw_debounce = completion.saved_generation == status.generation and
          completion.debounce ~= nil and not completion.debounce:status():has_finished()
      end
    end)
    local permit = compiler_scheduler.acquire()
    defer permit:release()
    app:note_saved_change()
    local saved_task? = app.refresh_task
    local pending_view?, pending_error? = app:current_view()
    test.assert(pending_error == nil and pending_view == initial_view,
      "saved refresh did not keep the preceding immutable view serviceable")
    assert_accepted_hover()
    test.assert(completion.hover_context.id == accepted_id,
      "pending saved analysis retired the accepted unsaved hover context")
    -- Release before joining: both the saved analysis and private replacement
    -- use the same permit and must be allowed to finish in ordinary FIFO order.
    permit:release()
    local published_view?, published_error? = application.joined_view(saved_task)
    test.assert(published_view ~= nil and published_error == nil and
        published_view.published_generation > initial_generation,
      "explicit watcher hint did not publish the changed saved bytes")
    test.assert(callback_saw_retention and callback_saw_debounce,
      "saved publication cleared accepted hover or failed to queue private reanalysis")
    assert_accepted_hover()
    join_hover_owner(completion)
    local refreshed? = completion.hover_context
    test.assert(refreshed.source and refreshed.id ~= accepted_id,
      "new committed baseline did not receive an autonomous hover replacement")
    do
      local access = store:acquire()
      defer access:release()
      test.assert(stores.scalar_integer(access.connection,
        "SELECT saved_generation FROM temp.retained_hover_snapshots WHERE id=?",
        sqlite3.Blob.new(refreshed.id)) == published_view.published_generation,
        "replacement hover context used the previous committed saved generation")
      local rows = stores.rows(access.connection,
        "SELECT contents FROM main.semantic_files WHERE filename=?", sqlite3.Blob.new(filename))
      test.assert(#rows == 1 and stores.bytes(rows[1], 1) == accepted,
        "watcher publication did not own the saved-source replacement")
    end
    assert_accepted_hover()
  end)
end

local function with_cold_application(
    body: function (string, YieldingAnalyzer, application.Application): ())
  local root = test_paths.temporary_name()
  fs.unlink(root)
  fs.mkdir(root)
  local source_root = root .. "/src"
  fs.mkdir(source_root)
  local filename = source_root .. "/main.titan"
  fs.write_file(filename,
    "function answer(): integer\n" ..
    "  return 1\n" ..
    "end\n")
  defer do
    if fs.lstat(filename) ~= nil then fs.unlink(filename) end
    if fs.lstat(source_root) ~= nil then fs.rmdir(source_root) end
    if fs.lstat(root) ~= nil then fs.rmdir(root) end
  end

  local analyzer = YieldingAnalyzer.new(0, false, false, false, false)
  local app = application.create(
    root,
    function (project_root: string,
              _progress_listener: bridge.ProgressListener?,
              snapshot_listener: project_service.SnapshotListener?):
        (project_service.Service?, project_service.Error?, project_loader.Restoration?)
      local loaded?,failure? = test_service.load {
        project_root = project_root,
        installed_binary_modules_root = test_paths.sdk_binary_root(),
        analyzer = analyzer:analyze,
        snapshot_listener = snapshot_listener,
      }
      return loaded,failure,nil
    end)
  defer do
    analyzer.block = false
    app:close()
  end
  body(filename, analyzer, app)
end

local function returns_empty_results_while_initial_index_runs()
  with_unindexed_application(function (
      filename: string, _analyzer: YieldingAnalyzer,
      app: application.Application)
    local statuses: {indexing_status.Status} = {}
    app:set_indexing_listener(function (status: indexing_status.Status)
      statuses[#statuses + 1] = status
    end)

    app:start_indexing()
    app:start_indexing()
    test.assert(
      result_array_length(
        app:handle(request_for(
          filename, 30, "textDocument/foldingRange")),
        "folding request during initial index") == 0,
      "initial folding request did not return an empty result")
    assert_null_result(
      app:handle(position_request_for(
        filename, 31, "textDocument/definition", 1)),
      "definition request during initial index")

    wait_until(function (): boolean return #statuses == 2 end,
               "initial background index did not reach ready")
    local metrics = app:indexing_metrics()
    test.assert(metrics.refresh_passes == 1 and metrics.view_builds == 1,
                "idempotent initial indexing started duplicate work")
    test.assert(indexing_status.state_name(statuses[1].state) == "indexing" and
                indexing_status.state_name(statuses[2].state) == "ready" and
                statuses[1].initial and statuses[2].initial and
                statuses[2].generation ~= nil,
                "initial index emitted the wrong bounded status sequence")
  end)
end

local function catches_save_while_cold_index_is_blocked()
  with_cold_application(function (
      filename: string, analyzer: YieldingAnalyzer,
      app: application.Application)
    local statuses: {indexing_status.Status} = {}
    app:set_indexing_listener(function (status: indexing_status.Status)
      statuses[#statuses + 1] = status
    end)
    analyzer.block = true
    analyzer.started = false
    app:start_indexing()
    wait_until(function (): boolean return analyzer.started end,
               "cold index analyzer did not start")
    test.assert(#app:watched_directories_for_testing() > 0,
                "cold index did not register its watcher before analysis")

    local epoch_before = app:change_epoch_for_testing()
    local changed = "function answer(): integer return 123456 end\n"
    fs.write_file(filename, changed)
    wait_until(function (): boolean
      return app:change_epoch_for_testing() > epoch_before
    end, "watcher did not observe a save during cold analysis")

    analyzer.block = false
    wait_until(function (): boolean
      local metrics = app:indexing_metrics()
      return metrics.refresh_passes >= 2 and
             not metrics.refresh_chain_active
    end, "save during cold analysis did not reach a replacement generation")
    local snapshot? = app:snapshot_for_testing()
    test.assert(snapshot ~= nil,
                "cold index did not retain its recovered project service")
    local saved = snapshot as project_service.Snapshot
    test.assert(#saved.project_modules == 1 and
                #saved.project_modules[1].source_files == 1 and
                saved.project_modules[1].source_files[1].contents == changed,
                "cold index published the pre-save project snapshot")
    test.assert(#statuses > 0 and
                indexing_status.state_name(statuses[#statuses].state) ==
                  "ready",
                "cold save recovery did not finish ready")
  end)
end

local function recovers_initial_error_from_later_save()
  with_cold_application(function (
      filename: string, analyzer: YieldingAnalyzer,
      app: application.Application)
    local statuses: {indexing_status.Status} = {}
    app:set_indexing_listener(function (status: indexing_status.Status)
      statuses[#statuses + 1] = status
    end)
    analyzer.fail = true
    app:start_indexing()
    wait_until(function (): boolean
      return #statuses > 0 and
             indexing_status.state_name(statuses[#statuses].state) ==
               "failed" and
             not app:indexing_metrics().refresh_chain_active
    end, "cold index did not publish its initial failure")
    test.assert(#app:watched_directories_for_testing() > 0,
                "initial compiler failure discarded the project watcher")

    local epoch_before = app:change_epoch_for_testing()
    local changed = "function answer(): integer return 654321 end\n"
    analyzer.fail = false
    fs.write_file(filename, changed)
    wait_until(function (): boolean
      return app:change_epoch_for_testing() > epoch_before
    end, "watcher did not observe the save which repaired initial failure")
    wait_until(function (): boolean
      return analyzer.runs >= 2 and #statuses > 0 and
             indexing_status.state_name(statuses[#statuses].state) ==
               "ready" and
             not app:indexing_metrics().refresh_chain_active
    end, "save did not recover the initially failed cold index")

    local snapshot? = app:snapshot_for_testing()
    test.assert(snapshot ~= nil,
                "recovered cold index did not retain its project service")
    local saved = snapshot as project_service.Snapshot
    test.assert(#saved.project_modules == 1 and
                #saved.project_modules[1].source_files == 1 and
                saved.project_modules[1].source_files[1].contents == changed,
                "initial-error recovery published the pre-save snapshot")
  end)
end

local function recovers_configuration_load_failure_from_later_save()
  local root = test_paths.temporary_name()
  fs.unlink(root)
  fs.mkdir(root)
  local filename = root .. "/main.titan"
  local config_file = root .. "/titan-config.lua"
  fs.write_file(filename, "function answer(): integer return 1 end\n")
  fs.write_file(config_file, "return {\n")
  defer do
    if fs.lstat(config_file) ~= nil then fs.unlink(config_file) end
    if fs.lstat(filename) ~= nil then fs.unlink(filename) end
    if fs.lstat(root) ~= nil then fs.rmdir(root) end
  end

  local analyzer = YieldingAnalyzer.new(0, false, false, false, false)
  local app = application.create(
    root,
    function (project_root: string,
              _progress_listener: bridge.ProgressListener?,
              snapshot_listener: project_service.SnapshotListener?):
        (project_service.Service?, project_service.Error?, project_loader.Restoration?)
      local loaded?,failure? = test_service.load {
        project_root = project_root,
        installed_binary_modules_root = test_paths.sdk_binary_root(),
        analyzer = analyzer:analyze,
        snapshot_listener = snapshot_listener,
      }
      return loaded,failure,nil
    end)
  defer app:close()

  local statuses: {indexing_status.Status} = {}
  app:set_indexing_listener(function (status: indexing_status.Status)
    statuses[#statuses + 1] = status
  end)
  app:start_indexing()
  wait_until(function (): boolean
    return #statuses > 0 and
           indexing_status.state_name(statuses[#statuses].state) ==
             "failed" and
           not app:indexing_metrics().refresh_chain_active
  end, "invalid cold configuration did not finish with a failure")
  test.assert(
    contains_string(app:watched_directories_for_testing(), test_paths.canonical_path(root)),
    "configuration failure did not retain a provisional project watcher")

  local failed_statuses = #statuses
  assert_failure(app:handle(request_for(
    filename, 0, "textDocument/foldingRange")),
    "unchanged request after initial configuration failure")
  test.assert(#statuses == failed_statuses and
              not app:indexing_metrics().refresh_chain_active,
              "unchanged request retried the failed configuration epoch")

  fs.write_file(config_file,
    "include = { \".\" }\n" ..
    "source_module_roots = { \".\" }\n")
  -- Inject the exact saved-file hint deterministically. ProjectWatcher tests
  -- separately cover delivery from the filesystem backend; this regression
  -- exercises the Application lifecycle after a pre-Service load failure.
  app:watch_callback(project_watcher.RediscoveryBatch.new({
    project_watcher.PathChange.modified(config_file),
  }, {}, false))
  wait_until(function (): boolean
    return analyzer.runs > 0 and #statuses > 0 and
           indexing_status.state_name(statuses[#statuses].state) == "ready" and
           not app:indexing_metrics().refresh_chain_active
  end, "saved valid configuration did not recover the cold project")
  local snapshot? = app:snapshot_for_testing()
  test.assert(snapshot ~= nil,
              "configuration recovery did not publish the saved project")
  local saved = snapshot as project_service.Snapshot
  test.assert(#saved.project_modules == 1,
              "configuration recovery published the wrong project")
end

local function reconciles_expanded_scope_before_existing_analysis()
  local workspace = test_paths.temporary_name()
  fs.unlink(workspace)
  fs.mkdir(workspace)
  local root = workspace .. "/project"
  local old_root = workspace .. "/old_source"
  local next_root = workspace .. "/next_source"
  fs.mkdir(root)
  fs.mkdir(old_root)
  fs.mkdir(next_root)
  local config_file = root .. "/titan-config.lua"
  local old_filename = old_root .. "/main.titan"
  local next_filename = next_root .. "/main.titan"
  fs.write_file(config_file,
    "include = { \"../old_source\" }\n" ..
    "source_module_roots = { \"../old_source\" }\n")
  fs.write_file(old_filename, "function answer(): integer return 1 end\n")
  fs.write_file(next_filename, "function answer(): integer return 2 end\n")
  defer do
    if fs.lstat(config_file) ~= nil then fs.unlink(config_file) end
    if fs.lstat(old_filename) ~= nil then fs.unlink(old_filename) end
    if fs.lstat(next_filename) ~= nil then fs.unlink(next_filename) end
    if fs.lstat(old_root) ~= nil then fs.rmdir(old_root) end
    if fs.lstat(next_root) ~= nil then fs.rmdir(next_root) end
    if fs.lstat(root) ~= nil then fs.rmdir(root) end
    if fs.lstat(workspace) ~= nil then fs.rmdir(workspace) end
  end

  local analyzer = YieldingAnalyzer.new(0, false, false, false, false)
  local service?, service_error? = test_service.load {
    project_root = root,
    installed_binary_modules_root = test_paths.sdk_binary_root(),
    analyzer = analyzer:analyze,
  }
  test.assert(service_error == nil and service ~= nil,
              "scope-expansion fixture project did not load")
  if service == nil then raise "scope-expansion fixture Service is missing" end
  local app = application.create_with_service(root, service)
  defer app:close()

  local statuses: {indexing_status.Status} = {}
  app:set_indexing_listener(function (status: indexing_status.Status)
    statuses[#statuses + 1] = status
  end)
  analyzer.block = true
  analyzer.started = false
  fs.write_file(config_file,
    "include = { \"../next_source\" }\n" ..
    "source_module_roots = { \"../next_source\" }\n")
  app:note_saved_change()
  wait_until(function (): boolean return analyzer.started end,
             "expanded-scope analyzer did not start")
  test.assert(
    contains_string(
      app:watched_directories_for_testing(), test_paths.canonical_path(next_root)),
    "new source root was not watched before existing-Service analysis")

  local changed = "function answer(): integer return 987654 end\n"
  fs.write_file(next_filename, changed)
  app:watch_callback(project_watcher.RediscoveryBatch.new({
    project_watcher.PathChange.modified(next_filename),
  }, {}, false))
  analyzer.block = false
  wait_until(function (): boolean
    return analyzer.runs >= 3 and #statuses > 0 and
           indexing_status.state_name(statuses[#statuses].state) == "ready" and
           not app:indexing_metrics().refresh_chain_active
  end, "save in expanded watcher scope did not reach a follow-up generation")
  local snapshot? = app:snapshot_for_testing()
  test.assert(snapshot ~= nil,
              "expanded-scope refresh did not retain a project snapshot")
  local saved = snapshot as project_service.Snapshot
  test.assert(#saved.config.include == 1 and
              saved.config.include[1] == next_root and
              #saved.project_modules == 1 and
              #saved.project_modules[1].source_files == 1 and
              saved.project_modules[1].source_files[1].contents == changed,
              "expanded-scope save published the pre-save snapshot")
end

local function coalesces_continuous_hints_after_publishing_one_pass()
  with_unindexed_application(function (
      filename: string, analyzer: YieldingAnalyzer,
      app: application.Application)
    use_manual_watch_delivery(app)
    local statuses: {indexing_status.Status} = {}
    app:set_indexing_listener(function (status: indexing_status.Status)
      statuses[#statuses + 1] = status
    end)
    fs.write_file(
      filename, "function answer(): integer return 123456 end\n")
    analyzer.block = true
    analyzer.started = false
    analyzer.finished = false
    app:start_indexing()
    wait_until(function (): boolean return analyzer.started end,
               "coalescing fixture analyzer did not start")

    for _hint = 1, 100 do app:note_saved_change() end
    test.assert(app:indexing_metrics().refresh_passes == 1,
                "hint burst started an overlapping refresh pass")
    analyzer.block = false

    wait_until(function (): boolean return #statuses == 3 end,
               "coalesced refresh chain did not reach ready")
    local metrics = app:indexing_metrics()
    test.assert(metrics.refresh_passes == 2,
                "hint burst did not coalesce into exactly one follow-up pass")
    test.assert(metrics.view_builds == 1,
                "unchanged follow-up generation rebuilt semantic Features")
    test.assert(indexing_status.state_name(statuses[1].state) == "indexing" and
                indexing_status.state_name(statuses[2].state) == "indexing" and
                statuses[2].completed_files == nil and
                statuses[2].total_files == nil and
                statuses[2].epoch == 101 and
                indexing_status.state_name(statuses[3].state) == "ready" and
                statuses[3].epoch == 101,
                "coalesced chain did not reset and finish the pending epoch")
  end)
end

local function keeps_progress_on_the_active_pass_epoch()
  with_unindexed_application(function (
      filename: string, analyzer: YieldingAnalyzer,
      app: application.Application)
    use_manual_watch_delivery(app)
    local statuses: {indexing_status.Status} = {}
    app:set_indexing_listener(function (status: indexing_status.Status)
      statuses[#statuses + 1] = status
    end)
    fs.write_file(
      filename, "function answer(): integer return 123456 end\n")
    analyzer.block = true
    analyzer.started = false
    app:start_indexing()
    wait_until(function (): boolean return analyzer.started end,
               "progress epoch fixture analyzer did not start")

    app:emit_compiler_progress(bridge.AnalysisProgress.new(0, 1))
    app:note_saved_change()
    app:emit_compiler_progress(bridge.AnalysisProgress.new(1, 1))
    analyzer.block = false
    wait_until(function (): boolean return #statuses == 5 end,
               "progress epoch fixture did not reach ready")

    test.assert(indexing_status.state_name(statuses[1].state) == "indexing" and
                statuses[1].completed_files == nil and
                statuses[1].total_files == nil and
                statuses[1].epoch == 1,
                "indexing chain did not emit its bounded busy state")
    test.assert(statuses[2].completed_files == 0 and
                statuses[2].total_files == 1 and
                statuses[2].epoch == 1 and
                statuses[3].completed_files == 1 and
                statuses[3].total_files == 1 and
                statuses[3].epoch == 1,
                "watch hint relabeled in-flight compiler work to a newer epoch")
    test.assert(indexing_status.state_name(statuses[4].state) == "indexing" and
                statuses[4].epoch == 2 and
                statuses[4].completed_files == nil and
                statuses[4].total_files == nil,
                "coalesced follow-up retained the preceding pass progress")
    test.assert(indexing_status.state_name(statuses[5].state) == "ready" and
                statuses[5].epoch == 2 and
                statuses[5].completed_files == nil and
                statuses[5].total_files == nil,
                "coalesced follow-up did not publish the newer terminal epoch")
  end)
end

local function retries_failure_when_a_later_epoch_is_pending()
  with_unindexed_application(function (
      filename: string, analyzer: YieldingAnalyzer,
      app: application.Application)
    use_manual_watch_delivery(app)
    local statuses: {indexing_status.Status} = {}
    app:set_indexing_listener(function (status: indexing_status.Status)
      statuses[#statuses + 1] = status
    end)
    fs.write_file(
      filename, "function answer(): integer return 123456 end\n")
    analyzer.block = true
    analyzer.started = false
    analyzer.fail = true
    local runs_before = analyzer.runs
    app:start_indexing()
    wait_until(function (): boolean return analyzer.started end,
               "failure retry fixture analyzer did not start")

    app:note_saved_change()
    analyzer.fail = false
    analyzer.block = false
    wait_until(function (): boolean return #statuses == 3 end,
               "later epoch did not retry the failed refresh")

    test.assert(analyzer.runs == runs_before + 2 and
                app:indexing_metrics().refresh_passes == 2,
                "later epoch did not run exactly one replacement analysis")
    test.assert(indexing_status.state_name(statuses[1].state) == "indexing" and
                indexing_status.state_name(statuses[2].state) == "indexing" and
                statuses[2].completed_files == nil and
                statuses[2].total_files == nil and
                statuses[2].epoch == 2 and
                indexing_status.state_name(statuses[3].state) == "ready" and
                statuses[3].epoch == 2,
                "recovering chain exposed an intermediate failed status")
  end)
end

local function filters_irrelevant_watcher_hints()
  with_application(function (filename: string, _analyzer: YieldingAnalyzer,
                             app: application.Application)
    use_manual_watch_delivery(app)
    local snapshot? = app:snapshot_for_testing()
    test.assert(snapshot ~= nil, "watch filtering fixture has no snapshot")
    local saved = snapshot as project_service.Snapshot
    local source_root = saved.config.include[1]
    local project_root = saved.config.project_root
    local package_directory = source_root .. "/new_package"
    local build_directory = source_root .. "/build"
    local temp_directory = source_root .. "/tmp"
    local editor_directory = source_root .. "/.editor"
    local dotted_directory = source_root .. "/build.debug"
    local makefile = source_root .. "/Makefile"
    local second_root = project_root .. "/other-src"
    local nested_root = source_root .. "/generated.code/nested-src"
    local implicit_nested_root = source_root .. "/vendor.foo/src"
    local lookup_root = project_root .. "/compiler-only"
    local excluded_directory = source_root .. "/generated"
    local excluded_file = source_root .. "/ignored.titan"
    local filtered_config = project_config.ProjectConfig.new(
      saved.config.project_root, saved.config.config_file,
      {source_root, second_root, nested_root},
      {excluded_directory, excluded_file},
      {source_root, second_root, implicit_nested_root, lookup_root},
      saved.config.binary_modules_root,
      saved.config.extra_ffi_include_dirs,
      saved.config.extra_ffi_cppflags)
    local filtered = project_service.Snapshot.new(
      saved.generation, filtered_config, saved.discovery_issues,
      saved.project_directories, saved.project_modules,
      saved.external_modules, saved.dirty_modules)
    fs.write_file(makefile, "all:\n")
    defer fs.unlink(makefile)
    test.assert(application.relevant_watch_change(
                  saved, project_watcher.PathChange.modified(filename)),
                "saved Titan path was filtered out")
    test.assert(application.relevant_watch_change(
                  saved, project_watcher.PathChange.modified(source_root)),
                "known source directory was filtered out")
    test.assert(application.relevant_watch_change(
                  saved, project_watcher.PathChange.modified(
                    project_root .. "/titan-config.lua")),
                "exact project configuration path was filtered out")
    test.assert(application.relevant_watch_change(
                  filtered, project_watcher.PathChange.modified(
                    second_root .. "/second.titan")),
                "saved Titan path in a later include root was filtered out")
    test.assert(application.relevant_watch_change(
                  filtered, project_watcher.PathChange.modified(
                    nested_root .. "/nested.titan")),
                "nested root below an ancestor-invalid path was filtered out")
    test.assert(application.relevant_watch_change(
                  filtered, project_watcher.PathChange.modified(
                    implicit_nested_root .. "/nested.titan")),
                "nested source root below an ancestor-invalid path was " ..
                "filtered out")
    test.assert(not application.relevant_watch_change(
                  filtered, project_watcher.PathChange.modified(
                    excluded_file)) and
                not application.relevant_watch_change(
                  filtered, project_watcher.PathChange.modified(
                    excluded_directory .. "/nested.titan")) and
                not application.relevant_watch_change(
                  filtered, project_watcher.PathChange.created(
                    excluded_directory)),
                "excluded file or directory hint remained watch-relevant")
    test.assert(not application.relevant_watch_change(
                  saved, project_watcher.PathChange.modified(
                    source_root .. "/main.o")) and
                not application.relevant_watch_change(
                  saved, project_watcher.PathChange.modified(
                    source_root .. "/.main.titan.swp")) and
                not application.relevant_watch_change(
                  saved, project_watcher.PathChange.modified(
                    project_root .. "/titan-config.lua.tmp")) and
                not application.relevant_watch_change(
                  saved, project_watcher.PathChange.modified(
                    test_paths.outside_project_file())) and
                not application.relevant_watch_change(
                  filtered, project_watcher.PathChange.modified(
                    lookup_root .. "/external.titan")) and
                not application.relevant_watch_change(
                  saved, project_watcher.PathChange.modified(
                    editor_directory)) and
                not application.relevant_watch_change(
                  saved, project_watcher.PathChange.modified(
                    source_root .. "/.titan-ls/generated.titan")) and
                not application.relevant_watch_change(
                  saved, project_watcher.PathChange.modified(
                    project_root .. "/.titan-ls/workspace.sqlite3")) and
                not application.relevant_watch_change(
                  saved, project_watcher.PathChange.modified(
                    dotted_directory)) and
                not application.relevant_watch_change(
                  saved, project_watcher.PathChange.modified(
                    dotted_directory .. "/generated.titan")) and
                not application.relevant_watch_change(
                  saved, project_watcher.PathChange.modified(
                    build_directory .. "/generated.o")) and
                not application.relevant_watch_change(
                  saved, project_watcher.PathChange.modified(
                    temp_directory .. "/main.titan.tmp")) and
                not application.relevant_watch_change(
                  saved, project_watcher.PathChange.modified(makefile)),
                "unrelated build/editor path was treated as a project change")

    local cache_root = project_root .. "/.titan-ls"
    local cache_config = project_config.ProjectConfig.new(project_root, nil,
      {cache_root}, {}, {cache_root}, saved.config.binary_modules_root,
      saved.config.extra_ffi_include_dirs, saved.config.extra_ffi_cppflags)
    local cache_snapshot = project_service.Snapshot.new(saved.generation,
      cache_config, {}, {cache_root}, {}, {}, {})
    test.assert(not application.relevant_watch_change(cache_snapshot,
      project_watcher.PathChange.modified(cache_root)) and
      not application.relevant_watch_change(cache_snapshot,
        project_watcher.PathChange.created(cache_root .. "/nested")) and
      not application.relevant_watch_change(cache_snapshot,
        project_watcher.PathChange.modified(cache_root .. "/generated.titan")),
      "explicitly mapped cache source root escaped the private-cache exclusion")

    local previous_log_level = logging.level()
    defer logging.configure(previous_log_level)
    test.assert(logging.configure("debug"),
                "watch filtering fixture could not enable debug logging")
    local malformed_path = source_root .. "/" .. strings.char(0xff)
    local before = app:indexing_metrics().refresh_passes
    app:watch_callback(project_watcher.RediscoveryBatch.new({
      project_watcher.PathChange.modified(source_root .. "/main.o"),
      project_watcher.PathChange.modified(
        source_root .. "/.main.titan.swp"),
      project_watcher.PathChange.modified(
        dotted_directory .. "/generated.titan"),
      project_watcher.PathChange.modified(malformed_path),
      project_watcher.PathChange.modified(makefile),
    }, {}, false))
    timer.yield()
    test.assert(app:indexing_metrics().refresh_passes == before,
                "irrelevant watcher batch started a refresh")

    local compiler_temporary = source_root .. "/XXcompiler"
    fs.write_file(compiler_temporary, "temporary reservation")
    defer fs.unlink(compiler_temporary)
    local epoch_before_temporary = app:change_epoch_for_testing()
    app:watch_callback(project_watcher.RediscoveryBatch.new({
      project_watcher.PathChange.created(compiler_temporary),
    }, {}, false))
    wait_until(function (): boolean
      return not app:directory_probe_active_for_testing()
    end, "extensionless regular-file probe did not finish")
    test.assert(app:indexing_metrics().refresh_passes == before and
                app:change_epoch_for_testing() == epoch_before_temporary,
                "compiler-style temporary file scheduled a refresh")

    local statuses: {indexing_status.Status} = {}
    app:set_indexing_listener(function (status: indexing_status.Status)
      statuses[#statuses + 1] = status
    end)
    app:watch_callback(project_watcher.RediscoveryBatch.new(
      {project_watcher.PathChange.modified(filename)}, {}, false))
    wait_until(function (): boolean return #statuses == 2 end,
               "Titan watcher hint did not refresh")
    app:watch_callback(project_watcher.RediscoveryBatch.new({}, {}, true))
    wait_until(function (): boolean return #statuses == 4 end,
               "watch-set retirement did not refresh")
    test.assert(app:indexing_metrics().refresh_passes == before + 2,
                "relevant watcher hints did not start bounded refreshes")
    fs.mkdir(package_directory)
    fs.mkdir(build_directory)
    fs.mkdir(temp_directory)
    defer do
      fs.rmdir(temp_directory)
      fs.rmdir(build_directory)
      fs.rmdir(package_directory)
    end
    test.assert(application.relevant_watch_change(
                  saved, project_watcher.PathChange.created(
                    package_directory)) and
                application.relevant_watch_change(
                  saved, project_watcher.PathChange.created(
                    build_directory)) and
                application.relevant_watch_change(
                  saved, project_watcher.PathChange.created(
                    temp_directory)) and
                application.relevant_watch_change(
                  saved, project_watcher.PathChange.created(
                    build_directory .. "/generated.titan")),
                "valid-named new source directory was filtered out")
    local before_directory = app:indexing_metrics().refresh_passes
    app:watch_callback(project_watcher.RediscoveryBatch.new({
      project_watcher.PathChange.created(compiler_temporary),
      project_watcher.PathChange.created(source_root .. "/XXvanished"),
      project_watcher.PathChange.created(package_directory),
    }, {}, false))
    wait_until(function (): boolean
      local metrics = app:indexing_metrics()
      return not app:directory_probe_active_for_testing() and
             metrics.refresh_passes == before_directory + 1 and
             not metrics.refresh_chain_active
    end, "new source-directory probe did not schedule one refresh")
    test.assert(app:indexing_metrics().refresh_passes == before_directory + 1,
                "new source-directory probe scheduled repeated refreshes")
  end)
end

local function refreshes_unmapped_warnings_only_during_ordinary_discovery()
  local root = test_paths.temporary_name()
  fs.unlink(root)
  fs.mkdir(root)
  local source_root = root .. "/src"
  local unmapped_root = root .. "/loose"
  local filename = source_root .. "/main.titan"
  local loose = root .. "/loose.titan"
  local removed = unmapped_root .. "/other.titan"
  local created = unmapped_root .. "/new.titan"
  local config = root .. "/titan-config.lua"
  defer do
    if fs.lstat(created) ~= nil then fs.unlink(created) end
    if fs.lstat(removed) ~= nil then fs.unlink(removed) end
    if fs.lstat(loose) ~= nil then fs.unlink(loose) end
    if fs.lstat(filename) ~= nil then fs.unlink(filename) end
    if fs.lstat(config) ~= nil then fs.unlink(config) end
    if fs.lstat(unmapped_root) ~= nil then fs.rmdir(unmapped_root) end
    if fs.lstat(source_root) ~= nil then fs.rmdir(source_root) end
    if fs.lstat(root) ~= nil then fs.rmdir(root) end
  end
  fs.mkdir(source_root)
  fs.mkdir(unmapped_root)
  fs.write_file(filename, "function answer(): integer return 1 end\n")
  fs.write_file(loose, "not valid Titan source\n")
  fs.write_file(removed, "also not valid Titan source\n")
  fs.write_file(config,
    "include = { '.' }\nsource_module_roots = { 'src' }\n")
  local analyzer = YieldingAnalyzer.new(0, false, false, false, false)
  local service?, service_error? = test_service.load {
    project_root = root,
    installed_binary_modules_root = test_paths.sdk_binary_root(),
    analyzer = analyzer:analyze,
  }
  test.assert(service_error == nil and service ~= nil,
              "unmapped warning fixture project did not load")
  local app = application.create_with_service(root, service)
  defer app:close()
  local watched = app:watched_directories_for_testing()
  test.assert(contains_string(watched, test_paths.canonical_path(root)) and
              contains_string(watched, test_paths.canonical_path(source_root)) and
              not contains_string(watched, test_paths.canonical_path(unmapped_root)),
              "unmapped branch acquired a native directory watcher")
  app:stop_watching_for_testing()

  local publications: {string: diagnostics.Publication} = {}
  local publication_count = 0
  app:set_diagnostics_listener(function (publication: diagnostics.Publication)
    publications[publication.uri] = publication
    publication_count = publication_count + 1
  end)
  local loose_uri = source_text.path_to_file_uri(loose)
  local removed_uri = source_text.path_to_file_uri(removed)
  local created_uri = source_text.path_to_file_uri(created)
  test.assert(publication_count == 2 and
              #publications[loose_uri].items == 1 and
              #publications[removed_uri].items == 1,
              "initial saved discovery did not publish unmapped warnings")
  local saved = service:latest()
  local projects, snapshots = application.project_inputs(saved, {})
  test.assert(#saved.project_modules == 1 and #projects == 1 and
              #snapshots == 0 and projects[1].module_name == "main" and
              saved.project_modules[1].compiler_snapshot == nil,
              "unmapped sources reached compiler or semantic project inputs")
  local features = semantic_features.build(projects, snapshots)
  defer features:close()
  test.assert(features:hover(loose, source_text.Position.new(0, 0)) == nil and
              #features:folding_ranges(loose) == 0,
              "unmapped source acquired semantic navigation data")

  local before = app:indexing_metrics()
  local epoch = app:change_epoch_for_testing()
  local runs = analyzer.runs
  fs.write_file(loose, "changed but still unmapped\n")
  fs.unlink(removed)
  fs.write_file(created, "function answer(): integer return 2 end\n")
  app:watch_callback(project_watcher.RediscoveryBatch.new({
    project_watcher.PathChange.modified(loose),
    project_watcher.PathChange.deleted(removed),
    project_watcher.PathChange.created(created),
    project_watcher.PathChange.modified(unmapped_root),
    project_watcher.PathChange.created(root .. "/unmapped_branch"),
  }, {}, false))
  timer.yield()
  test.assert(app:change_epoch_for_testing() == epoch and
              app:indexing_metrics().refresh_passes == before.refresh_passes and
              not app:directory_probe_active_for_testing() and
              analyzer.runs == runs and publication_count == 2,
              "unmapped file or directory hints started refresh or publication")

  app:watch_callback(project_watcher.RediscoveryBatch.new({
    project_watcher.PathChange.modified(filename),
  }, {}, false))
  wait_until(function (): boolean
    local metrics = app:indexing_metrics()
    return metrics.refresh_passes >= before.refresh_passes + 1 and
           not metrics.refresh_chain_active
  end, "ordinary saved-file discovery did not finish")
  app:stop_watching_for_testing()
  test.assert(#publications[removed_uri].items == 0 and
              #publications[created_uri].items == 1 and
              #publications[loose_uri].items == 1 and
              analyzer.runs == runs and
              service:latest().generation == saved.generation,
              "ordinary discovery did not replace warnings without recompiling")

  local before_mapping = app:indexing_metrics().refresh_passes
  fs.write_file(config,
    "include = { '.' }\nsource_module_roots = { 'src', 'loose' }\n")
  app:watch_callback(project_watcher.RediscoveryBatch.new({
    project_watcher.PathChange.modified(config),
  }, {}, false))
  wait_until(function (): boolean
    local metrics = app:indexing_metrics()
    return metrics.refresh_passes >= before_mapping + 1 and
           not metrics.refresh_chain_active and
           #service:latest().project_modules == 2
  end, "source-root mapping refresh did not finish")
  test.assert(#publications[created_uri].items == 0 and
              #publications[loose_uri].items == 1 and
              #service:latest().project_modules == 2 and
              contains_string(app:watched_directories_for_testing(),
                              test_paths.canonical_path(unmapped_root)),
              "configured source root did not clear its warning and enter project scope")
  app:stop_watching_for_testing()

  local before_include = app:indexing_metrics().refresh_passes
  fs.write_file(config,
    "include = { 'src' }\nsource_module_roots = { 'src' }\n")
  app:watch_callback(project_watcher.RediscoveryBatch.new({
    project_watcher.PathChange.modified(config),
  }, {}, false))
  wait_until(function (): boolean
    local metrics = app:indexing_metrics()
    return metrics.refresh_passes >= before_include + 1 and
           not metrics.refresh_chain_active and
           #service:latest().discovery_issues == 0
  end, "include-scope replacement did not finish")
  test.assert(#publications[loose_uri].items == 0 and
              #service:latest().discovery_issues == 0,
              "include-scope replacement left stale unmapped warnings")
end

function test_application_refreshes_unmapped_warnings_only_during_ordinary_discovery(
    _context: test.Context)
  test_runtime.run(refreshes_unmapped_warnings_only_during_ordinary_discovery)
end

local function builds_semantics_from_independently_valid_modules()
  with_application(function (
      _filename: string, _analyzer: YieldingAnalyzer,
      app: application.Application)
    app:stop_watching_for_testing()
    local snapshot? = app:snapshot_for_testing()
    test.assert(snapshot ~= nil,
                "partial semantic-view fixture has no snapshot")
    local saved = snapshot as project_service.Snapshot
    test.assert(#saved.project_modules == 1,
                "partial semantic-view fixture has unexpected modules")
    local completed = saved.project_modules[1]
    test.assert(completed.compiler_snapshot == nil,
      "accepted publication retained the valid module's body snapshot")
    local fresh_files: {bridge.SourceFile} = {}
    for index = 1, #completed.source_files do
      local file = completed.source_files[index]
      fresh_files[index] = bridge.SourceFile.new(file.filename, file.contents)
    end
    local valid = project_service.ProjectModule.new(completed.module_name,
      completed.source_files,
      project_snapshot(bridge.ProjectModule.new(completed.module_name, fresh_files)),
      {}, project_service.ProjectAnalysisState.clean())
    local original_stamp = valid.source_files[1].stamp
    local failed_filename = saved.config.include[1] ..
                            "/failed.titan"
    local failed_source = project_service.SourceFileSnapshot.new(
      failed_filename, "function broken(:\n",
      project_graph.FileStamp.new(
        failed_filename, original_stamp.modified_seconds,
        original_stamp.modified_nanoseconds, 18))
    local failed = project_service.ProjectModule.new(
      "failed", {failed_source}, valid.compiler_snapshot, {},
      project_service.ProjectAnalysisState.failed())
    local partial = project_service.Snapshot.new(
      saved.generation, saved.config, saved.discovery_issues,
      saved.project_directories, {valid, failed}, saved.external_modules,
      {})

    local projects, snapshots = application.project_inputs(partial, {valid.module_name, "failed"})
    test.assert(#projects == 2 and projects[1].module_name ==
                  valid.module_name and projects[2].module_name == "failed" and
                #snapshots == 1 and snapshots[1].module_name ==
                  valid.module_name,
                "partial semantic inputs lost saved source or retained a " ..
                "failed module's stale compiler snapshot")
    local features = semantic_features.build(projects, snapshots)
    defer features:close()
    test.assert(#features:folding_ranges(valid.source_files[1].filename) == 1,
                "valid module lost its compiler-backed semantics")
    test.assert(#features:folding_ranges(failed_filename) == 0 and
                features:hover(
                  failed_filename, source_text.Position.new(0, 0)) == nil,
                "failed module exposed stale compiler semantics")

    -- A retained clean module needs no body. Replacing its SQL facts still
    -- requires the fresh checked snapshot for that exact revision.
    local malformed = project_service.ProjectModule.new(
      "malformed", valid.source_files, nil, {},
      project_service.ProjectAnalysisState.clean())
    local inconsistent = project_service.Snapshot.new(
      saved.generation, saved.config, saved.discovery_issues,
      saved.project_directories, {malformed}, saved.external_modules, {})
    local rejected = false
    local retained_projects, retained_snapshots = application.project_inputs(inconsistent, {})
    test.assert(#retained_projects == 1 and #retained_snapshots == 0,
      "retained clean SQL facts required a body snapshot")
    do
      application.project_inputs(inconsistent, {"malformed"})
    catch
      rejected = error is application.Error
    end
    test.assert(rejected,
                "clean module without a compiler snapshot was accepted")
  end)
end

local function failed_revision_waits_for_a_saved_change_and_recovers()
  local root = test_paths.temporary_name()
  fs.unlink(root)
  fs.mkdir(root)
  local source_root = root .. "/src"
  fs.mkdir(source_root)
  local filename = source_root .. "/main.titan"
  fs.write_file(filename,
    "function answer(): integer\n" ..
    "  return 1\n" ..
    "end\n")
  defer do
    if fs.lstat(filename) ~= nil then fs.unlink(filename) end
    if fs.lstat(source_root) ~= nil then fs.rmdir(source_root) end
    if fs.lstat(root) ~= nil then fs.rmdir(root) end
  end

  local analyzer = RecoveringAnalyzer.new(true, 0)
  local service?, service_error? = test_service.load {
    project_root = root,
    installed_binary_modules_root = test_paths.sdk_binary_root(),
    analyzer = analyzer:analyze,
  }
  test.assert(service_error == nil and service ~= nil,
              "partial recovery fixture project did not load")
  if service == nil then raise "partial recovery Service is missing" end
  local app = application.create_with_service(root, service)
  defer app:close()
  app:stop_watching_for_testing()
  local diagnostic_publications: {diagnostics.Publication} = {}
  local throw_from_diagnostics_listener = false
  app:set_diagnostics_listener(function (
      publication: diagnostics.Publication)
    diagnostic_publications[#diagnostic_publications + 1] = publication
    if throw_from_diagnostics_listener then
      raise "deliberate diagnostics listener failure"
    end
  end)

  local initial? = app:snapshot_for_testing()
  test.assert(initial ~= nil and #initial.dirty_modules == 0 and
              #initial.project_modules == 1 and
              project_is_failed(initial.project_modules[1]) and
              initial.project_modules[1].compiler_snapshot == nil,
              "diagnostic module did not become a current failed revision")
  test.assert(#diagnostic_publications == 1 and
              diagnostic_publications[1].uri ~= "" and
              #diagnostic_publications[1].items == 1 and
              diagnostic_publications[1].items[1].message ==
                "deliberate saved-source error",
              "current failed revision was not published to the LSP client")
  local before = app:indexing_metrics()
  local runs_before = analyzer.runs
  test.assert(
    result_array_length(
      app:handle(request_for(
        filename, 40, "textDocument/foldingRange")),
      "folding request on partial View") == 0,
    "partial View exposed a failed module's structural AST")
  wait_until(function (): boolean
    return not app:indexing_metrics().refresh_chain_active
  end, "failed-revision external revalidation did not finish")
  test.assert(analyzer.runs == runs_before,
              "semantic request recompiled an unchanged failed revision")

  test.assert(
    result_array_length(
      app:handle(request_for(
        filename, 41, "textDocument/foldingRange")),
      "second folding request on partial View") == 0,
    "second request exposed a failed module's structural AST")
  wait_until(function (): boolean
    return not app:indexing_metrics().refresh_chain_active
  end, "second failed-revision external revalidation did not finish")
  test.assert(analyzer.runs == runs_before and
              app:indexing_metrics().view_builds == before.view_builds,
              "unchanged failed revision reran analysis or rebuilt Features")

  analyzer.fail = false
  fs.write_file(filename,
    "function answer(): integer\n" ..
    "  return 1\n" ..
    "end\n" ..
    "-- repaired saved revision\n")
  -- The watcher is deliberately stopped above so the saved-input transition
  -- is deterministic in this Application regression.
  throw_from_diagnostics_listener = true
  app:note_saved_change()
  wait_until(function (): boolean
    return analyzer.runs == runs_before + 1 and
           not app:indexing_metrics().refresh_chain_active
  end, "saved source change did not recover the failed revision")

  local repaired? = app:snapshot_for_testing()
  local after = app:indexing_metrics()
  test.assert(repaired ~= nil and #repaired.dirty_modules == 0 and
              #repaired.project_modules == 1 and
              project_is_clean(repaired.project_modules[1]) and
              after.view_builds == before.view_builds + 1,
              "saved-source repair did not publish a rebuilt semantic View")
  test.assert(#diagnostic_publications == 2 and
              diagnostic_publications[2].uri ==
                diagnostic_publications[1].uri and
              #diagnostic_publications[2].items == 0,
              "saved-source repair did not clear its stale diagnostic")
  test.assert(
    result_array_length(
      app:handle(request_for(
        filename, 42, "textDocument/foldingRange")),
      "folding request after partial repair") == 1,
    "repaired module did not enter the semantic View")
end

local function rebuilds_view_when_external_recheck_fails_clean_module()
  local root = test_paths.temporary_name()
  fs.unlink(root)
  fs.mkdir(root)
  local source_root = root .. "/src"
  fs.mkdir(source_root)
  local consumer_filename = source_root .. "/consumer.titan"
  local unrelated_filename = source_root .. "/unrelated.titan"
  local first_provider = root .. "/provider-one.so"
  local second_provider = root .. "/provider-two.so"
  fs.write_file(consumer_filename,
    "function answer(): integer\n" ..
    "  return 1\n" ..
    "end\n")
  fs.write_file(unrelated_filename,
    "function answer(): integer\n" ..
    "  return 1\n" ..
    "end\n")
  fs.write_file(first_provider, "first external provider")
  fs.write_file(second_provider, "second external provider")
  defer do
    if fs.lstat(second_provider) ~= nil then fs.unlink(second_provider) end
    if fs.lstat(first_provider) ~= nil then fs.unlink(first_provider) end
    if fs.lstat(unrelated_filename) ~= nil then
      fs.unlink(unrelated_filename)
    end
    if fs.lstat(consumer_filename) ~= nil then fs.unlink(consumer_filename) end
    if fs.lstat(source_root) ~= nil then fs.rmdir(source_root) end
    if fs.lstat(root) ~= nil then fs.rmdir(root) end
  end

  local provider_file = first_provider
  local fail_consumer = false
  local runs = 0
  local checked_modules: {string} = {}
  local analyzer: project_service.Analyzer =
    function (request: project_service.AnalysisRequest): bridge.Analysis
      runs = runs + 1
      local modules: {bridge.ModuleSnapshot} = {}
      local diagnostics: {bridge.Diagnostic} = {}
      local binary_observations: {bridge.BinaryProviderObservation} = {}
      local checked_consumer = false
      for index = 1, #request.dirty_modules do
        local name = request.dirty_modules[index]
        checked_modules[#checked_modules + 1] = name
        local module? = find_project(request, name)
        test.assert(module ~= nil,
                    "provider-failure analyzer lost a dirty module")
        if module == nil then raise "dirty provider consumer is missing" end

        local imports: {bridge.Import} = {}
        if name == "consumer" then
          checked_consumer = true
          imports[1] = bridge.Import.new(
            "vendor", "vendor.binary", false,
            bridge.SourceLocation.new(module.files[1].filename, 1, 1))
        end
        if name == "consumer" and fail_consumer then
          modules[#modules + 1] = bridge.ModuleSnapshot.new(
            name,
            bridge.Provenance.project_source(
                module.files[1].filename, {module.files[1].filename}),
            nil, {}, {}, imports, {}, nil, nil)
          diagnostics[#diagnostics + 1] = bridge.Diagnostic.new(
            bridge.DiagnosticKind.type_error(),
            "replacement provider is incompatible",
            bridge.SourceLocation.new(module.files[1].filename, 1, 1))
        else
          local snapshot = project_snapshot(module)
          modules[#modules + 1] = bridge.ModuleSnapshot.new(
            snapshot.module_name, snapshot.provenance, snapshot.manifest,
            snapshot.nodes, snapshot.symbols, imports,
            snapshot.c_header_dependencies, snapshot.hover_summaries,
            snapshot.provider_identity)
        end
      end
      if checked_consumer then
        local provider_identity? = observed_provider_identity(provider_file)
        modules[#modules + 1] = bridge.ModuleSnapshot.new(
          "vendor.binary",
          bridge.Provenance.dynamic_binary(
            provider_file),
          bridge.Manifest.new("vendor.binary", "vendor-public", nil),
          {}, {}, {}, {}, nil, provider_identity)
        binary_observations[1] = bridge.BinaryProviderObservation.new(
          "vendor.binary", "dynamic", provider_file, provider_identity)
      end
      return bridge.Analysis.new(
        request.root_module, diagnostics, modules, {},
        binary_observations, {})
    end
  local resolver: project_service.ExternalResolver =
    function (_config, _projects, requests):
        {bridge.ExternalResolution}
      local resolutions: {bridge.ExternalResolution} = {}
      for index = 1, #requests do
        resolutions[index] = bridge.ExternalResolution.new(
          requests[index].module_name,
          bridge.Provenance.dynamic_binary(
            provider_file), nil)
      end
      return resolutions
    end

  local service?, service_error? =
    test_service.load {
      project_root = root,
      installed_binary_modules_root = test_paths.sdk_binary_root(),
      analyzer = analyzer,
      external_resolver = resolver,
    }
  test.assert(service_error == nil and service ~= nil,
              "provider-failure Application fixture did not load")
  if service == nil then raise "provider-failure Service is missing" end
  local app = application.create_with_service(root, service)
  defer app:close()
  app:stop_watching_for_testing()

  local initial? = app:snapshot_for_testing()
  test.assert(initial ~= nil,
              "provider-failure fixture has no initial snapshot")
  if initial == nil then raise "provider-failure snapshot is missing" end
  local initial_consumer? = snapshot_project(initial, "consumer")
  local initial_unrelated? = snapshot_project(initial, "unrelated")
  test.assert(initial_consumer ~= nil and
              project_is_clean(initial_consumer) and
              initial_unrelated ~= nil and
              project_is_clean(initial_unrelated) and
              #initial.dirty_modules == 0,
              "provider-failure fixture did not start fully clean")
  test.assert(
    result_array_length(
      app:handle(request_for(
        consumer_filename, 43, "textDocument/foldingRange")),
      "initial provider consumer folding request") == 1 and
    result_array_length(
      app:handle(request_for(
        unrelated_filename, 44, "textDocument/foldingRange")),
      "initial unrelated folding request") == 1,
    "initial semantic View did not contain both clean modules")
  wait_until(function (): boolean
    return not app:indexing_metrics().refresh_chain_active
  end, "initial provider revalidation did not finish")

  local initial_generation = initial.generation
  local runs_before = runs
  local checked_before = #checked_modules
  local metrics_before = app:indexing_metrics()
  provider_file = second_provider
  fail_consumer = true

  -- Unchanged read requests do not probe unwatched providers. The next saved
  -- project refresh revalidates the provider topology, while reads remain
  -- responsive through the preceding immutable View.
  app:note_saved_change()
  test.assert(
    result_array_length(
      app:handle(request_for(
        consumer_filename, 45, "textDocument/foldingRange")),
      "folding request during provider revalidation") == 1,
    "provider revalidation did not serve the preceding semantic View")
  wait_until(function (): boolean
    return runs == runs_before + 1 and
           not app:indexing_metrics().refresh_chain_active
  end, "replacement provider did not finish its dependent recheck")

  local failed? = app:snapshot_for_testing()
  test.assert(failed ~= nil,
              "provider failure did not publish a project snapshot")
  if failed == nil then raise "provider failure snapshot is missing" end
  local failed_consumer? = snapshot_project(failed, "consumer")
  local clean_unrelated? = snapshot_project(failed, "unrelated")
  local failed_metrics = app:indexing_metrics()
  test.assert(failed.generation == initial_generation and
              #failed.dirty_modules == 0 and
              failed_consumer ~= nil and
              project_is_failed(failed_consumer) and
              clean_unrelated ~= nil and
              project_is_clean(clean_unrelated),
              "same-generation provider failure did not isolate its consumer")
  test.assert(#checked_modules == checked_before + 1 and
              checked_modules[#checked_modules] == "consumer",
              "provider replacement rechecked an unrelated clean module")
  test.assert(failed_metrics.view_builds == metrics_before.view_builds + 1,
              "same-generation failed result reused the preceding View")

  local runs_after_failure = runs
  test.assert(
    result_array_length(
      app:handle(request_for(
        consumer_filename, 46, "textDocument/foldingRange")),
      "failed provider consumer folding request") == 0,
    "rebuilt View retained the failed consumer's preceding AST")
  test.assert(
    result_array_length(
      app:handle(request_for(
        unrelated_filename, 47, "textDocument/foldingRange")),
      "clean unrelated folding request after provider failure") == 1,
    "rebuilt View dropped the unrelated clean module")
  wait_until(function (): boolean
    return not app:indexing_metrics().refresh_chain_active
  end, "unchanged failed-provider revalidation did not finish")
  test.assert(runs == runs_after_failure and
              app:indexing_metrics().view_builds == failed_metrics.view_builds,
              "unchanged semantic requests retried the failed revision")
end

local function ignores_extensionless_temporary_during_active_refresh()
  with_application(function (
      filename: string, analyzer: YieldingAnalyzer,
      app: application.Application)
    use_manual_watch_delivery(app)
    local snapshot? = app:snapshot_for_testing()
    test.assert(snapshot ~= nil,
                "active temporary-file fixture has no snapshot")
    local saved = snapshot as project_service.Snapshot
    local temporary = saved.config.include[1] .. "/XXcompiler"
    fs.write_file(temporary, "temporary reservation")
    defer do
      analyzer.block = false
      if fs.lstat(temporary) ~= nil then fs.unlink(temporary) end
    end

    local metrics_before = app:indexing_metrics()
    local epoch_before = app:change_epoch_for_testing()
    local runs_before = analyzer.runs
    fs.write_file(
      filename, "function answer(): integer return 123456 end\n")
    analyzer.block = true
    analyzer.started = false
    app:note_saved_change()
    wait_until(function (): boolean return analyzer.started end,
               "active temporary-file fixture analyzer did not start")

    app:watch_callback(project_watcher.RediscoveryBatch.new({
      project_watcher.PathChange.created(temporary),
    }, {}, false))
    wait_until(function (): boolean
      return not app:directory_probe_active_for_testing()
    end, "active extensionless regular-file probe did not finish")
    test.assert(
      app:change_epoch_for_testing() == epoch_before + 1 and
      app:indexing_metrics().refresh_passes ==
        metrics_before.refresh_passes + 1,
      "compiler-style temporary queued a follow-up refresh")

    analyzer.block = false
    wait_until(function (): boolean
      return not app:indexing_metrics().refresh_chain_active
    end, "active temporary-file fixture did not finish")
    test.assert(
      analyzer.runs == runs_before + 1 and
      app:indexing_metrics().refresh_passes ==
        metrics_before.refresh_passes + 1,
      "compiler-style temporary caused repeated analysis")
  end)
end

local function classifies_canonical_symlink_watcher_paths()
  local workspace = test_paths.temporary_name()
  fs.unlink(workspace)
  fs.mkdir(workspace)
  local actual_root = workspace .. "/actual"
  local source_root = actual_root .. "/src"
  local package_directory = source_root .. "/package"
  local linked_root = workspace .. "/linked"
  local filename = source_root .. "/main.titan"
  local config_file = actual_root .. "/titan-config.lua"
  fs.mkdir(actual_root)
  fs.mkdir(source_root)
  fs.mkdir(package_directory)
  fs.write_file(filename, "function answer(): integer return 1 end\n")
  fs.write_file(config_file,
    "include = { './src' }\n" ..
    "source_module_roots = { './src', " ..
    "'./src/vendor.foo/future' }\n")
  defer do
    if fs.lstat(linked_root) ~= nil then fs.unlink(linked_root) end
    if fs.lstat(filename) ~= nil then fs.unlink(filename) end
    if fs.lstat(config_file) ~= nil then fs.unlink(config_file) end
    if fs.lstat(package_directory) ~= nil then fs.rmdir(package_directory) end
    if fs.lstat(source_root) ~= nil then fs.rmdir(source_root) end
    if fs.lstat(actual_root) ~= nil then fs.rmdir(actual_root) end
    if fs.lstat(workspace) ~= nil then fs.rmdir(workspace) end
  end
  test_links.directory(actual_root, linked_root,
    "could not create project-root symlink fixture")

  local analyzer = YieldingAnalyzer.new(0, false, false, false, false)
  local service?, service_error? = test_service.load {
    project_root = linked_root,
    installed_binary_modules_root = test_paths.sdk_binary_root(),
    analyzer = analyzer:analyze,
  }
  test.assert(service_error == nil and service ~= nil,
              "symlinked project fixture did not load")
  if service == nil then raise "symlinked project Service is missing" end
  local app = application.create_with_service(linked_root, service)
  defer app:close()
  local snapshot? = app:snapshot_for_testing()
  test.assert(snapshot ~= nil, "symlinked project fixture has no snapshot")
  local saved = snapshot as project_service.Snapshot

  local canonical_cache = test_paths.canonical_path(linked_root) .. "/.titan-ls"
  test.assert(not application.relevant_watch_change(saved,
    project_watcher.PathChange.modified(canonical_cache)) and
    not application.relevant_watch_change(saved,
      project_watcher.PathChange.modified(canonical_cache .. "/generated.titan")),
    "canonical workspace cache alias triggered saved-project indexing")

  local canonical_source = test_paths.canonical_path(linked_root .. "/src")
  local canonical_file = canonical_source .. "/main.titan"
  local canonical_package = canonical_source .. "/package"
  local canonical_future = canonical_source .. "/vendor.foo/future"
  local canonical_config = test_paths.canonical_path(linked_root) .. "/titan-config.lua"
  test.assert(canonical_source ~= saved.config.include[1],
              "symlink fixture did not retain its lexical configured root")
  test.assert(application.relevant_watch_change(
                saved, project_watcher.PathChange.modified(canonical_file)) and
              application.relevant_watch_change(
                saved,
                project_watcher.PathChange.modified(canonical_source)) and
              application.relevant_watch_change(
                saved, project_watcher.PathChange.modified(canonical_config)),
              "canonical watcher path did not map to symlinked project root")
  test.assert(application.relevant_watch_change(
                saved, project_watcher.PathChange.modified(
                  canonical_future .. "/created.titan")),
              "missing nested source root lost its canonical watcher path")

  app:stop_watching_for_testing()
  fs.rmdir(package_directory)
  test.assert(application.relevant_watch_change(
                saved, project_watcher.PathChange.deleted(canonical_package)),
              "deleted canonical source directory was filtered out")
end

function test_application_classifies_canonical_symlink_watcher_paths(
    _context: test.Context)
  test_runtime.run(classifies_canonical_symlink_watcher_paths)
end

local function watches_canonical_targets_of_lexically_mapped_include_symlinks()
  local base = test_paths.temporary_name()
  fs.unlink(base)
  fs.mkdir(base)
  local project = base .. "/workspace"
  local actual = base .. "/actual"
  local linked = project .. "/link"
  local filename = actual .. "/main.titan"
  local nested = actual .. "/new_branch"
  local config = project .. "/titan-config.lua"
  defer do
    if fs.lstat(linked) ~= nil then fs.unlink(linked) end
    if fs.lstat(nested) ~= nil then fs.rmdir(nested) end
    if fs.lstat(filename) ~= nil then fs.unlink(filename) end
    if fs.lstat(config) ~= nil then fs.unlink(config) end
    if fs.lstat(actual) ~= nil then fs.rmdir(actual) end
    if fs.lstat(project) ~= nil then fs.rmdir(project) end
    if fs.lstat(base) ~= nil then fs.rmdir(base) end
  end
  fs.mkdir(project)
  fs.mkdir(actual)
  fs.write_file(filename, "function answer(): integer return 1 end\n")
  fs.write_file(config,
    "include = { 'link' }\nsource_module_roots = { '.' }\n")
  test_links.directory(actual, linked,
    "could not create lexical source-ancestry symlink fixture")

  local analyzer = YieldingAnalyzer.new(0, false, false, false, false)
  local service?, service_error? = test_service.load {
    project_root = project,
    installed_binary_modules_root = test_paths.sdk_binary_root(),
    analyzer = analyzer:analyze,
  }
  test.assert(service_error == nil and service ~= nil,
              "lexically mapped symlink fixture project did not load")
  local app = application.create_with_service(project, service)
  defer app:close()
  app:stop_watching_for_testing()
  local saved = service:latest()
  test.assert(#saved.project_modules == 1 and
              saved.project_modules[1].module_name == "link.main" and
              #saved.discovery_issues == 0,
              "symlink target outside physical source root lost its lexical owner")
  local canonical_file = test_paths.canonical_path(filename)
  local canonical_nested = test_paths.canonical_path(actual) .. "/new_branch"
  test.assert(application.relevant_watch_change(
                saved, project_watcher.PathChange.modified(canonical_file)) and
              application.relevant_watch_change(
                saved, project_watcher.PathChange.created(canonical_nested)),
              "canonical watcher paths lost lexical source-root coverage")
  test.assert(not application.relevant_watch_change(
                saved, project_watcher.PathChange.modified(
                  base .. "/outside.titan")),
              "include symlink expanded watcher coverage outside its target")

  local before = app:indexing_metrics().refresh_passes
  app:watch_callback(project_watcher.RediscoveryBatch.new({
    project_watcher.PathChange.modified(canonical_file),
  }, {}, false))
  wait_until(function (): boolean
    local metrics = app:indexing_metrics()
    return metrics.refresh_passes >= before + 1 and
           not metrics.refresh_chain_active
  end, "canonical source modification did not refresh its lexical project")
  app:stop_watching_for_testing()
  local before_directory = app:indexing_metrics().refresh_passes
  fs.mkdir(nested)
  app:watch_callback(project_watcher.RediscoveryBatch.new({
    project_watcher.PathChange.created(canonical_nested),
  }, {}, false))
  wait_until(function (): boolean
    local metrics = app:indexing_metrics()
    return metrics.refresh_passes >= before_directory + 1 and
           not app:directory_probe_active_for_testing() and
           not metrics.refresh_chain_active
  end, "canonical directory creation did not refresh its lexical project")
  test.assert(contains_string(app:watched_directories_for_testing(),
                              canonical_nested),
              "canonical newly discovered directory did not acquire a watcher")
end

function test_application_watches_canonical_targets_of_lexically_mapped_include_symlinks(
    _context: test.Context)
  test_runtime.run(watches_canonical_targets_of_lexically_mapped_include_symlinks)
end

local function probes_source_ancestors_with_titan_suffix()
  with_application(function (_filename: string, analyzer: YieldingAnalyzer,
                             app: application.Application)
    app:stop_watching_for_testing()
    local initial = app:snapshot_for_testing()
    local root = initial.config.project_root
    local config = root .. "/titan-config.lua"
    local ancestor = root .. "/vendor.titan"
    defer do
      app:stop_watching_for_testing()
      local metadata? = fs.lstat(ancestor)
      if metadata ~= nil then
        if metadata.kind == "directory" then fs.rmdir(ancestor)
        else fs.unlink(ancestor) end
      end
      if fs.lstat(config) ~= nil then fs.unlink(config) end
    end
    fs.write_file(config,
      "include = { '.' }\n" ..
      "source_module_roots = { 'src', 'vendor.titan/src' }\n")
    local before = app:indexing_metrics().refresh_passes
    app:note_saved_change()
    wait_until(function (): boolean
      local metrics = app:indexing_metrics()
      local snapshot? = app:snapshot_for_testing()
      return metrics.refresh_passes >= before + 1 and
             not metrics.refresh_chain_active and snapshot ~= nil and
             #snapshot.config.source_module_roots == 2 and
             snapshot.config.source_module_roots[2] == ancestor .. "/src"
    end, "future source-root configuration did not refresh")
    app:stop_watching_for_testing()
    -- Native backends may deliver the configuration save after reconciliation.
    -- The settled baseline still proves that the regular-file hint does no work.
    local configured_passes = app:indexing_metrics().refresh_passes
    local epoch = app:change_epoch_for_testing()
    local runs = analyzer.runs

    fs.write_file(ancestor, "an unmapped regular source file\n")
    app:watch_callback(project_watcher.RediscoveryBatch.new({
      project_watcher.PathChange.created(ancestor),
    }, {}, false))
    wait_until(function (): boolean
      return not app:directory_probe_active_for_testing()
    end, "source-shaped ancestor kind probe did not finish")
    test.assert(app:change_epoch_for_testing() == epoch and
                app:indexing_metrics().refresh_passes == configured_passes and
                analyzer.runs == runs,
                "unmapped regular file at a source-root ancestor triggered refresh")

    fs.unlink(ancestor)
    fs.mkdir(ancestor)
    app:watch_callback(project_watcher.RediscoveryBatch.new({
      project_watcher.PathChange.created(ancestor),
    }, {}, false))
    wait_until(function (): boolean
      local metrics = app:indexing_metrics()
      return metrics.refresh_passes >= configured_passes + 1 and
             not app:directory_probe_active_for_testing() and
             not metrics.refresh_chain_active
    end, "directory with Titan suffix did not reveal the future source-root path")
    test.assert(contains_string(app:watched_directories_for_testing(),
                                test_paths.canonical_path(ancestor)),
                "source-root ancestor with Titan suffix did not acquire a watcher")
  end)
end

function test_application_probes_source_ancestors_with_titan_suffix(
    _context: test.Context)
  test_runtime.run(probes_source_ancestors_with_titan_suffix)
end

local function reuses_view_without_unchanged_refresh()
  with_application(function (filename: string, _analyzer: YieldingAnalyzer,
                             app: application.Application)
    local statuses: {indexing_status.Status} = {}
    app:set_indexing_listener(function (status: indexing_status.Status)
      statuses[#statuses + 1] = status
    end)
    local before = app:indexing_metrics()
    test.assert(
      result_array_length(
        app:handle(request_for(
          filename, 32, "textDocument/foldingRange")),
        "read-only request against completed generation") == 1,
      "completed generation did not serve the read-only request")
    local after = app:indexing_metrics()
    test.assert(after.refresh_passes == before.refresh_passes and
                after.view_builds == before.view_builds and #statuses == 0,
                "unchanged semantic request started a project refresh")
  end)
end

function test_application_reuses_view_without_unchanged_refresh(
    _context: test.Context)
  test_runtime.run(reuses_view_without_unchanged_refresh)
end

local function remains_responsive_during_yielding_recheck()
  with_application(function (filename: string, analyzer: YieldingAnalyzer,
                             app: application.Application)
    app:stop_watching_for_testing()
    local statuses: {indexing_status.Status} = {}
    app:set_indexing_listener(function (status: indexing_status.Status)
      statuses[#statuses + 1] = status
    end)
    fs.write_file(
      filename, "function answer(): integer return 123456 end\n")
    analyzer.block = true
    analyzer.started = false
    analyzer.finished = false
    local runs_before = analyzer.runs

    app:note_saved_change()
    -- A read-only request does not wait for the watcher-triggered analysis and
    -- uses the preceding immutable generation while the new one is pending.
    local first = app:handle(request_for(
      filename, 1, "textDocument/foldingRange"))
    test.assert(
      result_array_length(first, "request during project recheck") == 1,
      "request during recheck did not use the completed View")
    wait_until(function (): boolean return analyzer.started end,
               "background project recheck did not start")

    local responsive = app:handle(request_for(
      filename, 2, "textDocument/foldingRange"))
    test.assert(
      result_array_length(
        responsive, "read-only request during project recheck") == 1,
      "responsive request did not use the completed View")
    test.assert(not analyzer.finished,
                "responsive request waited for the yielding recheck")

    -- Rename must not use the fallback because its edits target saved bytes.
    local rename = async.run<|dispatcher.SemanticOutcome, value|>(function ():
        dispatcher.SemanticOutcome
      return app:handle(request_for(
        filename, 3, "textDocument/rename"))
    end)
    timer.yield()
    test.assert(not rename:status():has_finished(),
                "rename used the completed-generation fallback")

    -- A second save and its watcher hint while analysis is suspended supersede
    -- this candidate. ProjectService must discard the in-flight snapshot and
    -- recheck the newest bytes before Application can publish it.
    fs.write_file(
      filename, "function answer(): integer return 789 end\n")
    app:note_saved_change()
    -- Superseding the in-flight candidate advances the pending saved epoch,
    -- but read-only requests still use the last completed immutable View until
    -- the coalesced follow-up publishes the newest generation.
    test.assert(
      result_array_length(
        app:handle(request_for(
          filename, 9, "textDocument/foldingRange")),
        "read-only request during watcher-dirty generation") == 1,
      "watcher-dirty generation lost the preceding completed View")
    analyzer.block = false
    wait_until(function (): boolean return #statuses == 3 end,
               "superseded refresh chain did not reach ready")
    test.assert(analyzer.finished,
                "yielding compiler recheck did not finish")
    test.assert(analyzer.runs >= runs_before + 2,
                "watcher-superseded refresh did not run another pass")
    assert_failure(join_outcome(rename, "fresh rename"),
                   "rename without a symbol")
    test.assert(
      result_array_length(
        app:handle(request_for(
          filename, 8, "textDocument/foldingRange")),
        "request after superseded refresh") == 0,
      "completed View did not advance to the newest saved generation")
  end)
end

function test_application_remains_responsive_during_yielding_recheck(
    _context: test.Context)
  test_runtime.run(remains_responsive_during_yielding_recheck)
end

local function preserves_shared_refresh_after_owner_cancellation()
  with_application(function (filename: string, analyzer: YieldingAnalyzer,
                             app: application.Application)
    -- This case exercises request cancellation, not kernel watcher delivery.
    -- Arm the blocking analyzer before publishing the saved-change hint:
    -- fs.write_file yields, so an active watcher could otherwise consume and
    -- commit this revision while block is still false. The later forced rename
    -- scan would then have no dirty work and never call the analyzer.
    app:stop_watching_for_testing()
    fs.write_file(
      filename, "function answer(): integer return 123456 end\n")
    analyzer.block = true
    analyzer.started = false
    analyzer.finished = false
    local runs_before = analyzer.runs
    app:note_saved_change()

    -- A fresh rename request joins the independently rooted refresh. Cancelling
    -- that request must detach its join without cancelling shared indexing.
    local owner = async.run<|dispatcher.SemanticOutcome, value|>(function ():
        dispatcher.SemanticOutcome
      return app:handle(request_for(
        filename, 5, "textDocument/rename"))
    end)
    wait_until(function (): boolean return analyzer.started end,
               "refresh owner did not start its shared recheck")
    test.assert(analyzer.runs == runs_before + 1,
                "refresh owner did not start exactly one shared recheck")

    owner:cancel(async.CancellationReason.simple(
      "cancel refresh-owning request in application test"))
    local owner_cancelled = false
    case async.join(owner)
    when cancelled() then owner_cancelled = true
    when succeeded() then
    when failed() then
    else
    end
    test.assert(owner_cancelled,
                "refresh-owning request did not finish as cancelled")

    analyzer.block = false

    -- Rename cannot use a completed-view fallback, so this request joins the
    -- surviving shared refresh. If cancellation leaked to that refresh, this
    -- call would need a replacement analyzer run and the original analyzer
    -- would never reach its successful release point.
    assert_failure(app:handle(request_for(
      filename, 6, "textDocument/rename")),
      "fresh request after refresh-owner cancellation")
    test.assert(analyzer.finished,
                "shared refresh did not survive owner cancellation")
    test.assert(analyzer.runs == runs_before + 1,
                "owner cancellation caused a replacement compiler recheck")

    test.assert(
      result_array_length(
        app:handle(request_for(
          filename, 7, "textDocument/foldingRange")),
        "later request after refresh-owner cancellation") == 0,
      "later request did not observe the published completed generation")
  end)
end

function test_application_preserves_shared_refresh_after_owner_cancellation(
    _context: test.Context)
  test_runtime.run(preserves_shared_refresh_after_owner_cancellation)
end

local function serves_completed_view_during_saved_failure_repair()
  with_application(function (filename: string, analyzer: YieldingAnalyzer,
                             app: application.Application)
    app:stop_watching_for_testing()
    fs.write_file(filename, "deliberately failed saved source\n")
    analyzer.fail = true
    assert_failure(app:handle(request_for(
      filename, 8, "textDocument/rename")),
      "fresh request which established the failed saved epoch")

    analyzer.fail = false
    analyzer.block = true
    analyzer.started = false
    analyzer.finished = false
    fs.write_file(filename,
      "function answer(): integer\n" ..
      "  return 2\n" ..
      "end\n" ..
      "-- repaired saved revision\n")
    app:note_saved_change()
    wait_until(function (): boolean return analyzer.started end,
               "saved repair analysis did not start")

    test.assert(
      result_array_length(
        app:handle(request_for(
          filename, 9, "textDocument/foldingRange")),
        "read-only request during saved repair") == 1,
      "active saved repair exposed the preceding epoch's stale failure")
    test.assert(app:indexing_metrics().refresh_chain_active,
                "read-only fallback terminated the blocked saved repair")

    analyzer.block = false
    wait_until(function (): boolean
      return analyzer.finished and
             not app:indexing_metrics().refresh_chain_active
    end, "saved repair did not replace the failed epoch")
    test.assert(
      result_array_length(
        app:handle(request_for(
          filename, 10, "textDocument/foldingRange")),
        "read-only request after saved repair") == 0,
      "repaired generation did not replace the completed View")
  end)
end

local function rejects_fallback_after_refresh_failure()
  with_application(function (filename: string, analyzer: YieldingAnalyzer,
                             app: application.Application)
    use_manual_watch_delivery(app)
    local statuses: {indexing_status.Status} = {}
    app:set_indexing_listener(function (status: indexing_status.Status)
      statuses[#statuses + 1] = status
    end)
    fs.write_file(filename, "deliberately changed saved source\n")
    analyzer.fail = true
    assert_failure(app:handle(request_for(
      filename, 10, "textDocument/rename")),
      "fresh request which discovered refresh failure")
    test.assert(#statuses == 2 and
                indexing_status.state_name(statuses[1].state) == "indexing" and
                indexing_status.state_name(statuses[2].state) == "failed" and
                statuses[2].message ~= nil,
                "terminal refresh failure did not emit bounded status")

    -- An unchanged read-only request neither clears the known failure nor
    -- retries the same failed saved revision. A strict rename may explicitly
    -- retry because it must prove the newest disk generation before editing.
    assert_failure(app:handle(request_for(
      filename, 11, "textDocument/foldingRange")),
      "read-only request after known refresh failure")
    test.assert(#statuses == 2,
                "unchanged read-only request retried a failed revision")
    assert_failure(app:handle(request_for(
      filename, 13, "textDocument/rename")),
      "strict request retrying known refresh failure")
    test.assert(#statuses == 4 and
                indexing_status.state_name(statuses[3].state) == "indexing" and
                indexing_status.state_name(statuses[4].state) == "failed",
                "explicit retry did not report a second terminal failure")

    analyzer.fail = false
    -- The saved source has no symbol at the rename position, so feature-level
    -- failure is expected after the project refresh itself recovers.
    assert_failure(app:handle(request_for(
      filename, 12, "textDocument/rename")),
      "fresh request after refresh recovery")
    test.assert(#statuses == 6 and
                indexing_status.state_name(statuses[5].state) == "indexing" and
                indexing_status.state_name(statuses[6].state) == "ready",
                "successful retry did not replace the failed state with ready")
  end)
end

function test_application_fresh_requests_retry_after_refresh_failure(
    _context: test.Context)
  test_runtime.run(rejects_fallback_after_refresh_failure)
end

local function emits_no_indexing_status_after_close()
  with_unindexed_application(function (
      _filename: string, _analyzer: YieldingAnalyzer,
      app: application.Application)
    local statuses: {indexing_status.Status} = {}
    app:set_indexing_listener(function (status: indexing_status.Status)
      statuses[#statuses + 1] = status
    end)
    app:start_indexing()
    test.assert(#statuses == 1 and
                indexing_status.state_name(statuses[1].state) == "indexing",
                "closing fixture did not begin an indexing chain")
    test.assert(app:indexing_metrics().refresh_chain_active,
                "closing fixture did not retain its active chain")
    app:close()
    app:start_indexing()
    app:note_saved_change()
    timer.yield()
    test.assert(#statuses == 1,
                "application emitted indexing status after close")
    test.assert(not app:indexing_metrics().refresh_chain_active,
                "application close left an unterminated indexing chain")
  end)
end

local function continues_indexing_after_status_encoding_failure()
  with_unindexed_application(function (
      filename: string, _analyzer: YieldingAnalyzer,
      app: application.Application)
    -- A watcher hint that arrives mid-pass would add a second pass and make the
    -- status/view counts below platform-dependent.
    use_manual_watch_delivery(app)
    local observed = 0
    app:set_indexing_listener(function (status: indexing_status.Status)
      observed = observed + 1
      indexing_status.notification(indexing_status.Status.new(
        status.state, status.initial, status.epoch, status.generation,
        strings.char(0xff), status.completed_files, status.total_files))
    end)
    app:start_indexing()
    wait_until(function (): boolean
      return not app:indexing_metrics().refresh_chain_active
    end, "status encoding failure interrupted the initial indexing chain")
    test.assert(observed >= 2 and
                app:indexing_metrics().view_builds == 1,
                "status encoding failure prevented the completed semantic View")
    test.assert(result_array_length(
      app:handle(request_for(filename, 51, "textDocument/foldingRange")),
      "folding after status encoding failure") == 1,
      "status encoding failure discarded the completed saved generation")
    wait_until(function (): boolean
      return not app:indexing_metrics().refresh_chain_active
    end, "revalidation after status encoding failure did not finish")

    app:set_indexing_listener(function (_status: indexing_status.Status)
      raise "unexpected status listener failure"
    end)
    local propagated = false
    do
      app:emit_indexing_status(indexing_status.State.ready(), nil, nil, nil)
    catch
      propagated = error == "unexpected status listener failure"
    end
    test.assert(propagated,
                "status publication swallowed an unexpected listener failure")

    app:set_indexing_listener(function (_status: indexing_status.Status)
      wire.decode("\"" .. strings.char(0xff) .. "\"")
    end)
    local decoding_failure = false
    do
      app:emit_indexing_status(indexing_status.State.ready(), nil, nil, nil)
    catch
      if error is json.Error then
        local failure: json.Error = error
        decoding_failure = failure.code == "invalid_utf8" and
                           failure.position ~= nil
      end
    end
    test.assert(decoding_failure,
                "status publication swallowed an unrelated JSON decode error")
  end)
end

function test_application_continues_indexing_after_status_encoding_failure(
    _context: test.Context)
  test_runtime.run(continues_indexing_after_status_encoding_failure)
end

local function run_indexing_case(name: string, body: function (): ())
  do body() catch
    if error is async.OperationError then
      local failure = error as async.OperationError
      raise name .. ": " .. failure.operation .. ": " .. failure.name ..
        ": " .. failure.message
    end
    raise name .. ": " .. strings.tostring(error)
  end
end

function test_application_indexing_state_machine(_context: test.Context)
  test_runtime.run(function ()
    run_indexing_case(
      "initial busy response", returns_empty_results_while_initial_index_runs)
    run_indexing_case(
      "blocked cold save", catches_save_while_cold_index_is_blocked)
    run_indexing_case(
      "initial error save recovery", recovers_initial_error_from_later_save)
    run_indexing_case(
      "configuration load save recovery",
      recovers_configuration_load_failure_from_later_save)
    run_indexing_case(
      "existing refresh scope expansion",
      reconciles_expanded_scope_before_existing_analysis)
    run_indexing_case(
      "continuous hint coalescing",
      coalesces_continuous_hints_after_publishing_one_pass)
    run_indexing_case(
      "active pass progress epoch", keeps_progress_on_the_active_pass_epoch)
    run_indexing_case(
      "later epoch failure retry", retries_failure_when_a_later_epoch_is_pending)
    run_indexing_case(
      "watcher filtering", filters_irrelevant_watcher_hints)
    run_indexing_case(
      "active extensionless temporary",
      ignores_extensionless_temporary_during_active_refresh)
    run_indexing_case(
      "partial semantic view",
      builds_semantics_from_independently_valid_modules)
    run_indexing_case(
      "failed revision save recovery",
      failed_revision_waits_for_a_saved_change_and_recovers)
    run_indexing_case(
      "same-generation provider failure View rebuild",
      rebuilds_view_when_external_recheck_fails_clean_module)
    run_indexing_case(
      "unchanged View reuse", reuses_view_without_unchanged_refresh)
    run_indexing_case(
      "saved failure repair fallback",
      serves_completed_view_during_saved_failure_repair)
    run_indexing_case(
      "closed status suppression", emits_no_indexing_status_after_close)
  end)
end

local function rejects_save_during_successful_rename_preflight()
  local root = test_paths.temporary_name()
  fs.unlink(root)
  fs.mkdir(root)
  local source_root = root .. "/src"
  fs.mkdir(source_root)
  local filename = source_root .. "/main.titan"
  fs.write_file(filename,
    "local answer = 1\n" ..
    "local copy = answer\n")
  defer do
    if fs.lstat(filename) ~= nil then fs.unlink(filename) end
    if fs.lstat(source_root) ~= nil then fs.rmdir(source_root) end
    if fs.lstat(root) ~= nil then fs.rmdir(root) end
  end

  local analyzer = YieldingAnalyzer.new(0, false, false, false, false)
  local service?, service_error? = test_service.load {
    project_root = root,
    installed_binary_modules_root = test_paths.sdk_binary_root(),
    analyzer = analyzer:analyze,
  }
  test.assert(service_error == nil and service ~= nil,
              "rename-race fixture project did not load")
  if service == nil then raise "rename-race fixture Service is missing" end

  local saving = SavingRenameAnalyzer.new(filename, 0)
  local app = application.create_with_service(
    root, service, saving:analyze)
  defer app:close()

  local outcome = app:handle(rename_request_for(filename, 20, 7))
  case outcome
  when result() then
    test.assert(false, "rename returned edits for an obsolete saved generation")
  when failure{code; message} then
    test.assert(
      code == -32803 and
      strings.find(message,
                   "saved Titan project changed") ~= nil,
      "rename save race did not return the retryable RequestFailed error")
  end
  test.assert(saving.runs == 1,
              "rename save-race fixture did not run exactly one preflight")
end

function test_application_rejects_save_during_successful_rename_preflight(
    _context: test.Context)
  test_runtime.run(rejects_save_during_successful_rename_preflight)
end

local function rejects_query_captured_before_sql_publication()
  with_application(function (filename: string, _analyzer: YieldingAnalyzer,
                             app: application.Application)
    app:stop_watching_for_testing()
    local service = app.service as project_service.Service
    local store = service:workspace_store()
    local before = app.completed_view as application.View
    local access = store:acquire()
    defer access:release()
    local queued = async.run<|dispatcher.SemanticOutcome, value|>(function ():
        dispatcher.SemanticOutcome
      return app:handle(request_for(filename, 501, "textDocument/foldingRange"))
    end)
    timer.yield()
    test.assert(not queued:status():has_finished(),
      "semantic query did not wait for the active publication lease")
    local generation = before.published_generation + 1
    stores.execute(access.connection,
      "UPDATE main.store_state SET published_generation=? WHERE singleton=1", generation)
    app.completed_view = application.View.new(before.work_generation, generation,
      before.dirty_signature, semantic_features.open(store, generation), before.configuration)
    access:release()
    local rejected = false
    case join_outcome(queued, "query queued behind publication")
    when failure{code; message} then
      rejected = code == -32803 and
        strings.find(message, "retry", 1, true) ~= nil
    else
    end
    test.assert(rejected, "a captured old Features handle read the replacement generation")
    test.assert(result_array_length(app:handle(request_for(
      filename, 502, "textDocument/foldingRange")), "new published view query") == 1,
      "new query could not read the replacement publication")
  end)
end

function test_application_rolls_back_missing_schema_and_retries_publication(
    _context: test.Context)
  test_runtime.run(function ()
    with_application(function (filename: string, _analyzer: YieldingAnalyzer,
                               app: application.Application)
      app:stop_watching_for_testing()
      local service = app.service as project_service.Service
      local store = service:workspace_store()
      local before = app.completed_view as application.View
      fs.write_file(filename, "function answer(): integer return 2 end\n")
      local report?, failure? = service:refresh()
      test.assert(report ~= nil and failure == nil,
        "missing-schema fixture did not produce a fresh clean snapshot")
      local snapshot = service:latest()
      do
        local access = store:acquire()
        defer access:release()
        stores.execute(access.connection, "DROP TABLE main.semantic_files")
      end
      local reject = true
      service:set_publication_hooks(project_service.PublicationHooks.new(
        function (_snapshot: project_service.Snapshot): boolean return false end,
        function (_connection: sqlite3.Connection)
          if reject then raise "reject recreated semantic schema" end
        end))
      local rejected = false
      do app:publish_view(service, snapshot, nil)
      catch rejected = error == "reject recreated semantic schema" end
      test.assert(rejected, "publication fixture did not reject its recreated schema")
      do
        local access = store:acquire()
        defer access:release()
        test.assert(access.connection:get_autocommit() and
          stores.scalar_integer(access.connection,
            "SELECT COUNT(*) FROM main.sqlite_master WHERE type='table' AND name='semantic_files'") == 0 and
          stores.scalar_integer(access.connection,
            "SELECT published_generation FROM main.store_state WHERE singleton=1") == before.published_generation and
          stores.scalar_integer(access.connection, "SELECT COUNT(*) FROM main.semantic_folds") == 1,
          "rollback committed empty recreated tables or changed the preceding publication")
      end
      test.assert(service:project_ast("main") ~= nil,
        "failed publication released the fresh snapshot needed by its retry")
      reject = false
      local recovered = app:publish_view(service, snapshot, nil)
      app.completed_view = recovered
      test.assert(recovered.published_generation == before.published_generation + 1 and
        #recovered.features:folding_ranges(filename) == 0 and
        service:project_ast("main") == nil,
        "retry retained stale folds or failed to commit and release its fresh snapshot")
      local access = store:acquire()
      defer access:release()
      local files = stores.rows(access.connection,
        "SELECT contents FROM main.semantic_files WHERE filename=?", sqlite3.Blob.new(filename))
      test.assert(#files == 1 and stores.bytes(files[1], 1) ==
        "function answer(): integer return 2 end\n",
        "retry treated its missing saved-file table as reusable")
    end)
  end)
end

function test_application_rejects_query_captured_before_sql_publication(
    _context: test.Context)
  test_runtime.run(rejects_query_captured_before_sql_publication)
end

local function close_drains_updater_and_readers()
  with_application(function (filename: string, analyzer: YieldingAnalyzer,
                             app: application.Application)
    app:stop_watching_for_testing()
    local service = app.service as project_service.Service
    analyzer.block = true
    analyzer.started = false
    fs.write_file(filename, "function answer(): integer return 123 end\n")
    app:note_saved_change()
    wait_until(function (): boolean return analyzer.started end,
      "close-drain analyzer did not start")
    local closer = async.run<|nil, value|>(function (): nil
      app:close()
      return nil
    end)
    wait_until(function (): boolean return app.closed end,
      "close owner did not begin draining")
    local closed_epoch = app:change_epoch_for_testing()
    app:note_saved_change()
    test.assert(not closer:status():has_finished() and
      app:change_epoch_for_testing() == closed_epoch,
      "close cancelled the updater or accepted a new saved hint")
    -- A reader accepted before Store.close still owns its complete SQL lease.
    local reader = service:workspace_store():acquire()
    defer reader:release()
    analyzer.block = false
    timer.yield()
    test.assert(not closer:status():has_finished(),
      "close released SQLite while an accepted reader still owned it")
    reader:release()
    case async.join<|nil, value|>(closer)
    when succeeded() then
    when failed(failed) then raise failed.error
    else raise "close did not drain the accepted updater"
    end
    test.assert(analyzer.finished, "close cancelled the accepted compiler recheck")
    local closed = false
    do service:workspace_store():acquire() catch closed = true end
    test.assert(closed, "close left the workspace Store open")
  end)
end

function test_application_close_drains_updater_and_readers(_context: test.Context)
  test_runtime.run(close_drains_updater_and_readers)
end

local record RestorationGate
  block: boolean
  started: boolean
  finished: boolean
  cancelled: boolean
  missing: boolean
end

local function with_restoring_application(missing: boolean,
    body: function (string, YieldingAnalyzer, RestorationGate, application.Application): ())
  local root = test_paths.temporary_name()
  fs.unlink(root)
  fs.mkdir(root)
  local source_root = root .. "/src"
  fs.mkdir(source_root)
  local filename = source_root .. "/main.titan"
  fs.write_file(filename,"function answer(): integer\n  return 1\nend\n")
  defer do
    if fs.lstat(filename) ~= nil then fs.unlink(filename) end
    if fs.lstat(source_root) ~= nil then fs.rmdir(source_root) end
    if fs.lstat(root) ~= nil then fs.rmdir(root) end
  end
  local analyzer = YieldingAnalyzer.new(0,false,false,false,false)
  local gate = RestorationGate.new(true,false,false,false,missing)
  local app = application.create(root,
    function (project_root: string,_progress: bridge.ProgressListener?,
        listener: project_service.SnapshotListener?):
        (project_service.Service?,project_service.Error?,project_loader.Restoration?)
      local loaded?,failure? = test_service.load {
        project_root = project_root,
        installed_binary_modules_root = test_paths.sdk_binary_root(),
        analyzer = analyzer:analyze,
        snapshot_listener = listener,
      }
      if loaded == nil then return nil,failure,nil end
      local restoring = project_loader.restoration(function (): {string}
        gate.started = true
        defer gate.finished = true
        do
          while gate.block do async.yield() end
        catch
          if error is async.CancellationReason then gate.cancelled = true end
          raise
        end
        if gate.missing then return {"main"} end
        return {}
      end)
      return loaded,nil,restoring
    end)
  defer do gate.block = false; app:close() end
  -- Saved changes in this restoration fixture are injected explicitly. Keep
  -- native hints from starting another epoch before its controlled READY.
  app.watcher = project_watcher.start(
    project_watcher.DirectoryScope.new({}, {}),
    function (_batch: project_watcher.RediscoveryBatch) end)
  body(filename,analyzer,gate,app)
end

local function serves_published_features_during_restoration()
  with_restoring_application(false,function (filename: string,
      analyzer: YieldingAnalyzer,gate: RestorationGate,app: application.Application)
    local ready = false
    app:set_indexing_listener(function (status: indexing_status.Status)
      if indexing_status.state_name(status.state) == "ready" and not ready then
        test.assert(not gate.started,"project restoration started before READY")
        ready = true
      end
    end)
    app:start_indexing()
    wait_until(function (): boolean return gate.started end,
      "project restoration did not start after publication")
    app:stop_watching_for_testing()
    test.assert(ready and not gate.finished,
      "READY waited for project restoration")
    local runs = analyzer.runs
    test.assert(result_array_length(app:handle(request_for(
      filename,501,"textDocument/foldingRange")),"folding during restoration") == 1,
      "published folding rows were unavailable during restoration")
    assert_result(app:handle(position_request_for(
      filename,502,"textDocument/definition",1)),"definition during restoration")
    assert_result(app:handle(position_request_for(
      filename,503,"textDocument/hover",1)),"hover during restoration")
    local references = position_request_for(filename,504,"textDocument/references",1)
    local params = references.params as wire.Object
    local context: wire.Object = {["includeDeclaration"] = true}
    params["context"] = context
    assert_result(app:handle(references),"references during restoration")
    test.assert(analyzer.runs == runs and not gate.finished,
      "read-only features waited for restoration or started analysis")
    local rename = async.run<|dispatcher.SemanticOutcome,value|>(function ():
        dispatcher.SemanticOutcome
      return app:handle(request_for(filename,505,"textDocument/rename"))
    end)
    timer.yield()
    test.assert(not rename:status():has_finished(),
      "rename did not wait for the owned restoration")
    rename:cancel(async.CancellationReason.simple("cancel waiting rename"))
    async.join(rename)
    test.assert(not gate.cancelled and not gate.finished,
      "request cancellation cancelled application-owned restoration")
    fs.write_file(filename,"function answer(): integer\n  return 999\nend\n")
    app:note_saved_change()
    timer.yield()
    test.assert(analyzer.runs == runs,
      "save analysis mutated compiler state before restoration finished")
    gate.block = false
    wait_until(function (): boolean
      return not app:indexing_metrics().refresh_chain_active and analyzer.runs > runs
    end,"save did not resume after restoration")
    local snapshot = app:snapshot_for_testing() as project_service.Snapshot
    test.assert(snapshot.project_modules[1].source_files[1].contents ==
      "function answer(): integer\n  return 999\nend\n",
      "save after restoration published stale bytes")
  end)
end

function test_application_serves_sql_features_during_background_restoration(
    _context: test.Context)
  test_runtime.run(serves_published_features_during_restoration)
end

local function recovers_missing_restoration_payload()
  with_restoring_application(true,function (_filename: string,
      analyzer: YieldingAnalyzer,gate: RestorationGate,app: application.Application)
    app:start_indexing()
    wait_until(function (): boolean return gate.started end,
      "missing-payload restoration did not start")
    app:stop_watching_for_testing()
    local before = analyzer.runs
    gate.block = false
    wait_until(function (): boolean
      return analyzer.runs > before and not app:indexing_metrics().refresh_chain_active
    end,"missing project payload did not schedule ordinary writer recovery")
    test.assert(gate.finished and not gate.cancelled,
      "missing-payload restoration was not drained")
  end)
end

function test_application_recovers_missing_background_project_payload(
    _context: test.Context)
  test_runtime.run(recovers_missing_restoration_payload)
end

local function closes_blocked_restoration()
  with_restoring_application(false,function (_filename: string,
      _analyzer: YieldingAnalyzer,gate: RestorationGate,app: application.Application)
    app:start_indexing()
    wait_until(function (): boolean return gate.started end,
      "shutdown restoration did not start")
    app:close()
    test.assert(gate.finished and gate.cancelled,
      "shutdown did not cancel and drain project restoration before closing")
  end)
end

function test_application_closes_blocked_background_restoration(_context: test.Context)
  test_runtime.run(closes_blocked_restoration)
end

function test_application_native_windows_watch_paths(_context: test.Context)
  if ffi.VSCODE_TITAN_WINDOWS == 0 then test.skip("native Windows paths") end
  test.assert(application.parent_directory("C:/") == "C:/")
  test.assert(application.parent_directory("W:/live/main.titan") == "W:/live")
  test.assert(application.parent_directory("//server/share") == "//server/share")
  test.assert(application.child_path("W:/", "main.titan") == "W:/main.titan")
  test.assert(application.leaf_name("W:/main.titan") == "main.titan")
  test.assert(application.path_within("W:/", "W:/main.titan") and
              not application.path_within("C:/", "W:/main.titan"))
  test.assert(application.valid_relative_directory("W:/", "W:/pkg/nested") and
              not application.valid_relative_directory("W:/", "W:/build.debug"))
  test.assert(application.rebase_path("C:/main.titan", "C:/", "W:/") ==
              "W:/main.titan")
end

local function variant_lifecycle_diagnostics_and_completion_isolation()
  local host = bridge.host_target()
  local root = test_paths.temporary_name()
  fs.unlink(root)
  fs.mkdir(root)
  local src = root .. "/src"
  fs.mkdir(src)
  local inactive_folder = src .. "/inactive_folder"
  local nested_folder = inactive_folder .. "/nested"
  fs.mkdir(inactive_folder)
  fs.mkdir(nested_folder)
  local default_file = src .. "/foo.titan"
  local host_file = src .. "/foo." .. host .. ".titan"
  local browser_file = src .. "/foo.browser.titan"
  local consumer_file = src .. "/consumer.titan"
  local inactive_folder_main = inactive_folder .. "/inactive_folder.browser.titan"
  local inactive_folder_part = inactive_folder .. "/part.titan"
  local inactive_folder_new_part = inactive_folder .. "/new_part.titan"
  local nested_main = nested_folder .. "/nested.titan"
  local nested_part = nested_folder .. "/part.titan"
  fs.write_file(default_file,
    "function selectedValue(): integer\n  return 1\nend\n")
  fs.write_file(browser_file,
    "foreign import \"nonexistent_browser_header.h\"\n" ..
    "function browserOnly(): integer return 2 end\n" ..
    "syntax error @@@\n")
  fs.write_file(consumer_file,
    "local foo = import \"foo\"\n" ..
    "function read(): integer\n  return foo.selectedValue()\nend\n")
  fs.write_file(inactive_folder_main,
    "function browserFolderMain(): integer return 0 end\n")
  local private_part_text =
    "local privateSentinel = 42\nfunction read(): integer\n return privateSen\nend\n"
  fs.write_file(inactive_folder_part, private_part_text)
  local nested_main_text =
    "function run(): integer\n return nestedHel\nend\n"
  fs.write_file(nested_main, nested_main_text)
  fs.write_file(nested_part,
    "function nestedHelper(): integer return 7 end\n")
  defer do
    remove_application_cache(workspace_cache.directory(root))
    if fs.lstat(src .. "/yielding_diagnostic.titan") ~= nil then
      fs.unlink(src .. "/yielding_diagnostic.titan")
    end
    if fs.lstat(nested_part) ~= nil then fs.unlink(nested_part) end
    if fs.lstat(nested_main) ~= nil then fs.unlink(nested_main) end
    if fs.lstat(inactive_folder_new_part) ~= nil then fs.unlink(inactive_folder_new_part) end
    if fs.lstat(inactive_folder_part) ~= nil then fs.unlink(inactive_folder_part) end
    if fs.lstat(inactive_folder_main) ~= nil then fs.unlink(inactive_folder_main) end
    if fs.lstat(nested_folder) ~= nil then fs.rmdir(nested_folder) end
    if fs.lstat(inactive_folder) ~= nil then fs.rmdir(inactive_folder) end
    if fs.lstat(consumer_file) ~= nil then fs.unlink(consumer_file) end
    if fs.lstat(browser_file) ~= nil then fs.unlink(browser_file) end
    if fs.lstat(host_file) ~= nil then fs.unlink(host_file) end
    if fs.lstat(default_file) ~= nil then fs.unlink(default_file) end
    if fs.lstat(src) ~= nil then fs.rmdir(src) end
    if fs.lstat(root) ~= nil then fs.rmdir(root) end
  end

  local default_uri? = source_text.path_to_file_uri(default_file)
  local host_uri? = source_text.path_to_file_uri(host_file)
  local browser_uri? = source_text.path_to_file_uri(browser_file)
  local consumer_uri? = source_text.path_to_file_uri(consumer_file)
  local inactive_folder_main_uri? = source_text.path_to_file_uri(inactive_folder_main)
  local inactive_folder_part_uri? = source_text.path_to_file_uri(inactive_folder_part)
  local inactive_folder_new_part_uri? = source_text.path_to_file_uri(inactive_folder_new_part)
  local nested_main_uri? = source_text.path_to_file_uri(nested_main)
  local published: {string: diagnostics.Publication} = {}
  local app = application.create(root)
  defer app:close()
  app:set_diagnostics_listener(function (publication: diagnostics.Publication)
    published[publication.uri] = publication
  end)
  app:start_indexing()
  wait_until(function (): boolean
    local snapshot? = app:snapshot_for_testing()
    return snapshot ~= nil and not app:indexing_metrics().refresh_chain_active and
      published[browser_uri as string] ~= nil
  end, "initial variant indexing did not finish")

  local browser_pub = published[browser_uri as string]
  test.assert(#browser_pub.items == 1 and
    strings.find(browser_pub.items[1].message,
      "not analyzed: inactive for host target '" .. host ..
      "'; 'foo.titan' selects 'foo.titan'") ~= nil,
    "inactive browser variant did not publish its information diagnostic")
  test.assert(published[default_uri as string] == nil and
    published[consumer_uri as string] == nil,
    "valid active files received unexpected diagnostics")

  -- Open inactive variant and verify it gets no completion and adds nothing to consumer.
  local browser_doc = lsp.TextDocument.new(browser_uri as string, browser_file)
  local browser_dirty = "function browserDirty(): integer return 99 end\n"
  app:on_document(lsp.DocumentNotification.opened(
    lsp.OpenDocument.new(browser_doc, 1, browser_dirty)))
  local inactive_completion = app:capture_completion(
    dispatcher.CompletionRequest.new(
      dispatcher.RequestId.integer_id(1),
      lsp.CompletionParams.new(
        lsp.DocumentPosition.new(
          browser_uri as string, browser_file, source_text.Position.new(0, 30)),
        1, nil)))
  case inactive_completion()
  when result(value) then
    local object? = wire.as_object(value)
    local items? = wire.as_array(object["items"])
    test.assert(#items == 0, "open inactive variant received completion items")
  else
    test.assert(false, "inactive variant completion request failed")
  end

  test.assert(published[inactive_folder_main_uri as string] ~= nil and
    published[inactive_folder_part_uri as string] ~= nil and
    strings.find(published[inactive_folder_part_uri as string].items[1].message,
      "'inactive_folder.titan' has no active variant") ~= nil,
    "inactive folder main and contributor did not publish inactive diagnostics")

  -- VSS-1: opening only a contributor under an unopened inactive-only folder main
  -- must produce no completion and must not enter private compiler analysis.
  app:on_document(lsp.DocumentNotification.opened(
    lsp.OpenDocument.new(
      lsp.TextDocument.new(inactive_folder_part_uri as string, inactive_folder_part),
      1, private_part_text)))
  local blocked_part_completion = app:capture_completion(
    dispatcher.CompletionRequest.new(
      dispatcher.RequestId.integer_id(10),
      lsp.CompletionParams.new(
        lsp.DocumentPosition.new(
          inactive_folder_part_uri as string, inactive_folder_part,
          source_text.Position.new(2, 18)),
        1, nil)))
  case blocked_part_completion()
  when result(value) then
    local object? = wire.as_object(value)
    local items? = wire.as_array(object["items"])
    test.assert(#items == 0 and app.completion.hover_context == nil,
      "contributor of unopened inactive-only folder main entered completion analysis")
  else
    test.assert(false, "blocked contributor completion request failed")
  end

  app:on_document(lsp.DocumentNotification.opened(
    lsp.OpenDocument.new(
      lsp.TextDocument.new(inactive_folder_new_part_uri as string, inactive_folder_new_part),
      1, private_part_text)))
  local blocked_new_part_completion = app:capture_completion(
    dispatcher.CompletionRequest.new(
      dispatcher.RequestId.integer_id(11),
      lsp.CompletionParams.new(
        lsp.DocumentPosition.new(
          inactive_folder_new_part_uri as string, inactive_folder_new_part,
          source_text.Position.new(2, 18)),
        1, nil)))
  case blocked_new_part_completion()
  when result(value) then
    local object? = wire.as_object(value)
    local items? = wire.as_array(object["items"])
    test.assert(#items == 0 and app.completion.hover_context == nil,
      "new unsaved contributor under unopened inactive-only folder main entered completion analysis")
  else
    test.assert(false, "blocked new contributor completion request failed")
  end

  -- A genuinely nested folder module under that inactive folder still completes.
  app:on_document(lsp.DocumentNotification.opened(
    lsp.OpenDocument.new(
      lsp.TextDocument.new(nested_main_uri as string, nested_main),
      1, nested_main_text)))
  local nested_completion = app:capture_completion(
    dispatcher.CompletionRequest.new(
      dispatcher.RequestId.integer_id(12),
      lsp.CompletionParams.new(
        lsp.DocumentPosition.new(
          nested_main_uri as string, nested_main,
          source_text.Position.new(1, 17)),
        1, nil)))
  case nested_completion()
  when result(value) then
    local object? = wire.as_object(value)
    local items? = wire.as_array(object["items"])
    local found_nested = false
    for index = 1, #items do
      local item? = wire.as_object(items[index])
      if wire.as_string(item["label"]) == "nestedHelper" then found_nested = true end
    end
    test.assert(found_nested,
      "genuinely nested folder module under inactive parent lost completion")
  else
    test.assert(false, "nested folder completion request failed")
  end

  -- Creating foo.<host>.titan re-selects foo, updates definition, and marks foo.titan inactive.
  fs.write_file(host_file,
    "-- host override\nfunction selectedValue(): integer\n  return 42\nend\n")
  app:watch_callback(project_watcher.RediscoveryBatch.new({
    project_watcher.PathChange.created(host_file),
  }, {}, false))
  wait_until(function (): boolean
    return not app:indexing_metrics().refresh_chain_active and
      published[default_uri as string] ~= nil and
      #published[default_uri as string].items == 1
  end, "creating host variant did not republish diagnostics")
  test.assert(strings.find(published[default_uri as string].items[1].message,
    "not analyzed: inactive for host target '" .. host ..
    "'; 'foo.titan' selects 'foo." .. host .. ".titan'") ~= nil,
    "shadowed default file did not receive inactive-variant diagnostic")

  local definition_outcome = app:handle(dispatcher.SemanticRequest.new(
    dispatcher.RequestId.integer_id(2), "textDocument/definition", {
      ["textDocument"] = {["uri"] = consumer_uri as string} as wire.Object,
      ["position"] = {["line"] = 2, ["character"] = 15} as wire.Object,
    } as wire.Object))
  case definition_outcome
  when result(value) then
    local location? = wire.as_object(value)
    test.assert(location ~= nil and
      wire.as_string(location["uri"]) == host_uri,
      "definition did not move to newly created host variant")
  else
    test.assert(false, "definition request failed after creating host variant")
  end

  -- Deleting foo.<host>.titan falls back to foo.titan and clears its inactive diagnostic.
  fs.unlink(host_file)
  app:watch_callback(project_watcher.RediscoveryBatch.new({
    project_watcher.PathChange.deleted(host_file),
  }, {}, false))
  wait_until(function (): boolean
    return not app:indexing_metrics().refresh_chain_active and
      published[default_uri as string] ~= nil and
      #published[default_uri as string].items == 0
  end, "deleting host variant did not clear default file's inactive diagnostic")
  local restored_definition = app:handle(dispatcher.SemanticRequest.new(
    dispatcher.RequestId.integer_id(3), "textDocument/definition", {
      ["textDocument"] = {["uri"] = consumer_uri as string} as wire.Object,
      ["position"] = {["line"] = 2, ["character"] = 15} as wire.Object,
    } as wire.Object))
  case restored_definition
  when result(value) then
    local location? = wire.as_object(value)
    test.assert(location ~= nil and
      wire.as_string(location["uri"]) == default_uri,
      "definition did not return to foo.titan after deleting host variant")
  else
    test.assert(false, "definition request failed after deleting host variant")
  end

  -- Simulate a pre-feature persisted catalog by deleting kind-4 rows from
  -- completion_roots while preserving schema, generation, and compiler/native
  -- cache compatibility. Add a 1 MiB diagnostic-bearing module so initial
  -- diagnostic coordinate construction yields during publish_view.
  local yielding_diagnostic_file = src .. "/yielding_diagnostic.titan"
  local yielding_diagnostic_uri? = source_text.path_to_file_uri(yielding_diagnostic_file)
  fs.write_file(yielding_diagnostic_file,
    "-- " .. strings.rep("x", 1024 * 1024) .. "\n" ..
    "local broken: integer = \"not integer\"\n")
  app:watch_callback(project_watcher.RediscoveryBatch.new({
    project_watcher.PathChange.created(yielding_diagnostic_file),
  }, {}, false))
  wait_until(function (): boolean
    return not app:indexing_metrics().refresh_chain_active and
      published[yielding_diagnostic_uri as string] ~= nil
  end, "yielding diagnostic fixture did not index")
  local generation_before_legacy =
    (app.completed_view as application.View).published_generation
  app:close()
  local db_path = workspace_cache.directory(root) .. "/index.sqlite3"
  do
    local raw_store = stores.open(db_path)
    defer raw_store:close()
    local access = raw_store:acquire()
    defer access:release()
    stores.execute(access.connection,
      "DELETE FROM main.completion_roots WHERE kind=4")
    test.assert(stores.scalar_integer(access.connection,
      "SELECT count(*) FROM main.completion_roots WHERE kind=4") == 0,
      "fixture did not remove kind-4 rows")
  end

  local restarted = application.create(root)
  defer restarted:close()
  restarted:on_document(lsp.DocumentNotification.opened(
    lsp.OpenDocument.new(
      lsp.TextDocument.new(inactive_folder_part_uri as string, inactive_folder_part),
      1, private_part_text)))
  restarted:start_indexing()
  wait_until(function (): boolean
    return restarted.service ~= nil
  end, "restarted application did not load its service before publication")
  -- Issue completion before initial publication commits its repaired catalog.
  local during_startup = restarted:capture_completion(
    dispatcher.CompletionRequest.new(
      dispatcher.RequestId.integer_id(20),
      lsp.CompletionParams.new(
        lsp.DocumentPosition.new(
          inactive_folder_part_uri as string, inactive_folder_part,
          source_text.Position.new(2, 18)),
        1, nil)))
  case during_startup()
  when result(value) then
    local object? = wire.as_object(value)
    local items? = wire.as_array(object["items"])
    test.assert(#items == 0 and restarted.completion.baseline == nil and
      restarted.completion.hover_context == nil,
      "legacy catalog without kind-4 sentinel was consumed during startup publication")
  else
    test.assert(false, "startup completion against legacy catalog failed")
  end

  wait_until(function (): boolean
    return restarted.completed_view ~= nil and
      not restarted:indexing_metrics().refresh_chain_active
  end, "restarted application did not finish repairing legacy catalog")
  local repaired_generation =
    (restarted.completed_view as application.View).published_generation
  test.assert(repaired_generation > generation_before_legacy,
    "repairing a legacy completion catalog did not advance published_generation")

  local after_repair = restarted:capture_completion(
    dispatcher.CompletionRequest.new(
      dispatcher.RequestId.integer_id(21),
      lsp.CompletionParams.new(
        lsp.DocumentPosition.new(
          inactive_folder_part_uri as string, inactive_folder_part,
          source_text.Position.new(2, 18)),
        1, nil)))
  case after_repair()
  when result(value) then
    local object? = wire.as_object(value)
    local items? = wire.as_array(object["items"])
    test.assert(#items == 0 and restarted.completion.hover_context == nil,
      "inactive contributor acquired completion after legacy catalog repair")
  else
    test.assert(false, "post-repair completion request failed")
  end
end

function test_application_variant_lifecycle_diagnostics_and_completion_isolation(
    _context: test.Context)
  test_runtime.run(variant_lifecycle_diagnostics_and_completion_isolation)
end

-- Record the last generation a `$/progress` end reported, so a test can prove
-- the period closed only after the completed view was installed.
local function drained_protocol_messages(
    output: response_queue.ResponseQueue,
    requests: outbound_requests.OutboundRequests,
    creates: {wire.Object}, progress: {wire.Object},
    on_end: function (): ())
  while output:pending() > 0 do
    local message? = output:take()
    local envelope? = wire.as_object(wire.decode(message))
    test.assert(envelope ~= nil, "protocol message is not an object")
    if envelope == nil then return end
    local method? = wire.as_string(envelope["method"])
    if method == "window/workDoneProgress/create" then
      creates[#creates + 1] = envelope
      local id? = wire.as_string(envelope["id"])
      test.assert(id ~= nil, "progress create request has no string id")
      if id ~= nil then
        local target: string = id
        requests:route(target, wire.null(), nil)
      end
    elseif method == "$/progress" then
      local params? = wire.as_object(envelope["params"])
      test.assert(params ~= nil, "progress notification has no params")
      if params ~= nil then
        local value? = wire.as_object(params["value"])
        test.assert(value ~= nil, "progress notification has no value")
        if value ~= nil then
          progress[#progress + 1] = params
          if wire.as_string(value["kind"]) == "end" then on_end() end
        end
      end
    end
  end
end

local function progress_kind(entry: wire.Object): string?
  local value? = wire.as_object(entry["value"])
  if value == nil then return nil end
  return wire.as_string((value as wire.Object)["kind"])
end

local function count_progress_kind(progress: {wire.Object}, kind: string): integer
  local count = 0
  for index = 1, #progress do
    if progress_kind(progress[index]) == kind then count = count + 1 end
  end
  return count
end

local function reports_work_done_progress_per_indexing_chain()
  with_cold_application(function (
      _filename: string, analyzer: YieldingAnalyzer,
      app: application.Application)
    app:stop_watching_for_testing()
    local output = response_queue.create()
    local requests = outbound_requests.create(output)
    local creates: {wire.Object} = {}
    local progress: {wire.Object} = {}
    local completed_at_end: integer? = nil
    app:set_client_channel(requests,
      function (): lsp.ClientCapabilities?
        return lsp.ClientCapabilities.new(true, false)
      end)
    defer requests:close()
    local drain = function ()
      drained_protocol_messages(output, requests, creates, progress,
        function ()
          local view? = app.completed_view
          if view ~= nil then
            completed_at_end = (view as application.View).published_generation
          end
        end)
    end

    analyzer.block = true
    app:start_indexing()
    wait_until(function (): boolean
      drain()
      return #progress > 0
    end, "indexing work-done progress did not begin")
    wait_until(function (): boolean return analyzer.started end,
               "blocked indexing pass never started")
    test.assert(#creates == 1,
                "indexing chain did not request exactly one progress token")
    local create_params? = wire.as_object(creates[1]["params"])
    test.assert(create_params ~= nil, "progress create request has no params")
    local begin = progress[1]
    local begin_value? = wire.as_object(begin["value"])
    local token? = wire.as_string(begin["token"])
    test.assert(progress_kind(begin) == "begin" and
                begin_value ~= nil and
                wire.as_string(begin_value["title"]) == "Titan indexing" and
                wire.as_string(begin_value["message"]) == "initial" and
                token ~= nil and token == wire.as_string(create_params["token"]),
                "progress did not begin for the created token")
    test.assert(strings.find(token as string, "titan-progress/") == 1,
                "progress token is not process-qualified")

    -- A save inside the same contiguous period must not begin or end again.
    app:note_saved_change()
    analyzer.block = false
    wait_until(function (): boolean
      drain()
      return not app:indexing_metrics().refresh_chain_active and
             #progress >= 2 and
             count_progress_kind(progress, "end") == 1
    end, "indexing progress chain did not finish")
    test.assert(count_progress_kind(progress, "begin") == 1 and
                count_progress_kind(progress, "end") == 1,
                "coalesced follow-up started or ended a second progress period")
    test.assert(completed_at_end ~= nil,
                "progress ended before the completed generation was installed")
    local last = progress[#progress]
    test.assert(progress_kind(last) == "end" and
                wire.as_string(last["token"]) == token,
                "progress period did not end with its own token")
    test.assert(#creates == 1,
                "coalesced follow-up requested a second progress token")
  end)
end

function test_application_reports_work_done_progress_per_indexing_chain(
    _context: test.Context)
  test_runtime.run(reports_work_done_progress_per_indexing_chain)
end

local function with_recovering_application(
    body: function (string, RecoveringAnalyzer, application.Application): ())
  local root = test_paths.temporary_name()
  fs.unlink(root)
  fs.mkdir(root)
  local source_root = root .. "/src"
  fs.mkdir(source_root)
  local filename = source_root .. "/main.titan"
  fs.write_file(filename,
    "function answer(): integer\n" ..
    "  return 1\n" ..
    "end\n")
  defer do
    if fs.lstat(filename) ~= nil then fs.unlink(filename) end
    if fs.lstat(source_root) ~= nil then fs.rmdir(source_root) end
    if fs.lstat(root) ~= nil then fs.rmdir(root) end
  end

  local analyzer = RecoveringAnalyzer.new(true, 0)
  local service?, service_error? = test_service.load {
    project_root = root,
    installed_binary_modules_root = test_paths.sdk_binary_root(),
    analyzer = analyzer:analyze,
  }
  test.assert(service_error == nil and service ~= nil,
              "pull diagnostics fixture project did not load")
  if service == nil then raise "pull diagnostics fixture Service is missing" end
  local app = application.create_with_service(root, service)
  defer app:close()
  app:stop_watching_for_testing()
  body(filename, analyzer, app)
end

local function diagnostic_request(path: string, id: integer,
    previous_result_id: string?): dispatcher.SemanticRequest
  local uri?, uri_error? = source_text.path_to_file_uri(path)
  test.assert(uri_error == nil and uri ~= nil,
              "pull diagnostics fixture path did not become a file URI")
  if uri == nil then raise "pull diagnostics fixture URI is missing" end
  local document: wire.Object = {["uri"] = uri}
  local params: wire.Object = {["textDocument"] = document}
  if previous_result_id ~= nil then
    params["previousResultId"] = previous_result_id
  end
  return dispatcher.SemanticRequest.new(
    dispatcher.RequestId.integer_id(id), "textDocument/diagnostic", params)
end

local function pull_report(app: application.Application, path: string,
    previous_result_id: string?): wire.Object
  local outcome = app:handle(diagnostic_request(path, 1, previous_result_id))
  case outcome
  when result(value) then
    local object? = wire.as_object(value)
    test.assert(object ~= nil,
                "textDocument/diagnostic did not return an object")
    if object == nil then raise "pull diagnostics object is missing" end
    return object
  when failure{code; message} then
    test.assert(false, "pull diagnostics failed with " ..
                strings.tostring(code) .. ": " .. message)
  end
  test.assert(false, "pull diagnostics produced no outcome")
  return {}
end

local function pulls_the_completed_generation_and_waits_for_new_bytes()
  with_recovering_application(function (
      filename: string, analyzer: RecoveringAnalyzer,
      app: application.Application)
    local first = pull_report(app, filename, nil)
    test.assert(wire.as_string(first["kind"]) == "full",
                "first pull did not return a full report")
    local items? = wire.as_array(first["items"])
    test.assert(items ~= nil and #items == 1,
                "pull did not report the saved diagnostic")
    if items ~= nil then
      local only = wire.as_object(items[1])
      test.assert(wire.as_string(only["code"]) == "syntax" and
                  wire.as_string(only["source"]) == "Titan" and
                  wire.as_string(only["message"]) ==
                    "deliberate saved-source error",
                  "pull reported a different diagnostic than push")
    end
    local first_id? = wire.as_string(first["resultId"])
    test.assert(first_id ~= nil and #first_id == 64,
                "pull report omitted its hex result id")

    local repeated = pull_report(app, filename, first_id)
    test.assert(wire.as_string(repeated["kind"]) == "unchanged" and
                wire.as_string(repeated["resultId"]) == first_id and
                repeated["items"] == nil,
                "unchanged pull repeated a full report")

    -- Rewrite the saved file and pull before the watcher can deliver a hint:
    -- the pull itself must obtain the generation covering the new bytes.
    analyzer.fail = false
    fs.write_file(filename,
      "function answer(): integer\n" ..
      "  return 2\n" ..
      "end\n")
    local repaired = pull_report(app, filename, first_id)
    test.assert(wire.as_string(repaired["kind"]) == "full",
                "pull after a saved rewrite did not return a full report")
    local repaired_items? = wire.as_array(repaired["items"])
    test.assert(repaired_items ~= nil and #repaired_items == 0,
                "pull after a repaired rewrite returned the stale diagnostic")
    local repaired_id? = wire.as_string(repaired["resultId"])
    test.assert(repaired_id ~= nil and repaired_id ~= first_id,
                "repaired pull reused the preceding result id")
    test.assert(app:indexing_metrics().refresh_passes >= 1,
                "pull did not refresh the saved project for new bytes")

    -- A file the project does not contain reports no diagnostics; the pull is
    -- still a freshness barrier like every other pull.
    local outside = filename .. ".other"
    fs.write_file(outside, "not Titan source\n")
    defer fs.unlink(outside)
    local empty = pull_report(app, outside, nil)
    local empty_items? = wire.as_array(empty["items"])
    test.assert(wire.as_string(empty["kind"]) == "full" and
                empty_items ~= nil and #empty_items == 0,
                "pull for a non-project file reported diagnostics")
  end)
end

function test_application_pulls_the_completed_generation_and_refreshes_new_bytes(
    _context: test.Context)
  test_runtime.run(pulls_the_completed_generation_and_waits_for_new_bytes)
end

local function ends_the_progress_period_after_a_refresh_exception()
  with_cold_application(function (
      _filename: string, _analyzer: YieldingAnalyzer,
      app: application.Application)
    -- An inert backend keeps the pass deterministic: a real watcher hint that
    -- arrives mid-pass bumps the saved epoch, so the pass completes and starts a
    -- coalesced follow-up, and the deliberate raise then lands in that follow-up
    -- instead of the Task this test captures.
    use_manual_watch_delivery(app)
    local output = response_queue.create()
    local requests = outbound_requests.create(output)
    local creates: {wire.Object} = {}
    local progress: {wire.Object} = {}
    app:set_client_channel(requests,
      function (): lsp.ClientCapabilities?
        return lsp.ClientCapabilities.new(true, false)
      end)
    defer requests:close()
    local drain = function ()
      drained_protocol_messages(output, requests, creates, progress,
        function () end)
    end

    -- The first status emit belongs to the chain itself, before the refresh
    -- Task exists; raising on the completed-state emit unwinds the pass after
    -- its progress period has begun.
    local raised = false
    app:set_indexing_listener(function (status: indexing_status.Status)
      if not raised and indexing_status.state_name(status.state) == "ready" then
        raised = true
        raise "deliberate status publication failure"
      end
    end)
    app:start_indexing()
    local refresh_task? = app.refresh_task
    test.assert(refresh_task ~= nil, "indexing did not start a refresh Task")
    wait_until(function (): boolean
      drain()
      return raised and not app:indexing_metrics().refresh_chain_active
    end, "a raising status listener did not end the indexing chain")
    wait_until(function (): boolean
      drain()
      return count_progress_kind(progress, "end") == 1
    end, "a refresh exception after progress began left its period open")
    -- The test owns this Task's terminal status. Titan still prints an
    -- uncaught Task failure to stderr, which is the product's own diagnostic
    -- for an unexpected refresh exception.
    if refresh_task ~= nil then
      case async.join(refresh_task)
      when failed() then
      else test.assert(false, "a raising status listener did not fail the Task")
      end
    end

    -- The reporter is usable again: the next chain opens a new period.
    app:set_indexing_listener(nil)
    local tokens_before = #creates
    app:note_saved_change()
    wait_until(function (): boolean
      drain()
      return #creates == tokens_before + 1 and
             count_progress_kind(progress, "end") == 2
    end, "a refresh exception wedged the progress reporter")
  end)
end

function test_application_ends_the_progress_period_after_a_refresh_exception(
    _context: test.Context)
  test_runtime.run(ends_the_progress_period_after_a_refresh_exception)
end

local function pulls_the_repaired_saved_project_after_a_failed_pass()
  with_cold_application(function (
      filename: string, _analyzer: YieldingAnalyzer,
      app: application.Application)
    local root = paths.dirname(paths.dirname(filename))
    local config = root .. "/titan-config.lua"
    fs.write_file(config, "include = {\n")
    defer do
      if fs.lstat(config) ~= nil then fs.unlink(config) end
    end
    app:start_indexing()
    wait_until(function (): boolean
      return app.refresh_failure ~= nil and
             not app:indexing_metrics().refresh_chain_active
    end, "a broken project configuration did not fail indexing")
    test.assert(app.completed_view == nil,
                "a failed first pass installed a completed view")

    -- Repair the saved input and pull before any watcher event can be relied
    -- on: the pull itself must obtain the generation covering the repaired
    -- bytes instead of reporting the superseded failure.
    app:stop_watching_for_testing()
    fs.write_file(config,
      'include = { "./src" }\nsource_module_roots = { "./src" }\n')
    local report = pull_report(app, filename, nil)
    test.assert(wire.as_string(report["kind"]) == "full",
                "a pull after repairing the project did not return a report")
    local items? = wire.as_array(report["items"])
    test.assert(items ~= nil and #items == 0,
                "the repaired project reported stale diagnostics")
    test.assert(app:indexing_metrics().refresh_passes >= 2,
                "the pull did not retry the failed saved project")
  end)
end

function test_application_pulls_the_repaired_project_after_a_failed_pass(
    _context: test.Context)
  test_runtime.run(pulls_the_repaired_saved_project_after_a_failed_pass)
end

local function pulls_new_and_deleted_project_sources()
  with_cold_application(function (
      filename: string, _analyzer: YieldingAnalyzer,
      app: application.Application)
    local source_root = paths.dirname(filename)
    local root = paths.dirname(source_root)
    local config = root .. "/titan-config.lua"
    fs.write_file(config,
      'include = { "./src" }\nsource_module_roots = { "./src" }\n')
    defer do
      if fs.lstat(config) ~= nil then fs.unlink(config) end
    end
    app:start_indexing()
    wait_until(function (): boolean
      return app.completed_view ~= nil and
             not app:indexing_metrics().refresh_chain_active
    end, "the project did not finish its first indexing pass")
    -- Replace the watcher with one that never delivers an event, so only the
    -- pull's own freshness rule can start a refresh.
    use_manual_watch_delivery(app)

    local created = source_root .. "/created.titan"
    fs.write_file(created, "function created(): integer\n  return 1\nend\n")
    defer do
      if fs.lstat(created) ~= nil then fs.unlink(created) end
    end
    local before = app:indexing_metrics().refresh_passes
    local report = pull_report(app, created, nil)
    test.assert(wire.as_string(report["kind"]) == "full",
                "a pull for a new project source did not return a report")
    local items? = wire.as_array(report["items"])
    test.assert(items ~= nil and #items == 0,
                "a new project source reported diagnostics")
    test.assert(app:indexing_metrics().refresh_passes == before + 1,
                "a pull for a new project source did not index it")
    local settled = app:indexing_metrics().refresh_passes
    local repeated = pull_report(app, created,
      wire.as_string(report["resultId"]))
    test.assert(wire.as_string(repeated["kind"]) == "unchanged",
                "a second pull for the indexed source did not replay its report")
    test.assert(app:indexing_metrics().refresh_passes == settled + 1,
                "a barrier pull did not run exactly one saved-change pass")

    -- A saved .titan file outside every include root is not in any project
    -- generation, so it reports nothing; the pull is still a barrier.
    local outside = root .. "/stray.titan"
    fs.write_file(outside, "function stray(): integer\n  return 1\nend\n")
    defer do
      if fs.lstat(outside) ~= nil then fs.unlink(outside) end
    end
    local empty = pull_report(app, outside, nil)
    local empty_items? = wire.as_array(empty["items"])
    test.assert(wire.as_string(empty["kind"]) == "full" and
                empty_items ~= nil and #empty_items == 0,
                "a pull outside every include root reported diagnostics")

    -- Deleting an indexed source makes the generation stale: the pull refreshes
    -- instead of answering for the vanished module.
    fs.unlink(created)
    local deleted = pull_report(app, created, nil)
    local deleted_items? = wire.as_array(deleted["items"])
    test.assert(wire.as_string(deleted["kind"]) == "full" and
                deleted_items ~= nil and #deleted_items == 0,
                "a pull for a deleted source answered a stale generation")
    test.assert(app:indexing_metrics().refresh_passes > settled,
                "a pull for a deleted source did not refresh the project")
  end)
end

function test_application_pulls_new_and_deleted_project_sources(
    _context: test.Context)
  test_runtime.run(pulls_new_and_deleted_project_sources)
end

local function pulls_a_deleted_discovery_issue_path()
  with_cold_application(function (
      filename: string, _analyzer: YieldingAnalyzer,
      app: application.Application)
    local source_root = paths.dirname(filename)
    local root = paths.dirname(source_root)
    local config = root .. "/titan-config.lua"
    -- `include` admits the whole root, but only `./src` is a source root, so a
    -- `.titan` file beside it is an unmapped source with its own published
    -- diagnostic and no project-module stamp.
    fs.write_file(config,
      'include = { "." }\nsource_module_roots = { "./src" }\n')
    defer do
      if fs.lstat(config) ~= nil then fs.unlink(config) end
    end
    local unmapped = root .. "/unmapped.titan"
    fs.write_file(unmapped, "function unmapped(): integer\n  return 1\nend\n")
    defer do
      if fs.lstat(unmapped) ~= nil then fs.unlink(unmapped) end
    end
    app:start_indexing()
    wait_until(function (): boolean
      return app.completed_view ~= nil and
             not app:indexing_metrics().refresh_chain_active
    end, "the project did not finish its first indexing pass")
    use_manual_watch_delivery(app)

    local report = pull_report(app, unmapped, nil)
    test.assert(wire.as_string(report["kind"]) == "full",
                "a pull for an unmapped source did not return a report")
    local items? = wire.as_array(report["items"])
    test.assert(items ~= nil and #items == 1,
                "an unmapped source reported no discovery diagnostic")
    if items ~= nil and #items == 1 then
      local only = wire.as_object(items[1])
      test.assert(wire.as_string(only["code"]) == "unmapped-source",
                  "the unmapped source reported a different diagnostic")
    end
    local report_id = wire.as_string(report["resultId"])
    local settled = app:indexing_metrics().refresh_passes
    local unchanged = pull_report(app, unmapped, report_id)
    test.assert(wire.as_string(unchanged["kind"]) == "unchanged" and
                app:indexing_metrics().refresh_passes == settled + 1,
                "an unchanged discovery issue did not replay through one barrier pass")

    -- A discovery issue describes a file that is still saved. Deleting it must
    -- refresh before the answer, so the client does not keep a diagnostic for a
    -- path that is gone.
    fs.unlink(unmapped)
    local passes = app:indexing_metrics().refresh_passes
    local deleted = pull_report(app, unmapped, report_id)
    local deleted_items? = wire.as_array(deleted["items"])
    test.assert(wire.as_string(deleted["kind"]) == "full" and
                deleted_items ~= nil and #deleted_items == 0,
                "a pull for a deleted discovery issue answered its old diagnostic")
    test.assert(app:indexing_metrics().refresh_passes == passes + 1,
                "a pull for a deleted discovery issue did not refresh")
    -- The generation no longer describes the path, so the answer settles.
    local settled_empty = pull_report(app, unmapped, nil)
    local settled_items? = wire.as_array(settled_empty["items"])
    test.assert(wire.as_string(settled_empty["kind"]) == "full" and
                settled_items ~= nil and #settled_items == 0,
                "a deleted discovery issue kept reporting diagnostics")
  end)
end

function test_application_pulls_a_deleted_discovery_issue_path(
    _context: test.Context)
  test_runtime.run(pulls_a_deleted_discovery_issue_path)
end

local function pull_is_a_scan_only_freshness_barrier()
  with_cold_application(function (
      filename: string, analyzer: YieldingAnalyzer,
      app: application.Application)
    app:start_indexing()
    wait_until(function (): boolean
      return app.completed_view ~= nil and
             not app:indexing_metrics().refresh_chain_active
    end, "the project did not finish its first indexing pass")
    use_manual_watch_delivery(app)

    local first = pull_report(app, filename, nil)
    test.assert(wire.as_string(first["kind"]) == "full",
                "a pull for the saved project did not return a report")
    local first_items? = wire.as_array(first["items"])
    test.assert(first_items ~= nil and #first_items == 0,
                "the clean project reported diagnostics")
    local result_id? = wire.as_string(first["resultId"])
    test.assert(result_id ~= nil,
                "the pull report omitted its result id")

    -- A pull with nothing dirty is a barrier pass that only scans: it runs
    -- exactly one saved-change pass, never re-analyses, and keeps the items and
    -- their resultId.
    local passes = app:indexing_metrics().refresh_passes
    local runs = analyzer.runs
    local repeated = pull_report(app, filename, result_id)
    test.assert(wire.as_string(repeated["kind"]) == "unchanged" and
                wire.as_string(repeated["resultId"]) == result_id,
                "a no-op barrier pass changed the report identity")
    test.assert(app:indexing_metrics().refresh_passes == passes + 1,
                "a pull did not run exactly one saved-change pass")
    test.assert(analyzer.runs == runs,
                "a pull with nothing dirty re-analysed the project")
  end)
end

function test_application_pull_is_a_scan_only_freshness_barrier(
    _context: test.Context)
  test_runtime.run(pull_is_a_scan_only_freshness_barrier)
end

-- A saved input can change what another file's report says: an importer's error
-- comes from its dependency's interface, and a folder module's diagnostics span
-- every contributor. This analyzer models both with the production graph:
-- manifest digests are derived from the saved contents (so a save invalidates
-- importers exactly as a compiler interface digest does) and a module reports one
-- diagnostic on its first file whenever any project source contains the marker.
local record InputAnalyzer
  runs: integer
end

local function project_input_digest(module: bridge.ProjectModule): string
  local joined = strings.writer()
  for index = 1, #module.files do
    local file = module.files[index]
    joined:write(#file.filename .. ":" .. #file.contents .. ":" .. file.contents)
  end
  return content_identity.hex_digest(joined:drain())
end

local function marker_saved(project_modules: {bridge.ProjectModule}): boolean
  for index = 1, #project_modules do
    local module = project_modules[index]
    for file_index = 1, #module.files do
      if strings.find(module.files[file_index].contents, "BROKEN_INPUT") ~= nil then
        return true
      end
    end
  end
  return false
end

local function InputAnalyzer:analyze(
    request: project_service.AnalysisRequest): bridge.Analysis
  self.runs = self.runs + 1
  local broken = marker_saved(request.project_modules)
  local modules: {bridge.ModuleSnapshot} = {}
  local diagnostics: {bridge.Diagnostic} = {}
  for index = 1, #request.dirty_modules do
    local name = request.dirty_modules[index]
    local module? = find_project(request, name)
    test.assert(module ~= nil, "input analyzer lost a dirty project module")
    if module == nil then raise "dirty input module is missing" end
    local actual = module as bridge.ProjectModule
    local filenames: {string} = {}
    for file_index = 1, #actual.files do
      filenames[file_index] = actual.files[file_index].filename
    end
    local imports: {bridge.Import} = {}
    local digest = project_input_digest(actual)
    modules[index] = bridge.ModuleSnapshot.new(
      name,
      bridge.Provenance.project_source(filenames[1], filenames),
      bridge.Manifest.new(name, digest, digest),
      {}, {}, imports, {}, nil, nil)
    if broken then
      for file_index = 1, #filenames do
        diagnostics[#diagnostics + 1] = bridge.Diagnostic.new(
          bridge.DiagnosticKind.type_error(),
          "deliberate saved-input failure",
          bridge.SourceLocation.new(filenames[file_index], 1, 1))
      end
    end
  end
  return bridge.Analysis.new(request.root_module, diagnostics, modules, {}, {}, {})
end

local function with_input_application(
    body: function (string, string, InputAnalyzer, application.Application): ())
  local root = test_paths.temporary_name()
  fs.unlink(root)
  fs.mkdir(root)
  local source_root = root .. "/src"
  fs.mkdir(source_root)
  local filename = source_root .. "/main.titan"
  fs.write_file(filename,
    'local helper = import "helper"\n\n' ..
    "function use(): integer\n  return 1\nend\n")
  local config = root .. "/titan-config.lua"
  fs.write_file(config,
    'include = { "." }\nsource_module_roots = { "./src" }\n')
  defer do
    if fs.lstat(config) ~= nil then fs.unlink(config) end
    if fs.lstat(filename) ~= nil then fs.unlink(filename) end
    if fs.lstat(source_root) ~= nil then fs.rmdir(source_root) end
    if fs.lstat(root) ~= nil then fs.rmdir(root) end
  end
  local analyzer = InputAnalyzer.new(0)
  local app = application.create(
    root,
    function (project_root: string,
              _progress_listener: bridge.ProgressListener?,
              snapshot_listener: project_service.SnapshotListener?):
        (project_service.Service?, project_service.Error?, project_loader.Restoration?)
      local loaded?, failure? = test_service.load {
        project_root = project_root,
        installed_binary_modules_root = test_paths.sdk_binary_root(),
        analyzer = analyzer:analyze,
        snapshot_listener = snapshot_listener,
      }
      return loaded, failure, nil
    end)
  defer app:close()
  body(root, source_root, analyzer, app)
end

local function pulls_a_folder_contributor_change()
  with_input_application(function (
      root: string, source_root: string, analyzer: InputAnalyzer,
      app: application.Application)
    local folder = source_root .. "/group"
    fs.mkdir(folder)
    local main_file = folder .. "/group.titan"
    local contributor = folder .. "/b.titan"
    fs.write_file(main_file, "function group_value(): integer\n  return 1\nend\n")
    fs.write_file(contributor, "function other_value(): integer\n  return 2\nend\n")
    defer do
      if fs.lstat(main_file) ~= nil then fs.unlink(main_file) end
      if fs.lstat(contributor) ~= nil then fs.unlink(contributor) end
      if fs.lstat(folder) ~= nil then fs.rmdir(folder) end
    end
    app:start_indexing()
    wait_until(function (): boolean
      return app.completed_view ~= nil and
             not app:indexing_metrics().refresh_chain_active
    end, "the folder-module project did not finish indexing")
    use_manual_watch_delivery(app)
    local clean = pull_report(app, main_file, nil)
    local clean_items? = wire.as_array(clean["items"])
    test.assert(wire.as_string(clean["kind"]) == "full" and
                clean_items ~= nil and #clean_items == 0,
                "the folder-module project is not clean")
    local clean_id = wire.as_string(clean["resultId"])

    -- Another contributor of the same folder module is saved; the pulled
    -- contributor's own bytes do not change.
    fs.write_file(contributor,
      "function other_value(): integer\n  return 0 -- BROKEN_INPUT\nend\n")
    local report = pull_report(app, main_file, clean_id)
    local items? = wire.as_array(report["items"])
    test.assert(wire.as_string(report["kind"]) == "full" and
                items ~= nil and #items == 1,
                "a pull after a contributor save replayed the stale generation")
    local _unused = root
  end)
end

function test_application_pull_revalidates_a_folder_contributor_change(
    _context: test.Context)
  test_runtime.run(pulls_a_folder_contributor_change)
end

local function diagnostic_replay_after_failed_saved_refresh(
    context: test.Context, first_attach: boolean, unexpected: boolean)
  local root = test_paths.canonical_path(test_paths.temporary_name())
  fs.unlink(root)
  fs.mkdir(root)
  local filename = root .. "/main.titan"
  local config_file = root .. "/titan-config.lua"
  local configuration = "include = { '.' }\nsource_module_roots = { '.' }\n"
  fs.write_file(filename, "function answer(): integer return 'broken' end\n")
  fs.write_file(config_file, configuration)
  defer do
    remove_application_cache(workspace_cache.directory(root))
    fs.unlink(config_file)
    fs.unlink(filename)
    fs.rmdir(root)
  end
  local app = application.create(root)
  defer app:close()
  local uri = source_text.path_to_file_uri(filename)
  local observed: {string: diagnostics.Publication} = {}
  local listener = function (publication: diagnostics.Publication)
    observed[publication.uri] = publication
  end
  if not first_attach then app:set_diagnostics_listener(listener) end
  app:start_indexing()
  wait_until(function (): boolean
    return app.completed_view ~= nil and
      not app:indexing_metrics().refresh_chain_active
  end, "the saved diagnostic generation did not finish")
  local initial? = app:published_items(app.completed_view, uri)
  test.assert(initial ~= nil and #initial > 0,
    "the real compiler did not persist the initial error")
  use_manual_watch_delivery(app)

  if unexpected then
    app:set_indexing_listener(function (status: indexing_status.Status)
      if indexing_status.state_name(status.state) == "ready" then
        raise "deliberate saved-refresh publication failure"
      end
    end)
    context:log("BEGIN expected saved-refresh Task failure")
    app:note_saved_change()
    local refresh = app.refresh_task
    case async.join(refresh)
    when failed(failure) then
      test.assert(failure.error == "deliberate saved-refresh publication failure",
        "the refresh reported a different exceptional failure")
    else
      test.assert(false, "the refresh did not fail its publication")
    end
    context:log("END expected saved-refresh Task failure")
    app:set_indexing_listener(nil)
  else
    fs.write_file(config_file, "include = 42\n")
    app:note_saved_change()
    wait_until(function (): boolean
      return app.refresh_failure ~= nil and
        not app:indexing_metrics().refresh_chain_active
    end, "the invalid saved configuration did not fail")
  end
  local retained? = app:published_items(app.completed_view, uri)
  test.assert(retained ~= nil and #retained > 0,
    "failure discarded the retained semantic generation")
  if not first_attach then
    test.assert(observed[uri] ~= nil and #observed[uri].items == 0,
      "failed refresh did not clear the currently published error")
  end

  observed = {}
  app:set_diagnostics_listener(listener)
  local replayed? = observed[uri]
  test.assert(replayed == nil or #replayed.items == 0,
    "listener attachment resurrected diagnostics cleared by a failed refresh")

  fs.write_file(config_file, configuration)
  app:note_saved_change()
  wait_until(function (): boolean
    return observed[uri] ~= nil and #observed[uri].items > 0 and
      not app:indexing_metrics().refresh_chain_active
  end, "successful repair did not restore diagnostic publication")
  app:set_diagnostics_listener(nil)
  observed = {}
  app:set_diagnostics_listener(listener)
  test.assert(observed[uri] ~= nil and #observed[uri].items > 0,
    "successful repair did not restore listener replay")
end

function test_application_diagnostic_replay_respects_failed_saved_epoch(
    context: test.Context)
  context:run("reattach", function (child: test.Context)
    test_runtime.run(function ()
      diagnostic_replay_after_failed_saved_refresh(child, false, false)
    end)
  end)
  context:run("first_attach", function (child: test.Context)
    test_runtime.run(function ()
      diagnostic_replay_after_failed_saved_refresh(child, true, false)
    end)
  end)
  context:run("exceptional_cleanup", function (child: test.Context)
    test_runtime.run(function ()
      diagnostic_replay_after_failed_saved_refresh(child, false, true)
    end)
  end)
end

local type ReplayFixture = function (string, string): ()
local NEXT_DIAGNOSTIC_SOURCE = "function answer(): integer\n  return true\nend\n"

local function with_diagnostic_replay_cache(body: ReplayFixture)
  local root = test_paths.canonical_path(test_paths.temporary_name())
  fs.unlink(root)
  fs.mkdir(root)
  local filename = root .. "/main.titan"
  local config = root .. "/titan-config.lua"
  fs.write_file(filename, "function answer(): integer return 'broken' end\n")
  fs.write_file(config, "include = { '.' }\nsource_module_roots = { '.' }\n")
  defer do
    remove_application_cache(workspace_cache.directory(root))
    fs.unlink(config)
    fs.unlink(filename)
    fs.rmdir(root)
  end
  do
    local app = application.create(root)
    defer app:close()
    app:start_indexing()
    wait_until(function (): boolean
      return app.completed_view ~= nil and
        not app:indexing_metrics().refresh_chain_active
    end, "the cold diagnostic generation did not complete")
    local uri = source_text.path_to_file_uri(filename)
    local persisted? = app:published_items(app.completed_view, uri)
    test.assert(persisted ~= nil and #persisted == 1,
      "the cold compiler did not persist a diagnostic")
  end
  body(root, filename)
end

local function await_next_replay_publication(app: application.Application,
    observed: {diagnostics.Publication}, uri: string)
  wait_until(function (): boolean
    return not app:indexing_metrics().refresh_chain_active
  end, "the follow-up diagnostic generation did not complete")
  test.assert(app.completed_epoch == app.change_epoch and app.failed_epoch == nil,
    "the follow-up did not accept the newest saved epoch")
  local current = false
  for index = 1, #observed do
    local publication = observed[index]
    if publication.uri == uri then
      if #publication.items > 0 then
        test.assert(#publication.items == 1 and
          publication.items[1].range.start.line == 1,
          "a stale type error reached the listener")
        current = true
      end
    end
  end
  test.assert(current, "the attached listener never received the current diagnostic")
end

local function replay_after_superseding_first_warm_pass(root: string,
                                                       filename: string)
  local uri = source_text.path_to_file_uri(filename)
  local replacement: application.Application? = nil
  local app = application.create(root, function (directory: string,
      progress: bridge.ProgressListener?, listener: project_service.SnapshotListener?):
      (project_service.Service?, project_service.Error?, project_loader.Restoration?)
    local loaded?, failure?, restoration? =
      project_loader.load(directory, progress, listener)
    if loaded ~= nil then
      local current = replacement
      use_manual_watch_delivery(current)
      fs.write_file(filename, NEXT_DIAGNOSTIC_SOURCE)
      current:note_saved_change()
    end
    return loaded, failure, restoration
  end)
  replacement = app
  defer app:close()
  local observed: {diagnostics.Publication} = {}
  local reattached = false
  local stale_replay = false
  app:set_indexing_listener(function (status: indexing_status.Status)
    -- The first View is installed, but its epoch is superseded. The coalesced
    -- pass has not been scheduled when this status is emitted.
    if not reattached and app.completed_view ~= nil and
       app.completed_epoch < app.change_epoch and status.completed_files == nil then
      test.assert(app:indexing_metrics().view_builds == 0,
        "the replacement did not reuse its real SQLite publication")
      app:set_diagnostics_listener(function (publication: diagnostics.Publication)
        observed[#observed + 1] = publication
        if publication.uri == uri and #publication.items > 0 and
           publication.items[1].range.start.line == 0 then
          stale_replay = true
        end
      end)
      reattached = true
    end
  end)
  app:start_indexing()
  wait_until(function (): boolean return reattached end,
    "the superseded warm View was never available before the follow-up")
  test.assert(not stale_replay, "reattach replayed the superseded first saved epoch")
  await_next_replay_publication(app, observed, uri)
end

function test_application_diagnostic_replay_withholds_superseded_first_warm_pass(
    _context: test.Context)
  test_runtime.run(function ()
    with_diagnostic_replay_cache(replay_after_superseding_first_warm_pass)
  end)
end

local function replay_after_hint_while_store_is_held(root: string, filename: string)
  local app = application.create(root)
  defer app:close()
  app:start_indexing()
  wait_until(function (): boolean
    return app.completed_view ~= nil and
      not app:indexing_metrics().refresh_chain_active
  end, "the warm diagnostic generation did not complete")
  use_manual_watch_delivery(app)
  local uri = source_text.path_to_file_uri(filename)
  local old? = app:published_items(app.completed_view, uri)
  test.assert(old ~= nil and #old == 1, "replay fixture has no old saved error")
  local service = app.service
  local access = service:workspace_store():acquire()
  defer access:release()
  local observed: {diagnostics.Publication} = {}
  local stale_replay = false
  local replay = async.run<|nil, value|>(function (): nil
    app:set_diagnostics_listener(function (publication: diagnostics.Publication)
      observed[#observed + 1] = publication
      if publication.uri == uri and #publication.items > 0 and
         publication.items[1].range.start.line == 0 then
        stale_replay = true
      end
    end)
    return nil
  end)
  timer.yield()
  test.assert(replay:status():as_string() == "waiting",
    "listener replay did not queue behind the held Store lease")
  fs.write_file(filename, NEXT_DIAGNOSTIC_SOURCE)
  app:note_saved_change()
  access:release()
  case async.join(replay)
  when succeeded() then
  when failed(failure) then failure:raise()
  else raise "listener replay unexpectedly cancelled"
  end
  test.assert(not stale_replay, "listener replay accepted rows after a newer save hint")
  await_next_replay_publication(app, observed, uri)
end

function test_application_diagnostic_replay_rechecks_epoch_after_store_wait(
    _context: test.Context)
  test_runtime.run(function ()
    with_diagnostic_replay_cache(replay_after_hint_while_store_is_held)
  end)
end
