--- Root-level SDK selection, trust, and SDK identity for the router.
-- @module server.root_settings

foreign import "compiler_io_platform.h"

local fs = import "fs"
local strings = import "string"
local wire = import "server.wire"
local content_identity = import "server.content_identity"
local project_config = import "server.project_config"
local roots = import "server.roots"
local source_text = import "server.source_text"

-- An installed Titan SDK prefix carries these exact entries. The router checks
-- them before it starts a worker so a missing or partial installation is a
-- root-scoped error instead of a worker crash. The standard provider is a
-- static archive on Unix and a DLL on Windows, so its entry is resolved by
-- platform; the entries before and after it keep one spelling across platforms.
local const SDK_FILES: const {string} = {
  "share/lua/5.5/titan-compiler/driver.lua",
}
local const SDK_DIRECTORIES: const {string} = {
  "lib/lua/5.5",
}
local const BROWSER_FILES: const {string} = {
  "lib/titan-browser/0.6/analysis-target",
  "lib/titan-browser/0.6/absent-modules",
  "lib/titan-browser/0.6/titan.a",
}
local const IDENTITY_FILES_HEAD: const {string} = {
  "share/lua/5.5/titan-compiler/driver.lua",
}
local const IDENTITY_FILES_TAIL: const {string} = {
  "lib/titan/0.6/sdk-digests",
}
local const PROBE_ROOTS_DIRECTORY = "roots"
local const PROBE_ROOT_DIGEST_BYTES = 16
local const PATH_LIST_SEPARATOR_LINUX = ":"
local const PATH_LIST_SEPARATOR_WINDOWS = ";"

-- One required SDK file, or the root-scoped error that names it.
local function missing_file(prefix: string, entry: string): Error?
  local metadata? = fs.stat(source_text.join_path(prefix, entry))
  if metadata ~= nil and metadata.kind == "file" then return nil end
  return Error(prefix,
    "compiler_root '" .. prefix .. "' is not an installed Titan SDK: " ..
    "missing " .. entry, Reason.invalid_prefix())
end

--- The selected SDK's standard provider, relative to its prefix.
function provider_entry(): string
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then return "lib/titan/0.6/titan.dll" end
  return "lib/titan/0.6/titan.a"
end

--- The bare Titan compiler support module, distinct from the standard provider.
function support_entry(): string
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then return "lib/lua/5.5/titan.dll" end
  return "lib/lua/5.5/titan.so"
end

--- Why a root's settings cannot be accepted.
-- The router reacts structurally, not by matching a message.
union Reason
  untrusted_selection()
  invalid_prefix()
  invalid_configuration()
  invalid_target()
end

--- One root-scoped configuration or selection failure.
record Error
  const path: string
  const message: string
  const reason: Reason
  const line: integer?
end

--- Canonical directories whose Titan roots may select their own SDK.
record Trust
  local const directories: {string}
end

local function split_path_list(text: string): {string}
  local separator = PATH_LIST_SEPARATOR_LINUX
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then separator = PATH_LIST_SEPARATOR_WINDOWS end
  local result: {string} = {}
  for entry in strings.split(text, separator) do
    if entry ~= "" then result[#result + 1] = entry end
  end
  return result
end

local function trusted_entry(candidate: string): string?
  if candidate == "" then return nil end
  if strings.sub(candidate, 1, 1) == "/" then
    return roots.canonical(candidate)
  end
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 and strings.sub(candidate, 2, 2) == ":" then
    return roots.canonical(candidate)
  end
  return nil
end

--- Create a trust set from configured directories, canonicalising each entry.
function create(directories: {string}): Trust
  local result: {string} = {}
  for index = 1, #directories do
    local canonical? = trusted_entry(directories[index])
    if canonical ~= nil then result[#result + 1] = canonical end
  end
  return Trust(result)
end

--- Return the number of configured trusted directories.
function Trust:count(): integer
  return #self.directories
end

--- Report whether a canonical root is equal to or inside a trusted directory.
function Trust:allows(root: string): boolean
  for index = 1, #self.directories do
    if roots.contains(self.directories[index], root) then return true end
  end
  return false
end

-- Trusted directories arrive from two sources: the client's
-- initializationOptions.trustedRoots array and TITAN_LS_TRUSTED_ROOTS, whose
-- spelling is the host's path-list separator.
--- Collect configured trusted directories before canonicalisation.
function trust_directories(initialization_options: value?,
                           environment: string?): {string}
  local result: {string} = {}
  if initialization_options ~= nil then
    local object? = wire.as_object(initialization_options)
    if object ~= nil then
      local declared = object["trustedRoots"]
      if declared ~= nil then
        local entries? = wire.as_array(declared)
        if entries ~= nil then
          for index = 1, #entries do
            local item = entries[index]
            if item is string then result[#result + 1] = item as string end
          end
        end
      end
    end
  end
  if environment ~= nil and environment ~= "" then
    local entries = split_path_list(environment)
    for index = 1, #entries do result[#result + 1] = entries[index] end
  end
  return result
end

--- Validated SDK selection for one root.
record Settings
  const root: string
  const compiler_root: string?
  const compiler_root_file: string?
  const trusted: boolean
  const target: string?
end

--- Validate the layout of an installed Titan SDK prefix.
function validate_prefix(prefix: string, target: string?): Error?
  for index = 1, #SDK_FILES do
    local failure? = missing_file(prefix, SDK_FILES[index])
    if failure ~= nil then return failure end
  end
  if target == nil then
    local failure? = missing_file(prefix, provider_entry())
    if failure ~= nil then return failure end
  end
  local support_failure? = missing_file(prefix, support_entry())
  if support_failure ~= nil then return support_failure end
  if target == nil and ffi.VSCODE_TITAN_WINDOWS ~= 0 then
    local failure? = missing_file(prefix, "bin/lua.exe")
    if failure ~= nil then return failure end
  end
  for index = 1, #SDK_DIRECTORIES do
    local entry = source_text.join_path(prefix, SDK_DIRECTORIES[index])
    local metadata? = fs.stat(entry)
    if metadata == nil or metadata.kind ~= "directory" then
      return Error(prefix,
        "compiler_root '" .. prefix .. "' is not an installed Titan SDK: " ..
        "missing " .. SDK_DIRECTORIES[index], Reason.invalid_prefix())
    end
  end
  return nil
end

--- Resolve one root's effective SDK selection, trust decision and layout check.
function load(root: string, trust: Trust, titan_root: string?): (Settings?, Error?)
  local allowed = trust:allows(root)
  local selection?, selection_failure? = project_config.load_compiler_root(root)
  if selection == nil then
    -- A local override exists to select an SDK, and an unusable compiler_root
    -- selects nothing verifiable, so the root is refused instead of falling
    -- back to the router's own SDK.
    local problem = selection_failure
    if problem.target_selection then
      return nil, Error(problem.path, problem.message, Reason.invalid_target(), problem.line)
    end
    return nil, Error(problem.path, problem.message,
      Reason.invalid_configuration())
  end
  local selected = selection
  local compiler_root? = selected.compiler_root
  if compiler_root ~= nil then
    local source_file = selected.compiler_root_file or root
    if not allowed then
      return nil, Error(source_file,
        "root '" .. root .. "' selects compiler_root '" ..
        compiler_root .. "' from " .. source_file ..
        " but is not a trusted directory; add it to " ..
        "initializationOptions.trustedRoots or TITAN_LS_TRUSTED_ROOTS",
        Reason.untrusted_selection(), selected.compiler_root_line)
    end
    local invalid? = validate_prefix(compiler_root, selected.target)
    if invalid ~= nil then
      if selected.target == nil then return nil, invalid end
      -- This refusal was already published for browser roots. The missing
      -- base layout belongs to compiler_root, not to the browser asset check.
      return nil, Error(source_file, invalid.message, Reason.invalid_target(),
        selected.compiler_root_line)
    end
  end
  local prefix? = compiler_root or titan_root
  if selected.target == "browser" and prefix ~= nil then
    for index = 1, #BROWSER_FILES do
      local entry = source_text.join_path(prefix, BROWSER_FILES[index])
      local metadata? = fs.stat(entry)
      if metadata == nil or metadata.kind ~= "file" then
        return nil, Error(source_text.join_path(root, "titan-config.lua"),
          "browser target requires the installed SDK asset '" .. entry .. "'",
          Reason.invalid_target(), selected.target_line)
      end
    end
  end
  return Settings {
    root = root,
    compiler_root = compiler_root,
    compiler_root_file = selected.compiler_root_file,
    trusted = allowed,
    target = selected.target,
  }, nil
end

--- Return the configuration identity that decides whether a worker must restart.
function fingerprint(settings: Settings): string
  local compiler_root = settings.compiler_root or ""
  local trusted = "untrusted"
  if settings.trusted then trusted = "trusted" end
  return #compiler_root .. ":" .. compiler_root .. trusted .. (settings.target or "")
end

-- Installation identity is the stat tuple of the files that decide the
-- compiler and its standard-library inventory. Content-hashing an archive this
-- large belongs to the worker's own cache compatibility, not to a restart
-- check the router repeats.
--- Observe the selected SDK installation identity for reinstall detection.
function sdk_identity(compiler_root: string?, titan_root: string?, target: string?): string
  local prefix? = compiler_root or titan_root
  if prefix == nil then return "" end
  local output = strings.writer()
  for index = 1, #IDENTITY_FILES_HEAD do
    local entry = source_text.join_path(prefix, IDENTITY_FILES_HEAD[index])
    output:write(content_identity.stat_identity(entry))
  end
  if compiler_root ~= nil then
    output:write(content_identity.stat_identity(
      source_text.join_path(prefix, support_entry())))
  end
  if target == "browser" then
    for index = 1, #BROWSER_FILES do
      output:write(content_identity.stat_identity(
        source_text.join_path(prefix, BROWSER_FILES[index])))
    end
  else
    output:write(content_identity.stat_identity(
      source_text.join_path(prefix, provider_entry())))
    if ffi.VSCODE_TITAN_WINDOWS ~= 0 and compiler_root ~= nil then
      output:write(content_identity.stat_identity(
        source_text.join_path(prefix, "bin/lua.exe")))
    end
  end
  for index = 1, #IDENTITY_FILES_TAIL do
    local entry = source_text.join_path(prefix, IDENTITY_FILES_TAIL[index])
    output:write(content_identity.stat_identity(entry))
  end
  return content_identity.digest(output:drain())
end

--- Choose one root's compiler probe-cache prefix.
function probe_prefix(inherited: string?, root: string): string
  if inherited == nil or inherited == "" then
    return source_text.join_path(root, ".titan-ls")
  end
  local digest = content_identity.hex_digest(root)
  local name = strings.sub(digest, 1, PROBE_ROOT_DIGEST_BYTES)
  return source_text.join_path(inherited, PROBE_ROOTS_DIRECTORY .. "/" .. name)
end
