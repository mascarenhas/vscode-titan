--- Persist accepted diagnostics alongside their committed semantic generation.
-- @module server.published_diagnostics

local bridge = import "server.compiler_bridge"
local diagnostics = import "server.diagnostics"
local indexer = import "server.semantic_index"
local source_text = import "server.source_text"
local sqlite3 = import "sqlite3"
local stores = import "server.workspace_store"

local const SCHEMA_STATEMENTS: const {string} = {
  "CREATE TABLE IF NOT EXISTS main.semantic_diagnostic_publications(" ..
    "publication_order INTEGER PRIMARY KEY,uri BLOB NOT NULL)",
  "CREATE TABLE IF NOT EXISTS main.semantic_diagnostic_items(" ..
    "publication_order INTEGER NOT NULL,item_order INTEGER NOT NULL," ..
    "kind INTEGER NOT NULL,message BLOB NOT NULL,start_line INTEGER NOT NULL," ..
    "start_character INTEGER NOT NULL,finish_line INTEGER NOT NULL," ..
    "finish_character INTEGER NOT NULL,PRIMARY KEY(publication_order,item_order)," ..
    "FOREIGN KEY(publication_order) REFERENCES " ..
    "semantic_diagnostic_publications(publication_order))",
}

-- Diagnostics are published with the semantic rows. Listener replay reads that
-- completed revision without retaining its source files or AST snapshots.
--- Create tables storing diagnostics beside accepted saved generations.
function initialize_schema(connection: sqlite3.Connection)
  for index = 1, #SCHEMA_STATEMENTS do
    stores.execute(connection, SCHEMA_STATEMENTS[index])
  end
end

local function kind_code(kind: diagnostics.Kind): integer
  case kind
  when compiler(compiler_kind) then
    case compiler_kind
    when syntax() then return 0
    when type_error() then return 1
    when compiler() then return 2
    end
  when unmapped_source() then return 3
  when inactive_variant() then return 4
  end
end

local function read_kind(code: integer): diagnostics.Kind
  if code == 0 then return diagnostics.Kind.compiler(bridge.DiagnosticKind.syntax()) end
  if code == 1 then return diagnostics.Kind.compiler(bridge.DiagnosticKind.type_error()) end
  if code == 2 then return diagnostics.Kind.compiler(bridge.DiagnosticKind.compiler()) end
  if code == 4 then return diagnostics.Kind.inactive_variant() end
  return diagnostics.Kind.unmapped_source()
end

--- Replace diagnostics within the transaction committing their semantic generation.
function publish(connection: sqlite3.Connection,
                 publications: const? {diagnostics.Publication})
  stores.execute(connection, "DELETE FROM main.semantic_diagnostic_items")
  stores.execute(connection, "DELETE FROM main.semantic_diagnostic_publications")
  local publication_batch = stores.batch(
    connection, "INSERT INTO main.semantic_diagnostic_publications VALUES ", 2)
  for publication_index = 1, #publications do
    publication_batch:append(
      publication_index, sqlite3.Blob(publications[publication_index].uri))
  end
  publication_batch:flush()

  local item_batch = stores.batch(
    connection, "INSERT INTO main.semantic_diagnostic_items VALUES ", 8)
  for publication_index = 1, #publications do
    local items = publications[publication_index].items
    for item_index = 1, #items do
      local item = items[item_index]
      item_batch:append(publication_index, item_index, kind_code(item.kind),
        sqlite3.Blob(item.message), item.range.start.line,
        item.range.start.character, item.range.finish.line,
        item.range.finish.character)
    end
  end
  item_batch:flush()
end

--- Read diagnostic publications from the specified accepted generation.
function read(store: stores.Store, generation: integer): {diagnostics.Publication}
  local access = store:acquire()
  defer access:release()
  indexer.check_generation(access.connection, generation)
  local statement = access.connection:prepare(
    "SELECT p.publication_order,p.uri,i.kind,i.message,i.start_line,i.start_character," ..
    "i.finish_line,i.finish_character FROM main.semantic_diagnostic_publications AS p " ..
    "LEFT JOIN main.semantic_diagnostic_items AS i ON i.publication_order=p.publication_order " ..
    "ORDER BY p.publication_order,i.item_order")
  defer statement:close()
  local cursor = statement:query()
  defer cursor:close()
  local result: {diagnostics.Publication} = {}
  local current: diagnostics.Publication? = nil
  local publication_order = 0
  for row in cursor:fetch do
    local ordinal = row:get(1) as integer
    if current == nil or ordinal ~= publication_order then
      current = diagnostics.Publication(indexer.bytes(row, 2), {})
      result[#result + 1] = current
      publication_order = ordinal
    end
    local kind? = row:get(3) as integer?
    if kind ~= nil then
      current.items[#current.items + 1] = diagnostics.Item(read_kind(kind),
        indexer.bytes(row, 4), source_text.Span(
          source_text.Position(row:get(5) as integer, row:get(6) as integer),
          source_text.Position(row:get(7) as integer, row:get(8) as integer)))
    end
  end
  return result
end

--- Read one document's items from the specified accepted generation.
-- Pull diagnostics serve the exact rows push publication reads.
function read_uri(store: stores.Store, generation: integer,
                  uri: string): {diagnostics.Item}
  local access = store:acquire()
  defer access:release()
  indexer.check_generation(access.connection, generation)
  local statement = access.connection:prepare(
    "SELECT i.kind,i.message,i.start_line,i.start_character," ..
    "i.finish_line,i.finish_character " ..
    "FROM main.semantic_diagnostic_publications AS p " ..
    "JOIN main.semantic_diagnostic_items AS i " ..
    "ON i.publication_order=p.publication_order " ..
    "WHERE p.uri=? ORDER BY i.item_order")
  defer statement:close()
  local cursor = statement:query(indexer.blob(uri))
  defer cursor:close()
  local items: {diagnostics.Item} = {}
  for row in cursor:fetch do
    items[#items + 1] = diagnostics.Item(read_kind(row:get(1) as integer),
      indexer.bytes(row, 2), source_text.Span(
        source_text.Position(row:get(3) as integer, row:get(4) as integer),
        source_text.Position(row:get(5) as integer, row:get(6) as integer)))
  end
  return items
end
