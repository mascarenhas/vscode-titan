local os = import "os"
local lua = import "lua"

local LUA_PATH_ENVIRONMENT_VARIABLE = "TITAN_LS_LUA_PATH"
local LUA_CPATH_ENVIRONMENT_VARIABLE = "TITAN_LS_LUA_CPATH"
local DEFAULT_LUA_PATH = "./?.lua"
local DEFAULT_LUA_CPATH = "./?.so"

local function set_package_paths(path: string, cpath: string)
  local set_paths = lua.load(
    "package.path, package.cpath = ...",
    "=titan-language-server.lua-paths", nil)
  set_paths(path, cpath)
end

local function current_package_paths(): (string, string)
  local get_paths = lua.load(
    "return package.path, package.cpath",
    "=titan-language-server.lua-paths", nil)
  return get_paths()
end

function configure(): (string, string)
  local path = os.getenv(LUA_PATH_ENVIRONMENT_VARIABLE) or DEFAULT_LUA_PATH
  local cpath =
    os.getenv(LUA_CPATH_ENVIRONMENT_VARIABLE) or DEFAULT_LUA_CPATH
  set_package_paths(path, cpath)
  return path, cpath
end
