local test = import "test"
local timer = import "timer"
local strings = import "string"
local coordinator = import "server.coordinator"
local dispatcher = import "server.dispatcher"
local framing = import "server.framing"
local wire = import "server.wire"
local protocol = import "server.protocol"
local test_runtime = import "server.test_runtime"

local function response_object(source: string): wire.Object
  local parsed = wire.decode(source)
  local object? = wire.as_object(parsed)
  test.assert(object ~= nil, "protocol response was not an object")
  return object
end

local function response_error_code(source: string): integer
  local object = response_object(source)
  local failure? = wire.as_object(object["error"])
  test.assert(failure ~= nil, "protocol response had no error object")
  local code? = wire.as_integer(failure["code"])
  test.assert(code ~= nil, "protocol error had no integer code")
  return code
end

local function runs_reader_coordinator_and_single_writer()
  local initialize =
    [[{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}]]
  local initialized =
    [[{"jsonrpc":"2.0","method":"initialized","params":{}}]]
  local semantic =
    [[{"jsonrpc":"2.0","id":"work","method":"workspace/symbol",]] ..
    [["params":{}}]]
  local cancel =
    [[{"jsonrpc":"2.0","method":"$/cancelRequest",]] ..
    [["params":{"id":"work"}}]]
  local shutdown =
    [[{"jsonrpc":"2.0","id":2,"method":"shutdown"}]]
  local exit = [[{"jsonrpc":"2.0","method":"exit"}]]
  local input = strings.reader(
    framing.frame(initialize) .. framing.frame(initialized) ..
    framing.frame(semantic) .. framing.frame(cancel) ..
    framing.frame(shutdown) .. framing.frame(exit))
  local output = strings.writer()
  local notification_sink?: protocol.NotificationSink = nil
  local initialized_calls = 0
  local shutdown_calls = 0
  local handler: coordinator.SemanticHandler = function (
      _request: dispatcher.SemanticRequest): dispatcher.SemanticOutcome
    while true do timer.yield() end
    return dispatcher.SemanticOutcome.result(wire.null())
  end

  test.assert(protocol.run(
      input, output, handler,
      function ()
        initialized_calls = initialized_calls + 1
        local sink? = notification_sink
        test.assert(sink ~= nil,
                    "notification sink was not bound before initialized")
        if sink == nil then raise "notification sink is missing" end
        sink(
          [[{"jsonrpc":"2.0","method":"titan/indexingStatus","params":{"state":"indexing"}}]])
      end,
      function (sink: protocol.NotificationSink)
        notification_sink = sink
      end,
      function ()
        shutdown_calls = shutdown_calls + 1
        local sink? = notification_sink
        test.assert(sink ~= nil,
                    "notification sink was unavailable during shutdown")
        if sink == nil then raise "notification sink is missing" end
        sink(
          [[{"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"file:///workspace/main.titan","diagnostics":[]}}]])
      end) == 0,
              "orderly protocol transcript returned failure")
  local frames = framing.reader()
  frames:feed(output:drain())
  local initialize_response = response_object(frames:next())
  local indexing_notification = response_object(frames:next())
  local cancellation_response = frames:next()
  local diagnostic_clear = response_object(frames:next())
  local shutdown_response = response_object(frames:next())

  test.assert(wire.as_integer(initialize_response["id"]) == 1,
              "initialize response was lost or reordered")
  test.assert(initialized_calls == 1 and
              wire.as_string(indexing_notification["method"]) ==
                "titan/indexingStatus",
              "initialized hook did not publish its server notification")
  test.assert(response_error_code(cancellation_response) == -32800 and
              wire.as_string(
                response_object(cancellation_response)["id"]) == "work",
              "queued cancellation response was malformed")
  local diagnostic_params? = wire.as_object(diagnostic_clear["params"])
  local cleared? = wire.as_array(diagnostic_params["diagnostics"])
  test.assert(shutdown_calls == 1 and
              wire.as_string(diagnostic_clear["method"]) ==
                "textDocument/publishDiagnostics" and
              cleared ~= nil and #cleared == 0,
              "shutdown did not queue the diagnostic clear before replying")
  test.assert(wire.as_integer(shutdown_response["id"]) == 2 and
              wire.is_null(shutdown_response["result"]),
              "shutdown response was lost or reordered")
  test.assert(frames:next() == nil and frames:pending_bytes() == 0,
              "single protocol writer emitted an extra or partial frame")
end

function test_protocol_runs_a_continuous_reader_and_single_writer(
    _context: test.Context)
  test_runtime.run(runs_reader_coordinator_and_single_writer)
end

local function reports_eof_before_exit()
  local input = strings.reader(framing.frame(
    [[{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}]]))
  local output = strings.writer()
  local rejected = false
  do
    protocol.run(input, output)
  catch
    rejected = true
    test.assert(error is protocol.ProtocolError,
                "early EOF raised a non-protocol error")
    local failure = error as protocol.ProtocolError
    test.assert(failure.message ==
                  "stdin closed before the exit notification",
                "early EOF protocol error was not actionable")
  end
  test.assert(rejected, "protocol accepted EOF without exit")

  local frames = framing.reader()
  frames:feed(output:drain())
  test.assert(wire.as_integer(response_object(frames:next())["id"]) == 1,
              "writer did not flush the accepted response before EOF failure")
  test.assert(frames:next() == nil,
              "EOF failure produced an unexpected protocol response")
end

function test_protocol_reports_eof_before_exit(_context: test.Context)
  test_runtime.run(reports_eof_before_exit)
end

local function recovers_after_rejected_json_bodies()
  local bodies: {string} = {
    [[{"jsonrpc":"2.0","id":1,"id":2}]],
    [[{"method":"]] .. strings.char(0xff) .. [["}]],
    "null",
    [[{"jsonrpc":"2.0","id":null,"method":"initialize","params":{}}]],
    [[{"jsonrpc":"2.0","id":"café","method":"initialize","params":{}}]],
    [[{"jsonrpc":"2.0","method":"initialized","params":{}}]],
    [[{"jsonrpc":"2.0","id":2,"method":"shutdown","params":null}]],
    [[{"jsonrpc":"2.0","method":"exit","params":null}]],
  }
  local input = strings.writer()
  for index = 1, #bodies do input:write(framing.frame(bodies[index])) end
  local output = strings.writer()
  test.assert(protocol.run(strings.reader(input:drain()), output) == 0,
              "rejected JSON body prevented orderly protocol shutdown")

  local frames = framing.reader()
  frames:feed(output:drain())
  local expected: {integer} = {-32700, -32700, -32600, -32600}
  for index = 1, #expected do
    local response = frames:next()
    test.assert(response_error_code(response) == expected[index] and
                wire.is_null(response_object(response)["id"]),
                "rejected JSON body changed its error category or null id")
  end
  local initialized = response_object(frames:next())
  test.assert(wire.as_string(initialized["id"]) == "café",
              "protocol lost its byte-framed Unicode id after rejected input")
  local shutdown = response_object(frames:next())
  test.assert(wire.as_integer(shutdown["id"]) == 2 and
              wire.is_null(shutdown["result"]) and frames:next() == nil,
              "protocol did not preserve null lifecycle results after recovery")
end

function test_protocol_recovers_after_rejected_json_bodies(_context: test.Context)
  test_runtime.run(recovers_after_rejected_json_bodies)
end
