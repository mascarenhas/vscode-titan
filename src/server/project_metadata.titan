--- Persist saved-source diagnostics, manifests, and external/header provenance.
-- @module server.project_metadata

local sqlite3 = import "sqlite3"
local sql = import "server.workspace_store"
local compiler_bridge = import "server.compiler_bridge"
local project_graph = import "server.project_graph"
local header_store = import "server.header_store"

--- Exact saved contributor bytes and observed filesystem stamp.
record SourceFileSnapshot
  const filename: string
  const contents: string
  const stamp: project_graph.FileStamp
end

union ExternalOrigin
  source(main_file: string, source_files: {string})
  dynamic_binary(provider_file: string)
  static_binary(provider_file: string)
end

-- This record intentionally cannot carry compiler nodes, symbols, or a raw
-- AST. External compiler snapshots are converted to this metadata-only shape
-- immediately when a generation is committed.
--- Detached external manifest and provenance without a retained full AST.
record ExternalModule
  const module_name: string
  const origin: ExternalOrigin
  const manifest: project_graph.Manifest
  const stamps: {project_graph.FileStamp}
  const analyzed_input_identity: string?
  const imports: {project_graph.ImportEdge}
  const compiler_imports: {compiler_bridge.Import}
  const c_header_dependencies: {compiler_bridge.CHeaderDependency}
end

-- Immutable pre-analysis identity for one external import name. The optional
-- origin represents a clean resolver miss/error. It never carries a compiler
-- type, AST, or symbol table.
record ExternalFingerprint
  const module_name: string
  const source_required: boolean
  const topology_resolved: boolean
  const origin: ExternalOrigin?
  const stamps: {project_graph.FileStamp}
  const error: string?
end

-- Exact compiler-observed inputs for one module's C preprocessor closure.
-- These are deliberately path identities rather than watched directories:
-- `search` entries include misses and therefore notice a new earlier shadow.
--- Ordered compiler-observed C-header dependencies retained for revalidation.
record HeaderFingerprint
  const module_name: string
  const dependencies: {compiler_bridge.CHeaderDependency}
end

--- Persisted source and diagnostic state for one project module.
record ProjectState
  module_name: string
  source_files: {SourceFileSnapshot}
  compiler_snapshot: compiler_bridge.ModuleSnapshot?
  diagnostics: {compiler_bridge.Diagnostic}
end

-- Borrow the updater's connection. These factories materialize one operation's
-- typed results; no file, provenance, diagnostics, or name index lives in RAM.
--- Typed access to project, external, and header provenance rows.
record Metadata
  const connection: sqlite3.Connection
  local const graph: project_graph.Graph<|compiler_bridge.ModuleSnapshot|>
end

local function optional_blob(candidate: string?): value
  if candidate == nil then return nil end
  return sqlite3.Blob.new(candidate)
end

-- Rows are temporary SQL-boundary values with an explicit column count. Array
-- holes represent NULL; they never determine the row width or bind arity.
local record Batch
  connection: sqlite3.Connection
  prefix: string
  columns: integer
  query: string
  parameters: {value}
  count: integer
end

local function batch(connection: sqlite3.Connection, table_name: string,
                     columns: integer): Batch
  local prefix = "INSERT INTO main." .. table_name .. " VALUES "
  return Batch.new(connection, prefix, columns, prefix, {}, 0)
end

local function Batch:flush()
  if self.count == 0 then return end
  sql.execute(self.connection, self.query, ...self.parameters)
  self.query = self.prefix
  self.parameters = {}
  self.count = 0
end

local function Batch:append(row: {value})
  if self.count > 0 then self.query = self.query .. "," end
  self.query = self.query .. "("
  for column = 1, self.columns do
    if column > 1 then self.query = self.query .. "," end
    local item: value = row[column]
    if item == nil then
      self.query = self.query .. "NULL"
    else
      self.query = self.query .. "?"
      self.parameters[#self.parameters + 1] = item
    end
  end
  self.query = self.query .. ")"
  self.count = self.count + 1
  -- The widest metadata row has eight columns: 160 parameters stays below
  -- Titan's 200-position variadic-call bound and keeps each SQL packet small.
  if self.count == 20 then self:flush() end
end

--- Open project metadata storage on the shared workspace connection.
function create(connection: sqlite3.Connection,
                graph: project_graph.Graph<|compiler_bridge.ModuleSnapshot|>): Metadata
  header_store.create(connection)
  local statements = {
    "CREATE TABLE IF NOT EXISTS main.project_records(name BLOB PRIMARY KEY) WITHOUT ROWID",
    "CREATE TABLE IF NOT EXISTS main.project_sources(module BLOB NOT NULL REFERENCES project_records(name) ON DELETE CASCADE, ordinal INTEGER NOT NULL, path BLOB NOT NULL, contents BLOB NOT NULL, seconds INTEGER NOT NULL, nanos INTEGER NOT NULL, size INTEGER NOT NULL, identity BLOB, physical_identity BLOB, PRIMARY KEY(module,ordinal)) WITHOUT ROWID",
    "CREATE UNIQUE INDEX IF NOT EXISTS main.project_source_path ON project_sources(path)",
    "CREATE TABLE IF NOT EXISTS main.project_diagnostics(module BLOB NOT NULL REFERENCES project_records(name) ON DELETE CASCADE, ordinal INTEGER NOT NULL, kind INTEGER NOT NULL, message BLOB NOT NULL, path BLOB, line INTEGER, column_number INTEGER, owner BLOB, PRIMARY KEY(module,ordinal)) WITHOUT ROWID",
    "CREATE TABLE IF NOT EXISTS main.external_records(name BLOB PRIMARY KEY, kind INTEGER NOT NULL, main_path BLOB NOT NULL, public_manifest BLOB NOT NULL, source_manifest BLOB NOT NULL, analyzed_identity BLOB) WITHOUT ROWID",
    "CREATE TABLE IF NOT EXISTS main.external_observations(name BLOB PRIMARY KEY, source_required INTEGER NOT NULL, topology_resolved INTEGER NOT NULL, kind INTEGER, main_path BLOB, error BLOB) WITHOUT ROWID",
    "CREATE TABLE IF NOT EXISTS main.external_files(scope INTEGER NOT NULL, module BLOB NOT NULL, ordinal INTEGER NOT NULL, path BLOB NOT NULL, seconds INTEGER NOT NULL, nanos INTEGER NOT NULL, size INTEGER NOT NULL, identity BLOB, physical_identity BLOB, PRIMARY KEY(scope,module,ordinal)) WITHOUT ROWID",
    "CREATE TABLE IF NOT EXISTS main.external_sources(scope INTEGER NOT NULL, module BLOB NOT NULL, ordinal INTEGER NOT NULL, path BLOB NOT NULL, PRIMARY KEY(scope,module,ordinal)) WITHOUT ROWID",
    "CREATE TABLE IF NOT EXISTS main.external_import_details(module BLOB NOT NULL, ordinal INTEGER NOT NULL, alias BLOB NOT NULL, imported BLOB NOT NULL, source_required INTEGER NOT NULL, path BLOB NOT NULL, line INTEGER NOT NULL, column_number INTEGER NOT NULL, PRIMARY KEY(module,ordinal)) WITHOUT ROWID",
  }
  for index = 1, #statements do sql.execute(connection, statements[index]) end
  return Metadata.new(connection, graph)
end

local function Metadata:names(query: string): {string}
  local rows = sql.rows(self.connection, query)
  local result: {string} = {}
  for index = 1, #rows do result[index] = sql.bytes(rows[index], 1) end
  return result
end

function Metadata:project_names(): {string}
  return self:names("SELECT name FROM main.project_records ORDER BY name")
end

function Metadata:external_names(): {string}
  return self:names("SELECT name FROM main.external_records ORDER BY name")
end

function Metadata:fingerprint_names(): {string}
  return self:names("SELECT name FROM main.external_observations ORDER BY name")
end

function Metadata:header_names(): {string}
  return self:names("SELECT key FROM main.header_owners WHERE scope=0 ORDER BY key")
end

function Metadata:has_project(name: string): boolean
  return sql.scalar_integer(self.connection,
    "SELECT EXISTS(SELECT 1 FROM main.project_records WHERE name=?)",
    sqlite3.Blob.new(name)) == 1
end

function Metadata:has_external(name: string): boolean
  return sql.scalar_integer(self.connection,
    "SELECT EXISTS(SELECT 1 FROM main.external_records WHERE name=?)",
    sqlite3.Blob.new(name)) == 1
end

local function diagnostic_kind(code: integer): compiler_bridge.DiagnosticKind
  if code == 0 then return compiler_bridge.DiagnosticKind.syntax() end
  if code == 1 then return compiler_bridge.DiagnosticKind.type_error() end
  return compiler_bridge.DiagnosticKind.compiler()
end

local function diagnostic_code(kind: compiler_bridge.DiagnosticKind): integer
  case kind
  when syntax() then return 0
  when type_error() then return 1
  when compiler() then return 2
  end
end

function Metadata:project(name: string): ProjectState?
  if not self:has_project(name) then return nil end
  local sources = sql.rows(self.connection,
    "SELECT path,contents,seconds,nanos,size,identity,physical_identity FROM main.project_sources WHERE module=? ORDER BY ordinal",
    sqlite3.Blob.new(name))
  local files: {SourceFileSnapshot} = {}
  for index = 1, #sources do
    local row = sources[index]
    local path = sql.bytes(row, 1)
    files[index] = SourceFileSnapshot.new(path, sql.bytes(row, 2),
      project_graph.FileStamp.new(path, row:get(3), row:get(4), row:get(5),
        sql.optional_bytes(row, 6), sql.optional_bytes(row, 7)))
  end
  local raw = sql.rows(self.connection,
    "SELECT kind,message,path,line,column_number,owner FROM main.project_diagnostics WHERE module=? ORDER BY ordinal",
    sqlite3.Blob.new(name))
  local diagnostics: {compiler_bridge.Diagnostic} = {}
  for index = 1, #raw do
    local row = raw[index]
    local path? = sql.optional_bytes(row, 3)
    local location?: compiler_bridge.SourceLocation = nil
    if path ~= nil then
      location = compiler_bridge.SourceLocation.new(path, row:get(4), row:get(5))
    end
    diagnostics[index] = compiler_bridge.Diagnostic.new(
      diagnostic_kind(row:get(1)), sql.bytes(row, 2), location,
      sql.optional_bytes(row, 6))
  end
  return ProjectState.new(name, files, self.graph:project_snapshot(name), diagnostics)
end

function Metadata:write_project_sources(name: string, files: {SourceFileSnapshot})
  sql.execute(self.connection,
    "INSERT INTO main.project_records VALUES(?) ON CONFLICT DO NOTHING",
    sqlite3.Blob.new(name))
  sql.execute(self.connection,"DELETE FROM main.project_sources WHERE module=?",
    sqlite3.Blob.new(name))
  local insert = batch(self.connection, "project_sources", 9)
  for index = 1, #files do
    local source = files[index]
    local stamp = source.stamp
    insert:append({sqlite3.Blob.new(name), index, sqlite3.Blob.new(source.filename),
      sqlite3.Blob.new(source.contents), stamp.modified_seconds,
      stamp.modified_nanoseconds, stamp.size, optional_blob(stamp.identity),
      optional_blob(stamp.physical_identity)})
  end
  insert:flush()
end

function Metadata:refresh_project_observations(name: string,
    files: {SourceFileSnapshot})
  for index = 1, #files do
    local source = files[index]
    local stamp = source.stamp
    sql.execute(self.connection,
      "UPDATE main.project_sources SET seconds=?,nanos=?,size=? " ..
      "WHERE module=? AND ordinal=? AND path=?", stamp.modified_seconds,
      stamp.modified_nanoseconds, stamp.size, sqlite3.Blob.new(name), index,
      sqlite3.Blob.new(source.filename))
  end
end

function Metadata:write_diagnostics(name: string,
    diagnostics: {compiler_bridge.Diagnostic})
  sql.execute(self.connection,"DELETE FROM main.project_diagnostics WHERE module=?",
    sqlite3.Blob.new(name))
  local insert = batch(self.connection, "project_diagnostics", 8)
  for index = 1, #diagnostics do
    local diagnostic = diagnostics[index]
    local path?: string
    local line?: integer
    local column?: integer
    if diagnostic.location ~= nil then
      path = diagnostic.location.filename
      line = diagnostic.location.line
      column = diagnostic.location.column
    end
    insert:append({sqlite3.Blob.new(name), index, diagnostic_code(diagnostic.kind),
      sqlite3.Blob.new(diagnostic.message), optional_blob(path), line, column,
      optional_blob(diagnostic.owner_module)})
  end
  insert:flush()
end

function Metadata:remove_project(name: string)
  sql.execute(self.connection,"DELETE FROM main.project_records WHERE name=?",
    sqlite3.Blob.new(name))
end

local function origin_values(origin: ExternalOrigin?): (integer?, string?)
  if origin == nil then return nil, nil end
  case origin
  when source{main_file} then return 0, main_file
  when dynamic_binary{provider_file} then return 1, provider_file
  when static_binary{provider_file} then return 2, provider_file
  end
end

local function Metadata:origin(scope: integer, name: string,
    kind: integer?, main_path: string?): ExternalOrigin?
  if kind == nil then return nil end
  if kind == 1 then
    return ExternalOrigin.dynamic_binary(main_path)
  elseif kind == 2 then
    return ExternalOrigin.static_binary(main_path)
  end
  local rows = sql.rows(self.connection,
    "SELECT path FROM main.external_sources WHERE scope=? AND module=? ORDER BY ordinal",
    scope, sqlite3.Blob.new(name))
  local files: {string} = {}
  for index = 1, #rows do files[index] = sql.bytes(rows[index], 1) end
  return ExternalOrigin.source(main_path, files)
end

local function Metadata:write_origin(scope: integer, name: string,
                                    origin: ExternalOrigin?)
  sql.execute(self.connection,
    "DELETE FROM main.external_sources WHERE scope=? AND module=?",
    scope, sqlite3.Blob.new(name))
  if origin == nil then return end
  case origin
  when source{source_files} then
    local insert = batch(self.connection, "external_sources", 4)
    for index = 1, #source_files do
      insert:append({scope, sqlite3.Blob.new(name), index,
        sqlite3.Blob.new(source_files[index])})
    end
    insert:flush()
  else
  end
end

local function Metadata:stamps(scope: integer, name: string): {project_graph.FileStamp}
  local rows = sql.rows(self.connection,
    "SELECT path,seconds,nanos,size,identity,physical_identity FROM main.external_files WHERE scope=? AND module=? ORDER BY ordinal",
    scope, sqlite3.Blob.new(name))
  local result: {project_graph.FileStamp} = {}
  for index = 1, #rows do
    local row = rows[index]
    result[index] = project_graph.FileStamp.new(sql.bytes(row, 1),
      row:get(2), row:get(3), row:get(4), sql.optional_bytes(row, 5),
      sql.optional_bytes(row, 6))
  end
  return result
end

local function Metadata:write_stamps(scope: integer, name: string,
                                    stamps: {project_graph.FileStamp})
  sql.execute(self.connection,
    "DELETE FROM main.external_files WHERE scope=? AND module=?",scope,sqlite3.Blob.new(name))
  local insert = batch(self.connection, "external_files", 9)
  for index = 1, #stamps do
    local stamp = stamps[index]
    insert:append({scope, sqlite3.Blob.new(name), index, sqlite3.Blob.new(stamp.path),
      stamp.modified_seconds, stamp.modified_nanoseconds, stamp.size,
      optional_blob(stamp.identity), optional_blob(stamp.physical_identity)})
  end
  insert:flush()
end

local function Metadata:refresh_observations(scope: integer, name: string,
    stamps: {project_graph.FileStamp})
  for index = 1, #stamps do
    local stamp = stamps[index]
    sql.execute(self.connection,
      "UPDATE main.external_files SET seconds=?,nanos=?,size=? " ..
      "WHERE scope=? AND module=? AND ordinal=? AND path=?",
      stamp.modified_seconds, stamp.modified_nanoseconds, stamp.size,
      scope, sqlite3.Blob.new(name), index, sqlite3.Blob.new(stamp.path))
  end
end

function Metadata:refresh_external_observations(name: string,
    stamps: {project_graph.FileStamp})
  self:refresh_observations(1, name, stamps)
end

function Metadata:refresh_fingerprint_observations(name: string,
    stamps: {project_graph.FileStamp})
  self:refresh_observations(0, name, stamps)
end

local function Metadata:headers(scope: integer, name: string): HeaderFingerprint?
  local inputs? = header_store.read(self.connection, scope, name)
  if inputs == nil then
    if sql.scalar_integer(self.connection,
        "SELECT EXISTS(SELECT 1 FROM main.header_owners WHERE scope=? AND key=?)",
        scope, sqlite3.Blob.new(name)) ~= 0 then
      raise "invalid saved header owner"
    end
    return nil
  end
  return HeaderFingerprint.new(name, inputs)
end

local function Metadata:write_headers(scope: integer, name: string,
    dependencies: {compiler_bridge.CHeaderDependency})
  header_store.replace(self.connection, scope, name, dependencies)
end

function Metadata:refresh_header_observations(name: string,
    dependencies: {compiler_bridge.CHeaderDependency})
  header_store.refresh(self.connection, 0, name, dependencies)
  header_store.refresh(self.connection, 1, name, dependencies)
end

function Metadata:header(name: string): HeaderFingerprint?
  return self:headers(0, name)
end

function Metadata:write_header(name: string, dependencies: {compiler_bridge.CHeaderDependency})
  self:write_headers(0, name, dependencies)
end

function Metadata:remove_header(name: string)
  header_store.remove(self.connection, 0, name)
end

function Metadata:clear_headers()
  header_store.clear_scope(self.connection, 0)
end

function Metadata:fingerprint(name: string): ExternalFingerprint?
  local rows = sql.rows(self.connection,
    "SELECT source_required,topology_resolved,kind,main_path,error FROM main.external_observations WHERE name=?",sqlite3.Blob.new(name))
  if #rows == 0 then return nil end
  local row = rows[1]
  local source_required: integer = row:get(1)
  local topology_resolved: integer = row:get(2)
  local kind?: integer = row:get(3)
  return ExternalFingerprint.new(name, source_required == 1, topology_resolved == 1,
    self:origin(0, name, kind, sql.optional_bytes(row, 4)),
    self:stamps(0, name), sql.optional_bytes(row, 5))
end

function Metadata:write_fingerprint(fingerprint: ExternalFingerprint)
  local name = fingerprint.module_name
  local kind?, path? = origin_values(fingerprint.origin)
  local source_required = 0
  if fingerprint.source_required then source_required = 1 end
  local topology = 0
  if fingerprint.topology_resolved then topology = 1 end
  sql.execute(self.connection,
    "INSERT INTO main.external_observations VALUES(?,?,?,?,?,?) ON CONFLICT(name) DO UPDATE SET source_required=excluded.source_required,topology_resolved=excluded.topology_resolved,kind=excluded.kind,main_path=excluded.main_path,error=excluded.error",
    sqlite3.Blob.new(name), source_required, topology, kind, optional_blob(path), optional_blob(fingerprint.error))
  self:write_origin(0, name, fingerprint.origin)
  self:write_stamps(0, name, fingerprint.stamps)
end

function Metadata:remove_fingerprint(name: string)
  sql.execute(self.connection,"DELETE FROM main.external_observations WHERE name=?",sqlite3.Blob.new(name))
  self:write_origin(0, name, nil)
  self:write_stamps(0, name, {})
end

function Metadata:external(name: string): ExternalModule?
  local rows = sql.rows(self.connection,
    "SELECT kind,main_path,public_manifest,source_manifest,analyzed_identity FROM main.external_records WHERE name=?",sqlite3.Blob.new(name))
  if #rows == 0 then return nil end
  local row = rows[1]
  local imports = sql.rows(self.connection,
    "SELECT alias,imported,source_required,path,line,column_number FROM main.external_import_details WHERE module=? ORDER BY ordinal",sqlite3.Blob.new(name))
  local compiler_imports: {compiler_bridge.Import} = {}
  for index = 1, #imports do
    local item = imports[index]
    local required: integer = item:get(3)
    compiler_imports[index] = compiler_bridge.Import.new(sql.bytes(item, 1),
      sql.bytes(item, 2), required == 1,
      compiler_bridge.SourceLocation.new(sql.bytes(item, 4), item:get(5), item:get(6)))
  end
  local headers = self:headers(1, name)
  return ExternalModule.new(name,
    self:origin(1, name, row:get(1), sql.bytes(row, 2)),
    project_graph.Manifest.new(sql.bytes(row, 3), sql.bytes(row, 4)),
    self:stamps(1, name), sql.optional_bytes(row, 5),
    self.graph:direct_imports(name), compiler_imports, headers.dependencies)
end

function Metadata:write_external(external: ExternalModule)
  local name = external.module_name
  local kind?, path? = origin_values(external.origin)
  sql.execute(self.connection,
    "INSERT INTO main.external_records VALUES(?,?,?,?,?,?) ON CONFLICT(name) DO UPDATE SET kind=excluded.kind,main_path=excluded.main_path,public_manifest=excluded.public_manifest,source_manifest=excluded.source_manifest,analyzed_identity=excluded.analyzed_identity",
    sqlite3.Blob.new(name), kind, optional_blob(path),
    sqlite3.Blob.new(external.manifest.public_digest),
    sqlite3.Blob.new(external.manifest.source_digest),optional_blob(external.analyzed_input_identity))
  self:write_origin(1, name, external.origin)
  self:write_stamps(1, name, external.stamps)
  self:write_headers(1, name, external.c_header_dependencies)
  sql.execute(self.connection,"DELETE FROM main.external_import_details WHERE module=?",sqlite3.Blob.new(name))
  local insert = batch(self.connection, "external_import_details", 8)
  for index = 1, #external.compiler_imports do
    local item = external.compiler_imports[index]
    local required = 0
    if item.source_required then required = 1 end
    insert:append({sqlite3.Blob.new(name), index, sqlite3.Blob.new(item.alias),
      sqlite3.Blob.new(item.module_name), required, sqlite3.Blob.new(item.location.filename),
      item.location.line, item.location.column})
  end
  insert:flush()
end

function Metadata:remove_external(name: string)
  sql.execute(self.connection,"DELETE FROM main.external_records WHERE name=?",sqlite3.Blob.new(name))
  sql.execute(self.connection,"DELETE FROM main.external_import_details WHERE module=?",sqlite3.Blob.new(name))
  header_store.remove(self.connection, 1, name)
  self:write_origin(1, name, nil)
  self:write_stamps(1, name, {})
end

function Metadata:clear_externals()
  sql.execute(self.connection,"DELETE FROM main.external_records")
  sql.execute(self.connection,"DELETE FROM main.external_import_details")
  sql.execute(self.connection,"DELETE FROM main.external_observations")
  sql.execute(self.connection,"DELETE FROM main.external_files")
  sql.execute(self.connection,"DELETE FROM main.external_sources")
  header_store.clear_scope(self.connection, 1)
end
