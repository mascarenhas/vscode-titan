--- Persist ordered compiler-observed C-header dependency closures by scope.
-- @module server.header_store

local sqlite3 = import "sqlite3"
local strings = import "string"
local sql = import "server.workspace_store"
local bridge = import "server.compiler_bridge"

local const SCHEMA_STATEMENTS: const {string} = {
  "CREATE TABLE IF NOT EXISTS main.header_dependencies(" ..
    "id INTEGER PRIMARY KEY,kind INTEGER NOT NULL CHECK(kind IN (0,1,2))," ..
    "path BLOB NOT NULL CHECK(typeof(path)='blob')," ..
    "identity BLOB NOT NULL CHECK(typeof(identity)='blob')," ..
    "observed_seconds INTEGER,observed_nanos INTEGER,physical_identity BLOB," ..
    "precision TEXT,size INTEGER,changed_seconds INTEGER,changed_nanos INTEGER," ..
    "CHECK((observed_seconds IS NULL AND observed_nanos IS NULL AND physical_identity IS NULL) OR " ..
      "(typeof(observed_seconds)='integer' AND typeof(observed_nanos)='integer' AND typeof(physical_identity)='blob')))",
  "CREATE UNIQUE INDEX IF NOT EXISTS main.header_dependencies_absent " ..
    "ON header_dependencies(kind,path,identity) WHERE observed_seconds IS NULL",
  "CREATE UNIQUE INDEX IF NOT EXISTS main.header_dependencies_observed " ..
    "ON header_dependencies(kind,path,identity,observed_seconds,observed_nanos,physical_identity," ..
      "COALESCE(precision,''),COALESCE(size,''),COALESCE(changed_seconds,''),COALESCE(changed_nanos,'')) " ..
    "WHERE observed_seconds IS NOT NULL",
  "CREATE TABLE IF NOT EXISTS main.header_owners(" ..
    "id INTEGER PRIMARY KEY,scope INTEGER NOT NULL CHECK(scope IN (0,1,2,3))," ..
    "key BLOB NOT NULL CHECK(typeof(key)='blob'),UNIQUE(scope,key))",
  "CREATE TABLE IF NOT EXISTS main.header_inputs(" ..
    "owner_id INTEGER NOT NULL REFERENCES header_owners(id) ON DELETE CASCADE," ..
    "ordinal INTEGER NOT NULL CHECK(ordinal>0)," ..
    "dependency_id INTEGER NOT NULL REFERENCES header_dependencies(id)," ..
    "PRIMARY KEY(owner_id,ordinal)) WITHOUT ROWID",
  "CREATE INDEX IF NOT EXISTS main.header_inputs_dependency ON header_inputs(dependency_id)",
}

-- Namespaces: 0 = observed module baseline, 1 = analyzed external module,
-- 2 = parsed C-header artifact, 3 = converted FFI artifact. An owner exists
-- even when its ordered input list is empty. All operations borrow the caller's
-- lease and transaction; no dictionary or owner index remains in memory.
--- Create persistent tables for ordered C-header dependency closures.
function create(connection: sqlite3.Connection)
  for index = 1, #SCHEMA_STATEMENTS do
    sql.execute(connection, SCHEMA_STATEMENTS[index])
  end
end

--- Read the ordered header closure for one scope and metadata key.
function read(connection: sqlite3.Connection, scope: integer,
              key: string): {bridge.CHeaderDependency}?
  local owners = sql.rows(connection,
    "SELECT id FROM main.header_owners WHERE scope=? AND key=?",
    scope, sqlite3.Blob(key))
  if #owners ~= 1 then return nil end
  local owner: integer = owners[1]:get(1)
  local rows = sql.rows(connection,
    "SELECT d.kind,d.path,d.identity,d.observed_seconds,d.observed_nanos,d.physical_identity,i.ordinal," ..
      "d.precision,d.size,d.changed_seconds,d.changed_nanos " ..
    "FROM main.header_inputs i LEFT JOIN main.header_dependencies d ON d.id=i.dependency_id " ..
    "WHERE i.owner_id=? ORDER BY i.ordinal", owner)
  local inputs: {bridge.CHeaderDependency} = {}
  for index = 1, #rows do
    local row = rows[index]
    local code: value = row:get(1)
    local path: value = row:get(2)
    local digest: value = row:get(3)
    local ordinal: value = row:get(7)
    if not (code is integer) or not (path is sqlite3.Blob) or
       not (digest is sqlite3.Blob) or ordinal ~= index then return nil end
    local kind? = bridge.header_dependency_kind_from_code(code)
    if kind == nil then return nil end
    local observation: bridge.HeaderObservation?
    local seconds: value = row:get(4)
    local nanos: value = row:get(5)
    local physical: value = row:get(6)
    if seconds ~= nil or nanos ~= nil or physical ~= nil then
      if not (seconds is integer) or not (nanos is integer) or
         not (physical is sqlite3.Blob) then return nil end
      observation = bridge.HeaderObservation(seconds, nanos,
        (physical as sqlite3.Blob).bytes, row:get(8), row:get(9), row:get(10), row:get(11))
    end
    inputs[index] = bridge.CHeaderDependency(kind,
      (path as sqlite3.Blob).bytes, (digest as sqlite3.Blob).bytes, observation)
  end
  return inputs
end

-- Bounded SQL packets insert dictionary values and resolve their row IDs in
-- bulk. Separate NULL/present joins use the matching partial unique index;
-- each packet stays below Titan's 200-value variadic-call limit.
local function incoming(inputs: const? {bridge.CHeaderDependency}, first: integer,
                        last: integer): (string, {value})
  local query = strings.writer()
  query:write("WITH incoming(ordinal,kind,path,identity,observed_seconds,observed_nanos,physical_identity,precision,size,changed_seconds,changed_nanos) AS (VALUES")
  local parameters: {value} = {}
  for index = first, last do
    if index > first then query:write(",") end
    local input = inputs[index]
    local obs? = input.observation
    parameters[#parameters + 1] = index
    parameters[#parameters + 1] = input.kind:code()
    parameters[#parameters + 1] = sqlite3.Blob(input.path)
    parameters[#parameters + 1] = sqlite3.Blob(input.identity)
    if obs == nil then
      query:write("(?,?,?,?,NULL,NULL,NULL,NULL,NULL,NULL,NULL)")
    else
      query:write("(?,?,?,?,?,?,?")
      parameters[#parameters + 1] = obs.modified_seconds
      parameters[#parameters + 1] = obs.modified_nanoseconds
      parameters[#parameters + 1] = sqlite3.Blob(obs.physical_identity)
      if obs.precision == nil then
        query:write(",NULL")
      else
        query:write(",?")
        parameters[#parameters + 1] = obs.precision
      end
      if obs.size == nil then
        query:write(",NULL")
      else
        query:write(",?")
        parameters[#parameters + 1] = obs.size
      end
      if obs.changed_seconds == nil then
        query:write(",NULL")
      else
        query:write(",?")
        parameters[#parameters + 1] = obs.changed_seconds
      end
      if obs.changed_nanoseconds == nil then
        query:write(",NULL")
      else
        query:write(",?")
        parameters[#parameters + 1] = obs.changed_nanoseconds
      end
      query:write(")")
    end
  end
  query:write(") ")
  return query:drain(), parameters
end

--- Replace one complete observed header closure within the caller transaction.
function replace(connection: sqlite3.Connection, scope: integer, key: string,
                 inputs: const? {bridge.CHeaderDependency})
  sql.execute(connection,
    "INSERT INTO main.header_owners(scope,key) VALUES(?,?) ON CONFLICT(scope,key) DO NOTHING",
    scope, sqlite3.Blob(key))
  local owner = sql.scalar_integer(connection,
    "SELECT id FROM main.header_owners WHERE scope=? AND key=?", scope, sqlite3.Blob(key))
  sql.execute(connection, "DELETE FROM main.header_inputs WHERE owner_id=?", owner)
  for first = 1, #inputs, 16 do
    local last = first + 15
    if last > #inputs then last = #inputs end
    local prefix, parameters = incoming(inputs, first, last)
    sql.execute(connection, prefix ..
      "INSERT INTO main.header_dependencies(kind,path,identity,observed_seconds,observed_nanos,physical_identity,precision,size,changed_seconds,changed_nanos) " ..
      "SELECT kind,path,identity,observed_seconds,observed_nanos,physical_identity,precision,size,changed_seconds,changed_nanos FROM incoming " ..
      "WHERE true ON CONFLICT DO NOTHING", ...parameters)
    parameters[#parameters + 1] = owner
    sql.execute(connection, prefix ..
      "INSERT INTO main.header_inputs(owner_id,ordinal,dependency_id) " ..
      "SELECT ?,resolved.ordinal,resolved.id FROM (" ..
        "SELECT i.ordinal,d.id FROM incoming i JOIN main.header_dependencies d " ..
        "ON d.kind=i.kind AND d.path=i.path AND d.identity=i.identity " ..
        "WHERE i.observed_seconds IS NULL AND d.observed_seconds IS NULL UNION ALL " ..
        "SELECT i.ordinal,d.id FROM incoming i JOIN main.header_dependencies d " ..
        "ON d.kind=i.kind AND d.path=i.path AND d.identity=i.identity " ..
        "AND d.observed_seconds=i.observed_seconds AND d.observed_nanos=i.observed_nanos " ..
        "AND d.physical_identity=i.physical_identity " ..
        "AND d.precision IS i.precision AND d.size IS i.size " ..
        "AND d.changed_seconds IS i.changed_seconds AND d.changed_nanos IS i.changed_nanos " ..
        "WHERE i.observed_seconds IS NOT NULL AND d.observed_seconds IS NOT NULL) AS resolved",
      ...parameters)
  end
end

local function dependency_key(input: bridge.CHeaderDependency): string
  return input.kind:code() .. ":" .. #input.path .. ":" .. input.path .. input.identity
end

-- A module refresh may include only some of the analyzed external closure.
-- Match existing triples and retain order, duplicates, and unmatched inputs.
-- Immutable values shared by other owners are never updated in place.
function refresh(connection: sqlite3.Connection, scope: integer, key: string,
                 inputs: const? {bridge.CHeaderDependency})
  local previous? = read(connection, scope, key)
  if previous == nil then return end
  local entries = previous
  local updates: {string: bridge.CHeaderDependency} = {}
  for index = 1, #inputs do updates[dependency_key(inputs[index])] = inputs[index] end
  local changed = false
  for index = 1, #entries do
    local update? = updates[dependency_key(entries[index])]
    if update ~= nil then
      entries[index] = update
      changed = true
    end
  end
  if changed then replace(connection, scope, key, entries) end
end

function remove(connection: sqlite3.Connection, scope: integer, key: string)
  sql.execute(connection, "DELETE FROM main.header_owners WHERE scope=? AND key=?",
    scope, sqlite3.Blob(key))
end

function clear_scope(connection: sqlite3.Connection, scope: integer)
  sql.execute(connection, "DELETE FROM main.header_owners WHERE scope=?", scope)
end

-- Run once in accepted publication, after all owners have their current links.
-- Rolling publication back also restores any values pruned here.
--- Remove header rows no longer retained by their owning metadata.
function prune(connection: sqlite3.Connection)
  sql.execute(connection, "DELETE FROM main.header_dependencies AS d WHERE NOT EXISTS(" ..
    "SELECT 1 FROM main.header_inputs i WHERE i.dependency_id=d.id)")
end
