local wire = import "server.wire"

union Decision
  unhandled()
  result(value)
  failure(code: integer, message: string)
  notification()
  initialized()
  exit(integer)
end

local union Phase
  before_initialize()
  awaiting_initialized()
  running()
  shutdown()
  exited()
end

record Lifecycle
  local phase: Phase
  local completion_enabled: boolean
end

local INVALID_REQUEST = -32600
local INVALID_PARAMS = -32602
local SERVER_NOT_INITIALIZED = -32002

function create(): Lifecycle
  return Lifecycle.new(Phase.before_initialize(), false)
end

function Lifecycle:enable_completion()
  self.completion_enabled = true
end

function Lifecycle:phase_name(): string
  case self.phase
  when before_initialize() then return "before_initialize"
  when awaiting_initialized() then return "awaiting_initialized"
  when running() then return "running"
  when shutdown() then return "shutdown"
  when exited() then return "exited"
  end
  return "exited"
end

local function fail(code: integer, message: string): Decision
  return Decision.failure(code, message)
end

local function initialize_result(completion_enabled: boolean): wire.Object
  local capabilities: wire.Object = {
    -- vscode-languageclient currently advertises only UTF-16 and rejects any
    -- other selection. State the negotiated/default encoding explicitly.
    ["positionEncoding"] = "utf-16",
    ["definitionProvider"] = true,
    ["referencesProvider"] = true,
    ["renameProvider"] = true,
    ["hoverProvider"] = true,
    ["foldingRangeProvider"] = true,
  }
  if completion_enabled then
    local save: wire.Object = {["includeText"] = false}
    local sync: wire.Object = {
      ["openClose"] = true, ["change"] = 1, ["save"] = save,
    }
    local triggers: wire.Array = {".", ":"}
    local completion: wire.Object = {
      ["resolveProvider"] = false, ["triggerCharacters"] = triggers,
    }
    capabilities["textDocumentSync"] = sync
    capabilities["completionProvider"] = completion
  end
  return {["capabilities"] = capabilities}
end

local function object_params(params: value): boolean
  if params == nil then return false end
  return wire.as_object(params) ~= nil
end

local function absent_or_null_params(params: value): boolean
  if params == nil then return true end
  return wire.is_null(params)
end

local function Lifecycle:handle_exit(is_request: boolean): Decision
  if is_request then
    return fail(INVALID_REQUEST, "exit must be sent as a notification")
  end

  local code = 1
  case self.phase
  when shutdown() then code = 0
  else code = 1
  end
  self.phase = Phase.exited()
  return Decision.exit(code)
end

local function Lifecycle:handle_initialize(
    is_request: boolean, params: value): Decision
  if not is_request then
    return fail(INVALID_REQUEST, "initialize must be sent as a request")
  end

  case self.phase
  when before_initialize() then
    if not object_params(params) then
      return fail(INVALID_PARAMS, "initialize params must be an object")
    end
    self.phase = Phase.awaiting_initialized()
    return Decision.result(initialize_result(self.completion_enabled))
  else
    return fail(INVALID_REQUEST, "initialize may only be sent once")
  end
end

local function Lifecycle:handle_initialized(
    is_request: boolean, params: value): Decision
  if is_request then
    return fail(INVALID_REQUEST, "initialized must be sent as a notification")
  end
  if not object_params(params) then
    return fail(INVALID_PARAMS, "initialized params must be an object")
  end

  case self.phase
  when awaiting_initialized() then
    self.phase = Phase.running()
    return Decision.initialized()
  else
    -- Notification errors have no response. Leave the state unchanged.
    return Decision.notification()
  end
end

local function Lifecycle:handle_shutdown(
    is_request: boolean, params: value): Decision
  if not is_request then
    return fail(INVALID_REQUEST, "shutdown must be sent as a request")
  end
  if not absent_or_null_params(params) then
    return fail(INVALID_PARAMS, "shutdown does not accept params")
  end

  case self.phase
  when before_initialize() then
    return fail(SERVER_NOT_INITIALIZED,
                "server has not received an initialize request")
  when awaiting_initialized() then
    self.phase = Phase.shutdown()
    return Decision.result(wire.null())
  when running() then
    self.phase = Phase.shutdown()
    return Decision.result(wire.null())
  else
    return fail(INVALID_REQUEST, "server has already shut down")
  end
end

function Lifecycle:dispatch(method: string, is_request: boolean,
                            params: value): Decision
  if method == "exit" then return self:handle_exit(is_request) end
  if method == "initialize" then
    return self:handle_initialize(is_request, params)
  end

  case self.phase
  when before_initialize() then
    if is_request then
      return fail(SERVER_NOT_INITIALIZED,
                  "server has not received an initialize request")
    end
    return Decision.notification()
  when shutdown() then
    if is_request then
      return fail(INVALID_REQUEST, "server has already shut down")
    end
    return Decision.notification()
  when exited() then
    if is_request then
      return fail(INVALID_REQUEST, "server has already exited")
    end
    return Decision.notification()
  else
  end

  if method == "initialized" then
    return self:handle_initialized(is_request, params)
  end
  if method == "shutdown" then
    return self:handle_shutdown(is_request, params)
  end
  return Decision.unhandled()
end
