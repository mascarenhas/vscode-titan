local test_paths = import "server.test_paths"
local test = import "test"
local iteration = import "iteration"
local strings = import "string"
local json = import "json"
local wire = import "server.wire"
local framing = import "server.framing"
local dispatcher = import "server.dispatcher"

local function response_object(result: dispatcher.DispatchResult): wire.Object
  test.assert(result.response ~= nil, "request produced no response")
  local parsed = wire.decode(result.response)
  local object? = wire.as_object(parsed)
  test.assert(object ~= nil, "dispatcher response was not an object")
  return object
end

local function member_count(object: wire.Object): integer
  local count = 0
  for _, _ in iteration.pairs<|string, value|>(object) do count = count + 1 end
  return count
end

local function response_error_code(result: dispatcher.DispatchResult): integer
  local object = response_object(result)
  local failure? = wire.as_object(object["error"])
  test.assert(failure ~= nil, "response did not contain an error object")
  local code? = wire.as_integer(failure["code"])
  test.assert(code ~= nil, "response error did not contain an integer code")
  return code
end

local function running_dispatcher(): dispatcher.Dispatcher
  local server = dispatcher.create()
  server:dispatch(
    [[{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}]])
  server:dispatch(
    [[{"jsonrpc":"2.0","method":"initialized","params":{}}]])
  return server
end

function test_dispatcher_routes_typed_document_notifications(_context: test.Context)
  local server = running_dispatcher()
  case server:route([[{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"]] .. test_paths.workspace_uri() .. [[/main.titan","languageId":"titan","version":1,"text":"unsaved"}}}]])
  when document(notification) then
    case notification
    when opened(item) then test.assert(item.version == 1 and item.text == "unsaved")
    else test.assert(false, "didOpen had the wrong typed notification")
    end
  else test.assert(false, "didOpen was discarded")
  end
  case server:route([[{"jsonrpc":"2.0","method":"textDocument/didSave","params":{"textDocument":{"uri":"]] .. test_paths.workspace_uri() .. [[/main.titan"}}}]])
  when document(notification) then
    case notification
    when saved(item) then test.assert(item.path == (test_paths.workspace_root() .. "/main.titan"))
    else test.assert(false, "didSave had the wrong typed notification")
    end
  else test.assert(false, "versionless didSave was discarded")
  end
  case server:route([[{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"]] .. test_paths.workspace_uri() .. [[/main.titan","version":2},"contentChanges":[{"text":"next"}]}}]])
  when document(notification) then
    case notification
    when changed(item) then test.assert(item.version == 2 and item.text == "next")
    else test.assert(false, "didChange had the wrong typed notification")
    end
  else test.assert(false, "didChange was discarded")
  end
  case server:route([[{"jsonrpc":"2.0","method":"textDocument/didClose","params":{"textDocument":{"uri":"]] .. test_paths.workspace_uri() .. [[/main.titan"}}}]])
  when document(notification) then
    case notification
    when closed(item) then test.assert(item.path == (test_paths.workspace_root() .. "/main.titan"))
    else test.assert(false, "didClose had the wrong typed notification")
    end
  else test.assert(false, "didClose was discarded")
  end
end

function test_dispatcher_validates_completion_and_drops_malformed_sync(_context: test.Context)
  local server = running_dispatcher()
  case server:route([[{"jsonrpc":"2.0","id":4,"method":"textDocument/completion","params":{"textDocument":{"uri":"]] .. test_paths.workspace_uri() .. [[/main.titan"},"position":{"line":0,"character":3},"context":{"triggerKind":2,"triggerCharacter":"."}}}]])
  when completion(request) then
    test.assert(request.id:to_json() == 4 and
      request.params.document.position.character == 3 and
      request.params.trigger_character == ".")
  else test.assert(false, "completion did not route with typed params")
  end
  case server:route([[{"jsonrpc":"2.0","id":5,"method":"textDocument/completion","params":{}}]])
  when immediate(result) then test.assert(response_error_code(result) == -32602)
  else test.assert(false, "invalid completion escaped protocol validation")
  end
  case server:route([[{"jsonrpc":"2.0","method":"textDocument/didChange","params":{}}]])
  when immediate(result) then test.assert(result.response == nil)
  else test.assert(false, "malformed notification escaped validation")
  end
end

local function assert_internal_error(object: wire.Object,
                                     id: dispatcher.RequestId)
  local failure? = wire.as_object(object["error"])
  test.assert(failure ~= nil and member_count(failure) == 2 and
              wire.as_integer(failure["code"]) == -32603 and
              wire.as_string(failure["message"]) == "Internal error",
              "encoding failure did not produce the fixed Internal Error")
  test.assert(member_count(object) == 3 and object["result"] == nil and
              wire.as_string(object["jsonrpc"]) == "2.0" and
              object["id"] == id:to_json(),
              "encoding fallback changed the envelope or request id")
end

function test_dispatcher_runs_the_lsp_lifecycle(_context: test.Context)
  local server = dispatcher.create()

  local initialized = server:dispatch(
    [[{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}]])
  local initialize_response = response_object(initialized)
  test.assert(wire.as_integer(initialize_response["id"]) == 1,
              "initialize response changed the request id")
  local initialize_result? =
    wire.as_object(initialize_response["result"])
  local capabilities? =
    wire.as_object(initialize_result["capabilities"])
  test.assert(capabilities ~= nil and member_count(capabilities) == 6 and
              wire.as_string(capabilities["positionEncoding"]) ==
                "utf-16" and
              wire.as_boolean(capabilities["definitionProvider"]) and
              wire.as_boolean(capabilities["referencesProvider"]) and
              wire.as_boolean(capabilities["renameProvider"]) and
              wire.as_boolean(capabilities["hoverProvider"]) and
              wire.as_boolean(capabilities["foldingRangeProvider"]),
              "dispatcher omitted a supported semantic capability")

  local ready = server:dispatch(
    [[{"jsonrpc":"2.0","method":"initialized","params":{}}]])
  test.assert(ready.response == nil and ready.exit_code == nil,
              "initialized notification produced output")

  local unknown = server:dispatch(
    [[{"jsonrpc":"2.0","id":"feature","method":"textDocument/hover",]] ..
    [["params":{}}]])
  test.assert(response_error_code(unknown) == -32601,
              "unsupported request did not return Method not found")

  local cancellation = server:dispatch(
    [[{"jsonrpc":"2.0","method":"$/cancelRequest",]] ..
    [["params":{"id":"feature"}}]])
  test.assert(cancellation.response == nil and cancellation.exit_code == nil,
              "cancellation notification produced protocol output")

  local shutdown = server:dispatch(
    [[{"jsonrpc":"2.0","id":2,"method":"shutdown"}]])
  local shutdown_response = response_object(shutdown)
  test.assert(wire.as_integer(shutdown_response["id"]) == 2 and
              wire.is_null(shutdown_response["result"]),
              "shutdown response did not preserve id and null result")

  local exited = server:dispatch(
    [[{"jsonrpc":"2.0","method":"exit"}]])
  test.assert(exited.response == nil and exited.exit_code == 0,
              "orderly exit did not terminate successfully")
end

function test_dispatcher_returns_json_rpc_errors(_context: test.Context)
  local malformed = dispatcher.create():dispatch("{")
  test.assert(response_error_code(malformed) == -32700,
              "malformed JSON did not return Parse error")

  local invalid = dispatcher.create():dispatch(
    [[{"jsonrpc":"2.0","id":1.0,"method":"initialize","params":{}}]])
  test.assert(response_error_code(invalid) == -32600,
              "non-LSP request id did not return Invalid Request")

  local early = dispatcher.create():dispatch(
    [[{"jsonrpc":"2.0","id":7,"method":"workspace/symbol"}]])
  test.assert(response_error_code(early) == -32002,
              "pre-initialize request did not return ServerNotInitialized")

  local bad_params = dispatcher.create():dispatch(
    [[{"jsonrpc":"2.0","id":8,"method":"initialize","params":null}]])
  test.assert(response_error_code(bad_params) == -32600,
              "scalar envelope params did not return Invalid Request")

  local notification = dispatcher.create():dispatch(
    [[{"jsonrpc":"2.0","method":"unknown/notification"}]])
  test.assert(notification.response == nil,
              "unknown notification incorrectly produced an error response")

  local bad_cancellation = dispatcher.create():dispatch(
    [[{"jsonrpc":"2.0","method":"$/cancelRequest","params":{}}]])
  test.assert(bad_cancellation.response == nil,
              "invalid cancellation notification produced a response")

  local cancellation_server = dispatcher.create()
  cancellation_server:dispatch(
    [[{"jsonrpc":"2.0","id":10,"method":"initialize","params":{}}]])
  local cancellation_request = cancellation_server:dispatch(
    [[{"jsonrpc":"2.0","id":9,"method":"$/cancelRequest",]] ..
    [["params":{"id":8}}]])
  test.assert(response_error_code(cancellation_request) == -32601,
              "$/ request did not return Method not found")
end

function test_dispatcher_validates_envelope_params_without_replying_to_notifications(
    _context: test.Context)
  local request = dispatcher.create():dispatch(
    [[{"jsonrpc":"2.0","id":1,"method":"initialize","params":7}]])
  test.assert(response_error_code(request) == -32600,
              "scalar request params did not invalidate the envelope")

  local server = dispatcher.create()
  server:dispatch(
    [[{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}]])
  local bad_notification = server:dispatch(
    [[{"jsonrpc":"2.0","method":"initialized","params":"bad"}]])
  test.assert(bad_notification.response == nil and
              server:phase_name() == "awaiting_initialized",
              "invalid notification params responded or changed lifecycle")

  local initialized = server:dispatch(
    [[{"jsonrpc":"2.0","method":"initialized","params":[]}]])
  test.assert(initialized.response == nil and
              server:phase_name() == "awaiting_initialized",
              "initialized accepted array params required to be an object")
  server:dispatch(
    [[{"jsonrpc":"2.0","method":"initialized","params":{}}]])

  local array_params = server:dispatch(
    [[{"jsonrpc":"2.0","id":2,"method":"workspace/symbol",]] ..
    [["params":[]}]])
  test.assert(response_error_code(array_params) == -32601,
              "JSON-RPC array params were rejected at the envelope boundary")

  local shutdown = server:dispatch(
    [[{"jsonrpc":"2.0","id":3,"method":"shutdown","params":null}]])
  test.assert(wire.is_null(response_object(shutdown)["result"]),
              "shutdown rejected interoperable null params")
  local bad_exit = server:dispatch(
    [[{"jsonrpc":"2.0","method":"exit","params":{}}]])
  test.assert(bad_exit.response == nil and bad_exit.exit_code == nil and
              server:phase_name() == "shutdown",
              "invalid exit params changed lifecycle or produced a response")
  local exit = server:dispatch(
    [[{"jsonrpc":"2.0","method":"exit"}]])
  test.assert(exit.exit_code == 0,
              "exit with omitted params was rejected")
end

function test_dispatcher_enforces_lsp_request_id_domain(
    _context: test.Context)
  local maximum = dispatcher.create():dispatch(
    [[{"jsonrpc":"2.0","id":2147483647,"method":"initialize",]] ..
    [["params":{}}]])
  test.assert(wire.as_integer(response_object(maximum)["id"]) ==
                2147483647,
              "maximum signed 32-bit request id was rejected")

  local minimum = dispatcher.create():dispatch(
    [[{"jsonrpc":"2.0","id":-2147483648,"method":"initialize",]] ..
    [["params":{}}]])
  test.assert(wire.as_integer(response_object(minimum)["id"]) ==
                -2147483648,
              "minimum signed 32-bit request id was rejected")

  local too_large = dispatcher.create():dispatch(
    [[{"jsonrpc":"2.0","id":2147483648,"method":"initialize",]] ..
    [["params":{}}]])
  test.assert(response_error_code(too_large) == -32600 and
              wire.is_null(response_object(too_large)["id"]),
              "out-of-range positive request id was accepted")

  local too_small = dispatcher.create():dispatch(
    [[{"jsonrpc":"2.0","id":-2147483649,"method":"initialize",]] ..
    [["params":{}}]])
  test.assert(response_error_code(too_small) == -32600,
              "out-of-range negative request id was accepted")

  local noninteger_ids: {string} = {"1.5", "1.0", "1e0"}
  for index = 1, #noninteger_ids do
    local rejected = dispatcher.create():dispatch(
      [[{"jsonrpc":"2.0","id":]] .. noninteger_ids[index] ..
      [[,"method":"initialize","params":{}}]])
    test.assert(response_error_code(rejected) == -32600 and
                wire.is_null(response_object(rejected)["id"]),
                "noninteger request id was accepted: " .. noninteger_ids[index])
  end
end

function test_dispatcher_distinguishes_null_and_missing_request_ids(
    _context: test.Context)
  local server = dispatcher.create()
  local root_null = server:dispatch("null")
  test.assert(response_error_code(root_null) == -32600 and
              wire.is_null(response_object(root_null)["id"]),
              "a null document was treated as a notification")

  local explicit_null = server:dispatch(
    [[{"jsonrpc":"2.0","id":null,"method":"initialize","params":{}}]])
  test.assert(response_error_code(explicit_null) == -32600 and
              wire.is_null(response_object(explicit_null)["id"]),
              "an explicit null request id was treated as a missing id")

  local missing = server:dispatch(
    [[{"jsonrpc":"2.0","method":"initialize","params":{}}]])
  test.assert(missing.response == nil and
              server:phase_name() == "before_initialize",
              "a missing id replied or initialized the server")
  local accepted = server:dispatch(
    [[{"jsonrpc":"2.0","id":7,"method":"initialize","params":{}}]])
  test.assert(wire.as_integer(response_object(accepted)["id"]) == 7 and
              server:phase_name() == "awaiting_initialized",
              "rejected null envelopes disrupted the next valid request")
end

function test_dispatcher_rejects_noninteger_cancellation_ids(
    _context: test.Context)
  local server = running_dispatcher()
  local invalid_ids: {string} = {"1.0", "1e0", "2147483648", "null"}
  for index = 1, #invalid_ids do
    case server:route(
      [[{"jsonrpc":"2.0","method":"$/cancelRequest","params":{"id":]] ..
      invalid_ids[index] .. [[}}]])
    when immediate(result) then
      test.assert(result.response == nil and result.exit_code == nil,
                  "invalid cancellation id produced protocol output")
    else
      test.assert(false, "invalid cancellation id reached request ownership")
    end
  end
  case server:route(
    [[{"jsonrpc":"2.0","method":"$/cancelRequest","params":{"id":1}}]])
  when cancel(id) then
    test.assert(id:equals(dispatcher.RequestId.integer_id(1)),
                "integer cancellation id changed during routing")
  else
    test.assert(false, "valid cancellation was lost after rejected ids")
  end
end

function test_dispatcher_classifies_numeric_range_errors_and_recovers(
    _context: test.Context)
  local server = dispatcher.create()
  local out_of_range: {string} = {
    "9223372036854775808", "1e9999", "1e-9999",
  }
  for index = 1, #out_of_range do
    local rejected = server:dispatch(
      [[{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"n":]] ..
      out_of_range[index] .. [[}}]])
    test.assert(response_error_code(rejected) == -32600 and
                wire.is_null(response_object(rejected)["id"]),
                "unrepresentable JSON number did not return Invalid Request")
  end

  local malformed: {string} = {"1e", "01", "1."}
  for index = 1, #malformed do
    local rejected = server:dispatch(
      [[{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"n":]] ..
      malformed[index] .. [[}}]])
    test.assert(response_error_code(rejected) == -32700 and
                wire.is_null(response_object(rejected)["id"]),
                "malformed JSON number did not return Parse error")
  end

  test.assert(server:phase_name() == "before_initialize",
              "rejected JSON changed the lifecycle")
  local accepted = server:dispatch(
    [[{"jsonrpc":"2.0","id":9,"method":"initialize","params":{}}]])
  test.assert(wire.as_integer(response_object(accepted)["id"]) == 9 and
              response_object(accepted)["error"] == nil,
              "numeric JSON rejection disrupted a later valid request")
end

function test_dispatcher_encodes_nil_and_false_semantic_results(
    _context: test.Context)
  local id = dispatcher.RequestId.integer_id(17)
  local absent = response_object(dispatcher.result_response(id, nil))
  test.assert(absent["result"] ~= nil and wire.is_null(absent["result"]) and
              wire.as_integer(absent["id"]) == 17 and absent["error"] == nil,
              "a nil semantic result omitted the required null result")
  local flag = response_object(dispatcher.result_response(id, false))
  test.assert(wire.as_boolean(flag["result"]) == false and
              flag["error"] == nil,
              "a false semantic result was changed to null or omitted")
end

function test_dispatcher_falls_back_for_unencodable_results_and_error_text(
    _context: test.Context)
  local integer_id = dispatcher.RequestId.integer_id(17)
  local cyclic: wire.Object = {}
  cyclic["self"] = cyclic
  assert_internal_error(
    response_object(dispatcher.result_response(integer_id, cyclic)), integer_id)

  local string_id = dispatcher.RequestId.string_id("saved-file")
  local malformed: wire.Object = {
    ["uri"] = (test_paths.workspace_uri() .. "/") .. strings.char(0xff),
  }
  assert_internal_error(
    response_object(dispatcher.result_response(string_id, malformed)), string_id)
  assert_internal_error(response_object(dispatcher.failure_response(
    string_id, -32602, "invalid path: " .. strings.char(0xff))), string_id)

  local recovered = response_object(dispatcher.result_response(string_id, "ok"))
  test.assert(wire.as_string(recovered["result"]) == "ok" and
              recovered["error"] == nil,
              "encoding failure disrupted a later semantic result")
end

function test_dispatcher_fallback_preserves_the_largest_accepted_string_id(
    _context: test.Context)
  local input_limit = 16 * 1024 * 1024
  local prefix = [[{"jsonrpc":"2.0","id":"]]
  local suffix = [[","method":"x"}]]
  local text_id = strings.rep("x", input_limit - #prefix - #suffix)
  local input = framing.reader()
  input:feed(framing.frame(prefix .. text_id .. suffix))
  local body? = input:next()
  test.assert(body ~= nil and #body == input_limit and input:next() == nil,
              "maximum-sized request did not pass the input framing boundary")

  local server = running_dispatcher()
  case server:route(body)
  when semantic(request) then
    test.assert(request.id:to_json() == text_id,
                "maximum-sized string id was not accepted intact")
    local fallback = dispatcher.failure_response(
      request.id, -32602, strings.char(0xff))
    test.assert(fallback.response ~= nil, "maximum-id fallback was dropped")
    local response: string = fallback.response
    test.assert(#response > input_limit and #response <= input_limit + 4096,
                "maximum-id fallback did not fit the reserved output budget")
    -- Response envelopes have an explicit reserve beyond the input frame
    -- limit. Decode with that allowance instead of the request-only decoder.
    local decoded = json.decode(response, nil,
      json.DecodeOption.max_bytes(input_limit + 4096))
    local object? = wire.as_object(decoded)
    test.assert(object ~= nil, "maximum-id fallback was not a JSON object")
    assert_internal_error(object, request.id)
    test.assert(wire.as_string(object["id"]) == text_id,
                "maximum-id fallback truncated or changed the accepted id")
  else
    test.assert(false, "maximum-sized valid request was not routed")
  end
end

function test_dispatcher_processes_a_coalesced_framed_transcript(
    _context: test.Context)
  local input = framing.reader()
  local initialize =
    [[{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}]]
  local shutdown =
    [[{"jsonrpc":"2.0","id":2,"method":"shutdown"}]]
  input:feed(framing.frame(initialize) .. framing.frame(shutdown))

  local server = dispatcher.create()
  local first_body? = input:next()
  local second_body? = input:next()
  local first = server:dispatch(first_body)
  local second = server:dispatch(second_body)
  test.assert(wire.as_integer(response_object(first)["id"]) == 1,
              "first coalesced request was not dispatched first")
  test.assert(wire.as_integer(response_object(second)["id"]) == 2,
              "second coalesced request was lost or reordered")
  test.assert(input:next() == nil,
              "coalesced transcript left an unexpected third frame")
end
