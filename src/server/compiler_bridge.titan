local iteration = import "iteration"
local lua = import "lua"
local math = import "math"
local strings = import "string"
local async = import "async"
local fs = import "fs"
local content_identity = import "server.content_identity"
local compiler_io = import "server.compiler_io"
local compiler_scheduler = import "server.compiler_scheduler"
local embedded_interfaces = import "server.embedded_interfaces"
local wire = import "server.wire"
local logging = import "server.logging"

local COMPILER_ABI = "2"
local COMPILER_LANGUAGE_SERVER_API = 1
local COMPILER_LANGUAGE_SERVER_API_MARKER = "LANGUAGE_SERVER_API_VERSION"
local PARSER_MODULE = "titan-compiler.parser"
local CHECKER_MODULE = "titan-compiler.checker"
local TYPES_MODULE = "titan-compiler.types"
local DRIVER_MODULE = "titan-compiler.driver"
local C_PROBE_TRACE_STRING_BYTES = 4096

record BridgeError
  module_name: string
  message: string
end

record SourceFile
  filename: string
  contents: string
end

record ProjectModule
  module_name: string
  files: {SourceFile}
end

record SourceLocation
  filename: string
  line: integer
  column: integer
end

record SourceSpan
  start: SourceLocation
  finish: SourceLocation
end

union DiagnosticKind
  syntax
  type_error
  compiler
end

record Diagnostic
  kind: DiagnosticKind
  message: string
  location: SourceLocation?
  -- The active project root whose compiler attempt produced this diagnostic.
  -- Explicit project-source locations remain the strongest ownership signal;
  -- this preserves attribution for loader/finalization errors without one.
  owner_module: string?
end

record TypeInfo
  tag: string
  display: string
end

-- A named callable keeps its declaration-shaped surface at the dynamic
-- compiler boundary. Function types deliberately omit parameter names, so a
-- flattened TypeInfo cannot reconstruct this text later in hover handling.
record CallableSignature
  display: string
end

-- Hover summaries are normalized while compiler-owned declaration graphs are
-- still available. The semantic index renders and caches these typed values;
-- hover requests never walk the dynamic compiler graph.
union HoverSummaryKind
  module_summary
  record_summary
  union_summary
  interface_summary
end

record HoverSummarySection
  heading: string
  lines: {string}
end

record HoverSummary
  id: integer
  kind: HoverSummaryKind
  title: string
  sections: {HoverSummarySection}
end

record AdjustmentInfo
  kind: string
  operation: string?
  source: TypeInfo?
  target: TypeInfo?
end

union Adjustment
  identity: AdjustmentInfo
  coercion: AdjustmentInfo
  gradual: AdjustmentInfo
  callable: AdjustmentInfo
  written: AdjustmentInfo
  other: AdjustmentInfo
end

union NodeKind
  declaration
  statement
  expression
  variable
  type_syntax
  other
end

record Node
  id: integer
  parent_id: integer?
  tag: string
  kind: NodeKind
  location: SourceLocation?
  source_span: SourceSpan?
  name: string?
  is_local: boolean
  synthetic: boolean
  inferred_type: TypeInfo?
  declared_type: TypeInfo?
  original_type: TypeInfo?
  coerced_type: TypeInfo?
  adjustment: Adjustment?
end

union OccurrenceRole
  definition
  reference
  write
  type_reference
  import_alias
end

union DeclarationVisibility
  block
  module
  exported
end

record SymbolOccurrence
  name: string
  declaration_id: string?
  role: OccurrenceRole
  location: SourceLocation
  exact_span: SourceSpan?
  is_local: boolean
  visibility: DeclarationVisibility
  type_info: TypeInfo?
  callable_signature: CallableSignature?
  summary_id: integer?
end

record Import
  alias: string
  module_name: string
  source_required: boolean
  location: SourceLocation
end

record Manifest
  module_name: string
  serialized: string
  source_serialized: string?
end

record SourceProvenance
  main_file: string
  source_files: {string}
end

record BinaryProvenance
  provider_file: string
end

union Provenance
  project_source: SourceProvenance
  external_source: SourceProvenance
  dynamic_binary: BinaryProvenance
  static_binary: BinaryProvenance
end

record ExternalResolutionRequest
  module_name: string
  source_required: boolean
end

-- A missing/error result deliberately carries no compiler type or AST. This
-- is a pre-analysis topology fingerprint, not another compiler cache.
record ExternalResolution
  module_name: string
  provenance: Provenance?
  error: string?
end

-- A compiled interface can expose a nominal type owned by another logical
-- module without importing or linking that owner independently. This record
-- carries only the physical interface provenance needed by the project cache.
record ContextualResolution
  owner_module: string
  exposer_module: string
  provenance: Provenance
  ordinary_lookup: boolean
  -- Captured by CompilerIO when the compiler selected this provider. Nil means
  -- the provider path was not observed, or repeated lstat calls in this one
  -- incremental analysis disagreed and the result must be treated as
  -- unvalidated by the project service.
  provider_identity: compiler_io.LstatIdentity?
end

-- Every ordinary binary provider selected by any root attempt remains visible
-- until the project service publishes or rejects the complete analysis. This
-- is distinct from final external snapshots: a later source-required attempt
-- may legitimately leave a source snapshot for the same logical module.
record BinaryProviderObservation
  module_name: string
  kind: string
  provider_file: string
  provider_identity: compiler_io.LstatIdentity?
end

union CHeaderDependencyKind
  file
  search
end

-- `file` identities hash the exact bytes cdriver parsed. `search` identities
-- describe one exact include candidate (including a miss) so an earlier
-- shadow appearing later invalidates the owning module without scanning a
-- whole external include tree.
record HeaderObservation
  modified_seconds: integer
  modified_nanoseconds: integer
  physical_identity: string
end

-- One validation pass shares physical observations without exposing compiler
-- tables to project metadata or the SQL cache.
record HeaderValidation
  local const memo: value
end

function header_validation(): HeaderValidation
  local memo: {string: value} = {}
  return HeaderValidation.new(memo)
end

record CHeaderDependency
  kind: CHeaderDependencyKind
  path: string
  identity: string
  observation: HeaderObservation?
end

record ModuleSnapshot
  module_name: string
  provenance: Provenance
  manifest: Manifest?
  nodes: {Node}
  symbols: {SymbolOccurrence}
  imports: {Import}
  c_header_dependencies: {CHeaderDependency}
  hover_summaries: {HoverSummary}?
  -- Binary snapshots carry the exact followed provider object observed while
  -- the compiler selected their interface. Nil is required for source
  -- snapshots and for a binary path whose observations disagreed.
  provider_identity: compiler_io.LstatIdentity?
end

record Analysis
  root_module: string
  diagnostics: {Diagnostic}
  modules: {ModuleSnapshot}
  contextual_resolutions: {ContextualResolution}
  binary_provider_observations: {BinaryProviderObservation}
  -- Logical modules which selected different binary provider kind/path pairs
  -- between root attempts. Source-required and ordinary imports may
  -- legitimately select source and binary simultaneously; that is not a
  -- binary-provider conflict.
  provider_conflicts: {string}
end

-- Progress counts the saved source files in one exact dirty project workset.
-- Compiler-only external modules never enter this total.
record AnalysisProgress
  const completed_files: integer
  const total_files: integer
end

-- These records are the complete language-server view of the compiler's
-- C-probe lifecycle. Keep the dynamic Lua tables at this one boundary: source,
-- argv, diagnostics, commands, and cache paths are intentionally absent.
local record CProbeSemanticTrace
  module_name: string
  key: string
  probe_kind: string
  header_identity: string
  header_label: string
  outcome: string
  cache_tier: string
  repeated: boolean
  publication: string
end

local record CProbeExecutionTrace
  module_name: string
  key: string
  probe_kind: string
  batch_kind: string
  header_identity: string
  header_label: string
  outcome: string
  persistent_lookup: string
  publication: string
  started: boolean
  wall_ms: float?
end

type ProgressListener = (AnalysisProgress) -> ()

-- Only unchanged external source modules use this serialized boundary. Clean
-- project modules retain their complete compiler-owned entries privately in
-- Compiler, while binary interfaces keep their physical provider resolution.
record CachedSourceInterface
  module_name: string
  serialized: string
  source_serialized: string
  main_file: string
  source_files: {string}
  imports: {Import}
  c_header_dependencies: {CHeaderDependency}
end

record ProjectPayload
  const module_name: string
  const payload: string
  const header_inputs: {CHeaderDependency}?
end

type CacheLookup = (string, string) -> (string?, {CHeaderDependency}?)
type CachePublisher = (string, string, string, {CHeaderDependency}) -> ()
type CacheInputRefresher = (string, string, {CHeaderDependency}) -> boolean
type ProjectPayloadReader = (string) -> (string?, {CHeaderDependency}?)
type ProjectSnapshotInstaller = (string, ModuleSnapshot) -> boolean

function Analysis:find_module(module_name: string): ModuleSnapshot?
  for index = 1, #self.modules do
    if self.modules[index].module_name == module_name then
      return self.modules[index]
    end
  end
  return nil
end

local type RequireFunction = (string) -> value
local type TypeOfFunction = (value) -> string
local type CompilerFunction = (...: value) -> (...: value)

record Compiler
  local parser: {string: value}
  local checker: {string: value}
  local types: {string: value}
  local driver: {string: value}
  local type_of: TypeOfFunction
  local embedded_interface_provider: {string: value}
  local embedded_provider_file: string
  local embedded_provider_identity: compiler_io.LstatIdentity
  local io: compiler_io.CompilerIO
  local project_asts: {string: value}
  local project_entries: {string: value}
  local source_path: string?
  local binary_path: string?
  local extra_ffi_include_dirs: {string}
  local extra_ffi_cppflags: {string}
  local cache_adapter: {string: value}?
end

local function fail<T>(module_name: string, message: string): T
  raise BridgeError.new(module_name, message)
end

local function describe(candidate: value, type_of: TypeOfFunction): string
  local kind = type_of(candidate)
  if kind == "nil" then return "nil" end
  return kind
end

local function required_map(candidate: value, module_name: string,
                            subject: string): {string: value}
  if not (candidate is {string: value}) then
    return fail<{string: value}>(
      module_name, subject .. " must be a Lua table")
  end
  return candidate as {string: value}
end

local function required_string(candidate: value, module_name: string,
                               subject: string): string
  if not (candidate is string) then
    return fail<string>(module_name, subject .. " must be a string")
  end
  return candidate as string
end

local function optional_string(candidate: value, module_name: string,
                               subject: string): string?
  if candidate == nil or candidate == false then return nil end
  return required_string(candidate, module_name, subject)
end

local function required_integer(candidate: value, module_name: string,
                                subject: string): integer
  local result: integer = candidate
  return result
catch
  return fail<integer>(module_name,
    subject .. " must carry an exact Lua integer")
end

local function embedded_provider_identity(
    candidate: {string: value}, provider_file: string):
    compiler_io.LstatIdentity
  local path = required_string(
    candidate["path"], DRIVER_MODULE,
    "embedded compiler provider identity.path")
  if path ~= provider_file then
    return fail<compiler_io.LstatIdentity>(
      DRIVER_MODULE,
      "embedded compiler provider identity path '" .. path ..
      "' does not match provider_file '" .. provider_file .. "'")
  end
  local kind = required_string(
    candidate["kind"], DRIVER_MODULE,
    "embedded compiler provider identity.kind")
  if kind ~= "file" then
    return fail<compiler_io.LstatIdentity>(
      DRIVER_MODULE,
      "embedded compiler provider identity kind must be 'file', found '" ..
      kind .. "'")
  end
  return compiler_io.LstatIdentity.new(
    path,
    required_integer(candidate["size"], DRIVER_MODULE,
                     "embedded compiler provider identity.size"),
    kind,
    required_integer(candidate["device"], DRIVER_MODULE,
                     "embedded compiler provider identity.device"),
    required_integer(candidate["inode"], DRIVER_MODULE,
                     "embedded compiler provider identity.inode"),
    required_integer(candidate["modified_seconds"], DRIVER_MODULE,
                     "embedded compiler provider identity.modified_seconds"),
    required_integer(
      candidate["modified_nanoseconds"], DRIVER_MODULE,
      "embedded compiler provider identity.modified_nanoseconds"))
end

local function required_boolean(candidate: value, module_name: string,
                                subject: string): boolean
  local result: boolean = candidate
  return result
catch
  return fail<boolean>(module_name, subject .. " must be a boolean")
end

local function bounded_trace_string(candidate: value, subject: string,
                                    allow_empty: boolean): string
  local result = required_string(candidate, DRIVER_MODULE, subject)
  if (not allow_empty and result == "") or
     #result > C_PROBE_TRACE_STRING_BYTES then
    local expectation = "a nonempty"
    if allow_empty then expectation = "a" end
    return fail<string>(DRIVER_MODULE,
      subject .. " must be " .. expectation .. " string of at most " ..
      C_PROBE_TRACE_STRING_BYTES .. " bytes")
  end
  return result
end

local function probe_trace_outcome(candidate: value,
                                   subject: string): string
  local result = bounded_trace_string(candidate, subject, false)
  if result ~= "success" and result ~= "compiler_rejection" and
     result ~= "infrastructure_failure" then
    return fail<string>(DRIVER_MODULE,
      subject .. " has unsupported value '" .. result .. "'")
  end
  return result
end

local function probe_trace_publication(candidate: value,
                                       subject: string): string
  local result = bounded_trace_string(candidate, subject, false)
  if result ~= "not_applicable" and result ~= "published" and
     result ~= "existing" and result ~= "failed" and
     result ~= "conflict" and result ~= "disabled" and
     result ~= "unstable_diagnostic" and result ~= "too_large" and
     result ~= "diagnostic_not_persisted" and
     result ~= "mixed" then
    return fail<string>(DRIVER_MODULE,
      subject .. " has unsupported value '" .. result .. "'")
  end
  return result
end

local function probe_trace_wall_ms(candidate: value,
                                   subject: string): float?
  if candidate == nil then return nil end
  local result = candidate as float
  if result < 0.0 or result ~= result or result >= math.huge then
    return fail<float?>(DRIVER_MODULE,
      subject .. " must be a finite nonnegative number")
  end
  return result
catch
  if error is BridgeError then raise end
  return fail<float?>(DRIVER_MODULE,
    subject .. " must be a finite nonnegative number")
end

local function normalize_c_probe_semantic_trace(
    candidate: value): CProbeSemanticTrace
  local subject = "compiler C-probe semantic trace"
  local raw = required_map(candidate, DRIVER_MODULE, subject)
  local event = bounded_trace_string(
    raw["event"], subject .. ".event", false)
  if event ~= "semantic_result" then
    return fail<CProbeSemanticTrace>(DRIVER_MODULE,
      subject .. ".event must be 'semantic_result'")
  end
  local key = bounded_trace_string(raw["key"], subject .. ".key", false)
  if #key ~= 64 then
    return fail<CProbeSemanticTrace>(DRIVER_MODULE,
      subject .. ".key must be a 64-byte digest")
  end
  local tier = bounded_trace_string(
    raw["cache_tier"], subject .. ".cache_tier", false)
  if tier ~= "service" and tier ~= "analysis" and
     tier ~= "persistent" and tier ~= "compiler" then
    return fail<CProbeSemanticTrace>(DRIVER_MODULE,
      subject .. ".cache_tier has unsupported value '" .. tier .. "'")
  end
  return CProbeSemanticTrace.new(
    bounded_trace_string(raw["module"], subject .. ".module", true),
    key,
    bounded_trace_string(
      raw["probe_kind"], subject .. ".probe_kind", false),
    bounded_trace_string(
      raw["header_identity"], subject .. ".header_identity", true),
    bounded_trace_string(
      raw["header_label"], subject .. ".header_label", true),
    probe_trace_outcome(raw["outcome"], subject .. ".outcome"),
    tier,
    required_boolean(raw["repeated"], DRIVER_MODULE,
      subject .. ".repeated"),
    probe_trace_publication(
      raw["publication"], subject .. ".publication"))
end

local function normalize_c_probe_execution_trace(
    candidate: value): CProbeExecutionTrace
  local subject = "compiler C-probe execution trace"
  local raw = required_map(candidate, DRIVER_MODULE, subject)
  local event = bounded_trace_string(
    raw["event"], subject .. ".event", false)
  if event ~= "compiler_execution" then
    return fail<CProbeExecutionTrace>(DRIVER_MODULE,
      subject .. ".event must be 'compiler_execution'")
  end
  local key = bounded_trace_string(raw["key"], subject .. ".key", false)
  if #key ~= 64 then
    return fail<CProbeExecutionTrace>(DRIVER_MODULE,
      subject .. ".key must be a 64-byte digest")
  end
  local batch_kind = bounded_trace_string(
    raw["batch_kind"], subject .. ".batch_kind", false)
  if batch_kind ~= "single" and batch_kind ~= "batch" then
    return fail<CProbeExecutionTrace>(DRIVER_MODULE,
      subject .. ".batch_kind has unsupported value '" ..
      batch_kind .. "'")
  end
  local lookup = bounded_trace_string(
    raw["persistent_lookup"], subject .. ".persistent_lookup", false)
  if lookup ~= "not_applicable" and lookup ~= "disabled" and
     lookup ~= "memory" and lookup ~= "hit" and lookup ~= "miss" and
     lookup ~= "invalid" and lookup ~= "io_error" and
     lookup ~= "mixed" then
    return fail<CProbeExecutionTrace>(DRIVER_MODULE,
      subject .. ".persistent_lookup has unsupported value '" ..
      lookup .. "'")
  end
  return CProbeExecutionTrace.new(
    bounded_trace_string(raw["module"], subject .. ".module", true),
    key,
    bounded_trace_string(
      raw["probe_kind"], subject .. ".probe_kind", false),
    batch_kind,
    bounded_trace_string(
      raw["header_identity"], subject .. ".header_identity", true),
    bounded_trace_string(
      raw["header_label"], subject .. ".header_label", true),
    probe_trace_outcome(raw["outcome"], subject .. ".outcome"),
    lookup,
    probe_trace_publication(
      raw["publication"], subject .. ".publication"),
    required_boolean(raw["started"], DRIVER_MODULE,
      subject .. ".started"),
    probe_trace_wall_ms(raw["wall_ms"], subject .. ".wall_ms"))
end

local function emit_c_probe_semantic_trace(root_module: string,
                                           candidate: value)
  local trace = normalize_c_probe_semantic_trace(candidate)
  logging.emit("trace", "compiler.c_probe.semantic", {
    ["root_module"] = root_module,
    ["module_name"] = trace.module_name,
    ["key"] = trace.key,
    ["probe_kind"] = trace.probe_kind,
    ["header_identity"] = trace.header_identity,
    ["header_label"] = trace.header_label,
    ["outcome"] = trace.outcome,
    ["cache_tier"] = trace.cache_tier,
    ["repeated"] = trace.repeated,
    ["publication"] = trace.publication,
  })
end

local function emit_c_probe_execution_trace(root_module: string,
                                            candidate: value)
  local trace = normalize_c_probe_execution_trace(candidate)
  local fields: wire.Object = {
    ["root_module"] = root_module,
    ["module_name"] = trace.module_name,
    ["key"] = trace.key,
    ["probe_kind"] = trace.probe_kind,
    ["batch_kind"] = trace.batch_kind,
    ["header_identity"] = trace.header_identity,
    ["header_label"] = trace.header_label,
    ["outcome"] = trace.outcome,
    ["persistent_lookup"] = trace.persistent_lookup,
    ["publication"] = trace.publication,
    ["started"] = trace.started,
  }
  if trace.wall_ms ~= nil then
    fields["wall_ms"] = trace.wall_ms as float
  end
  logging.emit("trace", "compiler.c_probe.execution", fields)
end

local function required_string_list(candidate: value, module_name: string,
                                    subject: string): {string}
  if not (candidate is {integer: value}) then
    return fail<{string}>(module_name, subject .. " must be a Lua array")
  end
  local raw = candidate as {integer: value}
  local result: {string} = {}
  for index = 1, #raw do
    result[index] = required_string(
      raw[index], module_name, subject .. "[" .. index .. "]")
  end
  return result
end

local function normalize_c_header_dependencies(
    candidate: value, subject: string): {CHeaderDependency}
  if candidate == nil or candidate == false then return {} end
  if not (candidate is {integer: value}) then
    return fail<{CHeaderDependency}>(
      DRIVER_MODULE, subject .. " must be a Lua array")
  end
  local raw = candidate as {integer: value}
  local result: {CHeaderDependency} = {}
  local seen: {string: boolean} = {}
  for index = 1, #raw do
    local item = required_map(
      raw[index], DRIVER_MODULE, subject .. "[" .. index .. "]")
    local raw_kind = required_string(
      item["kind"], DRIVER_MODULE,
      subject .. "[" .. index .. "].kind")
    local kind = CHeaderDependencyKind.file()
    if raw_kind == "search" then
      kind = CHeaderDependencyKind.search()
    elseif raw_kind ~= "file" then
      return fail<{CHeaderDependency}>(DRIVER_MODULE,
        subject .. "[" .. index .. "] has unknown kind '" ..
        raw_kind .. "'")
    end
    local path = required_string(
      item["path"], DRIVER_MODULE,
      subject .. "[" .. index .. "].path")
    local identity = required_string(
      item["identity"], DRIVER_MODULE,
      subject .. "[" .. index .. "].identity")
    if strings.sub(path, 1, 1) ~= "/" then
      return fail<{CHeaderDependency}>(DRIVER_MODULE,
        subject .. "[" .. index .. "].path must be absolute")
    elseif identity == "" then
      return fail<{CHeaderDependency}>(DRIVER_MODULE,
        subject .. "[" .. index .. "].identity must be nonempty")
    end
    local key = raw_kind .. "\0" .. path
    if seen[key] then
      return fail<{CHeaderDependency}>(DRIVER_MODULE,
        subject .. " repeats " .. raw_kind .. " input '" .. path .. "'")
    end
    seen[key] = true
    local observation: HeaderObservation? = nil
    local raw_observation: value = item["observation"]
    if raw_observation ~= nil then
      local observed = required_map(raw_observation,DRIVER_MODULE,
        subject .. "[" .. index .. "].observation")
      local seconds = required_integer(observed["modified_seconds"],DRIVER_MODULE,
        subject .. " observation.modified_seconds")
      local nanoseconds = required_integer(observed["modified_nanoseconds"],DRIVER_MODULE,
        subject .. " observation.modified_nanoseconds")
      local physical = required_string(observed["physical_identity"],DRIVER_MODULE,
        subject .. " observation.physical_identity")
      if nanoseconds < 0 or nanoseconds >= 1000000000 or physical == "" then
        return fail<{CHeaderDependency}>(DRIVER_MODULE,
          subject .. " has an invalid header observation")
      end
      observation = HeaderObservation.new(seconds,nanoseconds,physical)
    end
    result[index] = CHeaderDependency.new(kind, path, identity, observation)
  end
  return result
end

local function raw_c_header_dependencies(
    dependencies: {CHeaderDependency}): {integer: value}
  local result: {integer: value} = {}
  for index = 1, #dependencies do
    local dependency = dependencies[index]
    local kind = "file"
    case dependency.kind
    when search then kind = "search"
    when file then
    end
    local item: {string: value} = {}
    item["kind"] = kind
    item["path"] = dependency.path
    item["identity"] = dependency.identity
    local observation? = dependency.observation
    if observation ~= nil then
      local observed: {string: value} = {
        ["modified_seconds"] = observation.modified_seconds,
        ["modified_nanoseconds"] = observation.modified_nanoseconds,
        ["physical_identity"] = observation.physical_identity,
      }
      item["observation"] = observed
    end
    result[index] = item
  end
  return result
end

local function optional_boolean(candidate: value, module_name: string,
                                subject: string): boolean
  if candidate == nil or candidate == false then return false end
  local result: boolean = candidate
  return result
catch
  return fail<boolean>(module_name, subject .. " must be a boolean")
end

local function checked_function(module: {string: value},
                                module_name: string, member: string,
                                type_of: TypeOfFunction): value
  local candidate: value = module[member]
  if type_of(candidate) ~= "function" then
    return fail<value>(module_name,
      "compiler API member '" .. member .. "' must be a function, found " ..
      describe(candidate, type_of) ..
      ". Install a Titan compiler implementing " ..
      COMPILER_LANGUAGE_SERVER_API_MARKER .. " " ..
      COMPILER_LANGUAGE_SERVER_API)
  end
  return candidate
end

local function require_compiler_module(require_function: RequireFunction,
                                       type_of: TypeOfFunction,
                                       module_name: string): {string: value}
  local loaded: value = nil
  do
    loaded = require_function(module_name)
  catch
    return fail<{string: value}>(module_name,
      "cannot load compiler module through package.path/package.cpath: " ..
      strings.tostring(error))
  end
  if type_of(loaded) ~= "table" then
    return fail<{string: value}>(module_name,
      "compiler module must return a table, found " ..
      describe(loaded, type_of))
  end
  return required_map(loaded, module_name, "compiler module")
end

local function make_type_of(): TypeOfFunction
  local chunk = lua.load("return type", "=compiler_bridge.type", nil)
  local candidate: value = chunk()
  return candidate as TypeOfFunction
end

local function emit_cache_stats(compiler: Compiler)
  if not logging.enabled("debug") then return end
  local query = checked_function(compiler.driver,DRIVER_MODULE,
    "compiler_cache_stats",compiler.type_of) as (value) -> value
  local context: {string: value} = {["io"] = compiler.io}
  local options: {string: value} = {["context"] = context}
  local statistics = required_map(query(options),DRIVER_MODULE,"compiler cache statistics")
  local headers = required_map(statistics["headers"],DRIVER_MODULE,"header cache statistics")
  local conversion = required_map(statistics["conversion"],DRIVER_MODULE,"FFI cache statistics")
  logging.emit("debug","compiler.cache.stats",{
    ["header_lookups"] = headers["lookups"] as integer,
    ["header_hits"] = headers["hits"] as integer,
    ["header_misses"] = headers["misses"] as integer,
    ["header_file_reads"] = headers["file_reads"] as integer,
    ["header_file_hashes"] = headers["file_hashes"] as integer,
    ["header_metadata_reuses"] = headers["metadata_reuses"] as integer,
    ["header_search_checks"] = headers["search_checks"] as integer,
    ["header_memo_reuses"] = headers["memo_reuses"] as integer,
    ["conversion_lookups"] = conversion["lookups"] as integer,
    ["conversion_hits"] = conversion["hits"] as integer,
    ["conversion_misses"] = conversion["misses"] as integer,
  })
end

function Compiler:log_cache_stats()
  local permit = compiler_scheduler.acquire()
  defer permit:release()
  emit_cache_stats(self)
end

local function load_with(require_function: RequireFunction,
                         embedded_interface_provider: {string: value},
                         embedded_identity: compiler_io.LstatIdentity): Compiler
  local type_of = make_type_of()
  local parser = require_compiler_module(
    require_function, type_of, PARSER_MODULE)
  local checker = require_compiler_module(
    require_function, type_of, CHECKER_MODULE)
  local types = require_compiler_module(
    require_function, type_of, TYPES_MODULE)
  local driver = require_compiler_module(
    require_function, type_of, DRIVER_MODULE)

  local version = required_string(
    driver["TITAN_ABI_VERSION"], DRIVER_MODULE, "TITAN_ABI_VERSION")
  if version ~= COMPILER_ABI then
    return fail<Compiler>(DRIVER_MODULE,
      "incompatible Titan compiler ABI " .. version ..
      "; this server requires " .. COMPILER_ABI)
  end

  local raw_language_server_api: value =
    driver[COMPILER_LANGUAGE_SERVER_API_MARKER]
  if raw_language_server_api == nil then
    return fail<Compiler>(DRIVER_MODULE,
      "Titan compiler ABI " .. version .. " is missing " ..
      COMPILER_LANGUAGE_SERVER_API_MARKER ..
      "; matching Titan ABI alone is insufficient. Install the Titan " ..
      "compiler built for this vscode-titan server (language-server API " ..
      COMPILER_LANGUAGE_SERVER_API .. ")")
  end
  local language_server_api: integer = 0
  do
    language_server_api = raw_language_server_api
  catch
    return fail<Compiler>(DRIVER_MODULE,
      "incompatible Titan language-server API " ..
      describe(raw_language_server_api, type_of) .. " for compiler ABI " ..
      version .. "; this server requires " ..
      COMPILER_LANGUAGE_SERVER_API_MARKER .. " " ..
      COMPILER_LANGUAGE_SERVER_API ..
      ". Install the matching Titan compiler; matching Titan ABI alone " ..
      "is insufficient")
  end
  if language_server_api ~= COMPILER_LANGUAGE_SERVER_API then
    return fail<Compiler>(DRIVER_MODULE,
      "incompatible Titan language-server API " .. language_server_api ..
      " for compiler ABI " .. version .. "; this server requires " ..
      COMPILER_LANGUAGE_SERVER_API_MARKER .. " " ..
      COMPILER_LANGUAGE_SERVER_API ..
      ". Install the matching Titan compiler; matching Titan ABI alone " ..
      "is insufficient")
  end

  checked_function(parser, PARSER_MODULE, "parse", type_of)
  checked_function(parser, PARSER_MODULE, "error_to_string", type_of)
  checked_function(checker, CHECKER_MODULE, "check", type_of)
  checked_function(types, TYPES_MODULE, "tostring", type_of)
  checked_function(types, TYPES_MODULE, "serialize", type_of)
  checked_function(driver, DRIVER_MODULE, "defaultloader", type_of)
  checked_function(
    driver, DRIVER_MODULE, "new_c_header_analysis", type_of)
  checked_function(driver, DRIVER_MODULE, "new_resolver_context", type_of)
  checked_function(driver, DRIVER_MODULE, "finalize_resolver_context", type_of)
  checked_function(driver, DRIVER_MODULE, "close_resolver_context", type_of)
  checked_function(driver, DRIVER_MODULE, "close_loader", type_of)
  checked_function(driver, DRIVER_MODULE, "resolve_external_modules", type_of)
  checked_function(
    driver, DRIVER_MODULE, "restat_c_header_dependencies", type_of)
  checked_function(driver, DRIVER_MODULE, "split_shell_words", type_of)
  checked_function(driver, DRIVER_MODULE, "encode_project_entry", type_of)
  checked_function(driver, DRIVER_MODULE, "decode_project_entry", type_of)
  checked_function(driver, DRIVER_MODULE, "project_entries_registry", type_of)
  checked_function(driver, DRIVER_MODULE, "language_server_cache_identity", type_of)
  checked_function(driver, DRIVER_MODULE, "compiler_cache_stats", type_of)
  required_map(driver["imported"], DRIVER_MODULE, "driver.imported")
  required_map(types["registry"], TYPES_MODULE, "types.registry")

  local embedded_provider_file = required_string(
    embedded_interface_provider["provider_file"], DRIVER_MODULE,
    "embedded_interface_provider.provider_file")
  return Compiler.new(
    parser, checker, types, driver, type_of, embedded_interface_provider,
    embedded_provider_file, embedded_identity, compiler_io.create(),
    {}, {}, nil, nil, {}, {}, nil)
end

function load(): Compiler
  local provider: {string: value} = {}
  local raw_identity: {string: value} = {}
  do
    provider, raw_identity = embedded_interfaces.provider()
  catch
    raise BridgeError.new(
      DRIVER_MODULE,
      "cannot load embedded Titan compiler interfaces: " ..
      strings.tostring(error))
  end
  local provider_file = required_string(
    provider["provider_file"], DRIVER_MODULE,
    "embedded_interface_provider.provider_file")
  return load_with(
    lua.require, provider,
    embedded_provider_identity(raw_identity, provider_file))
end

function Compiler:compiler_abi(): string
  return COMPILER_ABI
end

function Compiler:has_project_ast(module_name: string): boolean
  return self.project_asts[module_name] ~= nil
end

function Compiler:drop_project_ast(module_name: string)
  self.project_asts[module_name] = nil
  self.project_entries[module_name] = nil
end

function Compiler:configure_paths(source_path: string?, binary_path: string?,
                                  extra_ffi_include_dirs: {string}?,
                                  extra_ffi_cppflags: string?)
  local next_include_dirs: {string} = {}
  if extra_ffi_include_dirs ~= nil then
    local source = extra_ffi_include_dirs as {string}
    for index = 1, #source do
      next_include_dirs[index] = source[index]
    end
  end

  local next_cppflags: {string} = {}
  if extra_ffi_cppflags ~= nil and extra_ffi_cppflags ~= "" then
    local raw_split = checked_function(
      self.driver, DRIVER_MODULE, "split_shell_words", self.type_of)
    local split = raw_split as (string) -> (value, value)
    local parsed, parse_error = split(extra_ffi_cppflags as string)
    if parsed == nil or parsed == false then
      return fail<value>(
        DRIVER_MODULE, "invalid extra_ffi_cppflags: " ..
          strings.tostring(parse_error))
    end
    next_cppflags = required_string_list(
      parsed, DRIVER_MODULE, "split extra_ffi_cppflags result")
  end

  -- Commit only after every untyped compiler value has been validated. A
  -- malformed reconfiguration leaves the last accepted project configuration
  -- intact rather than combining new paths with old preprocessing flags.
  self.source_path = source_path
  self.binary_path = binary_path
  self.extra_ffi_include_dirs = next_include_dirs
  self.extra_ffi_cppflags = next_cppflags
end

-- The driver parses inherited TITAN_EXTRA_CPPFLAGS once. Project flags use
-- that same parser, then extend a private copy only while this Compiler owns
-- the shared Lua state. Restoring the exact table before releasing the permit
-- prevents one yielding workspace analysis from reconfiguring another.
local function install_extra_cppflags(compiler: Compiler): value
  local previous: value = compiler.driver["EXTRA_CPPFLAGS"]
  local effective: {integer: value} = {}
  if previous ~= nil and previous ~= false then
    local inherited = required_string_list(
      previous, DRIVER_MODULE, "driver.EXTRA_CPPFLAGS")
    for index = 1, #inherited do
      effective[#effective + 1] = inherited[index]
    end
  elseif #compiler.extra_ffi_cppflags == 0 then
    return previous
  end
  for index = 1, #compiler.extra_ffi_cppflags do
    effective[#effective + 1] = compiler.extra_ffi_cppflags[index]
  end
  compiler.driver["EXTRA_CPPFLAGS"] = effective
  return previous
end

local function new_context(compiler: Compiler,
                           supplied: {string: value}?): value
  local raw_new_context = checked_function(
    compiler.driver, DRIVER_MODULE, "new_resolver_context", compiler.type_of)
  local create = raw_new_context as (value) -> value
  local options: {string: value} = {}
  if supplied ~= nil then options = supplied as {string: value} end
  options["io"] = compiler.io
  options["embedded_interface_provider"] =
    compiler.embedded_interface_provider
  if compiler.cache_adapter ~= nil then
    options["cache_adapter"] = compiler.cache_adapter
  end
  local context: value = create(options)
  if compiler.type_of(context) ~= "table" then
    return fail<value>(DRIVER_MODULE,
      "driver.new_resolver_context returned " ..
      describe(context, compiler.type_of) .. " instead of a table")
  end
  return context
end

local function close_loader_now(compiler: Compiler, loader: value)
  local raw_close = checked_function(
    compiler.driver, DRIVER_MODULE, "close_loader", compiler.type_of)
  local close = raw_close as (value) -> (value, value)
  local ok, close_error = close(loader)
  if not ok then
    fail<value>(DRIVER_MODULE,
      "cannot close compiler resolver: " .. strings.tostring(close_error))
  end
end

local function close_context_now(compiler: Compiler, context: value)
  local raw_close = checked_function(
    compiler.driver, DRIVER_MODULE, "close_resolver_context", compiler.type_of)
  local close = raw_close as (value) -> (value, value)
  local ok, close_error = close(context)
  if not ok then
    fail<value>(DRIVER_MODULE,
      "cannot close compiler resolver context: " ..
      strings.tostring(close_error))
  end
end

local function close_loader(compiler: Compiler, loader: value)
  do
    close_loader_now(compiler, loader)
  catch
    if error is async.CancellationReason then
      -- Cleanup I/O cannot be submitted by a Task with sticky cancellation.
      -- Retain the Lua object in a fresh Task and wait for the current owner to
      -- release the shared compiler permit before retrying the close.
      async.run<nil, value>(function (): nil
        local permit = compiler_scheduler.acquire()
        defer permit:release()
        close_loader_now(compiler, loader)
        return nil
      end)
    end
    raise
  end
end

local function close_context(compiler: Compiler, context: value)
  do
    close_context_now(compiler, context)
  catch
    if error is async.CancellationReason then
      async.run<nil, value>(function (): nil
        local permit = compiler_scheduler.acquire()
        defer permit:release()
        close_context_now(compiler, context)
        return nil
      end)
    end
    raise
  end
end

-- Recompute only the exact physical header bytes and ordered search candidates
-- already reported by the compiler. The operation owns the global compiler
-- permit but its Titan-backed I/O may suspend the current Task.
function Compiler:restat_c_header_dependencies(
    dependencies: {CHeaderDependency}, validation: HeaderValidation?):
    ({CHeaderDependency}, boolean)
  if #dependencies == 0 then return {},false end
  local permit = compiler_scheduler.acquire()
  defer permit:release()
  local context = new_context(self, nil)
  defer close_context(self, context)
  local raw_restat = checked_function(
    self.driver, DRIVER_MODULE, "restat_c_header_dependencies", self.type_of)
  local restat = raw_restat as (value, value) -> (value, value, value)
  if validation == nil then validation = header_validation() end
  local options: {string: value} = {
    ["context"] = context, ["header_validation"] = validation.memo,
  }
  local raw_result, raw_error, raw_changed = restat(
    raw_c_header_dependencies(dependencies), options)
  if raw_result == nil or raw_result == false then
    return fail<{CHeaderDependency}>(DRIVER_MODULE,
      "cannot restat C header dependencies: " ..
      strings.tostring(raw_error)), false
  end
  local changed: boolean = raw_changed
  return normalize_c_header_dependencies(
    raw_result, "driver.restat_c_header_dependencies result"), changed
catch
  if error is async.CancellationReason then raise end
  if error is BridgeError then raise end
  raise BridgeError.new(DRIVER_MODULE,
    "C header dependency restat failed: " .. strings.tostring(error))
end

-- Re-resolve known external import names under the currently configured paths
-- without parsing source. The compiler driver returns only physical
-- provenance; normalize it here so untyped Lua tables do not escape into the
-- project service.
function Compiler:resolve_external_modules(
    project_modules: {string},
    requests: {ExternalResolutionRequest}): {ExternalResolution}
  local permit = compiler_scheduler.acquire()
  defer permit:release()
  local context = new_context(self, nil)
  defer close_context(self, context)

  local previous_source_path: value = self.driver["TITAN_SOURCE_PATH"]
  local previous_binary_path: value = self.driver["TITAN_BIN_PATH"]
  defer self.driver["TITAN_SOURCE_PATH"] = previous_source_path
  defer self.driver["TITAN_BIN_PATH"] = previous_binary_path
  if self.source_path then
    self.driver["TITAN_SOURCE_PATH"] = self.source_path as string
  end
  if self.binary_path then
    self.driver["TITAN_BIN_PATH"] = self.binary_path as string
  end

  local raw_projects: {string: value} = {}
  for index = 1, #project_modules do
    local name = project_modules[index]
    if raw_projects[name] ~= nil then
      return fail<{ExternalResolution}>(
        DRIVER_MODULE, "duplicate project module '" .. name ..
        "' in external resolution request")
    end
    raw_projects[name] = true
  end
  local raw_requests: {string: value} = {}
  local requested: {string: boolean} = {}
  for index = 1, #requests do
    local request = requests[index]
    if requested[request.module_name] then
      return fail<{ExternalResolution}>(
        DRIVER_MODULE, "duplicate external module '" ..
        request.module_name .. "' in resolution request")
    end
    requested[request.module_name] = true
    raw_requests[request.module_name] = request.source_required
  end

  local raw_resolver = checked_function(
    self.driver, DRIVER_MODULE, "resolve_external_modules", self.type_of)
  local resolver = raw_resolver as (value, value, value) -> value
  local options: {string: value} = { ["context"] = context }
  local raw_results = required_map(
    resolver(raw_requests, raw_projects, options), DRIVER_MODULE,
    "driver.resolve_external_modules result")
  for name in iteration.pairs<string, value>(raw_results) do
    if not requested[name] then
      return fail<{ExternalResolution}>(DRIVER_MODULE,
        "driver.resolve_external_modules returned unexpected module '" ..
        name .. "'")
    end
  end

  local result: {ExternalResolution} = {}
  for index = 1, #requests do
    local request = requests[index]
    local subject = "external resolution for '" ..
      request.module_name .. "'"
    local raw = required_map(
      raw_results[request.module_name], DRIVER_MODULE, subject)
    local kind = required_string(raw["kind"], DRIVER_MODULE,
                                 subject .. ".kind")
    local provenance?: Provenance = nil
    local message?: string = nil
    if kind == "source" then
      provenance = Provenance.external_source(SourceProvenance.new(
        required_string(raw["main_file"], DRIVER_MODULE,
                        subject .. ".main_file"),
        required_string_list(raw["source_files"], DRIVER_MODULE,
                             subject .. ".source_files")))
    elseif kind == "dynamic" then
      provenance = Provenance.dynamic_binary(BinaryProvenance.new(
        required_string(raw["provider_file"], DRIVER_MODULE,
                        subject .. ".provider_file")))
    elseif kind == "static" or kind == "embedded" then
      provenance = Provenance.static_binary(BinaryProvenance.new(
        required_string(raw["provider_file"], DRIVER_MODULE,
                        subject .. ".provider_file")))
    elseif kind == "error" then
      message = required_string(raw["message"], DRIVER_MODULE,
                                subject .. ".message")
    elseif kind ~= "missing" then
      return fail<{ExternalResolution}>(DRIVER_MODULE,
        subject .. " has unknown kind '" .. kind .. "'")
    end
    result[index] = ExternalResolution.new(
      request.module_name, provenance, message)
  end
  return result
catch
  if error is async.CancellationReason then raise end
  if error is BridgeError then raise end
  raise BridgeError.new(DRIVER_MODULE,
    "external module resolution failed: " .. strings.tostring(error))
end

local function raw_location(candidate: value, subject: string): SourceLocation
  local loc = required_map(candidate, DRIVER_MODULE, subject)
  local filename = required_string(
    loc["filename"], DRIVER_MODULE, subject .. ".filename")
  local line = required_integer(
    loc["line"], DRIVER_MODULE, subject .. ".line")
  local column = required_integer(
    loc["col"], DRIVER_MODULE, subject .. ".col")
  if line < 1 or column < 1 then
    return fail<SourceLocation>(
      DRIVER_MODULE, subject .. " must use positive line and column values")
  end
  return SourceLocation.new(filename, line, column)
end

local function optional_location(node: {string: value},
                                 subject: string): SourceLocation?
  local candidate: value = node["loc"]
  if candidate == nil or candidate == false then return nil end
  return raw_location(candidate, subject .. ".loc")
end

local function optional_field_location(node: {string: value}, field: string,
                                       subject: string): SourceLocation?
  local candidate: value = node[field]
  if candidate == nil or candidate == false then return nil end
  return raw_location(candidate, subject .. "." .. field)
end

local function semantic_location(node: {string: value},
                                 subject: string): SourceLocation?
  local exact? = optional_field_location(node, "_name_loc", subject)
  if exact ~= nil then return exact end
  return optional_location(node, subject)
end

-- `_end_loc` is the start of the closing `end`/`until`. `_structure_loc`
-- exists only for an explicit `do ... end` StatBlock; all other parser-marked
-- structures begin at their ordinary diagnostic location.
local function structural_span(node: {string: value},
                               subject: string): SourceSpan?
  local finish? = optional_field_location(node, "_end_loc", subject)
  if finish == nil then return nil end
  local start? = optional_field_location(node, "_structure_loc", subject)
  if start == nil then start = optional_location(node, subject) end
  if start == nil then
    return fail<SourceSpan>(DRIVER_MODULE,
      subject .. " has _end_loc without a structural start")
  end
  if start.filename ~= finish.filename then
    return fail<SourceSpan>(DRIVER_MODULE,
      subject .. " structural span crosses source files")
  end
  if finish.line < start.line or
     (finish.line == start.line and finish.column < start.column) then
    return fail<SourceSpan>(DRIVER_MODULE,
      subject .. " structural span finishes before it starts")
  end
  return SourceSpan.new(start, finish)
end

local function exact_name_span(location: SourceLocation,
                               name: string): SourceSpan
  return SourceSpan.new(
    location,
    SourceLocation.new(location.filename, location.line,
                       location.column + #name))
end

local function type_tag(candidate: value, subject: string): string
  local raw = required_map(candidate, TYPES_MODULE, subject)
  local tag = required_string(raw["_tag"], TYPES_MODULE, subject .. "._tag")
  if strings.sub(tag, 1, 5) ~= "Type." then
    return fail<string>(TYPES_MODULE,
      subject .. " has invalid type tag '" .. tag .. "'")
  end
  return tag
end

local function render_type(compiler: Compiler, candidate: value,
                           subject: string): TypeInfo
  local raw = required_map(candidate, TYPES_MODULE, subject)
  local tag = type_tag(candidate, subject)
  local display = ""
  if tag == "Type.Module" then
    display = "module " .. required_string(
      raw["name"], TYPES_MODULE, subject .. ".name")
  elseif tag == "Type.ModuleMember" or tag == "Type.ModuleVariable"
      or tag == "Type.Field" then
    local nested: value = raw["type"]
    if nested == nil then
      return fail<TypeInfo>(TYPES_MODULE,
        subject .. " has no nested member type")
    end
    display = render_type(compiler, nested, subject .. ".type").display
  else
    local raw_renderer = checked_function(
      compiler.types, TYPES_MODULE, "tostring", compiler.type_of)
    local renderer = raw_renderer as (value) -> value
    local rendered: value = nil
    do
      rendered = renderer(candidate)
    catch
      return fail<TypeInfo>(TYPES_MODULE,
        "cannot render " .. subject .. ": " .. strings.tostring(error))
    end
    display = required_string(
      rendered, TYPES_MODULE, "types.tostring result for " .. subject)
  end
  return TypeInfo.new(tag, display)
end

local function optional_type(compiler: Compiler, node: {string: value},
                             field: string, subject: string): TypeInfo?
  local candidate: value = node[field]
  if candidate == nil or candidate == false then return nil end
  return render_type(compiler, candidate, subject .. "." .. field)
end

local function required_value_list(candidate: value, subject: string):
    {integer: value}
  if not (candidate is {integer: value}) then
    return fail<{integer: value}>(
      TYPES_MODULE, subject .. " must be a Lua array")
  end
  return candidate as {integer: value}
end

local function optional_name_list(candidate: value, subject: string):
    {string}?
  if candidate == nil or candidate == false then return nil end
  return required_string_list(candidate, TYPES_MODULE, subject)
end

local function write_type_parameters(
    compiler: Compiler, output: strings.StringWriter, candidate: value,
    subject: string)
  if candidate == nil or candidate == false then return end
  local parameters = required_value_list(candidate, subject)
  if #parameters == 0 then return end
  output:write("<")
  for index = 1, #parameters do
    if index > 1 then output:write(", ") end
    output:write(render_type(
      compiler, parameters[index], subject .. "[" .. index .. "]").display)
  end
  output:write(">")
end

local function write_callable_results(
    compiler: Compiler, output: strings.StringWriter,
    results: {integer: value}, flexible: value, subject: string)
  output:write(": ")
  local parenthesized = #results ~= 1 or
    (flexible ~= nil and flexible ~= false)
  if parenthesized then output:write("(") end
  for index = 1, #results do
    if index > 1 then output:write(", ") end
    output:write(render_type(
      compiler, results[index], subject .. ".rettypes[" .. index .. "]").display)
  end
  if flexible ~= nil and flexible ~= false then
    if #results > 0 then output:write(", ") end
    output:write("...: ")
    output:write(render_type(
      compiler, flexible, subject .. ".flexrettype").display)
  end
  if parenthesized then output:write(")") end
end

local function render_callable_type(
    compiler: Compiler, candidate: value, owner: string,
    separator: string, name: string, supplied_names: value,
    subject: string, display_owner: string?): CallableSignature?
  local raw = required_map(candidate, TYPES_MODULE, subject)
  local tag = required_string(raw["_tag"], TYPES_MODULE, subject .. "._tag")
  local type_parameters: value = raw["typeparams"]
  if tag == "Type.FunctionScheme" then
    candidate = raw["signature"]
    raw = required_map(candidate, TYPES_MODULE, subject .. ".signature")
    tag = required_string(
      raw["_tag"], TYPES_MODULE, subject .. ".signature._tag")
  elseif tag == "Type.Method" or tag == "Type.StaticMethod" then
    owner = required_string(raw["fqtn"], TYPES_MODULE, subject .. ".fqtn")
    separator = tag == "Type.Method" and ":" or "."
    name = required_string(raw["name"], TYPES_MODULE, subject .. ".name")
    supplied_names = raw["paramnames"]
  end
  if display_owner ~= nil then owner = display_owner end
  local c_function = tag == "Type.CFunction"
  if tag ~= "Type.Function" and tag ~= "Type.Method"
      and tag ~= "Type.StaticMethod" and not c_function then
    return nil
  end

  local parameters = required_value_list(
    raw["params"], subject .. ".params")
  local results: {integer: value} = {}
  if not c_function then
    results = required_value_list(
      raw["rettypes"], subject .. ".rettypes")
  end
  local names? = optional_name_list(
    supplied_names, subject .. ".paramnames")
  if names ~= nil and #names ~= #parameters then
    return fail<CallableSignature>(
      TYPES_MODULE, subject .. ".paramnames must match params")
  end

  local output = strings.writer()
  output:write(owner)
  output:write(separator)
  output:write(name)
  write_type_parameters(
    compiler, output, type_parameters, subject .. ".typeparams")
  output:write("(")
  for index = 1, #parameters do
    if index > 1 then output:write(", ") end
    if names ~= nil then
      output:write(names[index])
      output:write(": ")
    end
    output:write(render_type(
      compiler, parameters[index],
      subject .. ".params[" .. index .. "]").display)
  end
  local variable: value = raw["varargtype"]
  if c_function and optional_boolean(
      raw["vararg"], TYPES_MODULE, subject .. ".vararg") then
    if #parameters > 0 then output:write(", ") end
    output:write("...")
  elseif variable ~= nil and variable ~= false then
    if #parameters > 0 then output:write(", ") end
    output:write("...: ")
    output:write(render_type(
      compiler, variable, subject .. ".varargtype").display)
  end
  output:write(")")
  if c_function then
    local result: value = raw["ret"]
    output:write(": ")
    if type_tag(result, subject .. ".ret") == "Type.CVoid" then
      output:write("()")
    else
      output:write(render_type(
        compiler, result, subject .. ".ret").display)
    end
  else
    write_callable_results(
      compiler, output, results, raw["flexrettype"], subject)
  end
  return CallableSignature.new(output:drain())
end

local function written_module_alias(candidate: value): string?
  if not (candidate is {string: value}) then return nil end
  local node = candidate as {string: value}
  if node["_tag"] ~= "Ast.VarDot" then return nil end
  local expression: value = node["exp"]
  if not (expression is {string: value}) then return nil end
  local exp = expression as {string: value}
  if exp["_tag"] ~= "Ast.ExpVar" then return nil end
  local variable: value = exp["var"]
  if not (variable is {string: value}) then return nil end
  local var = variable as {string: value}
  if var["_tag"] ~= "Ast.VarName" or not (var["name"] is string) then
    return nil
  end
  return var["name"] as string
end

local function callable_signature(
    compiler: Compiler, module_name: string, candidate: value,
    source_node: value, subject: string): CallableSignature?
  if candidate == nil or candidate == false then return nil end
  local raw = required_map(candidate, DRIVER_MODULE, subject)
  local tag = required_string(raw["_tag"], DRIVER_MODULE, subject .. "._tag")
  if tag == "Ast.TopLevelFunc" or tag == "Ast.TopLevelForeignFunc" then
    local declared: value = raw["_declared_type"]
    local field = "._declared_type"
    if declared == nil or declared == false then
      declared = raw["_type"]
      field = "._type"
    end
    return render_callable_type(
      compiler, declared, module_name, ".",
      required_string(raw["name"], DRIVER_MODULE, subject .. ".name"),
      raw["_paramnames"], subject .. field, nil)
  elseif tag == "Ast.TopLevelMethod" or tag == "Ast.TopLevelStatic"
      or tag == "Ast.InterfaceMethod" then
    local declared: value = raw["_declared_type"]
    local field = "._declared_type"
    if declared == nil or declared == false then
      declared = raw["_type"]
      field = "._type"
    end
    return render_callable_type(
      compiler, declared, module_name, ".", "", nil,
      subject .. field, nil)
  elseif tag == "Type.ModuleMember" then
    local owner = required_string(
      raw["modname"], TYPES_MODULE, subject .. ".modname")
    local member_type = required_map(
      raw["type"], TYPES_MODULE, subject .. ".type")
    if member_type["_tag"] == "Type.CFunction" and
       raw["_foreign_source"] ~= true then
      local alias? = written_module_alias(source_node)
      if alias ~= nil then owner = alias end
    end
    return render_callable_type(
      compiler, member_type, owner,
      ".", required_string(
        raw["name"], TYPES_MODULE, subject .. ".name"),
      raw["paramnames"], subject .. ".type", nil)
  elseif tag == "Type.Method" or tag == "Type.StaticMethod" then
    return render_callable_type(
      compiler, candidate, module_name, ".", "", nil, subject, nil)
  end
  return nil
end

local record PendingSummaryLine
  rank: integer
  name: string
  display: string
end

-- Compiler graph normalization runs after the Lua compiler has published a
-- checked module. Share one deterministic operation budget across every
-- snapshot in that attempt so many individually small modules cannot starve
-- protocol Tasks any more than one large aggregate can.
local NORMALIZATION_YIELD_CADENCE = 1024

local record NormalizationWork
  pending: integer
end

local function NormalizationWork:account()
  self.pending = self.pending + 1
  if self.pending < NORMALIZATION_YIELD_CADENCE then return end
  self.pending = 0
  async.yield()
end

local function summary_line_less(left: PendingSummaryLine,
                                 right: PendingSummaryLine): boolean
  if left.rank ~= right.rank then return left.rank < right.rank end
  if left.name ~= right.name then return left.name < right.name end
  return left.display < right.display
end

-- Summaries can contain every member of a large module or aggregate. Keep the
-- normalization O(n log n), just like semantic occurrence normalization.
local function sort_summary_lines(items: {PendingSummaryLine},
                                  work: NormalizationWork)
  local count = #items
  if count < 2 then return end
  local source = items
  local target: {PendingSummaryLine} = {}
  local source_is_input = true
  local width = 1
  while width < count do
    local first = 1
    while first <= count do
      local left = first
      local left_finish = first + width - 1
      if left_finish > count then left_finish = count end
      local right = left_finish + 1
      local right_finish = right + width - 1
      if right_finish > count then right_finish = count end
      local output = first
      while left <= left_finish and right <= right_finish do
        work:account()
        if summary_line_less(source[right], source[left]) then
          target[output] = source[right]
          right = right + 1
        else
          target[output] = source[left]
          left = left + 1
        end
        output = output + 1
      end
      while left <= left_finish do
        work:account()
        target[output] = source[left]
        left = left + 1
        output = output + 1
      end
      while right <= right_finish do
        work:account()
        target[output] = source[right]
        right = right + 1
        output = output + 1
      end
      first = right_finish + 1
    end
    local swap = source
    source = target
    target = swap
    source_is_input = not source_is_input
    if width > count // 2 then width = count else width = width * 2 end
  end
  if not source_is_input then
    for index = 1, count do
      work:account()
      items[index] = source[index]
    end
  end
end

local function summary_lines(items: {PendingSummaryLine},
                             work: NormalizationWork): {string}
  sort_summary_lines(items, work)
  local result: {string} = {}
  for index = 1, #items do
    work:account()
    result[index] = items[index].display
  end
  return result
end

local function visibility_prefix(raw: {string: value}): string
  if optional_boolean(raw["islocal"], TYPES_MODULE, "member.islocal") then
    return "local "
  end
  return ""
end

local function field_summary_line(compiler: Compiler, candidate: value,
                                  subject: string): PendingSummaryLine
  local raw = required_map(candidate, TYPES_MODULE, subject)
  if type_tag(candidate, subject) ~= "Type.Field" then
    return fail<PendingSummaryLine>(TYPES_MODULE,
      subject .. " must be a Type.Field")
  end
  local name = required_string(raw["name"], TYPES_MODULE, subject .. ".name")
  local output = strings.writer()
  output:write(visibility_prefix(raw))
  if optional_boolean(raw["isconst"], TYPES_MODULE, subject .. ".isconst") then
    output:write("const ")
  end
  output:write(name)
  output:write(": ")
  output:write(render_type(
    compiler, raw["type"], subject .. ".type").display)
  return PendingSummaryLine.new(0, name, output:drain())
end

local function variant_summary_line(compiler: Compiler, candidate: value,
                                    subject: string): PendingSummaryLine
  local raw = required_map(candidate, TYPES_MODULE, subject)
  if type_tag(candidate, subject) ~= "Type.Variant" then
    return fail<PendingSummaryLine>(TYPES_MODULE,
      subject .. " must be a Type.Variant")
  end
  local name = required_string(raw["name"], TYPES_MODULE, subject .. ".name")
  local output = strings.writer()
  output:write(visibility_prefix(raw))
  output:write(name)
  local payload: value = raw["payload"]
  if payload ~= nil and payload ~= false then
    output:write("(payload: ")
    output:write(render_type(
      compiler, payload, subject .. ".payload").display)
    output:write(")")
  end
  return PendingSummaryLine.new(0, name, output:drain())
end

local function aggregate_callable_line(
    compiler: Compiler, candidate: value, owner: string,
    subject: string): PendingSummaryLine
  local raw = required_map(candidate, TYPES_MODULE, subject)
  local name = required_string(raw["name"], TYPES_MODULE, subject .. ".name")
  local signature? = render_callable_type(
    compiler, candidate, owner, ".", name, raw["paramnames"],
    subject, owner)
  if signature == nil then
    return fail<PendingSummaryLine>(TYPES_MODULE,
      subject .. " must be a method or associated function")
  end
  return PendingSummaryLine.new(
    0, name, visibility_prefix(raw) .. signature.display)
end

local function specialized_owner(compiler: Compiler, candidate: value,
                                 arguments: {integer: value}?,
                                 subject: string): value
  if arguments == nil or #arguments == 0 then return candidate end
  local raw = required_map(candidate, TYPES_MODULE, subject)
  local scope: value = raw["scope"]
  if scope == nil or scope == false then return candidate end
  local raw_substitute = checked_function(
    compiler.types, TYPES_MODULE, "substitute", compiler.type_of)
  local substitute = raw_substitute as (value, value, value) -> value
  local specialized: value = nil
  do
    specialized = substitute(candidate, scope, arguments)
  catch
    return fail<value>(TYPES_MODULE,
      "cannot specialize " .. subject .. ": " .. strings.tostring(error))
  end
  return specialized
end

local function registered_owner(compiler: Compiler, fqtn: string): value
  local registry: value = compiler.types["registry"]
  if registry is {string: value} then
    return (registry as {string: value})[fqtn]
  end
  return nil
end

local function unwrap_summary_descriptor(compiler: Compiler,
                                         candidate: value,
                                         subject: string): value
  if candidate == nil or candidate == false or
     not (candidate is {string: value}) then return nil end
  local raw = candidate as {string: value}
  local raw_tag: value = raw["_tag"]
  if not (raw_tag is string) then return nil end
  local tag = raw_tag as string
  if tag == "Type.Module" or tag == "Type.Record" or
     tag == "Type.Union" or tag == "Type.Interface" then
    return candidate
  elseif tag == "Type.ModuleMember" or tag == "Checker.TypeMember" then
    return unwrap_summary_descriptor(
      compiler, raw["type"], subject .. ".type")
  elseif tag == "Type.Nominal" then
    local fqtn = required_string(
      raw["fqtn"], TYPES_MODULE, subject .. ".fqtn")
    return registered_owner(compiler, fqtn)
  elseif tag == "Type.GenericAlias" then
    local fqtn = required_string(
      raw["target_owner_fqtn"], TYPES_MODULE,
      subject .. ".target_owner_fqtn")
    return registered_owner(compiler, fqtn)
  elseif tag == "Ast.Decl" and raw["name"] == "self" and
         (raw["_name_loc"] == nil or raw["_name_loc"] == false) then
    -- `self` is a lexical value declaration, but its nominal type is the
    -- record or union whose complete cached summary is useful at the use site.
    return unwrap_summary_descriptor(
      compiler, raw["_type"], subject .. "._type")
  elseif tag == "Ast.TopLevelImport" then
    local resolved: value = raw["_declared_type"]
    local field = "._declared_type"
    if resolved == nil or resolved == false then
      resolved = raw["_type"]
      field = "._type"
    end
    return unwrap_summary_descriptor(
      compiler, resolved, subject .. field)
  elseif tag == "Ast.TopLevelRecord" or tag == "Ast.TopLevelUnion" or
         tag == "Ast.TopLevelInterface" then
    local nested = unwrap_summary_descriptor(
      compiler, raw["_type"], subject .. "._type")
    if nested is {string: value} then
      local nested_raw = nested as {string: value}
      if nested_raw["name"] is string then
        local canonical = registered_owner(
          compiler, nested_raw["name"] as string)
        if canonical ~= nil and canonical ~= false then return canonical end
      end
    end
    return nested
  end
  return nil
end

local function occurrence_type_arguments(source_node: value,
                                         owner_name: string,
                                         subject: string): {integer: value}?
  if not (source_node is {string: value}) then return nil end
  local raw = source_node as {string: value}
  local namespace_arguments: value = raw["_generic_namespace_arguments"]
  if namespace_arguments ~= nil and namespace_arguments ~= false then
    return required_value_list(
      namespace_arguments, subject .. "._generic_namespace_arguments")
  end
  local surface_arguments: value = raw["_surface_typeargs"]
  if surface_arguments ~= nil and surface_arguments ~= false then
    local surface = required_value_list(
      surface_arguments, subject .. "._surface_typeargs")
    if #surface > 0 then
      local arguments: {integer: value} = {}
      local resolved_surface = true
      for index = 1, #surface do
        local argument = required_map(
          surface[index], DRIVER_MODULE,
          subject .. "._surface_typeargs[" .. index .. "]")
        local resolved: value = argument["_resolved_typearg"]
        if resolved == nil or resolved == false then
          -- Keep accepting an explicitly annotated syntax node at the
          -- compiler boundary. Current compiler lowering publishes the
          -- private resolved-typearg edge because ordinary type syntax does
          -- not otherwise retain its checked Type descriptor.
          resolved = argument["_type"]
        end
        if resolved == nil or resolved == false then
          -- Lowered generic syntax may retain surface arguments that were not
          -- individually annotated. Prefer the resolved nominal below; if it
          -- is absent too, the canonical generic owner is still a useful view.
          resolved_surface = false
          break
        end
        arguments[index] = resolved
      end
      if resolved_surface then return arguments end
    end
  end
  local annotated: value = raw["_type"]
  if annotated is {string: value} then
    local annotated_raw = annotated as {string: value}
    if annotated_raw["_tag"] == "Type.Nominal" and
       annotated_raw["fqtn"] == owner_name then
      local arguments: value = annotated_raw["args"]
      if arguments == nil or arguments == false then return {} end
      return required_value_list(arguments, subject .. "._type.args")
    end
  end
  return nil
end

local function applied_owner_title(compiler: Compiler, owner: value,
                                   arguments: {integer: value}?,
                                   subject: string): string
  if arguments == nil or #arguments == 0 then
    return render_type(compiler, owner, subject).display
  end
  local raw = required_map(owner, TYPES_MODULE, subject)
  local output = strings.writer()
  output:write(required_string(
    raw["name"], TYPES_MODULE, subject .. ".name"))
  output:write("<")
  for index = 1, #arguments do
    if index > 1 then output:write(", ") end
    output:write(render_type(
      compiler, arguments[index],
      subject .. ".arguments[" .. index .. "]").display)
  end
  output:write(">")
  return output:drain()
end

local function aggregate_summary(
    compiler: Compiler, descriptor: value,
    arguments: {integer: value}?, include_local: boolean, subject: string,
    work: NormalizationWork):
    (HoverSummaryKind?, string?, {HoverSummarySection}?)
  local raw = required_map(descriptor, TYPES_MODULE, subject)
  local tag = type_tag(descriptor, subject)
  if tag ~= "Type.Record" and tag ~= "Type.Union" and
     tag ~= "Type.Interface" then return nil, nil, nil end
  local specialized = specialized_owner(
    compiler, descriptor, arguments, subject)
  raw = required_map(specialized, TYPES_MODULE, subject .. " specialized")
  local title = applied_owner_title(
    compiler, descriptor, arguments, subject)
  local sections: {HoverSummarySection} = {}

  if tag == "Type.Union" then
    local variants: {PendingSummaryLine} = {}
    local variant_names: {string: boolean} = {}
    local raw_variants = required_value_list(
      raw["variants"], subject .. ".variants")
    for index = 1, #raw_variants do
      work:account()
      local variant_raw = required_map(
        raw_variants[index], TYPES_MODULE,
        subject .. ".variants[" .. index .. "]")
      local line = variant_summary_line(
        compiler, raw_variants[index],
        subject .. ".variants[" .. index .. "]")
      variant_names[line.name] = true
      if include_local or not optional_boolean(
          variant_raw["islocal"], TYPES_MODULE,
          subject .. ".variants[" .. index .. "].islocal") then
        variants[#variants + 1] = line
      end
    end
    if #variants > 0 then
      sections[#sections + 1] = HoverSummarySection.new(
        "Variants", summary_lines(variants, work))
    end

    local functions: {PendingSummaryLine} = {}
    local raw_functions = required_map(
      raw["functions"], TYPES_MODULE, subject .. ".functions")
    for name, candidate in iteration.pairs<string, value>(raw_functions) do
      work:account()
      local candidate_raw = required_map(
        candidate, TYPES_MODULE, subject .. ".functions['" .. name .. "']")
      if not variant_names[name] and (include_local or not optional_boolean(
          candidate_raw["islocal"], TYPES_MODULE,
          subject .. ".functions['" .. name .. "'].islocal")) then
        functions[#functions + 1] = aggregate_callable_line(
          compiler, candidate, title,
          subject .. ".functions['" .. name .. "']")
      end
    end
    if #functions > 0 then
      sections[#sections + 1] = HoverSummarySection.new(
        "Functions", summary_lines(functions, work))
    end
  else
    local fields: {PendingSummaryLine} = {}
    local raw_fields = required_value_list(raw["fields"], subject .. ".fields")
    for index = 1, #raw_fields do
      work:account()
      local field_raw = required_map(
        raw_fields[index], TYPES_MODULE,
        subject .. ".fields[" .. index .. "]")
      if include_local or not optional_boolean(
          field_raw["islocal"], TYPES_MODULE,
          subject .. ".fields[" .. index .. "].islocal") then
        fields[#fields + 1] = field_summary_line(
          compiler, raw_fields[index],
          subject .. ".fields[" .. index .. "]")
      end
    end
    if #fields > 0 then
      sections[#sections + 1] = HoverSummarySection.new(
        "Fields", summary_lines(fields, work))
    end

    if tag == "Type.Record" then
      local functions: {PendingSummaryLine} = {}
      local raw_functions = required_map(
        raw["functions"], TYPES_MODULE, subject .. ".functions")
      for name, candidate in iteration.pairs<string, value>(raw_functions) do
        work:account()
        local candidate_raw = required_map(
          candidate, TYPES_MODULE,
          subject .. ".functions['" .. name .. "']")
        if include_local or not optional_boolean(
            candidate_raw["islocal"], TYPES_MODULE,
            subject .. ".functions['" .. name .. "'].islocal") then
          functions[#functions + 1] = aggregate_callable_line(
            compiler, candidate, title,
            subject .. ".functions['" .. name .. "']")
        end
      end
      if #functions > 0 then
        sections[#sections + 1] = HoverSummarySection.new(
          "Functions", summary_lines(functions, work))
      end
    end
  end

  local methods: {PendingSummaryLine} = {}
  if tag == "Type.Interface" then
    local raw_methods = required_value_list(
      raw["methods"], subject .. ".methods")
    for index = 1, #raw_methods do
      work:account()
      local candidate_raw = required_map(
        raw_methods[index], TYPES_MODULE,
        subject .. ".methods[" .. index .. "]")
      if include_local or not optional_boolean(
          candidate_raw["islocal"], TYPES_MODULE,
          subject .. ".methods[" .. index .. "].islocal") then
        methods[#methods + 1] = aggregate_callable_line(
          compiler, raw_methods[index], title,
          subject .. ".methods[" .. index .. "]")
      end
    end
  else
    local raw_methods = required_map(
      raw["methods"], TYPES_MODULE, subject .. ".methods")
    for name, candidate in iteration.pairs<string, value>(raw_methods) do
      work:account()
      local candidate_raw = required_map(
        candidate, TYPES_MODULE,
        subject .. ".methods['" .. name .. "']")
      if include_local or not optional_boolean(
          candidate_raw["islocal"], TYPES_MODULE,
          subject .. ".methods['" .. name .. "'].islocal") then
        methods[#methods + 1] = aggregate_callable_line(
          compiler, candidate, title,
          subject .. ".methods['" .. name .. "']")
      end
    end
  end
  if #methods > 0 then
    sections[#sections + 1] = HoverSummarySection.new(
      "Methods", summary_lines(methods, work))
  end

  if tag == "Type.Record" then
    return HoverSummaryKind.record_summary(), title, sections
  elseif tag == "Type.Union" then
    return HoverSummaryKind.union_summary(), title, sections
  end
  return HoverSummaryKind.interface_summary(), title, sections
end

local function append_type_parameters(
    compiler: Compiler, output: strings.StringWriter, raw: {string: value},
    subject: string)
  write_type_parameters(
    compiler, output, raw["typeparams"], subject .. ".typeparams")
end

local function module_nominal_line(
    compiler: Compiler, raw: {string: value}, member_name: string,
    kind: string, subject: string, force_local: boolean): string
  local output = strings.writer()
  if force_local then output:write("local ")
  else output:write(visibility_prefix(raw)) end
  output:write(kind)
  output:write(" ")
  output:write(member_name)
  append_type_parameters(compiler, output, raw, subject)
  return output:drain()
end

local function append_module_member(
    compiler: Compiler, module_name: string, candidate: value,
    rank: integer, subject: string, target: {PendingSummaryLine})
  local raw = required_map(candidate, TYPES_MODULE, subject)
  local tag = type_tag(candidate, subject)
  if tag ~= "Type.ModuleMember" and tag ~= "Type.ModuleVariable" then
    return fail<value>(TYPES_MODULE,
      subject .. " must be a module member")
  end
  local name = required_string(raw["name"], TYPES_MODULE, subject .. ".name")
  local member_type: value = raw["type"]
  local member_raw = required_map(
    member_type, TYPES_MODULE, subject .. ".type")
  local member_tag = type_tag(member_type, subject .. ".type")
  local display = ""
  if member_tag == "Type.Record" then
    display = module_nominal_line(
      compiler, member_raw, name, "record", subject .. ".type", false)
  elseif member_tag == "Type.Union" then
    display = module_nominal_line(
      compiler, member_raw, name, "union", subject .. ".type", false)
  elseif member_tag == "Type.Interface" then
    display = module_nominal_line(
      compiler, member_raw, name, "interface", subject .. ".type", false)
  elseif tag == "Type.ModuleMember" and
         (member_tag == "Type.Function" or
          member_tag == "Type.FunctionScheme" or
          member_tag == "Type.CFunction") then
    local signature? = render_callable_type(
      compiler, member_type, module_name, ".", name,
      raw["paramnames"], subject .. ".type", nil)
    if signature == nil then
      return fail<value>(TYPES_MODULE,
        subject .. " callable has no signature")
    end
    display = visibility_prefix(raw) .. signature.display
  else
    local output = strings.writer()
    output:write(visibility_prefix(raw))
    if optional_boolean(
        raw["isconst"], TYPES_MODULE, subject .. ".isconst") then
      output:write("const ")
    end
    output:write(name)
    output:write(": ")
    output:write(render_type(
      compiler, member_type, subject .. ".type").display)
    display = output:drain()
  end
  target[#target + 1] = PendingSummaryLine.new(rank, name, display)
end

local function append_module_type_members(
    compiler: Compiler, candidate: value, rank: integer,
    subject: string, target: {PendingSummaryLine},
    seen: {string: boolean}, source_only: boolean,
    work: NormalizationWork)
  if candidate == nil or candidate == false then return end
  local raw = required_map(candidate, TYPES_MODULE, subject)
  for name, member in iteration.pairs<string, value>(raw) do
    work:account()
    if not seen[name] then
      -- A source interface may decorate the public entry by name as well as
      -- expose genuinely source-only type members. The public view wins.
      seen[name] = true
      local member_subject = subject .. "['" .. name .. "']"
      local member_raw = required_map(
        member, TYPES_MODULE, member_subject)
      local tag = type_tag(member, member_subject)
      local display = ""
      if tag == "Type.Record" then
        display = module_nominal_line(
          compiler, member_raw, name, "record", member_subject, source_only)
      elseif tag == "Type.Union" then
        display = module_nominal_line(
          compiler, member_raw, name, "union", member_subject, source_only)
    elseif tag == "Type.Interface" then
        display = module_nominal_line(
          compiler, member_raw, name, "interface", member_subject, source_only)
    else
        local output = strings.writer()
        if source_only then output:write("local ")
        else output:write(visibility_prefix(member_raw)) end
      output:write("type ")
      output:write(name)
      if tag == "Type.GenericAlias" then
        append_type_parameters(
          compiler, output, member_raw, member_subject)
        local rendered = render_type(
          compiler, member, member_subject).display
        local equals? = strings.find(rendered, " = ")
        if equals == nil then
          return fail<value>(TYPES_MODULE,
            member_subject .. " generic alias has no rendered target")
        end
        output:write(strings.sub(rendered, equals))
      else
        output:write(" = ")
        output:write(render_type(
          compiler, member, member_subject).display)
      end
      display = output:drain()
    end
      target[#target + 1] = PendingSummaryLine.new(rank, name, display)
    end
  end
end

local function module_summary(
    compiler: Compiler, descriptor: value, include_source: boolean,
    subject: string, work: NormalizationWork):
    (HoverSummaryKind?, string?, {HoverSummarySection}?)
  if type_tag(descriptor, subject) ~= "Type.Module" then
    return nil, nil, nil
  end
  local raw = required_map(descriptor, TYPES_MODULE, subject)
  local module_name = required_string(
    raw["name"], TYPES_MODULE, subject .. ".name")
  local members: {PendingSummaryLine} = {}
  local value_members_seen: {string: boolean} = {}
  local public_members: {integer: value} = {}
  if raw["members"] ~= nil and raw["members"] ~= false then
    public_members = required_value_list(
      raw["members"], subject .. ".members")
  end
  for index = 1, #public_members do
    work:account()
    local member_subject = subject .. ".members[" .. index .. "]"
    local member_raw = required_map(
      public_members[index], TYPES_MODULE, member_subject)
    local name = required_string(
      member_raw["name"], TYPES_MODULE, member_subject .. ".name")
    if not value_members_seen[name] then
      value_members_seen[name] = true
      append_module_member(
        compiler, module_name, public_members[index], 0,
        member_subject, members)
    end
  end
  local source_members: value = raw["source_members"]
  if include_source and source_members ~= nil and source_members ~= false then
    local source_list = required_value_list(
      source_members, subject .. ".source_members")
    for index = 1, #source_list do
      work:account()
      local member_subject = subject .. ".source_members[" .. index .. "]"
      local member_raw = required_map(
        source_list[index], TYPES_MODULE, member_subject)
      local name = required_string(
        member_raw["name"], TYPES_MODULE, member_subject .. ".name")
      if not value_members_seen[name] then
        value_members_seen[name] = true
        append_module_member(
          compiler, module_name, source_list[index], 1,
          member_subject, members)
      end
    end
  end
  local type_members_seen: {string: boolean} = {}
  append_module_type_members(
    compiler, raw["type_members"], 2,
    subject .. ".type_members", members, type_members_seen, false, work)
  if include_source then
    append_module_type_members(
      compiler, raw["source_type_members"], 3,
      subject .. ".source_type_members", members, type_members_seen, true,
      work)
  end
  local sections: {HoverSummarySection} = {}
  if #members > 0 then
    sections[1] = HoverSummarySection.new(
      "Members", summary_lines(members, work))
  end
  return HoverSummaryKind.module_summary(), module_name, sections
end

local function source_import_declaration(candidate: value): boolean
  if not (candidate is {string: value}) then return false end
  local raw = candidate as {string: value}
  if raw["_tag"] ~= "Ast.TopLevelImport" then return false end
  return raw["_source_import"] == true or raw["source_required"] == true
end

local function source_import_name(candidate: value): string?
  if not source_import_declaration(candidate) then return nil end
  local raw = candidate as {string: value}
  local modname: value = raw["modname"]
  if modname is string then return modname as string end
  return nil
end

local function source_import_module(candidate: value): string?
  if not (candidate is {string: value}) then return nil end
  local raw = candidate as {string: value}
  local tag: value = raw["_tag"]
  local imported? = source_import_name(candidate)
  if imported ~= nil then return imported end
  imported = source_import_name(raw["_module_decl"])
  if imported ~= nil then return imported end
  imported = source_import_name(raw["_import_decl"])
  if imported ~= nil then return imported end
  imported = source_import_name(raw["_decl"])
  if imported ~= nil then return imported end
  if tag == "Ast.VarDot" then
    return source_import_module(raw["exp"])
  elseif tag == "Ast.ExpVar" then
    return source_import_module(raw["var"])
  end
  return nil
end

local function adjustment_info(compiler: Compiler, candidate: value,
                               subject: string): AdjustmentInfo
  local raw = required_map(candidate, TYPES_MODULE, subject)
  local kind = required_string(raw["kind"], TYPES_MODULE, subject .. ".kind")
  local operation: string? = optional_string(
    raw["op"], TYPES_MODULE, subject .. ".op")
  local source: TypeInfo? = nil
  local target: TypeInfo? = nil
  if raw["source"] ~= nil and raw["source"] ~= false then
    source = render_type(compiler, raw["source"], subject .. ".source")
  end
  if raw["target"] ~= nil and raw["target"] ~= false then
    target = render_type(compiler, raw["target"], subject .. ".target")
  end
  if kind == "direct_coercion" then
    local nested = required_map(
      raw["coercion"], TYPES_MODULE, subject .. ".coercion")
    operation = optional_string(
      nested["op"], TYPES_MODULE, subject .. ".coercion.op")
  end
  return AdjustmentInfo.new(kind, operation, source, target)
end

local function normalize_adjustment(compiler: Compiler, candidate: value,
                                    subject: string): Adjustment
  local info = adjustment_info(compiler, candidate, subject)
  if info.kind == "identity" then return Adjustment.identity(info) end
  if info.kind == "direct_coercion" then
    return Adjustment.coercion(info)
  end
  if info.kind == "gradual_view" then return Adjustment.gradual(info) end
  if info.kind == "callable" then return Adjustment.callable(info) end
  if info.kind == "written_cast" then return Adjustment.written(info) end
  return Adjustment.other(info)
end

local function node_kind(tag: string): NodeKind
  if strings.sub(tag, 1, 12) == "Ast.TopLevel"
      or tag == "Ast.Decl" or tag == "Ast.UnionVariant"
      or tag == "Ast.InterfaceMethod" then
    return NodeKind.declaration()
  end
  if strings.sub(tag, 1, 8) == "Ast.Stat" or tag == "Ast.Then"
      or tag == "Ast.CaseArm" then
    return NodeKind.statement()
  end
  if strings.sub(tag, 1, 7) == "Ast.Exp" or strings.sub(tag, 1, 8) == "Ast.Args"
      or tag == "Ast.Field" then
    return NodeKind.expression()
  end
  if strings.sub(tag, 1, 7) == "Ast.Var" then
    return NodeKind.variable()
  end
  if strings.sub(tag, 1, 8) == "Ast.Type"
      or tag == "Ast.TypeParam" then
    return NodeKind.type_syntax()
  end
  return NodeKind.other()
end

local function node_name(node: {string: value}, tag: string): string?
  if tag == "Ast.TopLevelMethod" or tag == "Ast.TopLevelStatic"
      or tag == "Ast.TopLevelFunc" or tag == "Ast.TopLevelForeignFunc"
      or tag == "Ast.TopLevelTypeAlias" or tag == "Ast.TopLevelRecord"
      or tag == "Ast.TopLevelUnion" or tag == "Ast.TopLevelInterface"
      or tag == "Ast.Decl" or tag == "Ast.UnionVariant"
      or tag == "Ast.InterfaceMethod" or tag == "Ast.TypeParam"
      or tag == "Ast.VarName" or tag == "Ast.VarDot"
      or tag == "Ast.TypeName" or tag == "Ast.TypeQualName"
      or tag == "Ast.ExpMethodRef" or tag == "Ast.CaseArm" then
    return optional_string(node["name"], DRIVER_MODULE, tag .. ".name")
  end
  if tag == "Ast.Field" then
    local name: value = node["name"]
    if name == nil or name == false then return nil end
    if name is string then return name as string end
    required_map(name, DRIVER_MODULE, tag .. ".name")
    return nil
  end
  if tag == "Ast.ArgsMethod" or tag == "Ast.ArgsNamedMethod" then
    return optional_string(node["method"], DRIVER_MODULE, tag .. ".method")
  end
  if tag == "Ast.TopLevelImport" or tag == "Ast.TopLevelForeignImport" then
    return optional_string(
      node["localname"], DRIVER_MODULE, tag .. ".localname")
  end
  return nil
end

local function node_is_local(node: {string: value}): boolean
  local tag = required_string(node["_tag"], DRIVER_MODULE, "AST _tag")
  if tag == "Ast.TopLevelForeignFunc" then
    -- Titan publishes direct foreign functions only through a module's
    -- source-visible member table. The AST has no redundant `islocal` marker,
    -- so preserve that compiler visibility rule explicitly.
    return true
  end
  if tag == "Ast.TopLevelImport" or
      tag == "Ast.TopLevelForeignImport" then
    -- Import namespaces are always introduced by Titan's `local` import
    -- syntax. The compiler does not need an `islocal` marker for checking, so
    -- normalize that source fact explicitly at the language-server boundary.
    return true
  end
  if optional_boolean(node["islocal"], DRIVER_MODULE, "AST islocal") then
    return true
  end
  local depth: value = node["_funcdepth"]
  if depth ~= nil and depth ~= false then
    return required_integer(depth, DRIVER_MODULE, "AST _funcdepth") > 0
  end
  return false
end

local function node_is_synthetic(node: {string: value}, tag: string): boolean
  return optional_boolean(
      node["_record_constructor"], DRIVER_MODULE, tag .. "._record_constructor")
    or optional_boolean(
      node["_union_constructor"], DRIVER_MODULE, tag .. "._union_constructor")
    or optional_boolean(
      node["_implicit_coercion"], DRIVER_MODULE, tag .. "._implicit_coercion")
end

local function node_has_synthetic_children(node: {string: value},
                                           tag: string): boolean
  return optional_boolean(
      node["_record_constructor"], DRIVER_MODULE, tag .. "._record_constructor")
    or optional_boolean(
      node["_union_constructor"], DRIVER_MODULE, tag .. "._union_constructor")
end

local function declaration_namespace(raw: {string: value}, tag: string): string
  if tag == "Ast.TopLevelTypeAlias" or tag == "Ast.TopLevelInterface"
      or tag == "Type.Interface" or tag == "Type.GenericAlias" then
    return "type"
  end
  if tag == "Checker.TypeMember" then
    local target = required_map(
      raw["type"], DRIVER_MODULE, "Checker.TypeMember.type")
    -- Qualified record/union type syntax wraps the ordinary module member.
    -- Its type mentions and constructor namespace refer to one declaration.
    -- Aliases and Interfaces instead carry their target type directly, even
    -- when an alias offers the same constructor syntax as a nominal owner.
    if target["_tag"] ~= "Type.ModuleMember" then return "type" end
  end
  return "value"
end

local function module_declaration_identity(module_name: string,
                                           raw: {string: value},
                                           tag: string, name: string): string
  local visibility = node_is_local(raw) and "source:" or "export:"
  return visibility .. module_name .. ":" ..
    declaration_namespace(raw, tag) .. ":" .. name
end

local function ast_identity(module_name: string, raw: {string: value},
                            tag: string, name: string): string
  if strings.sub(tag, 1, 12) == "Ast.TopLevel"
      and tag ~= "Ast.TopLevelImport"
      and tag ~= "Ast.TopLevelForeignImport" then
    return module_declaration_identity(module_name, raw, tag, name)
  end
  local location: SourceLocation? = semantic_location(
    raw, "symbol declaration")
  if not location then return "ast:" .. module_name .. ":" .. tag .. ":" .. name end
  return "ast:" .. module_name .. ":" .. location.filename .. ":" ..
    location.line .. ":" .. location.column .. ":" .. name
end

local function declaration_identity(module_name: string, candidate: value): string?
  if candidate == nil or candidate == false then return nil end
  local raw = required_map(candidate, DRIVER_MODULE, "symbol declaration")
  local tag = required_string(
    raw["_tag"], DRIVER_MODULE, "symbol declaration._tag")
  if tag == "Ast.Decl" then
    local canonical: value = raw["_decl"]
    if canonical ~= nil and canonical ~= false and canonical ~= candidate then
      return declaration_identity(module_name, canonical)
    end
  end
  if strings.sub(tag, 1, 4) == "Ast." then
    local name: string? = optional_string(
      raw["name"], DRIVER_MODULE, "symbol declaration.name")
    if tag == "Ast.TopLevelImport" or tag == "Ast.TopLevelForeignImport" then
      name = optional_string(
        raw["localname"], DRIVER_MODULE, "symbol declaration.localname")
    elseif tag == "Ast.TopLevelVar" then
      local declaration = required_map(
        raw["decl"], DRIVER_MODULE, "Ast.TopLevelVar.decl")
      name = required_string(
        declaration["name"], DRIVER_MODULE, "Ast.TopLevelVar.decl.name")
    end
    if not name then return nil end
    return ast_identity(module_name, raw, tag, name)
  end
  if strings.sub(tag, 1, 5) == "Type." and
      (strings.sub(tag, 1, 6) == "Type.C" or tag == "Type.Invalid") then
    -- Foreign/compiler-only descriptors have no navigable Titan declaration
    -- in V1. Do not manufacture a project identity for them.
    return nil
  end
  if strings.sub(tag, 1, 8) == "Checker." and
      tag ~= "Checker.TypeMember" and tag ~= "Checker.Parameter" then
    return nil
  end
  local name = required_string(
    raw["name"], DRIVER_MODULE, "symbol declaration.name")
  if tag == "Checker.Parameter" then
    local owner_kind = required_string(
      raw["owner_kind"], DRIVER_MODULE,
      "Checker.Parameter.owner_kind")
    if owner_kind ~= "module" and owner_kind ~= "member" then
      return fail<string>(DRIVER_MODULE,
        "Checker.Parameter.owner_kind must be 'module' or 'member'")
    end
    local owner_name = required_string(
      raw["owner_name"], DRIVER_MODULE,
      "Checker.Parameter.owner_name")
    local callable_name = required_string(
      raw["callable_name"], DRIVER_MODULE,
      "Checker.Parameter.callable_name")
    local index = required_integer(
      raw["index"], DRIVER_MODULE, "Checker.Parameter.index")
    if index < 1 then
      return fail<string>(DRIVER_MODULE,
        "Checker.Parameter.index must be positive")
    end
    return "parameter:" .. owner_kind .. ":" .. owner_name .. ":" ..
      callable_name .. ":" .. index .. ":" .. name
  end
  if tag == "Type.Field" or tag == "Type.Variant"
      or tag == "Type.Method" or tag == "Type.StaticMethod" then
    local fqtn = required_string(
      raw["fqtn"], DRIVER_MODULE, "symbol declaration.fqtn")
    return "member:" .. fqtn .. ":" .. name
  end
  local owner: string? = optional_string(
    raw["modname"], DRIVER_MODULE, "symbol declaration.modname")
  if tag == "Type.Record" or tag == "Type.Union"
      or tag == "Type.Interface" then
    local split = 0
    for index = 1, #name do
      if strings.byte(name, index) == 46 then split = index end
    end
    if split == 0 or split == #name then
      return fail<string>(TYPES_MODULE,
        "nominal declaration name '" .. name .. "' is not fully qualified")
    end
    owner = strings.sub(name, 1, split - 1)
    name = strings.sub(name, split + 1)
  end
  if not owner then
    owner = optional_string(
      raw["fqtn"], DRIVER_MODULE, "symbol declaration.fqtn")
  end
  if not owner then owner = module_name end
  return module_declaration_identity(owner, raw, tag, name)
end

local function declaration_local(candidate: value): boolean
  if candidate == nil or candidate == false then return false end
  local raw = required_map(candidate, DRIVER_MODULE, "symbol declaration")
  return node_is_local(raw)
end

local function declaration_visibility(candidate: value,
                                      localness: boolean):
    DeclarationVisibility
  if candidate ~= nil and candidate ~= false then
    local raw = required_map(candidate, DRIVER_MODULE, "symbol declaration")
    local tag = required_string(
      raw["_tag"], DRIVER_MODULE, "symbol declaration._tag")
    if tag == "Checker.Parameter" or tag == "Ast.TypeParam" or
       tag == "Type.Parameter" or tag == "Type.TypeParameter" then
      return DeclarationVisibility.block()
    elseif tag == "Ast.Decl" then
      -- Module variables and aggregate fields resolve through `_decl` to a
      -- top-level/member descriptor before this helper. A remaining Ast.Decl
      -- is therefore a lexical binding: local, parameter, loop binding, or
      -- the implicit method receiver.
      return DeclarationVisibility.block()
    end
  end
  if localness then return DeclarationVisibility.module() end
  return DeclarationVisibility.exported()
end

local function semantic_declaration(node: {string: value}, tag: string): value
  if tag == "Ast.ExpMethodRef" or tag == "Ast.ArgsMethod"
      or tag == "Ast.ArgsNamedMethod" then
    local declared: value = node["_declared_method"]
    if declared ~= nil and declared ~= false then return declared end
  end
  local declaration: value = node["_decl"]
  if declaration ~= nil and declaration ~= false then return declaration end
  if tag == "Ast.ExpMethodRef" or tag == "Ast.ArgsMethod"
      or tag == "Ast.ArgsNamedMethod" then
    return node["_method"]
  end
  if tag == "Ast.CaseArm" then return node["_variant"] end
  if tag == "Ast.Field" then return node["_field"] end
  return nil
end

local record Walker
  compiler: Compiler
  module_name: string
  local work: NormalizationWork
  nodes: {Node}
  symbols: {SymbolOccurrence}
  imports: {Import}
  local seen: {value: boolean}
  local hover_summaries: {HoverSummary}
  local summary_ids: {string: integer}
  local summary_views: {string: integer}
end

local function summary_kind_key(kind: HoverSummaryKind): string
  case kind
  when module_summary then return "module"
  when record_summary then return "record"
  when union_summary then return "union"
  when interface_summary then return "interface"
  end
end

local function append_summary_key_part(output: strings.StringWriter,
                                       candidate: string)
  output:write(strings.tostring(#candidate))
  output:write(":")
  output:write(candidate)
end

local function summary_content_key(kind: HoverSummaryKind, title: string,
                                   sections: {HoverSummarySection},
                                   work: NormalizationWork): string
  local output = strings.writer()
  append_summary_key_part(output, summary_kind_key(kind))
  append_summary_key_part(output, title)
  for section_index = 1, #sections do
    work:account()
    local section = sections[section_index]
    append_summary_key_part(output, section.heading)
    for line_index = 1, #section.lines do
      work:account()
      append_summary_key_part(output, section.lines[line_index])
    end
    append_summary_key_part(output, "")
  end
  return output:drain()
end

local function Walker:intern_summary(kind: HoverSummaryKind, title: string,
                                     sections: {HoverSummarySection}): integer
  local key = summary_content_key(kind, title, sections, self.work)
  local old? = self.summary_ids[key]
  if old ~= nil then return old end
  local id = #self.hover_summaries + 1
  self.hover_summaries[id] = HoverSummary.new(id, kind, title, sections)
  self.summary_ids[key] = id
  return id
end

local function summary_argument_key(compiler: Compiler,
                                    arguments: {integer: value}?,
                                    subject: string): string
  if arguments == nil or #arguments == 0 then return "" end
  local output = strings.writer()
  for index = 1, #arguments do
    append_summary_key_part(output, render_type(
      compiler, arguments[index],
      subject .. "[" .. index .. "]").display)
  end
  return output:drain()
end

local function summary_view_key(descriptor: value, descriptor_tag: string,
                                include_source: boolean,
                                argument_key: string,
                                subject: string): string
  local raw = required_map(descriptor, TYPES_MODULE, subject)
  local output = strings.writer()
  append_summary_key_part(output, descriptor_tag)
  append_summary_key_part(output, required_string(
    raw["name"], TYPES_MODULE, subject .. ".name"))
  append_summary_key_part(output, include_source and "source" or "public")
  append_summary_key_part(output, argument_key)
  return output:drain()
end

local function aggregate_owner_module(name: string,
                                      subject: string): string
  local split = 0
  for index = 1, #name do
    if strings.byte(name, index) == 46 then split = index end
  end
  if split == 0 or split == #name then
    return fail<string>(TYPES_MODULE,
      subject .. " name '" .. name .. "' is not fully qualified")
  end
  return strings.sub(name, 1, split - 1)
end

local function summary_descriptor_module(descriptor: value,
                                         descriptor_tag: string,
                                         subject: string): string
  local raw = required_map(descriptor, TYPES_MODULE, subject)
  local name = required_string(
    raw["name"], TYPES_MODULE, subject .. ".name")
  if descriptor_tag == "Type.Module" then return name end
  return aggregate_owner_module(name, subject)
end

local function Walker:summary_id(candidate: value, source_node: value,
                                  subject: string): integer?
  local descriptor = unwrap_summary_descriptor(
    self.compiler, candidate, subject)
  if descriptor == nil or descriptor == false then return nil end
  local kind: HoverSummaryKind? = nil
  local title: string? = nil
  local sections: {HoverSummarySection}? = nil
  local descriptor_tag = type_tag(descriptor, subject)
  local descriptor_module = summary_descriptor_module(
    descriptor, descriptor_tag, subject)
  local imported_module? = source_import_module(candidate)
  if imported_module == nil then
    imported_module = source_import_module(source_node)
  end
  -- Source imports grant private visibility only in the module named by that
  -- import. An alias/re-export may normalize to an owner in another module,
  -- but source visibility is deliberately non-transitive.
  local include_source = descriptor_module == self.module_name or
    imported_module == descriptor_module
  local arguments: {integer: value}? = nil
  if descriptor_tag ~= "Type.Module" then
    local descriptor_raw = required_map(descriptor, TYPES_MODULE, subject)
    local owner_name = required_string(
      descriptor_raw["name"], TYPES_MODULE, subject .. ".name")
    arguments = occurrence_type_arguments(
      source_node, owner_name, subject .. " occurrence")
  end
  local argument_key = summary_argument_key(
    self.compiler, arguments, subject .. " arguments")
  local view_key = summary_view_key(
    descriptor, descriptor_tag, include_source, argument_key, subject)
  local memoized? = self.summary_views[view_key]
  if memoized ~= nil then return memoized end
  if descriptor_tag == "Type.Module" then
    kind, title, sections = module_summary(
      self.compiler, descriptor, include_source, subject, self.work)
  else
    kind, title, sections = aggregate_summary(
      self.compiler, descriptor, arguments, include_source, subject,
      self.work)
  end
  if kind == nil or title == nil or sections == nil then return nil end
  local summary_id = self:intern_summary(kind, title, sections)
  self.summary_views[view_key] = summary_id
  return summary_id
end

local function Walker:already_seen(candidate: value): boolean
  if self.seen[candidate] then return true end
  self.seen[candidate] = true
  return false
end

local function occurrence_role(name: string): OccurrenceRole
  if name == "definition" then return OccurrenceRole.definition() end
  if name == "write" then return OccurrenceRole.write() end
  if name == "type_reference" then return OccurrenceRole.type_reference() end
  if name == "import_alias" then return OccurrenceRole.import_alias() end
  return OccurrenceRole.reference()
end

local function exact_occurrence_span(node: {string: value}, tag: string,
                                     name: string): SourceSpan?
  -- Issue #91 explicitly leaves navigation to Titan FFI declarations out of
  -- V1. Calls may still carry a stable identity for hover/references, but the
  -- foreign declaration itself must not become a navigable project target or
  -- a rename anchor.
  if tag == "Ast.TopLevelForeignFunc" then return nil end
  local name_location? = optional_field_location(
    node, "_name_loc", tag)
  if name_location ~= nil then
    return exact_name_span(name_location, name)
  end
  -- The compiler marks every source-written identifier with `_name_loc`.
  -- Lowerings reuse a nearby diagnostic `loc` for generated names, so that
  -- broader location must never be promoted into an exact navigation span.
  return nil
end

local function Walker:add_occurrence(node: {string: value}, tag: string,
                                     name: string, role_name: string,
                                     location: SourceLocation,
                                     local_hint: boolean?,
                                     parent_tag: string?)
  local declaration: value = semantic_declaration(node, tag)
  local declaration_id: string? = nil
  local localness = node_is_local(node)
  if declaration ~= nil and declaration ~= false then
    declaration_id = declaration_identity(self.module_name, declaration)
    localness = declaration_local(declaration)
  elseif role_name == "definition" and local_hint == false then
    declaration_id = "export:" .. self.module_name .. ":" ..
      declaration_namespace(node, tag) .. ":" .. name
  elseif role_name == "definition" and
      parent_tag == "Ast.TopLevelVar" and local_hint == true then
    -- A top-level variable's source identifier is the nested Ast.Decl, while
    -- references point back to Ast.TopLevelVar. Join those two compiler shapes
    -- without turning lexical Ast.Decl bindings into module identities.
    declaration_id = "source:" .. self.module_name .. ":value:" .. name
  elseif role_name == "definition" or role_name == "import_alias" then
    declaration_id = declaration_identity(self.module_name, node)
  end
  if local_hint ~= nil then localness = local_hint end

  local span: SourceSpan? = nil
  span = exact_occurrence_span(node, tag, name)
  local signature_candidate: value = declaration
  if tag == "Ast.TopLevelFunc" or tag == "Ast.TopLevelForeignFunc"
      or tag == "Ast.TopLevelMethod" or tag == "Ast.TopLevelStatic"
      or tag == "Ast.InterfaceMethod" then
    -- Declaration occurrences own the frozen surface callable metadata. The
    -- semantic identity may instead be an erased Type.Method descriptor.
    signature_candidate = node
  elseif signature_candidate == nil or signature_candidate == false then
    signature_candidate = node
  end
  local visibility_candidate: value = declaration
  if visibility_candidate == nil or visibility_candidate == false then
    visibility_candidate = node
  end
  self.symbols[#self.symbols + 1] = SymbolOccurrence.new(
    name, declaration_id, occurrence_role(role_name), location, span,
    localness, declaration_visibility(visibility_candidate, localness),
    optional_type(self.compiler, node, "_type", tag),
    callable_signature(
      self.compiler, self.module_name, signature_candidate,
      node, tag .. " callable declaration"),
    self:summary_id(
      signature_candidate, node, tag .. " hover summary declaration"))
end

local function Walker:add_bound_occurrence(name: string, declaration: value,
                                            location: SourceLocation,
                                            role: OccurrenceRole)
  local declaration_id = declaration_identity(
    self.module_name, declaration)
  local localness = declaration_local(declaration)
  self.symbols[#self.symbols + 1] = SymbolOccurrence.new(
    name, declaration_id, role, location,
    exact_name_span(location, name), localness,
    declaration_visibility(declaration, localness),
    nil, nil,
    self:summary_id(
      declaration, declaration, "bound hover summary declaration"))
end

local function Walker:add_import(node: {string: value},
                                 location: SourceLocation)
  local alias = required_string(
    node["localname"], DRIVER_MODULE, "Ast.TopLevelImport.localname")
  local module_name = required_string(
    node["modname"], DRIVER_MODULE, "Ast.TopLevelImport.modname")
  local source_required = optional_boolean(
    node["source_required"], DRIVER_MODULE,
    "Ast.TopLevelImport.source_required")
  self.imports[#self.imports + 1] = Import.new(
    alias, module_name, source_required, location)
end

local function Walker:visit_any(candidate: value, parent_id: integer?,
                                role_name: string, local_hint: boolean?,
                                synthetic_parent: boolean)
  if candidate == nil or candidate == false then return end
  if self.compiler.type_of(candidate) ~= "table" then return end
  local table_value = candidate as {string: value}
  local raw_tag: value = table_value["_tag"]
  if raw_tag is string and
      strings.sub(raw_tag as string, 1, 4) == "Ast." then
    self:visit_node(
      candidate, parent_id, role_name, local_hint, synthetic_parent)
    return
  end

  local list = candidate as {integer: value}
  for index = 1, #list do
    self:visit_any(
      list[index], parent_id, role_name, local_hint, synthetic_parent)
  end
end

local function child_fields(): const { string }
  -- Keep only lexical AST children here. Ast.ExpSpreadIndex.spread is a DAG
  -- backreference to the carrier already emitted earlier in the expression
  -- list. Traversing it is redundant now and could mis-parent the carrier if
  -- expression-list traversal order changes.
  return {
    "typeparams", "typeargs", "_surface_typeparams", "_surface_typeargs",
    "_surface_named_args",
    "constraint", "class", "params",
    "argtypes", "rettypes", "varargtype", "flexrettype", "block",
    "decl", "decls", "value", "type", "fields", "variants",
    "name",
    "members", "methods", "stats", "condition", "start", "finish",
    "inc", "exps", "vars", "callexp", "exp", "first", "last",
    "var", "arms",
    "elseblock", "thens", "elsestat", "catchblock", "finallyblock",
    "exp1", "exp2", "lhs", "rhs", "target", "args", "subtype",
    "base", "keystype", "valuestype", "basetype", "payload",
    "binding", "index", "owner", "variant", "method",
  }
end

local function Walker:visit_node(candidate: value, parent_id: integer?,
                                 role_name: string, local_hint: boolean?,
                                 synthetic_parent: boolean)
  if self:already_seen(candidate) then return end
  self.work:account()
  local raw = required_map(candidate, DRIVER_MODULE, "AST node")
  local tag = required_string(raw["_tag"], DRIVER_MODULE, "AST node._tag")
  if strings.sub(tag, 1, 4) ~= "Ast." then
    fail<value>(DRIVER_MODULE, "invalid AST tag '" .. tag .. "'")
  end
  local location? = semantic_location(raw, tag)
  local source_span? = structural_span(raw, tag)
  local name? = node_name(raw, tag)
  local inferred: TypeInfo? = optional_type(
    self.compiler, raw, "_type", tag)
  local declared: TypeInfo? = optional_type(
    self.compiler, raw, "_declared_type", tag)
  local adjustment: Adjustment? = nil
  local original: TypeInfo? = nil
  local coerced: TypeInfo? = nil
  local raw_adjustment: value = raw["_adjustment"]
  if raw_adjustment == nil or raw_adjustment == false then
    raw_adjustment = raw["_assignment_adjustment"]
  end
  if raw_adjustment ~= nil and raw_adjustment ~= false then
    adjustment = normalize_adjustment(
      self.compiler, raw_adjustment, tag .. " adjustment")
    local detail: AdjustmentInfo? = nil
    case adjustment
    when identity: item then detail = item
    when coercion: item then detail = item
    when gradual: item then detail = item
    when callable: item then detail = item
    when written: item then detail = item
    when other: item then detail = item
    end
    if detail then
      original = detail.source
      coerced = detail.target
    end
  end

  local id = #self.nodes + 1
  local synthetic = synthetic_parent or node_is_synthetic(raw, tag)
  local children_synthetic = synthetic_parent or
    node_has_synthetic_children(raw, tag)
  local localness = node_is_local(raw)
  if local_hint ~= nil then localness = local_hint end
  self.nodes[id] = Node.new(
    id, parent_id, tag, node_kind(tag), location, source_span, name,
    localness, synthetic, inferred, declared, original, coerced,
    adjustment)

  local parent_tag: string? = nil
  if parent_id then parent_tag = self.nodes[parent_id].tag end
  if not synthetic and location and name then
    local role = role_name
    if strings.sub(tag, 1, 12) == "Ast.TopLevel"
        or tag == "Ast.Decl" or tag == "Ast.UnionVariant"
        or tag == "Ast.TypeParam"
        or tag == "Ast.InterfaceMethod" then
      role = (tag == "Ast.TopLevelImport" or
              tag == "Ast.TopLevelForeignImport")
        and "import_alias" or "definition"
    elseif tag == "Ast.TypeName" or tag == "Ast.TypeQualName" then
      role = "type_reference"
    end
    self:add_occurrence(
      raw, tag, name, role, location, local_hint, parent_tag)
  end
  if not synthetic and tag == "Ast.TypeQualName" then
    local module_location? = optional_field_location(
      raw, "_module_loc", tag)
    if module_location ~= nil then
      local module_name = required_string(
        raw["module"], DRIVER_MODULE, tag .. ".module")
      self:add_bound_occurrence(
        module_name, raw["_module_decl"], module_location,
        OccurrenceRole.reference())
    end
  end
  if not synthetic and (tag == "Ast.TopLevelMethod"
      or tag == "Ast.TopLevelStatic") then
    local owner_location? = optional_field_location(
      raw, "_owner_loc", tag)
    if owner_location ~= nil then
      local owner_name = required_string(
        raw["class"], DRIVER_MODULE, tag .. ".class")
      self:add_bound_occurrence(
        owner_name, raw["_owner_decl"], owner_location,
        OccurrenceRole.type_reference())
    end
  end
  if not synthetic and tag == "Ast.TopLevelImport" and location then
    self:add_import(raw, location)
  end

  if tag == "Ast.StatAssign" then
    self:visit_any(raw["vars"], id, "write", nil, children_synthetic)
  elseif tag == "Ast.TopLevelVar" then
    self:visit_any(
      raw["decl"], id, "definition", node_is_local(raw), children_synthetic)
  elseif tag == "Ast.TopLevelFunc" or tag == "Ast.TopLevelForeignFunc"
      or tag == "Ast.TopLevelMethod" or tag == "Ast.TopLevelStatic" then
    self:visit_any(
      raw["params"], id, "definition", true, children_synthetic)
  elseif tag == "Ast.StatDecl" or tag == "Ast.StatFor"
      or tag == "Ast.StatForIn" then
    self:visit_any(
      raw["decls"], id, "definition", true, children_synthetic)
    self:visit_any(
      raw["decl"], id, "definition", true, children_synthetic)
  end

  local fields = child_fields()
  for index = 1, #fields do
    self:visit_any(
      raw[fields[index]], id, "reference", nil, children_synthetic)
  end
end

local function walk_ast(compiler: Compiler, module_name: string,
                        candidate: value, work: NormalizationWork):
    ({Node}, {SymbolOccurrence}, {Import}, {HoverSummary})
  if compiler.type_of(candidate) ~= "table" then
    raise BridgeError.new(
      DRIVER_MODULE, "annotated AST root must be a Lua table")
  end
  local walker = Walker.new(
    compiler, module_name, work, {}, {}, {}, {}, {}, {}, {})
  walker:visit_any(candidate, nil, "reference", nil, false)
  return walker.nodes, walker.symbols, walker.imports,
         walker.hover_summaries
end

-- External annotated ASTs exist only long enough to recover dependency edges.
-- Avoid normalizing nodes, occurrences, and especially aggregate summaries
-- that the snapshot must immediately discard.
local function imports_from_ast(compiler: Compiler, candidate: value,
                                work: NormalizationWork): {Import}
  if compiler.type_of(candidate) ~= "table" then
    raise BridgeError.new(
      DRIVER_MODULE, "annotated AST root must be a Lua table")
  end
  local imports: {Import} = {}
  local roots = candidate as {integer: value}
  for index = 1, #roots do
    work:account()
    local root: value = roots[index]
    if root is {string: value} then
      local raw = root as {string: value}
      if raw["_tag"] == "Ast.TopLevelImport" then
        local location? = semantic_location(raw, "Ast.TopLevelImport")
        if location ~= nil then
          imports[#imports + 1] = Import.new(
            required_string(
              raw["localname"], DRIVER_MODULE,
              "Ast.TopLevelImport.localname"),
            required_string(
              raw["modname"], DRIVER_MODULE,
              "Ast.TopLevelImport.modname"),
            optional_boolean(
              raw["source_required"], DRIVER_MODULE,
              "Ast.TopLevelImport.source_required"),
            location)
        end
      end
    end
  end
  return imports
end

local function diagnostic_body(message: string, start: integer): string
  if start > #message then return "" end
  return strings.sub(message, start)
end

local function parse_diagnostic(message: string,
                                work: NormalizationWork,
                                owner_module: string?): Diagnostic
  local search = 1
  while search <= #message do
    work:account()
    local first: integer? = strings.find(message, ":", search)
    if not first then break end
    local second: integer? = strings.find(message, ":", first + 1)
    if not second then break end
    local third: integer? = strings.find(message, ":", second + 1)
    if not third then break end
    local raw_line = strings.sub(message, first + 1, second - 1)
    local raw_column = strings.sub(message, second + 1, third - 1)
    local line: integer? = math.tointeger(raw_line)
    local column: integer? = math.tointeger(raw_column)
    if line and column and line > 0 and column > 0 then
      local body = diagnostic_body(message, third + 2)
      local kind = DiagnosticKind.compiler()
      if strings.sub(body, 1, 14) == "syntax error: " then
        kind = DiagnosticKind.syntax()
      elseif strings.sub(body, 1, 12) == "type error: " then
        kind = DiagnosticKind.type_error()
      end
      return Diagnostic.new(kind, body, SourceLocation.new(
        strings.sub(message, 1, first - 1), line, column), owner_module)
    end
    search = first + 1
  end
  return Diagnostic.new(
    DiagnosticKind.compiler(), message, nil, owner_module)
end

local function normalize_diagnostics(candidate: value,
                                     work: NormalizationWork,
                                     owner_module: string?): {Diagnostic}
  if candidate == nil or candidate == false then
    return fail<{Diagnostic}>(
      DRIVER_MODULE, "compiler error list must be a Lua table")
  end
  if not (candidate is {integer: value}) then
    return fail<{Diagnostic}>(
      DRIVER_MODULE, "compiler error list must be a Lua table")
  end
  local raw = candidate as {integer: value}
  local diagnostics: {Diagnostic} = {}
  for index = 1, #raw do
    work:account()
    diagnostics[index] = parse_diagnostic(
      required_string(
        raw[index], DRIVER_MODULE, "compiler error " .. index), work,
      owner_module)
  end
  return diagnostics
end

local function serialize_manifest(compiler: Compiler, module_name: string,
                                  candidate: value,
                                  source_serialized: string?): Manifest
  local raw_type = required_map(
    candidate, TYPES_MODULE, "module interface for '" .. module_name .. "'")
  local tag = required_string(
    raw_type["_tag"], TYPES_MODULE,
    "module interface for '" .. module_name .. "'._tag")
  if tag ~= "Type.Module" then
    return fail<Manifest>(TYPES_MODULE,
      "module interface for '" .. module_name ..
      "' must have tag Type.Module, found " .. tag)
  end
  local raw_serializer = checked_function(
    compiler.types, TYPES_MODULE, "serialize", compiler.type_of)
  local serializer = raw_serializer as (value) -> value
  local serialized: value = nil
  do
    serialized = serializer(candidate)
  catch
    return fail<Manifest>(TYPES_MODULE,
      "cannot serialize public manifest for '" .. module_name .. "': " ..
      strings.tostring(error))
  end
  return Manifest.new(module_name, required_string(
    serialized, TYPES_MODULE,
    "types.serialize result for '" .. module_name .. "'"),
    source_serialized)
end

local function project_index(modules: {ProjectModule}): {string: ProjectModule}
  local result: {string: ProjectModule} = {}
  for index = 1, #modules do
    local module = modules[index]
    if result[module.module_name] ~= nil then
      return fail<{string: ProjectModule}>(
        DRIVER_MODULE, "duplicate project module '" .. module.module_name .. "'")
    end
    if #module.files == 0 then
      return fail<{string: ProjectModule}>(
        DRIVER_MODULE, "project module '" .. module.module_name ..
        "' has no saved source files")
    end
    result[module.module_name] = module
  end
  return result
end

local function raw_source_descriptor(module: ProjectModule): value
  local files: {integer: value} = {}
  local contents: {string: value} = {}
  for index = 1, #module.files do
    local source = module.files[index]
    if contents[source.filename] ~= nil then
      return fail<value>(DRIVER_MODULE,
        "project module '" .. module.module_name ..
        "' repeats source file '" .. source.filename .. "'")
    end
    files[index] = source.filename
    contents[source.filename] = source.contents
  end
  local descriptor: {string: value} = {}
  descriptor["kind"] = #module.files == 1 and "flat" or "folder"
  descriptor["main"] = module.files[1].filename
  descriptor["files"] = files
  descriptor["contents"] = contents
  descriptor["native_output"] = module.files[1].filename
  descriptor["program_output"] = module.module_name
  return descriptor
end

local function project_loader_inputs(modules: {ProjectModule}):
    ({string: value}, {string: ProjectModule})
  local projects = project_index(modules)
  local overrides: {string: value} = {}
  for index = 1, #modules do
    local module = modules[index]
    overrides[module.module_name] = raw_source_descriptor(module)
  end
  return overrides, projects
end

local function requested_modules(names: {string},
                                 projects: {string: ProjectModule}):
    ({string: boolean}, {string})
  local requested: {string: boolean} = {}
  local ordered: {string} = {}
  for index = 1, #names do
    local name = names[index]
    if projects[name] == nil then
      raise BridgeError.new(
        DRIVER_MODULE, "analysis module '" .. name ..
        "' is not in the project snapshot")
    end
    if not requested[name] then
      requested[name] = true
      ordered[#ordered + 1] = name
    end
  end
  if #ordered == 0 then
    raise BridgeError.new(
      DRIVER_MODULE, "incremental analysis requires at least one module")
  end
  return requested, ordered
end

local function emit_analysis_progress(listener: ProgressListener,
                                      completed_files: integer,
                                      total_files: integer)
  -- UI telemetry cannot affect compiler control flow. In particular, a
  -- protocol/client listener is not another cancellation boundary.
  do listener(AnalysisProgress.new(completed_files, total_files)) catch end
end

local function cached_source_map(cached: {CachedSourceInterface},
                                 projects: {string: ProjectModule}):
    ({string: CachedSourceInterface}, {string: value})
  local normalized: {string: CachedSourceInterface} = {}
  local raw: {string: value} = {}
  for index = 1, #cached do
    local item = cached[index]
    if projects[item.module_name] ~= nil then
      raise BridgeError.new(
        DRIVER_MODULE, "external cached interface '" .. item.module_name ..
        "' collides with a project module")
    end
    if normalized[item.module_name] ~= nil then
      raise BridgeError.new(
        DRIVER_MODULE, "duplicate external cached interface '" ..
        item.module_name .. "'")
    end
    if item.main_file == "" or item.serialized == "" or
        item.source_serialized == "" then
      raise BridgeError.new(
        DRIVER_MODULE, "cached source interface '" .. item.module_name ..
        "' has an empty filename or manifest")
    end
    normalized[item.module_name] = item
    local source_files: {integer: value} = {}
    for file_index = 1, #item.source_files do
      source_files[file_index] = item.source_files[file_index]
    end
    local dependencies: {integer: value} = {}
    local seen: {string: boolean} = {}
    for import_index = 1, #item.imports do
      local dependency = item.imports[import_index].module_name
      if not seen[dependency] then
        seen[dependency] = true
        dependencies[#dependencies + 1] = dependency
      end
    end
    local descriptor: {string: value} = {}
    descriptor["serialized"] = item.serialized
    descriptor["filename"] = item.main_file
    descriptor["source_files"] = source_files
    descriptor["dependencies"] = dependencies
    descriptor["c_header_dependencies"] =
      raw_c_header_dependencies(item.c_header_dependencies)
    raw[item.module_name] = descriptor
  end
  return normalized, raw
end

local record NormalizedProvenance
  provenance: Provenance
  embedded_provider: boolean
end

local record NormalizedModule
  snapshot: ModuleSnapshot
  embedded_provider: boolean
end

local function provenance(entry: {string: value}, module_name: string,
                          projects: {string: ProjectModule}): NormalizedProvenance
  local kind = required_string(
    entry["kind"], DRIVER_MODULE,
    "compiler provenance for '" .. module_name .. "'.kind")
  if kind == "source" then
    local main_file = required_string(
      entry["filename"], DRIVER_MODULE,
      "compiler provenance for '" .. module_name .. "'.filename")
    local source_files: {string} = {main_file}
    if entry["source_files"] ~= nil and entry["source_files"] ~= false then
      source_files = required_string_list(
        entry["source_files"], DRIVER_MODULE,
        "compiler provenance for '" .. module_name .. "'.source_files")
    end
    local source = SourceProvenance.new(main_file, source_files)
    if projects[module_name] ~= nil then
      return NormalizedProvenance.new(
        Provenance.project_source(source), false)
    end
    return NormalizedProvenance.new(
      Provenance.external_source(source), false)
  end
  if kind == "dynamic" then
    return NormalizedProvenance.new(
      Provenance.dynamic_binary(BinaryProvenance.new(required_string(
        entry["filename"], DRIVER_MODULE,
        "compiler provenance for '" .. module_name .. "'.filename"))),
      false)
  end
  if kind == "static" then
    return NormalizedProvenance.new(
      Provenance.static_binary(BinaryProvenance.new(required_string(
        entry["static_archive"], DRIVER_MODULE,
        "compiler provenance for '" .. module_name .. "'.static_archive"))),
      false)
  end
  if kind == "embedded" then
    return NormalizedProvenance.new(
      Provenance.static_binary(BinaryProvenance.new(required_string(
        entry["filename"], DRIVER_MODULE,
        "compiler provenance for '" .. module_name .. "'.filename"))),
      true)
  end
  return fail<NormalizedProvenance>(DRIVER_MODULE,
    "unsupported compiler provenance kind '" .. kind .. "'")
end

local function snapshot_module(compiler: Compiler, module_name: string,
                               candidate: value,
                               projects: {string: ProjectModule},
                               cached: {string: CachedSourceInterface},
                               valid_manifest: boolean,
                               work: NormalizationWork,
                               defer_ast_install: boolean?): NormalizedModule
  local entry = required_map(
    candidate, DRIVER_MODULE, "driver.imported['" .. module_name .. "']")
  local normalized_origin = provenance(entry, module_name, projects)
  local origin = normalized_origin.provenance
  local manifest: Manifest? = nil
  if valid_manifest then
    local cached_source? = cached[module_name]
    if cached_source ~= nil then
      manifest = Manifest.new(
        module_name, cached_source.serialized,
        cached_source.source_serialized)
    else
      local source_serialized: string? = nil
      case origin
      when project_source then
        source_serialized = required_string(
          entry["source_manifest"], DRIVER_MODULE,
          "compiler source manifest for '" .. module_name .. "'")
        if source_serialized == "" then
          return fail<NormalizedModule>(
            DRIVER_MODULE, "compiler source manifest for '" ..
            module_name .. "' must not be empty")
        end
      when external_source then
        source_serialized = required_string(
          entry["source_manifest"], DRIVER_MODULE,
          "compiler source manifest for '" .. module_name .. "'")
        if source_serialized == "" then
          return fail<NormalizedModule>(
            DRIVER_MODULE, "compiler source manifest for '" ..
            module_name .. "' must not be empty")
        end
      when dynamic_binary then
      when static_binary then
      end
      manifest = serialize_manifest(
        compiler, module_name, entry["type"], source_serialized)
    end
  end
  local nodes: {Node} = {}
  local symbols: {SymbolOccurrence} = {}
  local imports: {Import} = {}
  local hover_summaries: {HoverSummary} = {}
  local header_dependencies = normalize_c_header_dependencies(
    entry["c_header_dependencies"],
    "driver.imported['" .. module_name .. "'].c_header_dependencies")
  local raw_ast: value = entry["ast"]
  if projects[module_name] ~= nil then
    if raw_ast == nil or raw_ast == false then
      return fail<NormalizedModule>(DRIVER_MODULE,
        "project source '" .. module_name .. "' has no annotated AST")
    end
    nodes, symbols, imports, hover_summaries = walk_ast(
      compiler, module_name, raw_ast, work)
    if valid_manifest and not defer_ast_install then
      compiler.project_asts[module_name] = raw_ast
    end
  elseif cached[module_name] ~= nil then
    local cached_source = cached[module_name]
    for index = 1, #cached_source.imports do
      work:account()
      imports[index] = cached_source.imports[index]
    end
  elseif raw_ast ~= nil and raw_ast ~= false then
    -- External ASTs exist only for this transient compiler attempt. Normalize
    -- their dependency edges, then immediately discard the compiler graph.
    imports = imports_from_ast(compiler, raw_ast, work)
  else
    local dependencies: {string} = {}
    local raw_dependencies: value = entry["deps"]
    if raw_dependencies is {string: value} then
      for dependency, enabled in iteration.pairs<string, value>(
          raw_dependencies as {string: value}) do
        work:account()
        if enabled then
          local position = #dependencies + 1
          while position > 1 and
              dependencies[position - 1] > dependency do
            work:account()
            dependencies[position] = dependencies[position - 1]
            position = position - 1
          end
          dependencies[position] = dependency
        end
      end
    end
    local filename = "<" .. module_name .. ">"
    case origin
    when external_source: source then filename = source.main_file
    when dynamic_binary: binary then filename = binary.provider_file
    when static_binary: binary then filename = binary.provider_file
    when project_source then
    end
    for index = 1, #dependencies do
      work:account()
      imports[index] = Import.new(
        dependencies[index], dependencies[index], false,
        SourceLocation.new(filename, 1, 1))
    end
  end
  return NormalizedModule.new(
    ModuleSnapshot.new(
      module_name, origin, manifest, nodes, symbols, imports,
      header_dependencies, hover_summaries, nil),
    normalized_origin.embedded_provider)
end

local record NormalizedContextualResolution
  resolution: ContextualResolution
  embedded_provider: boolean
end

local function normalize_contextual_resolutions(
    context: value, work: NormalizationWork):
    {NormalizedContextualResolution}
  local raw_context = required_map(
    context, DRIVER_MODULE, "compiler resolver context")
  local raw_resolutions = required_map(
    raw_context["contextual_resolutions"], DRIVER_MODULE,
    "compiler resolver contextual_resolutions")
  local result: {NormalizedContextualResolution} = {}
  for key, candidate in iteration.pairs<string, value>(raw_resolutions) do
    work:account()
    local raw = required_map(candidate, DRIVER_MODULE,
      "compiler contextual resolution '" .. key .. "'")
    local owner = required_string(
      raw["owner"], DRIVER_MODULE,
      "compiler contextual resolution '" .. key .. "'.owner")
    local exposer = required_string(
      raw["exposer"], DRIVER_MODULE,
      "compiler contextual resolution '" .. key .. "'.exposer")
    local kind = required_string(
      raw["kind"], DRIVER_MODULE,
      "compiler contextual resolution '" .. key .. "'.kind")
    local provider_file = required_string(
      raw["provider_file"], DRIVER_MODULE,
      "compiler contextual resolution '" .. key .. "'.provider_file")
    local origin?: Provenance = nil
    if kind == "dynamic" then
      origin = Provenance.dynamic_binary(
        BinaryProvenance.new(provider_file))
    elseif kind == "static" or kind == "embedded" then
      origin = Provenance.static_binary(
        BinaryProvenance.new(provider_file))
    else
      return fail<{NormalizedContextualResolution}>(DRIVER_MODULE,
        "compiler contextual resolution '" .. key ..
        "' has unsupported provenance kind '" .. kind .. "'")
    end
    local normalized_kind = kind
    if normalized_kind == "embedded" then normalized_kind = "static" end
    local normalized = NormalizedContextualResolution.new(
      ContextualResolution.new(
        owner, exposer, origin as Provenance, required_boolean(
          raw["ordinary_lookup"], DRIVER_MODULE,
          "compiler contextual resolution '" .. key ..
          "'.ordinary_lookup"), nil),
      kind == "embedded")
    local position = #result + 1
    local identity = exposer .. "\0" .. owner .. "\0" ..
                     normalized_kind .. "\0" .. provider_file
    while position > 1 do
      work:account()
      local previous_normalized = result[position - 1]
      local previous = previous_normalized.resolution
      local previous_kind = "dynamic"
      local previous_file = ""
      case previous.provenance
      when dynamic_binary: binary then previous_file = binary.provider_file
      when static_binary: binary then
        previous_kind = "static"
        previous_file = binary.provider_file
      else
      end
      local previous_identity = previous.exposer_module .. "\0" ..
        previous.owner_module .. "\0" .. previous_kind .. "\0" ..
        previous_file
      if previous_identity <= identity then break end
      result[position] = previous_normalized
      position = position - 1
    end
    result[position] = normalized
  end
  return result
end

local function contextual_provider_file(
    resolution: ContextualResolution): string
  case resolution.provenance
  when dynamic_binary: binary then return binary.provider_file
  when static_binary: binary then return binary.provider_file
  else
    return fail<string>(DRIVER_MODULE,
      "contextual owner has non-binary provider provenance")
  end
end

local function copy_provider_identity(
    source: compiler_io.LstatIdentity): compiler_io.LstatIdentity
  return compiler_io.LstatIdentity.new(
    source.path, source.size, source.kind, source.device, source.inode,
    source.modified_seconds, source.modified_nanoseconds)
end

-- The embedded provider never traverses the compiler's filesystem
-- strategy. Its exact executable path is therefore stamped from the native
-- live-image observation validated at the end of this analysis; every other
-- binary provider retains the ordinary per-analysis lstat contract.
local function selected_provider_identity(
    compiler: Compiler, embedded_identity: compiler_io.LstatIdentity,
    provider_file: string,
    embedded_provider: boolean): compiler_io.LstatIdentity?
  if embedded_provider then
    if provider_file ~= compiler.embedded_provider_file then
      return fail<compiler_io.LstatIdentity?>(
        DRIVER_MODULE,
        "embedded compiler result names unexpected provider '" ..
        provider_file .. "'")
    end
    return copy_provider_identity(embedded_identity)
  end
  return compiler_io.consistent_lstat_identity(compiler.io, provider_file)
end

local function attach_contextual_provider_identities(
    compiler: Compiler, embedded_identity: compiler_io.LstatIdentity,
    resolutions: {NormalizedContextualResolution}): {ContextualResolution}
  local result: {ContextualResolution} = {}
  for index = 1, #resolutions do
    local normalized = resolutions[index]
    local source = normalized.resolution
    local provider_file = contextual_provider_file(source)
    result[index] = ContextualResolution.new(
      source.owner_module, source.exposer_module, source.provenance,
      source.ordinary_lookup,
      selected_provider_identity(
        compiler, embedded_identity, provider_file,
        normalized.embedded_provider))
  end
  return result
end

local function attach_module_provider_identities(
    compiler: Compiler, embedded_identity: compiler_io.LstatIdentity,
    modules: {ModuleSnapshot},
    provider_conflicts: {string: boolean},
    embedded_modules: {string: boolean})
  for index = 1, #modules do
    local snapshot = modules[index]
    local provider_file?: string = nil
    case snapshot.provenance
    when dynamic_binary: binary then provider_file = binary.provider_file
    when static_binary: binary then provider_file = binary.provider_file
    else
    end
    if provider_file ~= nil and
       not provider_conflicts[snapshot.module_name] then
      snapshot.provider_identity = selected_provider_identity(
        compiler, embedded_identity, provider_file as string,
        embedded_modules[snapshot.module_name] == true)
    end
  end
end

local record BinaryProviderSelection
  module_name: string
  kind: string
  provider_file: string
  embedded_provider: boolean
end

local function binary_provider_selection(
    snapshot: ModuleSnapshot,
    embedded_provider: boolean): BinaryProviderSelection?
  case snapshot.provenance
  when dynamic_binary: binary then
    return BinaryProviderSelection.new(
      snapshot.module_name, "dynamic", binary.provider_file,
      embedded_provider)
  when static_binary: binary then
    return BinaryProviderSelection.new(
      snapshot.module_name, "static", binary.provider_file,
      embedded_provider)
  else return nil
  end
end

local function binary_provider_selection_key(
    selection: BinaryProviderSelection): string
  local kind = selection.kind
  if selection.embedded_provider then kind = "embedded" end
  return kind .. "\0" .. selection.provider_file
end

local function binary_provider_observation_key(
    selection: BinaryProviderSelection): string
  return selection.module_name .. "\0" ..
         binary_provider_selection_key(selection)
end

local function observe_binary_provider_selection(
    snapshot: ModuleSnapshot, embedded_provider: boolean,
    selections: {string: string},
    observation_keys: {string: boolean},
    observations: {BinaryProviderSelection}, conflicts: {string: boolean})
  local selection? = binary_provider_selection(snapshot, embedded_provider)
  if selection == nil then return end
  local observed = selection as BinaryProviderSelection
  local key = binary_provider_selection_key(observed)
  local previous? = selections[observed.module_name]
  if previous == nil then
    selections[observed.module_name] = key
  elseif previous ~= key then
    conflicts[observed.module_name] = true
  end
  local observation_key = binary_provider_observation_key(observed)
  if not observation_keys[observation_key] then
    observation_keys[observation_key] = true
    local position = #observations + 1
    while position > 1 and
          binary_provider_observation_key(observations[position - 1]) >
            observation_key do
      observations[position] = observations[position - 1]
      position = position - 1
    end
    observations[position] = observed
  end
end

local function attach_binary_provider_observations(
    compiler: Compiler, embedded_identity: compiler_io.LstatIdentity,
    selections: {BinaryProviderSelection}): {BinaryProviderObservation}
  local result: {BinaryProviderObservation} = {}
  for index = 1, #selections do
    local selection = selections[index]
    result[index] = BinaryProviderObservation.new(
      selection.module_name, selection.kind, selection.provider_file,
      selected_provider_identity(
        compiler, embedded_identity, selection.provider_file,
        selection.embedded_provider))
  end
  return result
end

local function observe_embedded_provider(
    compiler: Compiler): compiler_io.LstatIdentity
  local raw_identity: {string: value} = {}
  do
    raw_identity = embedded_interfaces.identity()
  catch
    raise BridgeError.new(
      DRIVER_MODULE,
      "cannot observe embedded compiler provider '" ..
      compiler.embedded_provider_file .. "': " .. strings.tostring(error))
  end
  return embedded_provider_identity(
    raw_identity, compiler.embedded_provider_file)
end

local function validate_embedded_provider_baseline(
    compiler: Compiler): compiler_io.LstatIdentity
  local observed = observe_embedded_provider(compiler)
  if not compiler_io.same_lstat_identity(
      compiler.embedded_provider_identity, observed) then
    raise BridgeError.new(
      DRIVER_MODULE,
      "embedded compiler provider '" .. compiler.embedded_provider_file ..
      "' changed after compiler initialization; restart the language server")
  end
  return observed
end

-- Installation discovery belongs to the compiler, which deliberately
-- defers physical path resolution until a resolver owns an I/O strategy.
-- Initialize and close that resolver under the shared Lua-state permit before
-- exposing the compiler's release-versioned library directory to project
-- configuration.
function Compiler:installed_binary_modules_root(): string
  local permit = compiler_scheduler.acquire()
  defer permit:release()

  local context = new_context(self, nil)
  defer close_context(self, context)

  local paths = required_map(
    self.driver["INSTALL_PATHS"], DRIVER_MODULE,
    "driver.INSTALL_PATHS")
  return required_string(
    paths["titan_bin"], DRIVER_MODULE,
    "driver.INSTALL_PATHS.titan_bin")
catch
  if error is async.CancellationReason then raise end
  if error is BridgeError then raise end
  raise BridgeError.new(DRIVER_MODULE,
    "compiler installation discovery failed: " .. strings.tostring(error))
end

local function append_diagnostics(target: {Diagnostic}, source: {Diagnostic},
                                  work: NormalizationWork)
  for index = 1, #source do
    work:account()
    target[#target + 1] = source[index]
  end
end

local record AttemptResult
  diagnostics: {Diagnostic}
  modules: {ModuleSnapshot}
  contextual_resolutions: {NormalizedContextualResolution}
  embedded_modules: {string: boolean}
  checked: {string}
  entries: {string: value}
  failed: {string: boolean}
end

local function project_filename_owners(projects: {string: ProjectModule},
                                       work: NormalizationWork):
    {string: string}
  local owners: {string: string} = {}
  for name, project in iteration.pairs<string, ProjectModule>(projects) do
    for index = 1, #project.files do
      work:account()
      owners[project.files[index].filename] = name
    end
  end
  return owners
end

local function sort_strings(items: {string}, work: NormalizationWork)
  local count = #items
  if count < 2 then return end
  local source = items
  local target: {string} = {}
  local source_is_input = true
  local width = 1
  while width < count do
    local first = 1
    while first <= count do
      local left = first
      local middle = first + width
      local right = middle
      local finish = first + width + width - 1
      if middle > count + 1 then middle = count + 1 end
      if finish > count then finish = count end
      for output = first, finish do
        work:account()
        if left < middle and
           (right > finish or source[left] <= source[right]) then
          target[output] = source[left]
          left = left + 1
        else
          target[output] = source[right]
          right = right + 1
        end
      end
      first = finish + 1
    end
    local swap = source
    source = target
    target = swap
    source_is_input = not source_is_input
    width = width * 2
  end
  if not source_is_input then
    for index = 1, count do
      work:account()
      items[index] = source[index]
    end
  end
end

local function sorted_entry_names(entries: {string: value},
                                  work: NormalizationWork): {string}
  local result: {string} = {}
  for name in iteration.pairs<string, value>(entries) do
    work:account()
    result[#result + 1] = name
  end
  sort_strings(result, work)
  return result
end

local function failed_projects(root_module: string,
                               diagnostics: {Diagnostic},
                               projects: {string: ProjectModule},
                               loader_failed: boolean,
                               work: NormalizationWork): {string: boolean}
  local failed: {string: boolean} = {}
  local owners = project_filename_owners(projects, work)
  if loader_failed then failed[root_module] = true end
  for index = 1, #diagnostics do
    work:account()
    local diagnostic = diagnostics[index]
    local owner?: string = nil
    if diagnostic.location ~= nil then
      owner = owners[diagnostic.location.filename]
    end
    if owner == nil then owner = root_module end
    failed[owner as string] = true
  end
  return failed
end

local function failed_project_snapshot(project: ProjectModule): ModuleSnapshot
  local files: {string} = {}
  for index = 1, #project.files do
    files[index] = project.files[index].filename
  end
  return ModuleSnapshot.new(
    project.module_name,
    Provenance.project_source(SourceProvenance.new(
      project.files[1].filename, files)),
    nil, {}, {}, {}, {}, nil, nil)
end

local function snapshot_profile_filename(snapshot: ModuleSnapshot): string
  case snapshot.provenance
  when project_source: source then return source.main_file
  when external_source: source then return source.main_file
  when dynamic_binary: binary then return binary.provider_file
  when static_binary: binary then return binary.provider_file
  end
end

local function Compiler:run_attempt_inner(
    root_module: string, projects: {string: ProjectModule},
    overrides: {string: value},
    pending: {string: boolean}, cached: {string: CachedSourceInterface},
    raw_cached_interfaces: {string: value},
    c_header_analysis: value, header_inputs: value): AttemptResult
  local normalization_work = NormalizationWork.new(0)
  local options: {string: value} = { ["io"] = self.io }
  options["c_header_analysis"] = c_header_analysis
  if header_inputs ~= nil then options["header_inputs"] = header_inputs end
  local profiling = logging.enabled("trace")
  if profiling then
    local trace_header_phase:
      (string, string, string, string, float, string?) -> () =
      function (header: string, resolved_header: string,
                phase: string, outcome: string, cpu_ms: float,
                trace_identity: string?)
        local identity?: string = trace_identity
        if identity == nil or identity == "" then
          identity = resolved_header
          if identity == "" then identity = header end
        end
        logging.emit("trace", "compiler.c_header.phase", {
          ["root_module"] = root_module,
          ["header"] = header,
          ["resolved_header"] = resolved_header,
          ["identity"] = identity as string,
          ["phase"] = phase,
          ["outcome"] = outcome,
          ["cpu_ms"] = cpu_ms,
        })
      end
    local trace_source_module:
      (string, string, string, float, float, float, float) -> () =
      function (module_name: string, filename: string, outcome: string,
                self_cpu_ms: float, total_cpu_ms: float,
                parse_cpu_ms: float, check_cpu_ms: float)
        logging.emit("trace", "compiler.source_module.profile", {
          ["root_module"] = root_module,
          ["module_name"] = module_name,
          ["filename"] = filename,
          ["outcome"] = outcome,
          ["self_cpu_ms"] = self_cpu_ms,
          ["total_cpu_ms"] = total_cpu_ms,
          ["parse_cpu_ms"] = parse_cpu_ms,
          ["check_cpu_ms"] = check_cpu_ms,
        })
      end
    local trace_probe_cache:
      (string, string, boolean, string, string) -> () =
      function (module_name: string, stage: string, hit: boolean,
                key: string, path: string)
        logging.emit("trace", "compiler.c_probe.cache", {
          ["root_module"] = root_module,
          ["module_name"] = module_name,
          ["cache"] = "persistent success",
          ["stage"] = stage,
          ["hit"] = hit,
          ["key"] = key,
          ["path"] = path,
        })
      end
    local trace_probe_semantic: (value) -> () =
      function (event: value)
        emit_c_probe_semantic_trace(root_module, event)
      end
    local trace_probe_execution: (value) -> () =
      function (event: value)
        emit_c_probe_execution_trace(root_module, event)
      end
    options["c_header_process_trace"] = trace_header_phase
    options["source_process_trace"] = trace_source_module
    options["c_probe_cache_trace"] = trace_probe_cache
    options["c_probe_semantic_trace"] = trace_probe_semantic
    options["c_probe_execution_trace"] = trace_probe_execution
  end
  local roots: {string: value} = {[root_module] = true}
  local active_overrides: {string: value} = {}
  local retained_entries: {string: value} = {}
  local known_source_modules: {string: value} = {}
  for name in iteration.pairs<string, ProjectModule>(projects) do
    known_source_modules[name] = true
    if pending[name] then
      active_overrides[name] = overrides[name]
    elseif self.project_entries[name] ~= nil then
      retained_entries[name] = self.project_entries[name]
    end
  end
  options["source_roots"] = roots
  options["source_overrides"] = active_overrides
  options["known_source_modules"] = known_source_modules
  options["cached_source_entries"] = retained_entries
  options["cached_interfaces"] = raw_cached_interfaces
  local raw_includes: {integer: value} = {}
  for index = 1, #self.extra_ffi_include_dirs do
    raw_includes[index] = self.extra_ffi_include_dirs[index]
  end
  options["extra_ffi_include_dirs"] = raw_includes

  local previous_imported: value = self.driver["imported"]
  local previous_registry: value = self.types["registry"]
  defer self.driver["imported"] = previous_imported
  defer self.types["registry"] = previous_registry
  local imported: {string: value} = {}
  self.driver["imported"] = imported
  self.types["registry"] = {} as {string: value}

  local context = new_context(self, options)
  defer close_context(self, context)
  options["context"] = context

  local raw_defaultloader = checked_function(
    self.driver, DRIVER_MODULE, "defaultloader", self.type_of)
  local defaultloader = raw_defaultloader as (value, value) -> value
  local static_dependencies: {string: value} = {}
  local loader: value = defaultloader(static_dependencies, options)
  if self.type_of(loader) ~= "function" then
    return fail<AttemptResult>(DRIVER_MODULE,
      "driver.defaultloader returned " .. describe(loader, self.type_of) ..
      " instead of a function")
  end
  defer close_loader(self, loader)

  local diagnostics: {Diagnostic} = {}
  local invoke = loader as (string) -> (value, value, value, value)
  local raw_ok, interface_or_error, raw_errors = invoke(root_module)
  local ok = required_boolean(
    raw_ok, DRIVER_MODULE, "compiler loader result")
  if not ok then
    diagnostics[#diagnostics + 1] = parse_diagnostic(
      required_string(
        interface_or_error, DRIVER_MODULE, "compiler loader error"),
      normalization_work, root_module)
  else
    append_diagnostics(
      diagnostics,
      normalize_diagnostics(raw_errors, normalization_work, root_module),
      normalization_work)
  end

  local raw_context = required_map(
    context, DRIVER_MODULE, "compiler resolver context")
  local checked = required_string_list(
    raw_context["checked_source_modules"], DRIVER_MODULE,
    "compiler resolver checked_source_modules")

  local raw_finalize = checked_function(
    self.driver, DRIVER_MODULE, "finalize_resolver_context", self.type_of)
  local finalize = raw_finalize as (value) -> (value, value)
  local finalized, raw_final_errors = finalize(context)
  if finalized == nil or finalized == false then
    append_diagnostics(
      diagnostics,
      normalize_diagnostics(
        raw_final_errors, normalization_work, root_module),
      normalization_work)
  end
  local contextual_resolutions: {NormalizedContextualResolution} = {}
  if finalized ~= nil and finalized ~= false then
    contextual_resolutions = normalize_contextual_resolutions(
      context, normalization_work)
  end

  local failed = failed_projects(
    root_module, diagnostics, projects, not ok, normalization_work)
  local checked_set: {string: boolean} = {}
  for index = 1, #checked do checked_set[checked[index]] = true end
  -- A loader that fails before publishing a module cannot add the root to the
  -- context's checked list. Its failed root still belongs in this attempt's
  -- explicit result.
  if not ok then checked_set[root_module] = true end

  local modules: {ModuleSnapshot} = {}
  local embedded_modules: {string: boolean} = {}
  local entries: {string: value} = {}
  local names = sorted_entry_names(imported, normalization_work)
  for index = 1, #names do
    local name = names[index]
    local is_project = projects[name] ~= nil
    if not is_project or checked_set[name] then
      local valid = #diagnostics == 0
      if is_project then valid = failed[name] ~= true end
      if is_project and valid and #diagnostics > 0 then
        local entry = required_map(
          imported[name], DRIVER_MODULE,
          "driver.imported['" .. name .. "']")
        -- A diagnostic in a source dependency makes every source module that
        -- depends on it invalid. The compiler consequently omits those
        -- modules' source manifests even when no diagnostic points into their
        -- own files. Preserve malformed-manifest contract checks, but treat
        -- this documented omission as the compiler's transitive-failure
        -- signal instead of trying to serialize an invalid module.
        if entry["source_manifest"] == nil or
            entry["source_manifest"] == false then
          valid = false
          failed[name] = true
        end
      end
      local normalization_started = 0.0
      if profiling then normalization_started = logging.clock() end
      local normalized = snapshot_module(
        self, name, imported[name], projects, cached, valid,
        normalization_work)
      local snapshot = normalized.snapshot
      modules[#modules + 1] = snapshot
      if normalized.embedded_provider then embedded_modules[name] = true end
      if profiling then
        logging.emit("trace", "compiler.module.normalization", {
          ["root_module"] = root_module,
          ["module_name"] = name,
          ["filename"] = snapshot_profile_filename(snapshot),
          ["cpu_ms"] = logging.elapsed_ms(normalization_started),
        })
      end
      if is_project and valid then entries[name] = imported[name] end
    end
  end
  if checked_set[root_module] and imported[root_module] == nil then
    modules[#modules + 1] = failed_project_snapshot(projects[root_module])
  end
  return AttemptResult.new(
    diagnostics, modules, contextual_resolutions, embedded_modules,
    checked, entries, failed)
end

local function emit_attempt_terminal(
    strategy: compiler_io.CompilerIO, attempt: integer, root_module: string,
    outcome: string, result: AttemptResult?, debugging: boolean,
    started_wall: integer, started_cpu: float)
  local checkpoints = compiler_io.finish_attempt(strategy, attempt)
  do
    if debugging then
      local checked = 0
      local snapshots = 0
      local diagnostics = 0
      if result ~= nil then
        checked = #result.checked
        snapshots = #result.modules
        diagnostics = #result.diagnostics
      end
      logging.emit("debug", "compiler.attempt.end", {
        ["attempt"] = attempt,
        ["root_module"] = root_module,
        ["outcome"] = outcome,
        ["checked_modules"] = checked,
        ["completed_modules"] = checkpoints,
        ["snapshots"] = snapshots,
        ["diagnostics"] = diagnostics,
        ["wall_ms"] = logging.elapsed_wall_ms(started_wall),
        ["cpu_ms"] = logging.elapsed_ms(started_cpu),
      })
    end
  catch
  end
end

local function Compiler:run_attempt(
    root_module: string, projects: {string: ProjectModule},
    overrides: {string: value},
    pending: {string: boolean}, cached: {string: CachedSourceInterface},
    raw_cached_interfaces: {string: value},
    c_header_analysis: value, header_inputs: value): AttemptResult
  local attempt = compiler_io.begin_attempt(self.io, root_module)
  local debugging = logging.enabled("debug")
  local started_cpu = 0.0
  local started_wall = 0
  do
    if debugging then
      started_cpu = logging.clock()
      started_wall = logging.wall_clock()
      logging.emit("debug", "compiler.attempt.start", {
        ["attempt"] = attempt,
        ["root_module"] = root_module,
      })
    end
  catch
    debugging = false
  end

  local result?: AttemptResult = nil
  do
    result = self:run_attempt_inner(
      root_module, projects, overrides, pending, cached,
      raw_cached_interfaces, c_header_analysis, header_inputs)
  catch
    local outcome = "failed"
    if error is async.CancellationReason then outcome = "cancelled" end
    emit_attempt_terminal(
      self.io, attempt, root_module, outcome, nil, debugging,
      started_wall, started_cpu)
    raise
  end
  emit_attempt_terminal(
    self.io, attempt, root_module, "complete", result, debugging,
    started_wall, started_cpu)
  return result
end

function Compiler:analyze_incremental(
    project_modules: {ProjectModule}, dirty_modules: {string},
    cached_sources: {CachedSourceInterface},
    progress_listener: ProgressListener?, header_inputs: {CHeaderDependency}?): Analysis
  local started = logging.clock()
  logging.emit("debug", "compiler.analysis.start", {
    ["project_modules"] = #project_modules,
    ["dirty_modules"] = #dirty_modules,
    ["cached_sources"] = #cached_sources,
  })
  local overrides, projects = project_loader_inputs(project_modules)
  local requested, ordered = requested_modules(dirty_modules, projects)
  local cached, raw_cached_interfaces = cached_source_map(
    cached_sources, projects)
  local raw_header_inputs: value = nil
  if header_inputs ~= nil then raw_header_inputs = raw_c_header_dependencies(header_inputs) end

  -- The compiler strategy reports every completed source module, including
  -- transitive external modules and possible repeats across root attempts.
  -- Reduce that stream to this request's unique dirty project modules and
  -- advance by their saved constituent-file counts exactly once.
  compiler_io.set_checkpoint_listener(self.io, nil)
  defer compiler_io.set_checkpoint_listener(self.io, nil)
  local mark_completed: (string) -> () = function (_name: string) end
  if progress_listener ~= nil then
    local notify: ProgressListener = progress_listener
    local file_counts: {string: integer} = {}
    local total_files = 0
    for index = 1, #ordered do
      local name = ordered[index]
      local count = #projects[name].files
      file_counts[name] = count
      total_files = total_files + count
    end
    local completed: {string: boolean} = {}
    local completed_files = 0
    emit_analysis_progress(notify, 0, total_files)
    mark_completed = function (module_name: string)
      if completed[module_name] or not requested[module_name] then return end
      completed[module_name] = true
      completed_files = completed_files + file_counts[module_name]
      emit_analysis_progress(notify, completed_files, total_files)
    end
    compiler_io.set_checkpoint_listener(
      self.io, function (module_name: string?)
        if module_name ~= nil then mark_completed(module_name) end
      end)
  end
  local permit = compiler_scheduler.acquire()
  defer permit:release()
  local previous_cppflags = install_extra_cppflags(self)
  defer self.driver["EXTRA_CPPFLAGS"] = previous_cppflags
  compiler_io.begin_lstat_observations(self.io)
  defer compiler_io.end_lstat_observations(self.io)
  validate_embedded_provider_baseline(self)

  local raw_new_c_header_analysis = checked_function(
    self.driver, DRIVER_MODULE, "new_c_header_analysis", self.type_of)
  local create_c_header_analysis =
    raw_new_c_header_analysis as () -> value
  local c_header_analysis = create_c_header_analysis()
  if self.type_of(c_header_analysis) ~= "table" then
    return fail<Analysis>(
      DRIVER_MODULE, "driver.new_c_header_analysis returned " ..
      describe(c_header_analysis, self.type_of) .. " instead of a table")
  end

  local previous_source_path: value = self.driver["TITAN_SOURCE_PATH"]
  local previous_binary_path: value = self.driver["TITAN_BIN_PATH"]
  defer self.driver["TITAN_SOURCE_PATH"] = previous_source_path
  defer self.driver["TITAN_BIN_PATH"] = previous_binary_path
  if self.source_path then
    self.driver["TITAN_SOURCE_PATH"] = self.source_path as string
  end
  if self.binary_path then
    self.driver["TITAN_BIN_PATH"] = self.binary_path as string
  end

  -- Purge deleted and invalidated project state before constructing any fresh
  -- resolver. A dirty module can never be seeded from an older generation.
  for name in iteration.pairs<string, value>(self.project_entries) do
    if projects[name] == nil or requested[name] then
      self.project_entries[name] = nil
      self.project_asts[name] = nil
    end
  end

  local pending: {string: boolean} = {}
  for index = 1, #ordered do pending[ordered[index]] = true end
  local diagnostics: {Diagnostic} = {}
  local result_normalization_work = NormalizationWork.new(0)
  local snapshots: {string: ModuleSnapshot} = {}
  local binary_provider_selections: {string: string} = {}
  local binary_provider_observation_keys: {string: boolean} = {}
  local binary_provider_selection_list: {BinaryProviderSelection} = {}
  local provider_conflicts: {string: boolean} = {}
  local contextual_resolutions: {ContextualResolution} = {}
  local normalized_contextual_resolutions:
    {NormalizedContextualResolution} = {}
  local embedded_modules: {string: boolean} = {}

  for index = 1, #ordered do
    local root = ordered[index]
    if pending[root] then
      local attempt_result?: AttemptResult = nil
      do
        attempt_result = self:run_attempt(
          root, projects, overrides, pending, cached,
          raw_cached_interfaces, c_header_analysis, raw_header_inputs)
      catch
        -- A non-cancellation compiler failure terminally processes this root
        -- even when it fails before the driver's normal publish/yield point.
        -- Cancellation makes no such completion claim.
        if not (error is async.CancellationReason) then mark_completed(root) end
        raise
      end
      local finished: AttemptResult = attempt_result
      for checked_index = 1, #finished.checked do
        mark_completed(finished.checked[checked_index])
      end
      if finished.failed[root] then mark_completed(root) end
      local attempt = finished
      append_diagnostics(
        diagnostics, attempt.diagnostics, result_normalization_work)
      for module_index = 1, #attempt.modules do
        local snapshot = attempt.modules[module_index]
        local embedded_provider =
          attempt.embedded_modules[snapshot.module_name] == true
        observe_binary_provider_selection(
          snapshot, embedded_provider, binary_provider_selections,
          binary_provider_observation_keys,
          binary_provider_selection_list, provider_conflicts)
        snapshots[snapshot.module_name] = snapshot
        embedded_modules[snapshot.module_name] = embedded_provider
      end
      for resolution_index = 1, #attempt.contextual_resolutions do
        normalized_contextual_resolutions[
          #normalized_contextual_resolutions + 1] =
          attempt.contextual_resolutions[resolution_index]
      end
      for name, entry in iteration.pairs<string, value>(attempt.entries) do
        self.project_entries[name] = entry
      end
      for checked_index = 1, #attempt.checked do
        local name = attempt.checked[checked_index]
        if requested[name] then pending[name] = nil end
      end
      if attempt.failed[root] then pending[root] = nil end
      -- Parsing may fail before the context publishes the root.
      if snapshots[root] ~= nil then pending[root] = nil end
    end
  end

  local modules: {ModuleSnapshot} = {}
  for index = 1, #project_modules do
    local name = project_modules[index].module_name
    local snapshot? = snapshots[name]
    if snapshot ~= nil then modules[#modules + 1] = snapshot end
  end
  local external_names: {string} = {}
  for name in iteration.pairs<string, ModuleSnapshot>(snapshots) do
    if projects[name] == nil then
      local position = #external_names + 1
      while position > 1 and external_names[position - 1] > name do
        external_names[position] = external_names[position - 1]
        position = position - 1
      end
      external_names[position] = name
    end
  end
  for index = 1, #external_names do
    modules[#modules + 1] = snapshots[external_names[index]]
  end
  local final_embedded_identity = validate_embedded_provider_baseline(self)
  attach_module_provider_identities(
    self, final_embedded_identity, modules, provider_conflicts,
    embedded_modules)
  contextual_resolutions = attach_contextual_provider_identities(
    self, final_embedded_identity, normalized_contextual_resolutions)
  local binary_provider_observations =
    attach_binary_provider_observations(
      self, final_embedded_identity, binary_provider_selection_list)
  local provider_conflict_names: {string} = {}
  for name, conflicted in iteration.pairs<string, boolean>(
      provider_conflicts) do
    if conflicted then provider_conflict_names[#provider_conflict_names + 1] = name end
  end
  sort_strings(provider_conflict_names, result_normalization_work)
  local result = Analysis.new(
    ordered[1], diagnostics, modules, contextual_resolutions,
    binary_provider_observations, provider_conflict_names)
  emit_cache_stats(self)
  logging.emit("debug", "compiler.analysis.complete", {
    ["root_module"] = ordered[1],
    ["diagnostics"] = #diagnostics,
    ["snapshots"] = #modules,
    ["cpu_ms"] = logging.elapsed_ms(started),
  })
  return result
catch
  if error is async.CancellationReason then raise end
  if error is BridgeError then raise end
  raise BridgeError.new(DRIVER_MODULE,
    "compiler analysis failed: " .. strings.tostring(error))
end

function Compiler:analyze(root_module: string,
                          project_modules: {ProjectModule}): Analysis
  local roots: {string} = {root_module}
  for index = 1, #project_modules do
    local name = project_modules[index].module_name
    if name ~= root_module then roots[#roots + 1] = name end
  end
  return self:analyze_incremental(project_modules, roots, {})
end

function Compiler:configure_cache(lookup: CacheLookup,
                                  publish: CachePublisher,
                                  refresh_inputs: CacheInputRefresher?)
  local get: (string, string) -> (string?, value) = function (
      kind: string, key: string): (string?, value)
    local payload?, inputs? = lookup(kind, key)
    if inputs == nil then return payload,nil end
    return payload,raw_c_header_dependencies(inputs)
  end
  local put: (string, string, string, value) -> boolean = function (
      kind: string, key: string, payload: string, raw_inputs: value): boolean
    local inputs: {CHeaderDependency} = {}
    if raw_inputs ~= nil then
      inputs = normalize_c_header_dependencies(raw_inputs,"persisted header inputs")
    end
    publish(kind, key, payload, inputs)
    return true
  end
  local adapter: {string: value} = {
    ["get"] = get, ["put"] = put, ["sha256_binary"] = content_identity.digest,
    ["yield"] = function () async.yield() end,
  }
  if refresh_inputs ~= nil then
    local refresh: CacheInputRefresher = refresh_inputs
    adapter["refresh_inputs"] = function (
        kind: string, key: string, inputs: value): boolean
      return refresh(kind,key,normalize_c_header_dependencies(
        inputs,"refreshed persisted header inputs"))
    end
  end
  self.cache_adapter = adapter
end

local function cache_project_files(projects: {ProjectModule}): {string: value}
  local files: {string: value} = {}
  for module_index = 1, #projects do
    for file_index = 1, #projects[module_index].files do
      files[projects[module_index].files[file_index].filename] = true
    end
  end
  return files
end

function Compiler:export_projects(projects: {ProjectModule}, selected_names: {string}):
    {ProjectPayload}
  local started = logging.clock()
  local permit = compiler_scheduler.acquire()
  defer permit:release()
  local encode = checked_function(self.driver, DRIVER_MODULE,
    "encode_project_entry", self.type_of) as (value, value) -> (value, value)
  local current_projects = project_index(projects)
  local files = cache_project_files(projects)
  local options: {string: value} = {
    ["project_files"] = files,["sha256_binary"] = content_identity.digest,
    ["yield"] = function () async.yield() end,
  }
  local result: {ProjectPayload} = {}
  local encoded_names: {string} = {}
  local payload_bytes = 0
  for index = 1, #selected_names do
    local name = selected_names[index]
    local entry: value = self.project_entries[name]
    if current_projects[name] ~= nil and entry ~= nil then
      local raw, failure = encode(entry, options)
      if raw is string then
        result[#result + 1] = ProjectPayload.new(name,raw as string)
        encoded_names[#encoded_names + 1] = name
        payload_bytes = payload_bytes + #(raw as string)
      else
        logging.emit("debug","cache.project.unrepresentable",{
          ["module"] = name, ["message"] = strings.tostring(failure),
        })
      end
    end
    -- Only the compiler permit is held. Let ordinary SQL feature requests
    -- keep reading the preceding publication between independent payloads.
    if index < #selected_names then async.yield() end
  end
  logging.emit("debug","cache.projects.encode",{
    ["modules"] = #result,["bytes"] = payload_bytes,["cpu_ms"] = logging.elapsed_ms(started),
    ["module_names"] = logging.summarize_strings(encoded_names),
  })
  return result
end

-- Decode literal compiler-owned data before attaching anything to the live
-- compiler. The temporary complete registry preserves source-private/generic
-- summary views; it never escapes the existing global compiler permit.
function Compiler:hydrate_project_cache(projects: {ProjectModule},
    names: {string}, read: ProjectPayloadReader,
    install: ProjectSnapshotInstaller): {string}
  local started = logging.clock()
  local permit = compiler_scheduler.acquire()
  defer permit:release()
  local decode = checked_function(self.driver, DRIVER_MODULE,
    "decode_project_entry",self.type_of) as (string, value) -> (value, value)
  local make_registry = checked_function(self.driver, DRIVER_MODULE,
    "project_entries_registry",self.type_of) as (value, value) -> (value, value)
  local project_map = project_index(projects)
  local files = cache_project_files(projects)
  local entries: {string: value} = {}
  for index = 1, #names do
    local name = names[index]
    local payload?, header_inputs? = read(name)
    if payload ~= nil and project_map[name] ~= nil then
      local options: {string: value} = {
        ["module_name"] = name, ["project_files"] = files,
        ["sha256_binary"] = content_identity.digest,
        ["yield"] = function () async.yield() end,
      }
      if header_inputs ~= nil then
        options["header_inputs"] = raw_c_header_dependencies(header_inputs)
      end
      local entry, failure = decode(payload,options)
      if entry ~= nil and entry ~= false then
        entries[name] = entry
      else
        logging.emit("debug","cache.project.miss",{
          ["module"] = name,["message"] = strings.tostring(failure),
        })
      end
    end
    if index < #names then async.yield() end
  end
  local registry, registry_error = make_registry(entries,{["yield"] = function () async.yield() end})
  if registry == nil or registry == false then
    logging.emit("debug","cache.project.registry_miss",{
      ["message"] = strings.tostring(registry_error),
    })
    return {}
  end
  local previous: value = self.types["registry"]
  defer self.types["registry"] = previous
  self.types["registry"] = required_map(registry,DRIVER_MODULE,"hydrated project registry")
  local result: {string} = {}
  local work = NormalizationWork.new(0)
  for index = 1, #projects do
    local name = projects[index].module_name
    local entry: value = entries[name]
    if entry ~= nil then
      do
        local normalized = snapshot_module(self,name,entry,project_map,{},true,work,true)
        if install(name,normalized.snapshot) then
          self.project_asts[name] = required_map(entry,DRIVER_MODULE,
            "hydrated project entry")["ast"]
          self.project_entries[name] = entry
          result[#result + 1] = name
        else
          self:drop_project_ast(name)
        end
      catch
        if error is async.CancellationReason then raise end
        self:drop_project_ast(name)
        logging.emit("debug","cache.project.normalization_miss",{
          ["module"] = name,["message"] = strings.tostring(error),
        })
      end
    end
  end
  logging.emit("debug","cache.projects.hydrate",{
    ["requested"] = #names,["restored"] = #result,["cpu_ms"] = logging.elapsed_ms(started),
  })
  return result
end


function Compiler:hydrate_projects(projects: {ProjectModule},
                                    payloads: {ProjectPayload}): {ModuleSnapshot}
  local names: {string} = {}
  local saved: {string: string} = {}
  local observed: {string: {CHeaderDependency}} = {}
  for index = 1, #payloads do
    local item = payloads[index]
    names[index] = item.module_name
    saved[item.module_name] = item.payload
    if item.header_inputs ~= nil then observed[item.module_name] = item.header_inputs end
  end
  local snapshots: {ModuleSnapshot} = {}
  self:hydrate_project_cache(projects,names,
    function (name: string): (string?,{CHeaderDependency}?)
      return saved[name],observed[name]
    end,
    function (_name: string,snapshot: ModuleSnapshot): boolean
      snapshots[#snapshots + 1] = snapshot
      return true
    end)
  return snapshots
end

local function containing_directory(path: string): string
  local slash = 0
  for index = 1, #path do
    if strings.byte(path,index) == 47 then slash = index end
  end
  if slash == 0 then return "." end
  if slash == 1 then return "/" end
  return strings.sub(path,1,slash-1)
end

local function hash_compiler_tree(directory: string, output: strings.StringWriter,
    fingerprint: (string) -> string)
  local entries = fs.list(directory)
  local names: {string} = {}
  for index = 1, #entries do names[index] = entries[index] end
  sort_strings(names,NormalizationWork.new(0))
  for index = 1, #names do
    local path = directory .. "/" .. names[index]
    local metadata? = fs.stat(path)
    if metadata ~= nil then
      if metadata.kind == "directory" then
        hash_compiler_tree(path,output,fingerprint)
      elseif metadata.kind == "file" and strings.sub(path,-4) == ".lua" then
        output:write(#path .. ":" .. path)
        output:write(fingerprint(path))
      end
    end
  end
end

-- The native world can consult completed header graphs, so the workspace
-- transport must be configured before this second compatibility check.
function Compiler:native_cache_identity(): string
  local permit = compiler_scheduler.acquire()
  defer permit:release()
  local previous_cppflags = install_extra_cppflags(self)
  defer self.driver["EXTRA_CPPFLAGS"] = previous_cppflags
  local context = new_context(self,nil)
  defer close_context(self,context)
  local cache_identity = checked_function(self.driver,DRIVER_MODULE,
    "language_server_cache_identity",self.type_of) as (value) -> (value,value)
  local options: {string: value} = {["context"] = context}
  local raw, failure = cache_identity(options)
  if not (raw is string) then
    return fail<string>(DRIVER_MODULE,"cannot identify compiler cache context: " .. strings.tostring(failure))
  end
  emit_cache_stats(self)
  return content_identity.digest(raw as string)
end

-- Resolve the inventory before any C probing. This namespace is sufficient to
-- open the transport: each header/conversion key also carries its native world.
-- Project hydration additionally requires native_cache_identity above.
function Compiler:cache_identity(observed_fingerprint: ((string) -> string)?): string
  local permit = compiler_scheduler.acquire()
  defer permit:release()
  local output = strings.writer()
  output:write("titan-ls-sqlite-schema-3-api-" .. COMPILER_LANGUAGE_SERVER_API)
  local fingerprint: (string) -> string = function (path: string): string
    return content_identity.file(path,fs.read_file(path))
  end
  if observed_fingerprint ~= nil then fingerprint = observed_fingerprint end
  -- The reviewed Lua helper only resolves the active package search paths.
  -- Filesystem reads and fingerprints stay in typed Titan below this boundary.
  local raw_resolve: value = lua.load([[
return function(name, native)
  return package.searchpath(name, native and package.cpath or package.path)
end
]],"=compiler_bridge.cache_module_path",nil)()
  local resolve = raw_resolve as (string,boolean) -> (string?,string?)
  local compiler_path?, compiler_error? = resolve(DRIVER_MODULE,false)
  local parser_path?, parser_error? = resolve("c-parser.cdriver",false)
  if compiler_path == nil or parser_path == nil then
    return fail<string>(DRIVER_MODULE,"cannot identify compiler sources: " ..
      strings.tostring(compiler_error) .. strings.tostring(parser_error))
  end
  hash_compiler_tree(containing_directory(compiler_path),output,fingerprint)
  hash_compiler_tree(containing_directory(parser_path),output,fingerprint)
  local dependencies = {"relabel","inspect","lfs","lpeglabel"}
  for index = 1, #dependencies do
    local path?, path_error? = resolve(dependencies[index],index > 2)
    if path == nil then
      return fail<string>(DRIVER_MODULE,"cannot identify compiler dependency: " .. strings.tostring(path_error))
    end
    output:write(#path .. ":" .. path)
    output:write(fingerprint(path))
  end
  -- This image owns the complete static provider and embedded target/interface
  -- inventory, including libraries not linked by application declarations.
  output:write(fingerprint(self.embedded_provider_file))
  return content_identity.digest(output:drain())
end
