--- Convert source byte offsets, LSP UTF-16 coordinates, filesystem paths, and file URIs.
-- @module server.source_text

local strings = import "string"
local paths = import "path"
foreign import "compiler_io_platform.h"

-- ByteOffset uses the usual half-open, zero-based convention. Position is the
-- zero-based UTF-16 coordinate required by LSP.
--- Zero-based LSP line and UTF-16 code-unit position.
record Position
  line: integer
  character: integer
end

--- LSP range with an inclusive start and exclusive end.
record Span
  start: Position
  finish: Position
end

--- Byte-offset range used at the source and compiler boundary.
record ByteSpan
  start: integer
  finish: integer
end

record Error
  message: string
  byte_offset: integer?
end

local record CodePoint
  scalar: integer
  next_index: integer
end

local function fail<|T|>(message: string, byte_offset: integer?): T
  raise Error.new(message, byte_offset)
end

local function continuation(byte: integer): boolean
  return byte >= 0x80 and byte <= 0xbf
end

-- Decode one UTF-8 scalar at a one-based byte index. Invalid encodings,
-- overlong forms, surrogates, and values above U+10FFFF are rejected.
local function decode(source: string, index: integer): CodePoint
  local first: integer = strings.byte(source, index)
  if first <= 0x7f then return CodePoint.new(first, index + 1) end

  if first >= 0xc2 and first <= 0xdf then
    if index + 1 > #source then
      return fail<|CodePoint|>("truncated UTF-8 sequence", index - 1)
    end
    local second: integer = strings.byte(source, index + 1)
    if not continuation(second) then
      return fail<|CodePoint|>("invalid UTF-8 continuation byte", index)
    end
    return CodePoint.new(
      (first - 0xc0) * 0x40 + (second - 0x80), index + 2)
  end

  if first >= 0xe0 and first <= 0xef then
    if index + 2 > #source then
      return fail<|CodePoint|>("truncated UTF-8 sequence", index - 1)
    end
    local second: integer = strings.byte(source, index + 1)
    local third: integer = strings.byte(source, index + 2)
    if not continuation(third) then
      return fail<|CodePoint|>("invalid UTF-8 continuation byte", index + 1)
    end
    if first == 0xe0 then
      if second < 0xa0 or second > 0xbf then
        return fail<|CodePoint|>("invalid UTF-8 sequence", index - 1)
      end
    elseif first == 0xed then
      if second < 0x80 or second > 0x9f then
        return fail<|CodePoint|>("UTF-8 cannot encode a surrogate", index - 1)
      end
    elseif not continuation(second) then
      return fail<|CodePoint|>("invalid UTF-8 continuation byte", index)
    end
    return CodePoint.new(
      (first - 0xe0) * 0x1000 +
      (second - 0x80) * 0x40 +
      (third - 0x80), index + 3)
  end

  if first >= 0xf0 and first <= 0xf4 then
    if index + 3 > #source then
      return fail<|CodePoint|>("truncated UTF-8 sequence", index - 1)
    end
    local second: integer = strings.byte(source, index + 1)
    local third: integer = strings.byte(source, index + 2)
    local fourth: integer = strings.byte(source, index + 3)
    if not continuation(third) or not continuation(fourth) then
      return fail<|CodePoint|>("invalid UTF-8 continuation byte", index + 1)
    end
    if first == 0xf0 then
      if second < 0x90 or second > 0xbf then
        return fail<|CodePoint|>("invalid UTF-8 sequence", index - 1)
      end
    elseif first == 0xf4 then
      if second < 0x80 or second > 0x8f then
        return fail<|CodePoint|>("UTF-8 scalar is above U+10FFFF", index - 1)
      end
    elseif not continuation(second) then
      return fail<|CodePoint|>("invalid UTF-8 continuation byte", index)
    end
    return CodePoint.new(
      (first - 0xf0) * 0x40000 +
      (second - 0x80) * 0x1000 +
      (third - 0x80) * 0x40 +
      (fourth - 0x80), index + 4)
  end

  return fail<|CodePoint|>("invalid UTF-8 leading byte", index - 1)
end

local function utf16_width(codepoint: integer): integer
  if codepoint > 0xffff then return 2 end
  return 1
end

-- A line keeps only the non-ASCII scalar checkpoints where byte and UTF-16
-- coordinates diverge. ASCII offsets therefore convert in O(1) after the
-- line lookup, while Unicode offsets need only a binary search through that
-- line's compact checkpoints.
local record ScalarCheckpoint
  const byte_start: integer
  const byte_finish: integer
  const utf16_start: integer
  const utf16_finish: integer
end

local record IndexedLine
  const start_offset: integer
  const content_finish_offset: integer
  const next_start_offset: integer
  const utf16_length: integer
  const checkpoints: {ScalarCheckpoint}
end

-- Source-private deterministic instrumentation lets the stress tests assert
-- an operation budget instead of depending on machine-specific wall time.
local record CoordinateWork
  steps: integer
end

type Yield = function (): ()
type WorkAccount = function (): ()

local YIELD_CADENCE = 1024

--- Reusable mapping from exact source bytes to LSP UTF-16 positions.
record CoordinateIndex
  local const source: string
  local const lines: {IndexedLine}
  local const lf_line_starts: {integer}
  local const lf_line_finishes: {integer}
  local const valid_finish_offset: integer
  local const valid_finish_position: Position
  local const failure: Error?
  local const work: CoordinateWork?
end

local function count_step(work: CoordinateWork?)
  if work ~= nil then work.steps = work.steps + 1 end
end

local function account_yield_work(yield_now: Yield?, work: integer): integer
  if yield_now == nil then return 0 end
  local next_work = work + 1
  if next_work < YIELD_CADENCE then return next_work end
  yield_now()
  return 0
end

local function account_coordinate_work(work: CoordinateWork?,
                                       yield_now: Yield?,
                                       account_now: WorkAccount?,
                                       yield_work: integer): integer
  count_step(work)
  if account_now ~= nil then
    account_now()
    return yield_work
  end
  return account_yield_work(yield_now, yield_work)
end

local function try_decode(source: string, index: integer):
    (CodePoint?, Error?)
  do
    return decode(source, index), nil
  catch
    if error is Error then return nil, error as Error end
    raise
  end
end

local function build_coordinate_index(source: string,
                                      work: CoordinateWork?,
                                      yield_now: Yield?,
                                      account_now: WorkAccount?): CoordinateIndex
  local lines: {IndexedLine} = {}
  local lf_line_starts: {integer} = {0}
  local lf_line_finishes: {integer} = {}
  local checkpoints: {ScalarCheckpoint} = {}
  local line_start_offset = 0
  local character = 0
  local index = 1
  local failure?: Error
  local valid_finish_offset = #source
  local valid_finish_position = Position.new(0, 0)
  local yield_work = 0

  while index <= #source do
    yield_work = account_coordinate_work(
      work, yield_now, account_now, yield_work)
    local byte: integer = strings.byte(source, index)
    if byte == 0x0d then
      local content_finish_offset = index - 1
      local next_start_offset = index
      if index + 1 <= #source and
         strings.byte(source, index + 1) == 0x0a then
        -- The LF is the compiler's line ending. Its zero-based byte offset is
        -- the current one-based CR index.
        lf_line_finishes[#lf_line_finishes + 1] = index
        lf_line_starts[#lf_line_starts + 1] = index + 1
        next_start_offset = index + 1
        index = index + 2
      else
        index = index + 1
      end
      lines[#lines + 1] = IndexedLine.new(
        line_start_offset, content_finish_offset, next_start_offset,
        character, checkpoints)
      line_start_offset = next_start_offset
      character = 0
      checkpoints = {}
    elseif byte == 0x0a then
      local finish_offset = index - 1
      local next_start_offset = index
      lf_line_finishes[#lf_line_finishes + 1] = finish_offset
      lf_line_starts[#lf_line_starts + 1] = next_start_offset
      lines[#lines + 1] = IndexedLine.new(
        line_start_offset, finish_offset, next_start_offset,
        character, checkpoints)
      line_start_offset = next_start_offset
      character = 0
      checkpoints = {}
      index = index + 1
    else
      local decoded?, decode_error? = try_decode(source, index)
      if decoded == nil then
        failure = decode_error
        valid_finish_offset = index - 1
        valid_finish_position = Position.new(#lines, character)
        lines[#lines + 1] = IndexedLine.new(
          line_start_offset, valid_finish_offset, valid_finish_offset,
          character, checkpoints)
        break
      end
      local width = utf16_width(decoded.scalar)
      if decoded.next_index ~= index + 1 then
        checkpoints[#checkpoints + 1] = ScalarCheckpoint.new(
          index - 1, decoded.next_index - 1,
          character, character + width)
      end
      character = character + width
      index = decoded.next_index
    end
  end

  if failure == nil then
    lines[#lines + 1] = IndexedLine.new(
      line_start_offset, #source, #source, character, checkpoints)
    valid_finish_position = Position.new(#lines - 1, character)
  else
    -- UTF-16 queries after the first malformed scalar reproduce the decoder
    -- failure, but compiler LF-byte locations still need a complete line
    -- table. Finish that raw byte table without attempting another decode.
    while index <= #source do
      yield_work = account_coordinate_work(
        work, yield_now, account_now, yield_work)
      if strings.byte(source, index) == 0x0a then
        lf_line_finishes[#lf_line_finishes + 1] = index - 1
        lf_line_starts[#lf_line_starts + 1] = index
      end
      index = index + 1
    end
  end
  lf_line_finishes[#lf_line_finishes + 1] = #source

  return CoordinateIndex.new(
    source, lines, lf_line_starts, lf_line_finishes,
    valid_finish_offset, valid_finish_position, failure, work)
end

--- Build a coordinate mapping over one immutable source string.
function coordinate_index(source: string): CoordinateIndex
  return build_coordinate_index(source, nil, nil, nil)
end

function coordinate_index_with_yield(source: string,
                                     yield_now: Yield): CoordinateIndex
  return build_coordinate_index(source, nil, yield_now, nil)
end

-- Let a caller share one work budget across coordinate construction and its
-- surrounding operation. The callback accounts one decoded scalar or line
-- ending and decides when the actual cooperative yield occurs.
function coordinate_index_with_account(source: string,
                                       account_now: WorkAccount):
    CoordinateIndex
  return build_coordinate_index(source, nil, nil, account_now)
end

local function coordinate_index_with_work(source: string, yield_now: Yield?):
    (CoordinateIndex, CoordinateWork)
  local work = CoordinateWork.new(0)
  return build_coordinate_index(source, work, yield_now, nil), work
end

local function coordinate_work_steps(work: CoordinateWork): integer
  return work.steps
end

local function position_less(left: Position, right: Position): boolean
  return left.line < right.line or
         (left.line == right.line and left.character < right.character)
end

local function indexed_line_for_offset(self: CoordinateIndex,
                                       byte_offset: integer):
    (IndexedLine, integer)
  local low = 1
  local high = #self.lines
  local found = 1
  while low <= high do
    count_step(self.work)
    local middle = (low + high) // 2
    if self.lines[middle].start_offset <= byte_offset then
      found = middle
      low = middle + 1
    else
      high = middle - 1
    end
  end
  return self.lines[found], found
end

local function completed_byte_checkpoints(
    self: CoordinateIndex, line: IndexedLine,
    byte_offset: integer): integer
  local low = 1
  local high = #line.checkpoints
  local completed = 0
  while low <= high do
    count_step(self.work)
    local middle = (low + high) // 2
    if line.checkpoints[middle].byte_finish <= byte_offset then
      completed = middle
      low = middle + 1
    else
      high = middle - 1
    end
  end
  return completed
end

--- Convert a validated source byte offset to an LSP UTF-16 position.
function CoordinateIndex:position_for_offset(byte_offset: integer):
    (Position?, Error?)
  if byte_offset < 0 or byte_offset > #self.source then
    return nil, Error.new(
      "byte offset is outside the source text", byte_offset)
  end
  if self.failure ~= nil and byte_offset > self.valid_finish_offset then
    return nil, self.failure
  end

  local line, line_number = indexed_line_for_offset(self, byte_offset)
  if byte_offset > line.content_finish_offset then
    return nil, Error.new(
      "byte offset splits a CRLF line ending", byte_offset)
  end

  local completed = completed_byte_checkpoints(self, line, byte_offset)
  local next_checkpoint? = line.checkpoints[completed + 1]
  if next_checkpoint ~= nil and
     byte_offset > next_checkpoint.byte_start and
     byte_offset < next_checkpoint.byte_finish then
    return nil, Error.new("byte offset splits a UTF-8 scalar", byte_offset)
  end

  local adjustment = 0
  if completed > 0 then
    local checkpoint = line.checkpoints[completed]
    adjustment = checkpoint.utf16_finish -
      (checkpoint.byte_finish - line.start_offset)
  end
  return Position.new(
    line_number - 1,
    byte_offset - line.start_offset + adjustment), nil
end

local function completed_utf16_checkpoints(
    self: CoordinateIndex, line: IndexedLine,
    character: integer): integer
  local low = 1
  local high = #line.checkpoints
  local completed = 0
  while low <= high do
    count_step(self.work)
    local middle = (low + high) // 2
    if line.checkpoints[middle].utf16_finish <= character then
      completed = middle
      low = middle + 1
    else
      high = middle - 1
    end
  end
  return completed
end

--- Convert an LSP UTF-16 position to its exact source byte offset.
function CoordinateIndex:offset_for_position(position: Position):
    (integer?, Error?)
  if position.line < 0 or position.character < 0 then
    return nil, Error.new("LSP positions cannot be negative", nil)
  end
  if self.failure ~= nil and
     position_less(self.valid_finish_position, position) then
    return nil, self.failure
  end
  if position.line + 1 > #self.lines then
    return nil, Error.new("LSP line is outside the source text", nil)
  end

  local line = self.lines[position.line + 1]
  if position.character > line.utf16_length then
    local ending_offset?: integer
    if line.next_start_offset > line.content_finish_offset then
      ending_offset = line.content_finish_offset
    end
    return nil, Error.new("LSP character is outside its line", ending_offset)
  end

  local completed = completed_utf16_checkpoints(
    self, line, position.character)
  local next_checkpoint? = line.checkpoints[completed + 1]
  if next_checkpoint ~= nil and
     position.character > next_checkpoint.utf16_start and
     position.character < next_checkpoint.utf16_finish then
    return nil, Error.new(
      "LSP character splits a UTF-16 surrogate pair",
      next_checkpoint.byte_start)
  end

  local adjustment = 0
  if completed > 0 then
    local checkpoint = line.checkpoints[completed]
    adjustment = checkpoint.byte_finish - line.start_offset -
      checkpoint.utf16_finish
  end
  return line.start_offset + position.character + adjustment, nil
end

function CoordinateIndex:span_for_offsets(start_offset: integer,
                                          finish_offset: integer):
    (Span?, Error?)
  if finish_offset < start_offset then
    return nil, Error.new("span finish precedes its start", finish_offset)
  end
  local start?, start_error? = self:position_for_offset(start_offset)
  if start == nil then return nil, start_error end
  local finish?, finish_error? = self:position_for_offset(finish_offset)
  if finish == nil then return nil, finish_error end
  return Span.new(start, finish), nil
end

function CoordinateIndex:offsets_for_span(span: Span): (ByteSpan?, Error?)
  local start?, start_error? = self:offset_for_position(span.start)
  if start == nil then return nil, start_error end
  local finish?, finish_error? = self:offset_for_position(span.finish)
  if finish == nil then return nil, finish_error end
  if finish < start then
    return nil, Error.new("span finish precedes its start", finish)
  end
  return ByteSpan.new(start, finish), nil
end

-- Compiler locations count only LF and use one-based byte columns. These
-- constant-time accessors let semantic indexing share the same per-file scan
-- without teaching SourceText about compiler records.
function CoordinateIndex:lf_line_start(line: integer): integer?
  if line < 1 or line > #self.lf_line_starts then return nil end
  return self.lf_line_starts[line]
end

function CoordinateIndex:lf_line_finish(line: integer): integer?
  if line < 1 or line > #self.lf_line_finishes then return nil end
  return self.lf_line_finishes[line]
end

function CoordinateIndex:offset_for_lf_byte_position(
    line: integer, column: integer): integer?
  if line < 1 or column < 1 then return nil end
  local start? = self:lf_line_start(line)
  local finish? = self:lf_line_finish(line)
  if start == nil or finish == nil then return nil end
  local target = start + column - 1
  if target > finish then return nil end
  return target
end

function position_for_offset(source: string, byte_offset: integer):
    (Position?, Error?)
  return coordinate_index(source):position_for_offset(byte_offset)
end

function offset_for_position(source: string, position: Position):
    (integer?, Error?)
  return coordinate_index(source):offset_for_position(position)
end

function span_for_offsets(source: string, start_offset: integer,
                          finish_offset: integer): (Span?, Error?)
  return coordinate_index(source):span_for_offsets(start_offset, finish_offset)
end

function offsets_for_span(source: string, span: Span): (ByteSpan?, Error?)
  return coordinate_index(source):offsets_for_span(span)
end

local function is_hex(byte: integer): boolean
  if byte >= 48 and byte <= 57 then return true end
  if byte >= 65 and byte <= 70 then return true end
  return byte >= 97 and byte <= 102
end

local function hex_value(byte: integer): integer
  if byte >= 48 and byte <= 57 then return byte - 48 end
  if byte >= 65 and byte <= 70 then return byte - 65 + 10 end
  return byte - 97 + 10
end

local function valid_unc_authority(authority: string): boolean
  if authority == "" or authority == "." or authority == ".." then return false end
  for index = 1, #authority do
    local byte: integer = strings.byte(authority, index)
    local valid = byte == 45 or byte == 46 or byte == 95
    if byte >= 65 and byte <= 90 then valid = true end
    if byte >= 97 and byte <= 122 then valid = true end
    if byte >= 48 and byte <= 57 then valid = true end
    if not valid then return false end
  end
  return true
end

-- Project and URI identities deliberately keep forward slashes and uppercase
-- drive letters. Titan owns native volume grammar; this boundary additionally
-- rejects incomplete UNC roots and namespaces that cannot represent file URIs.
local function windows_root(subject: string): string?
  if not paths.is_absolute(subject) then return nil end
  local volume = paths.to_slash(paths.volume(subject))
  local first: integer = strings.byte(volume, 1) or 0
  local drive = false
  if first >= 65 and first <= 90 then drive = true end
  if first >= 97 and first <= 122 then drive = true end
  if #volume == 2 and drive and strings.sub(volume, 2) == ":" then
    return strings.upper(volume) .. "/"
  end
  if strings.sub(volume, 1, 2) ~= "//" then return nil end
  local server_end? = strings.find(volume, "/", 3)
  if server_end == nil then return nil end
  local server = strings.sub(volume, 3, server_end - 1)
  local share = strings.sub(volume, server_end + 1)
  if not valid_unc_authority(server) or share == "" or
     share == "." or share == ".." or strings.find(share, "/") ~= nil then
    return nil
  end
  return volume
end

local function normalize_absolute_or_raise(subject: string): string
  if strings.find(subject, "\0") ~= nil then
    return fail<|string|>("path contains a NUL byte", nil)
  end
  local root = "/"
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then
    local found? = windows_root(subject)
    if found == nil then
      return fail<|string|>("path must be a fully qualified drive or UNC path", nil)
    end
    root = found
  elseif not paths.is_absolute(subject) then
    return fail<|string|>("path must be absolute", nil)
  end
  local normalized = paths.to_slash(paths.normalize(subject))
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then
    local volume = paths.to_slash(paths.volume(subject))
    if #volume == 2 then
      normalized = root .. strings.sub(normalized, #volume + 2)
    elseif strings.sub(normalized, -1) == "/" then
      normalized = strings.sub(normalized, 1, -2)
    end
  end
  return normalized
end

function is_absolute_path(subject: string): boolean
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then return windows_root(subject) ~= nil end
  return paths.is_absolute(subject)
end

function normalize_absolute_path(path: string): (string?, Error?)
  do
    return normalize_absolute_or_raise(path), nil
  catch
    if error is Error then return nil, error as Error end
    raise
  end
end

local function resolve_path_or_raise(base: string, subject: string): string
  local normalized_base = normalize_absolute_or_raise(base)
  if paths.is_absolute(subject) then return normalize_absolute_or_raise(subject) end
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then
    -- Current-drive roots and drive-relative names need process-global drive
    -- state, which cannot participate in a stable project identity.
    if strings.sub(paths.to_slash(subject), 1, 1) == "/" or
       paths.volume(subject) ~= "" then
      return fail<|string|>("path must be a fully qualified drive or UNC path", nil)
    end
  end
  return normalize_absolute_or_raise(paths.join(normalized_base, subject))
end

function resolve_path(base: string, path: string): (string?, Error?)
  do
    return resolve_path_or_raise(base, path), nil
  catch
    if error is Error then return nil, error as Error end
    raise
  end
end

local function relative_path_or_raise(root: string, path: string): string?
  local normalized_root = normalize_absolute_or_raise(root)
  local normalized_path = normalize_absolute_or_raise(path)
  if normalized_path == normalized_root then return "" end
  local prefix = normalized_root
  if strings.sub(prefix, -1) ~= "/" then prefix = prefix .. "/" end
  if strings.sub(normalized_path, 1, #prefix) ~= prefix then return nil end
  return strings.sub(normalized_path, #prefix + 1)
end

function relative_path(root: string, path: string): string?
  do
    return relative_path_or_raise(root, path)
  catch
    if error is Error then return nil end
    raise
  end
end

local function decode_uri_path(source: string): string
  local output = strings.writer()
  local index = 1
  while index <= #source do
    local byte: integer = strings.byte(source, index)
    if byte == 37 then
      if index + 2 > #source then
        return fail<|string|>("malformed percent escape in file URI", index - 1)
      end
      local high: integer = strings.byte(source, index + 1)
      local low: integer = strings.byte(source, index + 2)
      if not is_hex(high) or not is_hex(low) then
        return fail<|string|>("malformed percent escape in file URI", index - 1)
      end
      output:write(strings.char(hex_value(high) * 16 + hex_value(low)))
      index = index + 3
    else
      output:write(strings.char(byte))
      index = index + 1
    end
  end
  return output:drain()
end

local function file_uri_to_path_or_raise(uri: string): string
  local windows = ffi.VSCODE_TITAN_WINDOWS ~= 0
  if strings.sub(uri, 1, 7) ~= "file://" then
    return fail<|string|>("URI must use the file scheme", nil)
  end
  if strings.find(uri, "?", 8) ~= nil or strings.find(uri, "#", 8) ~= nil then
    return fail<|string|>("file URI query and fragment must be percent encoded",
                        nil)
  end

  local remainder = strings.sub(uri, 8)
  local encoded_path = remainder
  local authority = ""
  if strings.sub(remainder, 1, 1) == "/" then
    encoded_path = remainder
  else
    local slash? = strings.find(remainder, "/")
    if slash == nil then
      return fail<|string|>("file URI has no absolute path", nil)
    end
    authority = strings.sub(remainder, 1, slash - 1)
    if authority ~= "localhost" and
       not (windows and strings.lower(authority) == "localhost") then
      if not windows then
        return fail<|string|>("file URI has a non-local authority", nil)
      end
      -- UNC authorities are host names, never userinfo, ports, or encoded
      -- separators. Keep their spelling; realpath owns physical identity.
      if not valid_unc_authority(authority) then
        return fail<|string|>("invalid UNC file URI authority", nil)
      end
      encoded_path = "//" .. authority .. strings.sub(remainder, slash)
    else
      encoded_path = strings.sub(remainder, slash)
    end
  end
  local path = decode_uri_path(encoded_path)
  if windows and strings.sub(path, 1, 1) == "/" and
     strings.sub(path, 3, 4) == ":/" then
    path = strings.sub(path, 2)
  elseif windows and strings.lower(authority) == "localhost" then
    -- VS Code also uses a localhost authority for a UNC share. A qualified
    -- drive path above is local; a share path retains the UNC host.
    path = "//" .. authority .. path
  end
  return normalize_absolute_or_raise(path)
end

--- Decode and validate a local file URI into a normalized filesystem path.
function file_uri_to_path(uri: string): (string?, Error?)
  do
    return file_uri_to_path_or_raise(uri), nil
  catch
    if error is Error then return nil, error as Error end
    raise
  end
end

local function uri_safe(byte: integer): boolean
  if byte >= 65 and byte <= 90 then return true end
  if byte >= 97 and byte <= 122 then return true end
  if byte >= 48 and byte <= 57 then return true end
  if byte == 45 then return true end
  if byte == 46 then return true end
  if byte == 95 then return true end
  if byte == 126 then return true end
  if byte == 47 then return true end
  return byte == 58
end

local function hex_digit(nibble: integer): string
  return strings.sub("0123456789ABCDEF", nibble + 1, nibble + 1)
end

local function path_to_file_uri_or_raise(path: string): string
  local windows = ffi.VSCODE_TITAN_WINDOWS ~= 0
  local normalized = normalize_absolute_or_raise(path)
  local output = strings.writer()
  output:write("file://")
  if windows then
    if strings.sub(normalized, 1, 2) == "//" then
      normalized = strings.sub(normalized, 3)
    else
      output:write("/")
    end
  end
  for index = 1, #normalized do
    local byte: integer = strings.byte(normalized, index)
    if uri_safe(byte) then
      output:write(strings.char(byte))
    else
      output:write("%")
      output:write(hex_digit(byte // 16))
      output:write(hex_digit(byte % 16))
    end
  end
  return output:drain()
end

--- Encode a normalized absolute filesystem path as a file URI.
function path_to_file_uri(path: string): (string?, Error?)
  do
    return path_to_file_uri_or_raise(path), nil
  catch
    if error is Error then return nil, error as Error end
    raise
  end
end
