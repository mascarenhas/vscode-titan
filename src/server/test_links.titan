foreign import "compiler_io_platform.h"
local async = import "async"
local fs = import "fs"
local os = import "os"
local strings = import "string"
local test = import "test"

-- Directory-link fixtures retain their native path arguments and report a
-- missing Windows privilege only after the actual creation attempt.
local function spawn_link(source: string, link: string): integer
  local command = "/bin/ln"
  local arguments = {"-s", source, link}
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then
    local fixture? = os.getenv("TITAN_COMPILER_IO_PROCESS_FIXTURE")
    test.assert(fixture ~= nil and #fixture > 0,
      "directory-link tests require TITAN_COMPILER_IO_PROCESS_FIXTURE")
    command = fixture
    arguments = {"directory-symbolic-link", source, link}
  end
  local linker = os.spawn(command, arguments)
  local link_input? = linker.stdin
  if link_input ~= nil then link_input:close() end
  local status = linker:wait()
  local link_output? = linker.stdout
  if link_output ~= nil then link_output:close() end
  local link_error? = linker.stderr
  if link_error ~= nil then link_error:close() end
  if status.signal ~= nil then return -1 end
  return status.code
end

local checked = false
local reason: string? = nil

-- Windows marks a link created without SeCreateSymbolicLinkPrivilege as an
-- untrusted mount point and refuses to traverse it, so creation alone does not
-- make the fixture usable. Probe once in a scratch directory: a fixture that
-- cannot be used must not be created at all, because removing it afterwards
-- also fails and would replace the skip with its own error.
local function windows_link_failure(): string?
  if checked then return reason end
  checked = true
  if ffi.VSCODE_TITAN_WINDOWS == 0 then return nil end
  local scratch = fs.tmpname()
  fs.unlink(scratch)
  fs.mkdir(scratch)
  local source = scratch .. "/source"
  fs.mkdir(source)
  local link = scratch .. "/link"
  local code = spawn_link(source, link)
  if code == 1314 then
    reason = "Windows account cannot create directory symbolic links (Win32 1314)"
  elseif code ~= 0 then
    reason = "Windows account cannot create directory symbolic links (Win32 " ..
      strings.tostring(code) .. ")"
  else
    do
      fs.realpath(link)
    catch
      if error is async.CancellationReason then raise end
      reason = "Windows refuses to traverse the created directory link " ..
        "(untrusted mount point)"
    end
  end
  do
    fs.unlink(link)
  catch
    if error is async.CancellationReason then raise end
  end
  do
    fs.rmdir(source)
    fs.rmdir(scratch)
  catch
    if error is async.CancellationReason then raise end
  end
  return reason
end

--- Link `source` to `link`, or skip while the host cannot provide a usable
--- directory link.
function directory(source: string, link: string, message: string)
  local failure? = windows_link_failure()
  if failure ~= nil then test.skip(failure) end
  local code = spawn_link(source, link)
  test.assert(code == 0, message)
end
