local async = import "async"
local fs = import "fs"
local json = import "json"
local strings = import "string"
local bridge = import "server.compiler_bridge"
local diagnostics = import "server.diagnostics"
local dispatcher = import "server.dispatcher"
local coordinator = import "server.coordinator"
local document_buffers = import "server.document_buffers"
local completion_service = import "server.completion_service"
local indexing_status = import "server.indexing_status"
local wire = import "server.wire"
local logging = import "server.logging"
local lsp = import "server.lsp_types"
local project_discovery = import "server.project_discovery"
local project_service = import "server.project_service"
local project_loader = import "server.project_loader"
local published_diagnostics = import "server.published_diagnostics"
local semantic_index = import "server.semantic_index"
local sqlite3 = import "sqlite3"
local stores = import "server.workspace_store"
local project_watcher = import "server.project_watcher"
local semantic_features = import "server.semantic_features"

record Error
  const message: string
end

local record View
  const work_generation: integer
  const published_generation: integer
  const dirty_signature: string
  const features: semantic_features.Features
end

local union RefreshOutcome
  ready(View)
  failure(Error)
end

-- Watch backends publish canonical paths, while project configuration retains
-- its lexical identity (including configured symlinks). Build both identities
-- while reconciling registrations so the poll callback itself only performs
-- bounded string/table work and cannot be cancelled between a hint and its
-- epoch increment.
local record WatchFilter
  const include_roots: {string}
  const source_roots: {string}
  const excluded_paths: {string}
  const cache_paths: {string}
  const configuration_paths: {string: boolean}
  const known_directories: {string: boolean}
end

local union WatchDisposition
  irrelevant()
  relevant()
  possible_directory(string)
end

-- A raw create hint does not carry a file kind. Own possible new-directory
-- paths independently of the watcher poll Task so asynchronous lstat cannot
-- lose an already-published hint when registrations are reconciled.
local record DirectoryProbes
  pending: {string: boolean}
  order: {string}
  next_index: integer
  task: async.Task<|nil, value|>?
end

local function new_directory_probes(): DirectoryProbes
  return DirectoryProbes.new({}, {}, 1, nil)
end

type RenameAnalyzer = function (
  project_service.Snapshot, {bridge.ProjectModule}): bridge.Analysis
type ProjectLoader = function (
  string, bridge.ProgressListener?, project_service.SnapshotListener?):
  (project_service.Service?, project_service.Error?, project_loader.Restoration?)

local record RefreshChain
  const id: integer
  const reason: string
  const first_pass: integer
  const started_wall: integer
  const started_cpu: float
end

record Application
  local const project_root: string
  local const project_loader: ProjectLoader
  local service: project_service.Service?
  local watcher: project_watcher.ProjectWatcher?
  local watch_filter: WatchFilter?
  local refresh_task: async.Task<|RefreshOutcome, value|>?
  local completed_view: View?
  local refresh_failure: Error?
  local failed_epoch: integer?
  local change_epoch: integer
  local completed_epoch: integer
  local active_refresh_epoch: integer?
  local refresh_chain: RefreshChain?
  local refresh_chain_initial: boolean
  local refresh_chains: integer
  local refresh_passes: integer
  local view_builds: integer
  local indexing_listener: indexing_status.Listener?
  local closed: boolean
  local directory_probes: DirectoryProbes
  local const rename_analyzer: RenameAnalyzer
  local const diagnostic_publisher: diagnostics.Publisher
  local restoration: project_loader.Restoration?
  local const buffers: document_buffers.BufferStore
  local completion: completion_service.Service?
end

-- Source-imported application tests use these counters to assert coalescing and
-- immutable View reuse without timing or compiler-performance assumptions.
local record IndexingMetrics
  const refresh_passes: integer
  const view_builds: integer
  const refresh_chain_active: boolean
end

local INVALID_PARAMS = -32602
local METHOD_NOT_FOUND = -32601
local INTERNAL_ERROR = -32603
local REQUEST_FAILED = -32803

local function failure(code: integer, message: string):
    dispatcher.SemanticOutcome
  return dispatcher.SemanticOutcome.failure(code, message)
end

local function runtime_error(candidate: value): Error
  if candidate is Error then return candidate as Error end
  if candidate is project_service.Error then
    local item = candidate as project_service.Error
    return Error.new(item.path .. ": " .. item.message)
  end
  if candidate is bridge.BridgeError then
    local item = candidate as bridge.BridgeError
    return Error.new(item.module_name .. ": " .. item.message)
  end
  if candidate is sqlite3.Error then
    local item = candidate as sqlite3.Error
    return Error.new(item.operation .. ": " .. item.message)
  end
  if candidate is semantic_index.Error then
    return Error.new((candidate as semantic_index.Error).message)
  end
  if candidate is semantic_features.Error then
    return Error.new((candidate as semantic_features.Error).message)
  end
  if candidate is async.OperationError then
    local item = candidate as async.OperationError
    return Error.new(item.operation .. ": " .. item.message ..
                     " (" .. item.name .. ")")
  end
  return Error.new(strings.tostring(candidate))
end

local function parent_directory(path: string): string
  if path == "/" then return "/" end
  local slash = 0
  for index = 1, #path do
    if strings.byte(path, index) == 47 then slash = index end
  end
  if slash <= 1 then return "/" end
  return strings.sub(path, 1, slash - 1)
end

local function child_path(parent: string, name: string): string
  if parent == "/" then return "/" .. name end
  return parent .. "/" .. name
end

local function leaf_name(path: string): string
  local parent = parent_directory(path)
  if parent == "/" then return strings.sub(path, 2) end
  return strings.sub(path, #parent + 2)
end

local function canonical_directory(path: string): string
  do
    return fs.realpath(path)
  catch
    if error is async.CancellationReason then raise end
    return path
  end
end

-- Preserve a configured future directory's physical identity through any
-- existing symlinked ancestor. Watch backends report canonical paths, so a
-- nested source root that does not exist yet must still reset filtering below
-- the canonical include tree when its first directory is created.
local function canonical_configured_path(path: string): string
  local suffix: {string} = {}
  local candidate = path
  while true do
    do
      local canonical = fs.realpath(candidate)
      for index = #suffix, 1, -1 do
        canonical = child_path(canonical, suffix[index])
      end
      return canonical
    catch
      if error is async.CancellationReason then raise end
    end
    if candidate == "/" then return path end
    suffix[#suffix + 1] = leaf_name(candidate)
    candidate = parent_directory(candidate)
  end
  return path
end

-- File events preserve the watched directory's canonical identity even for a
-- create/delete whose leaf cannot itself be resolved. Canonicalize the parent
-- and retain that leaf instead of calling realpath on the event target.
local function canonical_file_path(path: string): string
  return child_path(
    canonical_directory(parent_directory(path)), leaf_name(path))
end

local function path_within(root: string, path: string): boolean
  if path == root then return true end
  if root == "/" then return strings.sub(path, 1, 1) == "/" end
  return strings.sub(path, 1, #root + 1) == root .. "/"
end

local function titan_source_path(path: string): boolean
  return #path >= 6 and strings.sub(path, #path - 5) == ".titan"
end

local MAX_LOGGED_WATCH_PATHS = 32
local MAX_LOGGED_MESSAGE_BYTES = 4096

local function bounded_log_message(message: string): string
  if #message <= MAX_LOGGED_MESSAGE_BYTES then return message end
  local finish = MAX_LOGGED_MESSAGE_BYTES - 3
  -- Avoid cutting a well-formed UTF-8 scalar before JSON encoding. Invalid
  -- input still remains best-effort and is rejected by logging.format.
  while finish > 0 do
    local following = strings.byte(message, finish + 1)
    if following < 128 or following > 191 then break end
    finish = finish - 1
  end
  return strings.sub(message, 1, finish) .. "..."
end

local function watch_path_array(changes: {project_watcher.PathChange}):
    wire.Array
  local values: wire.Array = {}
  local limit = #changes
  if limit > MAX_LOGGED_WATCH_PATHS then limit = MAX_LOGGED_WATCH_PATHS end
  for index = 1, limit do
    values[index] = project_watcher.change_path(changes[index])
  end
  return values
end

-- Mirror project discovery's lexical directory boundary. Names such as build
-- and tmp are valid module components and must remain observable; their
-- non-Titan artifacts are filtered separately by watch_path_relevant.
local function valid_relative_directory(root: string, path: string): boolean
  if path == root then return true end
  local start = #root + 2
  if root == "/" then start = 2 end
  local component_start = start
  for index = start, #path + 1 do
    if index == #path + 1 or strings.byte(path, index) == 47 then
      if not project_discovery.valid_module_component(
          strings.sub(path, component_start, index - 1)) then
        return false
      end
      component_start = index + 1
    end
  end
  return true
end

local function included_directory_path(root: string, path: string,
                                       source_roots: {string}): boolean
  if not path_within(root, path) then return false end
  for index = 1, #source_roots do
    local source_root = source_roots[index]
    -- Keep ancestors of a configured nested source root observable even when
    -- an include-relative component (for example vendor.foo) is not a module
    -- component. Once inside that root, validate the reset logical path.
    if path_within(path, source_root) then return true end
    if path_within(source_root, path) and
       valid_relative_directory(source_root, path) then
      return true
    end
  end
  return mapped_source_path(path, source_roots) and
         valid_relative_directory(root, path)
end

local function mapped_source_path(path: string,
                                  source_roots: {string}): boolean
  for index = 1, #source_roots do
    if path_within(source_roots[index], path) then return true end
  end
  return false
end

local function rebase_path(path: string, source_root: string,
                           observed_root: string): string
  if path == source_root then return observed_root end
  if source_root == "/" then
    if observed_root == "/" then return path end
    return observed_root .. path
  end
  return observed_root .. strings.sub(path, #source_root + 1)
end

local function cache_watch_paths(project_root: string, include_roots: {string},
                                 canonical_includes: {string}): {string}
  local cache = child_path(project_root, ".titan-ls")
  local canonical = canonical_configured_path(cache)
  local result = {cache, canonical, canonical_file_path(cache)}
  for index = 1, #include_roots do
    local include_root = include_roots[index]
    local observed_root = canonical_includes[index]
    if path_within(canonical, observed_root) then
      -- A source/include alias pointing into the private cache stays private.
      result[#result + 1] = include_root
    elseif path_within(observed_root, canonical) then
      result[#result + 1] = rebase_path(canonical, observed_root, include_root)
    end
  end
  return result
end

local function build_watch_filter(snapshot: project_service.Snapshot):
    WatchFilter
  local include_roots: {string} = {}
  local canonical_includes: {string} = {}
  for index = 1, #snapshot.config.include do
    local include_root = snapshot.config.include[index]
    include_roots[#include_roots + 1] = include_root
    local canonical_include_root = canonical_directory(include_root)
    canonical_includes[index] = canonical_include_root
    if canonical_include_root ~= include_root then
      include_roots[#include_roots + 1] = canonical_include_root
    end
  end

  local source_roots: {string} = {}
  for index = 1, #snapshot.config.source_module_roots do
    local source_root = snapshot.config.source_module_roots[index]
    source_roots[#source_roots + 1] = source_root
    local canonical_source_root = canonical_configured_path(source_root)
    if canonical_source_root ~= source_root then
      source_roots[#source_roots + 1] = canonical_source_root
    end
    -- Discovery accepts lexical source ancestry across an include symlink.
    -- Carry that same mapped coverage into the native watcher's namespace,
    -- even when the symlink target is outside the source root's physical tree.
    for include_index = 1, #snapshot.config.include do
      local include_root = snapshot.config.include[include_index]
      local canonical_include = canonical_includes[include_index]
      if canonical_include ~= include_root then
        if path_within(source_root, include_root) then
          source_roots[#source_roots + 1] = canonical_include
        elseif path_within(include_root, source_root) then
          source_roots[#source_roots + 1] = rebase_path(
            source_root, include_root, canonical_include)
        end
        if path_within(canonical_source_root, canonical_include) then
          source_roots[#source_roots + 1] = include_root
        elseif path_within(canonical_include, canonical_source_root) then
          source_roots[#source_roots + 1] = rebase_path(
            canonical_source_root, canonical_include, include_root)
        end
      end
    end
  end

  local excluded_paths: {string} = {}
  for index = 1, #snapshot.config.exclude do
    local excluded = snapshot.config.exclude[index]
    excluded_paths[#excluded_paths + 1] = excluded
    local canonical = canonical_directory(excluded)
    if canonical ~= excluded then
      excluded_paths[#excluded_paths + 1] = canonical
    end
    local canonical_leaf = canonical_file_path(excluded)
    if canonical_leaf ~= excluded and canonical_leaf ~= canonical then
      excluded_paths[#excluded_paths + 1] = canonical_leaf
    end
    for root_index = 1, #snapshot.config.include do
      local include_root = snapshot.config.include[root_index]
      if path_within(include_root, excluded) then
        local observed = rebase_path(
          excluded, include_root, canonical_directory(include_root))
        if observed ~= excluded and observed ~= canonical and
           observed ~= canonical_leaf then
          excluded_paths[#excluded_paths + 1] = observed
        end
      end
    end
  end

  local configuration_paths: {string: boolean} = {}
  local expected_config = child_path(
    snapshot.config.project_root, "titan-config.lua")
  configuration_paths[expected_config] = true
  configuration_paths[canonical_file_path(expected_config)] = true
  local config_file? = snapshot.config.config_file
  if config_file ~= nil then
    configuration_paths[config_file] = true
    configuration_paths[canonical_file_path(config_file)] = true
  end

  local known_directories: {string: boolean} = {}
  for index = 1, #snapshot.project_directories do
    local directory = snapshot.project_directories[index]
    known_directories[directory] = true
    known_directories[canonical_directory(directory)] = true
    for root_index = 1, #snapshot.config.include do
      local include_root = snapshot.config.include[root_index]
      if path_within(include_root, directory) then
        known_directories[rebase_path(
          directory, include_root, canonical_directory(include_root))] = true
      end
    end
  end
  return WatchFilter.new(
    include_roots, source_roots, excluded_paths,
    cache_watch_paths(snapshot.config.project_root, snapshot.config.include,
      canonical_includes), configuration_paths, known_directories)
end

-- A failed configuration load or source discovery cannot provide a Snapshot
-- from which to derive the full watcher scope. Keep the project directory and
-- its conventional configuration path observable from before the first load;
-- a later save can then repair the project without requiring an unrelated LSP
-- request to retry indexing.
local function provisional_watch_filter(project_root: string): WatchFilter
  local expected_config = child_path(project_root, "titan-config.lua")
  local configuration_paths: {string: boolean} = {}
  configuration_paths[expected_config] = true
  configuration_paths[canonical_file_path(expected_config)] = true
  local include_roots = {project_root}
  local canonical_root = canonical_directory(project_root)
  if canonical_root ~= project_root then include_roots[2] = canonical_root end
  local known_directories: {string: boolean} = {}
  known_directories[project_root] = true
  known_directories[canonical_root] = true
  return WatchFilter.new(
    include_roots, include_roots, {},
    cache_watch_paths(project_root, {project_root}, {canonical_root}),
    configuration_paths, known_directories)
end

-- The directory watcher is intentionally broader than the saved project: it
-- must observe a new source directory or a newly created configuration file.
-- A created extensionless valid component needs an asynchronous kind probe;
-- subsequent modifications are ignored unless discovery cached it as a
-- directory. Dotted/editor paths and non-Titan artifacts remain irrelevant
-- because discovery would prune the same component. Classification itself is
-- non-yielding so every hint is either accepted or copied into Application-
-- owned probe state before the ProjectWatcher callback returns.
local function watch_change_disposition(filter: WatchFilter,
                                        change: project_watcher.PathChange):
    WatchDisposition
  local path = project_watcher.change_path(change)
  for index = 1, #filter.cache_paths do
    if path_within(filter.cache_paths[index], path) then
      return WatchDisposition.irrelevant()
    end
  end
  if filter.configuration_paths[path] then
    return WatchDisposition.relevant()
  end
  for index = 1, #filter.excluded_paths do
    if path_within(filter.excluded_paths[index], path) then
      return WatchDisposition.irrelevant()
    end
  end
  for index = 1, #filter.include_roots do
    local include_root = filter.include_roots[index]
    if path_within(include_root, path) then
      if titan_source_path(path) and
         mapped_source_path(path, filter.source_roots) and
         included_directory_path(
           include_root, parent_directory(path), filter.source_roots) then
        return WatchDisposition.relevant()
      end
      -- A configured source-root ancestor may itself end in .titan. Treat its
      -- creation as a possible directory, so an actual unmapped regular file
      -- still cannot trigger discovery after the asynchronous kind probe.
      if included_directory_path(
          include_root, path, filter.source_roots) then
        if filter.known_directories[path] then
          return WatchDisposition.relevant()
        end
        case change
        when created() then
          return WatchDisposition.possible_directory(path)
        else
        end
      end
    end
  end
  return WatchDisposition.irrelevant()
end

local function watch_change_relevant(filter: WatchFilter,
                                     change: project_watcher.PathChange):
    boolean
  case watch_change_disposition(filter, change)
  when irrelevant() then return false
  else return true
  end
end

-- Source-imported tests validate lexical and canonical eligibility through the
-- same immutable filter construction used by reconciliation. A possible new
-- directory counts as eligible here; production verifies its kind first.
local function relevant_watch_change(snapshot: project_service.Snapshot,
                                     change: project_watcher.PathChange):
    boolean
  return watch_change_relevant(build_watch_filter(snapshot), change)
end

local function watcher_scope(snapshot: project_service.Snapshot):
    project_watcher.DirectoryScope
  local configuration = {snapshot.config.project_root}
  if snapshot.config.config_file ~= nil then
    configuration[#configuration + 1] =
      parent_directory(snapshot.config.config_file)
  end
  return project_watcher.DirectoryScope.new(
    snapshot.project_directories, configuration)
end

local function project_inputs(snapshot: project_service.Snapshot,
                              replaced_modules: {string}):
    ({bridge.ProjectModule}, {bridge.ModuleSnapshot})
  local projects: {bridge.ProjectModule} = {}
  local snapshots: {bridge.ModuleSnapshot} = {}
  local replaced: {string: boolean} = {}
  for index = 1, #replaced_modules do replaced[replaced_modules[index]] = true end
  for module_index = 1, #snapshot.project_modules do
    local module = snapshot.project_modules[module_index]
    -- Retain every saved module in Features even when it has no semantic
    -- snapshot. Besides providing source coordinates, this makes rename
    -- preflight compile the complete saved project and therefore reject an
    -- edit if an invalid module could contain an unindexed reference.
    projects[module_index] = module:compiler_input()
    case module.analysis_state
    when clean() then
      if #module.diagnostics > 0 then
        raise Error.new("clean Titan project module '" .. module.module_name ..
          "' has compiler diagnostics")
      end
      if replaced[module.module_name] then
        if module.compiler_snapshot == nil then
          raise Error.new(
            "clean Titan project module '" .. module.module_name ..
            "' has no fresh compiler snapshot for semantic replacement")
        end
        snapshots[#snapshots + 1] = module.compiler_snapshot
      end
    when failed() then
      -- The diagnostics are current for this exact saved revision, but a
      -- failed module deliberately contributes no compiler snapshot.
    when dirty() then
      -- Saved or dependency inputs changed; indexing is still outstanding.
    end
  end
  return projects, snapshots
end


local function log_watch_failure(failure: project_watcher.WatchFailure)
  logging.emit("error", "project.watch.failure", {
    ["operation"] = failure.operation,
    ["name"] = failure.name,
    ["code"] = failure.code,
    ["message"] = failure.message,
  })
end

local function Application:run_directory_probes(): nil
  local probes = self.directory_probes
  defer do
    probes.pending = {}
    probes.order = {}
    probes.next_index = 1
    probes.task = nil
  end

  while not self.closed and probes.next_index <= #probes.order do
    -- Bound each wave before its first yield. Continuous compiler-temporary
    -- churn can append another wave, but cannot postpone a confirmed source
    -- directory's invalidation indefinitely.
    local wave_finish = #probes.order
    local relevant = false
    while not self.closed and probes.next_index <= wave_finish do
      local path = probes.order[probes.next_index]
      probes.next_index = probes.next_index + 1
      probes.pending[path] = nil

      -- An absent path was an ephemeral create/delete and cannot contribute to
      -- the saved project. Discovery also uses lstat and ignores symlinks, so
      -- only an extant directory needs a refresh. Metadata failures remain
      -- conservative; cancellation belongs to Application.close.
      local possible_directory = true
      do
        local metadata? = fs.lstat(path)
        possible_directory = metadata ~= nil and
                             metadata.kind == "directory"
      catch
        if error is async.CancellationReason then raise end
      end
      if possible_directory then relevant = true end
    end

    if relevant and not self.closed then self:note_saved_change() end
  end
  return nil
end

local function Application:probe_possible_directory(path: string)
  if self.closed then return end
  local probes = self.directory_probes
  if probes.pending[path] then return end
  probes.pending[path] = true
  probes.order[#probes.order + 1] = path
  if probes.task ~= nil then return end
  probes.task = async.run<|nil, value|>(
    function (): nil return self:run_directory_probes() end)
end

local function Application:watch_callback(
    batch: project_watcher.RediscoveryBatch)
  if self.closed then return end
  local relevant = batch.watch_set_changed
  local possible_directories: {string} = {}
  local filter? = self.watch_filter
  if not relevant and filter ~= nil then
    for index = 1, #batch.changes do
      case watch_change_disposition(filter, batch.changes[index])
      when relevant() then
        relevant = true
        break
      when possible_directory(path) then
        possible_directories[#possible_directories + 1] = path
      when irrelevant() then
      end
    end
  elseif not relevant and #batch.changes > 0 then
    -- A watcher should never exist without its prepared filter. If lifecycle
    -- code changes that invariant, prefer a bounded extra refresh to losing a
    -- saved-file invalidation.
    relevant = true
  end
  local queued_directory_probes = 0
  if not relevant then
    for index = 1, #possible_directories do
      self:probe_possible_directory(possible_directories[index])
    end
    queued_directory_probes = #possible_directories
  end
  if logging.enabled("debug") then
    logging.emit("debug", "project.watch.batch", {
      ["changes"] = #batch.changes,
      ["paths"] = watch_path_array(batch.changes),
      ["paths_truncated"] = #batch.changes > MAX_LOGGED_WATCH_PATHS,
      ["failures"] = #batch.failures,
      ["watch_set_changed"] = batch.watch_set_changed,
      ["directory_probes"] = queued_directory_probes,
      ["relevant"] = relevant,
    })
  end
  if relevant then
    -- Watch events are hints only. Start rediscovery of the complete saved
    -- project immediately and never consume editor notification text.
    self:note_saved_change()
  end
  for index = 1, #batch.failures do
    log_watch_failure(batch.failures[index])
  end
end

-- Keep watcher policy behind one method so the refresh state-machine tests can
-- deterministically inject the same coalesced hint without depending on kernel
-- event timing.
function Application:note_saved_change()
  if self.closed then return end
  self.change_epoch = self.change_epoch + 1
  logging.emit("debug", "indexing.saved_change", {
    ["epoch"] = self.change_epoch,
    ["refresh_active"] = self.refresh_task ~= nil,
  })
  self:start_refresh(false, "saved_change")
end

local function Application:ensure_provisional_watcher()
  if self.closed or self.watcher ~= nil then return end
  -- Publish the filter before starting the poll Task so even a callback on the
  -- first scheduler turn classifies project-root noise conservatively.
  self.watch_filter = provisional_watch_filter(self.project_root)
  self.watcher = project_watcher.start(
    project_watcher.DirectoryScope.new({}, {self.project_root}),
    function (batch: project_watcher.RediscoveryBatch)
      self:watch_callback(batch)
    end)
end

local function Application:reconcile_watcher(
    snapshot: project_service.Snapshot)
  if self.closed then return end
  -- Canonicalization may yield or fail, so finish it before changing watcher
  -- registrations. The callback retains the preceding immutable filter until
  -- a complete replacement is ready.
  local next_filter = build_watch_filter(snapshot)
  local scope = watcher_scope(snapshot)
  if self.closed then return end
  if self.watcher == nil then
    self.watcher = project_watcher.start(
      scope,
      function (batch: project_watcher.RediscoveryBatch)
        self:watch_callback(batch)
      end)
  else
    self.watcher:reconcile(scope)
  end
  -- Cooperative scheduling cannot run the newly started poll callback between
  -- the successful reconcile return and this non-yielding assignment.
  if not self.closed then self.watch_filter = next_filter end
end

local function dirty_signature(names: {string}): string
  local output = strings.writer()
  for index = 1, #names do
    output:write(#names[index] .. ":" .. names[index])
  end
  return output:drain()
end

local function publication_revision(connection: sqlite3.Connection): string
  local generation = stores.scalar_integer(connection,
    "SELECT generation FROM main.graph_state WHERE singleton=1")
  local output = strings.writer()
  output:write(generation .. ":")
  local statement = connection:prepare(
    "SELECT name,provenance,state,revision FROM main.graph_modules ORDER BY name")
  defer statement:close()
  local cursor = statement:query()
  defer cursor:close()
  for row in cursor:fetch do
    local name = row:get(1) as string
    output:write(#name .. ":" .. name .. ":" ..
      (row:get(2) as integer) .. ":" .. (row:get(3) as integer) .. ":" ..
      (row:get(4) as integer) .. ";")
  end
  return output:drain()
end

local function Application:publish_view(service: project_service.Service,
    snapshot: project_service.Snapshot, reuse: View?): View
  local store = service:workspace_store()
  local revision = ""
  local plan?: semantic_index.PublicationPlan = nil
  do
    local access = store:acquire()
    defer access:release()
    if stores.scalar_integer(access.connection,
        "SELECT generation FROM main.graph_state WHERE singleton=1") ~= snapshot.generation then
      raise Error.new("saved Titan project changed before semantic preparation; retry")
    end
    revision = publication_revision(access.connection)
    local rows = stores.rows(access.connection,
      "SELECT name,revision,state FROM main.graph_modules " ..
      "WHERE provenance=0 ORDER BY name")
    local modules: {semantic_index.ModulePublication} = {}
    for index = 1, #rows do
      local row = rows[index]
      modules[index] = semantic_index.ModulePublication.new(
        row:get(1) as string, row:get(2) as integer, row:get(3) as integer)
    end
    plan = semantic_index.publication_plan(access.connection, modules)
  end
  self:reconcile_watcher(snapshot)
  -- Source extraction and cache serialization can yield without monopolizing
  -- the Store. Requests keep reading the preceding completed SQL revision.
  local warm_reuse = service:prepare_publication(snapshot)
  local prepared: semantic_features.PreparedView? = nil
  if reuse == nil and not warm_reuse then
    self.view_builds = self.view_builds + 1
    local captured = plan as semantic_index.PublicationPlan
    local projects, snapshots = project_inputs(snapshot, captured.replaced_modules)
    prepared = semantic_features.prepare_update(
      projects, snapshots, captured, function () async.yield() end)
  end
  local diagnostic_rows = diagnostics.from_snapshot_with_yield(snapshot)
  local access = store:acquire()
  defer access:release()
  local connection = access.connection
  if publication_revision(connection) ~= revision then
    raise Error.new("saved Titan project changed during semantic preparation; retry")
  end
  local generation = stores.scalar_integer(connection,
    "SELECT published_generation FROM main.store_state WHERE singleton=1")
  if reuse ~= nil then
    semantic_index.check_generation(connection, reuse.published_generation)
  elseif not warm_reuse then
    generation = generation + 1
  end
  connection:set_autocommit(false)
  do
    -- Schema recreation belongs to the same accepted publication as its rows.
    -- A rollback must preserve missing tables so the retry still rebuilds all
    -- facts instead of trusting empty recreated tables at old revisions.
    semantic_features.initialize_schema(connection)
    published_diagnostics.initialize_schema(connection)
    if prepared ~= nil then prepared:publish(connection) end
    published_diagnostics.publish(connection, diagnostic_rows)
    service:publish_prepared(connection)
    stores.execute(connection,
      "UPDATE main.store_state SET published_generation=? WHERE singleton=1", generation)
    connection:commit()
  catch
    -- Only the uncancelled updater owns this transaction; request cancellation
    -- detaches a reader and Application.close joins the updater before close.
    if not connection:get_autocommit() then connection:rollback() end
    raise
  end
  service:publication_committed()
  local features = semantic_features.open(store, generation)
  if reuse ~= nil then features = reuse.features end
  return View.new(snapshot.generation, generation,
    dirty_signature(snapshot.dirty_modules), features)
end

local function Application:install_view(snapshot: project_service.Snapshot): View
  -- Establish the watcher before validation so a failed initial compiler
  -- snapshot can still observe the save which repairs it.
  local service = self.service as project_service.Service
  return self:publish_view(service, snapshot, nil)
end

local function Application:refresh_once(): RefreshOutcome
  do
    local service? = self.service
    if service == nil then
      self:ensure_provisional_watcher()
      local loaded?, load_error?, restoration? = self.project_loader(
        self.project_root,
        function (progress: bridge.AnalysisProgress)
          self:emit_compiler_progress(progress)
        end,
        function (snapshot: project_service.Snapshot)
          self:reconcile_watcher(snapshot)
        end)
      if loaded == nil then
        local message = "cannot load Titan project"
        if load_error ~= nil then
          message = load_error.path .. ": " .. load_error.message
        end
        return RefreshOutcome.failure(Error.new(message))
      end
      self.service = loaded
      self.restoration = restoration
      return RefreshOutcome.ready(self:install_view(loaded:latest()))
    end

    -- Saved changes and rename preflight share the foreground updater. Join
    -- outside a Store lease before mutating the live compiler or graph.
    local restoration? = self.restoration
    if restoration ~= nil then
      restoration:finish(service)
      self.restoration = nil
    end
    local report?, refresh_error? = service:refresh(
      function (snapshot: project_service.Snapshot)
        self:reconcile_watcher(snapshot)
      end)
    if report == nil then
      local message = "cannot refresh Titan project"
      if refresh_error ~= nil then
        message = refresh_error.path .. ": " .. refresh_error.message
      end
      return RefreshOutcome.failure(Error.new(message))
    end
    local snapshot = service:latest()
    local completed? = self.completed_view
    if completed ~= nil and completed.work_generation ==
         report.generation and #report.committed_modules == 0 and
       #report.failed_modules == 0 and
       completed.dirty_signature == dirty_signature(snapshot.dirty_modules) then
      -- A refresh still rediscovers directories and external inputs. When its
      -- semantic generation and pending-work membership did not change and no
      -- clean or failed project result was published, retain the immutable
      -- Features. In particular, a same-generation external invalidation can
      -- turn a formerly clean module into a failed one; that result must
      -- rebuild the View so its preceding AST is no longer exposed.
      return RefreshOutcome.ready(self:publish_view(service, snapshot, completed))
    end
    return RefreshOutcome.ready(self:install_view(snapshot))
  catch
    if error is async.CancellationReason then raise end
    return RefreshOutcome.failure(runtime_error(error))
  end
end

local function Application:status_generation(): integer?
  local completed? = self.completed_view
  if completed == nil then return nil end
  return completed.published_generation
end

local function Application:emit_indexing_status(
    state: indexing_status.State, message: string?,
    completed_files: integer?, total_files: integer?)
  if self.closed then return end
  local listener? = self.indexing_listener
  if listener == nil then return end
  local epoch = self.change_epoch
  if indexing_status.state_name(state) == "indexing" and
     self.active_refresh_epoch ~= nil then
    epoch = self.active_refresh_epoch
  end
  do
    listener(indexing_status.Status.new(
      state, self.refresh_chain_initial, epoch,
      self:status_generation(), message, completed_files, total_files))
  catch
    -- Encoding optional status output must not retire the indexing work that
    -- owns the saved generation. Other listener failures keep their behavior.
    if error is json.Error then
      local failure: json.Error = error
      if failure.position == nil and
         (failure.code == "invalid_utf8" or
          failure.code == "limit_exceeded") then
        return
      end
    end
    raise
  end
end

local function Application:emit_compiler_progress(
    progress: bridge.AnalysisProgress)
  -- A compiler can outlive its owning protocol listener while close/cancel is
  -- unwinding. Only an active refresh pass may publish progress.
  if self.refresh_chain == nil or self.active_refresh_epoch == nil then return end
  self:emit_indexing_status(
    indexing_status.State.indexing(), nil,
    progress.completed_files, progress.total_files)
end

local function Application:begin_refresh_chain(reason: string)
  if self.refresh_chain ~= nil then return end
  self.refresh_chain_initial = self.completed_view == nil
  local first_pass = self.refresh_passes
  self.refresh_chains = self.refresh_chains + 1
  local chain = RefreshChain.new(
    self.refresh_chains, reason, first_pass, logging.wall_clock(),
    logging.clock())
  self.refresh_chain = chain
  logging.emit("info", "indexing.chain.start", {
    ["chain"] = chain.id,
    ["reason"] = chain.reason,
    ["epoch"] = self.change_epoch,
    ["initial"] = self.refresh_chain_initial,
  })
  self:emit_indexing_status(indexing_status.State.indexing(), nil, nil, nil)
end

local function Application:complete_refresh_chain(
    outcome: string, attempted_epoch: integer, message: string?)
  local chain? = self.refresh_chain
  if chain == nil then return end
  -- Clear control state before best-effort telemetry. A platform clock or
  -- malformed diagnostic field must never keep a completed chain active.
  self.refresh_chain = nil
  do
    local fields: wire.Object = {
      ["chain"] = chain.id,
      ["reason"] = chain.reason,
      ["outcome"] = outcome,
      ["initial"] = self.refresh_chain_initial,
      ["attempted_epoch"] = attempted_epoch,
      ["completed_epoch"] = self.completed_epoch,
      ["pending_epoch"] = self.change_epoch,
      ["passes"] = self.refresh_passes - chain.first_pass,
      ["wall_ms"] = logging.elapsed_wall_ms(chain.started_wall),
      ["cpu_ms"] = logging.elapsed_ms(chain.started_cpu),
    }
    local generation? = self:status_generation()
    if generation ~= nil then
      fields["generation"] = generation
    end
    if message ~= nil then
      fields["message"] = bounded_log_message(message)
    end
    local level = "info"
    if outcome == "failed" then level = "error" end
    logging.emit(level, "indexing.chain.complete", fields)
  catch
  end
end

local function Application:start_refresh(force: boolean, reason: string):
    async.Task<|RefreshOutcome, value|>?
  if self.closed or self.refresh_task ~= nil then return self.refresh_task end
  if not force then
    if self.completed_view ~= nil and
       self.completed_epoch >= self.change_epoch then
      return nil
    end
    local failed_epoch? = self.failed_epoch
    if self.refresh_failure ~= nil and failed_epoch ~= nil and
       failed_epoch >= self.change_epoch then
      return nil
    end
  end

  local target_epoch = self.change_epoch
  self.active_refresh_epoch = target_epoch
  self:begin_refresh_chain(reason)
  if reason == "coalesced_follow_up" then
    -- A refresh chain stays continuously busy, but progress belongs to one
    -- exact saved epoch/workset. Clear the preceding pass's N/M immediately so
    -- the client cannot display a completed old workset during this scan.
    self:emit_indexing_status(indexing_status.State.indexing(), nil, nil, nil)
  end
  local chain = self.refresh_chain as RefreshChain
  local task = async.run<|RefreshOutcome, value|>(function (): RefreshOutcome
    do
      local started = logging.clock()
      self.refresh_passes = self.refresh_passes + 1
      logging.emit("debug", "indexing.pass.start", {
        ["chain"] = chain.id,
        ["chain_reason"] = chain.reason,
        ["trigger"] = reason,
        ["epoch"] = target_epoch,
        ["force"] = force,
        ["pass"] = self.refresh_passes,
        ["follow_up"] = self.refresh_passes > chain.first_pass + 1,
      })
      local completed = self:refresh_once()
      local outcome_name = "unknown"
      local outcome_message: string? = nil
      local diagnostic_publications: {diagnostics.Publication}? = nil
      case completed
      when failure(failure) then
        outcome_name = "failed"
        outcome_message = failure.message
        self.refresh_failure = failure
        self.failed_epoch = target_epoch
      when ready(view) then
        outcome_name = "ready"
        -- Publish every successful pass even when a later hint arrived. Retain
        -- and serve that immutable generation while the single coalesced
        -- follow-up runs.
        self.completed_view = view
        self.completed_epoch = target_epoch
        self.refresh_failure = nil
        self.failed_epoch = nil
        if self.diagnostic_publisher:enabled() and
           self.change_epoch == target_epoch then
          diagnostic_publications = published_diagnostics.read(
            (self.service as project_service.Service):workspace_store(),
            view.published_generation)
        end
      end

      case completed
      when failure() then
        -- A failed refresh cannot validate diagnostics from the preceding saved
        -- epoch. Clear them while the watcher waits for a repair.
        self.diagnostic_publisher:clear()
      when ready() then
        -- Building UTF-16 coordinates can yield. Publish only if no newer save
        -- arrived during that work; the coalesced follow-up owns the replacement.
        if diagnostic_publications ~= nil and
           self.change_epoch == target_epoch then
          self.diagnostic_publisher:publish(diagnostic_publications)
        end
      end

      logging.emit("debug", "indexing.pass.complete", {
        ["chain"] = chain.id,
        ["trigger"] = reason,
        ["epoch"] = target_epoch,
        ["outcome"] = outcome_name,
        ["pending_epoch"] = self.change_epoch,
        ["cpu_ms"] = logging.elapsed_ms(started),
      })

      self.refresh_task = nil
      self.active_refresh_epoch = nil
      if not self.closed and self.change_epoch > target_epoch then
        -- Start at most one next-turn pass for every burst. Epoch comparison,
        -- rather than clearing a boolean, preserves a hint delivered at any
        -- yielding point in scan, analysis, view construction, or reconciliation.
        self:start_refresh(false, "coalesced_follow_up")
      else
        self:complete_refresh_chain(
          outcome_name, target_epoch, outcome_message)
        case completed
        when failure(failure) then
          self:emit_indexing_status(
            indexing_status.State.failed(), failure.message)
        when ready(view) then
          self:emit_indexing_status(indexing_status.State.ready(), nil)
          local restoration? = self.restoration
          if restoration ~= nil and not self.closed then
            restoration:start(function ()
              -- Recovery belongs to the ordinary single writer. This callback
              -- only schedules it while readers retain the completed SQL View.
              if not self.closed then self:note_saved_change() end
            end)
          end
        end
      end
      return completed
    catch
      -- Cover refresh, diagnostic conversion/publication, logging, and status
      -- delivery with the same terminal cleanup. No post-refresh exception may
      -- strand the active epoch or suppress all later saved-file refreshes.
      self.refresh_task = nil
      self.active_refresh_epoch = nil
      if error is async.CancellationReason then
        self:complete_refresh_chain("cancelled", target_epoch, nil)
        raise
      end
      -- Terminal cleanup must not depend on any best-effort output path.
      do self.diagnostic_publisher:clear() catch end
      -- Preserve the original exceptional value. Its normalization is not
      -- allowed to become another failure merely to enrich telemetry.
      self:complete_refresh_chain("failed", target_epoch, nil)
      raise
    end
  end)
  self.refresh_task = task
  return task
end

-- Idempotently ensure that the initial or watcher-requested index is running.
-- The initialized lifecycle hook calls this without waiting for project I/O.
function Application:start_indexing()
  self:start_refresh(false, "initialized")
end

function Application:set_indexing_listener(listener: indexing_status.Listener?)
  self.indexing_listener = listener
end

function Application:set_diagnostics_listener(listener: diagnostics.Listener?)
  if self.closed then return end
  self.diagnostic_publisher:set_listener(listener)
  local completed? = self.completed_view
  if not self.closed and listener ~= nil and completed ~= nil then
    do
      local service = self.service as project_service.Service
      local publications = published_diagnostics.read(
        service:workspace_store(), completed.published_generation)
      if not self.closed then self.diagnostic_publisher:publish(publications) end
    catch
      -- A publication which overtook listener replay owns its replacement.
      if not (error is semantic_index.StaleView) then raise end
    end
  end
end

-- The LSP shutdown request must empty active Problems entries before the
-- protocol writer is stopped. Disable the listener after that replacement so
-- a still-unwinding refresh cannot republish after shutdown.
function Application:stop_diagnostics()
  self.diagnostic_publisher:stop()
end

local function Application:indexing_metrics(): IndexingMetrics
  return IndexingMetrics.new(
    self.refresh_passes, self.view_builds, self.refresh_chain ~= nil)
end

local function Application:snapshot_for_testing(): project_service.Snapshot?
  local service? = self.service
  if service == nil then return nil end
  return service:latest()
end

local function Application:watched_directories_for_testing(): {string}
  local watcher? = self.watcher
  if watcher == nil then return {} end
  return watcher:watched_directories()
end

local function Application:change_epoch_for_testing(): integer
  return self.change_epoch
end

local function Application:directory_probe_active_for_testing(): boolean
  return self.directory_probes.task ~= nil
end

local function Application:stop_watching_for_testing()
  local watcher? = self.watcher
  self.watcher = nil
  if watcher ~= nil then watcher:stop() end
end

local function joined_view(task: async.Task<|RefreshOutcome, value|>):
    (View?, Error?)
  case async.join<|RefreshOutcome, value|>(task)
  when succeeded(outcome) then
    case outcome
    when ready(view) then return view, nil
    when failure(item) then return nil, item
    end
  when failed(item) then
    return nil, runtime_error(item.error)
  when cancelled() then
    return nil, Error.new("project refresh was cancelled")
  else
    return nil, Error.new("project refresh did not finish")
  end
  return nil, Error.new("project refresh produced no result")
end

-- Read-only features use the last completed immutable View without probing
-- disk again. Saved project watcher hints start one coalesced refresh; while
-- it is running, the preceding View remains serviceable rather than blocking
-- requests or returning empty results. Intentionally unwatched external inputs
-- are revalidated by the next saved-project refresh or strict rename refresh.
-- A terminal refresh failure is authoritative for that saved epoch and is not
-- retried by unchanged read-only requests; a later saved hint or strict rename
-- may retry it.
local function Application:current_view(): (View?, Error?)
  if self.closed then
    return nil, Error.new("language server application is closed")
  end

  -- This joins/starts work only when a saved watcher epoch is pending. An
  -- unchanged hover/definition/folding request must not rescan the entire
  -- source tree merely to return an already immutable semantic generation.
  self:start_refresh(false, "semantic_request")
  local failure? = self.refresh_failure
  local failed_epoch? = self.failed_epoch
  if failure ~= nil and failed_epoch ~= nil and
     failed_epoch >= self.change_epoch then
    return nil, failure
  end
  local completed? = self.completed_view
  if completed ~= nil then return completed, nil end
  return nil, nil
end

-- Rename produces edits against saved bytes, so it must never use the
-- responsive completed-generation fallback. Always await the current stable
-- refresh and let the caller perform the existing post-preflight generation
-- check with a second fresh refresh.
local function Application:fresh_view(): (View?, Error?)
  if self.closed then
    return nil, Error.new("language server application is closed")
  end
  local task? = self.refresh_task
  if task == nil then task = self:start_refresh(true, "rename") end
  if task == nil then
    local completed? = self.completed_view
    if completed ~= nil then return completed, nil end
    return nil, Error.new("project refresh did not start")
  end
  local view?, view_error? = joined_view(task)
  if view == nil then return nil, view_error end
  if self.completed_epoch < self.change_epoch or self.refresh_task ~= nil then
    return nil, Error.new("saved Titan project changed while indexing; retry")
  end
  return view, nil
end

local function parse_error(item: lsp.Error?): dispatcher.SemanticOutcome
  if item == nil then
    return failure(INVALID_PARAMS, "Invalid params")
  end
  return failure(item.code, item.message)
end

local function location_result(location: semantic_features.Location?):
    value
  if location == nil then return wire.null() end
  return lsp.location_value(location.uri, location.range)
end

local function locations_result(locations: {semantic_features.Location}):
    wire.Array
  local result: wire.Array = {}
  for index = 1, #locations do
    result[index] = lsp.location_value(
      locations[index].uri, locations[index].range)
  end
  return result
end

local function folding_result(ranges: {lsp.FoldingRange}): wire.Array
  local result: wire.Array = {}
  for index = 1, #ranges do
    result[index] = lsp.folding_range_value(ranges[index])
  end
  return result
end

local function Application:handle_definition(
    request: dispatcher.SemanticRequest): dispatcher.SemanticOutcome
  local params?, params_error? = lsp.parse_document_position(request.params)
  if params == nil then return parse_error(params_error) end
  local view?, view_error? = self:current_view()
  if view == nil then
    if view_error ~= nil then
      return failure(REQUEST_FAILED, view_error.message)
    end
    return dispatcher.SemanticOutcome.result(wire.null())
  end
  return dispatcher.SemanticOutcome.result(location_result(
    view.features:definition(params.path, params.position)))
end

local function Application:handle_references(
    request: dispatcher.SemanticRequest): dispatcher.SemanticOutcome
  local params?, params_error? = lsp.parse_references(request.params)
  if params == nil then return parse_error(params_error) end
  local view?, view_error? = self:current_view()
  if view == nil then
    if view_error ~= nil then
      return failure(REQUEST_FAILED, view_error.message)
    end
    local result: wire.Array = {}
    return dispatcher.SemanticOutcome.result(result)
  end
  return dispatcher.SemanticOutcome.result(locations_result(
    view.features:references(
      params.document.path, params.document.position,
      params.include_declaration)))
end

local function Application:handle_hover(
    request: dispatcher.SemanticRequest): dispatcher.SemanticOutcome
  local params?, params_error? = lsp.parse_document_position(request.params)
  if params == nil then return parse_error(params_error) end
  local view?, view_error? = self:current_view()
  if view == nil then
    if view_error ~= nil then
      return failure(REQUEST_FAILED, view_error.message)
    end
    return dispatcher.SemanticOutcome.result(wire.null())
  end
  local hover? = view.features:hover(params.path, params.position)
  if hover == nil then
    return dispatcher.SemanticOutcome.result(wire.null())
  end
  return dispatcher.SemanticOutcome.result(
    lsp.hover_value(hover:markdown(), hover.range))
end

local function Application:handle_folding(
    request: dispatcher.SemanticRequest): dispatcher.SemanticOutcome
  local params?, params_error? = lsp.parse_document(request.params)
  if params == nil then return parse_error(params_error) end
  local view?, view_error? = self:current_view()
  if view == nil then
    if view_error ~= nil then
      return failure(REQUEST_FAILED, view_error.message)
    end
    local result: wire.Array = {}
    return dispatcher.SemanticOutcome.result(result)
  end
  return dispatcher.SemanticOutcome.result(folding_result(
    view.features:folding_ranges(params.path)))
end

local function default_rename_analyzer(
    snapshot: project_service.Snapshot,
    projects: {bridge.ProjectModule}): bridge.Analysis
  local compiler = bridge.load()
  compiler:configure(bridge.CompilerConfiguration.new {
    source_roots = snapshot.config.source_module_roots,
    binary_root = snapshot.config.binary_modules_root,
    include_roots = snapshot.config.extra_ffi_include_dirs,
    cppflags = snapshot.config.extra_ffi_cppflags,
  })
  return compiler:analyze(snapshot.project_modules[1].module_name, projects)
end

local function Application:rename_analysis(
    view: View, candidate: semantic_features.RenameCandidate):
    (bridge.Analysis?, Error?)
  local service = self.service as project_service.Service
  local snapshot = service:latest()
  if snapshot.generation ~= view.work_generation then
    raise semantic_index.StaleView.new(view.work_generation, snapshot.generation)
  end
  do
    local access = service:workspace_store():acquire()
    defer access:release()
    semantic_index.check_generation(access.connection, view.published_generation)
  end
  if #snapshot.project_modules == 0 then
    return nil, Error.new("cannot rename in an empty Titan project")
  end
  do
    return self.rename_analyzer(snapshot, candidate:edited_project_modules()), nil
  catch
    if error is async.CancellationReason then raise end
    return nil, runtime_error(error)
  end
end

local function Application:handle_rename(
    request: dispatcher.SemanticRequest): dispatcher.SemanticOutcome
  local params?, params_error? = lsp.parse_rename(request.params)
  if params == nil then return parse_error(params_error) end
  local view?, view_error? = self:fresh_view()
  if view == nil then return failure(REQUEST_FAILED, view_error.message) end

  local candidate?, rename_error? = view.features:rename(
    params.document.path, params.document.position, params.new_name)
  if rename_error ~= nil then
    return failure(REQUEST_FAILED, rename_error.message)
  end
  if candidate == nil then
    return failure(REQUEST_FAILED, "no project symbol exists at the position")
  end

  local analysis?, analysis_error? = self:rename_analysis(view, candidate)
  if analysis == nil then
    return failure(INTERNAL_ERROR, analysis_error.message)
  end
  local verified?, preflight_error? = candidate:preflight(analysis)
  if verified == nil then
    local message = "candidate rename failed compiler preflight"
    if preflight_error ~= nil then message = preflight_error.message end
    return failure(REQUEST_FAILED, message)
  end

  -- Compiler preflight works from an immutable copy of the saved generation.
  -- Revalidate disk state before publishing edits so a save that happened
  -- during the request cannot make the WorkspaceEdit target an older file.
  local latest?, latest_error? = self:fresh_view()
  if latest == nil then
    return failure(REQUEST_FAILED, latest_error.message)
  end
  if latest.work_generation ~= view.work_generation or
     latest.published_generation ~= view.published_generation then
    return failure(
      REQUEST_FAILED, "saved Titan project changed during rename; retry")
  end
  return dispatcher.SemanticOutcome.result(
    lsp.workspace_edit_value(verified:document_edits()))
end

function create(project_root: string, loader: ProjectLoader?,
    rename_analyzer: RenameAnalyzer?): Application
  return Application.new(
    project_root, loader or project_loader.load, nil, nil, nil, nil, nil, nil,
    nil, 1, 0, nil, nil, false, 0, 0, 0, nil, false,
    new_directory_probes(), rename_analyzer or default_rename_analyzer,
    diagnostics.create(), nil, document_buffers.create(), nil)
end

function Application:on_document(notification: lsp.DocumentNotification)
  if self.closed then return end
  local path = ""
  case notification
  when opened(item) then path = item.document.path
  when changed(item) then path = item.document.path
  when closed(item) then path = item.path
  when saved(item) then path = item.path
  end
  if not path_within(self.project_root, path) or not titan_source_path(path) then
    return
  end
  -- This bookkeeping is synchronous, including before saved indexing starts.
  -- Only completion consumes these bytes; didSave never publishes them.
  if self.buffers:apply(notification) then
    local completion? = self.completion
    if completion ~= nil then completion:changed() end
  end
end

local function unavailable_completion(): dispatcher.SemanticOutcome
  return dispatcher.SemanticOutcome.result(
    lsp.completion_list_value(lsp.CompletionList.new(true, {})))
end

function Application:capture_completion(request: dispatcher.CompletionRequest):
    coordinator.CompletionWork
  if self.closed or self.service == nil then return unavailable_completion end
  if self.completion == nil then
    self.completion = completion_service.create(
      self.service:workspace_store(), self.buffers)
  end
  -- A completion request does not wait for saved indexing or compiler manifest
  -- restoration. Its service captures the current committed SQL baseline.
  return self.completion:capture(request)
end

-- Source-imported tests own preloaded Services. All construction still passes
-- through create, so new Application state has one initialization authority.
local function create_unindexed_with_service(
    project_root: string, service: project_service.Service): Application
  local application = create(project_root)
  application.service = service
  return application
end

local function create_with_service(project_root: string,
    service: project_service.Service, rename_analyzer: RenameAnalyzer?): Application
  local application = create(project_root, nil, rename_analyzer)
  application.service = service
  application.change_epoch = 0
  application.completed_view = application:install_view(service:latest())
  return application
end

function Application:handle(
    request: dispatcher.SemanticRequest): dispatcher.SemanticOutcome
  if request.method == "textDocument/definition" then
    return self:handle_definition(request)
  elseif request.method == "textDocument/references" then
    return self:handle_references(request)
  elseif request.method == "textDocument/rename" then
    return self:handle_rename(request)
  elseif request.method == "textDocument/hover" then
    return self:handle_hover(request)
  elseif request.method == "textDocument/foldingRange" then
    return self:handle_folding(request)
  end
  return failure(METHOD_NOT_FOUND, "Method not found")
catch
  if error is async.CancellationReason then raise end
  if error is semantic_index.StaleView then
    return failure(REQUEST_FAILED, "saved Titan project changed while reading; retry")
  end
  return failure(INTERNAL_ERROR, runtime_error(error).message)
end

function Application:close()
  if self.closed then return end
  self.closed = true
  local completion? = self.completion
  self.completion = nil
  if completion ~= nil then completion:close() end
  self.diagnostic_publisher:stop()
  self.indexing_listener = nil
  -- Stop accepting hints immediately. A reconciliation may already be inside
  -- its watcher lifecycle operation, so stop that backend after its owner joins.
  self.watch_filter = nil

  local directory_probe? = self.directory_probes.task
  if directory_probe ~= nil then
    if not directory_probe:status():has_finished() then
      directory_probe:cancel(async.CancellationReason.simple(
        "language server application is closing"))
    end
    async.join(directory_probe)
    self.directory_probes.task = nil
  end
  self.directory_probes.pending = {}
  self.directory_probes.order = {}
  self.directory_probes.next_index = 1

  local attempted_epoch? = self.active_refresh_epoch
  local restoration? = self.restoration
  if restoration ~= nil then restoration:cancel() end
  local refresh? = self.refresh_task
  if refresh ~= nil then
    -- Cancellation cannot submit ordinary SQLite rollback. Drain the updater
    -- after stopping hints, then close the Store after all readers release it.
    async.join(refresh)
    self.refresh_task = nil
  end
  if self.refresh_chain ~= nil then
    if attempted_epoch == nil then attempted_epoch = self.change_epoch end
    self:complete_refresh_chain(
      "cancelled", attempted_epoch as integer, nil)
  end
  self.active_refresh_epoch = nil
  if restoration ~= nil then restoration:close() end
  self.restoration = nil

  local watcher? = self.watcher
  self.watcher = nil
  self.watch_filter = nil
  if watcher ~= nil then watcher:stop() end
  local service? = self.service
  if service ~= nil then service:close() end
  self.completed_view = nil
end
