local async = import "async"
local fs = import "fs"
local lua = import "lua"
local sqlite3 = import "sqlite3"
local strings = import "string"
local timer = import "timer"
local test = import "test"
local runtime = import "server.test_runtime"
local service = import "server.completion_service.titan"
local buffers = import "server.document_buffers"
local storage = import "server.completion_store.titan"
local fact_types = import "server.completion_types"
local bridge = import "server.compiler_bridge"
local scheduler = import "server.compiler_scheduler"
local loader = import "server.project_loader"
local sql = import "server.workspace_store.titan"
local semantic = import "server.semantic_index"
local lsp = import "server.lsp_types"
local dispatcher = import "server.dispatcher"
local source_text = import "server.source_text"
local wire = import "server.wire"
foreign import "compiler_io_clock.h"
foreign import "compiler_io_platform.h"

local ROOT = "/completion-fixture"
local PATH = "/completion-fixture/app.titan"
local URI = "file:///completion-fixture/app.titan"

local function seed(store: sql.Store, projects: {bridge.ProjectModule},
                    inactive_files: {string}?)
  local access = store:acquire()
  defer access:release()
  semantic.initialize_schema(access.connection)
  sql.execute(access.connection,
    "CREATE TABLE IF NOT EXISTS main.header_graphs(key BLOB PRIMARY KEY,payload BLOB NOT NULL) WITHOUT ROWID")
  sql.execute(access.connection,
    "CREATE TABLE IF NOT EXISTS main.ffi_conversion_snapshots(key BLOB PRIMARY KEY,payload BLOB NOT NULL) WITHOUT ROWID")
  local descriptors: {storage.SavedDescriptor} = {}
  local names: {string} = {}
  for index = 1, #projects do
    local project = projects[index]
    names[index] = project.module_name
    local files: {string} = {}
    sql.execute(access.connection, "INSERT INTO main.semantic_projects VALUES(?,?,1,2)",
      sqlite3.Blob.new(project.module_name), index)
    for file_index = 1, #project.files do
      local file = project.files[file_index]
      files[file_index] = file.filename
      sql.execute(access.connection, "INSERT INTO main.semantic_files VALUES(?,?,?,?,?)",
        sqlite3.Blob.new(file.filename), sqlite3.Blob.new(project.module_name),
        sqlite3.Blob.new(file.contents), index, file_index)
    end
    descriptors[index] = storage.SavedDescriptor.new(project.module_name, 1, 2,
      "project", files[1], "root-not-decoded", "", nil, files, {}, {}, {})
  end
  storage.publish_saved(access.connection, descriptors, names,
    bridge.CompilerConfiguration.new({ROOT}, nil, nil, nil),
    {ROOT}, {}, inactive_files)
  sql.execute(access.connection, "UPDATE main.store_state SET published_generation=7 WHERE singleton=1")
end

local function open(documents: buffers.BufferStore, path: string, version: integer, text: string)
  local uri? = source_text.path_to_file_uri(path)
  documents:apply(lsp.DocumentNotification.opened(lsp.OpenDocument.new(
    lsp.TextDocument.new(uri, path), version, text)))
end

local function seed_checked(store: sql.Store, projects: {bridge.ProjectModule})
  seed(store, projects)
  local compiler = bridge.load()
  local configuration = bridge.CompilerConfiguration.new({ROOT}, nil, nil, nil)
  compiler:configure(configuration)
  local analysis = compiler:analyze(projects[1].module_name, projects)
  test.assert(#analysis.diagnostics == 0, "saved dependency fixture did not compile")
  local names: {string} = {}
  for index = 1, #projects do names[index] = projects[index].module_name end
  local payloads = compiler:export_projects(projects, names)
  test.assert(#payloads == #projects, "saved dependency descriptors were not exported")
  local descriptors: {storage.SavedDescriptor} = {}
  for index = 1, #projects do
    local project = projects[index]
    local module? = analysis:find_module(project.module_name)
    local files: {string} = {}
    for file_index = 1, #project.files do files[file_index] = project.files[file_index].filename end
    local payload = ""
    for payload_index = 1, #payloads do
      if payloads[payload_index].module_name == project.module_name then payload = payloads[payload_index].payload end
    end
    descriptors[index] = storage.SavedDescriptor.new(project.module_name, 1, 2, "project",
      files[1], payload, module.manifest.serialized, module.manifest.source_serialized,
      files, module.imports, module.c_header_dependencies, {})
  end
  local access = store:acquire()
  defer access:release()
  storage.publish_saved(access.connection, descriptors, names, configuration, {ROOT}, {})
end

local function request(path: string, contents: string, needle: string,
                        options: lsp.CompletionOptions?): dispatcher.CompletionRequest
  local first? = strings.find(contents, needle, 1, true)
  test.assert(first ~= nil, "missing test completion token")
  local position? = source_text.position_for_offset(contents, first - 1 + #needle)
  local uri? = source_text.path_to_file_uri(path)
  return dispatcher.CompletionRequest.new(dispatcher.RequestId.integer_id(1),
    lsp.CompletionParams.new(lsp.DocumentPosition.new(uri, path, position), 1, nil), options)
end

local function selected_item(outcome: dispatcher.SemanticOutcome,
                             label: string): wire.Object
  case outcome
  when result(value) then
    local object? = wire.as_object(value)
    local items? = wire.as_array(object["items"])
    for index = 1, #items do
      local item? = wire.as_object(items[index])
      if wire.as_string(item["label"]) == label then return item end
    end
    raise "missing completion " .. label
  when failure{message} then raise message
  end
end

local function labels(outcome: dispatcher.SemanticOutcome): ({string}, boolean)
  case outcome
  when result(value) then
    local object? = wire.as_object(value)
    local items? = wire.as_array(object["items"])
    local result: {string} = {}
    for index = 1, #items do
      local item? = wire.as_object(items[index])
      result[index] = wire.as_string(item["label"])
    end
    return result, wire.as_boolean(object["isIncomplete"])
  when failure{message} then raise message
  end
end

local function contains(items: {string}, expected: string): boolean
  for index = 1, #items do if items[index] == expected then return true end end
  return false
end

local function await_preparation(completion: service.Service)
  if completion.worker ~= nil then
    case async.join(completion.worker)
    when succeeded() then
    when failed(failure) then raise failure.error
    else raise "completion owner did not finish"
    end
  end
end

local function await_refresh(completion: service.Service)
  if completion.debounce ~= nil then async.join(completion.debounce) end
  await_preparation(completion)
end

function test_completion_service_unsaved_receiver_and_whole_token_edit(_context: test.Context)
  runtime.run(function ()
    local store = sql.open(":memory:")
    defer store:close()
    seed(store, {bridge.ProjectModule.new("app", {bridge.SourceFile.new(PATH, "local saved = 1\n")})})
    local documents = buffers.create()
    local completion = service.create(store, documents)
    defer completion:close()
    local text = "record Cat\n  field: integer\nend\nfunction read(cat: Cat): integer\n  return cat.fiXYZ\nend\n"
    open(documents, PATH, 1, text)
    local work = completion:capture(request(PATH, text, "cat.fi"))
    work()
    await_preparation(completion)
    local result = work()
    local names, incomplete = labels(result)
    test.assert(contains(names, "field"),
      "unsaved receiver fields were not resolved from the captured text")
    test.assert(not contains(names, "saved"), "saved root names leaked into member completion")
    case result
    when result(value) then
      local object? = wire.as_object(value)
      local items? = wire.as_array(object["items"])
      local item? = wire.as_object(items[1])
      local edit? = wire.as_object(item["textEdit"])
      local range? = wire.as_object(edit["range"])
      local finish? = wire.as_object(range["end"])
      test.assert(wire.as_integer(finish["character"]) == 18,
        "replacement left the suffix after the caret intact")
    else raise "completion result missing"
    end
  end)
end

local function hover_markdown(outcome: dispatcher.SemanticOutcome?): string?
  if outcome == nil then return nil end
  case outcome
  when result(value) then
    local object? = wire.as_object(value)
    if object == nil then return nil end
    local contents? = wire.as_object(object["contents"])
    if contents == nil then return nil end
    return wire.as_string(contents["value"])
  when failure{message} then raise message
  end
end

function test_completion_service_hover_retains_analysis_until_refresh_and_retires_sessions(_context: test.Context)
  runtime.run(function ()
    local store = sql.open(":memory:")
    defer store:close()
    seed(store, {bridge.ProjectModule.new("app", {bridge.SourceFile.new(PATH, "local saved = 1\n")})})
    local documents = buffers.create()
    local completion = service.create(store, documents)
    defer completion:close()
    local text = "function read(): integer\r\n local unsaved = 1\r\n return unsaved\r\nend\r\n" ..
      "function after(): string local emoji = \"😀\" return emoji end\r\n"
    open(documents, PATH, 1, text)
    local before = documents:capture(PATH, source_text.Position.new(1, 8))
    test.assert(completion:hover(before) == nil, "hover invented a private preparation")
    local work = completion:capture(request(PATH, text, "return uns"))
    work()
    await_preparation(completion)
    local hover? = hover_markdown(completion:hover(before))
    test.assert(hover ~= nil and strings.find(hover, "Type: `integer`") ~= nil,
      "hover omitted a local from the completion's unsaved source")
    local suffix = documents:capture(PATH, source_text.Position.new(4, 54))
    local suffix_hover? = hover_markdown(completion:hover(suffix))
    test.assert(suffix_hover ~= nil and strings.find(suffix_hover, "Type: `string`") ~= nil,
      "hover did not remap an occurrence after the dummy and UTF-16 text")
    local hole = documents:capture(PATH, source_text.Position.new(2, 10))
    test.assert(completion:hover(hole) == nil,
      "the dummy token became a real editor occurrence")
    do
      local access = store:acquire()
      defer access:release()
      sql.execute(access.connection, "UPDATE main.store_state SET published_generation=8 WHERE singleton=1")
    end
    test.assert(hover_markdown(completion:hover(before)) ~= nil,
      "saved publication discarded accepted hover before replacement")
    do
      local access = store:acquire()
      defer access:release()
      sql.execute(access.connection, "UPDATE main.store_state SET published_generation=7 WHERE singleton=1")
    end
    documents:apply(lsp.DocumentNotification.changed(lsp.ChangeDocument.new(
      lsp.TextDocument.new(URI, PATH), 2, text .. "-- changed\n")))
    completion:changed()
    test.assert(completion:hover(before) == nil, "an obsolete hover request attached to newer editor bytes")
    test.assert(hover_markdown(completion:hover(documents:capture(PATH,
      source_text.Position.new(1, 8)))) ~= nil, "edit discarded an untouched accepted occurrence")
    await_refresh(completion)
    test.assert(hover_markdown(completion:hover(documents:capture(PATH,
      source_text.Position.new(2, 10)))) ~= nil, "autonomous source analysis retained the completion hole")
    documents:apply(lsp.DocumentNotification.closed(lsp.TextDocument.new(URI, PATH)))
    completion:changed()
    open(documents, PATH, 1, text)
    test.assert(completion:hover(documents:capture(PATH, source_text.Position.new(1, 8))) == nil,
      "reopened buffer borrowed the previous session's hover")
  end)
end

function test_completion_service_acceptance_refreshes_full_source_and_coalesces_edits(_context: test.Context)
  runtime.run(function ()
    local store = sql.open(":memory:")
    defer store:close()
    seed(store, {bridge.ProjectModule.new("app", {bridge.SourceFile.new(PATH, "local saved = 1\n")})})
    local documents = buffers.create()
    local completion = service.create(store, documents)
    defer completion:close()
    local text = "function combine(count: integer): integer return count end\n" ..
      "function read(): integer local count = 1 return comb end\n"
    open(documents, PATH, 1, text)
    local work = completion:capture(request(PATH, text, "return comb", lsp.CompletionOptions.new(true, true, true)))
    work()
    await_preparation(completion)
    local item = selected_item(work(), "combine")
    local edit? = wire.as_object(item["textEdit"])
    test.assert(wire.as_string(edit["newText"]) == "combine(${1:count})$0",
      "acceptance fixture did not obtain the real callable snippet")
    local accepted = "function combine(count: integer): integer return count end\n" ..
      "function read(): integer local count = 1 return combine(count) end\n"
    local previous_requests = completion.requests
    do
      local permit = scheduler.acquire()
      defer permit:release()
      for version = 2, 4 do
        documents:apply(lsp.DocumentNotification.changed(lsp.ChangeDocument.new(
          lsp.TextDocument.new(URI, PATH), version, accepted .. "-- version " .. version .. "\n")))
        completion:changed()
      end
      local kept? = hover_markdown(completion:hover(documents:capture(PATH,
        source_text.Position.new(1, 33))))
      test.assert(kept ~= nil and strings.find(kept, "Type: `integer`") ~= nil,
        "accepting a call removed unrelated hover while the compiler permit was held")
      test.assert(completion:hover(documents:capture(PATH, source_text.Position.new(1, 49))) == nil,
        "the new callee borrowed the completion dummy's occurrence")
      timer.sleep(service.HOVER_DEBOUNCE_MS + 50)
      test.assert(completion.requests == previous_requests + 1,
        "one edit burst started more than one background capture")
    end
    await_refresh(completion)
    local callee? = hover_markdown(completion:hover(documents:capture(PATH,
      source_text.Position.new(1, 49))))
    test.assert(callee ~= nil and strings.find(callee, "combine(count: integer)") ~= nil,
      "accepted callee required another completion to become hoverable")
    local repeat_work = completion:capture(request(PATH, accepted .. "-- version 4\n", "return combine"))
    repeat_work()
    await_preparation(completion)
    test.assert(hover_markdown(completion:hover(documents:capture(PATH,
      source_text.Position.new(1, 49)))) ~= nil,
      "another completion hole replaced full-source hover for identical editor bytes")
    local malformed = "-- 😀\r\n" .. accepted .. "function unfinished(\n"
    documents:apply(lsp.DocumentNotification.changed(lsp.ChangeDocument.new(
      lsp.TextDocument.new(URI, PATH), 5, malformed)))
    completion:changed()
    await_refresh(completion)
    -- Full sync with two disjoint edits conservatively touches the intervening
    -- source. Start with one trailing malformed edit to exercise retention.
    documents:apply(lsp.DocumentNotification.changed(lsp.ChangeDocument.new(
      lsp.TextDocument.new(URI, PATH), 6, accepted)))
    completion:changed()
    await_refresh(completion)
    documents:apply(lsp.DocumentNotification.changed(lsp.ChangeDocument.new(
      lsp.TextDocument.new(URI, PATH), 7, accepted .. "function unfinished(\n")))
    completion:changed()
    await_refresh(completion)
    test.assert(hover_markdown(completion:hover(documents:capture(PATH,
      source_text.Position.new(1, 49)))) ~= nil,
      "a failed rebuild erased mapped hover from the last accepted analysis")
  end)
end

function test_completion_service_rechecks_capture_after_publication_waiter_resumes(_context: test.Context)
  runtime.run(function ()
    for mode = 1, 2 do
      local subject = "publication race mode " .. mode
      local store = sql.open(":memory:")
      defer store:close()
      seed(store, {bridge.ProjectModule.new("app", {bridge.SourceFile.new(PATH, "local saved = 1\n")})})
      local documents = buffers.create()
      local completion = service.create(store, documents)
      defer completion:close()
      local text = "function read(): integer\n local alpha = 1\n return alpha\nend\n"
      local document = lsp.TextDocument.new(URI, PATH)
      open(documents, PATH, 1, text)
      local initial = completion:capture(request(PATH, text, "return al"))
      initial()
      await_preparation(completion)
      local next_text = "-- pending\n" .. text
      local next_version = 2
      if mode == 2 then
        -- A full-source context at the exact foreground capture makes the
        -- worker skip hover publication and exercise the candidate writer.
        next_text = text .. "-- source checked\n"
        documents:apply(lsp.DocumentNotification.changed(lsp.ChangeDocument.new(document, 2, next_text)))
        completion:changed()
        await_refresh(completion)
        test.assert(completion.hover_context.source, "candidate race fixture did not obtain full-source hover")
      end
      local prior_context? = completion.hover_context
      local permit = scheduler.acquire()
      defer permit:release()
      if mode == 1 then
        documents:apply(lsp.DocumentNotification.changed(lsp.ChangeDocument.new(document, next_version, next_text)))
        completion:changed()
      end
      -- Keep fixture background work from competing with the foreground
      -- writer whose precise commit/resume boundary this test owns.
      if completion.debounce ~= nil and not completion.debounce:status():has_finished() then
        completion.debounce:cancel(async.CancellationReason.simple("publication race fixture"))
      end
      -- Reusable candidates may let answer return before its new worker has
      -- even started. This fixture owns a fresh foreground preparation only.
      completion.ready = nil
      completion.previous_ready = nil
      local foreground = completion:capture(request(PATH, next_text, "return al"))
      foreground()
      for _attempt = 1, 5000 do
        if completion.preparation ~= nil then break end
        if completion.worker ~= nil and completion.worker:status():has_finished() then break end
        timer.sleep(1)
      end
      local preparing? = completion.preparation
      test.assert(preparing ~= nil and not preparing:status():has_finished(),
        subject .. ": did not hold private preparation at the compiler permit")
      local held: sql.Access? = nil
      defer do if held ~= nil then held:release() end end
      local observer: async.Task<|nil, value|>? = nil
      local preparation_succeeded = false
      local publication_committed = false
      local edited_before_resume = false
      local latest = "-- latest\n" .. next_text
      local detach_preparation = preparing:add_terminal_listener(
        function (status: async.TaskStatus<|service.Prepared?, value|>)
          local succeeded, prepared? = status:has_succeeded()
          preparation_succeeded = succeeded and prepared ~= nil
          if not preparation_succeeded then return end
          -- Preparation already released its compiler permit. Its worker join
          -- listener queued that continuation, but it cannot run until all
          -- terminal listeners return; acquire the free SQL lease first.
          held = store:acquire()
          observer = async.run<|nil, value|>(function (): nil
            local writers = completion.store.writers
            if #writers == 0 then
              held:release()
              return nil
            end
            local writer = writers[#writers]
            writer:add_terminal_listener(function (outcome: async.TaskStatus<|boolean, value|>)
              local accepted, committed? = outcome:has_succeeded()
              publication_committed = accepted and committed == true
              if not publication_committed then return end
              -- The transaction committed and released SQL. The service's join
              -- waiter is queued, so this synchronous editor notification wins
              -- before it can install the prepared capture in memory.
              edited_before_resume = documents:apply(lsp.DocumentNotification.changed(
                lsp.ChangeDocument.new(document, next_version + 1, latest)))
              completion:changed()
              if completion.debounce ~= nil and not completion.debounce:status():has_finished() then
                completion.debounce:cancel(async.CancellationReason.simple("publication race fixture edited"))
              end
            end)
            held:release()
            return nil
          end)
        end)
      defer detach_preparation()
      permit:release()
      await_preparation(completion)
      if observer ~= nil then
        case async.join(observer)
        when succeeded() then
        when failed(failure) then raise failure.error
        else raise "publication race observer did not finish"
        end
      end
      test.assert(preparation_succeeded and publication_committed and edited_before_resume,
        subject .. ": did not edit between commit and waiter resume")
      test.assert(completion.hover_context == prior_context and completion.ready == nil,
        subject .. ": a resumed waiter installed an obsolete hover context or candidate Ready")
      local first? = strings.find(latest, "local alpha", 1, true)
      local position? = source_text.position_for_offset(latest, first - 1 + #"local al")
      local kept? = hover_markdown(completion:hover(documents:capture(PATH, position)))
      test.assert(kept ~= nil and strings.find(kept, "Type: `integer`") ~= nil and
          prior_context.files[1].latest.text == latest,
        subject .. ": post-commit edit lost the prior context's safe mapping to the latest source")
    end
  end)
end

function test_completion_service_background_capture_cannot_overtake_new_active_document(_context: test.Context)
  runtime.run(function ()
    local store = sql.open(":memory:")
    defer store:close()
    local other = ROOT .. "/other.titan"
    seed(store, {
      bridge.ProjectModule.new("app", {bridge.SourceFile.new(PATH, "local saved = 1\n")}),
      bridge.ProjectModule.new("other", {bridge.SourceFile.new(other, "local saved = \"B\"\n")}),
    })
    local documents = buffers.create()
    local completion = service.create(store, documents)
    defer completion:close()
    local first = "function read(): integer\n local kept = 1\n return kept\nend\n"
    local second = "function read(): string\n local kept = \"from B\"\n return kept\nend\n"
    open(documents, PATH, 1, first)
    open(documents, other, 1, second)
    completion:capture(request(PATH, first, "return ke"))
    local old_capture? = documents:capture(PATH, source_text.Position.new(0, 0))
    local stale = service.Request.new(old_capture, 7, nil, "app",
      "stale-source-app", completion.requests, nil, true)
    completion.pending_hover = stale
    local foreground = completion:capture(request(other, second, "return ke"))
    test.assert(completion.pending_hover == nil,
      "switching the active completion document retained the previous background slot")
    test.assert(documents:current(old_capture),
      "active-document regression accidentally relied on a changed buffer epoch")
    -- A debounce may already have captured A, then resume its saved-generation
    -- SQL read after completion switches to B. Reinsert that immutable request
    -- to exercise the worker's ownership fence separately from queue clearing.
    completion.pending_hover = stale
    foreground()
    await_preparation(completion)
    test.assert(contains(labels(foreground()), "kept"),
      "new active document did not prepare its foreground candidates")
    local context? = completion.hover_context
    local markdown? = hover_markdown(completion:hover(documents:capture(other,
      source_text.Position.new(1, 8))))
    test.assert(context ~= nil and context.module_name == "other" and
        markdown ~= nil and strings.find(markdown, "Type: `string`") ~= nil,
      "still-current background A replaced hover accepted for the latest completion in B")
  end)
end

function test_completion_service_retained_ranges_reject_rewritten_and_joined_tokens(_context: test.Context)
  local original = buffers.Input.new(URI, PATH, 1, 1, "local keep = 1\nreturn keep\n")
  local file = service.HoverFile.new(original, original, {}, false)
  local context = service.HoverContext.new("test", {file}, true, 1, 7, "app")
  local row = fact_types.Hover.new(PATH, 22, 26, "kept")
  local shifted = buffers.Input.new(URI, PATH, 1, 2, "-- 😀\r\n" .. original.text)
  test.assert(context:follow({shifted}), "same-session edits retired mapped context")
  local span? = file:current_span(row)
  test.assert(span ~= nil and span.start == 31 and span.finish == 35,
    "retained occurrence did not move by UTF-8 bytes")
  test.assert(file:original_offset(32) == 23, "current cursor did not map into original snapshot")
  -- A suffix inserted at the occurrence boundary must invalidate the complete
  -- token even though the retained half-open span itself was untouched.
  local joined = buffers.Input.new(URI, PATH, 1, 3, "-- 😀\r\nlocal keep = 1\nreturn keeper\n")
  context:follow({joined})
  test.assert(file:current_span(row) == nil, "retained hover matched a prefix of a rewritten token")
  local replacement = buffers.Input.new(URI, PATH, 2, 1, original.text)
  test.assert(not context:follow({replacement}), "a reopened session inherited an old mapping")
end

function test_completion_service_full_source_context_does_not_hide_another_module(_context: test.Context)
  runtime.run(function ()
    local store = sql.open(":memory:")
    defer store:close()
    local other_path = ROOT .. "/other.titan"
    local first_text = "function read(): integer\n local firstValue = 1\n return firstValue\nend\n"
    local other_text = "function read(): string\n local secondValue = \"other\"\n return secondValue\nend\n"
    seed(store, {
      bridge.ProjectModule.new("app", {bridge.SourceFile.new(PATH, first_text)}),
      bridge.ProjectModule.new("other", {bridge.SourceFile.new(other_path, other_text)}),
    })
    local documents = buffers.create()
    open(documents, PATH, 1, first_text)
    open(documents, other_path, 1, other_text)
    local completion = service.create(store, documents)
    defer completion:close()
    completion:capture(request(PATH, first_text, "return firstV"))()
    await_preparation(completion)
    documents:apply(lsp.DocumentNotification.changed(lsp.ChangeDocument.new(
      lsp.TextDocument.new(URI, PATH), 2, first_text .. "-- edited\n")))
    completion:changed()
    await_refresh(completion)
    test.assert(completion.hover_context.source, "fixture did not obtain full-source hover")
    completion:capture(request(other_path, other_text, "return secondV"))()
    await_preparation(completion)
    local other_hover? = hover_markdown(completion:hover(documents:capture(other_path,
      source_text.Position.new(1, 8))))
    test.assert(other_hover ~= nil and strings.find(other_hover, "Type: `string`") ~= nil,
      "same-epoch completion in another module kept unrelated full-source hover")
  end)
end

function test_completion_service_capture_before_deferred_change_and_reopen(_context: test.Context)
  runtime.run(function ()
    local store = sql.open(":memory:")
    defer store:close()
    seed(store, {bridge.ProjectModule.new("app", {bridge.SourceFile.new(PATH, "local saved = 1\n")})})
    local documents = buffers.create()
    local completion = service.create(store, documents)
    defer completion:close()
    local first = "function f(): integer\n local alpha = 1\n return al\nend\n"
    open(documents, PATH, 1, first)
    local stale = completion:capture(request(PATH, first, "return al"))
    local second = "function f(): integer\n local bravo = 1\n return br\nend\n"
    local document = lsp.TextDocument.new(URI, PATH)
    documents:apply(lsp.DocumentNotification.changed(lsp.ChangeDocument.new(document, 5, second)))
    completion:changed()
    local stale_names, stale_incomplete = labels(stale())
    test.assert(#stale_names == 0 and stale_incomplete, "deferred request sampled a newer buffer")
    local work = completion:capture(request(PATH, second, "return br"))
    work()
    await_preparation(completion)
    test.assert(contains(labels(work()), "bravo"), "new document version was not analyzed")
    documents:apply(lsp.DocumentNotification.saved(document))
    test.assert(contains(labels(work()), "bravo"), "didSave retired editor completion state")
    documents:apply(lsp.DocumentNotification.closed(document))
    completion:changed()
    await_preparation(completion)
    do
      local access = store:acquire()
      defer access:release()
      test.assert(sql.scalar_integer(access.connection, "SELECT count(*) FROM temp.open_documents") == 0,
        "close retained TEMP editor rows")
    end
    open(documents, PATH, 5, second)
    completion:changed()
    test.assert(#labels(work()) == 0, "reopen reused the previous open session")
  end)
end

function test_completion_service_bounded_while_shared_compiler_permit_held(_context: test.Context)
  runtime.run(function ()
    local store = sql.open(":memory:")
    defer store:close()
    seed(store, {bridge.ProjectModule.new("app", {bridge.SourceFile.new(PATH, "local saved = 1\n")})})
    local documents = buffers.create()
    local completion = service.create(store, documents)
    defer completion:close()
    local text = "function f(): integer\n local alpha = 1\n return al\nend\n"
    open(documents, PATH, 1, text)
    local work = completion:capture(request(PATH, text, "return al"))
    local paused = false
    local barrier = async.ResumeToken.new("completion.test.hydration-held")
    local hydration = loader.restoration(function (): {string}
      local permit = scheduler.acquire()
      defer permit:release()
      paused = true
      async.suspend(barrier, function () paused = false end)
      return {}
    end)
    defer hydration:close()
    hydration:start()
    while not paused do async.yield() end
    local started = ffi.vscode_titan_monotonic_ms()
    local names, incomplete = labels(work())
    local elapsed = ffi.vscode_titan_monotonic_ms() - started
    test.assert(paused, "completion resumed workspace hydration")
    hydration:close()
    test.assert(#names == 0 and incomplete and elapsed < 2000.0,
      "completion waited for shared hydration permit instead of returning bounded fallback")
    await_preparation(completion)
    test.assert(contains(labels(work()), "alpha"), "private preparation did not resume after permit release")
  end)
end

function test_completion_service_provisional_candidates_follow_current_token_during_refresh(_context: test.Context)
  runtime.run(function ()
    local store = sql.open(":memory:")
    defer store:close()
    seed(store, {bridge.ProjectModule.new("app", {bridge.SourceFile.new(PATH, "local saved = 1\n")})})
    local documents = buffers.create()
    local completion = service.create(store, documents)
    defer completion:close()
    local text = "function f(): integer\n local alpha = 1\n return al\nend\n"
    open(documents, PATH, 1, text)
    local first = completion:capture(request(PATH, text, "return al"))
    first()
    await_preparation(completion)
    test.assert(contains(labels(first()), "alpha"), "initial completion was not prepared")
    local permit = scheduler.acquire()
    defer permit:release()
    do
      local access = store:acquire()
      defer access:release()
      sql.execute(access.connection, "UPDATE main.store_state SET published_generation=8 WHERE singleton=1")
    end
    local refreshed = completion:capture(request(PATH, text, "return al"))
    local previous_names, previous_incomplete = labels(refreshed())
    test.assert(contains(previous_names, "alpha") and previous_incomplete,
      "saved reanalysis hid useful previous candidates while the compiler permit was held")
    local document = lsp.TextDocument.new(URI, PATH)
    local changed = "function f(): integer\n local alpha = 1\n return alphSuffix\nend\n"
    documents:apply(lsp.DocumentNotification.changed(lsp.ChangeDocument.new(document, 2, changed)))
    completion:changed()
    local typed = completion:capture(request(PATH, changed, "return alph"))
    local started = ffi.vscode_titan_monotonic_ms()
    local result = typed()
    local names, incomplete = labels(result)
    test.assert(contains(names, "alpha") and incomplete and
        ffi.vscode_titan_monotonic_ms() - started < 1000.0,
      "typing waited for new compiler analysis instead of filtering prepared candidates")
    case result
    when result(value) then
      local object? = wire.as_object(value)
      local items? = wire.as_array(object["items"])
      local item? = wire.as_object(items[1])
      local edit? = wire.as_object(item["textEdit"])
      local range? = wire.as_object(edit["range"])
      local finish? = wire.as_object(range["end"])
      test.assert(wire.as_integer(finish["character"]) == 18,
        "provisional edit used the old buffer's replacement range")
    else raise "completion result missing"
    end
    test.assert(#labels(refreshed()) == 0, "previous captured request survived a buffer change")
    local other = "function f(): integer\n local alpha = 1\n return object.al\nend\n"
    documents:apply(lsp.DocumentNotification.changed(lsp.ChangeDocument.new(document, 3, other)))
    completion:changed()
    test.assert(#labels(completion:capture(request(PATH, other, "object.al"))()) == 0,
      "provisional lexical candidates leaked into a changed receiver context")
    documents:apply(lsp.DocumentNotification.closed(document))
    completion:changed()
    open(documents, PATH, 4, text)
    completion:changed()
    test.assert(#labels(completion:capture(request(PATH, text, "return al"))()) == 0,
      "provisional candidates survived close and reopen into another document session")
  end)
end

function test_completion_service_restart_prepares_while_hydration_paused_and_select_never_decodes(_context: test.Context)
  runtime.run(function ()
    local path = fs.tmpname()
    defer fs.unlink(path)
    do
      local first = sql.open(path)
      defer first:close()
      seed_checked(first, {
        bridge.ProjectModule.new("app", {bridge.SourceFile.new(PATH,
          "local dep = import \"dep\"\nfunction f(): integer return dep.public() end\n")}),
        bridge.ProjectModule.new("dep", {bridge.SourceFile.new(ROOT .. "/dep.titan",
          "local record Box<|T|>\n value: T\nend\nfunction public(): integer return 1 end\n")}),
      })
    end
    local store = sql.open(path)
    defer store:close()
    local driver = lua.require("titan-compiler.driver") as {string: value}
    local types = lua.require("titan-compiler.types") as {string: value}
    local previous_imported = driver["imported"]
    local previous_registry = types["registry"]
    local imported: {string: value} = {}
    local registry: {string: value} = {}
    driver["imported"], types["registry"] = imported, registry
    defer driver["imported"] = previous_imported
    defer types["registry"] = previous_registry
    local original_decode = driver["decode_project_entry"] as function (string, value): (value, value)
    local decodes = 0
    driver["decode_project_entry"] = function (payload: string, options: value): (value, value)
      decodes = decodes + 1
      return original_decode(payload, options)
    end
    defer driver["decode_project_entry"] = original_decode
    local paused = false
    local barrier = async.ResumeToken.new("completion.test.hydration-free")
    local hydration = loader.restoration(function (): {string}
      paused = true
      async.suspend(barrier, function () paused = false end)
      return {}
    end)
    defer hydration:close()
    hydration:start()
    while not paused do async.yield() end
    local documents = buffers.create()
    local completion = service.create(store, documents)
    defer completion:close()
    local text = "local dep = import \"dep.titan\"\nfunction f(box: dep.Box<|integer|>): integer\n return box.va\nend\n"
    open(documents, PATH, 1, text)
    local work = completion:capture(request(PATH, text, "box.va"))
    work()
    await_preparation(completion)
    test.assert(paused and contains(labels(work()), "value"),
      "private generic completion required shared workspace hydration")
    test.assert(decodes == 1, "preparation decoded more than its one required detached dependency")
    local permit = scheduler.acquire()
    defer permit:release()
    for index = 1, 3 do
      test.assert(contains(labels(work()), "value"), "published TEMP selection waited for the compiler permit")
    end
    test.assert(decodes == 1 and driver["imported"] == imported and types["registry"] == registry,
      "SELECT decoded a compiler payload or private preparation populated the shared registry")
  end)
end

function test_completion_service_folder_contributors_and_new_file(_context: test.Context)
  runtime.run(function ()
    local store = sql.open(":memory:")
    defer store:close()
    local main = ROOT .. "/box/box.titan"
    local child = ROOT .. "/box/fields.titan"
    seed(store, {bridge.ProjectModule.new("box", {bridge.SourceFile.new(main, "local saved = 1\n")})})
    local documents = buffers.create()
    local completion = service.create(store, documents)
    defer completion:close()
    local text = "function f(): integer\n return current.va\nend\n"
    open(documents, main, 1, text)
    open(documents, child, 2, "record Box\n value: integer\nend\nlocal current = Box.new(1)\n")
    local work = completion:capture(request(main, text, "current.va"))
    work()
    await_preparation(completion)
    test.assert(contains(labels(work()), "value"), "new open folder contributor was not part of the logical module")
    local new_path = ROOT .. "/fresh.titan"
    local new_text = "function f(): integer\n local answer = 1\n return ans\nend\n"
    open(documents, new_path, 1, new_text)
    completion:changed()
    local fresh = completion:capture(request(new_path, new_text, "return ans"))
    fresh()
    await_preparation(completion)
    test.assert(contains(labels(fresh()), "answer"), "unambiguous new file-backed module was deferred")
  end)
end

function test_completion_service_restored_callable_snippets_and_provisional_argument_guard(_context: test.Context)
  runtime.run(function ()
    local store = sql.open(":memory:")
    defer store:close()
    local dependency = ROOT .. "/dep.titan"
    seed_checked(store, {
      bridge.ProjectModule.new("app", {bridge.SourceFile.new(PATH,
        "local dep = import \"dep\"\nfunction f(): integer return dep.public(1, \"one\") end\n")}),
      bridge.ProjectModule.new("dep", {bridge.SourceFile.new(dependency,
        "--- Choose a saved count.\n-- @param count Number to return.\n-- @usage functions.md#named-calls\n" ..
        "function public(count: integer, label: string): integer return count end\n")}),
    })
    local documents = buffers.create()
    local completion = service.create(store, documents)
    defer completion:close()
    open(documents, dependency, 1, "function newer(): integer return 3 end\n")
    local text = "local dep = import \"dep\"\nfunction f(): integer return dep.pubXYZ end\n"
    open(documents, PATH, 1, text)
    local options = lsp.CompletionOptions.new(true, true, true)
    local work = completion:capture(request(PATH, text, "dep.pub", options))
    work()
    await_preparation(completion)
    local permit = scheduler.acquire()
    defer permit:release()
    local item = selected_item(work(), "public")
    local edit? = wire.as_object(item["textEdit"])
    local details? = wire.as_object(item["labelDetails"])
    test.assert(wire.as_string(item["detail"]) == "public(count: integer, label: string): integer" and
      wire.as_string(details["detail"]) == "(count: integer, label: string): integer",
      "detached dependency lost declared parameter names before SQL selection")
    test.assert(wire.as_integer(item["insertTextFormat"]) == 2 and
      wire.as_string(edit["newText"]) == "public(${1:count}, ${2:label})$0",
      "ready SQL selection did not preserve callable snippet metadata")
    local documentation? = wire.as_object(item["documentation"])
    test.assert(documentation ~= nil and wire.as_string(documentation["kind"]) == "markdown" and
      strings.find(wire.as_string(documentation["value"]), "Choose a saved count.") ~= nil,
      "restored completion lost the saved dependency documentation")
    local reference = completion:capture(request(PATH, text, "dep.pub",
      lsp.CompletionOptions.new(true, true, false)))
    local plain = selected_item(reference(), "public")
    local plain_edit? = wire.as_object(plain["textEdit"])
    test.assert(wire.as_integer(plain["insertTextFormat"]) == 1 and
      wire.as_string(plain_edit["newText"]) == "public",
      "reference preference was lost on a reused prepared snapshot")

    local with_arguments = "local dep = import \"dep\"\nfunction f(): integer return dep.pubXYZ {count = 1, label = \"one\"} end\n"
    documents:apply(lsp.DocumentNotification.changed(lsp.ChangeDocument.new(
      lsp.TextDocument.new(URI, PATH), 2, with_arguments)))
    completion:changed()
    local provisional = completion:capture(request(PATH, with_arguments, "dep.pub", options))
    local outcome = provisional()
    local _, incomplete = labels(outcome)
    local retained = selected_item(outcome, "public")
    local retained_edit? = wire.as_object(retained["textEdit"])
    test.assert(incomplete and wire.as_integer(retained["insertTextFormat"]) == 1 and
      wire.as_string(retained_edit["newText"]) == "public",
      "provisional completion duplicated the current buffer's named call arguments")
  end)
end

function test_completion_service_detached_dependencies_ignore_dirty_imports(_context: test.Context)
  runtime.run(function ()
    local store = sql.open(":memory:")
    defer store:close()
    local dependency = ROOT .. "/dep.titan"
    seed_checked(store, {
      bridge.ProjectModule.new("app", {bridge.SourceFile.new(PATH,
        "local dep = import \"dep\"\nfunction f(): integer return dep.public() end\n")}),
      bridge.ProjectModule.new("dep", {bridge.SourceFile.new(dependency,
        "function public(): integer return 1 end\nlocal function secret(): integer return 2 end\n")}),
    })
    local documents = buffers.create()
    local completion = service.create(store, documents)
    defer completion:close()
    open(documents, dependency, 1, "function newer(): integer return 3 end\n")
    local ordinary = "local dep = import \"dep\"\nfunction f(): integer return dep. end\n"
    open(documents, PATH, 1, ordinary)
    local work = completion:capture(request(PATH, ordinary, "dep."))
    work()
    await_preparation(completion)
    local names = labels(work())
    test.assert(contains(names, "public") and not contains(names, "secret") and not contains(names, "newer"),
      "ordinary imports lost saved public visibility or consumed another module's dirty bytes")
    local direct = "local dep = import \"dep.titan\"\nfunction f(): integer return dep.sec end\n"
    documents:apply(lsp.DocumentNotification.changed(lsp.ChangeDocument.new(
      lsp.TextDocument.new(URI, PATH), 2, direct)))
    completion:changed()
    local private_work = completion:capture(request(PATH, direct, "dep.sec"))
    private_work()
    await_preparation(completion)
    test.assert(contains(labels(private_work()), "secret"), "detached direct-source visibility was lost")
  end)
end

function test_completion_service_hover_declines_unwatched_unsaved_headers(_context: test.Context)
  runtime.run(function ()
    local header = fs.tmpname()
    defer fs.unlink(header)
    fs.write_file(header, "int headerFunction(int argument);\n")
    local store = sql.open(":memory:")
    defer store:close()
    seed(store, {bridge.ProjectModule.new("app", {bridge.SourceFile.new(PATH, "local saved = 1\n")})})
    local documents = buffers.create()
    local completion = service.create(store, documents)
    defer completion:close()
    local text = "foreign import " .. strings.format("%q", header) ..
      "\nlocal newLocal = 1\nfunction read(): integer return newLo end\n"
    open(documents, PATH, 1, text)
    local work = completion:capture(request(PATH, text, "return newLo"))
    work()
    await_preparation(completion)
    test.assert(contains(labels(work()), "newLocal"),
      "volatile header fixture did not prepare compiler candidates")
    test.assert(completion.ready ~= nil and #completion.ready.volatile_headers > 0,
      "new unsaved header was incorrectly treated as watcher-owned")
    test.assert(completion.hover_context == nil and
      completion:hover(documents:capture(PATH, source_text.Position.new(1, 8))) == nil,
      "hover retained C knowledge without watcher-owned header freshness")
  end)
end

function test_completion_service_ignores_open_inactive_variants_and_completes_selected_variants(
    _context: test.Context)
  runtime.run(function ()
    local host = bridge.host_target()
    local store = sql.open(":memory:")
    defer store:close()
    local main_path = ROOT .. "/pkg/pkg." .. host .. ".titan"
    local active_ops = ROOT .. "/pkg/ops.native.titan"
    local inactive_main = ROOT .. "/pkg/pkg.titan"
    local inactive_browser = ROOT .. "/pkg/ops.browser.titan"
    local inactive_default = ROOT .. "/pkg/ops.titan"
    local oversize_inactive = ROOT .. "/pkg/oversize.browser.titan"
    local inactive_folder_main = ROOT .. "/inactive_folder/inactive_folder.browser.titan"
    local inactive_folder_saved_part = ROOT .. "/inactive_folder/part.titan"
    local inactive_folder_new_part = ROOT .. "/inactive_folder/new_part.titan"
    seed(store, {
      bridge.ProjectModule.new("pkg", {
        bridge.SourceFile.new(main_path, "function run(): integer\n return activeOp\nend\n"),
        bridge.SourceFile.new(active_ops, "function activeOperation(): integer return 1 end\n"),
      }),
    }, {
      inactive_main, inactive_browser, inactive_default,
      inactive_folder_main, inactive_folder_saved_part,
    })
    local documents = buffers.create()
    local completion = service.create(store, documents)
    defer completion:close()
    local main_text = "function run(): integer\n return activeOp\nend\n"
    local active_ops_text = "function activeOperation(): integer return 1 end\n" ..
      "function activeUnsaved(): integer return 2 end\n"
    local inactive_browser_text = "foreign import \"missing_inactive_header.h\"\n" ..
      "function activeFromBrowser(): integer return 3 end\n" ..
      "function broken(\n"
    local inactive_default_text = "function activeFromDefault(): integer return 4 end\n"
    local inactive_main_text = "function activeFromDefaultMain(): integer return 5 end\n"
    open(documents, main_path, 1, main_text)
    open(documents, active_ops, 1, active_ops_text)
    open(documents, inactive_browser, 1, inactive_browser_text)
    open(documents, inactive_default, 1, inactive_default_text)
    open(documents, inactive_main, 1, inactive_main_text)
    -- Make an inactive variant exceed the document byte limit (unavailable_paths).
    open(documents, oversize_inactive, 1, strings.rep("x", 4 * 1024 * 1024 + 16))

    local work = completion:capture(request(main_path, main_text, "return active"))
    work()
    await_preparation(completion)
    local names = labels(work())
    test.assert(contains(names, "activeOperation") and contains(names, "activeUnsaved"),
      "selected variant unsaved text was not included in completion analysis")
    test.assert(not contains(names, "activeFromBrowser") and
      not contains(names, "activeFromDefault") and
      not contains(names, "activeFromDefaultMain"),
      "open inactive variant contributed declarations to completion")

    local browser_work = completion:capture(
      request(inactive_browser, inactive_browser_text, "return 3"))
    browser_work()
    await_preparation(completion)
    local browser_names, browser_incomplete = labels(browser_work())
    test.assert(#browser_names == 0 and browser_incomplete,
      "open inactive browser variant received semantic completion")
    test.assert(completion:hover(documents:capture(
      inactive_browser, source_text.Position.new(1, 10))) == nil,
      "open inactive browser variant received semantic hover")

    local default_work = completion:capture(
      request(inactive_default, inactive_default_text, "return 4"))
    default_work()
    await_preparation(completion)
    local default_names, default_incomplete = labels(default_work())
    test.assert(#default_names == 0 and default_incomplete,
      "open shadowed default variant received semantic completion")

    -- VSS-1: an unopened inactive-only folder main blocks both a saved
    -- contributor and a newly opened unsaved contributor from completion/hover.
    local part_text = "local privateSentinel = 42\nfunction read(): integer\n return privateSen\nend\n"
    open(documents, inactive_folder_saved_part, 1, part_text)
    open(documents, inactive_folder_new_part, 1, part_text)
    completion.hover_context = nil
    local saved_part_work = completion:capture(
      request(inactive_folder_saved_part, part_text, "return privateSen"))
    saved_part_work()
    await_preparation(completion)
    local saved_part_names, saved_part_incomplete = labels(saved_part_work())
    test.assert(#saved_part_names == 0 and saved_part_incomplete and
      completion.hover_context == nil and
      completion:hover(documents:capture(
        inactive_folder_saved_part, source_text.Position.new(0, 8))) == nil,
      "saved contributor under unopened inactive-only main entered private analysis")

    local new_part_work = completion:capture(
      request(inactive_folder_new_part, part_text, "return privateSen"))
    new_part_work()
    await_preparation(completion)
    local new_part_names, new_part_incomplete = labels(new_part_work())
    test.assert(#new_part_names == 0 and new_part_incomplete and
      completion.hover_context == nil,
      "new unsaved contributor under unopened inactive-only main entered private analysis")
  end)
end

do
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then
    ROOT = "C:/completion-fixture"
    PATH = "C:/completion-fixture/app.titan"
    URI = "file:///C:/completion-fixture/app.titan"
  end
end
