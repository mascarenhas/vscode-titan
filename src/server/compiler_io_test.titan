local async = import "async"
local fs = import "fs"
local iteration = import "iteration"
local lua = import "lua"
local math = import "math"
local system = import "os"
local strings = import "string"
local test = import "test"
local compiler_io = import "server.compiler_io.titan"
local logging = import "server.logging"
local test_runtime = import "server.test_runtime"
foreign import "compiler_io_platform.h"

local function temporary_root(): string
  local root = fs.tmpname()
  fs.unlink(root)
  fs.mkdir(root)
  return root
end

local function remove_path(path: string)
  do
    local metadata? = fs.lstat(path)
    if not metadata then return end
    if (metadata as fs.Stat).kind == "directory" then
      fs.rmdir(path)
    else
      fs.unlink(path)
    end
  catch
  end
end

local function required_string(candidate: string?, failure: string?,
                               subject: string): string
  if not candidate then
    raise subject .. ": " .. (failure or "missing value")
  end
  test.assert(failure == nil, subject .. " returned a value and an error")
  return candidate as string
end

local function required_mutation(candidate: boolean?, failure: string?,
                                 subject: string)
  test.assert(candidate == true and failure == nil,
              subject .. ": " .. (failure or "operation returned false"))
end

local function bool_field(result: {string: value}, name: string): boolean
  local raw: value = result[name]
  if raw == nil then raise "missing boolean result field '" .. name .. "'" end
  local field: boolean = raw
  return field
end

local function integer_field(result: {string: value}, name: string): integer
  local field: integer = result[name]
  return field
end

local function float_field(result: {string: value}, name: string): float
  local field: float = result[name]
  return field
end

local function string_field(result: {string: value}, name: string): string
  local field: string = result[name]
  return field
end

local function dump_fields(result: {string: value}): string
  local output = strings.writer()
  for key, item in iteration.pairs(result) do
    output:write(key .. "=" .. strings.tostring(item) .. ";")
  end
  return output:drain()
end

local function native_process_fixture(): string
  local fixture? = system.getenv("TITAN_COMPILER_IO_PROCESS_FIXTURE")
  if not fixture or #fixture == 0 then
    raise "native CompilerIO tests require TITAN_COMPILER_IO_PROCESS_FIXTURE"
  end
  return fixture
end

local function link_fixture(strategy: compiler_io.CompilerIO, source: string,
                            link: string, symbolic: boolean): {string: value}
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then
    local command = "hard-link"
    if symbolic then command = "symbolic-link" end
    return strategy:run({[1] = native_process_fixture(), [2] = command,
                         [3] = source, [4] = link}, nil)
  end
  if symbolic then
    return strategy:run({[1] = "ln", [2] = "-s", [3] = source, [4] = link}, nil)
  end
  return strategy:run({[1] = "ln", [2] = source, [3] = link}, nil)
end

local function require_symlink(result: {string: value})
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 and bool_field(result, "started") and
     integer_field(result, "status") == 1314 then
    test.skip("Windows account cannot create symbolic links (Win32 1314)")
  end
  test.assert(bool_field(result, "ok"),
              "could not create symlink fixture: " .. string_field(result, "diagnostic"))
end

local function filesystem_contract()
  local strategy = compiler_io.create()
  local root = temporary_root()
  defer remove_path(root)

  local cwd?, cwd_error? = strategy:cwd()
  test.assert(required_string(cwd, cwd_error, "cwd") == system.cwd(),
              "compiler I/O cwd changed the process directory")

  local directory = root .. "/nested"
  local made?, make_error? = strategy:mkdir(directory)
  required_mutation(made, make_error, "mkdir")
  defer remove_path(directory)

  local source = directory .. "/source.bin"
  local bytes = "prefix\0middle\255suffix"
  local written?, write_error? = strategy:write_file(source, bytes)
  required_mutation(written, write_error, "write_file")
  defer remove_path(source)
  test.assert(strategy:readable(source),
              "written compiler input was not readable")
  local contents?, read_error? = strategy:read_file(source)
  test.assert(required_string(contents, read_error, "read_file") == bytes,
              "compiler I/O changed binary file bytes")
  local exact?, exact_error? = strategy:read_file(source, #bytes)
  test.assert(required_string(exact, exact_error, "bounded exact read") ==
              bytes,
              "bounded read changed a file exactly at its limit")
  local bounded?, bounded_error? = strategy:read_file(source, 5)
  test.assert(required_string(bounded, bounded_error, "bounded prefix read") ==
              strings.sub(bytes, 1, 6),
              "bounded read did not retain exactly one overflow byte")
  local first?, first_error? = strategy:read_file(source, 0)
  test.assert(required_string(first, first_error, "zero-bound read") == "p",
              "zero-bound read did not retain its one overflow byte")
  local invalid?, invalid_error? = strategy:read_file(source, -1)
  test.assert(invalid == nil and invalid_error ~= nil and
              strings.find(invalid_error, "nonnegative integer") ~= nil,
              "negative read limit was not rejected before filesystem I/O")
  invalid, invalid_error = strategy:read_file(source, math.maxinteger)
  test.assert(invalid == nil and invalid_error ~= nil and
              strings.find(invalid_error, "nonnegative integer") ~= nil,
              "overflowing read limit was not rejected before filesystem I/O")

  local raw_metadata?, stat_error? = strategy:stat(source)
  test.assert(raw_metadata ~= nil and stat_error == nil,
              "stat did not return file metadata")
  local metadata: {string: value} = raw_metadata
  local kind: string = metadata["kind"]
  local size: integer = metadata["size"]
  local mode: integer = metadata["mode"]
  local device: integer = metadata["device"]
  local inode: integer = metadata["inode"]
  local modified_seconds: integer = metadata["modified_seconds"]
  local modified_nanoseconds: integer = metadata["modified_nanoseconds"]
  test.assert(kind == "file" and size == #bytes and
              (mode & 0xF000) == 0x8000,
              "stat returned non-normalized file metadata")
  test.assert(modified_seconds >= 0 and modified_nanoseconds >= 0 and
              modified_nanoseconds < 1000000000,
              "stat returned an invalid modification timestamp")

  local hard_link = directory .. "/source-hard-link"
  defer remove_path(hard_link)
  local hard_linked = link_fixture(strategy, source, hard_link, false)
  test.assert(bool_field(hard_linked, "ok"),
              "could not create hard-link fixture: " ..
              string_field(hard_linked, "diagnostic"))
  local hard_link_metadata?: {string: value} = strategy:stat(hard_link)
  test.assert(hard_link_metadata ~= nil,
              "stat omitted an existing hard link")
  local hard_device: integer = hard_link_metadata["device"]
  local hard_inode: integer = hard_link_metadata["inode"]
  test.assert(hard_device == device and hard_inode == inode,
              "stat did not preserve physical identity through a hard link")
  remove_path(hard_link)

  local raw_entries?, list_error? = strategy:list(directory)
  test.assert(raw_entries ~= nil and list_error == nil,
              "list failed for the compiler input directory")
  local entries: {integer: string} = raw_entries
  test.assert(#entries == 1 and entries[1] == "source.bin",
              "list did not return one dense Lua-compatible entry table")

  local canonical?, canonical_error? = strategy:realpath(source)
  local canonical_path = required_string(
    canonical, canonical_error, "realpath")
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then
    test.assert(strings.sub(canonical_path, 2, 2) == ":" and
      (strings.sub(canonical_path, 3, 3) == "\\" or
       strings.sub(canonical_path, 3, 3) == "/"),
      "realpath did not return the fixture absolute Windows drive path")
  else
    test.assert(strings.sub(canonical_path, 1, 1) == "/",
                "realpath did not return an absolute source path")
  end

  local renamed = directory .. "/renamed.bin"
  defer remove_path(renamed)
  local renamed_ok?, rename_error? = strategy:rename(source, renamed)
  required_mutation(renamed_ok, rename_error, "rename")
  local renamed_contents?, renamed_read_error? = strategy:read_file(renamed)
  test.assert(required_string(
    renamed_contents, renamed_read_error, "renamed read") == bytes,
    "rename changed the complete file bytes")

  local removed?, remove_error? = strategy:unlink(renamed)
  required_mutation(removed, remove_error, "unlink")
  local absent?, absent_error? = strategy:stat(renamed)
  test.assert(absent == nil and absent_error == nil,
              "stat did not normalize a missing path to nil, nil")
  absent, absent_error = strategy:lstat(renamed)
  test.assert(absent == nil and absent_error == nil,
              "lstat did not normalize a missing path to nil, nil")
  local missing_contents?, missing_error? = strategy:read_file(renamed)
  test.assert(missing_contents == nil and missing_error ~= nil,
              "read_file did not retain a missing-path error string")

  local temporary?, temporary_error? = strategy:tmpname()
  local temporary_path = required_string(
    temporary, temporary_error, "tmpname")
  defer remove_path(temporary_path)
  local temporary_stat? = strategy:stat(temporary_path)
  test.assert(temporary_stat ~= nil,
              "tmpname did not leave its caller-owned empty file")

  local replacement?, replacement_error? =
    strategy:write_file(directory, "must not replace a directory")
  test.assert(replacement == nil and replacement_error ~= nil,
              "atomic write unexpectedly replaced a directory")
  local root_entries? = strategy:list(root)
  local remaining: {integer: string} = root_entries
  local preserved_directory? = strategy:stat(directory)
  test.assert(#remaining == 1 and remaining[1] == "nested" and
              preserved_directory ~= nil,
              "failed atomic write leaked its sibling or removed its target")

  local removed_directory?, directory_error? = strategy:rmdir(directory)
  required_mutation(removed_directory, directory_error, "rmdir")
end

function test_compiler_io_preserves_files_paths_and_lua_tables(
    _context: test.Context)
  test_runtime.run(filesystem_contract)
end

local function filesystem_symlink_contract()
  local strategy = compiler_io.create()
  local directory = temporary_root()
  defer remove_path(directory)
  local source = directory .. "/source.bin"
  fs.write_file(source, "symlink target bytes")
  defer remove_path(source)
  local canonical_path = fs.realpath(source)
  local link = directory .. "/source-link"
  defer remove_path(link)
  require_symlink(link_fixture(strategy, source, link, true))
  local followed? = strategy:stat(link)
  local unlinked? = strategy:lstat(link)
  test.assert(followed ~= nil and unlinked ~= nil,
              "stat/lstat omitted an existing symlink")
  local followed_metadata: {string: value} = followed
  local link_metadata: {string: value} = unlinked
  local followed_kind: string = followed_metadata["kind"]
  local link_kind: string = link_metadata["kind"]
  test.assert(followed_kind == "file" and link_kind == "symlink",
              "stat/lstat did not distinguish a symlink from its target")
  local link_canonical?, link_canonical_error? = strategy:realpath(link)
  test.assert(required_string(
    link_canonical, link_canonical_error, "symlink realpath") ==
    canonical_path,
    "realpath did not canonicalize a symlink to its target")

end

function test_compiler_io_follows_created_symbolic_links(_context: test.Context)
  test_runtime.run(filesystem_symlink_contract)
end

local function windows_process_contract()
  local strategy = compiler_io.create()
  local fixture = native_process_fixture()
  local original_lang? = system.getenv("LANG")
  local original_all? = system.getenv("LC_ALL")
  local success = strategy:run({ [1] = fixture, [2] = "locale" }, nil)
  test.assert(bool_field(success, "started") and bool_field(success, "ok") and
              integer_field(success, "status") == 0 and
              float_field(success, "wall_ms") >= 0.0,
              "native compiler child failed: " .. dump_fields(success))
  test.assert(string_field(success, "output") == "C|C|A\0B|diagnostic" and
              string_field(success, "diagnostic") == string_field(success, "output"),
              "native capture changed locale, binary bytes, or merged output")
  test.assert(system.getenv("LANG") == original_lang and
              system.getenv("LC_ALL") == original_all,
              "compiler I/O changed parent locale variables")
  test.assert(strings.find(string_field(success, "command"), "LANG=C LC_ALL=C ") == 1,
              "native command label omitted child locale options")
  local codes = {7, 126, 127}
  for index = 1, #codes do
    local result = strategy:run({
      [1] = fixture, [2] = "exit", [3] = strings.tostring(codes[index]),
    }, nil)
    test.assert(bool_field(result, "started") and not bool_field(result, "ok") and
                integer_field(result, "status") == codes[index] and
                string_field(result, "output") == "rejected",
                "native exit code was mistaken for a launch failure")
  end
  local missing = strategy:run({ [1] = fixture .. ".missing" }, nil)
  test.assert(not bool_field(missing, "started") and not bool_field(missing, "ok") and
              missing["status"] == nil,
              "native prelaunch failure fabricated a child exit status")
  local unmerged = strategy:run({ [1] = fixture, [2] = "stdout" },
      { ["stderr_to_stdout"] = false })
  test.assert(string_field(unmerged, "output") == "stdout-only" and
              strings.sub(string_field(unmerged, "command"), -5) ~= " 2>&1",
              "native capture changed split stderr policy")
  local delayed = strategy:run({ [1] = fixture, [2] = "delay" }, nil)
  local elapsed = float_field(delayed, "wall_ms")
  test.assert(bool_field(delayed, "ok") and elapsed >= 10.0 and elapsed < 5000.0,
              "native monotonic clock did not measure child wall time")
  local large = strategy:run({ [1] = fixture, [2] = "large" }, nil)
  test.assert(bool_field(large, "ok") and #string_field(large, "output") == 131072,
              "native capture failed to drain output larger than pipe capacity")
end

local function process_contract()
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then
    windows_process_contract()
    return
  end
  local strategy = compiler_io.create()
  local script =
    "printf '%s|%s|' \"$LANG\" \"$LC_ALL\"; " ..
    "printf 'A\\000B'; printf '|diagnostic' >&2"
  local success = strategy:run({
    [1] = "sh", [2] = "-c", [3] = script,
  }, nil)
  test.assert(success["ok"] ~= nil, "success result omitted ok")
  test.assert(bool_field(success, "started") and
              bool_field(success, "ok") and
              integer_field(success, "status") == 0 and
              float_field(success, "wall_ms") >= 0.0 and
              string_field(success, "why") == "exit" and
              not bool_field(success, "interrupted"),
              "successful captured command returned the wrong status")
  test.assert(string_field(success, "output") ==
              "C|C|A\0B|diagnostic" and
              string_field(success, "diagnostic") ==
              string_field(success, "output"),
              "captured command changed locale, binary bytes, or merge order")
  local command = string_field(success, "command")
  local prefix? = strings.find(command, "env LANG=C LC_ALL=C ")
  test.assert(prefix == 1 and strings.sub(command, -5) == " 2>&1",
              "captured command label omitted locale or merge policy")

  local rejected = strategy:run({
    [1] = "sh", [2] = "-c", [3] = "printf rejected; exit 7",
  }, nil)
  test.assert(rejected["ok"] ~= nil, "nonzero result omitted ok")
  test.assert(bool_field(rejected, "started") and
              not bool_field(rejected, "ok") and
              integer_field(rejected, "status") == 7 and
              string_field(rejected, "why") == "exit" and
              string_field(rejected, "output") == "rejected",
              "nonzero command status was not normalized")

  local missing = strategy:run({
    [1] = "/definitely/missing/titan-compiler-command",
  }, nil)
  test.assert(missing["ok"] ~= nil, "missing result omitted ok")
  test.assert(not bool_field(missing, "started") and
              not bool_field(missing, "ok") and
              integer_field(missing, "status") == 127 and
              string_field(missing, "why") == "exit" and
              not bool_field(missing, "interrupted"),
              "missing executable status was not normalized")

  local signalled = strategy:run({
    [1] = "sh", [2] = "-c", [3] = "kill -TERM $$",
  }, nil)
  test.assert(signalled["ok"] ~= nil,
              "signal result omitted ok: " .. dump_fields(signalled))
  test.assert(bool_field(signalled, "started") and
              not bool_field(signalled, "ok") and
              string_field(signalled, "why") == "signal" and
              integer_field(signalled, "status") == 15 and
              integer_field(signalled, "signal") == 15 and
              integer_field(signalled, "shell_status") == 143 and
              bool_field(signalled, "interrupted"),
              "signal termination was not normalized")

  local unmerged = strategy:run({
    [1] = "sh", [2] = "-c", [3] = "printf stdout-only",
  }, { ["stderr_to_stdout"] = false })
  test.assert(string_field(unmerged, "output") == "stdout-only" and
              strings.sub(string_field(unmerged, "command"), -5) ~= " 2>&1",
              "stderr_to_stdout=false did not select the split policy")

  local delayed = strategy:run({
    [1] = "sh", [2] = "-c", [3] = "sleep 0.05",
  }, nil)
  local delayed_wall_ms = float_field(delayed, "wall_ms")
  test.assert(bool_field(delayed, "ok") and delayed_wall_ms >= 10.0 and
              delayed_wall_ms < 5000.0,
              "child wall timing was not high-resolution monotonic time: " ..
              delayed_wall_ms)

  -- This exceeds ordinary pipe capacity. The run can finish only when its
  -- output reader and process waiter make progress concurrently.
  local large = strategy:run({
    [1] = "sh", [2] = "-c",
    [3] = "i=0; while [ $i -lt 8192 ]; do " ..
          "printf 0123456789abcdef; i=$((i+1)); done",
  }, nil)
  test.assert(large["ok"] ~= nil, "large-output result omitted ok")
  test.assert(bool_field(large, "ok") and
              #string_field(large, "output") == 131072,
              "captured process did not concurrently drain large output")
end

function test_compiler_io_captures_process_output_and_status(
    _context: test.Context)
  test_runtime.run(process_contract)
end

function test_compiler_io_bounded_reader_continues_after_short_reads(
    _context: test.Context)
  local chunks = {"ab", "c", "def", "must not be read"}
  local requests: {integer} = {}
  local index = 0
  local result = compiler_io.read_bounded_chunks(
    function (remaining: integer): string?
      requests[#requests + 1] = remaining
      index = index + 1
      return chunks[index]
    end, 5)
  test.assert(result == "abcdef" and index == 3,
              "bounded reader did not stop at exactly limit plus one")
  test.assert(#requests == 3 and requests[1] == 6 and
              requests[2] == 4 and requests[3] == 3,
              "bounded reader did not reduce each short-read request")

  local eof_chunks = {"ab", "c"}
  index = 0
  result = compiler_io.read_bounded_chunks(
    function (_remaining: integer): string?
      index = index + 1
      return eof_chunks[index]
    end, 5)
  test.assert(result == "abc" and index == 3,
              "bounded reader did not continue to EOF after short reads")
end

function test_compiler_io_preserves_launch_facts_and_rejects_bad_clock_samples(
    _context: test.Context)
  local before_spawn = compiler_io.capture_failure(
    "compiler", "spawn failed", false)
  local after_spawn = compiler_io.capture_failure(
    "compiler", "capture failed", true)
  test.assert(not bool_field(before_spawn, "started") and
              bool_field(after_spawn, "started"),
              "capture failures lost their pre/post-spawn distinction")

  test.assert(compiler_io.elapsed_monotonic_ms(12.5, 15.0) == 2.5,
              "valid monotonic samples did not produce elapsed time")
  test.assert(compiler_io.elapsed_monotonic_ms(-1.0, 15.0) == nil and
              compiler_io.elapsed_monotonic_ms(12.5, -1.0) == nil and
              compiler_io.elapsed_monotonic_ms(math.huge, 15.0) == nil and
              compiler_io.elapsed_monotonic_ms(12.5, math.huge) == nil and
              compiler_io.elapsed_monotonic_ms(0 / 0, 15.0) == nil and
              compiler_io.elapsed_monotonic_ms(12.5, 0 / 0) == nil and
              compiler_io.elapsed_monotonic_ms(15.0, 12.5) == nil,
              "invalid monotonic samples fabricated a wall duration")
end

local function lua_proxy_yield_contract()
  local strategy = compiler_io.create()
  local root = temporary_root()
  defer remove_path(root)
  local source = root .. "/source.titan"
  fs.write_file(source, "function answer(): integer return 42 end\n")
  defer remove_path(source)

  local observed = false
  local observer = async.run<|nil, value|>(function (): nil
    observed = true
    return nil
  end)
  local invoke = lua.load([==[
return function(strategy, path)
  assert(type(strategy) == "userdata",
         "Titan compiler I/O strategy did not cross as userdata")
  local metadata, stat_error = strategy:stat(path)
  assert(metadata and stat_error == nil and type(metadata) == "table",
         "stat did not cross as an ordinary Lua table")
  local entries, list_error = strategy:list(path:match("^(.*)/"))
  assert(entries and list_error == nil and type(entries) == "table",
         "list did not cross as an ordinary Lua table")
  local bounded, read_error = strategy:read_file(path, 5)
  assert(bounded == "functi" and read_error == nil,
         "bounded read did not cross the Lua proxy")
  strategy:yield("fixture.module")
  return metadata.kind, metadata.size, #entries, bounded
end
]==], "=compiler_io_lua_proxy", nil)() as
    function (compiler_io.CompilerIO, string): (string, integer, integer, string)

  local kind, size, entries, bounded = invoke(strategy, source)
  test.assert(observed,
              "CompilerIO:yield did not cooperatively run another Task")
  test.assert(kind == "file" and size > 0 and entries == 1 and
              bounded == "functi",
              "Lua proxy invocation changed stat/list results")
  test.assert(observer:status():has_succeeded(),
              "yield observer did not finish successfully")
end

function test_compiler_io_lua_proxy_calls_async_methods_and_yields(
    _context: test.Context)
  test_runtime.run(lua_proxy_yield_contract)
end

local function lstat_observation_contract()
  local strategy = compiler_io.create()
  local root = temporary_root()
  defer remove_path(root)
  local provider = root .. "/provider.so"
  fs.write_file(provider, "first provider")
  defer remove_path(provider)

  compiler_io.begin_lstat_observations(strategy)
  local raw?, raw_error? = strategy:lstat(provider)
  test.assert(raw ~= nil and raw_error == nil,
              "observed provider lstat failed")
  local identity? = compiler_io.consistent_lstat_identity(
    strategy, provider)
  test.assert(identity ~= nil and identity.path == provider and
              identity.kind == "file" and
              identity.size == #"first provider" and
              identity.device == integer_field(raw, "device") and
              identity.inode == integer_field(raw, "inode") and
              identity.modified_seconds ==
                integer_field(raw, "modified_seconds") and
              identity.modified_nanoseconds ==
                integer_field(raw, "modified_nanoseconds"),
              "typed lstat identity did not preserve compiler metadata")

  local repeated?, repeated_error? = strategy:lstat(provider)
  test.assert(repeated ~= nil and repeated_error == nil and
              compiler_io.consistent_lstat_identity(strategy, provider) ~= nil,
              "unchanged repeated lstat lost its consistent identity")

  fs.write_file(provider, "second provider with different bytes")
  local changed?, changed_error? = strategy:lstat(provider)
  test.assert(changed ~= nil and changed_error == nil and
              compiler_io.consistent_lstat_identity(strategy, provider) == nil,
              "conflicting lstat results retained a compiler identity")
  compiler_io.end_lstat_observations(strategy)
  test.assert(compiler_io.consistent_lstat_identity(strategy, provider) == nil,
              "ended lstat observation leaked an analysis identity")

  compiler_io.begin_lstat_observations(strategy)
  test.assert(compiler_io.consistent_lstat_identity(strategy, provider) == nil,
              "new lstat observation reused a previous analysis identity")
  strategy:lstat(provider)
  local fresh? = compiler_io.consistent_lstat_identity(strategy, provider)
  test.assert(fresh ~= nil and
              fresh.size == #"second provider with different bytes",
              "new analysis did not capture the current provider identity")
  compiler_io.end_lstat_observations(strategy)

end

local function symlink_lstat_observation_contract()
  local strategy = compiler_io.create()
  local root = temporary_root()
  defer remove_path(root)
  local target = root .. "/provider-target.so"
  local link = root .. "/provider-link.so"
  fs.write_file(target, "first target")
  defer remove_path(target)
  defer remove_path(link)
  require_symlink(link_fixture(strategy, target, link, true))

  compiler_io.begin_lstat_observations(strategy)
  local raw_link? = strategy:lstat(link)
  local followed_link? = strategy:stat(link)
  local link_identity? = compiler_io.consistent_lstat_identity(
    strategy, link)
  test.assert(raw_link ~= nil and followed_link ~= nil and
              string_field(raw_link, "kind") == "symlink" and
              link_identity ~= nil and link_identity.kind == "file" and
              link_identity.size == #"first target" and
              link_identity.device == integer_field(
                followed_link, "device") and
              link_identity.inode == integer_field(followed_link, "inode"),
              "provider observation did not follow the lstat symlink")
  fs.write_file(target, "second target with different bytes")
  strategy:lstat(link)
  test.assert(compiler_io.consistent_lstat_identity(strategy, link) == nil,
              "symlink target replacement retained a stable identity")
  compiler_io.end_lstat_observations(strategy)
end

function test_compiler_io_tracks_only_consistent_per_analysis_lstat_identity(
    _context: test.Context)
  test_runtime.run(lstat_observation_contract)
end

function test_compiler_io_tracks_created_symbolic_link_targets(
    _context: test.Context)
  test_runtime.run(symlink_lstat_observation_contract)
end

local function compiler_progress_contract()
  local previous_level = logging.level()
  defer logging.configure(previous_level)
  test.assert(logging.configure("debug"),
              "compiler progress test could not enable debug logging")
  local strategy = compiler_io.create()
  local checkpoints: {string} = {}
  compiler_io.set_checkpoint_listener(
    strategy, function (module_name: string?)
      if module_name ~= nil then
        checkpoints[#checkpoints + 1] = module_name
      end
      if module_name == "project.raise" then
        raise "deliberate progress listener failure"
      end
    end)
  local first_attempt = strategy:begin_attempt("project.main")
  test.assert(first_attempt == 1,
              "compiler progress did not start at attempt one")

  strategy:yield("project.dependency")
  strategy:yield(nil)
  strategy:yield("project.raise")
  test.assert(strategy:finish_attempt(first_attempt) == 3,
              "compiler progress did not count one checkpoint per yield")
  test.assert(#checkpoints == 2 and
              checkpoints[1] == "project.dependency" and
              checkpoints[2] == "project.raise",
              "compiler checkpoint listener lost source module names")
  test.assert(strategy:finish_attempt(first_attempt) == 0,
              "compiler progress finish was not idempotent")

  compiler_io.set_checkpoint_listener(strategy, nil)
  strategy:yield("project.ignored")
  test.assert(#checkpoints == 2,
              "cleared compiler checkpoint listener was still invoked")

  local second_attempt = strategy:begin_attempt("project.other")
  test.assert(second_attempt == 2,
              "compiler progress did not advance the attempt number")
  test.assert(strategy:finish_attempt(second_attempt) == 0,
              "compiler progress reported a checkpoint before a yield")
end

function test_compiler_io_tracks_bounded_source_module_checkpoints(
    _context: test.Context)
  test_runtime.run(compiler_progress_contract)
end

local function cancellation_contract()
  local strategy = compiler_io.create()
  local root = temporary_root()
  defer remove_path(root)
  local marker = root .. "/child.pid"
  defer remove_path(marker)

  local command: {integer: string} = {
    [1] = "sh", [2] = "-c",
    [3] = "echo $$ > '" .. marker .. "'; exec /bin/sleep 60",
  }
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then
    command = { [1] = native_process_fixture(), [2] = "wait", [3] = marker }
  end
  local running = async.run<|{string: value}, value|>(
    function (): {string: value} return strategy:run(command, nil) end)

  local attempts = 0
  while not fs.stat(marker) and attempts < 10000 do
    async.yield()
    attempts = attempts + 1
  end
  test.assert(fs.stat(marker) ~= nil,
              "owned child did not publish its process marker")

  running:cancel(async.CancellationReason.simple(
    "cancel captured compiler process"))
  local terminal = async.join(running)
  test.assert(terminal:as_string() == "cancelled",
              "cancelled captured process Task did not finish cancelled")

  local pid = fs.read_file(marker)
  local newline? = strings.find(pid, "\n")
  if newline then pid = strings.sub(pid, 1, newline - 1) end
  local gone = false
  attempts = 0
  while not gone and attempts < 100 do
    local probe_arguments: {integer: string} = {
      [1] = "sh", [2] = "-c", [3] = "kill -0 " .. pid .. " 2>/dev/null",
    }
    if ffi.VSCODE_TITAN_WINDOWS ~= 0 then
      probe_arguments = { [1] = native_process_fixture(), [2] = "probe", [3] = pid }
    end
    local probe = strategy:run(probe_arguments, nil)
    if ffi.VSCODE_TITAN_WINDOWS ~= 0 then
      test.assert(bool_field(probe, "started") and integer_field(probe, "status") <= 1,
                  "native child liveness probe failed")
    end
    gone = not bool_field(probe, "ok")
    if not gone then async.yield() end
    attempts = attempts + 1
  end
  if not gone then
    local cleanup_arguments: {integer: string} = {
      [1] = "sh", [2] = "-c", [3] = "kill -KILL " .. pid,
    }
    if ffi.VSCODE_TITAN_WINDOWS ~= 0 then
      cleanup_arguments = { [1] = native_process_fixture(), [2] = "kill", [3] = pid }
    end
    strategy:run(cleanup_arguments, nil)
  end
  test.assert(gone,
              "cancellation did not terminate and reap the owned child")
end

local function tmpname_entries(): {string: boolean}
  local result: {string: boolean} = {}
  local entries = fs.list(fs.tmpdir())
  for index = 1, #entries do
    local name = entries[index]
    if strings.sub(name, 1, 9) == "titan-fs-" then result[name] = true end
  end
  return result
end

local function cancelled_tmpname_releases_reservation()
  local strategy = compiler_io.create()
  local before = tmpname_entries()
  local pending = async.run<|string?, value|>(function (): string?
    local path? = strategy:tmpname()
    return path
  end)

  -- The caller Task first waits while its uncancelled handoff worker owns the
  -- mkstemp result. Cancellation at this point must make that worker unlink
  -- the reservation even though the caller cannot submit cleanup I/O itself.
  async.yield()
  test.assert(not pending:status():has_finished(),
              "tmpname handoff completed before cancellation could be tested")
  pending:cancel(async.CancellationReason.simple(
    "cancel tmpname while its reservation is in flight"))
  local terminal = async.join<|string?, value|>(pending)
  test.assert(terminal:as_string() == "cancelled",
              "tmpname caller did not finish cancelled")

  local clean = false
  local attempts = 0
  while not clean and attempts < 1000 do
    clean = true
    local after = tmpname_entries()
    for name, _ in iteration.pairs(after) do
      if not before[name] then clean = false end
    end
    if not clean then async.yield() end
    attempts = attempts + 1
  end
  test.assert(clean, "cancelled tmpname leaked its caller-owned reservation")
end

local function cancelled_owned_unlink_releases_reservation()
  local strategy = compiler_io.create()
  local reservation = fs.tmpname()
  defer remove_path(reservation)
  local started = false
  local pending = async.run<|nil, value|>(function (): nil
    started = true
    local removed?, failure? = strategy:unlink(reservation, true)
    if not removed then raise failure or "owned unlink failed" end
    return nil
  end)

  -- The first turn starts the Task and submits its unlink. Titan's filesystem
  -- continuation delivers a pending cancellation only after the accepted
  -- native operation completes, so the rollback branch must tolerate both an
  -- already absent path and an unlink that still needs to be retried.
  while not started do async.yield() end
  test.assert(not pending:status():has_finished(),
              "owned unlink completed before cancellation could be tested")
  pending:cancel(async.CancellationReason.simple(
    "cancel owned tmpname unlink while it is in flight"))
  local terminal = async.join<|nil, value|>(pending)
  test.assert(terminal:as_string() == "cancelled",
              "owned unlink caller did not finish cancelled")

  local clean = false
  local attempts = 0
  while not clean and attempts < 1000 do
    clean = fs.lstat(reservation) == nil
    if not clean then async.yield() end
    attempts = attempts + 1
  end
  test.assert(clean,
              "cancelled owned unlink leaked its tmpname reservation")
end

local function cancelled_owned_mkdir_removes_directory()
  local strategy = compiler_io.create()
  local root = temporary_root()
  defer remove_path(root)
  local directory = root .. "/cancelled-owned-directory"
  defer remove_path(directory)
  local started = false
  local pending = async.run<|nil, value|>(function (): nil
    started = true
    local made?, failure? = strategy:mkdir(directory, true)
    if not made then raise failure or "owned mkdir failed" end
    return nil
  end)

  while not started do async.yield() end
  test.assert(not pending:status():has_finished(),
              "owned mkdir completed before cancellation could be tested")
  pending:cancel(async.CancellationReason.simple(
    "cancel owned mkdir while it is in flight"))
  local terminal = async.join<|nil, value|>(pending)
  test.assert(terminal:as_string() == "cancelled",
              "owned mkdir caller did not finish cancelled")

  local clean = false
  local attempts = 0
  while not clean and attempts < 1000 do
    clean = fs.lstat(directory) == nil
    if not clean then async.yield() end
    attempts = attempts + 1
  end
  test.assert(clean,
              "cancelled owned mkdir leaked its newly created directory")
end

