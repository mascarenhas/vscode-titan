function test_compiler_io_temporary_leaf_uses_native_separators(
    _context: test.Context)
  test.assert(compiler_io.temporary_leaf("/tmp/reservation") == "reservation",
              "temporary leaf lost slash separator")
  local windows_path = "C:\\Users\\worker\\reservation"
  local expected = windows_path
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then expected = "reservation" end
  test.assert(compiler_io.temporary_leaf(windows_path) == expected,
              "temporary leaf changed native backslash semantics")
end

function test_compiler_io_keeps_opaque_provider_identity_complete(_context: test.Context)
  local native = compiler_io.LstatIdentity.new(
    "C:/provider.dll", 42, "file", nil, nil, 100, 700, "volume\0full-128-bit-file-id")
  local same = compiler_io.LstatIdentity.new(
    native.path, native.size, native.kind, nil, nil, 100, 700, native.native_identity)
  test.assert(compiler_io.same_lstat_identity(native, same), "matching opaque identity changed")
  same.native_identity = nil
  test.assert(not compiler_io.same_lstat_identity(native, same), "missing opaque identity fell back to integers")
  same.native_identity = "volume\0different-full-file-id"
  test.assert(not compiler_io.same_lstat_identity(native, same), "different full file identity was ignored")
  same.native_identity = native.native_identity
  same.path = "C:/other.dll"
  test.assert(not compiler_io.same_lstat_identity(native, same), "provider pathname was ignored")
  if ffi.VSCODE_TITAN_WINDOWS == 0 then
    test.assert(not compiler_io.lstat_identity_is_current(native), "Unix accepted a forged Windows identity")
  end
end
