--- Typed editor captures, prepared completion facts, and ephemeral hover identities.
-- @module server.completion_types

-- Compiler-normalized completion facts. These scalar records are the narrow
-- boundary between private compiler preparation and SQL-only selection.
const MAX_HOVER_BYTES = 4 * 1024 * 1024
const MAX_HOVER_ROWS = 100000

record Candidate
  const label: string
  const lookup_domain: string
  const lookup_key: string
  const kind: integer
  const detail: string
  const type_key: string
  const scope_id: integer
  const scope_depth: integer
  const declaration_order: integer
  const available: boolean
  const visibility: string
  const owner_key: string
  const access_mode: string
  const call_snippet: string?
  const documentation: string?
end

record Scope
  const id: integer
  const parent_id: integer?
  const kind: string
  const filename: string
  const byte_start: integer
  const byte_finish: integer
end

record ModuleFacts
  const module_name: string
  const candidates: {Candidate}
  const documentation: string?
end

record OpenDocument
  const uri: string
  const filename: string
  const module_name: string
  const session: integer
  const version: integer
  const contents: string
end

record Input
  const filename: string
  const session: integer
  const version: integer
  const contents: string
end

record Snapshot
  const id: string
  const module_name: string
  const saved_generation: integer
  const buffer_epoch: integer
  const context_key: string
  const filename: string
  const document_session: integer
  const document_version: integer
  const caret_byte: integer
  const replace_start: integer
  const replace_finish: integer
  const prefix: string
  const quality: string
  const inputs: {Input}
  const scopes: {Scope}
  const candidates: {Candidate}
  const hovers: ({Hover})?
end

record Selection
  const candidates: {Candidate}
  const is_incomplete: boolean
end

-- Already rendered during private preparation. Hover queries retain no AST
-- and use original editor byte spans, never the compiler's dummy-token text.
record Hover
  const filename: string
  const byte_start: integer
  const byte_finish: integer
  const markdown: string
end
