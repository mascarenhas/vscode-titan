local function traverses_to_nested_source_root_after_invalid_component()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("vendor.foo")
    fixture:mkdir("vendor.foo/src")
    fixture:mkdir("vendor.foo/src/pkg")
    fixture:write("vendor.foo/src/pkg/item.titan")

    local nested = fixture:path("vendor.foo/src")
    local found?, failure? = discovery.discover(
      {fixture.root}, {}, {nested})
    test.assert(failure == nil and found ~= nil and #found.issues == 0,
                "nested source root behind invalid include component failed")
    test.assert(found:find_module("pkg.item") ~= nil and
                found:owner_for_file(
                  fixture:path("vendor.foo/src/pkg/item.titan")) == "pkg.item",
                "nested source root did not reset logical module identity")
    test.assert(#found.directories == 4 and
                found.directories[2] == fixture:path("vendor.foo") and
                found.directories[3] == nested,
                "discovery pruned the path leading to a nested source root")
  end)
end

function test_project_discovery_reaches_nested_source_root_after_invalid_component(
    _context: test.Context)
  test_runtime.run(traverses_to_nested_source_root_after_invalid_component)
end

local function preserves_lexical_source_ancestry_above_symlinked_include()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("actual")
    fixture:write("actual/item.titan")
    local actual = fixture:path("actual")
    local linked = fixture:path("linked")
    test_links.directory(actual, linked,
      "could not create source-ancestry symlink fixture")
    defer fs.unlink(linked)

    local found?, failure? = discovery.discover(
      {linked}, {}, {fixture.root})
    test.assert(failure == nil and found ~= nil and #found.issues == 0 and
                found:find_module("linked.item") ~= nil,
                "lexical source root ancestry was replaced by canonical path")
    local linked_owner? = found:owner_for_file(linked .. "/item.titan")
    local canonical_item = fs.realpath(actual .. "/item.titan")
    local canonical_owner? = found:owner_for_file(canonical_item)
    test.assert(linked_owner == "linked.item",
                "lexical symlink source lost owner: " ..
                strings.tostring(linked_owner))
    test.assert(canonical_owner == "linked.item",
                "canonical symlink target lost owner: " ..
                strings.tostring(canonical_owner))
  end)
end

function test_project_discovery_preserves_lexical_source_root_ancestry(
    _context: test.Context)
  test_runtime.run(preserves_lexical_source_ancestry_above_symlinked_include)
end

