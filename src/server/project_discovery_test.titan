local fs = import "fs"
local os = import "os"
local test = import "test"
local strings = import "string"
local discovery = import "server.project_discovery"
local test_runtime = import "server.test_runtime"

local record Fixture
  root: string
  files: {string}
  directories: {string}
  known_files: {string: boolean}
  known_directories: {string: boolean}
end

local type FixtureBody = (Fixture) -> ()

local function new_fixture(): Fixture
  local root = fs.tmpname()
  fs.unlink(root)
  fs.mkdir(root)
  return Fixture.new(root, {}, {root}, {}, {[root] = true})
end

local function Fixture:path(relative: string): string
  return self.root .. "/" .. relative
end

local function Fixture:mkdir(relative: string)
  local path = self:path(relative)
  fs.mkdir(path)
  if self.known_directories[path] == nil then
    self.known_directories[path] = true
    self.directories[#self.directories + 1] = path
  end
end

local function Fixture:write(relative: string)
  local path = self:path(relative)
  fs.write_file(path, "-- " .. relative .. "\n")
  if self.known_files[path] == nil then
    self.known_files[path] = true
    self.files[#self.files + 1] = path
  end
end

local function Fixture:remove(relative: string)
  local path = self:path(relative)
  if fs.lstat(path) ~= nil then fs.unlink(path) end
end

local function Fixture:cleanup()
  for index = #self.files, 1, -1 do
    if fs.lstat(self.files[index]) ~= nil then fs.unlink(self.files[index]) end
  end
  for index = #self.directories, 1, -1 do
    if fs.lstat(self.directories[index]) ~= nil then
      fs.rmdir(self.directories[index])
    end
  end
end

local function with_fixture(body: FixtureBody)
  local fixture = new_fixture()
  defer fixture:cleanup()
  body(fixture)
end

local function require_discovery(root: string): discovery.Discovery
  local found?, failure? = discovery.discover({root}, {})
  test.assert(failure == nil and found ~= nil,
              "valid project source tree was not discovered")
  return found
end

local function scans_flat_folder_and_nested_modules()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("pkg")
    fixture:mkdir("pkg/nested")
    fixture:mkdir(".build")
    fixture:mkdir(".build/generated")
    fixture:write("flat.titan")
    fixture:write("pkg.titan")
    fixture:write("pkg/pkg.titan")
    fixture:write("pkg/z.titan")
    fixture:write("pkg/A.titan")
    fixture:write("pkg/nested.titan")
    fixture:write("pkg/titan.titan")
    fixture:write("pkg/nested/nested.titan")
    fixture:write("pkg/nested/b.titan")
    fixture:write(".build/generated/copied.titan")

    local found = require_discovery(fixture.root)
    test.assert(#found.issues == 0,
                "valid folder project produced discovery issues")
    test.assert(#found.modules == 3 and
                found.modules[1].name == "flat" and
                found.modules[2].name == "pkg" and
                found.modules[3].name == "pkg.nested",
                "module list was not bytewise sorted, complete, or pruned")
    test.assert(#found.directories == 3 and
                found.directories[1] == fixture.root and
                found.directories[2] == fixture:path("pkg") and
                found.directories[3] == fixture:path("pkg/nested"),
                "discovery did not retain its exact traversed directory set")

    local pkg? = found:find_module("pkg")
    test.assert(pkg ~= nil and pkg:is_folder(),
                "folder main did not take precedence over flat source")
    test.assert(#pkg.files == 5 and
                pkg.files[1] == fixture:path("pkg/pkg.titan") and
                pkg.files[2] == fixture:path("pkg/A.titan") and
                pkg.files[3] == fixture:path("pkg/nested.titan") and
                pkg.files[4] == fixture:path("pkg/titan.titan") and
                pkg.files[5] == fixture:path("pkg/z.titan"),
                "folder contributors were not main-first bytewise sorted")

    test.assert(found:owner_for_file("pkg/A.titan") == "pkg" and
                found:owner_for_file("pkg/nested.titan") == "pkg" and
                found:owner_for_file("pkg/nested/nested.titan") ==
                  "pkg.nested",
                "owner_by_file lost contributor or nested-module ownership")
    test.assert(found:owner_for_file("pkg.titan") == nil,
                "folder-shadowed flat source was incorrectly made an owner")
  end)
end

function test_project_discovery_matches_folder_first_driver_precedence(
    _context: test.Context)
  test_runtime.run(scans_flat_folder_and_nested_modules)
end

local function reports_only_invalid_logical_module_names()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("good")
    fixture:mkdir("owner")
    fixture:write("titan.titan")
    fixture:write("bad name.titan")
    fixture:write("good/9bad.titan")
    fixture:write("owner/owner.titan")
    fixture:write("owner/bad name.titan")

    local found = require_discovery(fixture.root)
    test.assert(found:find_module("titan") ~= nil and
                found:find_module("owner") ~= nil,
                "valid root or folder module was omitted")
    test.assert(#found.issues == 2 and
                strings.find(found.issues[1].message,
                             "invalid logical Titan module name") ~= nil and
                strings.find(found.issues[2].message,
                             "invalid logical Titan module name") ~= nil,
                "invalid flat module names were not reported deterministically")
    test.assert(found:owner_for_file("owner/bad name.titan") == "owner",
                "folder contributor filename was incorrectly treated as a " ..
                "logical module name")

    test.assert(discovery.valid_module_name("a-b.child_2"),
                "portable dash/underscore module name was rejected")
    test.assert(discovery.valid_module_name("titan"),
                "bare logical module titan was rejected")
    test.assert(discovery.valid_module_component("build") and
                discovery.valid_module_component("tmp") and
                not discovery.valid_module_component("build.debug") and
                not discovery.valid_module_component(".editor"),
                "single directory component predicate diverged from discovery")
    test.assert(not discovery.valid_module_name("app.titan") and
                not discovery.valid_module_name("bad..name") and
                not discovery.valid_module_name("9bad"),
                "reserved or non-portable logical module name was accepted")
  end)
end

function test_project_discovery_reports_invalid_names_without_rejecting_folder_contributors(
    _context: test.Context)
  test_runtime.run(reports_only_invalid_logical_module_names)
end

local function observes_folder_main_transitions()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("pkg")
    fixture:write("pkg.titan")
    fixture:write("pkg/extra.titan")

    local flat = require_discovery(fixture.root)
    test.assert(#flat.modules == 2 and
                flat:find_module("pkg") ~= nil and
                flat:find_module("pkg.extra") ~= nil and
                flat:owner_for_file("pkg.titan") == "pkg" and
                flat:owner_for_file("pkg/extra.titan") == "pkg.extra",
                "flat project did not expose both modules")

    fixture:write("pkg/pkg.titan")
    local folder = require_discovery(fixture.root)
    local pkg? = folder:find_module("pkg")
    test.assert(#folder.modules == 1 and pkg ~= nil and pkg:is_folder(),
                "creating a folder main did not replace flat resolution")
    test.assert(folder:owner_for_file("pkg.titan") == nil and
                folder:owner_for_file("pkg/extra.titan") == "pkg",
                "folder-main transition did not update file ownership")

    fixture:remove("pkg/pkg.titan")
    local restored = require_discovery(fixture.root)
    test.assert(#restored.modules == 2 and
                restored:find_module("pkg.extra") ~= nil and
                restored:owner_for_file("pkg.titan") == "pkg" and
                restored:owner_for_file("pkg/extra.titan") == "pkg.extra",
                "removing a folder main did not restore flat modules")
  end)
end

function test_project_discovery_recomputes_folder_main_transitions(
    _context: test.Context)
  test_runtime.run(observes_folder_main_transitions)
end

local function scans_ordered_multiple_roots_once()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("first")
    fixture:mkdir("second")
    fixture:mkdir("second/nested")
    fixture:write("first/shared.titan")
    fixture:write("second/shared.titan")
    fixture:write("second/only.titan")
    fixture:write("second/nested/nested.titan")

    local found?, failure? = discovery.discover(
      {fixture:path("first"), fixture:path("second")}, {})
    test.assert(failure == nil and found ~= nil,
                "multiple source roots were rejected")
    test.assert(#found.include_roots == 2 and
                found.include_roots[1] == fixture:path("first") and
                found.include_roots[2] == fixture:path("second"),
                "include root order was not retained")
    test.assert(#found.modules == 3 and
                found:find_module("nested") ~= nil and
                found:find_module("only") ~= nil and
                found:find_module("shared") ~= nil,
                "multiple roots did not produce one merged module catalog")
    test.assert(found:owner_for_file(fixture:path("first/shared.titan")) ==
                  "shared" and
                found:owner_for_file(fixture:path("second/shared.titan")) ==
                  nil,
                "later root did not preserve first-root module precedence")
  end)
end

function test_project_discovery_merges_ordered_include_roots(
    _context: test.Context)
  test_runtime.run(scans_ordered_multiple_roots_once)
end

local function gives_nested_include_its_own_module_identity()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("spec")
    fixture:mkdir("spec/stdlib")
    fixture:mkdir("spec/stdlib/titan")
    fixture:mkdir("spec/stdlib/titan/support")
    fixture:write("main.titan")
    fixture:write("spec/stdlib/titan/support/runtime.titan")

    local nested = fixture:path("spec/stdlib/titan")
    local found?, failure? = discovery.discover({fixture.root, nested}, {})
    test.assert(failure == nil and found ~= nil,
                "overlapping source roots were rejected")
    test.assert(#found.modules == 2 and
                found:find_module("main") ~= nil and
                found:find_module("support.runtime") ~= nil and
                found:find_module("spec.stdlib.titan.support.runtime") == nil,
                "nested include root did not own its physical subtree once")
    test.assert(found:owner_for_file(
                  fixture:path("spec/stdlib/titan/support/runtime.titan")) ==
                  "support.runtime",
                "nested include root lost source-file ownership")
  end)
end

function test_project_discovery_partitions_overlapping_include_roots(
    _context: test.Context)
  test_runtime.run(gives_nested_include_its_own_module_identity)
end

local function canonicalizes_aliased_include_and_exclude_roots()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("actual")
    fixture:mkdir("actual/pkg")
    fixture:write("actual/root.titan")
    fixture:write("actual/pkg/item.titan")
    local actual = fixture:path("actual")
    local nested = fixture:path("actual/pkg")
    local linked = fixture:path("linked")
    local linker = os.spawn("/bin/ln", {"-s", actual, linked})
    local link_input? = linker.stdin
    if link_input ~= nil then link_input:close() end
    local link_status = linker:wait()
    local link_output? = linker.stdout
    if link_output ~= nil then link_output:close() end
    local link_error? = linker.stderr
    if link_error ~= nil then link_error:close() end
    test.assert(link_status.code == 0 and link_status.signal == nil,
                "could not create include-root symlink fixture")
    defer fs.unlink(linked)

    local found?, failure? = discovery.discover(
      {linked, actual, nested}, {linked .. "/pkg"})
    test.assert(failure == nil and found ~= nil,
                "canonical include-root discovery failed")
    test.assert(#found.include_roots == 2 and
                found.include_roots[1] == linked and
                found.include_roots[2] == nested,
                "physical include aliases were not deduplicated in order")
    test.assert(#found.modules == 2 and
                found:find_module("root") ~= nil and
                found:find_module("item") ~= nil and
                found:find_module("pkg.item") == nil,
                "aliased overlap indexed one physical subtree twice")
    test.assert(#found.directories == 1 and
                found.directories[1] == linked,
                "aliased exclusion remained in the watcher directory set")
    test.assert(found:owner_for_file(
                  fixture:path("actual/pkg/item.titan")) == "item",
                "canonical nested include lost lexical file ownership")
  end)
end

function test_project_discovery_canonicalizes_include_and_exclude_aliases(
    _context: test.Context)
  test_runtime.run(canonicalizes_aliased_include_and_exclude_roots)
end

local function scans_but_does_not_watch_excluded_paths()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    fixture:mkdir("src/ignored")
    fixture:mkdir("src/ignored/deeper")
    fixture:mkdir("src/kept")
    fixture:write("src/ignored/hidden.titan")
    fixture:write("src/ignored/deeper/inner.titan")
    fixture:write("src/kept/excluded_file.titan")
    fixture:write("src/kept/visible.titan")

    local source = fixture:path("src")
    local ignored = fixture:path("src/ignored")
    local excluded_file = fixture:path("src/kept/excluded_file.titan")
    local found?, failure? = discovery.discover(
      {source}, {ignored, excluded_file})
    test.assert(failure == nil and found ~= nil,
                "watch exclusions made discovery fail")
    test.assert(found:find_module("ignored.hidden") ~= nil and
                found:find_module("ignored.deeper.inner") ~= nil and
                found:find_module("kept.excluded_file") ~= nil and
                found:find_module("kept.visible") ~= nil,
                "watch exclusions incorrectly removed saved source modules")
    test.assert(#found.directories == 2 and
                found.directories[1] == source and
                found.directories[2] == fixture:path("src/kept"),
                "excluded folder subtree remained in the watch directory set")
  end)
end

function test_project_discovery_keeps_excluded_sources_but_omits_watch_subtrees(
    _context: test.Context)
  test_runtime.run(scans_but_does_not_watch_excluded_paths)
end

local function rejects_non_directory_root()
  local path = fs.tmpname()
  defer fs.unlink(path)
  local found?, failure? = discovery.discover({path}, {})
  test.assert(found == nil and failure ~= nil and
              strings.find(failure.message, "not a directory") ~= nil,
              "regular file was accepted as an include root")
end

function test_project_discovery_rejects_non_directory_include_root(
    _context: test.Context)
  test_runtime.run(rejects_non_directory_root)
end
