                found:find_module("child") ~= nil and
                found:owner_for_file(fixture:path("pkg/pkg.titan")) == nil and
                strings.find(found.issues[1].message,
                             "different physical provider") ~= nil,
                "ambiguous flat/folder identity entered the project catalog")
  end)
end

function test_project_discovery_reports_overlapping_root_descriptor_mismatch(
