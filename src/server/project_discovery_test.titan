local function canonicalizes_aliased_include_and_exclude_roots()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("actual")
    fixture:mkdir("actual/pkg")
    fixture:write("actual/root.titan")
    fixture:write("actual/pkg/item.titan")
    local actual = fixture:path("actual")
    local nested = fixture:path("actual/pkg")
    local linked = fixture:path("linked")
    test_links.directory(actual, linked,
      "could not create include-root symlink fixture")
    defer fs.unlink(linked)

    local found?, failure? = discovery.discover(
      {linked, actual, nested}, {linked .. "/pkg"}, {actual, nested})
    test.assert(failure == nil and found ~= nil,
                "canonical include-root discovery failed")
    test.assert(#found.include_roots == 2 and
                found.include_roots[1] == linked and
                found.include_roots[2] == nested,
                "physical include aliases were not deduplicated in order")
    test.assert(#found.modules == 2 and
                found:find_module("root") ~= nil and
                found:find_module("item") ~= nil and
                found:find_module("pkg.item") == nil,
                "aliased overlap indexed one physical subtree twice")
    test.assert(#found.directories == 1 and
                found.directories[1] == linked,
                "aliased exclusion remained in the watcher directory set")
    test.assert(found:owner_for_file(
                  fixture:path("actual/pkg/item.titan")) == "item",
                "canonical nested include lost lexical file ownership")
    test.assert(found:owner_for_file(linked .. "/root.titan") == "root" and
                found:owner_for_file(actual .. "/root.titan") == "root",
                "source and include aliases did not share physical ownership")
  end)
end

function test_project_discovery_canonicalizes_include_and_exclude_aliases(
    _context: test.Context)
  test_runtime.run(canonicalizes_aliased_include_and_exclude_roots)
end

local function scans_but_does_not_watch_excluded_paths()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("src")
    fixture:mkdir("src/ignored")
    fixture:mkdir("src/ignored/deeper")
    fixture:mkdir("src/kept")
    fixture:write("src/ignored/hidden.titan")
    fixture:write("src/ignored/deeper/inner.titan")
    fixture:write("src/kept/excluded_file.titan")
    fixture:write("src/kept/visible.titan")

    local source = fixture:path("src")
    local ignored = fixture:path("src/ignored")
    local excluded_file = fixture:path("src/kept/excluded_file.titan")
    local found?, failure? = discovery.discover(
      {source}, {ignored, excluded_file}, {source})
    test.assert(failure == nil and found ~= nil,
                "watch exclusions made discovery fail")
    test.assert(found:find_module("ignored.hidden") ~= nil and
                found:find_module("ignored.deeper.inner") ~= nil and
                found:find_module("kept.excluded_file") ~= nil and
                found:find_module("kept.visible") ~= nil,
                "watch exclusions incorrectly removed saved source modules")
    test.assert(#found.directories == 2 and
                found.directories[1] == source and
                found.directories[2] == fixture:path("src/kept"),
                "excluded folder subtree remained in the watch directory set")
  end)
end

function test_project_discovery_keeps_excluded_sources_but_omits_watch_subtrees(
    _context: test.Context)
  test_runtime.run(scans_but_does_not_watch_excluded_paths)
end

local function reports_included_sources_without_module_roots()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("watched")
    fixture:mkdir("lookup")
    fixture:write("watched/main.titan")
    fixture:write("lookup/external.titan")

    local watched = fixture:path("watched")
    local found?, failure? = discovery.discover(
      {watched}, {}, {fixture:path("lookup")})
    test.assert(failure == nil and found ~= nil and
                #found.modules == 0 and #found.issues == 1 and
                found.issues[1].path == fixture:path("watched/main.titan") and
                strings.find(found.issues[1].message,
                             "source_module_roots") ~= nil,
                "unmapped watched source received an invented module name")
    test.assert(#found.directories == 0 and
                found:owner_for_file(fixture:path("watched/main.titan")) == nil,
                "unmapped include root remained watched or acquired an owner")
  end)
end

function test_project_discovery_reports_included_files_outside_source_roots(
    _context: test.Context)
  test_runtime.run(reports_included_sources_without_module_roots)
end

local function watches_only_mapped_source_branches()
  with_fixture(function (fixture: Fixture)
    fixture:mkdir("included")
    fixture:mkdir("included/src")
    fixture:mkdir("included/unmapped")
    fixture:mkdir("lookup")
    fixture:write("included/src/main.titan")
    fixture:write("included/loose.titan")
    fixture:write("included/unmapped/other.titan")
    fixture:write("lookup/external.titan")
    local included = fixture:path("included")
    local mapped = fixture:path("included/src")
    local unmapped = fixture:path("included/unmapped")
    local found?, failure? = discovery.discover(
      {included, unmapped}, {unmapped}, {mapped, fixture:path("lookup")})
    test.assert(failure == nil and found ~= nil and
                #found.modules == 1 and found.modules[1].name == "main" and
                #found.issues == 2,
                "mixed include scope lost mapped modules or unmapped warnings")
    test.assert(found.issues[1].path == fixture:path("included/loose.titan") and
                found.issues[2].path == unmapped .. "/other.titan",
                "unmapped source warnings were duplicated or reordered")
    for index = 1, #found.issues do
      case found.issues[index].kind
      when unmapped_source() then
      else test.assert(false, "unmapped source issue lost its warning category")
      end
      test.assert(found:owner_for_file(found.issues[index].path) == nil,
                  "unmapped source entered project module ownership")
    end
    test.assert(#found.directories == 2 and
                found.directories[1] == included and
                found.directories[2] == mapped,
                "watch scope included an unmapped or external branch")

    local remapped?, remap_error? = discovery.discover(
      {included, unmapped}, {unmapped},
      {mapped, unmapped, fixture:path("lookup")})
    test.assert(remap_error == nil and remapped ~= nil and
                #remapped.modules == 2 and #remapped.issues == 1 and
                remapped:owner_for_file(unmapped .. "/other.titan") == "other" and
                #remapped.directories == 2,
                "adding a source root did not resolve its warning or preserve exclude")
  end)
end

function test_project_discovery_watches_only_mapped_source_branches(
    _context: test.Context)
  test_runtime.run(watches_only_mapped_source_branches)
end

local function rejects_non_directory_root()
  local path = fs.tmpname()
  defer fs.unlink(path)
  local found?, failure? = discovery.discover({path}, {}, {path})
  test.assert(found == nil and failure ~= nil and
              strings.find(failure.message, "not a directory") ~= nil,
              "regular file was accepted as an include root")
end

function test_project_discovery_rejects_non_directory_include_root(
    _context: test.Context)
  test_runtime.run(rejects_non_directory_root)
end

function test_project_discovery_excludes_workspace_cache_even_as_explicit_root(
    _context: test.Context)
  test_runtime.run(function ()
    with_fixture(function (fixture: Fixture)
      fixture:mkdir(".titan-ls")
      fixture:write(".titan-ls/accidental.titan")
      fixture:write("main.titan")
      local cache = fixture:path(".titan-ls")
      local found?, failure? = discovery.discover(
        {fixture.root,cache},{},{fixture.root,cache})
      test.assert(failure == nil and found ~= nil and #found.modules == 1 and
        found.modules[1].name == "main", "cache directory entered saved module discovery")
      for index = 1, #found.directories do
        test.assert(found.directories[index] ~= cache,"cache directory acquired a watcher")
      end
    end)
  end)
end

function test_project_discovery_native_windows_roots(_context: test.Context)
  if ffi.VSCODE_TITAN_WINDOWS == 0 then test.skip("native Windows paths") end
  test.assert(discovery.parent_directory("C:/") == "C:/")
  test.assert(discovery.parent_directory("C:/project") == "C:/")
  test.assert(discovery.parent_directory("//server/share") == "//server/share")
  test.assert(discovery.parent_directory("//server/share/project") == "//server/share")
  test.assert(discovery.leaf_name("C:/project") == "project")
  test.assert(discovery.leaf_name("C:/") == "")
  test.assert(discovery.join("C:/", "project") == "C:/project")
  test.assert(discovery.relative_to_root("C:/", "C:/project/main.titan") ==
              "project/main.titan")
  test.assert(discovery.path_within("C:/", "C:/project") and
              not discovery.path_within("C:/", "W:/project"))
  test.assert(discovery.rebase_path("C:/main.titan", "C:/", "W:/") ==
              "W:/main.titan")
  test_runtime.run(function()
    with_fixture(function(fixture: Fixture)
      fixture:write("main.titan")
      local native = strings.writer()
      for index = 1, #fixture.root do
        local byte: integer = strings.byte(fixture.root, index)
        if byte == 47 then byte = 92 end
        native:write(strings.char(byte))
      end
      local native_root = native:drain()
      local found = require_discovery(native_root)
      test.assert(#found.modules == 1 and found.modules[1].name == "main")
      test.assert(found:owner_for_file(native_root .. "\\main.titan") == "main" and
                  found:owner_for_file(fixture:path("main.titan")) == "main",
                  "native and normalized paths did not share the saved owner")
      local physical?, failure? = source_text.normalize_absolute_path(
        fs.realpath(fixture:path("main.titan")))
      test.assert(failure == nil and found:owner_for_file(physical) == "main",
                  "physical file spelling did not retain the saved owner")
    end)
  end)
end

local function with_target_override(target: string, body: function (): ())
  local driver = lua.require("titan-compiler.driver") as {string: value}
  local original: value = driver["context_target"]
  driver["context_target"] = function (_context: value): value
    return target
  end
  defer driver["context_target"] = original
  body()
end

local function find_issue(issues: {discovery.Issue},
                          path: string): discovery.Issue?
  for index = 1, #issues do
    if issues[index].path == path then return issues[index] end
  end
  return nil
end

local function assert_inactive_issue(issues: {discovery.Issue}, path: string,
                                     target: string, logical: string,
                                     selected: string?)
  local issue? = find_issue(issues, path)
  test.assert(issue ~= nil, "missing inactive variant issue for " .. path)
  case issue.kind
  when inactive_variant() then
  else
    test.assert(false,
      "inactive variant received wrong issue kind: " .. issue.message)
  end
  local prefix = "not analyzed: inactive for host target '"
  if target == "browser" then prefix = "not analyzed: inactive for target '" end
  local expected = prefix .. target .. "'; '" .. logical .. "' has no active variant"
  if selected ~= nil then
    expected = prefix .. target .. "'; '" .. logical .. "' selects '" .. selected .. "'"
  end
  test.assert(issue.message == expected,
    "unexpected inactive variant diagnostic '" .. issue.message ..
    "' (expected '" .. expected .. "')")
end

local function selects_host_variants_and_composes_folders()
  with_fixture(function (fixture: Fixture)
    local host = bridge.host_target()
    local labels = bridge.source_labels()
    test.assert(#labels == 5, "compiler did not expose all five source labels")
    for index = 1, #labels do
      fixture:write("host_label." .. labels[index] .. ".titan")
    end
    fixture:write("host_label.titan")
    fixture:write("linux.titan")
    fixture:write("browser_only.browser.titan")
    fixture:mkdir("titan")
    fixture:mkdir("titan/example")
    fixture:write("titan/example/example.titan")
    fixture:write("titan/example/operations-common.titan")
    fixture:write("titan/example/operations.native.titan")
    fixture:write("titan/example/operations.browser.titan")
    fixture:write("titan/example/native-helpers.native.titan")
    fixture:write("titan/example/browser-helpers.browser.titan")
    fixture:write("titan/example/a-common.titan")
    fixture:write("titan/example/a.native.titan")
    fixture:write("titan/example/a.u.titan")
    fixture:write("titan/example/a_extra.titan")

    local found = require_discovery(fixture.root)
    local expected_host_file = "host_label." .. host .. ".titan"
    local host_module? = found:find_module("host_label")
    test.assert(host_module ~= nil and not host_module:is_folder() and
                #host_module.files == 1 and
                host_module.main_file == fixture:path(expected_host_file),
                "flat family did not select the host target variant")
    test.assert(found:owner_for_file(fixture:path(expected_host_file)) ==
                  "host_label" and
                found:owner_for_file(fixture:path("host_label.titan")) == nil and
                found:owner_for_file(fixture:path("host_label.browser.titan")) ==
                  nil,
                "inactive flat variants entered owner_by_file")
    for index = 1, #labels do
      local candidate = "host_label." .. labels[index] .. ".titan"
      if candidate ~= expected_host_file then
        assert_inactive_issue(
          found.issues, fixture:path(candidate), host,
          "host_label.titan", expected_host_file)
      end
    end
    assert_inactive_issue(
      found.issues, fixture:path("host_label.titan"), host,
      "host_label.titan", expected_host_file)
    assert_inactive_issue(
      found.issues, fixture:path("browser_only.browser.titan"), host,
      "browser_only.titan", nil)
    test.assert(found:find_module("browser_only") == nil,
                "target-only module with no applicable variant was discovered")
    test.assert(found:find_module("linux") ~= nil and
                found:owner_for_file(fixture:path("linux.titan")) == "linux",
                "bare label stem linux.titan was misclassified as a variant")

    local example? = found:find_module("titan.example")
    test.assert(example ~= nil and example:is_folder(),
                "folder module with variant contributors was not discovered")
    test.assert(#example.files == 8 and
                example.files[1] ==
                  fixture:path("titan/example/example.titan") and
                example.files[2] ==
                  fixture:path("titan/example/a-common.titan") and
                example.files[3] ==
                  fixture:path("titan/example/a.native.titan") and
                example.files[4] ==
                  fixture:path("titan/example/a.u.titan") and
                example.files[5] ==
                  fixture:path("titan/example/a_extra.titan") and
                example.files[6] ==
                  fixture:path("titan/example/native-helpers.native.titan") and
                example.files[7] ==
                  fixture:path("titan/example/operations-common.titan") and
                example.files[8] ==
                  fixture:path("titan/example/operations.native.titan"),
                "folder contributors did not follow logical bytewise sort order")
    assert_inactive_issue(
      found.issues, fixture:path("titan/example/operations.browser.titan"),
      host, "operations.titan", "operations.native.titan")
    assert_inactive_issue(
      found.issues, fixture:path("titan/example/browser-helpers.browser.titan"),
      host, "browser-helpers.titan", nil)

    if host ~= "native" then
      fixture:write("titan/example/example." .. host .. ".titan")
      fixture:write("titan/example/operations." .. host .. ".titan")
      local overridden = require_discovery(fixture.root)
      local updated? = overridden:find_module("titan.example")
      test.assert(updated ~= nil and #updated.files == 8 and
                  updated.main_file ==
                    fixture:path("titan/example/example." .. host .. ".titan") and
                  updated.files[1] == updated.main_file and
                  updated.files[8] ==
                    fixture:path("titan/example/operations." .. host .. ".titan"),
                  "OS-specific folder main and contributor did not override native/default")
      assert_inactive_issue(
        overridden.issues, fixture:path("titan/example/example.titan"),
        host, "example.titan", "example." .. host .. ".titan")
      assert_inactive_issue(
        overridden.issues,
        fixture:path("titan/example/operations.native.titan"),
        host, "operations.titan", "operations." .. host .. ".titan")
    end

    with_target_override("native", function ()
      local unlisted = require_discovery(fixture.root)
      local unlisted_host? = unlisted:find_module("host_label")
      test.assert(unlisted_host ~= nil and
                  unlisted_host.main_file ==
                    fixture:path("host_label.native.titan"),
                  "label-less native host did not select .native.titan over default")
      assert_inactive_issue(
        unlisted.issues, fixture:path("host_label." .. host .. ".titan"),
        "native", "host_label.titan", "host_label.native.titan")
    end)

    local browser = require_discovery(fixture.root, "browser")
    local browser_example? = browser:find_module("titan.example")
    test.assert(browser_example ~= nil and #browser_example.files == 7 and
                browser_example.files[1] == fixture:path("titan/example/example.titan") and
                browser_example.files[5] == fixture:path("titan/example/browser-helpers.browser.titan") and
                browser_example.files[7] == fixture:path("titan/example/operations.browser.titan"),
                "browser target did not select browser contributors and omit native-only ones")
    test.assert(browser:find_module("browser_only") ~= nil,
                "browser target did not select browser-only flat module")
    assert_inactive_issue(browser.issues, fixture:path("titan/example/operations.native.titan"),
      "browser", "operations.titan", "operations.browser.titan")

    if host ~= "native" then
      fixture:remove(expected_host_file)
      local after_host_removed = require_discovery(fixture.root)
      local native_selected? = after_host_removed:find_module("host_label")
      test.assert(native_selected ~= nil and
                  native_selected.main_file ==
                    fixture:path("host_label.native.titan"),
                  "removing OS variant did not fall back to host_label.native.titan")
      assert_inactive_issue(
        after_host_removed.issues, fixture:path("host_label.titan"),
        host, "host_label.titan", "host_label.native.titan")
    end
    fixture:remove("host_label.native.titan")
    local after_native_removed = require_discovery(fixture.root)
    local default_selected? = after_native_removed:find_module("host_label")
    test.assert(default_selected ~= nil and
                default_selected.main_file ==
                  fixture:path("host_label.titan"),
                "removing .native.titan did not fall back to host_label.titan")
    test.assert(find_issue(
      after_native_removed.issues, fixture:path("host_label.titan")) == nil,
      "selected default file retained an inactive-variant issue")
  end)
end

function test_project_discovery_selects_host_variants_and_composes_folders(
    _context: test.Context)
  test_runtime.run(selects_host_variants_and_composes_folders)
end

local function enforces_variant_precedence_privacy_and_reserved_labels()
  with_fixture(function (fixture: Fixture)
    local host = bridge.host_target()
    fixture:mkdir("first")
    fixture:mkdir("first/bar")
    fixture:mkdir("first/baz")
    fixture:mkdir("first/uv_only")
    fixture:mkdir("first/uv_only/nested")
    fixture:mkdir("first/bad_folder")
    fixture:mkdir("second")
    fixture:mkdir("second/uv_only")

    -- Earlier root's foo.titan beats later root's foo.<host>.titan.
    fixture:write("first/foo.titan")
    fixture:write("second/foo." .. host .. ".titan")
    fixture:write("second/foo.browser.titan")

    -- Earlier root's inactive variant does not shadow later root's active file.
    fixture:write("first/later_wins.browser.titan")
    fixture:write("second/later_wins.titan")

    -- Selected folder main bar/bar.titan beats sibling bar.<host>.titan.
    fixture:write("first/bar/bar.titan")
    fixture:write("first/bar." .. host .. ".titan")

    -- baz/baz.browser.titan is absent on native hosts, so sibling baz.titan wins.
    fixture:write("first/baz/baz.browser.titan")
    fixture:write("first/baz.titan")

    -- Contributor privacy under a folder with no active main on native hosts.
    fixture:write("first/uv_only/uv_only.browser.titan")
    fixture:write("first/uv_only/tcp.titan")
    fixture:write("first/uv_only/nested/nested." .. host .. ".titan")
    fixture:write("second/uv_only/tcp.titan")

    -- Stacked and mis-cased labels are diagnosed at root and inside folders.
    fixture:write("first/stacked.linux.native.titan")
    fixture:write("first/miscased.Linux.titan")
    fixture:write("first/bad_folder/bad_folder.titan")
    fixture:write("first/bad_folder/part.Linux.titan")

    local found?, failure? = discovery.discover(
      {fixture:path("first"), fixture:path("second")}, {},
      {fixture:path("first"), fixture:path("second")})
    test.assert(failure == nil and found ~= nil,
                "precedence and privacy fixture failed discovery")

    local foo? = found:find_module("foo")
    test.assert(foo ~= nil and foo.main_file == fixture:path("first/foo.titan"),
                "later root variant overrode earlier root default")
    local shadowed_foo? = find_issue(
      found.issues, fixture:path("second/foo." .. host .. ".titan"))
    test.assert(shadowed_foo ~= nil and
                strings.find(shadowed_foo.message, "shadowed") ~= nil,
                "shadowed later-root variant main was not reported")
    assert_inactive_issue(
      found.issues, fixture:path("second/foo.browser.titan"),
      host, "foo.titan", "foo." .. host .. ".titan")

    local later_wins? = found:find_module("later_wins")
    test.assert(later_wins ~= nil and
                later_wins.main_file == fixture:path("second/later_wins.titan"),
                "inactive earlier-root variant shadowed later-root module")

    local bar? = found:find_module("bar")
    test.assert(bar ~= nil and bar:is_folder() and
                bar.main_file == fixture:path("first/bar/bar.titan"),
                "sibling flat variant overrode folder main")
    assert_inactive_issue(
      found.issues, fixture:path("first/bar." .. host .. ".titan"),
      host, "bar.titan", "bar.titan")

    local baz? = found:find_module("baz")
    test.assert(baz ~= nil and not baz:is_folder() and
                baz.main_file == fixture:path("first/baz.titan"),
                "inactive folder main blocked sibling flat fallback")
    assert_inactive_issue(
      found.issues, fixture:path("first/baz/baz.browser.titan"),
      host, "baz.titan", nil)

    test.assert(found:find_module("uv_only") == nil and
                found:find_module("uv_only.tcp") == nil,
                "contributor under inactive folder main became an importable flat module")
    assert_inactive_issue(
      found.issues, fixture:path("first/uv_only/uv_only.browser.titan"),
      host, "uv_only.titan", nil)
    assert_inactive_issue(
      found.issues, fixture:path("first/uv_only/tcp.titan"),
      host, "uv_only.titan", nil)
    local blocked_tcp? = find_issue(
      found.issues, fixture:path("second/uv_only/tcp.titan"))
    test.assert(blocked_tcp ~= nil and
                strings.find(blocked_tcp.message, "blocked by folder source") ~= nil,
                "later-root flat constituent was not blocked by earlier inactive folder main")
    local nested? = found:find_module("uv_only.nested")
    test.assert(nested ~= nil and nested:is_folder() and
                nested.main_file ==
                  fixture:path("first/uv_only/nested/nested." .. host .. ".titan"),
                "genuinely nested folder module under inactive parent was lost")

    local stacked? = find_issue(
      found.issues, fixture:path("first/stacked.linux.native.titan"))
    local miscased? = find_issue(
      found.issues, fixture:path("first/miscased.Linux.titan"))
    local folder_miscased? = find_issue(
      found.issues, fixture:path("first/bad_folder/part.Linux.titan"))
    test.assert(stacked ~= nil and
                strings.find(stacked.message, "stacked target labels") ~= nil and
                miscased ~= nil and
                strings.find(miscased.message, "mis-cased target label") ~= nil and
                folder_miscased ~= nil and
                strings.find(folder_miscased.message, "mis-cased target label") ~= nil,
                "stacked or mis-cased target labels were not diagnosed")


    -- Differential check against the installed compiler's driver.resolve_source
    -- on the exact same two-root fixture layout.
    local check_compiler_parity = lua.load([==[
return function(paths, modname)
  local driver = require("titan-compiler.driver")
  local context = driver.new_resolver_context()
  local source, err = driver.resolve_source(context, modname, paths)
  driver.close_resolver_context(context)
  if err then return "error", "", {} end
  if not source then return "absent", "", {} end
  return source.kind, source.main or "", source.files or {}
end
]==], "=project_discovery_compiler_parity", nil)() as
      function (string, string): (string, string, {integer: value})
    local search_paths = fixture:path("first") .. ";" .. fixture:path("second")
    local check_names = {
      "foo", "later_wins", "bar", "baz", "uv_only", "uv_only.tcp",
      "uv_only.nested", "bad_folder",
    }
    for name_index = 1, #check_names do
      local check_name = check_names[name_index]
      local compiler_kind, compiler_main, compiler_files =
        check_compiler_parity(search_paths, check_name)
      local discovered? = found:find_module(check_name)
      if compiler_kind == "flat" or compiler_kind == "folder" then
        test.assert(discovered ~= nil and
          discovered:is_folder() == (compiler_kind == "folder") and
          discovered.main_file == compiler_main and
          #discovered.files == #compiler_files,
          "server discovery diverged from driver.resolve_source for " .. check_name)
        for file_index = 1, #discovered.files do
          test.assert(discovered.files[file_index] ==
            (compiler_files[file_index] as string),
            "server discovery file order diverged from compiler for " .. check_name)
        end
      else
        test.assert(discovered == nil,
          "server discovery accepted module rejected/absent in compiler: " ..
          check_name .. " (" .. compiler_kind .. ")")
      end
    end
    with_target_override("browser", function ()
      local browser?, browser_error? = discovery.discover(
        {fixture:path("first")}, {}, {fixture:path("first")})
      test.assert(browser_error == nil and browser ~= nil,
                  "browser target discovery failed")
      local browser_baz? = browser:find_module("baz")
      test.assert(browser_baz ~= nil and browser_baz:is_folder() and
                  browser_baz.main_file ==
                    fixture:path("first/baz/baz.browser.titan"),
                  "baz did not switch to a folder module on browser")
      local browser_uv? = browser:find_module("uv_only")
      test.assert(browser_uv ~= nil and browser_uv:is_folder() and
                  #browser_uv.files == 2 and
                  browser_uv.files[1] ==
                    fixture:path("first/uv_only/uv_only.browser.titan") and
                  browser_uv.files[2] ==
                    fixture:path("first/uv_only/tcp.titan"),
                  "uv_only folder did not activate with its contributor on browser")
    end)
  end)
end

function test_project_discovery_enforces_variant_precedence_privacy_and_reserved_labels(
    _context: test.Context)
  test_runtime.run(enforces_variant_precedence_privacy_and_reserved_labels)
end
