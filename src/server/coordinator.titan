local async = import "async"
local dispatcher = import "server.dispatcher"
local logging = import "server.logging"
local response_queue = import "server.response_queue"
local lsp = import "server.lsp_types"

type SemanticHandler = function (dispatcher.SemanticRequest):
  dispatcher.SemanticOutcome
type InitializedHandler = function (): ()
type ShutdownHandler = function (): ()
type CompletionWork = function (): dispatcher.SemanticOutcome
type CompletionCapture = function (dispatcher.CompletionRequest): CompletionWork
type DocumentHandler = function (lsp.DocumentNotification): ()

local type RemoveListener = function (): ()

local record ActiveRequest
  id: dispatcher.RequestId
  method: string
  task: async.Task<|dispatcher.SemanticOutcome, value|>
  remove_listener: RemoveListener?
  responded: boolean
  started: float
end

record Coordinator
  local router: dispatcher.Dispatcher
  local output: response_queue.ResponseQueue
  local handler: SemanticHandler
  local initialized_handler: InitializedHandler?
  local shutdown_handler: ShutdownHandler?
  local active: {ActiveRequest}
  local document_handler: DocumentHandler?
  local completion_capture: CompletionCapture?
end

local REQUEST_CANCELLED = -32800
local INTERNAL_ERROR = -32603
local INVALID_REQUEST = -32600
local METHOD_NOT_FOUND = -32601

local function method_not_found(
    _request: dispatcher.SemanticRequest): dispatcher.SemanticOutcome
  return dispatcher.SemanticOutcome.failure(
    dispatcher.SemanticError.new(METHOD_NOT_FOUND, "Method not found"))
end

function create(output: response_queue.ResponseQueue,
                handler: SemanticHandler?,
                initialized_handler: InitializedHandler?,
                shutdown_handler: ShutdownHandler?): Coordinator
  local actual = method_not_found
  if handler ~= nil then actual = handler end
  return Coordinator.new(
    dispatcher.create(), output, actual, initialized_handler,
    shutdown_handler, {}, nil, nil)
end

function Coordinator:configure_completion(
    document_handler: DocumentHandler, capture: CompletionCapture)
  self.document_handler = document_handler
  self.completion_capture = capture
  self.router:enable_completion()
end

function Coordinator:phase_name(): string
  return self.router:phase_name()
end

function Coordinator:active_count(): integer
  return #self.active
end

local function Coordinator:find(id: dispatcher.RequestId): ActiveRequest?
  for index = 1, #self.active do
    local candidate = self.active[index]
    if candidate.id:equals(id) then return candidate end
  end
  return nil
end

local function Coordinator:remove(target: ActiveRequest)
  local count = #self.active
  for index = 1, count do
    if self.active[index] == target then
      for following = index, count - 1 do
        self.active[following] = self.active[following + 1]
      end
      self.active[count] = nil
      return
    end
  end
end

local function Coordinator:publish(result: dispatcher.DispatchResult)
  if result.response ~= nil then self.output:push(result.response) end
end

local function Coordinator:complete(
    active: ActiveRequest,
    status: async.TaskStatus<|dispatcher.SemanticOutcome, value|>)
  if active.responded then return end
  active.responded = true

  local remove? = active.remove_listener
  active.remove_listener = nil
  if remove ~= nil then remove() end
  self:remove(active)

  local status_name = "unknown"

  case status
  when succeeded(outcome) then
    status_name = "succeeded"
    case outcome
    when result(result) then
      self:publish(dispatcher.result_response(active.id, result))
    when failure(failure) then
      self:publish(dispatcher.failure_response(
        active.id, failure.code, failure.message))
    end
  when failed() then
    status_name = "failed"
    self:publish(dispatcher.failure_response(
      active.id, INTERNAL_ERROR, "Internal error"))
  when cancelled() then
    status_name = "cancelled"
    self:publish(dispatcher.failure_response(
      active.id, REQUEST_CANCELLED, "Request cancelled"))
  else
    self:publish(dispatcher.failure_response(
      active.id, INTERNAL_ERROR, "Internal error"))
  end
  logging.emit("debug", "request.complete", {
    ["id"] = active.id:to_json(),
    ["method"] = active.method,
    ["status"] = status_name,
    ["cpu_ms"] = logging.elapsed_ms(active.started),
    ["active_requests"] = #self.active,
  })
end

local function Coordinator:start(id: dispatcher.RequestId,
                                  method: string, work: CompletionWork)
  if self:find(id) ~= nil then
    self:publish(dispatcher.failure_response(
      id, INVALID_REQUEST, "Duplicate active request id"))
    return
  end

  local task = async.run<|dispatcher.SemanticOutcome, value|>(
    function (): dispatcher.SemanticOutcome
      return work()
    end)
  local active = ActiveRequest.new(
    id, method, task, nil, false, logging.clock())
  self.active[#self.active + 1] = active
  logging.emit("debug", "request.start", {
    ["id"] = id:to_json(),
    ["method"] = method,
    ["active_requests"] = #self.active,
  })
  active.remove_listener = task:add_terminal_listener(
    function (status: async.TaskStatus<|dispatcher.SemanticOutcome, value|>)
      self:complete(active, status)
    end)
end

local function Coordinator:cancel(id: dispatcher.RequestId)
  local active? = self:find(id)
  if active == nil then return end
  local task = active.task
  logging.emit("debug", "request.cancel", {
    ["id"] = id:to_json(),
    ["method"] = active.method,
  })
  if not task:status():has_finished() then
    task:cancel(async.CancellationReason.simple("LSP request cancelled"))
  end
  -- Cancellation is a request, not completion. Joining retires the handler's
  -- borrowed state before this ownership operation returns.
  async.join(task)
end

local function Coordinator:start_completion(request: dispatcher.CompletionRequest)
  if self:find(request.id) ~= nil then
    self:publish(dispatcher.failure_response(
      request.id, INVALID_REQUEST, "Duplicate active request id"))
    return
  end
  local capture? = self.completion_capture
  if capture == nil then
    self:publish(dispatcher.failure_response(
      request.id, METHOD_NOT_FOUND, "Method not found"))
    return
  end
  -- Capture before scheduling: later notifications can change a buffer before
  -- async.run enters its Task. The closure owns this request's exact input.
  local work?: CompletionWork
  do
    work = capture(request)
  catch
    self:publish(dispatcher.failure_response(
      request.id, INTERNAL_ERROR, "Internal error"))
    return
  end
  self:start(request.id, "textDocument/completion", work)
end

function Coordinator:cancel_all(reason: string)
  local snapshot: {ActiveRequest} = {}
  for index = 1, #self.active do
    snapshot[index] = self.active[index]
  end

  for index = 1, #snapshot do
    local task = snapshot[index].task
    if not task:status():has_finished() then
      task:cancel(async.CancellationReason.simple(reason))
    end
  end
  if #snapshot > 0 then
    logging.emit("debug", "request.cancel_all", {
      ["count"] = #snapshot,
      ["reason"] = reason,
    })
  end
  for index = 1, #snapshot do
    async.join(snapshot[index].task)
  end
end

-- Handle one already-framed JSON body. A nonnil result is the process exit
-- code requested by the LSP exit notification.
function Coordinator:handle(source: string): integer?
  local phase_before = self.router:phase_name()
  case self.router:route(source)
  when immediate(result) then
    self:publish(result)
    local phase_after = self.router:phase_name()
    if phase_after ~= phase_before then
      logging.emit("info", "lifecycle.transition", {
        ["from"] = phase_before,
        ["to"] = phase_after,
      })
    end
    return result.exit_code
  when initialized() then
    local handler? = self.initialized_handler
    if handler ~= nil then handler() end
    logging.emit("info", "lifecycle.initialized", nil)
    return nil
  when semantic(request) then
    self:start(request.id, request.method,
      function (): dispatcher.SemanticOutcome
        return self.handler(request)
      end)
    return nil
  when completion(request) then
    self:start_completion(request)
    return nil
  when document(notification) then
    local handler? = self.document_handler
    if handler ~= nil then handler(notification) end
    return nil
  when cancel(id) then
    self:cancel(id)
    return nil
  when shutdown(result) then
    self:cancel_all("language server shutdown")
    local handler? = self.shutdown_handler
    if handler ~= nil then handler() end
    self:publish(result)
    logging.emit("info", "lifecycle.shutdown", nil)
    return nil
  when exit(code) then
    logging.emit("info", "lifecycle.exit", {
      ["code"] = code,
    })
    return code
  end
  return nil
end
