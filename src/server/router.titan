--- One client session serving several independent Titan roots through workers.
-- @module server.router

foreign import "compiler_io_platform.h"

local async = import "async"
local dispatcher = import "server.dispatcher"
local fs = import "fs"
local iteration = import "iteration"
local json = import "json"
local logging = import "server.logging"
local lsp = import "server.lsp_types"
local math = import "math"
local io = import "io"
local os = import "os"
local paths = import "path"
local protocol = import "server.protocol"
local response_queue = import "server.response_queue"
local root_settings = import "server.root_settings"
local roots = import "server.roots"
local source_text = import "server.source_text"
local strings = import "string"
local timer = import "timer"
local wire = import "server.wire"
local worker_process = import "server.worker_process"

local DEFAULT_MAX_WORKERS = 4
local DEFAULT_IDLE_TIMEOUT_SECONDS = 600.0
local CRASH_WINDOW_MILLISECONDS = 60000
local CRASH_LIMIT = 3
local ACTIVATION_TIMEOUT_MILLISECONDS = 60000
local SHUTDOWN_TIMEOUT_MILLISECONDS = 15000
local REVALIDATE_INTERVAL_MILLISECONDS = 1000
local DRAIN_TIMEOUT_MILLISECONDS = 5000
local DRAIN_POLL_MILLISECONDS = 20
local HOUSEKEEPING_INTERVAL_MILLISECONDS = 500
local MAX_WORKERS_ENVIRONMENT_VARIABLE = "TITAN_LS_MAX_WORKERS"
local TRUSTED_ROOTS_ENVIRONMENT_VARIABLE = "TITAN_LS_TRUSTED_ROOTS"
local WORKER_INFO_METHOD = "titan/workerInfo"
local REQUEST_FAILED = -32803
local PARSE_ERROR = -32700
local INVALID_REQUEST = -32600
local METHOD_NOT_FOUND = -32601

--- Worker lifecycle state reported by titan/workspaceStatus.
union WorkerState
  inactive()
  starting()
  ready()
  failed(string)
  evicted()
end

--- Return the protocol spelling of one worker state.
function state_name(state: WorkerState): string
  case state
  when inactive() then return "inactive"
  when starting() then return "starting"
  when ready() then return "ready"
  when failed() then return "failed"
  when evicted() then return "evicted"
  end
  return "inactive"
end

local function state_ready(state: WorkerState): boolean
  case state
  when ready() then return true
  else return false
  end
  return false
end

local function state_failure(state: WorkerState): string?
  case state
  when failed(message) then return message
  else return nil
  end
  return nil
end

--- One open editor buffer replayed into a (re)started worker.
record Overlay
  const uri: string
  const path: string
  local version: integer
  local text: string
end

--- One forwarded client request awaiting its worker's response.
record Forwarded
  const root: string
  const id: value
end

--- One client request a worker asked this session to originate.
record Outbound
  const root: string
  const id: value
end

--- Per-root worker ownership, settings identity, and lifecycle state.
record Slot
  const root: roots.Root
  local worker: worker_process.WorkerProcess?
  local state: WorkerState
  local stopping: boolean
  local failure: string?
  local generation: integer
  local last_used: integer
  local settings: root_settings.Settings?
  local settings_fingerprint: string
  local sdk_identity: string
  local checked: integer
  local crashes: {integer}
  local worker_pid: integer?
  -- The worker's own report of the SDK and probe prefix it resolved.
  local titan_root: string?
  local probe_prefix: string?
  -- The worker reported background indexing; it is not idle then.
  local indexing: boolean
  local diagnosed_file: string?
  local transitioning: boolean
  local waiter: async.Task?
  local token: async.ResumeToken
end

--- Launch inputs fixed before the client's initialize request arrives.
record LaunchOptions
  const executable: string
  const root: string
  const probe_prefix: string?
  const titan_root: string?
end

--- Router session state: roots, workers, overlays, and request ownership.
record Router
  const options: LaunchOptions
  const output: response_queue.ResponseQueue
  local registry: roots.Roots
  local trust: root_settings.Trust
  local slots: {string: Slot}
  local order: {string}
  local overlays: {string: Overlay}
  local overlay_order: {string}
  local forwarded: {string: Forwarded}
  local outbound: {string: Outbound}
  local retired: {worker_process.WorkerProcess}
  local envelope: dispatcher.Dispatcher
  local initial_roots: {string}
  local client_capabilities: value
  local client_initialization_options: value
  local max_workers: integer
  local idle_timeout_seconds: float
  local next_outbound: integer
  local initial_activated: boolean
  local housekeeping: async.Task<|nil, value|>?
  local unowned_logged: {string: boolean}
  local closed: boolean
end

type Finish = function (): ()

local function now_milliseconds(): integer
  return logging.wall_clock() * 1000
end

-- A configured duration arrives as a JSON number: an integer second count or a
-- fraction. Anything else keeps the default.
local function seconds_value(item: value): float?
  local whole? = wire.as_integer(item)
  if whole ~= nil then
    local seconds: integer = whole
    return seconds as float
  end
  do
    local fraction: float = item
    return fraction
  catch
    if error is async.CancellationReason then raise end
  end
  return nil
end

local function leaf_name(subject: string): string
  local name = paths.basename(subject)
  if name == "" then return subject end
  return name
end

local function router_publish(router: Router, message: string)
  router.output:push(message)
end

local function overlay_belongs(slot: Slot, overlay: Overlay): boolean
  return roots.contains(slot.root.path, overlay.path)
end

local function Slot:wake()
  local waiter? = self.waiter
  self.waiter = nil
  if waiter ~= nil then waiter:resume(self.token) end
end

local function Slot:wait_settled()
  while self.transitioning do
    if self.waiter ~= nil then
      raise "router slot already has a waiting caller"
    end
    local current = async.running()
    self.waiter = current
    local detach = function ()
      if self.waiter == current then self.waiter = nil end
    end
    defer detach()
    async.suspend(self.token, detach)
  end
end

--- Create a router session over one client stream pair.
function create(options: LaunchOptions, output: response_queue.ResponseQueue): Router
  local max_workers = DEFAULT_MAX_WORKERS
  local configured? = os.getenv(MAX_WORKERS_ENVIRONMENT_VARIABLE)
  if configured ~= nil and configured ~= "" then
    do
      local parsed? = math.tointeger(configured as string)
      if parsed ~= nil and (parsed as integer) > 0 then
        max_workers = parsed as integer
      end
    catch
      if error is async.CancellationReason then raise end
    end
  end
  local envelope = dispatcher.create(true)
  -- The router always serves completion, exactly as the single-root server did,
  -- so the advertised capabilities must include it.
  envelope:enable_completion()
  return Router.new(
    options, output, roots.create(), root_settings.create({}),
    {}, {}, {}, {}, {}, {}, {}, envelope, {},
    nil, nil, max_workers, DEFAULT_IDLE_TIMEOUT_SECONDS, 1,
    false, nil, {}, false)
end

local function slot_for_root(router: Router, entry: roots.Root): Slot
  local existing? = router.slots[entry.path]
  if existing ~= nil then return existing as Slot end
  local slot = Slot.new {
    root = entry,
    worker = nil,
    state = WorkerState.inactive(),
    stopping = false,
    failure = nil,
    generation = 0,
    last_used = now_milliseconds(),
    settings = nil,
    settings_fingerprint = "",
    sdk_identity = "",
    checked = 0,
    crashes = {},
    worker_pid = nil,
    titan_root = nil,
    probe_prefix = nil,
    indexing = false,
    diagnosed_file = nil,
    transitioning = false,
    waiter = nil,
    token = async.ResumeToken.new("server.router.slot"),
  }
  router.slots[entry.path] = slot
  router.order[#router.order + 1] = entry.path
  return slot
end

local function status_value(router: Router): value
  local result: wire.Array = {}
  for index = 1, #router.order do
    local slot = router.slots[router.order[index]] as Slot
    local entry: wire.Object = {
      ["root"] = slot.root.path,
      ["state"] = state_name(slot.state),
      ["generation"] = slot.generation,
    }
    case slot.root:origin()
    when folder() then entry["origin"] = "folder"
    when discovered() then entry["origin"] = "discovered"
    end
    local settings? = slot.settings
    if settings ~= nil then
      local actual = settings as root_settings.Settings
      entry["trusted"] = actual.trusted
      if actual.compiler_root ~= nil then
        entry["compilerRoot"] = actual.compiler_root
      else
        entry["compilerRoot"] = wire.null()
      end
    else
      entry["trusted"] = false
      entry["compilerRoot"] = wire.null()
    end
    local failure? = slot.failure
    if failure ~= nil then entry["failure"] = failure as string end
    local pid? = slot.worker_pid
    if pid ~= nil then
      entry["workerPid"] = pid as integer
    else
      entry["workerPid"] = wire.null()
    end
    local titan_root? = slot.titan_root
    if titan_root ~= nil then
      entry["titanRoot"] = titan_root as string
    else
      entry["titanRoot"] = wire.null()
    end
    local probe? = slot.probe_prefix
    if probe ~= nil then
      entry["probePrefix"] = probe as string
    else
      entry["probePrefix"] = wire.null()
    end
    result[index] = entry
  end
  return {["roots"] = result}
end

-- Worker messages ------------------------------------------------------------------

local function fail_forwarded(router: Router, root: string, message: string)
  local expired: {Forwarded} = {}
  for key, entry in iteration.pairs(router.forwarded) do
    if entry.root == root then
      expired[#expired + 1] = entry
      router.forwarded[key] = nil
    end
  end
  for index = 1, #expired do
    local entry = expired[index]
    router_publish(router, dispatcher.failure_body(
      entry.id, REQUEST_FAILED, message))
  end
end

local function in_flight_for(router: Router, root: string): integer
  local count = 0
  for _key, entry in iteration.pairs(router.forwarded) do
    if entry.root == root then count = count + 1 end
  end
  return count
end

local function record_crash(slot: Slot)
  local now = now_milliseconds()
  local kept: {integer} = {}
  for index = 1, #slot.crashes do
    local stamp = slot.crashes[index]
    if now - stamp <= CRASH_WINDOW_MILLISECONDS then kept[#kept + 1] = stamp end
  end
  kept[#kept + 1] = now
  slot.crashes = kept
end

-- The design requires a restart to let pending requests finish before the
-- worker shuts down: the worker's own shutdown handler cancels active work, so
-- the router drains forwarded requests first, bounded, and only then stops it.
local function drain_requests(router: Router, root: string)
  local deadline = now_milliseconds() + DRAIN_TIMEOUT_MILLISECONDS
  while in_flight_for(router, root) > 0 and
        now_milliseconds() < deadline do
    timer.sleep(DRAIN_POLL_MILLISECONDS)
  end
end

-- Stop one slot's worker after its in-flight requests finish. The caller owns
-- the slot transition, so a restart can stop and start inside one transition.
local function stop_worker_locked(router: Router, slot: Slot, reason: string)
  drain_requests(router, slot.root.path)
  local worker? = slot.worker
  slot.worker = nil
  slot.worker_pid = nil
  slot.titan_root = nil
  slot.probe_prefix = nil
  slot.indexing = false
  if worker ~= nil then
    slot.stopping = true
    local actual_worker = worker as worker_process.WorkerProcess
    actual_worker:stop(SHUTDOWN_TIMEOUT_MILLISECONDS)
    slot.stopping = false
    router.retired[#router.retired + 1] = worker as worker_process.WorkerProcess
  end
  fail_forwarded(router, slot.root.path,
    "Titan worker for " .. slot.root.path .. " stopped: " .. reason)
  slot.state = WorkerState.evicted()
  logging.emit("info", "root.stop", {
    ["root"] = slot.root.path,
    ["reason"] = reason,
  })
end

--- Stop one slot's worker process, settling its waiters.
local function stop_slot(router: Router, slot: Slot, reason: string)
  slot.transitioning = true
  stop_worker_locked(router, slot, reason)
  slot.transitioning = false
  slot:wake()
end

local function worker_listener(router: Router, slot: Slot): worker_process.Listener
  local owner = slot
  return worker_process.Listener.new(
    function (method: string, params: value, body: string)
      if method == WORKER_INFO_METHOD then
        local object? = wire.as_object(params)
        if object ~= nil then
          local info = object as wire.Object
          local pid? = wire.as_integer(info["pid"])
          if pid ~= nil then owner.worker_pid = pid as integer end
          local titan_root? = wire.as_string(info["titanRoot"])
          if titan_root ~= nil and titan_root ~= "" then
            owner.titan_root = titan_root as string
          end
          local probe? = wire.as_string(info["probePrefix"])
          if probe ~= nil and probe ~= "" then
            owner.probe_prefix = probe as string
          end
        end
        return
      end
      if method == "titan/indexingStatus" then
        -- The publication itself is forwarded unchanged: it carries no root
        -- identity, so only this slot's idleness may observe it.
        local object? = wire.as_object(params)
        if object ~= nil then
          local state? = wire.as_string((object as wire.Object)["state"])
          if state ~= nil then
            local name: string = state
            owner.indexing = name == "indexing"
          end
        end
      end
      if method == "textDocument/publishDiagnostics" then
        local object? = wire.as_object(params)
        if object ~= nil then
          local uri? = wire.as_string((object as wire.Object)["uri"])
          if uri ~= nil then
            local path?, failure? = source_text.file_uri_to_path(uri as string)
            if path ~= nil then
              local canonical = roots.canonical(path as string)
              local current? = router.registry:owner(canonical)
              if current == nil or current.path ~= owner.root.path then
                logging.emit("debug", "diagnostics.dropped", {
                  ["root"] = owner.root.path,
                  ["uri"] = uri,
                })
                return
              end
            end
          end
        end
      end
      router.output:push(body)
    end,
    function (id: value, method: string, params: value, body: string)
      router.next_outbound = router.next_outbound + 1
      local generated = "titan-ls:" .. strings.tostring(router.next_outbound)
      router.outbound[worker_process.id_key(generated as value)] =
        Outbound.new(owner.root.path, id)
      local envelope: wire.Object = {
        ["jsonrpc"] = "2.0",
        ["id"] = generated,
        ["method"] = method,
      }
      if params ~= nil then envelope["params"] = params end
      router.output:push(wire.encode(envelope))
    end,
    function (body: string)
      do
        local parsed = wire.decode(body)
        local object? = wire.as_object(parsed)
        if object ~= nil then
          local raw_id = (object as wire.Object)["id"]
          if raw_id ~= nil then
            router.forwarded[worker_process.id_key(raw_id)] = nil
          end
        end
      catch
        if error is async.CancellationReason then raise end
      end
      router.output:push(body)
    end,
    function (message: string)
      if owner.stopping or owner.worker == nil then return end
      owner.worker = nil
      owner.worker_pid = nil
      owner.titan_root = nil
      owner.probe_prefix = nil
      owner.indexing = false
      record_crash(owner)
      owner.state = WorkerState.failed(message)
      owner.failure = message
      fail_forwarded(router, owner.root.path, message)
      logging.emit("error", "root.worker.exited", {
        ["root"] = owner.root.path,
        ["message"] = message,
        ["crashes"] = #owner.crashes,
      })
    end)
end

-- Activation ----------------------------------------------------------------------

local function worker_initialize_params(router: Router, root_path: string): wire.Object
  local uri: value = wire.null()
  do
    uri = source_text.path_to_file_uri(root_path)
  catch
    if error is async.CancellationReason then raise end
    uri = wire.null()
  end
  local folder: wire.Object = {
    ["uri"] = uri, ["name"] = leaf_name(root_path),
  }
  local folders: wire.Array = {}
  folders[1] = folder
  local params: wire.Object = {
    ["processId"] = wire.null(),
    ["capabilities"] = router.client_capabilities,
    ["rootPath"] = root_path,
    ["rootUri"] = uri,
    ["workspaceFolders"] = folders,
  }
  if router.client_initialization_options ~= nil then
    params["initializationOptions"] = router.client_initialization_options
  end
  return params
end

local function replay_overlays(router: Router, slot: Slot,
                               worker: worker_process.WorkerProcess)
  for index = 1, #router.overlay_order do
    local overlay = router.overlays[router.overlay_order[index]] as Overlay
    if overlay_belongs(slot, overlay) then
      local document: wire.Object = {
        ["uri"] = overlay.uri,
        ["languageId"] = "titan",
        ["version"] = overlay.version,
        ["text"] = overlay.text,
      }
      local params: wire.Object = {["textDocument"] = document}
      local envelope: wire.Object = {
        ["jsonrpc"] = "2.0",
        ["method"] = "textDocument/didOpen",
        ["params"] = params,
      }
      worker:send(wire.encode(envelope))
    end
  end
end

-- A trust refusal is a diagnostic on the configuration file that selected the
-- SDK: an editor must show why that root has no worker, and the notification
-- is replaced by an empty publication once the selection is accepted.
local function configuration_diagnostic_line(filename: string): integer
  local source = fs.read_file(filename)
  local offset? = strings.find(source, "compiler_root")
  if offset == nil then return 0 end
  local line = 0
  for index = 1, (offset as integer) - 1 do
    if strings.byte(source, index) == 10 then line = line + 1 end
  end
  return line
catch
  if error is async.CancellationReason then raise end
  return 0
end

local function publish_configuration_diagnostic(router: Router, slot: Slot,
                                                filename: string,
                                                message: string)
  local uri: value = wire.null()
  do
    uri = source_text.path_to_file_uri(roots.canonical(filename))
  catch
    if error is async.CancellationReason then raise end
  end
  local position: wire.Object = {
    ["line"] = configuration_diagnostic_line(filename), ["character"] = 0,
  }
  local range: wire.Object = {["start"] = position, ["end"] = position}
  local diagnostic: wire.Object = {
    ["range"] = range,
    ["severity"] = 1,
    ["source"] = "Titan",
    ["code"] = "configuration",
    ["message"] = message,
  }
  local diagnostics: wire.Array = {}
  diagnostics[1] = diagnostic
  local params: wire.Object = {
    ["uri"] = uri, ["diagnostics"] = diagnostics,
  }
  local envelope: wire.Object = {
    ["jsonrpc"] = "2.0",
    ["method"] = "textDocument/publishDiagnostics",
    ["params"] = params,
  }
  router.output:push(wire.encode(envelope))
  slot.diagnosed_file = filename
end

local function clear_configuration_diagnostic(router: Router, slot: Slot)
  local filename? = slot.diagnosed_file
  if filename == nil then return end
  slot.diagnosed_file = nil
  local uri: value = wire.null()
  do
    uri = source_text.path_to_file_uri(roots.canonical(filename as string))
  catch
    if error is async.CancellationReason then raise end
  end
  local diagnostics: wire.Array = {}
  local params: wire.Object = {["uri"] = uri, ["diagnostics"] = diagnostics}
  local envelope: wire.Object = {
    ["jsonrpc"] = "2.0",
    ["method"] = "textDocument/publishDiagnostics",
    ["params"] = params,
  }
  router.output:push(wire.encode(envelope))
end

local function fail_slot(slot: Slot, message: string)
  slot.state = WorkerState.failed(message)
  slot.failure = message
  logging.emit("error", "root.failed", {
    ["root"] = slot.root.path,
    ["message"] = message,
  })
end

local function start_worker(router: Router, slot: Slot,
                            settings: root_settings.Settings): boolean
  local arguments: {string} = {"--worker", "--root", slot.root.path}
  local compiler_root? = settings.compiler_root
  if compiler_root ~= nil then
    arguments[#arguments + 1] = "--compiler-root"
    arguments[#arguments + 1] = compiler_root as string
  end
  local probe = root_settings.probe_prefix(
    router.options.probe_prefix, slot.root.path)
  local worker = worker_process.spawn(
    router.options.executable, arguments, slot.root.path, probe,
    worker_listener(router, slot))
  slot.worker = worker
  slot.worker_pid = nil
  slot.last_used = now_milliseconds()
  slot.stopping = false
  slot.state = WorkerState.starting()
  slot.generation = slot.generation + 1
  local outcome = worker:request(
    "initialize", worker_initialize_params(router, slot.root.path),
    ACTIVATION_TIMEOUT_MILLISECONDS)
  case outcome
  when answered(_value) then
    -- InitializedParams is an empty object, not an empty array: an untyped
    -- empty table literal encodes as "[]" and the worker would reject it.
    local initialized_params: wire.Object = {}
    worker:notify("initialized", initialized_params)
    slot.state = WorkerState.ready()
    slot.failure = nil
    replay_overlays(router, slot, worker)
    logging.emit("info", "root.start", {
      ["root"] = slot.root.path,
      ["generation"] = slot.generation,
      ["probe_cache_prefix"] = probe,
      ["compiler_root"] = compiler_root,
    })
    return true
  when failed(error_value) then
    slot.worker = nil
    worker:stop(SHUTDOWN_TIMEOUT_MILLISECONDS)
    router.retired[#router.retired + 1] = worker
    record_crash(slot)
    fail_slot(slot, "Titan worker for " .. slot.root.path ..
      " rejected initialize: " .. strings.tostring(error_value))
    return false
  when unavailable(message) then
    slot.worker = nil
    worker:kill()
    router.retired[#router.retired + 1] = worker
    record_crash(slot)
    fail_slot(slot, message)
    return false
  end
  return false
end

-- A changed root restarts gracefully: stop routing new requests to it, let its
-- pending ones finish (bounded), stop the worker, then start a fresh one with
-- the accepted settings. Overlays are replayed, so an unsaved buffer survives.
local function restart_slot(router: Router, slot: Slot, reason: string)
  slot.transitioning = true
  stop_worker_locked(router, slot, reason)
  local settings? = slot.settings
  if settings ~= nil then
    start_worker(router, slot, settings as root_settings.Settings)
  else
    slot.state = WorkerState.inactive()
  end
  slot.transitioning = false
  slot:wake()
end

local function slot_idle(router: Router, slot: Slot): boolean
  if slot.worker == nil or not state_ready(slot.state) then return false end
  if slot.indexing then return false end
  if in_flight_for(router, slot.root.path) > 0 then return false end
  for index = 1, #router.overlay_order do
    if overlay_belongs(slot, router.overlays[router.overlay_order[index]]) then
      return false
    end
  end
  return true
end

local function live_workers(router: Router): integer
  local count = 0
  for index = 1, #router.order do
    local slot = router.slots[router.order[index]]
    if slot.worker ~= nil then count = count + 1 end
  end
  return count
end

local function make_room(router: Router): boolean
  if live_workers(router) < router.max_workers then return true end
  local candidate: Slot? = nil
  for index = 1, #router.order do
    local slot = router.slots[router.order[index]]
    if not slot.transitioning and slot_idle(router, slot) then
      if candidate == nil or slot.last_used < candidate.last_used then
        candidate = slot
      end
    end
  end
  if candidate == nil then return false end
  local actual = candidate as Slot
  stop_slot(router, actual, "worker cap")
  return true
end

-- Only a trust refusal gets a configuration diagnostic; every other settings
-- failure is reported by the requests that need the root.
local function selection_refused(reason: root_settings.Reason): boolean
  case reason
  when untrusted_selection() then return true
  else return false
  end
  return false
end

-- A root's settings decide its SDK and trust. Reloading them is bounded to one
-- observation per interval except when the client explicitly asks for a reload.
local function revalidate(router: Router, slot: Slot, force: boolean): boolean
  local now = now_milliseconds()
  if not force and now - slot.checked < REVALIDATE_INTERVAL_MILLISECONDS then
    return false
  end
  slot.checked = now
  local settings?, failure? = root_settings.load(slot.root.path, router.trust)
  if settings == nil then
    local error_value = failure as root_settings.Error
    local message = error_value.message
    slot.settings = nil
    if slot.worker ~= nil then stop_slot(router, slot, "settings error") end
    slot.state = WorkerState.failed(message)
    slot.failure = message
    if selection_refused(error_value.reason) then
      publish_configuration_diagnostic(router, slot, error_value.path, message)
    end
    logging.emit("error", "root.settings.failure", {
      ["root"] = slot.root.path,
      ["message"] = message,
    })
    return true
  end
  local actual = settings as root_settings.Settings
  local fingerprint = root_settings.fingerprint(actual)
  local identity = root_settings.sdk_identity(
    actual.compiler_root, router.options.titan_root)
  local changed = slot.settings == nil or
    fingerprint ~= slot.settings_fingerprint or
    identity ~= slot.sdk_identity
  clear_configuration_diagnostic(router, slot)
  slot.settings = actual
  slot.settings_fingerprint = fingerprint
  slot.sdk_identity = identity
  if force then
    -- An explicit client reload is a deliberate retry: it clears the restart
    -- suppression a crash loop installed.
    slot.crashes = {}
    if state_failure(slot.state) ~= nil then
      slot.failure = nil
      slot.state = WorkerState.inactive()
    end
  end
  if changed then
    slot.crashes = {}
    slot.failure = nil
    if slot.worker ~= nil then
      logging.emit("info", "root.restart", {
        ["root"] = slot.root.path,
        ["reason"] = "settings changed",
      })
      restart_slot(router, slot, "settings changed")
    elseif not state_ready(slot.state) then
      slot.state = WorkerState.inactive()
    end
  end
  return changed
end

--- Ensure a canonical root has a live, initialized worker.
local function activate(router: Router, slot: Slot): (Slot?, string?)
  while true do
    slot:wait_settled()
    -- A root is re-observed at most once per interval on the routing path, so a
    -- reinstalled SDK or a changed override cannot answer a request from a
    -- stale runtime.
    revalidate(router, slot, false)
    if slot.worker ~= nil and state_ready(slot.state) then return slot, nil end
    local failure? = slot.failure
    local settings? = slot.settings
    if settings == nil then
      if failure == nil then failure = "root settings are unavailable" end
      return nil, failure as string
    end
    if failure ~= nil and #slot.crashes >= CRASH_LIMIT then
      return nil, (failure as string) ..
        " (restart suppressed after repeated failures; change the root's " ..
        "settings or reload the session)"
    end
    if not make_room(router) then
      local cap_message = "Titan worker cap (" ..
        strings.tostring(router.max_workers) ..
        ") reached; close another Titan root or raise " ..
        MAX_WORKERS_ENVIRONMENT_VARIABLE
      fail_slot(slot, cap_message)
      return nil, cap_message
    end
    -- Activation itself is a transition: the housekeeping Task must not
    -- revalidate or evict a worker that is still settling its initialize.
    slot.transitioning = true
    local started = start_worker(router, slot, settings as root_settings.Settings)
    slot.transitioning = false
    slot:wake()
    if started then return slot, nil end
    local current? = slot.failure
    if current == nil then current = "cannot start a Titan worker" end
    return nil, current as string
  end
  return nil, "cannot start a Titan worker"
end

local function ensure_slot(router: Router, path: string): (Slot?, string?)
  local owner? = router.registry:owner(path)
  local entry: roots.Root? = owner
  if entry == nil then
    local discovered? = roots.discover(path)
    if discovered == nil then
      return nil, "Titan file '" .. path .. "' is outside every known Titan " ..
        "root and has no titan-config.lua ancestor"
    end
    entry = router.registry:attach_discovery(discovered as string)
    logging.emit("info", "root.discovered", {
      ["root"] = (entry as roots.Root).path,
      ["path"] = path,
    })
  end
  local slot = slot_for_root(router, entry as roots.Root)
  return activate(router, slot)
end

-- Client message routing -----------------------------------------------------------

local function document_path(params: value): string?
  local object? = wire.as_object(params)
  if object == nil then return nil end
  local document? = wire.as_object((object as wire.Object)["textDocument"])
  if document == nil then return nil end
  local uri? = wire.as_string((document as wire.Object)["uri"])
  if uri == nil then return nil end
  local path?, failure? = source_text.file_uri_to_path(uri as string)
  if path == nil then return nil end
  return path
end

local function note_unowned(router: Router, uri: string, action: string)
  if router.unowned_logged[uri] == nil then
    router.unowned_logged[uri] = true
    logging.emit("info", "document.unowned", {
      ["uri"] = uri,
      ["detail"] = action,
    })
  end
end

local function forward_request(router: Router, slot: Slot, id: value,
                               body: string)
  router.forwarded[worker_process.id_key(id)] =
    Forwarded.new(slot.root.path, id)
  slot.last_used = now_milliseconds()
  local worker? = slot.worker
  if worker ~= nil then
    local actual_worker = worker as worker_process.WorkerProcess
    actual_worker:send(body)
  end
end

local function Router:route_request(request: dispatcher.SemanticRequest,
                                    body: string)
  if request.method == "titan/workspaceStatus" then
    router_publish(self, dispatcher.result_body(
      request.id:to_json(), status_value(self)))
    return
  end
  local path? = document_path(request.params)
  if path == nil then
    router_publish(self, dispatcher.failure_body(
      request.id:to_json(), METHOD_NOT_FOUND, "Method not found"))
    return
  end
  local slot?, message? = ensure_slot(self, roots.canonical(path as string))
  if slot == nil then
    router_publish(self, dispatcher.failure_body(
      request.id:to_json(), REQUEST_FAILED, message as string))
    return
  end
  forward_request(self, slot as Slot, request.id:to_json(), body)
end

local function Router:route_completion(request: dispatcher.CompletionRequest,
                                       body: string)
  local slot?, message? = ensure_slot(
    self, roots.canonical(request.params.document.path))
  if slot == nil then
    router_publish(self, dispatcher.failure_body(
      request.id:to_json(), REQUEST_FAILED, message as string))
    return
  end
  forward_request(self, slot as Slot, request.id:to_json(), body)
end

local function notification_identity(notification: lsp.DocumentNotification):
    (string, string)
  case notification
  when opened(item) then return item.document.uri, item.document.path
  when changed(item) then return item.document.uri, item.document.path
  when closed(item) then return item.uri, item.path
  when saved(item) then return item.uri, item.path
  end
  return "", ""
end

local function notification_closes(notification: lsp.DocumentNotification): boolean
  case notification
  when closed() then return true
  else return false
  end
  return false
end

local function Router:set_overlay(notification: lsp.DocumentNotification)
  case notification
  when opened(item) then
    local path = item.document.path
    if self.overlays[path] == nil then
      self.overlay_order[#self.overlay_order + 1] = path
    end
    self.overlays[path] = Overlay.new(
      item.document.uri, path, item.version, item.text)
  when changed(item) then
    local path = item.document.path
    local existing? = self.overlays[path]
    if existing == nil then
      self.overlay_order[#self.overlay_order + 1] = path
      self.overlays[path] = Overlay.new(
        item.document.uri, path, item.version, item.text)
    else
      local overlay = existing as Overlay
      overlay.version = item.version
      overlay.text = item.text
    end
  when closed(item) then
    local path = item.path
    if self.overlays[path] ~= nil then
      self.overlays[path] = nil
      local kept: {string} = {}
      for index = 1, #self.overlay_order do
        local candidate = self.overlay_order[index]
        if candidate ~= path then kept[#kept + 1] = candidate end
      end
      self.overlay_order = kept
    end
  when saved() then
  end
end

local function Router:route_document(notification: lsp.DocumentNotification,
                                     body: string)
  local uri, path = notification_identity(notification)
  if path == "" then return end
  local canonical = roots.canonical(path)
  self:set_overlay(notification)
  local current? = self.registry:owner(canonical)
  if current == nil then
    local discovered? = roots.discover(canonical)
    if discovered == nil then
      note_unowned(self, uri, "notification")
      return
    end
    current = self.registry:attach_discovery(discovered as string)
  end
  local slot = slot_for_root(self, current as roots.Root)
  if notification_closes(notification) and slot.worker == nil then return end
  local actual?, message? = activate(self, slot)
  if actual == nil then
    note_unowned(self, uri, message as string)
    return
  end
  local live = actual as Slot
  live.last_used = now_milliseconds()
  local worker? = live.worker
  if worker ~= nil then
    local actual_worker = worker as worker_process.WorkerProcess
    actual_worker:send(body)
  end
end

local function Router:route_cancel(id: dispatcher.RequestId)
  local value = id:to_json()
  local entry? = self.forwarded[worker_process.id_key(value)]
  if entry == nil then return end
  local forwarded_entry = entry as Forwarded
  local slot? = self.slots[forwarded_entry.root]
  if slot == nil then return end
  local worker? = (slot as Slot).worker
  if worker == nil then return end
  local params: wire.Object = {["id"] = value}
  local actual_worker = worker as worker_process.WorkerProcess
  actual_worker:notify("$/cancelRequest", params)
end

--- Rewrite a client response for a router-allocated id into the worker's reply.
function worker_response_body(original: value, object: wire.Object): string
  local envelope: wire.Object = {
    ["jsonrpc"] = "2.0", ["id"] = original,
  }
  local failure = object["error"]
  if failure ~= nil then
    envelope["error"] = failure
  else
    envelope["result"] = object["result"]
  end
  return wire.encode(envelope)
end

local function Router:on_client_response(object: wire.Object)
  local raw_id = object["id"]
  local key = worker_process.id_key(raw_id)
  local entry? = self.outbound[key]
  if entry == nil then
    logging.emit("debug", "worker.request.unmatched", {["id"] = raw_id})
    return
  end
  self.outbound[key] = nil
  local outbound = entry as Outbound
  local slot? = self.slots[outbound.root]
  if slot == nil then return end
  local worker? = (slot as Slot).worker
  if worker == nil then return end
  local actual_worker = worker as worker_process.WorkerProcess
  actual_worker:send(worker_response_body(outbound.id, object))
end

local function Router:remove_root(canonical: string)
  if not self.registry:remove_folder(canonical) then return end
  local slot? = self.slots[canonical]
  if slot ~= nil then
    stop_slot(self, slot as Slot, "folder removed")
    self.slots[canonical] = nil
    local kept: {string} = {}
    for index = 1, #self.order do
      if self.order[index] ~= canonical then
        kept[#kept + 1] = self.order[index]
      end
    end
    self.order = kept
  end
  logging.emit("info", "root.removed", {["root"] = canonical})
end

local function Router:on_folders(params: value)
  local object? = wire.as_object(params)
  if object == nil then return end
  local event? = wire.as_object((object as wire.Object)["event"])
  if event == nil then return end
  local actual = event as wire.Object
  local removed? = wire.as_array(actual["removed"])
  if removed ~= nil then
    local items = removed as {value}
    for index = 1, #items do
      local folder? = wire.as_object(items[index])
      if folder ~= nil then
        local uri? = wire.as_string((folder as wire.Object)["uri"])
        if uri ~= nil then
          local path?, failure? = source_text.file_uri_to_path(uri as string)
          if path ~= nil then
            self:remove_root(roots.canonical(path as string))
          end
        end
      end
    end
  end
  local added? = wire.as_array(actual["added"])
  if added ~= nil then
    local items = added as {value}
    for index = 1, #items do
      local folder? = wire.as_object(items[index])
      if folder ~= nil then
        local uri? = wire.as_string((folder as wire.Object)["uri"])
        if uri ~= nil then
          local path?, failure? = source_text.file_uri_to_path(uri as string)
          if path == nil then
            logging.emit("info", "root.folder_ignored", {["uri"] = uri})
          else
            local canonical = roots.canonical(path as string)
            slot_for_root(self, self.registry:add_folder(canonical))
            logging.emit("info", "root.added", {["root"] = canonical})
          end
        end
      end
    end
  end
end

-- A snapshot keeps one root's removal during an awaited restart from
-- reindexing the remaining roots out of the live order array.
local function Router:root_paths(): {string}
  local paths: {string} = {}
  for index = 1, #self.order do paths[index] = self.order[index] end
  return paths
end

local function Router:revalidate_all(force: boolean)
  local paths = self:root_paths()
  for index = 1, #paths do
    local slot? = self.slots[paths[index]]
    if slot ~= nil then
      local actual = slot as Slot
      if not actual.transitioning then
        do
          revalidate(self, actual, force)
        catch
          if error is async.CancellationReason then raise end
          logging.emit("error", "root.revalidate.failure", {
            ["root"] = actual.root.path,
            ["message"] = strings.tostring(error),
          })
        end
      end
    end
  end
end

-- Housekeeping --------------------------------------------------------------------

local function Router:drain_retired()
  local pending_retired = self.retired
  self.retired = {}
  for index = 1, #pending_retired do
    do
      pending_retired[index]:close()
    catch
      if error is async.CancellationReason then raise end
    end
  end
end

local function Router:evict_idle()
  local now = now_milliseconds()
  local paths = self:root_paths()
  for index = 1, #paths do
    local slot? = self.slots[paths[index]]
    if slot ~= nil then
      local actual = slot as Slot
      if not actual.transitioning and slot_idle(self, actual) then
        local idle_seconds = (now - actual.last_used) as float / 1000.0
        if idle_seconds >= self.idle_timeout_seconds then
          stop_slot(self, actual, "idle timeout")
        end
      end
    end
  end
end

local function housekeeping(router: Router): nil
  while not router.closed do
    timer.sleep(HOUSEKEEPING_INTERVAL_MILLISECONDS)
    if router.closed then break end
    do
      router:drain_retired()
      router:revalidate_all(false)
      router:evict_idle()
    catch
      if error is async.CancellationReason then raise end
      logging.emit("error", "router.housekeeping.failure", {
        ["message"] = strings.tostring(error),
      })
    end
  end
  return nil
end

-- Lifecycle -----------------------------------------------------------------------

local function Router:capture_initialize(params: value)
  local object? = wire.as_object(params)
  local options: value = nil
  if object ~= nil then
    local actual = object as wire.Object
    self.client_capabilities = actual["capabilities"]
    options = actual["initializationOptions"]
    self.client_initialization_options = options
  end
  if options ~= nil then
    local options_object? = wire.as_object(options)
    if options_object ~= nil then
      local declared = options_object as wire.Object
      local max_workers? = wire.as_integer(declared["maxWorkers"])
      if max_workers ~= nil and (max_workers as integer) > 0 then
        self.max_workers = max_workers as integer
      end
      local idle? = seconds_value(declared["idleTimeoutSeconds"])
      if idle ~= nil and (idle as float) > 0.0 then
        -- A fractional timeout is what makes idle eviction observable in a
        -- protocol test without minutes of waiting.
        self.idle_timeout_seconds = idle as float
      end
    end
  end
  self.trust = root_settings.create(root_settings.trust_directories(
    options, os.getenv(TRUSTED_ROOTS_ENVIRONMENT_VARIABLE)))
  local declared: {string} = {}
  if object ~= nil then
    local actual = object as wire.Object
    local folders? = wire.as_array(actual["workspaceFolders"])
    if folders ~= nil then
      local items = folders as {value}
      for index = 1, #items do
        local folder? = wire.as_object(items[index])
        if folder ~= nil then
          local uri? = wire.as_string((folder as wire.Object)["uri"])
          if uri ~= nil then
            local path?, failure? = source_text.file_uri_to_path(uri as string)
            if path ~= nil then
              declared[#declared + 1] = path as string
            else
              logging.emit("info", "root.folder_ignored", {["uri"] = uri})
            end
          end
        end
      end
    else
      local root_uri? = wire.as_string(actual["rootUri"])
      if root_uri ~= nil then
        local path?, failure? = source_text.file_uri_to_path(root_uri as string)
        if path ~= nil then declared[#declared + 1] = path as string end
      else
        local root_path? = wire.as_string(actual["rootPath"])
        if root_path ~= nil then
          local absolute?, failure? = source_text.resolve_path(
            self.options.root, root_path as string)
          if absolute ~= nil then declared[#declared + 1] = absolute as string end
        end
      end
    end
  end
  if #declared == 0 then declared[1] = self.options.root end
  local seen: {string: boolean} = {}
  for index = 1, #declared do
    local canonical = roots.canonical(declared[index])
    self.registry:add_folder(canonical)
    if seen[canonical] == nil then
      seen[canonical] = true
      self.initial_roots[#self.initial_roots + 1] = canonical
    end
  end
  logging.emit("info", "router.initialize", {
    ["roots"] = #self.initial_roots,
    ["trusted_roots"] = self.trust:count(),
    ["max_workers"] = self.max_workers,
  })
end

local function Router:activate_initial_roots()
  if self.initial_activated then return end
  self.initial_activated = true
  for index = 1, #self.initial_roots do
    local root_path = self.initial_roots[index]
    local entry? = self.registry:find(root_path)
    if entry ~= nil then
      local slot = slot_for_root(self, entry as roots.Root)
      do
        local actual?, message? = activate(self, slot)
        if actual == nil and message ~= nil then
          logging.emit("error", "root.activation.failure", {
            ["root"] = root_path,
            ["message"] = message as string,
          })
        end
      catch
        if error is async.CancellationReason then raise end
        logging.emit("error", "root.activation.failure", {
          ["root"] = root_path,
          ["message"] = strings.tostring(error),
        })
      end
    end
  end
end

local function Router:shutdown_all()
  for index = 1, #self.order do
    local slot = self.slots[self.order[index]]
    if not slot.transitioning and slot.worker ~= nil then
      stop_slot(self, slot, "shutdown")
    end
  end
  self:drain_retired()
end

local function Router:stop_all()
  self.closed = true
  local housekeeping_task? = self.housekeeping
  self.housekeeping = nil
  for index = 1, #self.order do
    local slot = self.slots[self.order[index]]
    local worker? = slot.worker
    slot.worker = nil
    slot.worker_pid = nil
    if worker ~= nil then
      local actual_worker = worker as worker_process.WorkerProcess
      actual_worker:kill()
      self.retired[#self.retired + 1] = actual_worker
    end
  end
  if housekeeping_task ~= nil then
    local task = housekeeping_task as async.Task<|nil, value|>
    if not task:status():has_finished() then
      task:cancel(async.CancellationReason.simple("router stopped"))
    end
    async.join(task)
  end
  self:drain_retired()
end

--- Route one framed client message, returning a requested process exit code.
function Router:handle(body: string): integer?
  local parsed: value = nil
  do
    parsed = wire.decode(body)
  catch
    if error is json.Error then
      router_publish(self, dispatcher.failure_body(nil, PARSE_ERROR, "Parse error"))
      return nil
    end
    raise
  end
  local object? = wire.as_object(parsed)
  if object == nil then
    router_publish(self,
      dispatcher.failure_body(nil, INVALID_REQUEST, "Invalid Request"))
    return nil
  end
  local actual = object as wire.Object
  local method? = wire.as_string(actual["method"])
  local raw_id = actual["id"]
  if method == nil then
    if raw_id ~= nil and (actual["result"] ~= nil or actual["error"] ~= nil) then
      self:on_client_response(actual)
    end
    return nil
  end
  local actual_method = method as string
  if actual_method == "initialize" and
     self.envelope:phase_name() == "before_initialize" then
    -- Trust, limits and initial roots are captured once: a replayed or hostile
    -- second initialize is answered by the lifecycle and must not widen this
    -- session's trust.
    self:capture_initialize(actual["params"])
  elseif actual_method == "workspace/didChangeWorkspaceFolders" then
    if self.envelope:phase_name() ~= "before_initialize" then
      self:on_folders(actual["params"])
    end
    return nil
  elseif actual_method == "workspace/didChangeConfiguration" then
    if self.envelope:phase_name() ~= "before_initialize" then
      self:revalidate_all(true)
    end
    return nil
  end
  case self.envelope:route_value(parsed)
  when immediate(result) then
    local response? = result.response
    if response ~= nil then router_publish(self, response as string) end
    return nil
  when initialized() then
    self:activate_initial_roots()
    return nil
  when semantic(request) then
    self:route_request(request, body)
    return nil
  when completion(request) then
    self:route_completion(request, body)
    return nil
  when document(notification) then
    self:route_document(notification, body)
    return nil
  when cancel(id) then
    self:route_cancel(id)
    return nil
  when shutdown(result) then
    self:shutdown_all()
    local response? = result.response
    if response ~= nil then router_publish(self, response as string) end
    self:drain_retired()
    return nil
  when exit(code) then
    return code
  end
  return nil
end

--- Finish relay Tasks and every worker before the process exits.
function Router:close()
  self:stop_all()
end

--- Serve one client session until its exit notification or a transport failure.
function run(source: io.Reader, target: io.Writer,
             options: LaunchOptions): integer
  local input = protocol.new_input_queue()
  local output = response_queue.create()
  local writer = async.run<|nil, value|>(function (): nil
    return protocol.write_messages(target, output)
  end)
  local reader = async.run<|nil, value|>(function (): nil
    return protocol.read_messages(source, input)
  end)
  local router = create(options, output)
  router.housekeeping = async.run<|nil, value|>(function (): nil
    return housekeeping(router)
  end)
  logging.emit("debug", "router.session.start", nil)
  local closed = false
  local finish: Finish = function ()
    if closed then return end
    closed = true
    router:close()
    if not reader:status():has_finished() then
      reader:cancel(async.CancellationReason.simple("router stopped reading"))
    end
    async.join(reader)
    output:stop()
    async.join(writer)
  end
  defer finish()
  while true do
    case input:take()
    when message(delivery) then
      local exit_code? = router:handle(delivery.body)
      delivery:acknowledge()
      if exit_code ~= nil then return exit_code end
      async.yield()
    when eof() then
      raise protocol.ProtocolError.new(
        "stdin closed before the exit notification")
    when failure(message) then
      raise protocol.ProtocolError.new(message)
    end
  end
  return 1
end
