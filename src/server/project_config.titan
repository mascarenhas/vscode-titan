--- Load and normalize project settings into one semantic configuration identity.
-- @module server.project_config

local async = import "async"
local fs = import "fs"
local iteration = import "iteration"
local lua = import "lua"
local strings = import "string"
local paths = import "path"
local source_text = import "server.source_text"
local content_identity = import "server.content_identity"

record Error
  const path: string
  const message: string
  const target_selection: boolean?
  const line: integer?
end

--- One evaluated configuration file's global assignments.
type Environment = {value: value}
--- Absent-or-evaluated configuration, including a missing optional file.
type OptionalEnvironment = Environment?

local type SelectorLines = {string: integer}
local type SelectorObserver =
  function (Environment, string): (SelectorLines, function (): ())

-- Only the two selectors need a write trap. Other globals stay in the
-- ordinary environment; selector reads see the current values, including
-- nil after a clear. None of the observer's helpers enters that environment.
local const observe_selectors = lua.load([=[
local getinfo, rawset, setmetatable = debug.getinfo, rawset, setmetatable
return function(environment, source)
  local selectors, lines = {}, {}
  setmetatable(environment, {
    __index = selectors,
    __newindex = function(env, name, item)
      if name == "target" or name == "compiler_root" then
        selectors[name] = item
        local info = item ~= nil and getinfo(2, "Sl")
        lines[name] = info and info.source == source and info.currentline > 0
          and info.currentline or nil
      else
        rawset(env, name, item)
      end
    end,
  })
  return lines, function()
    setmetatable(environment, nil)
    environment.target = selectors.target
    environment.compiler_root = selectors.compiler_root
  end
end
]=], "=config_selector_observer", nil)() as SelectorObserver

local const LOCAL_CONFIG_FILE_NAME = "titan-config.local.lua"

local function configuration_path(root: string): string
  return source_text.join_path(root, "titan-config.lua")
end

local function local_configuration_path(root: string): string
  return source_text.join_path(root, LOCAL_CONFIG_FILE_NAME)
end

--- Normalized project discovery, source roots, native flags, and provider settings.
record ProjectConfig
  const project_root: string
  const config_file: string?
  const include: {string}
  const exclude: {string}
  const source_module_roots: {string}
  const binary_modules_root: string
  const extra_ffi_include_dirs: {string}
  const extra_ffi_cppflags: string?
  const compiler_root: string?
  const compiler_root_file: string?
  const use_selected_inventory: boolean?
  -- Nil selects the compiler's native host label, not the label "native".
  const target: string?
end

function ProjectConfig:copy(): ProjectConfig
  return ProjectConfig {
    project_root = self.project_root,
    config_file = self.config_file,
    include = {...self.include},
    exclude = {...self.exclude},
    source_module_roots = {...self.source_module_roots},
    binary_modules_root = self.binary_modules_root,
    extra_ffi_include_dirs = {...self.extra_ffi_include_dirs},
    extra_ffi_cppflags = self.extra_ffi_cppflags,
    compiler_root = self.compiler_root,
    compiler_root_file = self.compiler_root_file,
    use_selected_inventory = self.use_selected_inventory,
    target = self.target,
  }
end

-- Persist the same semantic fields used by live invalidation. Exclude only
-- changes watcher policy and must not invalidate a compatible checked graph.
-- compiler_root stays out of the identity on purpose: it selects the compiler
-- before this process loads it, and the workspace cache already fences the
-- compiler installation by its own compatibility fingerprint, so a selected
-- SDK change rebuilds the cache without changing this digest.
--- Return the complete identity fencing semantic cache compatibility.
function ProjectConfig:semantic_identity(): string
  local output = strings.writer()
  local fields = {self.project_root,self.config_file or "",self.binary_modules_root,
    self.extra_ffi_cppflags or ""}
  for index = 1, #fields do output:write(#fields[index] .. ":" .. fields[index]) end
  local groups = {self.include,self.source_module_roots,self.extra_ffi_include_dirs}
  for group_index = 1, #groups do
    local group = groups[group_index]
    output:write(#group .. ":")
    for index = 1, #group do output:write(#group[index] .. ":" .. group[index]) end
  end
  if self.use_selected_inventory ~= nil then
    output:write(self.use_selected_inventory == true and "selected inventory" or "ordinary lookup")
  end
  if self.target ~= nil then output:write(#self.target .. ":" .. self.target) end
  return content_identity.digest(output:drain())
end

local function fail<|T|>(path: string, message: string): T
  raise Error(path, message)
end

local function absolute_project_root(path: string): string
  local candidate = path
  if candidate == "" then candidate = "." end
  if not source_text.is_absolute_path(candidate) then
    local resolved?, failure? = source_text.resolve_path(fs.pwd(), candidate)
    if resolved == nil then
      return fail<|string|>(path, failure.message)
    end
    return resolved
  end
  local normalized?, failure? = source_text.normalize_absolute_path(candidate)
  if normalized == nil then return fail<|string|>(path, failure.message) end
  return normalized
end

local function resolve_config_path(config_file: string, base: string,
                                   candidate: string, field: string): string
  if candidate == "" then
    return fail<|string|>(config_file, field .. " must not be empty")
  end
  local resolved?, failure? = source_text.resolve_path(base, candidate)
  if resolved == nil then
    return fail<|string|>(config_file, field .. ": " .. failure.message)
  end
  return resolved
end

--- Resolve a directory alias without changing the lexical configuration path.
function physical_directory(path: string): string?
  local metadata? = fs.stat(path)
  if metadata == nil or metadata.kind ~= "directory" then return nil end
  return source_text.normalize_absolute_path(fs.realpath(path))
catch
  if error is async.OperationError then
    local failure = error as async.OperationError
    if failure.name == "ENOENT" or failure.name == "ENOTDIR" then return nil end
  end
  raise
end

local function optional_path(config_file: string, base: string,
                             candidate: value, field: string,
                             default_path: string): string
  if candidate == nil then return default_path end
  if not (candidate is string) then
    return fail<|string|>(config_file, field .. " must be a string")
  end
  return resolve_config_path(
    config_file, base, candidate as string, field)
end

local function optional_string(config_file: string, candidate: value,
                               field: string): string?
  if candidate == nil then return nil end
  if not (candidate is string) then
    return fail<|string|>(config_file, field .. " must be a string")
  end
  return candidate as string
end

local function normalize_paths(config_file: string, base: string,
                               candidate: value, field: string,
                               defaults: {string}): {string}
  if candidate == nil then
    local result: {string} = {}
    for index = 1, #defaults do
      local resolved = resolve_config_path(
        config_file, base, defaults[index], field .. "[" .. index .. "]")
      if field == "source_module_roots" and
         strings.find(resolved, ";") ~= nil then
        return fail<|{string}|>(
          config_file, field .. "[" .. index .. "] must not contain ';'")
      end
      result[index] = resolved
    end
    return result
  end
  if not (candidate is {value: value}) then
    return fail<|{string}|>(
      config_file, field .. " must be a Lua array table")
  end

  local raw = candidate as {value: value}
  local normalized: {integer: string} = {}
  local count = 0
  local maximum = 0
  for key, item in iteration.pairs(raw) do
    if not (key is integer) then
      return fail<|{string}|>(
        config_file,
        field .. " must contain only integer array keys")
    end
    local index = key as integer
    if index < 1 then
      return fail<|{string}|>(
        config_file,
        field .. " array keys must be positive")
    end
    if not (item is string) then
      return fail<|{string}|>(
        config_file,
        field .. " entries must be strings")
    end
    local resolved = resolve_config_path(
      config_file, base, item as string, field .. "[" .. index .. "]")
    if field == "source_module_roots" and
       strings.find(resolved, ";") ~= nil then
      return fail<|{string}|>(
        config_file, field .. "[" .. index .. "] must not contain ';'")
    end
    normalized[index] = resolved
    count = count + 1
    if index > maximum then maximum = index end
  end
  if count ~= maximum then
    return fail<|{string}|>(
      config_file, field .. " must be a dense Lua array")
  end

  local result: {string} = {}
  for index = 1, maximum do result[index] = normalized[index] end
  return result
end

local function normalize_compiler_root(config_file: string,
                                       project_root: string,
                                       candidate: value): string
  if not (candidate is string) then
    return fail<|string|>(config_file, "compiler_root must be a string")
  end
  local text = candidate as string
  if text == "" then
    return fail<|string|>(config_file, "compiler_root must not be empty")
  end
  return resolve_config_path(config_file, project_root, text, "compiler_root")
end

local function normalize_target(config_file: string, candidate: value,
                                line: integer?): string?
  if candidate == nil or candidate == "native" then return nil end
  if candidate == "browser" then return "browser" end
  raise Error(config_file, "target must be \"native\" or \"browser\"", true, line)
end

local function normalize_environment(config_file: string?,
                                     compiler_root_file: string?,
                                     project_root: string,
                                     default_binary_root: string,
                                     selected_inventory_directory: string?,
                                     environment: Environment):
    ProjectConfig
  -- Invalid defaults still belong to the expected configuration pathname,
  -- while config_file remains nil when the optional file is absent.
  local error_path = config_file or configuration_path(project_root)
  local raw_include: value = nil
  local raw_exclude: value = nil
  local raw_source_module_roots: value = nil
  local raw_binary_root: value = nil
  local raw_include_dirs: value = nil
  local raw_cppflags: value = nil
  local raw_compiler_root: value = nil
  local raw_target: value = nil
  for key, item in iteration.pairs(environment) do
    if not (key is string) then
      return fail<|ProjectConfig|>(
        error_path, "titan-config.lua global names must be strings")
    end
    local name = key as string
    if name == "include" then
      raw_include = item
    elseif name == "exclude" then
      raw_exclude = item
    elseif name == "source_module_roots" then
      raw_source_module_roots = item
    elseif name == "binary_modules_root" then
      raw_binary_root = item
    elseif name == "extra_ffi_include_dirs" then
      raw_include_dirs = item
    elseif name == "extra_ffi_cppflags" then
      raw_cppflags = item
    elseif name == "compiler_root" then
      raw_compiler_root = item
    elseif name == "target" then
      raw_target = item
    else
      return fail<|ProjectConfig|>(
        error_path, "unknown titan-config.lua field '" .. name .. "'")
    end
  end

  local include = normalize_paths(
    error_path, project_root, raw_include, "include", {"./src"})
  local exclude = normalize_paths(
    error_path, project_root, raw_exclude, "exclude", {})
  local source_module_roots = normalize_paths(
    error_path, project_root, raw_source_module_roots,
    "source_module_roots", {"./src"})
  local binary_root = optional_path(
    error_path, project_root, raw_binary_root,
    "binary_modules_root", default_binary_root)
  local use_selected_inventory: boolean? = nil
  if selected_inventory_directory ~= nil then
    use_selected_inventory = binary_root == selected_inventory_directory or
      physical_directory(binary_root) == selected_inventory_directory
  end
  local include_dirs = normalize_paths(
    error_path, project_root, raw_include_dirs,
    "extra_ffi_include_dirs", {})
  local cppflags? = optional_string(
    error_path, raw_cppflags, "extra_ffi_cppflags")
  local compiler_root: string?
  if raw_compiler_root ~= nil then
    local source_file = compiler_root_file or error_path
    compiler_root = normalize_compiler_root(
      source_file, project_root, raw_compiler_root)
  end
  return ProjectConfig {
    project_root = project_root,
    config_file = config_file,
    include = include,
    exclude = exclude,
    source_module_roots = source_module_roots,
    binary_modules_root = binary_root,
    extra_ffi_include_dirs = include_dirs,
    extra_ffi_cppflags = cppflags,
    compiler_root = compiler_root,
    compiler_root_file = compiler_root_file,
    use_selected_inventory = use_selected_inventory,
    target = normalize_target(error_path, raw_target),
  }
end

-- Configuration is data, not an extension hook. Evaluate it with an empty
-- environment so workspace code cannot write protocol-corrupting bytes through
-- print/io (or mutate the embedded compiler Lua state). A valid file needs only
-- assignments and Lua literals. The environment itself is the result;
-- accepting a returned table would silently support a second, incompatible
-- configuration format. A missing file yields nil, and a non-file path is an
-- error.
local function evaluate(config_file: string, observe: boolean?): (Environment?, SelectorLines?)
  local metadata? = fs.stat(config_file)
  if metadata == nil then return nil, nil end
  if metadata.kind ~= "file" then
    return fail<|OptionalEnvironment|>(config_file,
      paths.basename(config_file) .. " is not a regular file"), nil
  end
  local environment: Environment = {}
  local returned: value
  local lines: SelectorLines?
  do
    local source = fs.read_file(config_file)
    local chunk_name = "@" .. config_file
    local finish: (function (): ())?
    if observe then
      lines, finish = observe_selectors(environment, chunk_name)
    end
    local chunk = lua.load(source, chunk_name, environment)
    returned = chunk()
    if finish ~= nil then finish() end
  catch
    if error is async.CancellationReason then raise end
    return fail<|OptionalEnvironment|>(config_file,
      "cannot evaluate " .. paths.basename(config_file) .. ": " ..
      strings.tostring(error)), nil
  end
  if returned ~= nil then
    return fail<|OptionalEnvironment|>(config_file,
      paths.basename(config_file) ..
      " must use global assignments and return no value"), nil
  end
  return environment, lines
end

-- The untracked local override exists for one job: naming a machine-specific
-- SDK prefix without dirtying the tracked configuration. Every other key is
-- rejected rather than silently shadowing the tracked file.
local function evaluate_local(config_file: string, observe: boolean?):
    (Environment?, SelectorLines?)
  local environment?, lines? = evaluate(config_file, observe)
  if environment == nil then return nil, nil end
  for key, _ in iteration.pairs(environment) do
    if not (key is string) or (key as string) ~= "compiler_root" then
      return fail<|OptionalEnvironment|>(config_file,
        "titan-config.local.lua may only assign compiler_root"), nil
    end
  end
  return environment, lines
end

local function load_or_raise(project_root: string,
                             installed_binary_modules_root: string,
                             selected_inventory_directory: string?):
    ProjectConfig
  local root = absolute_project_root(project_root)
  local default_binary_root = resolve_config_path(
    root, root, installed_binary_modules_root,
    "installed binary modules root")
  local config_file = configuration_path(root)

  local tracked? = evaluate(config_file)
  local environment: Environment = {}
  local actual_config_file: string? = config_file
  if tracked == nil then
    actual_config_file = nil
  else
    environment = tracked
  end
  local compiler_root_file: string?
  local local_file = local_configuration_path(root)
  local overrides? = evaluate_local(local_file)
  if overrides ~= nil and overrides["compiler_root"] ~= nil then
    environment["compiler_root"] = overrides["compiler_root"]
    compiler_root_file = local_file
  end
  return normalize_environment(
    actual_config_file, compiler_root_file, root, default_binary_root,
    selected_inventory_directory, environment)
end

--- Compiler SDK and analysis target selection, read before a worker exists.
record CompilerRoot
  const compiler_root: string?
  const compiler_root_file: string?
  const target: string?
  const compiler_root_line: integer?
  const target_line: integer?
end

-- The router must select an SDK and evaluate trust before a worker exists, and
-- it must not load the compiler to do it. This reads only the two configuration
-- files' compiler_root and tracked target. Every other key stays the worker's
-- business, which reports unknown or malformed fields as its own project error.
--
-- Three outcomes are distinct on purpose:
--   * no local override and a tracked file this server cannot evaluate means no
--     SDK is selected here: the worker reports that project error itself, which
--     is what the single-root server always did;
--   * the local override exists only to select an SDK, so every problem in it is
--     a root-scoped selection error, never a silent default SDK;
--   * a present but unusable compiler_root value selects nothing verifiable, so
--     it is also a selection error.
--- Read the effective compiler_root and associated tracked analysis target.
function load_compiler_root(project_root: string): (CompilerRoot?, Error?)
  local root = absolute_project_root(project_root)
  local local_file = local_configuration_path(root)
  local overrides?, override_lines? = evaluate_local(local_file, true)
  local override_root: string?
  if overrides ~= nil then
    local raw = overrides["compiler_root"]
    if raw ~= nil then
      override_root = normalize_compiler_root(local_file, root, raw)
    end
  end
  local config_file = configuration_path(root)
  local tracked: OptionalEnvironment
  local tracked_lines: SelectorLines?
  local tracked_error: Error?
  do
    tracked, tracked_lines = evaluate(config_file, true)
  catch
    if error is async.CancellationReason then raise end
    if error is Error then
      tracked_error = error as Error
    else
      raise
    end
  end
  if tracked_error ~= nil then
    -- An override exists, so this root exists to select an SDK; a tracked file
    -- that cannot be read makes that selection unverifiable.
    if overrides ~= nil then return nil, tracked_error end
    return CompilerRoot {}, nil
  end
  local tracked_root: string?
  local tracked_file: string?
  local target: string?
  local compiler_root_line: integer?
  local target_line: integer?
  if tracked_lines ~= nil then
    compiler_root_line = tracked_lines["compiler_root"]
    target_line = tracked_lines["target"]
  end
  if tracked ~= nil then
    local raw = tracked["compiler_root"]
    if raw ~= nil then
      tracked_root = normalize_compiler_root(config_file, root, raw)
      tracked_file = config_file
    end
    target = normalize_target(config_file, tracked["target"], target_line)
  end
  if override_root ~= nil then
    local override_line: integer?
    if override_lines ~= nil then override_line = override_lines["compiler_root"] end
    return CompilerRoot(override_root, local_file, target, override_line, target_line), nil
  end
  return CompilerRoot(tracked_root, tracked_file, target, compiler_root_line, target_line), nil
catch
  if error is async.CancellationReason then raise end
  if error is Error then return nil, error as Error end
  return nil, Error(project_root, strings.tostring(error))
end

-- The caller supplies the installed library-versioned directory reported by
-- the compatible compiler bridge. This keeps the Lua value boundary here
-- limited to the optional project file and makes the default explicit and
-- testable.
--- Evaluate optional titan-config.lua assignments and normalize paths against the project root.
function load(project_root: string,
              installed_binary_modules_root: string,
              selected_inventory_directory: string?):
    (ProjectConfig?, Error?)
  return load_or_raise(project_root, installed_binary_modules_root,
    selected_inventory_directory), nil
catch
  if error is async.CancellationReason then raise end
  if error is Error then return nil, error as Error end
  return nil, Error(project_root, strings.tostring(error))
end
