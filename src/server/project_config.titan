local async = import "async"
local fs = import "fs"
local iteration = import "iteration"
local lua = import "lua"
local strings = import "string"
local source_text = import "server.source_text"

record Error
  path: string
  message: string
end

record ProjectConfig
  project_root: string
  config_file: string?
  include: {string}
  exclude: {string}
  source_module_roots: {string}
  binary_modules_root: string
  extra_ffi_include_dirs: {string}
  extra_ffi_cppflags: string?
end

function ProjectConfig:source_path(): string
  local output = strings.writer()
  for index = 1, #self.source_module_roots do
    if index > 1 then output:write(";") end
    output:write(self.source_module_roots[index])
  end
  return output:drain()
end

local function fail<T>(path: string, message: string): T
  raise Error.new(path, message)
end

local function absolute_project_root(path: string): string
  local candidate = path
  if candidate == "" then candidate = "." end
  if strings.sub(candidate, 1, 1) ~= "/" then
    local resolved?, failure? = source_text.resolve_path(fs.pwd(), candidate)
    if resolved == nil then
      return fail<string>(path, failure.message)
    end
    return resolved
  end
  local normalized?, failure? = source_text.normalize_absolute_path(candidate)
  if normalized == nil then return fail<string>(path, failure.message) end
  return normalized
end

local function resolve_config_path(config_file: string, base: string,
                                   candidate: string, field: string): string
  if candidate == "" then
    return fail<string>(config_file, field .. " must not be empty")
  end
  local resolved?, failure? = source_text.resolve_path(base, candidate)
  if resolved == nil then
    return fail<string>(config_file, field .. ": " .. failure.message)
  end
  return resolved
end

local function optional_path(config_file: string, base: string,
                             candidate: value, field: string,
                             default_path: string): string
  if candidate == nil then return default_path end
  if not (candidate is string) then
    return fail<string>(config_file, field .. " must be a string")
  end
  return resolve_config_path(
    config_file, base, candidate as string, field)
end

local function optional_string(config_file: string, candidate: value,
                               field: string): string?
  if candidate == nil then return nil end
  if not (candidate is string) then
    return fail<string>(config_file, field .. " must be a string")
  end
  return candidate as string
end

local function normalize_paths(config_file: string, base: string,
                               candidate: value, field: string,
                               defaults: {string}): {string}
  if candidate == nil then
    local result: {string} = {}
    for index = 1, #defaults do
      local resolved = resolve_config_path(
        config_file, base, defaults[index], field .. "[" .. index .. "]")
      if field == "source_module_roots" and
         strings.find(resolved, ";") ~= nil then
        return fail<{string}>(
          config_file, field .. "[" .. index .. "] must not contain ';'")
      end
      result[index] = resolved
    end
    return result
  end
  if not (candidate is {value: value}) then
    return fail<{string}>(
      config_file, field .. " must be a Lua array table")
  end

  local raw = candidate as {value: value}
  local normalized: {integer: string} = {}
  local count = 0
  local maximum = 0
  for key, item in iteration.pairs(raw) do
    if not (key is integer) then
      return fail<{string}>(
        config_file,
        field .. " must contain only integer array keys")
    end
    local index = key as integer
    if index < 1 then
      return fail<{string}>(
        config_file,
        field .. " array keys must be positive")
    end
    if not (item is string) then
      return fail<{string}>(
        config_file,
        field .. " entries must be strings")
    end
    local resolved = resolve_config_path(
      config_file, base, item as string, field .. "[" .. index .. "]")
    if field == "source_module_roots" and
       strings.find(resolved, ";") ~= nil then
      return fail<{string}>(
        config_file, field .. "[" .. index .. "] must not contain ';'")
    end
    normalized[index] = resolved
    count = count + 1
    if index > maximum then maximum = index end
  end
  if count ~= maximum then
    return fail<{string}>(
      config_file, field .. " must be a dense Lua array")
  end

  local result: {string} = {}
  for index = 1, maximum do result[index] = normalized[index] end
  return result
end

local function normalize_environment(config_file: string,
                                     project_root: string,
                                     default_binary_root: string,
                                     environment: {value: value}):
    ProjectConfig
  local raw_include: value = nil
  local raw_exclude: value = nil
  local raw_source_module_roots: value = nil
  local raw_binary_root: value = nil
  local raw_include_dirs: value = nil
  local raw_cppflags: value = nil
  for key, item in iteration.pairs(environment) do
    if not (key is string) then
      return fail<ProjectConfig>(
        config_file, "titan-config.lua global names must be strings")
    end
    local name = key as string
    if name == "include" then
      raw_include = item
    elseif name == "exclude" then
      raw_exclude = item
    elseif name == "source_module_roots" then
      raw_source_module_roots = item
    elseif name == "binary_modules_root" then
      raw_binary_root = item
    elseif name == "extra_ffi_include_dirs" then
      raw_include_dirs = item
    elseif name == "extra_ffi_cppflags" then
      raw_cppflags = item
    else
      return fail<ProjectConfig>(
        config_file, "unknown titan-config.lua field '" .. name .. "'")
    end
  end

  local include = normalize_paths(
    config_file, project_root, raw_include, "include", {"./src"})
  local exclude = normalize_paths(
    config_file, project_root, raw_exclude, "exclude", {})
  local source_module_roots = normalize_paths(
    config_file, project_root, raw_source_module_roots,
    "source_module_roots", {"./src"})
  local binary_root = optional_path(
    config_file, project_root, raw_binary_root,
    "binary_modules_root", default_binary_root)
  local include_dirs = normalize_paths(
    config_file, project_root, raw_include_dirs,
    "extra_ffi_include_dirs", {})
  local cppflags: string? = optional_string(
    config_file, raw_cppflags, "extra_ffi_cppflags")
  return ProjectConfig.new(
    project_root, config_file, include, exclude, source_module_roots,
    binary_root, include_dirs, cppflags)
end

local function load_or_raise(project_root: string,
                             installed_binary_modules_root: string):
    ProjectConfig
  local root = absolute_project_root(project_root)
  local default_binary_root = resolve_config_path(
    root, root, installed_binary_modules_root,
    "installed binary modules root")
  local config_file = root .. "/titan-config.lua"
  if root == "/" then config_file = "/titan-config.lua" end

  local metadata? = fs.stat(config_file)
  if metadata == nil then
    local include = normalize_paths(
      config_file, root, nil, "include", {"./src"})
    local source_module_roots = normalize_paths(
      config_file, root, nil, "source_module_roots", {"./src"})
    return ProjectConfig.new(
      root, nil, include, {}, source_module_roots,
      default_binary_root, {}, nil)
  end
  if metadata.kind ~= "file" then
    return fail<ProjectConfig>(
      config_file, "titan-config.lua is not a regular file")
  end

  local environment: {value: value} = {}
  local returned: value = nil
  do
    -- Configuration is data, not an extension hook. Evaluate it with an
    -- empty environment so workspace code cannot write protocol-corrupting
    -- bytes through print/io (or mutate the embedded compiler Lua state).
    -- A valid file needs only assignments and Lua literals. The environment
    -- itself is the result; accepting a returned table would silently support
    -- a second, incompatible configuration format.
    local source = fs.read_file(config_file)
    local chunk = lua.load(source, "@" .. config_file, environment)
    returned = chunk()
  catch
    if error is async.CancellationReason then raise end
    return fail<ProjectConfig>(
      config_file,
      "cannot evaluate titan-config.lua: " .. strings.tostring(error))
  end
  if returned ~= nil then
    return fail<ProjectConfig>(
      config_file,
      "titan-config.lua must use global assignments and return no value")
  end
  return normalize_environment(
    config_file, root, default_binary_root, environment)
end

-- The caller supplies the installed library-versioned directory reported by
-- the compatible compiler bridge. This keeps the Lua value boundary here
-- limited to the optional project file and makes the default explicit and
-- testable.
function load(project_root: string,
              installed_binary_modules_root: string):
    (ProjectConfig?, Error?)
  do
    return load_or_raise(project_root, installed_binary_modules_root), nil
  catch
    if error is async.CancellationReason then raise end
    if error is Error then return nil, error as Error end
    return nil, Error.new(project_root, strings.tostring(error))
  end
end
