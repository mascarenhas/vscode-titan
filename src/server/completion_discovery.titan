--- Discover private completion inputs and generation-fenced saved baselines.
-- @module server.completion_discovery

local bridge = import "server.compiler_bridge"
local discovery = import "server.project_discovery"
local source_text = import "server.source_text"
local strings = import "string"

-- This resolver reads the captured catalog only. It never discovers files,
-- mutates saved membership, or follows a client URI through the filesystem.
local function within_any(path: string, roots: const? {string}): boolean
  for index = 1, #roots do
    if source_text.path_within(roots[index], path) then return true end
  end
  return false
end

local function admitted(path: string, include: const? {string},
                        exclude: const? {string}): boolean
  return within_any(path, include) and not within_any(path, exclude) and
    strings.find(path, "/.titan-ls/") == nil and
    #path > 6 and source_text.titan_source_path(path)
end

local function selected_root(path: string, roots: const? {string}): integer?
  local selected?: integer
  local length = 0
  for index = 1, #roots do
    local root = roots[index]
    if source_text.path_within(root, path) and #root > length then
      selected = index
      length = #root
    end
  end
  return selected
end

local function slash_to_dot(_: string): string
  return "."
end

local function dotted(path: string): string
  return (strings.gsub(path, "/", slash_to_dot))
end

local function saved_owner(path: string,
                           sources: const? {bridge.ProjectModule}): string?
  for index = 1, #sources do
    local module = sources[index]
    for file_index = 1, #module.files do
      if module.files[file_index].filename == path then return module.module_name end
    end
  end
  return nil
end

local function open_exists(path: string, include: const? {string},
                           exclude: const? {string},
                           open_paths: const? {string}): boolean
  if not admitted(path, include, exclude) then return false end
  for index = 1, #open_paths do
    if open_paths[index] == path then return true end
  end
  return false
end

local function inactive_exists(path: string,
                               inactive_paths: {string}?): boolean
  if inactive_paths == nil then return false end
  for index = 1, #inactive_paths do
    if inactive_paths[index] == path then return true end
  end
  return false
end

local function saved_family_member(directory: string, logical_basename: string,
                                   labels: const? {string},
                                   sources: const? {bridge.ProjectModule},
                                   inactive_paths: {string}?): string?
  for index = 1, #sources do
    local module = sources[index]
    for file_index = 1, #module.files do
      local filename = module.files[file_index].filename
      if source_text.parent_directory(filename) == directory then
        local classification = bridge.classify_source_filename(
          source_text.leaf_name(filename))
        if classification.logical_basename == logical_basename then
          return filename
        end
      end
    end
  end
  if inactive_paths ~= nil then
    local stem = strings.sub(logical_basename, 1, #logical_basename - 6)
    for index = 1, #labels do
      local candidate = source_text.join_path(
        directory, stem .. "." .. labels[index] .. ".titan")
      if inactive_exists(candidate, inactive_paths) then
        return candidate
      end
    end
    local default_path = source_text.join_path(directory, logical_basename)
    if inactive_exists(default_path, inactive_paths) then
      return default_path
    end
  end
  return nil
end

local function has_any_family_member(directory: string,
                                     logical_basename: string,
                                     sources: const? {bridge.ProjectModule},
                                     inactive_paths: {string}?,
                                     include: const? {string},
                                     exclude: const? {string},
                                     open_paths: const? {string}): boolean
  for index = 1, #sources do
    local module = sources[index]
    for file_index = 1, #module.files do
      local filename = module.files[file_index].filename
      if source_text.parent_directory(filename) == directory then
        local classification = bridge.classify_source_filename(
          source_text.leaf_name(filename))
        if classification.logical_basename == logical_basename then
          return true
        end
      end
    end
  end
  if inactive_paths ~= nil then
    for index = 1, #inactive_paths do
      local filename = inactive_paths[index]
      if source_text.parent_directory(filename) == directory then
        local classification = bridge.classify_source_filename(
          source_text.leaf_name(filename))
        if classification.logical_basename == logical_basename then
          return true
        end
      end
    end
  end
  for index = 1, #open_paths do
    local filename = open_paths[index]
    if admitted(filename, include, exclude) and
       source_text.parent_directory(filename) == directory then
      local classification = bridge.classify_source_filename(
        source_text.leaf_name(filename))
      if classification.logical_basename == logical_basename then
        return true
      end
    end
  end
  return false
end

local function select_virtual_family(directory: string,
                                     logical_basename: string,
                                     labels: const? {string},
                                     sources: const? {bridge.ProjectModule},
                                     inactive_paths: {string}?,
                                     include: const? {string},
                                     exclude: const? {string},
                                     open_paths: const? {string}): string?
  local saved? = saved_family_member(
    directory, logical_basename, labels, sources, inactive_paths)
  if saved ~= nil then return saved end
  local stem = strings.sub(logical_basename, 1, #logical_basename - 6)
  for index = 1, #labels do
    local candidate = source_text.join_path(
      directory, stem .. "." .. labels[index] .. ".titan")
    if open_exists(candidate, include, exclude, open_paths) then
      return candidate
    end
  end
  local default_path = source_text.join_path(directory, logical_basename)
  if open_exists(default_path, include, exclude, open_paths) then
    return default_path
  end
  return nil
end

local function folder_conflicts(directory: string, module_name: string,
                                sources: const? {bridge.ProjectModule}): boolean
  for index = 1, #sources do
    local module = sources[index]
    for file_index = 1, #module.files do
      if source_text.parent_directory(module.files[file_index].filename) == directory and
         module.module_name ~= module_name then
        return true
      end
    end
  end
  return false
end

-- Include roots are a complete saved scan only within their own trees. An
-- earlier source root outside them may contain an uncaptured provider, so a
-- new later-root identity cannot safely claim that the earlier lookup missed.
local function covered_root(root: string, include: const? {string}): boolean
  return within_any(root, include)
end

function find(path: string, sources: {bridge.ProjectModule},
              source_roots: {string}, include: {string},
              exclude: {string}, open_paths: const {string},
              inactive_paths: {string}?,
              requested_target: string?): string?
  local normalized? = source_text.normalize_absolute_path(path)
  if normalized == nil then return nil end
  if inactive_exists(normalized, inactive_paths) then return nil end
  local known? = saved_owner(normalized, sources)
  if known ~= nil then return known end
  if not admitted(normalized, include, exclude) then return nil end
  local classification = bridge.classify_source_filename(
    source_text.leaf_name(normalized))
  if classification.error ~= nil or
     classification.logical_basename == nil then
    return nil
  end
  local target = requested_target or bridge.host_target()
  if classification.label ~= nil and
     not bridge.target_label_applies(target, classification.label) then
    return nil
  end
  local logical_basename = classification.logical_basename
  local selection_labels = bridge.target_selection_labels(target)
  local root_index? = selected_root(normalized, source_roots)
  if root_index == nil then return nil end
  local root = source_roots[root_index]
  local relative? = source_text.relative_path(root, normalized)
  if relative == nil then return nil end
  local directory = source_text.parent_directory(normalized)
  local relative_directory = discovery.relative_parent(relative)
  local logical_relative = logical_basename
  if relative_directory ~= "" then
    logical_relative = relative_directory .. "/" .. logical_basename
  end
  local candidate_relative = strings.sub(
    logical_relative, 1, #logical_relative - 6)

  -- Choose a folder namespace using its actual canonical main, never the
  -- number of saved contributors or the order in which buffers were opened.
  if relative_directory ~= "" then
    local folder_main? = select_virtual_family(
      directory, source_text.leaf_name(directory) .. ".titan",
      selection_labels, sources, nil, include, exclude, open_paths)
    if folder_main ~= nil then
      candidate_relative = relative_directory
    end
  end
  if not discovery.valid_path_components(candidate_relative) then return nil end
  local candidate = dotted(candidate_relative)
  if not discovery.valid_module_name(candidate) then return nil end

  local candidate_path = discovery.module_path(candidate)
  local basename = discovery.terminal_component(candidate)
  for index = 1, #source_roots do
    local candidate_root = source_roots[index]
    local folder = source_text.join_path(candidate_root, candidate_path)
    local folder_main? = select_virtual_family(
      folder, basename .. ".titan", selection_labels,
      sources, nil, include, exclude, open_paths)
    if folder_main ~= nil then
      if folder ~= directory or
         folder_conflicts(folder, candidate, sources) then return nil end
      local selected_member? = select_virtual_family(
        folder, logical_basename, selection_labels,
        sources, nil, include, exclude, open_paths)
      if selected_member ~= normalized then return nil end
      -- A saved module with the same identity but a different provider cannot
      -- be replaced by an unsaved new main. Wait for watcher publication.
      for module_index = 1, #sources do
        local module = sources[module_index]
        if module.module_name == candidate and #module.files > 0 and
           module.files[1].filename ~= folder_main then return nil end
      end
      return candidate
    end

    local flat_directory = source_text.parent_directory(
      source_text.join_path(candidate_root, candidate_path .. ".titan"))
    local flat? = select_virtual_family(
      flat_directory, basename .. ".titan", selection_labels,
      sources, inactive_paths, include, exclude, open_paths)
    if flat ~= nil then
      local owner? = discovery.module_owner(candidate)
      if owner ~= nil then
        local owner_folder = source_text.join_path(
          candidate_root, discovery.module_path(owner))
        if has_any_family_member(
            owner_folder, discovery.terminal_component(owner) .. ".titan",
            sources, inactive_paths, include, exclude, open_paths) then
          return nil
        end
      end
      if flat ~= normalized or inactive_exists(flat, inactive_paths) then
        return nil
      end
      for module_index = 1, #sources do
        local module = sources[module_index]
        if module.module_name == candidate and #module.files > 0 and
           module.files[1].filename ~= flat then return nil end
      end
      return candidate
    end
    if index < root_index and not covered_root(candidate_root, include) then
      return nil
    end
  end
  return nil
end
