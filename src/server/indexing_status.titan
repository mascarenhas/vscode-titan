local wire = import "server.wire"

union State
  indexing
  ready
  failed
end

record Status
  const state: State
  const initial: boolean
  const epoch: integer
  const generation: integer?
  const message: string?
  const completed_files: integer?
  const total_files: integer?
end

type Listener = (Status) -> ()

function state_name(state: State): string
  case state
  when indexing then return "indexing"
  when ready then return "ready"
  when failed then return "failed"
  end
end

local function validate_progress(status: Status)
  local completed? = status.completed_files
  local total? = status.total_files
  if completed == nil and total == nil then return end
  if completed == nil or total == nil then
    raise "indexing progress requires completed_files and total_files"
  end
  if state_name(status.state) ~= "indexing" then
    raise "indexing progress is only valid while indexing"
  end
  if completed < 0 or total < 0 or
     completed > 9007199254740991 or total > 9007199254740991 then
    raise "indexing progress must use nonnegative safe integers"
  end
  if completed > total then
    raise "indexing progress cannot exceed total_files"
  end
end

function notification(status: Status): string
  validate_progress(status)
  local params: wire.Object = {
    ["state"] = state_name(status.state),
    ["initial"] = status.initial,
    ["epoch"] = status.epoch,
  }
  if status.generation ~= nil then
    params["generation"] = status.generation
  end
  if status.message ~= nil then
    params["message"] = status.message
  end
  if status.completed_files ~= nil then
    params["completed_files"] = status.completed_files
    params["total_files"] = status.total_files
  end
  local envelope: wire.Object = {
    ["jsonrpc"] = "2.0",
    ["method"] = "titan/indexingStatus",
    ["params"] = params,
  }
  return wire.encode(envelope)
end
