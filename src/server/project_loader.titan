--- Load project services and coordinate deferred cached-body restoration.
-- @module server.project_loader

local async = import "async"
local strings = import "string"
local sqlite3 = import "sqlite3"
local bridge = import "server.compiler_bridge"
local config = import "server.project_config"
local service = import "server.project_service"
local caches = import "server.workspace_cache"
local logging = import "server.logging"
local completion_store = import "server.completion_store"
local completion_types = import "server.completion_types"
local sql = import "server.workspace_store"
local header_store = import "server.header_store"
foreign import "compiler_io_clock.h"

local function phase(name: string, cpu: float, wall: float)
  local elapsed = ffi.vscode_titan_monotonic_ms() - wall
  if elapsed < 0.0 then elapsed = 0.0 end
  logging.emit("debug", "cache.startup.phase", {
    ["phase"] = name, ["cpu_ms"] = logging.elapsed_ms(cpu), ["wall_ms"] = elapsed,
  })
end

local function project_inputs(snapshot: service.Snapshot): {bridge.ProjectModule}
  local projects: {bridge.ProjectModule} = {}
  for index = 1, #snapshot.project_modules do
    local module = snapshot.project_modules[index]
    projects[index] = module:compiler_input()
  end
  return projects
end

local record CompletionRevision
  const name: string
  const revision: integer
  const state: integer
end

local function binary_provider_key(kind: string, filename: string): string
  return kind .. "\0" .. filename
end

-- Catalog-only siblings belong to a complete physical provider. Saved graph
-- names always win, and a recapture replaces all prior siblings of its owner.
local function completion_catalog(connection: sqlite3.Connection,
    snapshot: service.Snapshot, binaries: const? {bridge.CompletionBinary},
    reusable: boolean, browser_provider: string?):
    ({completion_store.SavedDescriptor}, {string})
  local browser_provider_key: string? = nil
  if browser_provider ~= nil then
    browser_provider_key = binary_provider_key("static", browser_provider)
  end
  local graph_names: {string: integer} = {}
  local graph_rows = sql.rows(connection, "SELECT name,provenance FROM main.graph_modules")
  for index = 1, #graph_rows do graph_names[graph_rows[index]:get(1)] = graph_rows[index]:get(2) end
  local clean: {string: boolean} = {}
  local reachable = sql.rows(connection,
    "WITH RECURSIVE reachable(name) AS (" ..
    "SELECT imported FROM main.graph_imports AS e JOIN main.graph_modules AS m ON m.name=e.importer " ..
    "WHERE m.provenance=0 AND m.state=2 UNION " ..
    "SELECT imported FROM reachable AS r JOIN main.graph_modules AS m ON m.name=r.name " ..
    "JOIN main.graph_imports AS e ON e.importer=r.name WHERE m.provenance<>0) SELECT name FROM reachable")
  for index = 1, #reachable do clean[reachable[index]:get(1)] = true end
  local selected: {string: boolean} = {}
  local clean_providers: {string: boolean} = {}
  for index = 1, #snapshot.external_modules do
    local external = snapshot.external_modules[index]
    local key?: string
    case external.origin
    when static_binary{provider_file} then key = binary_provider_key("static", provider_file)
    when dynamic_binary{provider_file} then key = binary_provider_key("dynamic", provider_file)
    when source() then
    end
    if key ~= nil then
      selected[key] = true
      if clean[external.module_name] then clean_providers[key] = true end
    end
  end
  local previous: {sqlite3.Row} = {}
  if sql.scalar_integer(connection,
      "SELECT count(*) FROM main.sqlite_master WHERE name='completion_descriptors' AND type='table'") ~= 0 then
    previous = sql.rows(connection,
      "SELECT module_name,provenance,main_file FROM main.completion_descriptors " ..
      "WHERE provenance IN ('static','dynamic','embedded') ORDER BY module_name")
  end
  local replaced: {string: boolean} = {}
  local blocked: {string: boolean} = {}
  for index = 1, #binaries do
    local binary = binaries[index]
    local key = binary_provider_key(binary.kind, binary.filename)
    replaced[key] = true
    local provenance? = graph_names[binary.module_name]
    if provenance ~= nil and provenance ~= 2 then blocked[key] = true end
  end
  for index = 1, #previous do
    local row = previous[index]
    local key = binary_provider_key(row:get(2), sql.bytes(row, 3))
    local provenance? = graph_names[sql.bytes(row, 1)]
    if not replaced[key] and provenance ~= nil and provenance ~= 2 then
      blocked[key] = true
    end
  end
  local names: {string} = {}
  local choices: {string: bridge.CompletionBinary} = {}
  local fresh: {string: boolean} = {}
  for index = 1, #previous do
    local row = previous[index]
    local name = sql.bytes(row, 1)
    local kind: string = row:get(2)
    local key = binary_provider_key(kind, sql.bytes(row, 3))
    local keep = false
    if kind == "embedded" then
      keep = reusable
    elseif key == browser_provider_key or selected[key] then
      keep = reusable or clean_providers[key] == true
    end
    if graph_names[name] == nil and not blocked[key] and not replaced[key] and
       keep then
      names[#names + 1] = name
      choices[name] = bridge.CompletionBinary {
        module_name = name,
        serialized = "",
        kind = kind,
        filename = sql.bytes(row, 3),
      }
    end
  end
  for index = 1, #binaries do
    local binary = binaries[index]
    local key = binary_provider_key(binary.kind, binary.filename)
    if graph_names[binary.module_name] == nil and not blocked[key] and
       (binary.kind == "embedded" or key == browser_provider_key or selected[key] == true) then
      local previous? = choices[binary.module_name]
      if previous == nil then
        names[#names + 1] = binary.module_name
        choices[binary.module_name] = binary
        fresh[binary.module_name] = true
      elseif binary.kind == "embedded" then
        choices[binary.module_name] = binary
        fresh[binary.module_name] = true
      elseif previous.kind ~= "embedded" and
             binary.filename > previous.filename then
        -- Preserve the compiler's deterministic catalog ordering. Ordinary
        -- graph selections remain authoritative; invalid archive overlap still
        -- belongs to the compiler's resolver diagnostics.
        choices[binary.module_name] = binary
        fresh[binary.module_name] = true
      end
    end
  end
  local descriptors: {completion_store.SavedDescriptor} = {}
  local retained: {string} = {}
  for index = 1, #names do
    local name = names[index]
    local binary = choices[name]
    retained[#retained + 1] = name
    if fresh[name] then
      descriptors[#descriptors + 1] = completion_store.SavedDescriptor {
        module_name = name,
        revision = 0,
        state = 2,
        provenance = binary.kind,
        main_file = binary.filename,
        public_interface = binary.serialized,
        source_files = {},
        imports = {},
        header_inputs = {},
        candidates = {},
        documentation = binary.documentation,
      }
    end
  end
  return descriptors, retained
end

-- The updater prepares compiler facts without holding the connection lease,
-- then publishes these descriptors with semantic_files in its one transaction.
local function prepare_completion_descriptors(snapshot: service.Snapshot,
    loaded: service.Service, compiler: bridge.Compiler, reusable: boolean):
    ({completion_store.SavedDescriptor}, {string})
  local changed: {CompletionRevision} = {}
  local retained: {string} = {}
  local exists = false
  do
    local access = loaded:workspace_store():acquire()
    defer access:release()
    exists = sql.scalar_integer(access.connection,
      "SELECT count(*) FROM main.sqlite_master WHERE type='table' AND name IN " ..
      "('completion_descriptors','completion_source_files','completion_imports','completion_header_inputs','completion_members','completion_configuration','completion_roots')") == 7
    local query = "SELECT name,revision,state,provenance FROM main.graph_modules ORDER BY name"
    local rows = sql.rows(access.connection, query)
    for index = 1, #rows do
      local row = rows[index]
      local name: string = row:get(1)
      local revision: integer = row:get(2)
      local state: integer = row:get(3)
      retained[index] = name
      local unchanged = false
      if exists and row:get(4) == 0 then
        unchanged = sql.scalar_integer(access.connection,
          "SELECT count(*) FROM main.completion_descriptors WHERE module_name=? AND revision=? AND state=?",
          sqlite3.Blob(name), revision, state) ~= 0
      end
      if not unchanged then
        changed[#changed + 1] = CompletionRevision(name, revision, state)
      end
    end
  end
  local names: {string} = {}
  for index = 1, #changed do names[index] = changed[index].name end
  local exported = compiler:export_completion_facts(names)
  local candidates: {string: {completion_types.Candidate}} = {}
  local documentation: {string: string} = {}
  for index = 1, #exported do
    candidates[exported[index].module_name] = exported[index].candidates
    documentation[exported[index].module_name] = exported[index].documentation
  end
  local projects_by_name: {string: service.ProjectModule} = {}
  for index = 1, #snapshot.project_modules do
    local project = snapshot.project_modules[index]
    projects_by_name[project.module_name] = project
  end
  local externals_by_name: {string: service.ExternalModule} = {}
  for index = 1, #snapshot.external_modules do
    local external = snapshot.external_modules[index]
    externals_by_name[external.module_name] = external
  end
  local descriptors: {completion_store.SavedDescriptor} = {}
  for index = 1, #changed do
    local revision = changed[index]
    local files: {string} = {}
    local imports: {bridge.Import} = {}
    local headers: {bridge.CHeaderDependency} = {}
    local main_file = ""
    local provenance = "project"
    local public_interface = ""
    local source_interface: string? = nil
    local project? = projects_by_name[revision.name]
    if project ~= nil then
      for file_index = 1, #project.source_files do
        files[file_index] = project.source_files[file_index].filename
      end
      if #files > 0 then main_file = files[1] end
      if project.compiler_snapshot ~= nil then
        imports = project.compiler_snapshot.imports
        headers = project.compiler_snapshot.c_header_dependencies
        if project.compiler_snapshot.manifest ~= nil then
          public_interface = project.compiler_snapshot.manifest.serialized
          source_interface = project.compiler_snapshot.manifest.source_serialized
        end
      else
        -- Failed or unchanged body-free projects may have no live snapshot.
        -- Header provenance belongs to the accepted graph revision, not RAM.
        local access = loaded:workspace_store():acquire()
        defer access:release()
        local saved_headers? = header_store.read(access.connection, 0, revision.name)
        if saved_headers ~= nil then headers = saved_headers end
      end
    end
    local external? = externals_by_name[revision.name]
    if external ~= nil then
      imports = external.compiler_imports
      headers = external.c_header_dependencies
      public_interface = external.manifest.public_digest
      source_interface = external.manifest.source_digest
      case external.origin
      when source{source_main_file = main_file; source_files} then
        provenance = "external"
        main_file = source_main_file
        files = source_files
      when dynamic_binary{provider_file} then
        provenance = "dynamic"
        main_file = provider_file
      when static_binary{provider_file} then
        provenance = "static"
        main_file = provider_file
      end
    end
    local members: {completion_types.Candidate} = {}
    local selected_members? = candidates[revision.name]
    if selected_members ~= nil then members = selected_members end
    local descriptor = completion_store.SavedDescriptor {
      module_name = revision.name,
      revision = revision.revision,
      state = revision.state,
      provenance = provenance,
      main_file = main_file,
      public_interface = public_interface,
      source_interface = source_interface,
      source_files = files,
      imports = imports,
      header_inputs = headers,
      candidates = members,
      documentation = documentation[revision.name],
    }
    local unchanged = false
    if provenance ~= "project" and exists then
      local access = loaded:workspace_store():acquire()
      defer access:release()
      unchanged = completion_store.descriptor_matches(access.connection, descriptor)
    end
    if not unchanged then
      if provenance == "external" then
        local payload? = compiler:external_completion_payload(revision.name,
          public_interface, source_interface, main_file, files, headers)
        descriptor = completion_store.SavedDescriptor {
          module_name = revision.name,
          revision = revision.revision,
          state = revision.state,
          provenance = provenance,
          main_file = main_file,
          payload = payload,
          public_interface = public_interface,
          source_interface = source_interface,
          source_files = files,
          imports = imports,
          header_inputs = headers,
          candidates = members,
          documentation = documentation[revision.name],
        }
      end
      descriptors[#descriptors + 1] = descriptor
    end
  end
  local binaries = compiler:completion_binary_catalog(not reusable)
  local access = loaded:workspace_store():acquire()
  defer access:release()
  -- The driver seeds the accepted browser SDK even without a saved import.
  -- Keep its real static provenance; the exact admitted path distinguishes
  -- this implicit standard provider from arbitrary project archives.
  local catalog, catalog_names = completion_catalog(access.connection, snapshot,
    binaries, reusable, compiler:browser_provider_file())
  for index = 1, #catalog do descriptors[#descriptors + 1] = catalog[index] end
  for index = 1, #catalog_names do retained[#retained + 1] = catalog_names[index] end
  return descriptors, retained
end

local function analysis_header_inputs(request: service.AnalysisRequest):
    {bridge.CHeaderDependency}
  local inputs: {bridge.CHeaderDependency} = {}
  local seen: {string: boolean} = {}
  for index = 1, #request.header_fingerprints do
    local dependencies = request.header_fingerprints[index].dependencies
    for dependency_index = 1, #dependencies do
      local input = dependencies[dependency_index]
      local key = input.kind:name() .. "\0" .. input.path .. "\0" .. input.identity
      if not seen[key] then
        seen[key] = true
        inputs[#inputs + 1] = input
      end
    end
    if index < #request.header_fingerprints then async.yield() end
  end
  return inputs
end

-- The Application owns this Task. Joining it never gives a query ownership of
-- cancellation; shutdown explicitly cancels and drains it before Store.close.
record Restoration
  local const work: function (): {string}
  local task: async.Task<|{string}, value|>?
  local consumed: boolean
end

function restoration(work: function (): {string}): Restoration
  return Restoration { work = work, consumed = false }
end

function Restoration:start(on_miss: (function (): ())?)
  if self.task ~= nil then return end
  self.task = async.run<|{string}, value|>(function (): {string}
    -- READY and the completed SQL View are visible before decoding starts.
    async.yield()
    local missing = self.work()
    if #missing > 0 and on_miss ~= nil then on_miss() end
    return missing
  end)
end

function Restoration:finish(loaded: service.Service)
  self:start()
  local missing: {string} = {}
  case async.join(self.task)
  when succeeded(result) then missing = result
  when failed(failure) then raise failure.error
  when cancelled() then
    raise async.CancellationReason.simple("project restoration was cancelled")
  else raise "project restoration did not finish"
  end
  if self.consumed then return end
  -- Only the foreground updater calls finish. Background decoding never
  -- mutates persisted graph state or the published semantic generation.
  for index = 1, #missing do loaded:invalidate_cached_project(missing[index]) end
  self.consumed = true
end

function Restoration:cancel()
  local task? = self.task
  if task ~= nil and not task:status():has_finished() then
    task:cancel(async.CancellationReason.simple("language server application is closing"))
  end
end

function Restoration:close()
  self:cancel()
  local task? = self.task
  if task ~= nil then async.join(task) end
end

local function project_restoration(compiler: bridge.Compiler,
    loaded: service.Service, cache: caches.Cache): Restoration
  -- Snapshot only names/revisions here; BLOB reads belong to the background
  -- task and release their individual Store leases before decoding can yield.
  local candidates = cache:project_candidates()
  return restoration(function (): {string}
    local cpu = logging.clock()
    local wall = ffi.vscode_titan_monotonic_ms()
    logging.emit("debug", "cache.projects.restoration_start", {
      ["candidates"] = #candidates,
    })
    local names: {string} = {}
    local selected: {string: caches.ProjectCandidate} = {}
    for index = 1, #candidates do
      local candidate = candidates[index]
      names[index] = candidate.module_name
      selected[candidate.module_name] = candidate
    end
    local restored: {string: boolean} = {}
    do
      compiler:restore_project_cache(project_inputs(loaded:latest()), names,
        function (name: string): (string?, {bridge.CHeaderDependency}?)
          local payload? = cache:project_payload(selected[name])
          if payload == nil then return nil, nil end
          return payload.payload, payload.header_inputs
        end,
        function (name: string): boolean
          local candidate = selected[name]
          local accepted = loaded:accepts_project_manifest(name, candidate.revision)
          if accepted then restored[name] = true end
          return accepted
        end)
    catch
      if error is async.CancellationReason then raise end
      logging.emit("debug", "cache.projects.restoration_miss", {
        ["message"] = strings.tostring(error),
      })
    end
    local missing: {string} = {}
    for index = 1, #names do
      if not restored[names[index]] then missing[#missing + 1] = names[index] end
    end
    compiler:log_cache_stats()
    phase("project_restoration", cpu, wall)
    return missing
  end)
end

local function load_or_raise(project_root: string,
    progress_listener: bridge.ProgressListener?,
    snapshot_listener: service.SnapshotListener?): (service.Service?, service.Error?, Restoration?)
  local cpu = logging.clock()
  local wall = ffi.vscode_titan_monotonic_ms()
  local compiler: bridge.Compiler?
  do
    compiler = bridge.load()
  catch
    if error is bridge.BridgeError and bridge.analysis_target() == "browser" then
      local failure = error as bridge.BridgeError
      return nil, service.Error(project_root .. "/titan-config.lua", failure.message), nil
    end
    raise
  end
  local installed_root = compiler:installed_binary_modules_root()
  local selected_inventory_directory? = compiler:selected_inventory_directory()
  local settings?, config_error? = config.load(
    project_root, installed_root, selected_inventory_directory)
  if settings == nil then
    return nil, service.Error(config_error.path, config_error.message), nil
  end
  if settings.target ~= bridge.analysis_target() then
    return nil, service.Error(settings.config_file or project_root,
      "analysis target changed; restart this root's language-server worker"), nil
  end
  compiler:configure(bridge.project_configuration(settings))
  local cache = caches.open_for_inventory(settings.project_root)
  local loaded?: service.Service
  local restoring: Restoration? = nil
  local complete = false
  defer do
    if not complete then
      if restoring ~= nil then restoring:close() end
      if loaded ~= nil then loaded:close() else cache.store:close() end
    end
  end
  local inventory = compiler:cache_identity(cache:inventory_identity)
  local current_configuration = settings:semantic_identity()
  local compatibility = inventory .. current_configuration
  cache = cache:validate_inventory(settings.project_root, compatibility)
  phase("inventory", cpu, wall)
  compiler:configure_cache(cache:lookup, cache:stage, cache:refresh_inputs)
  cpu = logging.clock()
  wall = ffi.vscode_titan_monotonic_ms()
  local native_context = compiler:native_cache_identity()
  if not cache:accept_native_context(native_context) then
    cache = cache:rebuild()
    compiler:configure_cache(cache:lookup, cache:stage, cache:refresh_inputs)
    if not cache:accept_native_context(native_context) then
      raise "fresh workspace cache rejected its native context"
    end
  end
  phase("native_context", cpu, wall)
  local analyzer: service.Analyzer = function (
      request: service.AnalysisRequest): bridge.Analysis
    if restoring ~= nil and loaded ~= nil then restoring:finish(loaded) end
    compiler:configure(bridge.project_configuration(request.config))
    return compiler:analyze_incremental(request.project_modules, request.dirty_modules,
      request.cached_sources, progress_listener, analysis_header_inputs(request))
  end
  local resolver: service.ExternalResolver = function (
      current: config.ProjectConfig, projects: {string},
      requests: {bridge.ExternalResolutionRequest}): {bridge.ExternalResolution}
    compiler:configure(bridge.project_configuration(current))
    return compiler:resolve_external_modules(projects, requests)
  end
  local restater: service.HeaderRestater = compiler:restat_c_header_dependencies
  local failure?: service.Error
  cpu = logging.clock()
  wall = ffi.vscode_titan_monotonic_ms()
  loaded, failure = service.create {
    settings = settings,
    installed_binary_modules_root = installed_root,
    analyzer = analyzer,
    external_resolver = resolver,
    header_restater = restater,
    store = cache.store,
    selected_inventory_directory = selected_inventory_directory,
  }
  if loaded == nil then return nil, failure, nil end
  phase("input_validation", cpu, wall)
  local browser = settings.target == "browser"
  if browser then
    local saved_foreign? = cache:browser_foreign_identity()
    if saved_foreign ~= nil then
      local observed? = compiler:observe_browser_foreign()
      if observed ~= saved_foreign then loaded:invalidate_browser_foreign(observed) end
    end
  end
  local unpublished = cache:unpublished_projects()
  for index = 1, #unpublished do loaded:invalidate_cached_project(unpublished[index]) end
  restoring = project_restoration(compiler, loaded, cache)
  local completion_descriptors: {completion_store.SavedDescriptor} = {}
  local completion_modules: {string} = {}
  local completion_configuration = bridge.CompilerConfiguration()
  local completion_include: {string} = {}
  local completion_exclude: {string} = {}
  local completion_inactive: {string} = {}
  loaded:set_publication_hooks(service.PublicationHooks {
    prepare = function (snapshot: service.Snapshot): boolean
      local next_configuration = loaded:semantic_configuration()
      if next_configuration ~= current_configuration then
        compiler:configure(bridge.project_configuration(snapshot.config))
        native_context = compiler:native_cache_identity()
        current_configuration = next_configuration
      end
      local saved_foreign: string?
      if browser then saved_foreign = cache:browser_foreign_identity() end
      cache:stage_context(snapshot.config.project_root,
        inventory .. current_configuration, native_context, saved_foreign)
      local reusable = cache:prepare()
      if not reusable then
        local selected = cache:projects_to_export()
        if #selected > 0 then
          cache:set_projects(compiler:export_projects(project_inputs(snapshot), selected))
        end
      end
      completion_descriptors, completion_modules =
        prepare_completion_descriptors(snapshot, loaded, compiler, reusable)
      completion_configuration = bridge.project_configuration(snapshot.config)
      completion_include = snapshot.config.include
      completion_exclude = snapshot.config.exclude
      local inactive: {string} = {}
      for index = 1, #snapshot.discovery_issues do
        local issue = snapshot.discovery_issues[index]
        case issue.kind
        when inactive_variant() then inactive[#inactive + 1] = issue.path
        when invalid_module() then inactive[#inactive + 1] = issue.path
        else
        end
      end
      completion_inactive = inactive
      return reusable
    end,
    publish = function (connection: sqlite3.Connection)
      cache:publish(connection)
      completion_store.publish_saved(connection, completion_descriptors,
        completion_modules, completion_configuration, completion_include,
        completion_exclude, completion_inactive)
    end,
    committed = function ()
      cache:publication_committed()
      compiler:release_completion_exports()
    end,
  })
  local report?, refresh_error? = loaded:run_pending(snapshot_listener)
  if report == nil then return nil, refresh_error, nil end
  if not cache:can_reuse_publication() then
    restoring:finish(loaded)
    report, refresh_error = loaded:run_pending()
    if report == nil then return nil, refresh_error, nil end
  end
  compiler:log_cache_stats()
  complete = true
  return loaded, nil, restoring
end

function load(project_root: string, progress_listener: bridge.ProgressListener?,
              snapshot_listener: service.SnapshotListener?):
    (service.Service?, service.Error?, Restoration?)
  return load_or_raise(project_root, progress_listener, snapshot_listener)
catch
  if error is async.CancellationReason then raise end
  if error is bridge.BridgeError then
    local failure = error as bridge.BridgeError
    return nil, service.Error(failure.module_name, failure.message), nil
  end
  if error is service.Error then return nil, error as service.Error, nil end
  if error is sqlite3.Error then
    return nil, service.Error(project_root, (error as sqlite3.Error).message), nil
  end
  return nil, service.Error(project_root, strings.tostring(error)), nil
end
