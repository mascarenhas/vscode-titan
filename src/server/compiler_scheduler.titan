--- One cooperative permit serializing access to shared compiler Lua state.
-- @module server.compiler_scheduler

local async = import "async"
local logging = import "server.logging"

-- All compiler bridge instances share one embedded Lua state. Compiler calls
-- temporarily replace process-global driver/type registries, so only one may
-- own that state at a time even when an analysis cooperatively yields.

local record Waiter
  const task: async.Task<|value, value|>
  const resume_token: async.ResumeToken
  queued: boolean
  reserved: boolean
end

--- Exclusive compiler-state lease released exactly once by its owner.
record Permit
  local const owner: Scheduler
  local released: boolean
end

--- Cooperative FIFO ownership of one shared compiler Lua state.
record Scheduler
  local active: boolean
  local waiters: {Waiter}
end

--- Create an independent compiler permit scheduler.
function create(): Scheduler
  return Scheduler(false, {})
end

local function Scheduler:grant_next()
  while #self.waiters > 0 do
    local waiter = self.waiters[1]
    for index = 1, #self.waiters - 1 do
      self.waiters[index] = self.waiters[index + 1]
    end
    self.waiters[#self.waiters] = nil
    if waiter.queued then
      -- Keep queued true until the resumed Task accepts ownership. Its
      -- cancellation action or post-suspend catch can therefore detect a
      -- reserved-but-not-yet-run permit and hand it to the following waiter.
      waiter.reserved = true
      logging.emit("trace", "compiler.scheduler.grant", {
        ["remaining_waiters"] = #self.waiters,
      })
      waiter.task:resume(waiter.resume_token)
      return
    end
  end
  self.active = false
end

local function Scheduler:abandon(waiter: Waiter)
  if not waiter.queued then return end
  waiter.queued = false
  if waiter.reserved then
    -- active represents this reservation already. Transfer it instead of
    -- clearing the scheduler while an older owner is still unwinding.
    self:grant_next()
  end
end

local function Scheduler:release_owner()
  if not self.active then raise "compiler scheduler released without an owner" end
  self:grant_next()
end

--- Wait for exclusive compiler access; defer the returned permit release immediately.
function Scheduler:acquire(): Permit
  if not self.active then
    self.active = true
    logging.emit("trace", "compiler.scheduler.acquire", {
      ["waited"] = false,
      ["queued"] = 0,
    })
    return Permit(self, false)
  end

  local waiter = Waiter(
    async.running(), async.ResumeToken("server.compiler_scheduler"),
    true, false)
  self.waiters[#self.waiters + 1] = waiter
  local started = logging.clock()
  logging.emit("debug", "compiler.scheduler.wait", {
    ["queued"] = #self.waiters,
  })
  local abandon = function () self:abandon(waiter) end
  do
    async.suspend(waiter.resume_token, abandon)
    waiter.queued = false
    logging.emit("debug", "compiler.scheduler.acquire", {
      ["waited"] = true,
      ["wait_cpu_ms"] = logging.elapsed_ms(started),
      ["queued"] = #self.waiters,
    })
    return Permit(self, false)
  catch
    -- Resume delivery closes its zero timer before re-entering this Task, so
    -- cancellation can be injected after the cancellation action was cleared.
    self:abandon(waiter)
    raise
  end
end

--- Release this exact permit and wake the next waiting owner once.
function Permit:release()
  if self.released then return end
  self.released = true
  logging.emit("trace", "compiler.scheduler.release", nil)
  self.owner:release_owner()
end

local shared_scheduler: Scheduler? = nil

--- Acquire the process-wide compiler-state permit.
function acquire(): Permit
  if shared_scheduler == nil then shared_scheduler = create() end
  return shared_scheduler:acquire()
end
