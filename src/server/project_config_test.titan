foreign import "compiler_io_platform.h"
local test_paths = import "server.test_paths"
local fs = import "fs"
local lua = import "lua"
local test = import "test"
local iteration = import "iteration"
local strings = import "string"
local config = import "server.project_config.titan"
local source_text = import "server.source_text"
local test_runtime = import "server.test_runtime"

local type FixtureBody = function (string): ()

local function with_temporary_project(body: FixtureBody)
  local root = test_paths.temporary_name()
  fs.unlink(root)
  fs.mkdir(root)
  defer fs.rmdir(root)
  body(root)
end

local function run_without_config()
  with_temporary_project(function (root: string)
    local loaded?, failure? = config.load(root, test_paths.sdk_binary_root())
    test.assert(failure == nil and loaded ~= nil,
                "missing optional config did not use defaults")
    test.assert(loaded.project_root == root and loaded.config_file == nil,
                "default config did not retain its project identity")
    test.assert(#loaded.include == 1 and
                loaded.include[1] == root .. "/src",
                "include did not default to the project src directory")
    test.assert(#loaded.source_module_roots == 1 and
                loaded.source_module_roots[1] == root .. "/src",
                "source module roots did not default to project src")
    test.assert(#loaded.exclude == 0,
                "exclude did not default to an empty array")
    test.assert(loaded.binary_modules_root == test_paths.sdk_binary_root(),
                "binary root did not default to the library-versioned tree")
    test.assert(#loaded.extra_ffi_include_dirs == 0,
                "include directories did not default to an empty array")
    test.assert(loaded.extra_ffi_cppflags == nil,
                "FFI preprocessing flags did not default to absent")
  end)
end

function test_project_config_defaults_when_root_file_is_absent(
    _context: test.Context)
  test_runtime.run(run_without_config)
end

local function defaults_root_lists_independently()
  with_temporary_project(function (root: string)
    local filename = root .. "/titan-config.lua"
    defer fs.unlink(filename)

    fs.write_file(filename, [[
include = { "./watched" }
]])
    local include_only?, include_failure? =
      config.load(root, test_paths.sdk_binary_root())
    test.assert(include_failure == nil and include_only ~= nil and
                include_only.include[1] == root .. "/watched" and
                #include_only.source_module_roots == 1 and
                include_only.source_module_roots[1] == root .. "/src",
                "source roots inherited the explicitly configured include")

    fs.write_file(filename, [[
source_module_roots = { "./lookup" }
]])
    local source_only?, source_failure? =
      config.load(root, test_paths.sdk_binary_root())
    test.assert(source_failure == nil and source_only ~= nil and
                #source_only.include == 1 and
                source_only.include[1] == root .. "/src" and
                source_only.source_module_roots[1] == root .. "/lookup",
                "include inherited the explicitly configured source roots")
  end)
end

function test_project_config_defaults_root_lists_independently(
    _context: test.Context)
  test_runtime.run(defaults_root_lists_independently)
end

local function run_relative_config()
  with_temporary_project(function (root: string)
    local filename = root .. "/titan-config.lua"
    fs.write_file(filename, [[
include = { "./src", "./tests" }
exclude = { "./examples", "./spec/fixtures" }
source_module_roots = {
  "./src", "./tests", "src/../modules", "./spec/stdlib/titan"
}
binary_modules_root = "./vendor/titan"
extra_ffi_include_dirs = { "./include", "../shared/include" }
extra_ffi_cppflags = "-DPROJECT_FFI=1 '-Ipath with spaces'"
]])
    defer fs.unlink(filename)

    local loaded?, failure? = config.load(root, test_paths.sdk_binary_root())
    test.assert(failure == nil and loaded ~= nil,
                "valid titan-config.lua was rejected")
    test.assert(loaded.config_file == filename,
                "loaded config did not retain its filename")
    test.assert(#loaded.include == 2 and
                loaded.include[1] == root .. "/src" and
                loaded.include[2] == root .. "/tests",
                "relative include paths were not normalized in array order")
    test.assert(#loaded.source_module_roots == 4 and
                loaded.source_module_roots[1] == root .. "/src" and
                loaded.source_module_roots[2] == root .. "/tests" and
                loaded.source_module_roots[3] == root .. "/modules" and
                loaded.source_module_roots[4] ==
                  root .. "/spec/stdlib/titan",
                "source module roots were not normalized in array order")
    test.assert(#loaded.exclude == 2 and
                loaded.exclude[1] == root .. "/examples" and
                loaded.exclude[2] == root .. "/spec/fixtures",
                "relative exclude paths were not normalized in array order")
    test.assert(loaded.binary_modules_root == root .. "/vendor/titan",
                "relative binary root was not resolved from the config file")
    local shared_include?, shared_failure? =
      source_text.resolve_path(root, "../shared/include")
    test.assert(shared_failure == nil and shared_include ~= nil,
                "test fixture could not resolve its expected include path")
    test.assert(#loaded.extra_ffi_include_dirs == 2 and
                loaded.extra_ffi_include_dirs[1] == root .. "/include" and
                loaded.extra_ffi_include_dirs[2] == shared_include,
                "FFI include directories were not normalized in array order")
    test.assert(loaded.extra_ffi_cppflags ==
                  "-DPROJECT_FFI=1 '-Ipath with spaces'",
                "FFI preprocessing flags did not preserve shell-word syntax")
  end)
end

function test_project_config_normalizes_typed_relative_paths(
    _context: test.Context)
  test_runtime.run(run_relative_config)
end

local function assert_config_error(root: string, source: string,
                                   expected: string)
  local filename = root .. "/titan-config.lua"
  fs.write_file(filename, source)
  local loaded?, failure? = config.load(root, test_paths.sdk_binary_root())
  test.assert(loaded == nil and failure ~= nil,
              "malformed project configuration was accepted")
  test.assert(failure.path == filename and
              strings.find(failure.message, expected) ~= nil,
              "project configuration error was not actionable")
end

local function run_invalid_configs()
  with_temporary_project(function (root: string)
    local filename = root .. "/titan-config.lua"
    defer fs.unlink(filename)

    assert_config_error(root, "return 42\n", "return no value")
    assert_config_error(root,
      "return { include = { './legacy' } }\n",
      "use global assignments")
    assert_config_error(root,
      "include = false\n",
      "include must be a Lua array table")
    assert_config_error(root,
      "include = { [2] = './two' }\n",
      "include must be a dense Lua array")
    assert_config_error(root,
      "exclude = { './one', 2 }\n",
      "exclude entries must be strings")
    assert_config_error(root,
      "source_module_roots = false\n",
      "source_module_roots must be a Lua array table")
    assert_config_error(root,
      "source_module_roots = { [2] = './two' }\n",
      "source_module_roots must be a dense Lua array")
    assert_config_error(root,
      "source_module_roots = { './one;./two' }\n",
      "source_module_roots[1] must not contain ';'")
    assert_config_error(root,
      "extra_ffi_include_dirs = { [2] = './two' }\n",
      "dense Lua array")
    assert_config_error(root,
      "extra_ffi_include_dirs = { './one', 2 }\n",
      "entries must be strings")
    assert_config_error(root,
      "extra_ffi_cppflags = { '-DNOT_A_STRING=1' }\n",
      "extra_ffi_cppflags must be a string")
    assert_config_error(root,
      "source_modules_root = './legacy'\n",
      "unknown titan-config.lua field")
    assert_config_error(root,
      "_ENV[1] = './not-a-name'\n",
      "global names must be strings")
    assert_config_error(root,
      "print('must never reach LSP stdout')\n",
      "cannot evaluate")
    assert_config_error(root,
      "io.write('must never reach LSP stdout')\n",
      "cannot evaluate")
    assert_config_error(root, "include = {\n", "cannot evaluate")
  end)
end

function test_project_config_rejects_untyped_sparse_or_invalid_values(
    _context: test.Context)
  test_runtime.run(run_invalid_configs)
end

local function rejects_semicolon_after_relative_resolution()
  local reservation = test_paths.temporary_name()
  fs.unlink(reservation)
  local root = reservation .. ";project"
  fs.mkdir(root)
  defer fs.rmdir(root)

  local loaded?, failure? = config.load(root, test_paths.sdk_binary_root())
  test.assert(loaded == nil and failure ~= nil and
              failure.path == root .. "/titan-config.lua" and
              strings.find(
                failure.message,
                "source_module_roots[1] must not contain ';'") ~= nil,
              "semicolon introduced by project-root resolution was accepted")
end

function test_project_config_rejects_ambiguous_normalized_source_path(
    _context: test.Context)
  test_runtime.run(rejects_semicolon_after_relative_resolution)
end

local function permits_semicolon_in_watcher_include_root()
  local reservation = test_paths.temporary_name()
  fs.unlink(reservation)
  local root = reservation .. ";project"
  fs.mkdir(root)
  defer fs.rmdir(root)
  local filename = root .. "/titan-config.lua"
  fs.write_file(filename,
    "include = { \"./watched\" }\n" ..
    "source_module_roots = { \"" .. test_paths.compiler_source_root() .. "\" }\n")
  defer fs.unlink(filename)

  local loaded?, failure? = config.load(root, test_paths.sdk_binary_root())
  test.assert(failure == nil and loaded ~= nil and
              loaded.include[1] == root .. "/watched" and
              #loaded.source_module_roots == 1 and
              loaded.source_module_roots[1] == test_paths.compiler_source_root(),
              "watcher include was incorrectly parsed as compiler source path")
end

function test_project_config_allows_semicolon_outside_source_module_roots(
    _context: test.Context)
  test_runtime.run(permits_semicolon_in_watcher_include_root)
end

function test_project_config_native_windows_absolute_roots(context: test.Context)
  if ffi.VSCODE_TITAN_WINDOWS == 0 then test.skip("native Windows configuration") end
  context:run("drive_root", function(_child: test.Context)
    test.assert(config.absolute_project_root("c:\\") == "C:/",
                "configured drive root changed its established identity")
    test.assert(config.configuration_path("C:/") == "C:/titan-config.lua",
                "drive-root config lookup acquired a repeated separator")
  end)
  context:run("unc_root", function(_child: test.Context)
    test.assert(config.absolute_project_root("\\\\server\\share\\") == "//server/share",
                "configured UNC root changed its established identity")
    test.assert(config.configuration_path("//server/share") == "//server/share/titan-config.lua",
                "UNC config lookup lost its share root")
  end)
end

function test_project_config_observes_provider_alias_without_changing_its_path(_: test.Context)
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then
    test.skip("native Windows alias traversal is covered by the elevated SDK transcript")
  end
  test_runtime.run(function ()
    with_temporary_project(function (temporary: string)
      local root = test_paths.canonical_path(temporary)
      local sdk = root .. "/sdk"
      local empty = root .. "/empty"
      local alias = root .. "/providers"
      local filename = root .. "/titan-config.lua"
      fs.mkdir(sdk)
      defer fs.rmdir(sdk)
      fs.mkdir(empty)
      defer fs.rmdir(empty)
      fs.write_file(filename, 'binary_modules_root = "./providers"\n')
      defer fs.unlink(filename)
      local link = lua.load([[
        return function(source, alias) assert(require("lfs").link(source, alias, true)) end
      ]], "=provider-alias-fixture", nil)() as function (string, string): ()
      local selection = function (expected: boolean): string
        local settings?, failure? = config.load(root, sdk, sdk)
        test.assert(settings ~= nil and failure == nil, "could not load the aliased provider configuration")
        test.assert(settings.binary_modules_root == alias)
        test.assert(settings.use_selected_inventory == expected)
        local identity = settings:semantic_identity()
        test.assert(settings:copy():semantic_identity() == identity)
        return identity
      end
      local missing = selection(false)
      link(sdk, alias)
      defer do
        if fs.lstat(alias) ~= nil then fs.unlink(alias) end
      end
      local selected = selection(true)
      test.assert(missing ~= selected)
      fs.unlink(alias)
      link(empty, alias)
      test.assert(selection(false) == missing)
      fs.unlink(alias)
      link(sdk, alias)
      test.assert(selection(true) == selected)
      fs.unlink(alias)
      test.assert(selection(false) == missing)
    end)
  end)
end

function test_project_config_accepts_one_tracked_analysis_target(
    _context: test.Context)
  test_runtime.run(function ()
    with_temporary_project(function (root: string)
      local tracked = root .. "/titan-config.lua"
      local overrides = root .. "/titan-config.local.lua"
      fs.write_file(tracked, "")
      defer fs.unlink(tracked)
      local default = config.load(root, test_paths.sdk_binary_root())
      fs.write_file(tracked, 'target = "native"\n')
      local native = config.load(root, test_paths.sdk_binary_root())
      test.assert(native.target == nil and
        native:semantic_identity() == default:semantic_identity())

      fs.write_file(tracked, 'target = "browser"\n')
      local browser = config.load(root, test_paths.sdk_binary_root())
      test.assert(browser.target == "browser" and browser:copy().target == "browser" and
        browser:semantic_identity() ~= default:semantic_identity())
      local selected = config.load_compiler_root(root)
      test.assert(selected.target == "browser")

      fs.write_file(overrides, 'target = "native"\n')
      defer fs.unlink(overrides)
      local refused?, problem? = config.load_compiler_root(root)
      test.assert(refused == nil and problem.path == overrides)
      fs.write_file(overrides, "")
      for _, bad in iteration.ipairs({'""', '"linux"', "false", "{}"}) do
        fs.write_file(tracked, "target = " .. bad .. "\n")
        local rejected?, failure? = config.load_compiler_root(root)
        test.assert(rejected == nil and failure.path == tracked and failure.target_selection)
      end
    end)
  end)
end
