local test = import "test"
local strings = import "string"
local docs = import "server.documentation"

function test_documentation_formats_prose_tags_and_relative_manual_links(_context: test.Context)
  local document = docs.Documentation("Split a byte string.", "Empty fields are preserved.", {
    docs.Tag("module", "titan.string"),
    docs.Tag("param", "subject Bytes to split."),
    docs.Tag("return", "A nil-terminated iterator."),
    docs.Tag("return", "Empty strings are real values."),
    docs.Tag("usage", "standard-library-string.md#compiled-regular-expressions"),
    docs.Tag("warning", "The delimiter is a regex."),
  })
  local rendered = document:markdown()
  test.assert(strings.find(rendered, "Split a byte string.\n\nEmpty fields are preserved.") ~= nil)
  test.assert(strings.find(rendered, "`subject` — Bytes to split.") ~= nil)
  test.assert(strings.find(rendered, "**Returns:** A nil-terminated iterator.") ~= nil)
  test.assert(strings.find(rendered, "**Returns:** Empty strings are real values.") ~= nil)
  test.assert(strings.find(rendered, "https://github.com/mascarenhas/titan/blob/master/doc/language/standard-library-string.md#compiled-regular-expressions") ~= nil)
  test.assert(strings.find(rendered, "**warning:** The delimiter is a regex.") ~= nil)
  test.assert(strings.find(rendered, "titan.string") == nil)
end

function test_documentation_retains_literal_usage_and_absent_description(_context: test.Context)
  local document = docs.Documentation("Read chunks.", "", {
    docs.Tag("usage", "reader:read()"), docs.Tag("see", "standard-library-io.md"),
  })
  local rendered = document:markdown()
  test.assert(strings.find(rendered, "```titan\nreader:read()\n```") ~= nil)
  test.assert(strings.find(rendered, "[See also](https://github.com/mascarenhas/titan/blob/master/doc/language/standard-library-io.md)") ~= nil)
end

function test_documentation_formats_typed_and_optional_parameters(_context: test.Context)
  local document = docs.Documentation("Read bytes.", "", {
    docs.Tag("param", "[opt] count Maximum bytes."),
    docs.Tag("tparam", "string path Filename."),
    docs.Tag("tfield", "integer size Byte count."),
  })
  local rendered = document:markdown()
  test.assert(strings.find(rendered, "`count` (opt) — Maximum bytes.") ~= nil)
  test.assert(strings.find(rendered, "`path` (`string`) — Filename.") ~= nil)
  test.assert(strings.find(rendered, "`size` (`integer`) — Byte count.") ~= nil)
end
