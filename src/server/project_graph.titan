local iteration = import "iteration"
local sqlite3 = import "sqlite3"
local sql = import "server.workspace_store"

-- The graph is deliberately independent from filesystem and compiler APIs.
-- Callers normalize those boundaries, then provide immutable stamps, manifests,
-- imports, and a typed annotated-AST value.

record FileStamp
  const path: string
  const modified_seconds: integer
  const modified_nanoseconds: integer
  const size: integer
  const identity: string?
end

record Manifest
  -- Public imports depend only on public_digest. source_digest represents the
  -- complete source-collaboration surface, including the public surface.
  const public_digest: string
  const source_digest: string
end

union Provenance
  project
  external_source
  external_binary
end

union ImportVisibility
  ordinary
  source_required
end

record ImportEdge
  const module_name: string
  const visibility: ImportVisibility
end

record ReverseImport
  const importer: string
  const visibility: ImportVisibility
end

record CheckToken
  const module_name: string
  const generation: integer
  const revision: integer
end

record ChangeReport
  const changed: boolean
  const generation: integer
  const invalidated: {string}
end

record CommitAccepted
  const invalidated: {string}
end

union CommitResult
  accepted: CommitAccepted
  stale
end


-- Metadata has one owner: main. Only live project compiler values remain in
-- memory. This adapter borrows its caller's complete-operation connection lease
-- and never begins/ends a transaction or closes the connection.
record AstSnapshot<A>
  local const asts: {string: A}
end

record Graph<A>
  const connection: sqlite3.Connection
  local asts: {string: A}
end

local record Module
  provenance: integer
  state: integer
  recovering: boolean
  revision: integer
  manifest: Manifest?
end

local function copy_stamps(stamps: {FileStamp}): {FileStamp}
  local result: {FileStamp} = {}
  for index = 1, #stamps do
    local stamp = stamps[index]
    local position = #result + 1
    while position > 1 and stamp.path < result[position - 1].path do
      result[position] = result[position - 1]
      position = position - 1
    end
    result[position] = stamp
  end
  return result
end

local function source_required(visibility: ImportVisibility): boolean
  case visibility
  when ordinary then return false
  when source_required then return true
  end
end

local function visibility_rank(visibility: ImportVisibility): integer
  if source_required(visibility) then return 1 end
  return 0
end

local function same_visibility(left: ImportVisibility,
                               right: ImportVisibility): boolean
  return source_required(left) == source_required(right)
end

local function copy_visibility(
    visibility: ImportVisibility): ImportVisibility
  if source_required(visibility) then
    return ImportVisibility.source_required()
  end
  return ImportVisibility.ordinary()
end

local function edge_less(left: ImportEdge, right: ImportEdge): boolean
  if left.module_name ~= right.module_name then
    return left.module_name < right.module_name
  end
  return visibility_rank(left.visibility) < visibility_rank(right.visibility)
end

local function same_edge(left: ImportEdge, right: ImportEdge): boolean
  return left.module_name == right.module_name and
         same_visibility(left.visibility, right.visibility)
end

local function normalize_imports(imports: {ImportEdge}): {ImportEdge}
  local result: {ImportEdge} = {}
  for index = 1, #imports do
    local source = imports[index]
    local edge = ImportEdge.new(
      source.module_name, copy_visibility(source.visibility))
    local duplicate = false
    local position = #result + 1
    for current = 1, #result do
      if same_edge(result[current], edge) then
        duplicate = true
        break
      end
      if edge_less(edge, result[current]) then
        position = current
        break
      end
    end
    if not duplicate then
      for current = #result, position, -1 do
        result[current + 1] = result[current]
      end
      result[position] = edge
    end
  end
  return result
end

local function same_stamps(left: {FileStamp}, right: {FileStamp}): boolean
  if #left ~= #right then return false end
  for index = 1, #left do
    local a = left[index]
    local b = right[index]
    if a.path ~= b.path or
       a.modified_seconds ~= b.modified_seconds or
       a.modified_nanoseconds ~= b.modified_nanoseconds or
       a.size ~= b.size or a.identity ~= b.identity then
      return false
    end
  end
  return true
end

local function same_manifest(left: Manifest, right: Manifest): boolean
  return left.public_digest == right.public_digest and
         left.source_digest == right.source_digest
end

local function same_imports(left: {ImportEdge}, right: {ImportEdge}): boolean
  if #left ~= #right then return false end
  for index = 1, #left do
    if not same_edge(left[index], right[index]) then return false end
  end
  return true
end

local function add_sorted_name(names: {string}, module_name: string)
  for index = 1, #names do
    if names[index] == module_name then return end
    if module_name < names[index] then
      for following = #names, index, -1 do
        names[following + 1] = names[following]
      end
      names[index] = module_name
      return
    end
  end
  names[#names + 1] = module_name
end

local function name_set(names: {string}): {string: boolean}
  local result: {string: boolean} = {}
  for index = 1, #names do result[names[index]] = true end
  return result
end

function initialize_schema(connection: sqlite3.Connection)
  sql.execute(connection, "CREATE TABLE IF NOT EXISTS main.graph_state (" ..
    "singleton INTEGER PRIMARY KEY CHECK(singleton=1), generation INTEGER NOT NULL, " ..
    "work_revision INTEGER NOT NULL)")
  sql.execute(connection, "INSERT OR IGNORE INTO main.graph_state VALUES(1,0,0)")
  sql.execute(connection, "CREATE TABLE IF NOT EXISTS main.graph_modules (" ..
    "name TEXT PRIMARY KEY COLLATE BINARY, provenance INTEGER NOT NULL, " ..
    "state INTEGER NOT NULL, recovering INTEGER NOT NULL, revision INTEGER NOT NULL, " ..
    "public_digest BLOB, source_digest BLOB, " ..
    "CHECK(provenance BETWEEN 0 AND 2), CHECK(state BETWEEN 0 AND 3), " ..
    "CHECK((public_digest IS NULL)=(source_digest IS NULL))) WITHOUT ROWID")
  sql.execute(connection, "CREATE TABLE IF NOT EXISTS main.graph_files (" ..
    "module_name TEXT NOT NULL REFERENCES graph_modules(name) ON DELETE CASCADE, " ..
    "path TEXT NOT NULL COLLATE BINARY, seconds INTEGER NOT NULL, " ..
    "nanoseconds INTEGER NOT NULL, size INTEGER NOT NULL, identity BLOB, " ..
    "PRIMARY KEY(module_name,path)) WITHOUT ROWID")
  -- imported deliberately has no foreign key: incoming edges to a missing
  -- provider must survive its removal and wake importers when it reappears.
  sql.execute(connection, "CREATE TABLE IF NOT EXISTS main.graph_imports (" ..
    "importer TEXT NOT NULL REFERENCES graph_modules(name) ON DELETE CASCADE, " ..
    "imported TEXT NOT NULL COLLATE BINARY, visibility INTEGER NOT NULL, " ..
    "PRIMARY KEY(importer,imported,visibility), " ..
    "CHECK(visibility IN (0,1))) WITHOUT ROWID")
  sql.execute(connection, "CREATE INDEX IF NOT EXISTS main.graph_reverse " ..
    "ON graph_imports(imported,importer,visibility)")
  sql.execute(connection, "CREATE INDEX IF NOT EXISTS main.graph_project_work " ..
    "ON graph_modules(provenance,state,name)")
end

function create<A>(connection: sqlite3.Connection): Graph<A>
  initialize_schema(connection)
  return Graph<A>.new(connection, {})
end

function Graph:checkpoint_asts(): AstSnapshot<A>
  local copy: {string: A} = {}
  for name, ast in iteration.pairs<string, A>(self.asts) do copy[name] = ast end
  return AstSnapshot<A>.new(copy)
end

function Graph:restore_asts(snapshot: AstSnapshot<A>)
  self.asts = snapshot.asts
end

local function Graph:module(module_name: string): Module?
  local statement = self.connection:prepare(
    "SELECT provenance,state,recovering,revision,public_digest,source_digest " ..
    "FROM main.graph_modules WHERE name=?")
  defer statement:close()
  local cursor = statement:query(module_name)
  defer cursor:close()
  local row? = cursor:fetch()
  if row == nil then return nil end
  local public_digest: sqlite3.Blob? = row:get(5)
  local source_digest: sqlite3.Blob? = row:get(6)
  local output: Manifest?
  if public_digest ~= nil and source_digest ~= nil then
    output = Manifest.new(public_digest.bytes, source_digest.bytes)
  end
  local recovering: integer = row:get(3)
  return Module.new(row:get(1), row:get(2), recovering ~= 0, row:get(4), output)
end

local function Graph:names(query: string, ...: value): {string}
  local statement = self.connection:prepare(query)
  defer statement:close()
  local cursor = statement:query(...)
  defer cursor:close()
  local names: {string} = {}
  for row in cursor:fetch do names[#names + 1] = row:get(1) end
  return names
end

function Graph:generation(): integer
  return sql.scalar_integer(self.connection,
    "SELECT generation FROM main.graph_state WHERE singleton=1")
end

local function Graph:advance_generation()
  sql.execute(self.connection,
    "UPDATE main.graph_state SET generation=generation+1 WHERE singleton=1")
  -- Old tokens become stale; in-flight work immediately becomes retryable.
  sql.execute(self.connection,
    "UPDATE main.graph_modules SET state=0 WHERE provenance=0 AND state=1")
end

-- Work identity must survive removal and recreation of every module. A
-- per-module counter can repeat while an older completed payload still exists.
-- Allocate from the same transaction as the graph mutation so rollback restores
-- both the input state and its allocator together.
local function Graph:next_revision(): integer
  sql.execute(self.connection,
    "UPDATE main.graph_state SET work_revision=work_revision+1 WHERE singleton=1")
  return sql.scalar_integer(self.connection,
    "SELECT work_revision FROM main.graph_state WHERE singleton=1")
end

local function Graph:dirty_project(module_name: string): boolean
  local revision = self:next_revision()
  return sql.execute(self.connection,
    "UPDATE main.graph_modules SET state=0,revision=? " ..
    "WHERE name=? AND provenance=0", revision, module_name) ~= 0
end

local function Graph:set_stamps(module_name: string, stamps: {FileStamp})
  sql.execute(self.connection,
    "DELETE FROM main.graph_files WHERE module_name=?", module_name)
  local first = 1
  while first <= #stamps do
    -- At most 192 parameters, below Titan's 200-position call bound.
    local last = first + 31
    if last > #stamps then last = #stamps end
    local query = "INSERT INTO main.graph_files VALUES "
    local bindings: {value} = {}
    for index = first, last do
      if index > first then query = query .. "," end
      local stamp = stamps[index]
      local offset = #bindings
      bindings[offset + 1] = module_name
      bindings[offset + 2] = stamp.path
      bindings[offset + 3] = stamp.modified_seconds
      bindings[offset + 4] = stamp.modified_nanoseconds
      bindings[offset + 5] = stamp.size
      if stamp.identity ~= nil then
        query = query .. "(?,?,?,?,?,?)"
        bindings[offset + 6] = sqlite3.Blob.new(stamp.identity)
      else
        -- Array nil assignment removes a slot, so NULL is SQL syntax while
        -- every present value remains a bound parameter.
        query = query .. "(?,?,?,?,?,NULL)"
      end
    end
    sql.execute(self.connection, query, ...bindings)
    first = last + 1
  end
end

local function Graph:set_imports(module_name: string, imports: {ImportEdge})
  sql.execute(self.connection,
    "DELETE FROM main.graph_imports WHERE importer=?", module_name)
  local first = 1
  while first <= #imports do
    local last = first + 49
    if last > #imports then last = #imports end
    local query = "INSERT OR IGNORE INTO main.graph_imports VALUES "
    local bindings: {value} = {}
    for index = first, last do
      if index > first then query = query .. "," end
      query = query .. "(?,?,?)"
      local edge = imports[index]
      bindings[#bindings + 1] = module_name
      bindings[#bindings + 1] = edge.module_name
      bindings[#bindings + 1] = visibility_rank(edge.visibility)
    end
    sql.execute(self.connection, query, ...bindings)
    first = last + 1
  end
end

-- The recursive relation crosses metadata-only external nodes and stops at
-- project roots. UNION eliminates cycles and duplicate paths in SQLite.
local const reverse_walk =
  "WITH RECURSIVE affected(name) AS (" ..
  "SELECT importer FROM main.graph_imports WHERE imported=? AND " ..
  "(?<>0 OR (?<>0 AND visibility=1)) UNION " ..
  "SELECT edge.importer FROM affected AS previous " ..
  "JOIN main.graph_modules AS provider ON provider.name=previous.name " ..
  "JOIN main.graph_imports AS edge ON edge.imported=previous.name " ..
  "WHERE provider.provenance<>0) "

local function Graph:invalidate_importers(module_name: string,
    old_manifest: Manifest?, new_manifest: Manifest?, force: boolean,
    satisfied: {string: boolean}): {string}
  local public_changed = force or new_manifest == nil or old_manifest == nil
  local source_changed = public_changed
  if not public_changed and old_manifest ~= nil and new_manifest ~= nil then
    public_changed = old_manifest.public_digest ~= new_manifest.public_digest
    source_changed = old_manifest.source_digest ~= new_manifest.source_digest
  end
  local public_flag = 0
  local source_flag = 0
  if public_changed then public_flag = 1 end
  if source_changed then source_flag = 1 end
  local names = self:names(reverse_walk ..
    "SELECT module.name FROM affected JOIN main.graph_modules AS module " ..
    "ON module.name=affected.name WHERE module.provenance=0 " ..
    "ORDER BY module.name COLLATE BINARY", module_name, public_flag, source_flag)
  local invalidated: {string} = {}
  for index = 1, #names do
    local name = names[index]
    if not satisfied[name] and self:dirty_project(name) then
      invalidated[#invalidated + 1] = name
    end
  end
  return invalidated
end

local function Graph:invalidate_failed_importers(module_name: string,
    already_invalidated: {string: boolean}): {string}
  local names = self:names(reverse_walk ..
    "SELECT module.name FROM affected JOIN main.graph_modules AS module " ..
    "ON module.name=affected.name WHERE module.provenance=0 AND module.state=3 " ..
    "ORDER BY module.name COLLATE BINARY", module_name, 1, 1)
  local invalidated: {string} = {}
  for index = 1, #names do
    local name = names[index]
    if not already_invalidated[name] and self:dirty_project(name) then
      invalidated[#invalidated + 1] = name
    end
  end
  return invalidated
end

function Graph:module_names(): {string}
  return self:names("SELECT name FROM main.graph_modules ORDER BY name COLLATE BINARY")
end

function Graph:has_module(module_name: string): boolean
  return sql.scalar_integer(self.connection,
    "SELECT count(*) FROM main.graph_modules WHERE name=?", module_name) ~= 0
end

function Graph:provenance(module_name: string): Provenance?
  local entry? = self:module(module_name)
  if entry == nil then return nil end
  if entry.provenance == 0 then return Provenance.project() end
  if entry.provenance == 1 then return Provenance.external_source() end
  return Provenance.external_binary()
end

function Graph:file_stamps(module_name: string): {FileStamp}
  local statement = self.connection:prepare(
    "SELECT path,seconds,nanoseconds,size,identity FROM main.graph_files " ..
    "WHERE module_name=? ORDER BY path COLLATE BINARY")
  defer statement:close()
  local cursor = statement:query(module_name)
  defer cursor:close()
  local result: {FileStamp} = {}
  for row in cursor:fetch do
    local identity_blob: sqlite3.Blob? = row:get(5)
    local identity: string?
    if identity_blob ~= nil then identity = identity_blob.bytes end
    result[#result + 1] = FileStamp.new(row:get(1), row:get(2), row:get(3), row:get(4), identity)
  end
  return result
end

function Graph:manifest(module_name: string): Manifest?
  local entry? = self:module(module_name)
  if entry == nil then return nil end
  return entry.manifest
end

function Graph:direct_imports(module_name: string): {ImportEdge}
  local statement = self.connection:prepare(
    "SELECT imported,visibility FROM main.graph_imports WHERE importer=? " ..
    "ORDER BY imported COLLATE BINARY,visibility")
  defer statement:close()
  local cursor = statement:query(module_name)
  defer cursor:close()
  local result: {ImportEdge} = {}
  for row in cursor:fetch do
    local visibility: integer = row:get(2)
    local access = ImportVisibility.ordinary()
    if visibility == 1 then access = ImportVisibility.source_required() end
    result[#result + 1] = ImportEdge.new(row:get(1), access)
  end
  return result
end

function Graph:reverse_imports(module_name: string): {ReverseImport}
  local statement = self.connection:prepare(
    "SELECT importer,visibility FROM main.graph_imports WHERE imported=? " ..
    "ORDER BY importer COLLATE BINARY,visibility")
  defer statement:close()
  local cursor = statement:query(module_name)
  defer cursor:close()
  local result: {ReverseImport} = {}
  for row in cursor:fetch do
    local visibility: integer = row:get(2)
    local access = ImportVisibility.ordinary()
    if visibility == 1 then access = ImportVisibility.source_required() end
    result[#result + 1] = ReverseImport.new(row:get(1), access)
  end
  return result
end

function Graph:is_dirty(module_name: string): boolean
  return sql.scalar_integer(self.connection,
    "SELECT count(*) FROM main.graph_modules WHERE name=? AND provenance=0 AND state=0",
    module_name) ~= 0
end

function Graph:is_failed(module_name: string): boolean
  return sql.scalar_integer(self.connection,
    "SELECT count(*) FROM main.graph_modules WHERE name=? AND provenance=0 AND state=3",
    module_name) ~= 0
end

function Graph:dirty_modules(): {string}
  return self:names("SELECT name FROM main.graph_modules " ..
    "WHERE provenance=0 AND state=0 ORDER BY name COLLATE BINARY")
end

function Graph:project_ast(module_name: string): A?
  if sql.scalar_integer(self.connection,
    "SELECT count(*) FROM main.graph_modules WHERE name=? AND provenance=0 AND state=2",
    module_name) == 0 then return nil end
  return self.asts[module_name]
end

-- Diagnostic/state snapshots preserve the last project compiler handle while
-- work is dirty and may retain an authoritative failed compiler result. This
-- is separate from project_ast's clean-only language-feature contract.
function Graph:project_snapshot(module_name: string): A?
  if sql.scalar_integer(self.connection,
    "SELECT count(*) FROM main.graph_modules WHERE name=? AND provenance=0",
    module_name) == 0 then return nil end
  return self.asts[module_name]
end

function Graph:set_project_snapshot(module_name: string, ast: A?): boolean
  if sql.scalar_integer(self.connection,
    "SELECT count(*) FROM main.graph_modules WHERE name=? AND provenance=0",
    module_name) == 0 then return false end
  self.asts[module_name] = ast
  return true
end

-- The caller has validated and decoded this persisted project payload. A
-- restored compiler handle does not perform work or change published metadata.
function Graph:hydrate_project_ast(module_name: string, ast: A): boolean
  if sql.scalar_integer(self.connection,
    "SELECT count(*) FROM main.graph_modules WHERE name=? AND provenance=0 AND state=2",
    module_name) == 0 then return false end
  self.asts[module_name] = ast
  return true
end

-- A prior process cannot finish in-flight work. Preserve completed and failed
-- revisions; only interrupted checks become available for a fresh attempt.
function Graph:restart_interrupted_checks()
  sql.execute(self.connection,
    "UPDATE main.graph_modules SET state=0 WHERE provenance=0 AND state=1")
end

function Graph:observe_project(module_name: string,
    stamps: {FileStamp}): ChangeReport
  local normalized = copy_stamps(stamps)
  local existing? = self:module(module_name)
  if existing ~= nil and existing.provenance == 0 then
    if same_stamps(self:file_stamps(module_name), normalized) then
      return ChangeReport.new(false, self:generation(), {})
    end
    self:advance_generation()
    self:set_stamps(module_name, normalized)
    self:dirty_project(module_name)
    return ChangeReport.new(true, self:generation(), {})
  end
  self:advance_generation()
  sql.execute(self.connection, "DELETE FROM main.graph_modules WHERE name=?", module_name)
  sql.execute(self.connection,
    "INSERT INTO main.graph_modules VALUES(?,0,0,0,?,NULL,NULL)",
    module_name, self:next_revision())
  self.asts[module_name] = nil
  self:set_stamps(module_name, normalized)
  local invalidated = self:invalidate_importers(module_name, nil, nil, true, {})
  return ChangeReport.new(true, self:generation(), invalidated)
end

function Graph:invalidate_project(module_name: string): ChangeReport
  local entry? = self:module(module_name)
  if entry == nil or entry.provenance ~= 0 then
    return ChangeReport.new(false, self:generation(), {})
  end
  self:advance_generation()
  self:dirty_project(module_name)
  return ChangeReport.new(true, self:generation(), {})
end

function Graph:begin_project_check(module_name: string): CheckToken?
  if sql.execute(self.connection,
    "UPDATE main.graph_modules SET state=1 WHERE name=? AND provenance=0 AND state=0",
    module_name) == 0 then return nil end
  local entry? = self:module(module_name)
  if entry == nil then raise "project disappeared while holding store access" end
  return CheckToken.new(module_name, self:generation(), entry.revision)
end

local function Graph:accepts(token: CheckToken): Module?
  if token.generation ~= self:generation() then return nil end
  local entry? = self:module(token.module_name)
  if entry == nil or entry.provenance ~= 0 or entry.state ~= 1 or
     entry.revision ~= token.revision then return nil end
  return entry
end

function Graph:abort_project_check(token: CheckToken): boolean
  if self:accepts(token) == nil then return false end
  sql.execute(self.connection,
    "UPDATE main.graph_modules SET state=0 WHERE name=?", token.module_name)
  return true
end

function Graph:fail_project_check(token: CheckToken,
    imports: {ImportEdge}): boolean
  if self:accepts(token) == nil then return false end
  self:set_imports(token.module_name, imports)
  sql.execute(self.connection,
    "UPDATE main.graph_modules SET state=3,recovering=1 WHERE name=?", token.module_name)
  self.asts[token.module_name] = nil
  return true
end

function Graph:commit_project(token: CheckToken, manifest: Manifest,
    imports: {ImportEdge}, ast: A): CommitResult
  local entry? = self:accepts(token)
  if entry == nil then return CommitResult.stale() end
  self:set_imports(token.module_name, imports)
  sql.execute(self.connection,
    "UPDATE main.graph_modules SET state=2,recovering=0,public_digest=?,source_digest=? " ..
    "WHERE name=?", sqlite3.Blob.new(manifest.public_digest),
    sqlite3.Blob.new(manifest.source_digest), token.module_name)
  self.asts[token.module_name] = ast
  local invalidated = self:invalidate_importers(
    token.module_name, entry.manifest, manifest, false, {})
  if entry.recovering then
    local recovery = self:invalidate_failed_importers(token.module_name, name_set(invalidated))
    for index = 1, #recovery do add_sorted_name(invalidated, recovery[index]) end
  end
  return CommitResult.accepted(CommitAccepted.new(invalidated))
end

local function Graph:upsert_external(module_name: string, provenance: integer,
    stamps: {FileStamp}, manifest: Manifest, imports: {ImportEdge},
    advance: boolean, satisfied: {string: boolean}): ChangeReport
  local normalized_stamps = copy_stamps(stamps)
  local normalized_imports = normalize_imports(imports)
  local existing? = self:module(module_name)
  local old_manifest: Manifest?
  local force = existing == nil
  if existing ~= nil then
    old_manifest = existing.manifest
    force = existing.provenance ~= provenance
    if not force and same_stamps(self:file_stamps(module_name), normalized_stamps) and
       old_manifest ~= nil and same_manifest(old_manifest, manifest) and
       same_imports(self:direct_imports(module_name), normalized_imports) then
      return ChangeReport.new(false, self:generation(), {})
    end
  end
  if advance then self:advance_generation() end
  sql.execute(self.connection, "DELETE FROM main.graph_modules WHERE name=?", module_name)
  sql.execute(self.connection,
    "INSERT INTO main.graph_modules VALUES(?,?,2,0,0,?,?)", module_name, provenance,
    sqlite3.Blob.new(manifest.public_digest), sqlite3.Blob.new(manifest.source_digest))
  self.asts[module_name] = nil
  self:set_stamps(module_name, normalized_stamps)
  self:set_imports(module_name, normalized_imports)
  local invalidated = self:invalidate_importers(
    module_name, old_manifest, manifest, force, satisfied)
  return ChangeReport.new(true, self:generation(), invalidated)
end

function Graph:upsert_external_source(module_name: string, stamps: {FileStamp},
    manifest: Manifest, imports: {ImportEdge}): ChangeReport
  return self:upsert_external(module_name, 1, stamps, manifest, imports, true, {})
end

function Graph:upsert_external_binary(module_name: string, stamps: {FileStamp},
    manifest: Manifest, imports: {ImportEdge}): ChangeReport
  return self:upsert_external(module_name, 2, stamps, manifest, imports, true, {})
end

function Graph:publish_external_source(module_name: string, stamps: {FileStamp},
    manifest: Manifest, imports: {ImportEdge}, satisfied_project_names: {string}): ChangeReport
  return self:upsert_external(module_name, 1, stamps, manifest, imports,
    false, name_set(satisfied_project_names))
end

function Graph:publish_external_binary(module_name: string, stamps: {FileStamp},
    manifest: Manifest, imports: {ImportEdge}, satisfied_project_names: {string}): ChangeReport
  return self:upsert_external(module_name, 2, stamps, manifest, imports,
    false, name_set(satisfied_project_names))
end

function Graph:invalidate_external_change(module_name: string): {string}
  return self:invalidate_importers(module_name, nil, nil, true, {})
end

function Graph:reachable_external_modules(): {string}
  return self:names("WITH RECURSIVE reachable(name) AS (" ..
    "SELECT imported FROM main.graph_imports AS edge " ..
    "JOIN main.graph_modules AS provider ON provider.name=edge.importer " ..
    "WHERE provider.provenance=0 UNION " ..
    "SELECT imported FROM reachable AS previous " ..
    "JOIN main.graph_modules AS provider ON provider.name=previous.name " ..
    "JOIN main.graph_imports AS edge ON edge.importer=previous.name " ..
    "WHERE provider.provenance<>0) " ..
    "SELECT module.name FROM reachable " ..
    "JOIN main.graph_modules AS module ON module.name=reachable.name " ..
    "WHERE module.provenance<>0 ORDER BY module.name COLLATE BINARY")
end

function Graph:prune_external(module_name: string): boolean
  return sql.execute(self.connection,
    "DELETE FROM main.graph_modules WHERE name=? AND provenance<>0", module_name) ~= 0
end

function Graph:remove_module(module_name: string): ChangeReport
  local entry? = self:module(module_name)
  if entry == nil then return ChangeReport.new(false, self:generation(), {}) end
  self:advance_generation()
  sql.execute(self.connection, "DELETE FROM main.graph_modules WHERE name=?", module_name)
  self.asts[module_name] = nil
  local invalidated = self:invalidate_importers(module_name, entry.manifest, nil, true, {})
  return ChangeReport.new(true, self:generation(), invalidated)
end
