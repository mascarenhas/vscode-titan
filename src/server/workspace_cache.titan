--- Validate and stage persistent compiler payloads and saved publication inventories.
-- @module server.workspace_cache

local async = import "async"
local fs = import "fs"
local sqlite3 = import "sqlite3"
local strings = import "string"
local paths = import "path"
local sql = import "server.workspace_store"
local identity = import "server.content_identity"
local bridge = import "server.compiler_bridge"
local logging = import "server.logging"
local headers = import "server.header_store"

local SCHEMA_VERSION = 8

type ProjectPayload = bridge.ProjectPayload

--- Persistent project payload candidate with accepted source identity.
record ProjectCandidate
  const module_name: string
  const revision: integer
end

local record InventoryInput
  const path: string
  const observation: string
  const fingerprint: string
end

record InventoryMetrics
  const reads: integer
  const hashes: integer
  const reused: integer
end

local record Artifact
  const kind: string
  const key: string
  const payload: string?
  const inputs: {bridge.CHeaderDependency}
end

--- Persisted compiler artifact namespace and its header provenance scope.
-- `table` holds its opaque payloads by key; `scope` is the `header_store`
-- provenance scope for its ordered inputs.
record ArtifactNamespace
  const kind: string
  const table: string
  const scope: integer
end

-- The one owner of the compiler's artifact namespaces. Schema creation,
-- staging, publication, `Cache:lookup` and the completion store's private
-- saved reads all resolve through this map, so a compiler pin that renames a
-- namespace is one edit here, and the installed-kind regression covers both
-- read paths.
local const artifact_namespaces: const {ArtifactNamespace} = {
  ArtifactNamespace.new("c-header-v8","main.header_graphs",2),
  ArtifactNamespace.new("ffi-conversion-v8","main.ffi_conversion_snapshots",3),
}

--- Resolve a compiler artifact namespace to its table and header scope.
--- Unknown namespaces are cache misses, never aliases of a known one.
function artifact_namespace(kind: string): ArtifactNamespace?
  for index = 1, #artifact_namespaces do
    local namespace = artifact_namespaces[index]
    if namespace.kind == kind then return namespace end
  end
  return nil
end

--- Stage compiler payloads and inventories for atomic saved publication.
record Cache
  const store: sql.Store
  const path: string
  local pending: {Artifact}
  local projects: {ProjectPayload}?
  local publication_key: string?
  local publication_compatibility: string?
  local publication_native_context: string?
  local inventory: {InventoryInput}
  local inventory_reads: integer
  local inventory_hashes: integer
  local inventory_reused: integer
end

local function metadata(connection: sqlite3.Connection, key: string): string?
  local rows = sql.rows(connection,
    "SELECT value FROM main.cache_meta WHERE key=?",sqlite3.Blob.new(key))
  if #rows == 0 then return nil end
  return sql.bytes(rows[1], 1)
end

local function write_metadata(connection: sqlite3.Connection,
                              key: string, payload: string)
  sql.execute(connection,
    "INSERT INTO main.cache_meta VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value",
    sqlite3.Blob.new(key), sqlite3.Blob.new(payload))
end

-- Nil means a disposable schema/root/compiler compatibility mismatch. The
-- caller closes this attempt before replacing the workspace cache file.
local function open_compatible(path: string, compatibility: string?): Cache?
  local store = sql.open(path)
  local accepted = false
  defer do if not accepted then store:close() end end
  local access = store:acquire()
  defer access:release()
  local connection = access.connection
  local version = sql.scalar_integer(connection, "PRAGMA main.user_version")
  if version ~= 0 and version ~= SCHEMA_VERSION then return nil end
  if sql.scalar_integer(connection,
      "SELECT count(*) FROM main.cache_meta WHERE typeof(key)<>'blob' OR typeof(value)<>'blob'") > 0 then
    return nil
  end
  local previous? = metadata(connection, "compatibility")
  if version ~= 0 and previous == nil then return nil end
  if compatibility ~= nil and previous ~= nil and previous ~= compatibility then return nil end
  if previous ~= nil then
    local checked = sql.rows(connection,"PRAGMA main.quick_check")
    if #checked ~= 1 or checked[1]:get(1) ~= "ok" then return nil end
  end
  headers.create(connection)
  local schema = {
    "CREATE TABLE IF NOT EXISTS main.project_snapshots(module BLOB PRIMARY KEY,payload BLOB NOT NULL,revision INTEGER NOT NULL) WITHOUT ROWID",
    "CREATE TABLE IF NOT EXISTS main.compiler_inputs(path BLOB PRIMARY KEY,observation BLOB NOT NULL,fingerprint BLOB NOT NULL) WITHOUT ROWID",
  }
  for index = 1, #schema do sql.execute(connection, schema[index]) end
  -- Artifact tables come from the namespace map so a new namespace cannot
  -- stage payloads into a table this schema never created.
  for index = 1, #artifact_namespaces do
    sql.execute(connection,"CREATE TABLE IF NOT EXISTS " ..
      artifact_namespaces[index].table ..
      "(key BLOB PRIMARY KEY,payload BLOB NOT NULL) WITHOUT ROWID")
  end
  sql.execute(connection, "PRAGMA main.user_version=" .. SCHEMA_VERSION)
  if sql.scalar_integer(connection, "PRAGMA main.user_version") ~= SCHEMA_VERSION then
    raise "workspace cache schema version was not installed"
  end
  if compatibility ~= nil then write_metadata(connection,"compatibility",compatibility) end
  accepted = true
  return Cache.new(store, path, {}, nil, nil, nil, nil, {}, 0, 0, 0)
end

-- Native startup and SQLite persistence share this workspace-local root.
--- Return the shared workspace-cache directory for a normalized project root.
function directory(root: string): string
  return paths.to_slash(paths.join(root, ".titan-ls"))
end

local function disk_cache(root: string, compatibility: string?): Cache
  local cache_dir = directory(root)
  local existing? = fs.lstat(cache_dir)
  if existing == nil then
    fs.mkdir(cache_dir)
  elseif existing.kind ~= "directory" then
    raise "workspace cache path is not a directory"
  end
  local ignore = paths.to_slash(paths.join(cache_dir, ".gitignore"))
  if fs.lstat(ignore) == nil then fs.write_file(ignore, "*\n") end
  local path = paths.to_slash(paths.join(cache_dir, "index.sqlite3"))
  local existing_file? = fs.lstat(path)
  if existing_file ~= nil and existing_file.kind ~= "file" then
    raise "cache database is not a regular file"
  end
  local cached?: Cache
  local rebuild = false
  do
    cached = open_compatible(path, compatibility)
    rebuild = cached == nil
  catch
    if error is async.CancellationReason then raise end
    if error is sqlite3.Error then
      local failure = error as sqlite3.Error
      -- SQLITE_CORRUPT / SQLITE_NOTADB. Access and filesystem failures use
      -- memory; only a known damaged disposable database is replaced.
      rebuild = failure.code == 11 or failure.code == 26
    end
    if not rebuild then raise end
  end
  if cached ~= nil then return cached end
  if rebuild then
    local metadata? = fs.lstat(path)
    if metadata ~= nil then
      if metadata.kind ~= "file" then raise "cache database is not a regular file" end
      fs.unlink(path)
    end
    cached = open_compatible(path, compatibility)
  end
  if cached == nil then raise "cannot initialize workspace cache schema" end
  return cached
end

local function open_cache(root: string, compatibility: string?): Cache
  do
    local physical_root = fs.realpath(root)
    local key?: string
    if compatibility ~= nil then key = identity.digest(physical_root .. "\0" .. compatibility) end
    local cache = disk_cache(physical_root, key)
    logging.emit("debug", "cache.open", {["path"] = cache.path,["mode"] = "file"})
    return cache
  catch
    if error is async.CancellationReason then raise end
    local reason = strings.tostring(error)
    if error is sqlite3.Error then reason = (error as sqlite3.Error).message end
    if error is async.OperationError then reason = (error as async.OperationError).message end
    logging.emit("info", "cache.memory_fallback", {
      ["root"] = root, ["message"] = "Workspace persistence is unavailable: " .. reason,
    })
    return open_compatible(":memory:",compatibility)
  end
end

--- Open or rebuild a persistent workspace cache using its compatibility identity.
function open(root: string, compatibility: string): Cache
  return open_cache(root,compatibility)
end

-- Only the tiny compiler observation table may be consulted before the actual
-- selected compiler/configuration inventory is accepted. Loader owns this
-- provisional store immediately and does not expose it as a semantic view.
function open_for_inventory(root: string): Cache
  return open_cache(root,nil)
end

function memory(compatibility: string): Cache
  return open_compatible(":memory:",compatibility)
end

local function inventory_stat(metadata: fs.Stat?): (string,string)
  if metadata == nil then return "missing","missing" end
  local physical = metadata.kind .. ":" .. metadata.device .. ":" ..
    metadata.inode .. ":" .. metadata.size .. ":" .. metadata.mode
  return physical .. ":" .. metadata.modified_seconds .. ":" ..
    metadata.modified_nanoseconds,physical
end

local function inventory_observation(path: string): (string,string)
  local link,link_physical = inventory_stat(fs.lstat(path))
  local target,target_physical = inventory_stat(fs.stat(path))
  return link .. "\0" .. target,link_physical .. "\0" .. target_physical
end

local function Cache:record_inventory(input: InventoryInput)
  for index = 1, #self.inventory do
    if self.inventory[index].path == input.path then
      self.inventory[index] = input
      return
    end
  end
  self.inventory[#self.inventory + 1] = input
end

function Cache:inventory_identity(path: string): string
  local previous?: InventoryInput
  do
    local access = self.store:acquire()
    defer access:release()
    local rows = sql.rows(access.connection,
      "SELECT observation,fingerprint FROM main.compiler_inputs WHERE path=?",
      sqlite3.Blob.new(path))
    if #rows == 1 then
      local observation: value = rows[1]:get(1)
      local fingerprint: value = rows[1]:get(2)
      if observation is sqlite3.Blob and fingerprint is sqlite3.Blob then
        local saved: sqlite3.Blob = fingerprint
        if #saved.bytes == 32 then
          previous = InventoryInput.new(path,(observation as sqlite3.Blob).bytes,saved.bytes)
        end
      end
    end
  end
  for attempt = 1, 3 do
    local before,physical = inventory_observation(path)
    if previous ~= nil and previous.observation == before then
      self.inventory_reused = self.inventory_reused + 1
      self:record_inventory(previous)
      return previous.fingerprint
    end
    self.inventory_reads = self.inventory_reads + 1
    local contents = fs.read_file(path)
    local after,_physical = inventory_observation(path)
    if before == after then
      self.inventory_hashes = self.inventory_hashes + 1
      local fingerprint = identity.digest(identity.digest(contents) .. physical)
      self:record_inventory(InventoryInput.new(path,after,fingerprint))
      return fingerprint
    end
  end
  raise "compiler input changed repeatedly while validating: " .. path
end

function Cache:inventory_metrics(): InventoryMetrics
  return InventoryMetrics.new(self.inventory_reads,self.inventory_hashes,self.inventory_reused)
end

local function Cache:publish_inventory()
  local access = self.store:acquire()
  defer access:release()
  -- This small observation list is temporary startup work. Its replacement is
  -- independent of semantic publication and cannot expose an unvalidated view.
  access.connection:set_autocommit(false)
  local committed = false
  defer do if not committed then access.connection:rollback() end end
  sql.execute(access.connection,"DELETE FROM main.compiler_inputs")
  local insert = access.connection:prepare("INSERT INTO main.compiler_inputs VALUES(?,?,?)")
  defer insert:close()
  for index = 1, #self.inventory do
    local input = self.inventory[index]
    insert:execute(sqlite3.Blob.new(input.path),sqlite3.Blob.new(input.observation),
      sqlite3.Blob.new(input.fingerprint))
  end
  access.connection:commit()
  committed = true
end

function Cache:validate_inventory(root: string,compatibility: string): Cache
  local key = identity.digest(fs.realpath(root) .. "\0" .. compatibility)
  local previous?: string
  do
    local access = self.store:acquire()
    defer access:release()
    previous = metadata(access.connection,"compatibility")
    if previous == nil then write_metadata(access.connection,"compatibility",key) end
  end
  local accepted = self
  if previous ~= nil and previous ~= key then accepted = self:rebuild(key) end
  accepted:publish_inventory()
  logging.emit("debug","cache.inventory.validation",{
    ["reads"] = accepted.inventory_reads,["hashes"] = accepted.inventory_hashes,
    ["reused"] = accepted.inventory_reused,
  })
  return accepted
end

function Cache:accept_native_context(context: string): boolean
  local access = self.store:acquire()
  defer access:release()
  local previous? = metadata(access.connection,"native_context")
  if previous ~= nil then return previous == context end
  write_metadata(access.connection,"native_context",context)
  return true
end

-- The preliminary inventory can match while PATH, CC, or the native SDK has
-- changed. Discard project/semantic state before discovery, retaining only the
-- freshly validated header records staged while identifying the new context.
function Cache:rebuild(replacement_compatibility: string?): Cache
  local compatibility?: string = replacement_compatibility
  if compatibility == nil then
    local access = self.store:acquire()
    defer access:release()
    compatibility = metadata(access.connection,"compatibility")
  end
  self.store:close()
  local replacement?: Cache
  do
    if self.path ~= ":memory:" then fs.unlink(self.path) end
    replacement = open_compatible(self.path,compatibility)
  catch
    if error is async.CancellationReason then raise end
    replacement = open_compatible(":memory:",compatibility)
  end
  replacement.pending = self.pending
  replacement.inventory = self.inventory
  replacement.inventory_reads = self.inventory_reads
  replacement.inventory_hashes = self.inventory_hashes
  replacement.inventory_reused = self.inventory_reused
  replacement:publish_inventory()
  self.pending = {}
  return replacement
end

--- Read a compatible compiler payload and its ordered header closure.
function Cache:lookup(kind: string, key: string): (string?,{bridge.CHeaderDependency}?)
  local refreshed?: {bridge.CHeaderDependency}
  for index = #self.pending, 1, -1 do
    local item = self.pending[index]
    if item.kind == kind and item.key == key then
      if item.payload ~= nil then return item.payload,item.inputs end
      refreshed = item.inputs
      break
    end
  end
  local namespace? = artifact_namespace(kind)
  if namespace == nil then return nil,nil end
  local access = self.store:acquire()
  defer access:release()
  local rows = sql.rows(access.connection,
    "SELECT payload FROM " .. namespace.table .. " WHERE key=?",sqlite3.Blob.new(key))
  if #rows == 0 then return nil,nil end
  local payload: value = rows[1]:get(1)
  if not (payload is sqlite3.Blob) then return nil,nil end
  if refreshed == nil then refreshed = headers.read(access.connection,namespace.scope,key) end
  if refreshed == nil then return nil,nil end
  return (payload as sqlite3.Blob).bytes,refreshed
end

-- Compiler hooks only stage successful records. SQLite writes remain with the
-- updater's completed-view publication; speculative rename has no such hook.
--- Stage a complete compiler payload for later accepted publication.
function Cache:stage(kind: string, key: string, payload: string,
                      inputs: {bridge.CHeaderDependency})
  if artifact_namespace(kind) == nil then return end
  local item = Artifact.new(kind,key,payload,inputs)
  for index = 1, #self.pending do
    if self.pending[index].kind == kind and self.pending[index].key == key then
      self.pending[index] = item
      return
    end
  end
  self.pending[#self.pending + 1] = item
end

function Cache:refresh_inputs(kind: string,key: string,
    inputs: {bridge.CHeaderDependency}): boolean
  local namespace? = artifact_namespace(kind)
  if namespace == nil then return false end
  for index = #self.pending, 1, -1 do
    local item = self.pending[index]
    if item.kind == kind and item.key == key then
      self.pending[index] = Artifact.new(kind,key,item.payload,inputs)
      return true
    end
  end
  do
    local access = self.store:acquire()
    defer access:release()
    if sql.scalar_integer(access.connection,"SELECT count(*) FROM " .. namespace.table ..
        " WHERE key=? AND typeof(payload)='blob'",sqlite3.Blob.new(key)) ~= 1 then
      return false
    end
  end
  self.pending[#self.pending + 1] = Artifact.new(kind,key,nil,inputs)
  return true
end

function Cache:project_candidates(): {ProjectCandidate}
  local access = self.store:acquire()
  defer access:release()
  local rows = sql.rows(access.connection,
    "SELECT name,revision FROM main.graph_modules WHERE provenance=0 AND state=2 " ..
    "ORDER BY name COLLATE BINARY")
  local result: {ProjectCandidate} = {}
  for index = 1, #rows do
    result[index] = ProjectCandidate.new(rows[index]:get(1),rows[index]:get(2))
  end
  return result
end

-- A declared compiler manifest cannot rebuild lexical SQL facts. Interrupted
-- work or an incomplete semantic publication must recheck its source before
-- an updater can replace those facts; no body hydration fallback exists.
function Cache:unpublished_projects(): {string}
  local access = self.store:acquire()
  defer access:release()
  local connection = access.connection
  local complete = sql.scalar_integer(connection,
    "SELECT count(*) FROM main.sqlite_master WHERE type='table' AND name IN (" ..
    "'semantic_projects','semantic_files','semantic_summaries','semantic_occurrences'," ..
    "'semantic_hovers','semantic_folds','completion_configuration','completion_roots'," ..
    "'completion_descriptors','completion_source_files','completion_imports'," ..
    "'completion_header_inputs','completion_members')") == 13
  local query = "SELECT g.name FROM main.graph_modules AS g " ..
    "WHERE g.provenance=0 AND g.state=2"
  if complete then
    query = query .. " AND NOT EXISTS(SELECT 1 FROM main.semantic_projects AS p " ..
      "WHERE p.module_name=CAST(g.name AS BLOB) AND p.revision=g.revision AND p.state=2 " ..
      "AND EXISTS(SELECT 1 FROM main.completion_descriptors AS c " ..
      "WHERE c.module_name=p.module_name AND c.revision=p.revision AND c.state=2))"
  end
  local rows = sql.rows(connection, query .. " ORDER BY g.name COLLATE BINARY")
  local result: {string} = {}
  for index = 1, #rows do result[index] = rows[index]:get(1) as string end
  return result
end

function Cache:project_payload(candidate: ProjectCandidate): ProjectPayload?
  local access = self.store:acquire()
  defer access:release()
  local rows = sql.rows(access.connection,
    "SELECT p.payload FROM main.project_snapshots AS p " ..
    "JOIN main.graph_modules AS g ON g.name=CAST(p.module AS TEXT) " ..
    "WHERE p.module=? AND p.revision=? AND typeof(p.revision)='integer' " ..
    "AND g.provenance=0 AND g.state=2 AND g.revision=p.revision",
    sqlite3.Blob.new(candidate.module_name),candidate.revision)
  if #rows ~= 1 then
    logging.emit("debug","cache.project.miss",{
      ["module"] = candidate.module_name,
      ["message"] = "persisted project payload is missing at the selected revision",
    })
    return nil
  end
  local payload: value = rows[1]:get(1)
  if not (payload is sqlite3.Blob) then
    logging.emit("debug","cache.project.miss",{
      ["module"] = candidate.module_name,
      ["message"] = "persisted project payload has invalid SQLite storage type",
    })
    return nil
  end
  local inputs? = headers.read(access.connection,0,candidate.module_name)
  if inputs == nil then
    logging.emit("debug","cache.project.miss",{
      ["module"] = candidate.module_name,
      ["message"] = "persisted project header owner is missing or invalid",
    })
    return nil
  end
  return ProjectPayload.new(candidate.module_name,(payload as sqlite3.Blob).bytes,inputs)
end

function Cache:project_payloads(): {ProjectPayload}
  local access = self.store:acquire()
  defer access:release()
  local rows = sql.rows(access.connection,
    "SELECT p.module,p.payload FROM main.project_snapshots AS p " ..
    "JOIN main.graph_modules AS g ON g.name=CAST(p.module AS TEXT) " ..
    "WHERE g.provenance=0 AND g.state=2 AND typeof(p.revision)='integer' " ..
    "AND g.revision=p.revision ORDER BY p.module")
  local result: {ProjectPayload} = {}
  for index = 1, #rows do
    local module: value = rows[index]:get(1)
    local payload: value = rows[index]:get(2)
    if module is sqlite3.Blob and payload is sqlite3.Blob then
      result[#result + 1] = ProjectPayload.new(
        (module as sqlite3.Blob).bytes,(payload as sqlite3.Blob).bytes)
    else
      logging.emit("debug","cache.project.miss",{
        ["message"] = "persisted project payload has invalid SQLite storage types",
      })
    end
  end
  return result
end

-- Work revisions are separate from the feature generation. A same-generation
-- header or external dependency invalidation still changes this exact key.
local function revision_key(connection: sqlite3.Connection): string
  local rows = sql.rows(connection,
    "SELECT name,provenance,state,revision FROM main.graph_modules ORDER BY name COLLATE BINARY")
  local output = strings.writer()
  for index = 1, #rows do
    local row = rows[index]
    local name: string = row:get(1)
    local provenance: integer = row:get(2)
    local state: integer = row:get(3)
    local revision: integer = row:get(4)
    output:write(#name .. ":" .. name .. ":" .. provenance .. ":" .. state .. ":" .. revision .. ";")
  end
  return identity.digest(output:drain())
end

local function reusable_publication(connection: sqlite3.Connection,key: string): boolean
  local previous? = metadata(connection,"published_revisions")
  return previous ~= nil and previous == key and
    sql.scalar_integer(connection,
      "SELECT published_generation FROM main.store_state WHERE singleton=1") > 0 and
    sql.scalar_integer(connection,
      "SELECT count(*) FROM main.sqlite_master WHERE type='table' AND name IN (" ..
      "'semantic_projects','semantic_files','semantic_summaries','semantic_occurrences'," ..
      "'semantic_hovers','semantic_folds','semantic_diagnostic_publications','semantic_diagnostic_items'," ..
      "'completion_configuration','completion_roots','completion_descriptors','completion_source_files'," ..
      "'completion_imports','completion_header_inputs','completion_members')") == 15 and
    sql.scalar_integer(connection,
      "SELECT count(*) FROM main.completion_configuration WHERE singleton=1") == 1 and
    sql.scalar_integer(connection,
      "SELECT count(*) FROM main.completion_roots WHERE kind=4 AND position=0") == 1
end

function Cache:can_reuse_publication(): boolean
  local access = self.store:acquire()
  defer access:release()
  return reusable_publication(access.connection,revision_key(access.connection))
end

function Cache:prepare(): boolean
  self.projects = nil
  local access = self.store:acquire()
  defer access:release()
  self.publication_key = revision_key(access.connection)
  return reusable_publication(access.connection,self.publication_key)
end

function Cache:set_projects(projects: {ProjectPayload})
  self.projects = projects
end

-- A completed module revision owns its opaque compiler payload independently
-- of the current feature publication. Preserve it until that revision changes.
function Cache:projects_to_export(): {string}
  local access = self.store:acquire()
  defer access:release()
  local rows = sql.rows(access.connection,
    "SELECT g.name FROM main.graph_modules AS g WHERE g.provenance=0 AND g.state=2 " ..
    "AND NOT EXISTS(SELECT 1 FROM main.project_snapshots AS p " ..
      "WHERE p.module=CAST(g.name AS BLOB) AND typeof(p.payload)='blob' " ..
      "AND typeof(p.revision)='integer' AND p.revision=g.revision) " ..
    "ORDER BY g.name COLLATE BINARY")
  local result: {string} = {}
  for index = 1, #rows do result[index] = rows[index]:get(1) as string end
  return result
end

-- Publish the context which produced these rows, including live configuration
-- transitions. Keeping the startup key would mislabel a later completed view.
function Cache:stage_context(root: string,compatibility: string,native_context: string)
  self.publication_compatibility = identity.digest(fs.realpath(root) .. "\0" .. compatibility)
  self.publication_native_context = native_context
end

--- Publish staged cache state within the shared semantic transaction.
function Cache:publish(connection: sqlite3.Connection)
  if self.publication_key == nil then raise "cache publication was not prepared" end
  -- Pruning belongs to the same completed publication as replacement facts.
  -- A selected module whose compiler graph cannot be encoded loses its old
  -- revision here, while unchanged clean rows are never rewritten.
  sql.execute(connection,
    "DELETE FROM main.project_snapshots AS p WHERE typeof(p.module)<>'blob' " ..
    "OR typeof(p.payload)<>'blob' OR typeof(p.revision)<>'integer' OR NOT EXISTS(" ..
      "SELECT 1 FROM main.graph_modules AS g WHERE g.name=CAST(p.module AS TEXT) " ..
      "AND g.provenance=0 AND g.state=2 AND p.revision=g.revision)")
  if self.projects ~= nil then
    local insert = connection:prepare("INSERT INTO main.project_snapshots(module,payload,revision) " ..
      "SELECT ?,?,revision FROM main.graph_modules WHERE name=? AND provenance=0 AND state=2 " ..
      "ON CONFLICT(module) DO UPDATE SET payload=excluded.payload,revision=excluded.revision")
    defer insert:close()
    for index = 1, #self.projects do
      local item = self.projects[index]
      insert:execute(sqlite3.Blob.new(item.module_name),sqlite3.Blob.new(item.payload),item.module_name)
    end
  end
  for index = 1, #self.pending do
    local item = self.pending[index]
    -- Staging rejects unknown namespaces, so every pending item resolves.
    local namespace = artifact_namespace(item.kind)
    if item.payload ~= nil then
      sql.execute(connection,"INSERT INTO " .. namespace.table ..
        " VALUES(?,?) ON CONFLICT(key) DO UPDATE SET payload=excluded.payload",
        sqlite3.Blob.new(item.key),sqlite3.Blob.new(item.payload))
    end
    headers.replace(connection,namespace.scope,item.key,item.inputs)
  end
  headers.prune(connection)
  write_metadata(connection,"published_revisions",self.publication_key)
  if self.publication_compatibility ~= nil then
    write_metadata(connection,"compatibility",self.publication_compatibility)
    write_metadata(connection,"native_context",self.publication_native_context)
  end
  -- Keep staged immutable records until the next prepare so a caller rolling
  -- back this transaction can retry the same complete publication.
end

--- Retire staged state after successful transaction commit.
function Cache:publication_committed()
  self.pending = {}
  self.projects = nil
  self.publication_key = nil
  self.publication_compatibility = nil
  self.publication_native_context = nil
end
