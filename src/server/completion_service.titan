--- Prepare captured editor completions and select qualified scalar facts.
-- @module server.completion_service

local async = import "async"
local timer = import "timer"
local strings = import "string"
local file_paths = import "path"
local bridge = import "server.compiler_bridge"
local buffers = import "server.document_buffers"
local discovery = import "server.completion_discovery"
local facts = import "server.completion_types"
local storage = import "server.completion_store"
local sql = import "server.workspace_store"
local source_text = import "server.source_text"
local lsp = import "server.lsp_types"
local dispatcher = import "server.dispatcher"
local coordinator = import "server.coordinator"
local logging = import "server.logging"
local semantic_features = import "server.semantic_features"
local wire = import "server.wire"
foreign import "compiler_io_clock.h"

local record Request
  const capture: buffers.Capture
  const generation: integer
  baseline: storage.Baseline?
  module_name: string
  const key: string
  const sequence: integer
  const options: lsp.CompletionOptions?
  const hover_only: boolean
end

local record Prepared
  const snapshot: facts.Snapshot
  const range: source_text.Span
  const volatile_headers: {bridge.CHeaderDependency}
  const hover_usable: boolean
end

local record Ready
  const id: string
  const key: string
  const prefix: string
  const range: source_text.Span
  const volatile_headers: {bridge.CHeaderDependency}
  const validated_through: integer
  const filename: string
  const session: integer
  const anchor: string
  const generation: integer
end

local record ByteChange
  const start: integer
  const old_finish: integer
  const new_finish: integer
end

local record HoverFile
  const original: buffers.Input
  latest: buffers.Input
  const changes: {ByteChange}
  exhausted: boolean
end

local record HoverContext
  const id: string
  const files: {HoverFile}
  const source: boolean
  const epoch: integer
  const generation: integer
  const module_name: string
end

-- Full-sync changes have no edit ranges. A conservative common prefix/suffix
-- supplies one replacement per version; intervening occurrences are omitted.
local function changed_bytes(before: string, after: string): ByteChange?
  if before == after then return nil end
  local first = 0
  local limit = #before
  if #after < limit then limit = #after end
  while first + 1024 <= limit and
      strings.sub(before, first + 1, first + 1024) ==
      strings.sub(after, first + 1, first + 1024) do first = first + 1024 end
  while first < limit and strings.byte(before, first + 1) ==
      strings.byte(after, first + 1) do first = first + 1 end
  local suffix = 0
  while suffix + 1024 <= limit - first and
      strings.sub(before, #before - suffix - 1023, #before - suffix) ==
      strings.sub(after, #after - suffix - 1023, #after - suffix) do suffix = suffix + 1024 end
  while suffix < limit - first and strings.byte(before, #before - suffix) ==
      strings.byte(after, #after - suffix) do suffix = suffix + 1 end
  return ByteChange(first, #before - suffix, #after - suffix)
end

local function HoverContext:follow(inputs: const {buffers.Input}): boolean
  for index = 1, #self.files do
    local file = self.files[index]
    local live: buffers.Input? = nil
    for input_index = 1, #inputs do
      local input = inputs[input_index]
      if input.path == file.original.path then live = input end
    end
    if live == nil or live.session ~= file.original.session then return false end
    local change? = changed_bytes(file.latest.text, live.text)
    if change ~= nil and not file.exhausted then
      if #file.changes >= 64 then
        file.exhausted = true
      else
        file.changes[#file.changes + 1] = change
      end
    end
    file.latest = live
  end
  return true
end

local function HoverFile:original_offset(offset: integer): integer?
  if self.exhausted then return nil end
  for index = #self.changes, 1, -1 do
    local change = self.changes[index]
    if offset >= change.start and offset < change.new_finish then return nil end
    if offset >= change.new_finish then
      offset = offset + change.old_finish - change.new_finish
    end
  end
  return offset
end

local function identifier_byte(byte: integer?): boolean
  if byte == nil then return false end
  return byte == 95 or byte >= 65 and byte <= 90 or
    byte >= 97 and byte <= 122 or byte >= 48 and byte <= 57
end

local function HoverFile:current_span(row: facts.Hover): source_text.ByteSpan?
  if self.exhausted then return nil end
  local first = row.byte_start
  local finish = row.byte_finish
  for index = 1, #self.changes do
    local change = self.changes[index]
    if finish <= change.start then
    elseif first >= change.old_finish then
      first = first + change.new_finish - change.old_finish
      finish = finish + change.new_finish - change.old_finish
    else
      return nil
    end
  end
  if first < 0 or finish > #self.latest.text or
      strings.sub(self.latest.text, first + 1, finish) ~=
      strings.sub(self.original.text, row.byte_start + 1, row.byte_finish) then return nil end
  -- Inserting identifier characters at a span boundary changes that token too.
  if identifier_byte(strings.byte(self.latest.text, first + 1)) and
      identifier_byte(strings.byte(self.latest.text, first)) then return nil end
  if identifier_byte(strings.byte(self.latest.text, finish)) and
      identifier_byte(strings.byte(self.latest.text, finish + 1)) then return nil end
  return source_text.ByteSpan(first, finish)
end

local function hover_context(snapshot: facts.Snapshot, capture: buffers.Capture,
                             source: boolean): HoverContext
  local files: {HoverFile} = {}
  for index = 1, #snapshot.inputs do
    local input = snapshot.inputs[index]
    if input.session > 0 then
      for input_index = 1, #capture.inputs do
        local document = capture.inputs[input_index]
        if document.path == input.filename then
          files[#files + 1] = HoverFile(document, document, {}, false)
        end
      end
    end
  end
  return HoverContext {
    id = snapshot.id,
    files = files,
    source = source,
    epoch = capture.epoch,
    generation = snapshot.saved_generation,
    module_name = snapshot.module_name,
  }
end

record Service
  local const store: storage.Store
  local const buffers: buffers.BufferStore
  local pending: Request?
  local pending_hover: Request?
  local active: Request?
  local preparation: async.Task<|Prepared?, value|>?
  local worker: async.Task<|nil, value|>?
  local ready: Ready?
  local closed: boolean
  local sync_needed: boolean
  local baseline: storage.Baseline?
  local requests: integer
  local previous_ready: Ready?
  local hover_context: HoverContext?
  local hover_path: string?
  local hover_session: integer
  local debounce: async.Task<|nil, value|>?
  local saved_generation: integer
  local minimum_saved_generation: integer
end

local const HOVER_DEBOUNCE_MS = 200
local const MAX_RESTORATION_BYTES = 64 * 1024 * 1024

local function empty(): dispatcher.SemanticOutcome
  return dispatcher.SemanticOutcome.result(lsp.completion_list_value(
    lsp.CompletionList(true, {})))
end

function create(store: sql.Store, documents: buffers.BufferStore): Service
  return Service {
    store = storage.open(store),
    buffers = documents,
    closed = false,
    sync_needed = false,
    requests = 0,
    hover_session = 0,
    saved_generation = 0,
    minimum_saved_generation = 0,
  }
end

local function open_paths(capture: buffers.Capture): const {string}
  local paths: {string} = {}
  for index = 1, #capture.inputs do paths[#paths + 1] = capture.inputs[index].path end
  for index = 1, #capture.unavailable_paths do
    paths[#paths + 1] = capture.unavailable_paths[index]
  end
  return paths as const {string}
end

local function open_documents(inputs: const? {buffers.Input}): {facts.OpenDocument}
  local documents: {facts.OpenDocument} = {}
  for index = 1, #inputs do
    local input = inputs[index]
    documents[index] = facts.OpenDocument {
      uri = input.uri,
      filename = input.path,
      module_name = "",
      session = input.session,
      version = input.version,
      contents = input.text,
    }
  end
  return documents
end

local function module_for(path: string, baseline: storage.Baseline,
                          paths: const {string}): string?
  local roots: {string} = {}
  if baseline.configuration.source_roots ~= nil then roots = baseline.configuration.source_roots end
  local name? = discovery.find(path, baseline.projects, roots,
    baseline.include, baseline.exclude, paths, baseline.inactive_files, baseline.target)
  if name == nil then return nil end
  for index = 1, #baseline.modules do
    local module = baseline.modules[index]
    if module.module_name == name and module.provenance ~= "project" then return nil end
  end
  return name
end

local function contributor_key(filename: string): string
  local basename = file_paths.basename(filename)
  local classification = bridge.classify_source_filename(basename)
  if classification.logical_basename ~= nil then
    return classification.logical_basename
  end
  return basename
end

local function sort_files(files: {bridge.SourceFile}, main_file: string)
  for index = 2, #files do
    local item = files[index]
    local item_key = contributor_key(item.filename)
    local previous = index - 1
    while previous >= 1 and files[previous].filename ~= main_file and
        (item.filename == main_file or
         item_key < contributor_key(files[previous].filename)) do
      files[previous + 1] = files[previous]
      previous = previous - 1
    end
    files[previous + 1] = item
  end
end

local function Request:active_module(paths: const {string}):
    (bridge.ProjectModule?, {facts.Input})
  local files: {bridge.SourceFile} = {}
  local inputs: {facts.Input} = {}
  local indexes: {string: integer} = {}
  local main_file = ""
  for index = 1, #self.baseline.projects do
    local project = self.baseline.projects[index]
    if project.module_name == self.module_name then
      for file_index = 1, #project.files do
        local file = project.files[file_index]
        files[#files + 1] = file
        indexes[file.filename] = #files
        inputs[#inputs + 1] = facts.Input(file.filename, 0, 0, file.contents)
      end
      if #files > 0 then main_file = files[1].filename end
    end
  end
  for index = 1, #self.capture.unavailable_paths do
    if module_for(self.capture.unavailable_paths[index], self.baseline, paths) ==
        self.module_name then return nil, {} end
  end
  for index = 1, #self.capture.inputs do
    local input = self.capture.inputs[index]
    if module_for(input.path, self.baseline, paths) == self.module_name then
      local ordinal? = indexes[input.path]
      if ordinal == nil then ordinal = #files + 1 end
      files[ordinal] = bridge.SourceFile(input.path, input.text)
      inputs[ordinal] = facts.Input(input.path, input.session, input.version, input.text)
      indexes[input.path] = ordinal
    end
  end
  if #files == 0 then return nil, {} end
  if main_file == "" then
    -- A folder's final name identifies its main file. Discovery has already
    -- verified that the virtual resolver selects this exact provider.
    local leaf = self.module_name
    for index = 1, #leaf do
      if strings.sub(self.module_name, index, index) == "." then
        leaf = strings.sub(self.module_name, index + 1)
      end
    end
    for index = 1, #files do
      local file = files[index].filename
      if contributor_key(file) == leaf .. ".titan" then main_file = file end
    end
    if main_file == "" then main_file = self.capture.document.path end
  end
  sort_files(files, main_file)
  return bridge.ProjectModule(self.module_name, files), inputs
end

local function import_candidates(baseline: storage.Baseline): {facts.Candidate}
  local result: {facts.Candidate} = {}
  for index = 1, #baseline.modules do
    local item = baseline.modules[index]
    result[#result + 1] = facts.Candidate {
      label = item.module_name,
      lookup_domain = "module",
      lookup_key = item.module_name,
      kind = 9,
      detail = "Titan module",
      type_key = "",
      scope_id = 0,
      scope_depth = 0,
      declaration_order = index,
      available = true,
      visibility = "public",
      owner_key = "",
      access_mode = "import",
      documentation = item.documentation,
    }
  end
  return result
end

local function completion_hovers(active: bridge.ProjectModule,
    analysis: bridge.CompletionAnalysis, hole: bridge.CompletionHole?,
    original: string): ({facts.Hover}, boolean)
  if analysis.snapshot == nil then return {}, false end
  if #analysis.snapshot.symbols > facts.MAX_HOVER_ROWS then return {}, false end
  local prepared = semantic_features.prepare({active}, {analysis.snapshot}, async.yield)
  local rows = prepared:completion_hovers(async.yield)
  local result: {facts.Hover} = {}
  local delta = 0
  local analysis_finish = 0
  if hole ~= nil then
    delta = #hole.contents - #original
    analysis_finish = hole.replace_finish + delta
  end
  for index = 1, #rows do
    if index % 1024 == 0 then async.yield() end
    local row = rows[index]
    local first = row.byte_start
    local finish = row.byte_finish
    local include = true
    if hole ~= nil and row.filename == hole.filename then
      if first >= analysis_finish then
        first = first - delta
        finish = finish - delta
      elseif finish > hole.replace_start then
        -- The dummy token has no editor identity. Neither it nor any span
        -- crossing its replacement may be mistaken for a real occurrence.
        include = false
      end
    end
    if include then
      result[#result + 1] = facts.Hover(row.filename, first, finish, row.markdown)
    end
  end
  return result, true
catch
  if error is async.CancellationReason then raise end
  logging.emit("debug", "completion.hover.failure", {["message"] = strings.tostring(error)})
  return {}, false
end

local function Service:request_current(request: Request): boolean
  return not self.closed and request.generation >= self.minimum_saved_generation and
    self.buffers:current(request.capture)
end

local function Service:prepare(request: Request): Prepared?
  local started = logging.clock()
  local wall = ffi.vscode_titan_monotonic_ms()
  defer do
    logging.emit("debug", "completion.prepare", {
      ["cpu_ms"] = logging.elapsed_ms(started),
      ["wall_ms"] = ffi.vscode_titan_monotonic_ms() - wall,
      ["module"] = request.module_name, ["saved_generation"] = request.generation,
      ["hover_only"] = request.hover_only,
    })
  end
  if self.baseline == nil or self.baseline.generation ~= request.generation then
    local baseline? = self.store:capture_baseline()
    if baseline == nil or baseline.generation ~= request.generation then return nil end
    self.baseline = baseline
  end
  request.baseline = self.baseline
  local reusable? = self.ready
  if not request.hover_only and reusable ~= nil and reusable.key == request.key and #reusable.volatile_headers > 0 then
    local validator = bridge.load()
    validator:configure(request.baseline.configuration)
    local _, changed = validator:restat_c_header_dependencies(reusable.volatile_headers)
    if not changed and self:request_current(request) and
        self.store:current_generation(request.generation) and self:request_current(request) then
      self.ready = Ready {
        id = reusable.id,
        key = reusable.key,
        prefix = reusable.prefix,
        range = reusable.range,
        volatile_headers = reusable.volatile_headers,
        validated_through = self.requests,
        filename = reusable.filename,
        session = reusable.session,
        anchor = reusable.anchor,
        generation = reusable.generation,
      }
      return nil
    end
    if not self:request_current(request) then return nil end
    self.previous_ready = reusable
    self.ready = nil
  end
  local paths = open_paths(request.capture)
  local module_name? = module_for(request.capture.document.path, request.baseline, paths)
  if module_name == nil then return nil end
  request.module_name = module_name
  local capture = request.capture
  local coordinates = source_text.coordinate_index(capture.document.text)
  local caret? = coordinates:offset_for_position(capture.position)
  if caret == nil then return nil end
  local hole: bridge.CompletionHole? = nil
  local range = source_text.Span(capture.position, capture.position)
  if not request.hover_only then
    hole = bridge.prepare_completion(capture.document.path, capture.document.text, caret)
    if hole == nil then return nil end
    local replacement? = coordinates:span_for_offsets(hole.replace_start, hole.replace_finish)
    if replacement == nil then return nil end
    range = replacement
  end
  local active?, inputs = request:active_module(paths)
  if active == nil then return nil end
  if hole ~= nil then
    for index = 1, #active.files do
      if active.files[index].filename == capture.document.path then
        active.files[index] = bridge.SourceFile(capture.document.path, hole.contents)
      end
    end
  end
  local result = bridge.CompletionAnalysis("complete", "source", {}, {})
  local volatile_headers: {bridge.CHeaderDependency} = {}
  if hole ~= nil and hole.kind == "import" then
    result = bridge.CompletionAnalysis("complete", "import", import_candidates(request.baseline), {})
  else
    local compiler = bridge.load()
    compiler:configure(request.baseline.configuration)
    -- Writes are intentionally private and disposable. Persisted C entries
    -- are read only from this saved generation; pending watcher caches never
    -- enter an unsaved analysis and native probe persistence is disabled.
    compiler:configure_cache(
      function (kind: string, key: string): (string?, {bridge.CHeaderDependency}?)
        return self.store:read_saved_cache(request.baseline.generation, kind, key)
      end,
      function (_kind: string, _key: string, _payload: string, _inputs: {bridge.CHeaderDependency}) end,
      function (_kind: string, _key: string, _inputs: {bridge.CHeaderDependency}): boolean return false end)
    local restoration: {bridge.ProjectModule} = {}
    local payloads: {bridge.ProjectPayload} = {}
    local projects: {bridge.ProjectModule} = {active}
    local binaries: {bridge.CompletionBinary} = {}
    local captured_headers: {bridge.CHeaderDependency} = {}
    local dependencies? = bridge.completion_dependencies(active)
    if dependencies == nil then return nil end
    local needed: {string: boolean} = {}
    for index = 1, #dependencies do needed[dependencies[index]] = true end
    local expanded = true
    while expanded do
      expanded = false
      for index = 1, #request.baseline.modules do
        local module = request.baseline.modules[index]
        if needed[module.module_name] then
          for import_index = 1, #module.imports do
            local dependency = module.imports[import_index].module_name
            if not needed[dependency] then needed[dependency] = true; expanded = true end
          end
        end
      end
    end
    local bytes = 0
    for index = 1, #request.baseline.modules do
      local module = request.baseline.modules[index]
      if module.module_name ~= request.module_name then
        if module.provenance == "project" or module.provenance == "external" then
          if needed[module.module_name] then
            local payload? = self.store:read_descriptor(request.baseline.generation, module.module_name)
            if payload ~= nil then
              if payload.header_inputs ~= nil then
                for header_index = 1, #payload.header_inputs do
                  captured_headers[#captured_headers + 1] = payload.header_inputs[header_index]
                end
              end
              bytes = bytes + #payload.payload
              if bytes > MAX_RESTORATION_BYTES then return nil end
              local files: {bridge.SourceFile} = {}
              for file_index = 1, #module.source_files do
                files[file_index] = bridge.SourceFile(module.source_files[file_index], "")
              end
              if #files > 0 then
                restoration[#restoration + 1] = bridge.ProjectModule(module.module_name, files)
                payloads[#payloads + 1] = payload
              end
            end
          end
        elseif module.public_interface ~= "" then
          binaries[#binaries + 1] = bridge.CompletionBinary {
            module_name = module.module_name,
            serialized = module.public_interface,
            kind = module.provenance,
            filename = module.main_file,
          }
        end
      end
    end
    for index = 1, #request.baseline.projects do
      local project = request.baseline.projects[index]
      if project.module_name ~= request.module_name then projects[#projects + 1] = project end
    end
    compiler:restore_projects(restoration, payloads)
    local headers? = self.store:read_header_inputs(request.baseline.generation, request.module_name)
    if headers == nil then return nil end
    for index = 1, #headers do captured_headers[#captured_headers + 1] = headers[index] end
    local _, changed = compiler:restat_c_header_dependencies(captured_headers)
    if changed then return nil end
    result = compiler:analyze_completion(request.module_name, projects, {}, hole, headers, binaries)
    if result.observed_headers ~= nil then
      for index = 1, #result.observed_headers do
        local observed = result.observed_headers[index]
        local captured = false
        for saved_index = 1, #captured_headers do
          local saved = captured_headers[saved_index]
          if saved.kind:code() == observed.kind:code() and saved.path == observed.path then
            captured = true
            if saved.identity ~= observed.identity then return nil end
          end
        end
        -- Unsaved code may introduce a new explicit header. It is not part of
        -- the saved watch inventory yet, so later requests must prepare again.
        if not captured then volatile_headers[#volatile_headers + 1] = observed end
      end
      local _, changed_observed = compiler:restat_c_header_dependencies(result.observed_headers)
      if changed_observed then return nil end
    end
    local _, changed_after = compiler:restat_c_header_dependencies(captured_headers)
    if changed_after then return nil end
  end
  if not self.buffers:current(capture) then return nil end
  local first = caret
  local finish = caret
  local prefix = ""
  if hole ~= nil then
    first = hole.replace_start
    finish = hole.replace_finish
    prefix = hole.prefix
  end
  local hovers, usable = completion_hovers(active, result, hole, capture.document.text)
  return Prepared(
    facts.Snapshot {
      id = request.key,
      module_name = request.module_name,
      saved_generation = request.baseline.generation,
      buffer_epoch = capture.epoch,
      context_key = request.key,
      filename = capture.document.path,
      document_session = capture.document.session,
      document_version = capture.document.version,
      caret_byte = caret,
      replace_start = first,
      replace_finish = finish,
      prefix = prefix,
      quality = result.quality,
      inputs = inputs,
      scopes = result.scopes,
      candidates = result.candidates,
      hovers = hovers,
    },
    range, volatile_headers, usable)
end

local function Service:run(): nil
  while (self.pending ~= nil or self.pending_hover ~= nil or self.sync_needed) and not self.closed do
    if self.sync_needed then
      self.sync_needed = false
      local epoch = self.buffers:epoch()
      local documents = open_documents(self.buffers:inputs())
      self.store:sync_documents(documents, epoch,
        function (): boolean return not self.closed and self.buffers:epoch() == epoch end)
    end
    if self.pending ~= nil or self.pending_hover ~= nil then
      local request? = self.pending
      if request ~= nil then
        self.pending = nil
      else
        request = self.pending_hover
        self.pending_hover = nil
      end
      if request == nil then raise "completion worker lost its pending request" end
      self.active = request
      do
        local documents = open_documents(request.capture.inputs)
        local current = function (): boolean
          return self:request_current(request) and
            (not request.hover_only or request.capture.document.path == self.hover_path and
              request.capture.document.session == self.hover_session)
        end
        if self.store:sync_documents(documents, request.capture.epoch, current) then
          local task = async.run<|Prepared?, value|>(function (): Prepared? return self:prepare(request) end)
          self.preparation = task
          case async.join(task)
          when succeeded(prepared) then
            if prepared ~= nil and current() then
              -- Unsaved-only headers have no watcher-owned freshness. A later
              -- hover does not run compiler probes, so these facts cannot be
              -- retained as an exact hover context between completion requests.
              local existing? = self.hover_context
              local previous_id: string? = nil
              if existing ~= nil then previous_id = existing.id end
              local keep_source = not request.hover_only and existing ~= nil and existing.source and
                existing.epoch == request.capture.epoch and existing.generation == request.generation and
                existing.module_name == prepared.snapshot.module_name
              -- The writer can commit before this waiter resumes. An intervening
              -- edit must not let the resumed waiter install its old capture.
              if not keep_source and prepared.hover_usable and #prepared.volatile_headers == 0 and current() and
                  self.store:publish_hover(prepared.snapshot, current, previous_id) and current() then
                self.hover_context = hover_context(prepared.snapshot, request.capture, request.hover_only)
              end
              -- Do not expose fresh candidates before their usable hover artifact
              -- is accepted: selecting the snippet can immediately advance the
              -- buffer and cancel publication for this capture.
              if not request.hover_only and current() and self.store:publish(prepared.snapshot, current) and current() then
                self.ready = Ready {
                  id = prepared.snapshot.id,
                  key = request.key,
                  prefix = prepared.snapshot.prefix,
                  range = prepared.range,
                  volatile_headers = prepared.volatile_headers,
                  validated_through = self.requests,
                  filename = request.capture.document.path,
                  session = request.capture.document.session,
                  anchor = strings.sub(request.capture.document.text, 1, prepared.snapshot.replace_start),
                  generation = request.generation,
                }
                self.previous_ready = self.ready
              end
            end
          when failed(failure) then
            logging.emit("debug", "completion.prepare.failure", {["message"] = strings.tostring(failure.error)})
          when cancelled() then
            self.ready = nil
          else
            raise "completion join returned running task"
          end
          self.preparation = nil
        end
      catch
        if error is async.CancellationReason then raise end
        logging.emit("debug", "completion.failure", {["message"] = strings.tostring(error)})
      end
      self.active = nil
    end
  end
  return nil
end

local function Service:schedule_hover()
  local debounce? = self.debounce
  if debounce ~= nil and not debounce:status():has_finished() then
    debounce:cancel(async.CancellationReason.simple("hover refresh superseded"))
  end
  if self.closed or self.hover_path == nil or self.hover_session == 0 then return end
  self.debounce = async.run<|nil, value|>(function (): nil
    timer.sleep(HOVER_DEBOUNCE_MS)
    if self.closed or self.hover_path == nil then return nil end
    local capture? = self.buffers:capture(self.hover_path, source_text.Position(0, 0))
    if capture == nil or capture.document.session ~= self.hover_session then return nil end
    local generation = self.store:saved_generation()
    if generation <= 0 then return nil end
    self.requests = self.requests + 1
    local key = "hover:" .. generation .. ":" .. capture.epoch .. ":" .. self.requests
    -- Explicit completion remains the foreground request. Its preparation can
    -- finish first; source analysis then fills the hole with actual editor text.
    self.pending_hover = Request {
      capture = capture,
      generation = generation,
      module_name = "",
      key = key,
      sequence = self.requests,
      hover_only = true,
    }
    if self.worker == nil or self.worker:status():has_finished() then
      self.worker = async.run<|nil, value|>(self:run)
    end
    return nil
  end)
end

function Service:changed()
  if self.hover_context ~= nil and not self.hover_context:follow(self.buffers:inputs()) then
    self.hover_context = nil
  end
  if self.hover_path ~= nil then
    local capture? = self.buffers:capture(self.hover_path, source_text.Position(0, 0))
    if capture == nil then self.hover_session = 0
    else self.hover_session = capture.document.session end
  end
  if self.ready ~= nil then self.previous_ready = self.ready end
  self.ready = nil
  self.pending = nil
  self.pending_hover = nil
  local task? = self.preparation
  if task ~= nil and not task:status():has_finished() then
    task:cancel(async.CancellationReason.simple("completion inputs changed"))
  end
  self.sync_needed = true
  self:schedule_hover()
  if not self.closed and (self.worker == nil or self.worker:status():has_finished()) then
    self.worker = async.run<|nil, value|>(self:run)
  end
end

-- Ordinary saves retain usable provisional facts. The first accepted view
-- and subsequent configuration changes cannot borrow an earlier baseline.
function Service:saved_changed(generation: integer, configuration_boundary: boolean)
  if self.closed then return end
  if configuration_boundary then
    self.minimum_saved_generation = generation
    self.ready = nil
    self.previous_ready = nil
    self.hover_context = nil
  elseif generation == self.saved_generation then
    return
  end
  self.saved_generation = generation
  self:changed()
end

local function Ready:valid_for(request: Request): boolean
  return self.key == request.key and
    (#self.volatile_headers == 0 or self.validated_through >= request.sequence)
end

local function encode(selected: facts.Selection, range: source_text.Span,
    capture: buffers.Capture, options: lsp.CompletionOptions?): dispatcher.SemanticOutcome
  local items: {lsp.CompletionItem} = {}
  local finish = source_text.coordinate_index(capture.document.text):offset_for_position(range.finish)
  for index = 1, #selected.candidates do
    local candidate = selected.candidates[index]
    items[index] = lsp.CompletionItem {
      label = candidate.label,
      kind = candidate.kind,
      detail = candidate.detail,
      sort_text = strings.format("%04d", index),
      filter_text = candidate.label,
      edit = lsp.TextEdit(range, candidate.label),
      call_snippet = lsp.completion_call_snippet(
        capture.document.text, finish, candidate.call_snippet),
      documentation = candidate.documentation,
    }
  end
  return dispatcher.SemanticOutcome.result(lsp.completion_list_value(
    lsp.CompletionList(selected.is_incomplete, items), options))
end

local function Service:provisional(request: Request): dispatcher.SemanticOutcome?
  local ready?: Ready = self.ready
  if ready == nil then ready = self.previous_ready end
  if ready == nil or ready.generation < self.minimum_saved_generation or
      ready.filename ~= request.capture.document.path or
      ready.session ~= request.capture.document.session then return nil end
  local span? = buffers.identifier_span(request.capture)
  if span == nil or strings.sub(request.capture.document.text, 1, span.bytes.start) ~= ready.anchor then
    return nil
  end
  local selected? = self.store:select_provisional(ready.id, ready.filename, ready.session,
    span.prefix, 200, function (): boolean
      return ready.generation >= self.minimum_saved_generation and self:request_current(request)
    end)
  if selected == nil then return nil end
  logging.emit("debug", "completion.provisional", {["items"] = #selected.candidates})
  return encode(selected, span.range, request.capture, request.options)
end

local function Service:answer(request: Request): dispatcher.SemanticOutcome
  if not self:request_current(request) then return empty() end
  if self.ready == nil or not self.ready:valid_for(request) then
    if self.active == nil or self.active.key ~= request.key then self.pending = request end
    if self.worker == nil or self.worker:status():has_finished() then
      self.worker = async.run<|nil, value|>(self:run)
    end
    local provisional? = self:provisional(request)
    if provisional ~= nil then return provisional end
    -- The request owns no compiler task or scheduler permit. A held hydration
    -- permit therefore yields a bounded, truthful retryable response.
    for _ = 1, 15 do
      if self.ready ~= nil and self.ready:valid_for(request) then break end
      if not self:request_current(request) then return empty() end
      if self.worker:status():has_finished() then break end
      timer.sleep(10)
    end
  end
  local ready? = self.ready
  if ready == nil or not ready:valid_for(request) then return empty() end
  local started = logging.clock()
  local wall = ffi.vscode_titan_monotonic_ms()
  local selected? = self.store:select(ready.id, ready.key, ready.prefix, 200,
    function (): boolean return self:request_current(request) end)
  logging.emit("debug", "completion.select", {
    ["cpu_ms"] = logging.elapsed_ms(started),
    ["wall_ms"] = ffi.vscode_titan_monotonic_ms() - wall,
  })
  if selected == nil then return empty() end
  return encode(selected, ready.range, request.capture, request.options)
end

-- Called by the coordinator before its deferred request Task is created.
-- Both editor inputs and saved rows are captured here, never sampled later.
function Service:capture(request: dispatcher.CompletionRequest): coordinator.CompletionWork
  local capture? = self.buffers:capture(request.params.document.path,
    request.params.document.position)
  if capture == nil or self.closed then return empty end
  local generation = self.store:saved_generation()
  if generation <= 0 then return empty end
  local key = generation .. ":" .. capture.epoch .. ":" .. capture.document.session ..
    ":" .. capture.document.version .. ":" .. capture.position.line .. ":" .. capture.position.character
  self.requests = self.requests + 1
  local captured = Request {
    capture = capture,
    generation = generation,
    module_name = "",
    key = key,
    sequence = self.requests,
    options = request.options,
    hover_only = false,
  }
  if self.hover_path ~= capture.document.path or self.hover_session ~= capture.document.session then
    self.pending_hover = nil
    local debounce? = self.debounce
    if debounce ~= nil and not debounce:status():has_finished() then
      debounce:cancel(async.CancellationReason.simple("active hover document changed"))
    end
    local active? = self.active
    local preparation? = self.preparation
    if active ~= nil and active.hover_only and preparation ~= nil and not preparation:status():has_finished() then
      preparation:cancel(async.CancellationReason.simple("active hover document changed"))
    end
  end
  self.hover_path = capture.document.path
  self.hover_session = capture.document.session
  self.saved_generation = generation
  return function (): dispatcher.SemanticOutcome return self:answer(captured) end
end

-- Query the accepted analysis in its original coordinates, then map an
-- untouched occurrence into the exact request capture. No old row is relabeled
-- as current semantic state; a refresh replaces it when usable facts arrive.
local function Service:read_hover(capture: buffers.Capture,
                                  context: HoverContext): dispatcher.SemanticOutcome?
  local file: HoverFile? = nil
  for index = 1, #context.files do
    local candidate = context.files[index]
    if candidate.original.path == capture.document.path and
        candidate.original.session == capture.document.session and
        candidate.latest == capture.document then file = candidate end
  end
  if file == nil then return nil end
  local coordinates = source_text.coordinate_index(capture.document.text)
  local offset? = coordinates:offset_for_position(capture.position)
  if offset == nil then return dispatcher.SemanticOutcome.result(wire.null()) end
  local original_offset? = file:original_offset(offset)
  if original_offset == nil then return nil end
  local row? = self.store:hover_retained(context.id, capture.document.path,
    capture.document.session, original_offset,
    function (): boolean
      return not self.closed and context.generation >= self.minimum_saved_generation and
        self.buffers:current(capture)
    end)
  if row == nil then return nil end
  local bytes? = file:current_span(row)
  if bytes == nil then return nil end
  local range? = coordinates:span_for_offsets(bytes.start, bytes.finish)
  if range == nil then return dispatcher.SemanticOutcome.result(wire.null()) end
  return dispatcher.SemanticOutcome.result(lsp.hover_value(row.markdown, range))
end

function Service:hover(capture: buffers.Capture): dispatcher.SemanticOutcome?
  for _ = 1, 2 do
    local context? = self.hover_context
    if self.closed or context == nil or not self.buffers:current(capture) then return nil end
    local outcome? = self:read_hover(capture, context)
    if outcome ~= nil then return outcome end
    -- An accepted artifact may change while the lookup waits for SQL. Retained
    -- original rows cover that handoff; retry once also finds a newly available
    -- occurrence that was absent from the previous completion-hole snapshot.
    if self.hover_context == context then return nil end
  end
  return nil
end

function Service:close()
  if self.closed then return end
  self.closed = true
  self:changed()
  self.hover_context = nil
  self.hover_path = nil
  if self.debounce ~= nil then async.join(self.debounce) end
  if self.worker ~= nil then async.join(self.worker) end
  self.store:close()
end
