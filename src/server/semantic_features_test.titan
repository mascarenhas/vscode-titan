function test_semantic_features_folds_incomplete_parseable_saved_source(
    _context: test.Context)
  runtime.run(function ()
    local filename = "/workspace/draft_fold.titan"
    -- This is a valid checked draft despite its empty unfinished branch and
    -- missing trailing newline. Compiler spans, not keyword guessing, own both
    -- structural ranges.
    local contents =
      "function draft(ready: boolean)\n" ..
      "  if ready then\n" ..
      "\n" ..
      "  end\n" ..
      "end"
    local model = features.build({project("draft_fold", {
      bridge.SourceFile.new(filename, contents),
    })}, {snapshot("draft_fold", filename, {filename}, {
      node(1, "Ast.TopLevelFunc", bridge.NodeKind.declaration(),
           filename, 1, 1, "draft", false, nil, nil, nil, nil,
           compiler_span(filename, 1, 1, 5, 1)),
      node(2, "Ast.StatIf", bridge.NodeKind.statement(),
           filename, 2, 3, nil, false, nil, nil, nil, nil,
           compiler_span(filename, 2, 3, 4, 3)),
    }, {})})
    defer model:close()

    local ranges = model:folding_ranges(filename)
    test.assert(#ranges == 2 and
                ranges[1].start_line == 0 and ranges[1].end_line == 3 and
                ranges[2].start_line == 1 and ranges[2].end_line == 2,
                "parseable draft source lost valid compiler-derived folds")
  end)
end

local function rename_fixture(): features.Features
  local main_file = "/workspace/pkg/pkg.titan"
  local part_file = "/workspace/pkg/use.titan"
  local user_file = "/workspace/use.titan"
  local symbol = "export:pkg:answer"
  return features.build({
    project("pkg", {
      bridge.SourceFile.new(main_file, "answer = 1\n"),
      bridge.SourceFile.new(part_file, "local other = answer\n"),
    }),
    project("use", {
      bridge.SourceFile.new(user_file, "local copy = answer\n"),
    }),
  }, {
    snapshot("pkg", main_file, {main_file, part_file}, {}, {
      occurrence(main_file, 1, 1, 7, "answer", symbol,
                 bridge.OccurrenceRole.definition(), false, nil),
      occurrence(part_file, 1, 15, 21, "answer", symbol,
                 bridge.OccurrenceRole.reference(), false, nil),
    }),
    snapshot("use", user_file, {user_file}, {}, {
      occurrence(user_file, 1, 14, 20, "answer", symbol,
                 bridge.OccurrenceRole.reference(), false, nil),
    }),
  })
end

function test_semantic_features_rename_requires_successful_compiler_preflight(
    _context: test.Context)
  runtime.run(function ()
    local model = rename_fixture()
    defer model:close()
    local candidate?, candidate_error? = model:rename(
      "/workspace/pkg/pkg.titan", source_text.Position.new(0, 2), "sum")
    test.assert(candidate_error == nil and candidate ~= nil and
                candidate:source_name() == "answer" and
                candidate:target_name() == "sum",
                "valid rename did not produce an unverified candidate")
    local edited = candidate:edited_project_modules()
    test.assert(find_contents(edited, "/workspace/pkg/pkg.titan") ==
                  "sum = 1\n" and
                find_contents(edited, "/workspace/pkg/use.titan") ==
                  "local other = sum\n" and
                find_contents(edited, "/workspace/use.titan") ==
                  "local copy = sum\n",
                "rename candidate did not edit the complete saved project")

    local renamed = "export:pkg:sum"
    local checked = bridge.Analysis.new("pkg", {}, {
      snapshot("pkg", "/workspace/pkg/pkg.titan", {
        "/workspace/pkg/pkg.titan", "/workspace/pkg/use.titan",
      }, {}, {
        occurrence("/workspace/pkg/pkg.titan", 1, 1, 4, "sum", renamed,
                   bridge.OccurrenceRole.definition(), false, nil),
        occurrence("/workspace/pkg/use.titan", 1, 15, 18, "sum", renamed,
                   bridge.OccurrenceRole.reference(), false, nil),
      }),
      snapshot("use", "/workspace/use.titan", {"/workspace/use.titan"}, {}, {
        occurrence("/workspace/use.titan", 1, 14, 17, "sum", renamed,
                   bridge.OccurrenceRole.reference(), false, nil),
      }),
    }, {}, {}, {})
    local verified?, verification_error? = candidate:preflight(checked)
    test.assert(verification_error == nil and verified ~= nil,
                "consistent compiler bindings did not verify the rename")
    local documents = verified:document_edits()
    test.assert(#documents == 3 and
                documents[1].uri == "file:///workspace/pkg/pkg.titan" and
                documents[2].uri == "file:///workspace/pkg/use.titan" and
                documents[3].uri == "file:///workspace/use.titan" and
                documents[1].edits[1].range.finish.character == 6 and
                documents[1].edits[1].new_text == "sum",
                "verified workspace edits were not deterministic or pre-edit")

    local encoded = lsp.workspace_edit_value(documents)
    test.assert(strings.find(wire.encode(encoded), [["changes"]]) ~= nil,
                "verified rename could not reach the LSP encoding boundary")
  end)
end

function test_semantic_features_rename_rejects_invalid_names_and_capture(
    _context: test.Context)
  runtime.run(function ()
    local model = rename_fixture()
    defer model:close()
    local invalid?, invalid_error? = model:rename(
      "/workspace/pkg/pkg.titan", source_text.Position.new(0, 2), "function")
    test.assert(invalid == nil and invalid_error ~= nil,
                "rename accepted a Titan keyword")

    local candidate?, candidate_error? = model:rename(
      "/workspace/pkg/pkg.titan", source_text.Position.new(0, 2), "sum")
    test.assert(candidate_error == nil and candidate ~= nil,
                "capture fixture did not produce a candidate")
    local exported = "export:pkg:sum"
    local captured = "ast:pkg:/workspace/pkg/use.titan:1:7:sum"
    local split = bridge.Analysis.new("pkg", {}, {
      snapshot("pkg", "/workspace/pkg/pkg.titan", {
        "/workspace/pkg/pkg.titan", "/workspace/pkg/use.titan",
      }, {}, {
        occurrence("/workspace/pkg/pkg.titan", 1, 1, 4, "sum", exported,
                   bridge.OccurrenceRole.definition(), false, nil),
        occurrence("/workspace/pkg/use.titan", 1, 7, 12, "other", captured,
                   bridge.OccurrenceRole.definition(), true, nil),
        occurrence("/workspace/pkg/use.titan", 1, 15, 18, "sum", captured,
                   bridge.OccurrenceRole.reference(), true, nil),
      }),
      snapshot("use", "/workspace/use.titan", {"/workspace/use.titan"}, {}, {
        occurrence("/workspace/use.titan", 1, 14, 17, "sum", exported,
                   bridge.OccurrenceRole.reference(), false, nil),
      }),
    }, {}, {}, {})
    local verified?, capture_error? = candidate:preflight(split)
    test.assert(verified == nil and capture_error ~= nil and
                strings.find(capture_error.message, "capture") ~= nil,
                "compiler-observed capture did not reject all edits")

    local diagnostics = bridge.Analysis.new("pkg", {
      bridge.Diagnostic.new(
        bridge.DiagnosticKind.type_error(), "duplicate declaration", nil),
    }, {}, {}, {}, {})
    local diagnostic_result?, diagnostic_error? =
      candidate:preflight(diagnostics)
    test.assert(diagnostic_result == nil and diagnostic_error ~= nil,
                "compiler diagnostics did not reject the rename candidate")
  end)
end

local function assert_materialized_view(view: features.Features, filename: string)
  local at = source_text.Position.new(24, 2)
  local hover? = view:hover(filename, at)
  test.assert(hover ~= nil and hover.inferred_type ~= nil and
    hover.inferred_type.display == "integer" and hover.declared_type ~= nil and
    hover.declared_type.display == "value" and hover.original_type ~= nil and
    hover.original_type.display == "integer" and hover.coerced_type ~= nil and
    hover.coerced_type.display == "float",
    "materialized hover batch lost an optional type view")
  local definition? = view:definition(filename, at)
  test.assert(definition ~= nil and definition.range.start.line == 24,
    "reopened definition did not use its saved occurrence")
  test.assert(#view:references(filename, at, true) == 1,
    "reopened references did not use their saved identity")
  local folds = view:folding_ranges(filename)
  test.assert(#folds == 1 and folds[1].start_line == 0 and folds[1].end_line == 24,
    "materialized fold did not survive publication")
  local candidate?, failure? = view:rename(filename, at, "replacement")
  test.assert(candidate ~= nil and failure == nil,
    "reopened rename could not reconstruct the published source")
  test.assert(strings.find(find_contents(candidate:edited_project_modules(), filename),
    "replacement\nend\n", 1, true) ~= nil,
    "reopened rename edited the wrong source token")
end

local function materialized_roundtrip(path: string)
  local filename = "/workspace/materialized.titan"
  local output = strings.writer()
  local nodes: {bridge.Node} = {}
  local symbols: {bridge.SymbolOccurrence} = {}
  local integer_type = bridge.TypeInfo.new("Type.Integer", "integer")
  local value_type = bridge.TypeInfo.new("Type.Value", "value")
  local float_type = bridge.TypeInfo.new("Type.Float", "float")
  for index = 1, 25 do
    local name = "item" .. index
    output:write(name .. "\n")
    nodes[index] = node(index, "Ast.Decl", bridge.NodeKind.declaration(),
      filename, index, 1, name, false, integer_type, value_type,
      integer_type, float_type, nil)
    symbols[index] = occurrence(filename, index, 1, #name + 1, name,
      "identity\0" .. index, bridge.OccurrenceRole.definition(), false, integer_type)
  end
  output:write("end\n")
  nodes[26] = node(26, "Ast.TopLevelFunc", bridge.NodeKind.declaration(),
    filename, 1, 1, nil, false, nil, nil, nil, nil,
    compiler_span(filename, 1, 1, 26, 1))
  local saved = project("materialized", {bridge.SourceFile.new(filename, output:drain())})
  local prepared = features.prepare({saved}, {
    snapshot("materialized", filename, {filename}, nodes, symbols),
  })
  local store = stores.open(path)
  defer store:close()
  do
    local access = store:acquire()
    defer access:release()
    features.initialize_schema(access.connection)
    stores.execute(access.connection, "CREATE TEMP TABLE semantic_occurrences(unrelated INTEGER)")
    stores.execute(access.connection, "CREATE TEMP TABLE semantic_hovers(unrelated INTEGER)")
    access.connection:set_autocommit(false)
    prepared:publish(access.connection)
    stores.execute(access.connection,
      "UPDATE main.store_state SET published_generation=4 WHERE singleton=1")
    access.connection:commit()
  end
  -- Mutating extraction input cannot affect the durable query view.
  nodes[25] = node(25, "Ast.Decl", bridge.NodeKind.declaration(),
    filename, 25, 1, "item25", false, float_type, float_type, nil, nil, nil)
  local view = features.open(store, 4)
  assert_materialized_view(view, filename)
  local invalid = features.prepare({saved}, {
    snapshot("materialized", filename, {filename}, {}, {
      symbols[1], occurrence(filename, 1, 1, 6, "item1", "other",
        bridge.OccurrenceRole.reference(), false, integer_type),
    }),
  })
  do
    local access = store:acquire()
    defer access:release()
    access.connection:set_autocommit(false)
    local rejected = false
    do
      invalid:publish(access.connection)
    catch
      rejected = true
      test.assert(error is indexer.Error, "invalid publication did not report a semantic error")
    end
    access.connection:rollback()
    test.assert(rejected, "overlapping publication unexpectedly succeeded")
  end
  assert_materialized_view(view, filename)
  do
    local access = store:acquire()
    defer access:release()
    stores.execute(access.connection,
      "UPDATE main.store_state SET published_generation=5 WHERE singleton=1")
  end
  local stale = false
  do
    view:folding_ranges(filename)
  catch
    stale = true
    test.assert(error is indexer.StaleView, "old query facade did not report its stale generation")
  end
  test.assert(stale, "old query facade read a newer publication")
  store:close()
  if path ~= ":memory:" then
    local reopened = stores.open(path)
    defer reopened:close()
    assert_materialized_view(features.open(reopened, 5), filename)
  end
end

function test_semantic_features_materialization_rollback_and_file_reopen(
    _context: test.Context)
  runtime.run(function ()
    materialized_roundtrip(":memory:")
    local path = fs.tmpname()
    defer fs.unlink(path)
    materialized_roundtrip(path)
  end)
end
