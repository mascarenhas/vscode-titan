      bridge.SourceFile.new(filename, contents),
    })}, {snapshot("equal_fold", filename, {filename}, {
      node(1, "Ast.TopLevelFunc", bridge.NodeKind.declaration(),
           filename, 1, 1, "first", false, nil, nil, nil, nil,
           compiler_span(filename, 1, 1, 4, 1)),
