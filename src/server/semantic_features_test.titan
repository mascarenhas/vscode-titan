function test_semantic_features_uses_half_open_structural_folding_spans(
    _context: test.Context)
  runtime.run(function ()
    local filename = "/workspace/fold.titan"
    local external_file = "/vendor/fold.titan"
    local contents =
      "function outer()\n" ..
      "  if ready then\n" ..
      "    local callback = function()\n" ..
      "      work()\n" ..
      "    end\n" ..
      "    do\n" ..
      "      work()\n" ..
      "    end\n" ..
      "  end\n" ..
      "end\n"
    local outer_span = compiler_span(filename, 1, 1, 10, 1)
    local model = features.build({project("fold", {
      bridge.SourceFile.new(filename, contents),
    })}, {
      external_snapshot("vendor.fold", external_file, {
        node(1, "Ast.TopLevelFunc", bridge.NodeKind.declaration(),
             external_file, 1, 10, "outside", false, nil, nil, nil, nil,
             compiler_span(external_file, 1, 1, 5, 1)),
      }, {}),
      snapshot("fold", filename, {filename}, {
        node(1, "Ast.TopLevelFunc", bridge.NodeKind.declaration(),
             filename, 1, 10, "outer", false, nil, nil, nil, nil,
             outer_span),
        -- A duplicate parser carrier is normalized to one structural range.
        node(2, "Ast.StatBlock", bridge.NodeKind.statement(),
             filename, 1, 1, nil, false, nil, nil, nil, nil, outer_span),
        node(3, "Ast.StatIf", bridge.NodeKind.statement(),
             filename, 2, 3, nil, false, nil, nil, nil, nil,
             compiler_span(filename, 2, 3, 9, 3)),
        node(4, "Ast.ExpFunction", bridge.NodeKind.expression(),
             filename, 3, 22, nil, false, nil, nil, nil, nil,
             compiler_span(filename, 3, 22, 5, 5)),
        -- Catch/defer lowering can make a source `do` or module initializer a
        -- StatTry while preserving the parser's exact structure span.
        node(5, "Ast.StatTry", bridge.NodeKind.statement(),
             filename, 6, 5, nil, false, nil, nil, nil, nil,
             compiler_span(filename, 6, 5, 8, 5)),
        -- A closing keyword on the following line leaves no body line to fold.
        node(6, "Ast.StatBlock", bridge.NodeKind.statement(),
             filename, 1, 1, nil, false, nil, nil, nil, nil,
             compiler_span(filename, 1, 1, 2, 3)),
      }, {}),
    })
    defer model:close()

    local ranges = model:folding_ranges(filename)
    test.assert(#ranges == 4 and
                ranges[1].start_line == 0 and ranges[1].end_line == 8 and
                ranges[2].start_line == 1 and ranges[2].end_line == 7 and
                ranges[3].start_line == 2 and ranges[3].end_line == 3 and
                ranges[4].start_line == 5 and ranges[4].end_line == 6 and
                ranges[1].kind == nil and ranges[2].kind == nil and
                ranges[3].kind == nil and ranges[4].kind == nil,
                "structural folds did not retain closing keyword lines")
    test.assert(#model:folding_ranges(external_file) == 0,
                "external source contributed folding ranges")
  end)
end

function test_semantic_features_folds_multiline_comments_only(
    _context: test.Context)
  runtime.run(function ()
    local filename = "/workspace/comment_fold.titan"
    local contents =
      "--[=[\n" ..
      "header 😀\n" ..
      "details\n" ..
      "]=]\n" ..
      "local quoted = \"--[[not a comment]]\"\n" ..
      "local long = [==[\n" ..
      "--[[also not a comment]]\n" ..
      "]==]\n" ..
      "function work()\n" ..
      "  --[[\n" ..
      "  body\n" ..
      "  ]]\n" ..
      "end\n"
    local model = features.build({project("comment_fold", {
      bridge.SourceFile.new(filename, contents),
    })}, {snapshot("comment_fold", filename, {filename}, {
      node(1, "Ast.TopLevelFunc", bridge.NodeKind.declaration(),
           filename, 9, 1, "work", false, nil, nil, nil, nil,
           compiler_span(filename, 9, 1, 13, 1)),
    }, {})})
    defer model:close()

    local ranges = model:folding_ranges(filename)
    test.assert(#ranges == 3 and
                ranges[1].start_line == 0 and ranges[1].end_line == 3 and
                ranges[1].kind == "comment" and
                ranges[2].start_line == 8 and ranges[2].end_line == 11 and
                ranges[2].kind == nil and
                ranges[3].start_line == 9 and ranges[3].end_line == 11 and
                ranges[3].kind == "comment",
                "multiline comment folds were missing or string text folded")
  end)
end

function test_semantic_features_deduplicates_equal_comment_and_structural_folds(
    _context: test.Context)
