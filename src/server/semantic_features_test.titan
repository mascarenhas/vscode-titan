local strings = import "string"
local fs = import "fs"
local stores = import "server.workspace_store"
local indexer = import "server.semantic_index"
local test = import "test"
local runtime = import "server.test_runtime"
local bridge = import "server.compiler_bridge"
local features = import "server.semantic_features"
local wire = import "server.wire"
local lsp = import "server.lsp_types"
local source_text = import "server.source_text"

local function location(filename: string, line: integer,
                        column: integer): bridge.SourceLocation
  return bridge.SourceLocation.new(filename, line, column)
end

local function compiler_span(filename: string,
                             start_line: integer, start_column: integer,
                             finish_line: integer, finish_column: integer):
    bridge.SourceSpan
  return bridge.SourceSpan.new(
    location(filename, start_line, start_column),
    location(filename, finish_line, finish_column))
end

local function occurrence(filename: string, line: integer,
                          start_column: integer, finish_column: integer,
                          name: string, declaration_id: string?,
                          role: bridge.OccurrenceRole,
                          is_local: boolean,
                          type_info: bridge.TypeInfo?,
                          callable_signature: bridge.CallableSignature?,
                          summary_id: integer?,
                          visibility: bridge.DeclarationVisibility?):
    bridge.SymbolOccurrence
  local start = location(filename, line, start_column)
  local resolved_visibility? = visibility
  if resolved_visibility == nil then
    if is_local then
      resolved_visibility = bridge.DeclarationVisibility.block()
    else
      resolved_visibility = bridge.DeclarationVisibility.exported()
    end
  end
  return bridge.SymbolOccurrence.new(
    name, declaration_id, role, start,
    bridge.SourceSpan.new(
      start, location(filename, line, finish_column)),
    is_local, resolved_visibility, type_info, callable_signature, summary_id)
end

local function visibility_name(
    visibility: bridge.DeclarationVisibility): string
  case visibility
  when block() then return "block"
  when module() then return "module"
  when exported() then return "exported"
  end
end

local function node(id: integer, tag: string, kind: bridge.NodeKind,
                    filename: string, line: integer, column: integer,
                    name: string?, is_local: boolean,
                    inferred: bridge.TypeInfo?,
                    declared: bridge.TypeInfo?,
                    original: bridge.TypeInfo?,
                    coerced: bridge.TypeInfo?,
                    source_span: bridge.SourceSpan?): bridge.Node
  return bridge.Node.new(
    id, nil, tag, kind, location(filename, line, column), source_span,
    name, is_local, false, inferred, declared, original, coerced, nil)
end

local function child_node(id: integer, parent_id: integer, tag: string,
                          kind: bridge.NodeKind, filename: string,
                          line: integer, column: integer, name: string?,
                          is_local: boolean, inferred: bridge.TypeInfo?,
                          declared: bridge.TypeInfo?,
                          original: bridge.TypeInfo?,
                          coerced: bridge.TypeInfo?): bridge.Node
  return bridge.Node.new(
    id, parent_id, tag, kind, location(filename, line, column), nil,
    name, is_local, false, inferred, declared, original, coerced, nil)
end

local function project(module_name: string,
                       files: {bridge.SourceFile}): bridge.ProjectModule
  return bridge.ProjectModule.new(module_name, files)
end

local function snapshot(module_name: string, main_file: string,
                        source_files: {string}, nodes: {bridge.Node},
                        symbols: {bridge.SymbolOccurrence},
                        hover_summaries: {bridge.HoverSummary}?):
    bridge.ModuleSnapshot
  return bridge.ModuleSnapshot.new(
    module_name,
    bridge.Provenance.project_source(
      main_file, source_files),
    nil, nodes, symbols, {}, {}, hover_summaries, nil)
end

local function external_snapshot(module_name: string, filename: string,
                                 nodes: {bridge.Node},
                                 symbols: {bridge.SymbolOccurrence}):
    bridge.ModuleSnapshot
  return bridge.ModuleSnapshot.new(
    module_name,
    bridge.Provenance.external_source(
      filename, {filename}),
    nil, nodes, symbols, {}, {}, nil, nil)
end

local function find_contents(projects: {bridge.ProjectModule},
                             filename: string): string?
  for module_index = 1, #projects do
    for file_index = 1, #projects[module_index].files do
      local file = projects[module_index].files[file_index]
      if file.filename == filename then return file.contents end
    end
  end
  return nil
end

function test_semantic_features_reports_index_build_context(
    _context: test.Context)
  runtime.run(function ()
    local filename = "/workspace/invalid-index.titan"
    local rejected = false
    do
      features.build({project("invalid_index", {
        bridge.SourceFile.new(filename, "local item = 1\n"),
      })}, {snapshot("invalid_index", filename, {filename}, {}, {
        occurrence(filename, 1, 7, 11, "wrong", "local:item",
                   bridge.OccurrenceRole.definition(), true, nil),
      })})
    catch
      rejected = true
      test.assert(error is features.Error,
                  "index build failure escaped the semantic feature boundary")
      local failure = error as features.Error
      test.assert(strings.find(failure.message,
                               "Titan module 'invalid_index'") ~= nil and
                  strings.find(failure.message, filename) ~= nil and
                  strings.find(failure.message,
                               "saved source does not contain identifier") ~= nil,
                  failure.message)
    end
    test.assert(rejected, "invalid index unexpectedly built semantic features")
  end)
end

function test_semantic_features_reuses_indexed_file_coordinates(
    _context: test.Context)
  runtime.run(function ()
    local files: {bridge.SourceFile} = {}
    local filenames: {string} = {}
    for index = 1, 8 do
      local filename = "/workspace/reuse" .. index .. ".titan"
      filenames[index] = filename
      files[index] = bridge.SourceFile.new(
        filename, strings.rep("a", 1100) .. "\n")
    end

    local yield_count = 0
    local model = features.build_with_yield({
      project("coordinate_reuse", files),
    }, {
      snapshot("coordinate_reuse", filenames[1], filenames, {}, {}),
    }, function () yield_count = yield_count + 1 end)
    defer model:close()
    test.assert(#model:folding_ranges(filenames[1]) == 0,
                "coordinate-reuse fixture unexpectedly produced folds")
    test.assert(yield_count == 16,
                "coordinate decoding and comment extraction did not share bounded work")
  end)
end

local function update_plan(store: stores.Store,
                           modules: {indexer.ModulePublication}): indexer.PublicationPlan
  local access = store:acquire()
  defer access:release()
  return indexer.publication_plan(access.connection, modules)
end

local function publish_update(store: stores.Store,
                              projects: {bridge.ProjectModule},
                              snapshots: {bridge.ModuleSnapshot},
                              modules: {indexer.ModulePublication}): features.Features
  local plan = update_plan(store, modules)
  local prepared = features.prepare_update(projects, snapshots, plan)
  local generation = 0
  do
    local access = store:acquire()
    defer access:release()
    local connection = access.connection
    generation = stores.scalar_integer(connection,
      "SELECT published_generation FROM main.store_state WHERE singleton=1") + 1
    connection:set_autocommit(false)
    defer do
      if not connection:get_autocommit() then connection:rollback() end
    end
    features.initialize_schema(connection)
    prepared:publish(connection)
    stores.execute(connection,
      "UPDATE main.store_state SET published_generation=? WHERE singleton=1", generation)
    connection:commit()
  end
  return features.open(store, generation)
end

local function module_facts(module_name: string, filenames: {string},
                            names: {string}, type_info: bridge.TypeInfo): bridge.ModuleSnapshot
  local nodes: {bridge.Node} = {}
  local symbols: {bridge.SymbolOccurrence} = {}
  for index = 1, #filenames do
    local filename, name = filenames[index], names[index]
    nodes[#nodes + 1] = node(index * 2 - 1, "Ast.Decl", bridge.NodeKind.declaration(),
      filename, 1, 1, name, false, type_info, nil, nil, nil, nil)
    nodes[#nodes + 1] = node(index * 2, "Ast.TopLevelFunc", bridge.NodeKind.declaration(),
      filename, 1, 1, nil, false, nil, nil, nil, nil,
      compiler_span(filename, 1, 1, 3, 1))
    symbols[index] = occurrence(filename, 1, 1, #name + 1, name,
      "export:" .. module_name .. ":value:" .. name,
      bridge.OccurrenceRole.definition(), false, type_info)
  end
  return snapshot(module_name, filenames[1], filenames, nodes, symbols)
end

function test_semantic_features_retains_unchanged_facts_and_prunes_old_file_owners(
    _context: test.Context)
  runtime.run(function ()
    local store = stores.open(":memory:")
    defer store:close()
    local main_file, old_file = "/workspace/folder/main.titan", "/workspace/folder/old.titan"
    local keep_file = "/workspace/keep.titan"
    local main = bridge.SourceFile.new(main_file, "first\nbody\nend\n")
    local old = bridge.SourceFile.new(old_file, "second\nbody\nend\n")
    local keep = bridge.SourceFile.new(keep_file, "third\nbody\nend\n")
    local a = project("folder", {main, old})
    local b = project("keep", {keep})
    local integer_type = bridge.TypeInfo.new("Type.Integer", "integer")
    local string_type = bridge.TypeInfo.new("Type.String", "string")
    publish_update(store, {a, b}, {
      module_facts("folder", {main_file, old_file}, {"first", "second"}, integer_type),
      module_facts("keep", {keep_file}, {"third"}, integer_type),
    }, {indexer.ModulePublication.new("folder", 1, 2), indexer.ModulePublication.new("keep", 2, 2)})
    do
      local access = store:acquire()
      defer access:release()
      stores.execute(access.connection,
        "CREATE TEMP TRIGGER retain_hovers BEFORE DELETE ON main.semantic_hovers " ..
        "WHEN OLD.filename=CAST('/workspace/keep.titan' AS BLOB) " ..
        "BEGIN SELECT RAISE(ABORT,'retained hover'); END")
      stores.execute(access.connection,
        "CREATE TEMP TRIGGER retain_folds BEFORE DELETE ON main.semantic_folds " ..
        "WHEN OLD.filename=CAST('/workspace/keep.titan' AS BLOB) " ..
        "BEGIN SELECT RAISE(ABORT,'retained fold'); END")
    end
    a = project("folder", {main})
    local view = publish_update(store, {a, b}, {
      module_facts("folder", {main_file}, {"first"}, string_type),
    }, {indexer.ModulePublication.new("folder", 3, 2), indexer.ModulePublication.new("keep", 2, 2)})
    local at = source_text.Position.new(0, 1)
    local retained? = view:hover(keep_file, at)
    local replaced? = view:hover(main_file, at)
    test.assert(retained ~= nil and retained.inferred_type ~= nil and
      retained.inferred_type.display == "integer" and #view:folding_ranges(keep_file) == 1,
      "unchanged module lost its materialized hover or fold without an AST")
    test.assert(replaced ~= nil and replaced.inferred_type ~= nil and
      replaced.inferred_type.display == "string" and #view:folding_ranges(main_file) == 1,
      "changed module did not replace its materialized type facts")
    test.assert(view:hover(old_file, at) == nil and #view:folding_ranges(old_file) == 0,
      "removed constituent retained facts after its old file ownership disappeared")
    local candidate?, rename_error? = view:rename(keep_file, at, "renamed")
    test.assert(candidate ~= nil and rename_error == nil,
      "retained SQL facts could not create a rename candidate")
    local edited = candidate:edited_project_modules()
    test.assert(#edited == 2 and find_contents(edited, main_file) == main.contents and
      find_contents(edited, old_file) == nil and
      find_contents(edited, keep_file) == "renamed\nbody\nend\n",
      "rename preflight lost complete current saved membership after retention")
    local removed = publish_update(store, {b}, {}, {indexer.ModulePublication.new("keep", 2, 2)})
    test.assert(removed:hover(main_file, at) == nil and #removed:folding_ranges(main_file) == 0 and
      removed:hover(keep_file, at) ~= nil and #removed:folding_ranges(keep_file) == 1,
      "module deletion pruned the wrong owner's materialized facts")
  end)
end

function test_semantic_features_rebuilds_all_facts_after_missing_file_ownership(
    _context: test.Context)
  runtime.run(function ()
    local store = stores.open(":memory:")
    defer store:close()
    local clean_file = "/workspace/clean.titan"
    local failed_file = "/workspace/failed.titan"
    local removed_file = "/workspace/removed.titan"
    local clean = project("clean", {bridge.SourceFile.new(clean_file, "first\nbody\nend\n")})
    local failed = project("failed", {bridge.SourceFile.new(failed_file, "local broken = missing\n")})
    local removed = project("removed", {bridge.SourceFile.new(removed_file, "old\nbody\nend\n")})
    local integer_type = bridge.TypeInfo.new("Type.Integer", "integer")
    publish_update(store, {clean, failed, removed}, {
      module_facts("clean", {clean_file}, {"first"}, integer_type),
      module_facts("removed", {removed_file}, {"old"}, integer_type),
    }, {
      indexer.ModulePublication.new("clean", 1, 2),
      indexer.ModulePublication.new("failed", 2, 3),
      indexer.ModulePublication.new("removed", 3, 2),
    })
    do
      local access = store:acquire()
      defer access:release()
      stores.execute(access.connection, "DROP TABLE main.semantic_files")
    end
    clean = project("clean", {bridge.SourceFile.new(clean_file, "first\n")})
    local view = publish_update(store, {clean, failed}, {
      snapshot("clean", clean_file, {clean_file}, {
        node(1, "Ast.Decl", bridge.NodeKind.declaration(), clean_file, 1, 1,
          "first", false, integer_type, nil, nil, nil, nil),
      }, {
        occurrence(clean_file, 1, 1, 6, "first", "export:clean:value:first",
          bridge.OccurrenceRole.definition(), false, integer_type),
      }),
    }, {
      indexer.ModulePublication.new("clean", 4, 2),
      indexer.ModulePublication.new("failed", 2, 3),
    })
    local at = source_text.Position.new(0, 1)
    test.assert(view:hover(clean_file, at) ~= nil and
      view:hover(removed_file, at) == nil and
      #view:folding_ranges(clean_file) == 0 and
      #view:folding_ranges(removed_file) == 0,
      "lost file ownership retained old folds or a removed module's hover")
    local candidate?, rename_error? = view:rename(clean_file, at, "renamed")
    test.assert(candidate ~= nil and rename_error == nil,
      "rebuilt clean facts did not support rename preparation")
    local edited = candidate:edited_project_modules()
    test.assert(#edited == 2 and find_contents(edited, clean_file) == "renamed\n" and
      find_contents(edited, failed_file) == failed.files[1].contents and
      find_contents(edited, removed_file) == nil,
      "recovery omitted the unchanged failed source from complete rename preflight")
    local access = store:acquire()
    defer access:release()
    test.assert(stores.scalar_integer(access.connection,
      "SELECT COUNT(*) FROM main.semantic_hovers") == 1 and
      stores.scalar_integer(access.connection, "SELECT COUNT(*) FROM main.semantic_folds") == 0,
      "recovery left orphaned feature rows without their old file ownership")
  end)
end

function test_semantic_features_rejects_stale_update_before_pruning(
    _context: test.Context)
  runtime.run(function ()
    local store = stores.open(":memory:")
    defer store:close()
    local a_file, b_file = "/workspace/a.titan", "/workspace/b.titan"
    local a = project("a", {bridge.SourceFile.new(a_file, "first\nbody\nend\n")})
    local b = project("b", {bridge.SourceFile.new(b_file, "second\nbody\nend\n")})
    local integer_type = bridge.TypeInfo.new("Type.Integer", "integer")
    local string_type = bridge.TypeInfo.new("Type.String", "string")
    publish_update(store, {a, b}, {
      module_facts("a", {a_file}, {"first"}, integer_type),
      module_facts("b", {b_file}, {"second"}, integer_type),
    }, {indexer.ModulePublication.new("a", 1, 2), indexer.ModulePublication.new("b", 2, 2)})
    local stale_plan = update_plan(store, {
      indexer.ModulePublication.new("a", 3, 2), indexer.ModulePublication.new("b", 2, 2),
    })
    local obsolete = features.prepare_update({a, b}, {
      module_facts("a", {a_file}, {"first"}, string_type),
    }, stale_plan)
    local current = publish_update(store, {a, b}, {
      module_facts("b", {b_file}, {"second"}, string_type),
    }, {indexer.ModulePublication.new("a", 1, 2), indexer.ModulePublication.new("b", 4, 2)})
    do
      local access = store:acquire()
      defer access:release()
      local connection = access.connection
      connection:set_autocommit(false)
      defer connection:rollback()
      local rejected = false
      do
        obsolete:publish(connection)
      catch
        rejected = error is indexer.StaleView
      end
      test.assert(rejected, "obsolete module plan overwrote a newer completed view")
      -- Inspect before rollback: a fence inside index publication alone would
      -- run after feature pruning and leave this transaction partially changed.
      test.assert(stores.scalar_integer(connection, "SELECT COUNT(*) FROM main.semantic_hovers") == 2 and
        stores.scalar_integer(connection, "SELECT COUNT(*) FROM main.semantic_folds") == 2 and
        stores.scalar_integer(connection, "SELECT COUNT(*) FROM main.semantic_occurrences") == 2,
        "stale publication mutated facts before checking its completed generation")
    end
    local at = source_text.Position.new(0, 1)
    test.assert(current:hover(a_file, at).inferred_type.display == "integer" and
      current:hover(b_file, at).inferred_type.display == "string",
      "obsolete update changed the preceding accepted module facts")
  end)
end

function test_semantic_features_definition_and_all_project_references(
    _context: test.Context)
  runtime.run(function ()
    local main_file = "/workspace/pkg/pkg.titan"
    local part_file = "/workspace/pkg/use.titan"
    local user_file = "/workspace/use.titan"
    local symbol = "export:pkg:answer"
    local model = features.build({
      project("use", {
        bridge.SourceFile.new(
          user_file, "-- 😀\nlocal item = answer\n"),
      }),
      project("pkg", {
        bridge.SourceFile.new(main_file, "answer = 1\n"),
        bridge.SourceFile.new(part_file, "local copy = answer\n"),
      }),
    }, {
      snapshot("use", user_file, {user_file}, {}, {
        occurrence(user_file, 2, 14, 20, "answer", symbol,
                   bridge.OccurrenceRole.reference(), false, nil),
      }),
      snapshot("pkg", main_file, {main_file, part_file}, {}, {
        occurrence(part_file, 1, 14, 20, "answer", symbol,
                   bridge.OccurrenceRole.reference(), false, nil),
        occurrence(main_file, 1, 1, 7, "answer", symbol,
                   bridge.OccurrenceRole.definition(), false, nil),
      }),
    })
    defer model:close()

    local definition? = model:definition(
      user_file, source_text.Position.new(1, 16))
    test.assert(definition ~= nil and
                definition.uri == "file:///workspace/pkg/pkg.titan" and
                definition.range.start.line == 0 and
                definition.range.start.character == 0 and
                definition.range.finish.character == 6,
                "definition did not remain project-only and exact")

    local without = model:references(
      user_file, source_text.Position.new(1, 16), false)
    test.assert(#without == 2 and
                without[1].uri == "file:///workspace/pkg/use.titan" and
                without[2].uri == "file:///workspace/use.titan",
                "references did not exclude the declaration or sort by path")
    local with_declaration = model:references(
      user_file, source_text.Position.new(1, 16), true)
    test.assert(#with_declaration == 3 and
                with_declaration[1].uri ==
                  "file:///workspace/pkg/pkg.titan",
                "includeDeclaration did not include the project definition")
  end)
end

function test_semantic_features_excludes_external_definition_locations(
    _context: test.Context)
  runtime.run(function ()
    local project_file = "/workspace/main.titan"
    local external_file = "/vendor/dep.titan"
    local symbol = "export:vendor.dep:remote"
    local model = features.build({project("main", {
      bridge.SourceFile.new(project_file, "local x = remote\n"),
    })}, {
      external_snapshot("vendor.dep", external_file, {}, {
        occurrence(external_file, 1, 1, 7, "remote", symbol,
                   bridge.OccurrenceRole.definition(), false, nil),
      }),
      snapshot("main", project_file, {project_file}, {}, {
        occurrence(project_file, 1, 11, 17, "remote", symbol,
                   bridge.OccurrenceRole.reference(), false, nil),
      }),
    })
    defer model:close()

    local definition? = model:definition(
      project_file, source_text.Position.new(0, 12))
    test.assert(definition == nil,
                "definition navigation escaped into external source")
    local references = model:references(
      project_file, source_text.Position.new(0, 12), true)
    test.assert(#references == 1 and
                references[1].uri == "file:///workspace/main.titan",
                "external source leaked into all-project references")
    local rename?, rename_error? = model:rename(
      project_file, source_text.Position.new(0, 12), "renamed")
    test.assert(rename == nil and rename_error ~= nil and
                strings.find(rename_error.message, "outside project") ~= nil,
                "rename accepted an externally declared symbol")
  end)
end

function test_semantic_features_hover_preserves_compiler_type_views(
    _context: test.Context)
  runtime.run(function ()
    local filename = "/workspace/hover.titan"
    local integer_type = bridge.TypeInfo.new("Type.Integer", "integer")
    local float_type = bridge.TypeInfo.new("Type.Float", "float")
    local symbol = "ast:hover:/workspace/hover.titan:1:7:count"
    local model = features.build({project("hover", {
      bridge.SourceFile.new(filename, "local count: float = 1\n"),
    })}, {snapshot("hover", filename, {filename}, {
      node(1, "Ast.Decl", bridge.NodeKind.declaration(),
           filename, 1, 7, "count", true, float_type, float_type,
           integer_type, float_type, nil),
    }, {
      occurrence(filename, 1, 7, 12, "count", symbol,
                 bridge.OccurrenceRole.definition(), true, float_type),
    })})
    defer model:close()

    local hover? = model:hover(filename, source_text.Position.new(0, 8))
    test.assert(hover ~= nil and hover.inferred_type ~= nil and
                hover.inferred_type.display == "float" and
                hover.declared_type ~= nil and
                hover.original_type ~= nil and
                hover.original_type.display == "integer" and
                hover.coerced_type ~= nil and
                visibility_name(hover.visibility) == "block",
                "hover lost typed compiler metadata or local status")
    test.assert(hover:markdown() ==
      "- Type: `float`\n" ..
      "- Visibility: block\n",
      "hover markdown repeated equivalent declared and inferred types")
  end)
end

function test_semantic_features_hover_matches_nodes_after_unicode_prefix(
    _context: test.Context)
  runtime.run(function ()
    local filename = "/workspace/unicode_hover.titan"
    local integer_type = bridge.TypeInfo.new("Type.Integer", "integer")
    local symbol = "ast:unicode-hover:count"
    local model = features.build({project("unicode_hover", {
      bridge.SourceFile.new(filename, "-- 😀 count\n"),
    })}, {snapshot("unicode_hover", filename, {filename}, {
      node(1, "Ast.VarName", bridge.NodeKind.variable(),
           filename, 1, 9, "count", true, integer_type, nil,
           nil, nil, nil),
    }, {
      occurrence(filename, 1, 9, 14, "count", symbol,
                 bridge.OccurrenceRole.reference(), true, integer_type),
    })})
    defer model:close()

    local hover? = model:hover(filename, source_text.Position.new(0, 7))
    test.assert(hover ~= nil and hover.inferred_type ~= nil and
                hover.inferred_type.display == "integer" and
                hover.range.start.character == 6 and
                hover.range.finish.character == 11,
                "hover did not reuse UTF-16 coordinates for compiler byte columns")
  end)
end

function test_semantic_features_hover_reads_unnamed_adjustment_ancestors(
    _context: test.Context)
  runtime.run(function ()
    local filename = "/workspace/ancestor_hover.titan"
    local integer_type = bridge.TypeInfo.new("Type.Integer", "integer")
    local float_type = bridge.TypeInfo.new("Type.Float", "float")
    local symbol = "ast:hover:/workspace/ancestor_hover.titan:1:7:count"
    local model = features.build({project("hover", {
      bridge.SourceFile.new(filename,
        "local count = 1\nlocal result = count as float\n"),
    })}, {snapshot("hover", filename, {filename}, {
      node(1, "Ast.Decl", bridge.NodeKind.declaration(),
           filename, 1, 7, "count", true, integer_type, integer_type,
           nil, nil, nil),
      node(2, "Ast.ExpCast", bridge.NodeKind.expression(),
           filename, 2, 16, nil, true, float_type, nil,
           integer_type, float_type, nil),
      child_node(3, 2, "Ast.ExpVar", bridge.NodeKind.expression(),
                 filename, 2, 16, nil, true, integer_type, nil,
                 nil, nil),
      child_node(4, 3, "Ast.VarName", bridge.NodeKind.variable(),
                 filename, 2, 16, "count", true, integer_type, nil,
                 nil, nil),
    }, {
      occurrence(filename, 1, 7, 12, "count", symbol,
                 bridge.OccurrenceRole.definition(), true, integer_type),
      occurrence(filename, 2, 16, 21, "count", symbol,
                 bridge.OccurrenceRole.reference(), true, integer_type),
    })})
    defer model:close()

    local hover? = model:hover(filename, source_text.Position.new(1, 17))
    test.assert(hover ~= nil and hover.inferred_type ~= nil and
                hover.inferred_type.display == "integer" and
                hover.original_type ~= nil and
                hover.original_type.display == "integer" and
                hover.coerced_type ~= nil and
                hover.coerced_type.display == "float",
                "hover ignored coercion metadata on an unnamed ancestor")
    test.assert(hover:markdown() ==
                  "- Type: `integer`\n" ..
                  "- Cast to: `float`\n" ..
                  "- Visibility: block\n",
                "hover did not render the distinct enclosing cast target")
  end)
end

function test_semantic_features_hover_prefers_named_callable_signatures(
    _context: test.Context)
  runtime.run(function ()
    local filename = "/workspace/callable_hover.titan"
    local function_type = bridge.TypeInfo.new(
      "Type.Function", "function (integer): string")
    local model = features.build({project("sample", {
      bridge.SourceFile.new(filename,
        "function render(value: integer): string\n" ..
        "end\n" ..
        "local callback: function (integer): string = " ..
        "function(value) return \"\" end\n"),
    })}, {snapshot("sample", filename, {filename}, {}, {
      occurrence(filename, 1, 10, 16, "render", "export:sample:render",
                 bridge.OccurrenceRole.definition(), false, function_type,
                 bridge.CallableSignature.new(
                   "sample.render(value: integer): string")),
      occurrence(filename, 3, 7, 15, "callback", "ast:sample:callback",
                 bridge.OccurrenceRole.definition(), true, function_type),
    })})
    defer model:close()

    local callable? = model:hover(filename, source_text.Position.new(0, 11))
    test.assert(callable ~= nil and callable:markdown() ==
                  "- Signature: `sample.render(value: integer): string`\n" ..
                  "- Visibility: exported\n",
                "named function hover fell back to a bare function type")

    local variable? = model:hover(filename, source_text.Position.new(2, 8))
    test.assert(variable ~= nil and variable:markdown() ==
                  "- Type: `function (integer): string`\n" ..
                  "- Visibility: block\n",
                "ordinary function-valued variable did not keep its bare type")
  end)
end

function test_semantic_features_hover_appends_cached_aggregate_summary(
    _context: test.Context)
  runtime.run(function ()
    local filename = "/workspace/aggregate_hover.titan"
    local record_type = bridge.TypeInfo.new(
      "Type.Record", "sample.Box<|integer|>")
    local symbol = occurrence(
      filename, 1, 1, 4, "Box", "export:sample:Box",
      bridge.OccurrenceRole.definition(), false, record_type,
      bridge.CallableSignature.new("wrong.signature(): nil"), 1)
    local fields = bridge.HoverSummarySection.new(
      "Fields", {"value: integer"})
    local methods = bridge.HoverSummarySection.new(
      "Methods", {"sample.Box<|integer|>:get(): integer"})
    local summary = bridge.HoverSummary.new(
      1, bridge.HoverSummaryKind.record_summary(), "sample.Box<|integer|>",
      {fields, methods})
    local saved = project("sample", {
      bridge.SourceFile.new(filename, "Box\n"),
    })
    local compiler_snapshot = snapshot(
      "sample", filename, {filename}, {}, {symbol}, {summary})
    local model = features.build({saved}, {compiler_snapshot})
    defer model:close()

    local hover? = model:hover(filename, source_text.Position.new(0, 1))
    test.assert(hover ~= nil and hover:markdown() ==
                  "**record** `sample.Box<|integer|>`\n\n" ..
                  "Fields\n\n" ..
                  "- `value: integer`\n\n" ..
                  "Methods\n\n" ..
                  "- `sample.Box<|integer|>:get(): integer`\n\n" ..
                  "- Visibility: exported\n",
                "hover rebuilt or failed to append its cached summary")
  end)
end

function test_semantic_features_hover_reports_imported_terms(
    _context: test.Context)
  runtime.run(function ()
    local filename = "/workspace/import_hover.titan"
    local module_type = bridge.TypeInfo.new(
      "Type.Module", "module titan.math")
    local float_type = bridge.TypeInfo.new("Type.Float", "float")
    local import_symbol =
      "ast:import_hover:/workspace/import_hover.titan:1:7:math"
    local member_symbol = "export:titan.math:pi"
    local model = features.build({project("import_hover", {
      bridge.SourceFile.new(filename,
        "local math = import \"math\"\n" ..
        "function result(): float\n" ..
        "  return math.pi\n" ..
        "end\n"),
    })}, {snapshot("import_hover", filename, {filename}, {
      node(1, "Ast.TopLevelImport", bridge.NodeKind.declaration(),
           filename, 1, 7, "math", true, module_type, module_type,
           nil, nil, nil),
      node(2, "Ast.VarName", bridge.NodeKind.variable(),
           filename, 3, 10, "math", true, module_type, nil,
           nil, nil, nil),
      node(3, "Ast.VarDot", bridge.NodeKind.variable(),
           filename, 3, 15, "pi", false, float_type, nil,
           nil, nil, nil),
    }, {
      occurrence(filename, 1, 7, 11, "math", import_symbol,
                 bridge.OccurrenceRole.import_alias(), true, module_type,
                 nil, nil, bridge.DeclarationVisibility.module()),
      occurrence(filename, 3, 10, 14, "math", import_symbol,
                 bridge.OccurrenceRole.reference(), true, module_type,
                 nil, nil, bridge.DeclarationVisibility.module()),
      occurrence(filename, 3, 15, 17, "pi", member_symbol,
                 bridge.OccurrenceRole.reference(), false, float_type),
    })})
    defer model:close()

    local alias? = model:hover(filename, source_text.Position.new(0, 8))
    test.assert(alias ~= nil and alias.inferred_type ~= nil and
                alias.inferred_type.display == "module titan.math" and
                alias.declared_type ~= nil and
                visibility_name(alias.visibility) == "module",
                "hover lost the compiler type or localness of an import alias")

    local alias_use? = model:hover(filename, source_text.Position.new(2, 10))
    test.assert(alias_use ~= nil and alias_use.inferred_type ~= nil and
                alias_use.inferred_type.display == "module titan.math" and
                visibility_name(alias_use.visibility) == "module",
                "hover lost the compiler type or localness of an imported name")

    local member? = model:hover(filename, source_text.Position.new(2, 15))
    test.assert(member ~= nil and member.inferred_type ~= nil and
                member.inferred_type.display == "float" and
                visibility_name(member.visibility) == "exported" and
                member.range.start.character == 14 and
                member.range.finish.character == 16,
                "hover lost the type, localness, or range of an imported term")
    test.assert(member:markdown() ==
                  "- Type: `float`\n" ..
                  "- Visibility: exported\n",
                "imported-term hover did not produce stable Markdown")
  end)
end

