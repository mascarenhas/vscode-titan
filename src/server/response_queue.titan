--- Single-reader FIFO serializing framed replies and notifications.
-- @module server.response_queue

local async = import "async"

-- A single-consumer, unbounded protocol queue. Producers never yield, so a
-- Task terminal listener can publish exactly one response safely. The one
-- consumer is the protocol writer Task.
--- Ordered response buffer with one reserved consumer and explicit stop state.
record ResponseQueue
  local items: {string}
  local head: integer
  local waiter: async.Task?
  local const resume_token: async.ResumeToken
  local stopped: boolean
end

--- Create an empty response queue.
function create(): ResponseQueue
  return ResponseQueue {
    items = {},
    head = 1,
    resume_token = async.ResumeToken("server.response_queue"),
    stopped = false,
  }
end

local function ResponseQueue:wake()
  local waiter? = self.waiter
  if waiter == nil then return end
  self.waiter = nil
  waiter:resume(self.resume_token)
end

--- Append a reply or notification and wake the reserved consumer.
function ResponseQueue:push(message: string)
  if self.stopped then raise "protocol response queue is stopped" end
  self.items[#self.items + 1] = message
  self:wake()
end

--- End production while retaining queued messages for the consumer.
function ResponseQueue:stop()
  if self.stopped then return end
  self.stopped = true
  self:wake()
end

function ResponseQueue:pending(): integer
  return #self.items - self.head + 1
end

--- Take the next message, suspending while live and empty; nil marks drained stop.
function ResponseQueue:take(): string?
  if self:pending() == 0 then
    if self.stopped then return nil end
    if self.waiter ~= nil then
      raise "protocol response queue already has a waiting consumer"
    end

    local current = async.running()
    self.waiter = current
    local detach = function ()
      if self.waiter == current then self.waiter = nil end
    end
    defer detach()
    async.suspend(self.resume_token, detach)
  end

  if self:pending() == 0 then return nil end

  local index = self.head
  local message = self.items[index]
  self.items[index] = nil
  self.head = index + 1
  if self.head > #self.items then
    self.items = {}
    self.head = 1
  end
  return message
end
