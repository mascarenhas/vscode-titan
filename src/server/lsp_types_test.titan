local json = import "server.json"
local lsp = import "server.lsp_types"
local source_text = import "server.source_text"
local test = import "test"

local function params(uri: json.Value, line: json.Value,
                      character: json.Value): json.Value
  return json.from_object({
    json.Member.new("textDocument", json.from_object({
      json.Member.new("uri", uri),
    })),
    json.Member.new("position", json.from_object({
      json.Member.new("line", line),
      json.Member.new("character", character),
    })),
  })
end

function test_lsp_types_parses_local_document_positions(
    _context: test.Context)
  local parsed?, failure? = lsp.parse_document_position(params(
    json.from_string("file:///workspace/a%20b.titan"),
    json.from_integer(3), json.from_integer(5)))
  test.assert(failure == nil and parsed ~= nil and
              parsed.uri == "file:///workspace/a%20b.titan" and
              parsed.path == "/workspace/a b.titan" and
              parsed.position.line == 3 and parsed.position.character == 5,
              "valid document position did not normalize")

  local text_document = json.from_object({
    json.Member.new(
      "uri", json.from_string("file:///workspace/a%20b.titan")),
  })
  local document_params = json.from_object({
    json.Member.new("textDocument", text_document),
  })
  local document?, document_error? = lsp.parse_document(document_params)
  test.assert(document_error == nil and document ~= nil and
              document.path == "/workspace/a b.titan",
              "position-free text document params did not normalize")
end

function test_lsp_types_rejects_malformed_params(_context: test.Context)
  local missing?, missing_error? =
    lsp.parse_document_position(json.new_object())
  test.assert(missing == nil and missing_error ~= nil and
              missing_error.code == -32602,
              "missing document position did not return Invalid params")

  local remote?, remote_error? = lsp.parse_document_position(params(
    json.from_string("file://example.com/workspace/main.titan"),
    json.from_integer(0), json.from_integer(0)))
  test.assert(remote == nil and remote_error ~= nil,
              "non-local document URI was accepted")

  local negative?, negative_error? = lsp.parse_document_position(params(
    json.from_string("file:///workspace/main.titan"),
    json.from_integer(-1), json.from_integer(0)))
  test.assert(negative == nil and negative_error ~= nil,
              "negative LSP position was accepted")
end

function test_lsp_types_parses_reference_and_rename_extensions(
    _context: test.Context)
  local reference_params = params(
    json.from_string("file:///workspace/main.titan"),
    json.from_integer(1), json.from_integer(2))
  local reference_object? = json.as_object(reference_params)
  reference_object:set("context", json.from_object({
    json.Member.new("includeDeclaration", json.from_boolean(false)),
  }))
  local references?, references_error? =
    lsp.parse_references(reference_params)
  test.assert(references_error == nil and references ~= nil and
              not references.include_declaration,
              "reference context did not parse")

  local rename_params = params(
    json.from_string("file:///workspace/main.titan"),
    json.from_integer(1), json.from_integer(2))
  local rename_object? = json.as_object(rename_params)
  rename_object:set("newName", json.from_string("renamed_2"))
  local rename?, rename_error? = lsp.parse_rename(rename_params)
  test.assert(rename_error == nil and rename ~= nil and
              rename.new_name == "renamed_2",
              "valid rename params did not parse")

  rename_object:set("newName", json.from_string("function"))
  local keyword?, keyword_error? = lsp.parse_rename(rename_params)
  test.assert(keyword == nil and keyword_error ~= nil,
              "Titan keyword was accepted as a rename target")
end

function test_lsp_types_encodes_deterministic_results(_context: test.Context)
  local first = source_text.Span.new(
    source_text.Position.new(0, 1), source_text.Position.new(0, 4))
  local second = source_text.Span.new(
    source_text.Position.new(2, 0), source_text.Position.new(2, 3))
  local edit = lsp.workspace_edit_value({
    lsp.DocumentEdits.new("file:///z.titan", {
      lsp.TextEdit.new(second, "z"),
    }),
    lsp.DocumentEdits.new("file:///a.titan", {
      lsp.TextEdit.new(first, "a"),
    }),
  })
  test.assert(json.encode(edit) ==
    [[{"changes":{"file:///a.titan":[{"range":{"start":{"line":0,"character":1},"end":{"line":0,"character":4}},"newText":"a"}],"file:///z.titan":[{"range":{"start":{"line":2,"character":0},"end":{"line":2,"character":3}},"newText":"z"}]}}]],
    "workspace edit was not encoded deterministically")

  local hover = lsp.hover_value("```titan\ninteger\n```", first)
  test.assert(json.encode(hover) ==
    [[{"contents":{"kind":"markdown","value":"```titan\ninteger\n```"},"range":{"start":{"line":0,"character":1},"end":{"line":0,"character":4}}}]],
    "hover result did not use MarkupContent and an exact range")

  local fold = lsp.folding_range_value(lsp.FoldingRange.new(
    1, 2, 8, 0, "region"))
  test.assert(json.encode(fold) ==
    [[{"startLine":1,"endLine":8,"startCharacter":2,"endCharacter":0,"kind":"region"}]],
    "folding range fields changed")
end
