local async = import "async"
local fs = import "fs"
local iteration = import "iteration"
local strings = import "string"
local compiler_bridge = import "server.compiler_bridge"
local compiler_io = import "server.compiler_io"
local json = import "server.json"
local logging = import "server.logging"
local project_config = import "server.project_config"
local project_discovery = import "server.project_discovery"
local project_graph = import "server.project_graph"

record Error
  path: string
  message: string
end

record SourceFileSnapshot
  const filename: string
  const contents: string
  const stamp: project_graph.FileStamp
end

-- `dirty` means an input changed and compiler work is required. A failed
-- result is instead current for its exact revision: it carries authoritative
-- diagnostics but no semantic AST until a relevant input invalidates it.
union ProjectAnalysisState
  clean
  failed
  dirty
end

record ProjectModule
  const module_name: string
  const source_files: {SourceFileSnapshot}
  const compiler_snapshot: compiler_bridge.ModuleSnapshot?
  const diagnostics: {compiler_bridge.Diagnostic}
  const analysis_state: ProjectAnalysisState
end

record ExternalSource
  const main_file: string
  const source_files: {string}
end

record ExternalBinary
  const provider_file: string
end

union ExternalOrigin
  source: ExternalSource
  dynamic_binary: ExternalBinary
  static_binary: ExternalBinary
end

-- This record intentionally cannot carry compiler nodes, symbols, or a raw
-- AST. External compiler snapshots are converted to this metadata-only shape
-- immediately when a generation is committed.
record ExternalModule
  const module_name: string
  const origin: ExternalOrigin
  const manifest: project_graph.Manifest
  const stamps: {project_graph.FileStamp}
  const analyzed_input_identity: string?
  const imports: {project_graph.ImportEdge}
  const compiler_imports: {compiler_bridge.Import}
  const c_header_dependencies: {compiler_bridge.CHeaderDependency}
end

-- Immutable pre-analysis identity for one external import name. The optional
-- origin represents a clean resolver miss/error. It never carries a compiler
-- type, AST, or symbol table.
record ExternalFingerprint
  const module_name: string
  const source_required: boolean
  const topology_resolved: boolean
  const origin: ExternalOrigin?
  const stamps: {project_graph.FileStamp}
  const error: string?
end

-- Exact compiler-observed inputs for one module's C preprocessor closure.
-- These are deliberately path identities rather than watched directories:
-- `search` entries include misses and therefore notice a new earlier shadow.
record HeaderFingerprint
  const module_name: string
  const dependencies: {compiler_bridge.CHeaderDependency}
end

record Snapshot
  const generation: integer
  const config: project_config.ProjectConfig
  const discovery_issues: {project_discovery.Issue}
  const project_directories: {string}
  const project_modules: {ProjectModule}
  const external_modules: {ExternalModule}
  const dirty_modules: {string}
end

-- project_modules is the immutable saved-file catalog available to the bridge;
-- dirty_modules is the exact work set. check_tokens capture those modules'
-- graph revisions before analysis, so a same-generation dependency
-- invalidation cannot publish an obsolete result.
record AnalysisRequest
  const generation: integer
  const config: project_config.ProjectConfig
  const root_module: string
  const project_modules: {compiler_bridge.ProjectModule}
  const dirty_modules: {string}
  const cached_sources: {compiler_bridge.CachedSourceInterface}
  const external_fingerprints: {ExternalFingerprint}
  const header_fingerprints: {HeaderFingerprint}
  const check_tokens: {project_graph.CheckToken}
end

type Analyzer = (AnalysisRequest) -> compiler_bridge.Analysis
type ExternalResolver = (
  project_config.ProjectConfig, {string},
  {compiler_bridge.ExternalResolutionRequest}) ->
  {compiler_bridge.ExternalResolution}
type HeaderRestater = ({compiler_bridge.CHeaderDependency}) ->
                      {compiler_bridge.CHeaderDependency}
-- Lifecycle owners use the saved snapshot after discovery to establish their
-- watcher before compiler analysis begins. The cold loader immediately scans
-- once more after its first callback, closing the initial
-- scan-to-registration gap, and publishes that post-registration snapshot
-- before analysis.
type SnapshotListener = (Snapshot) -> ()

record Counters
  const file_reads: integer
  const analysis_runs: integer
  const project_modules_submitted: integer
end

record RefreshReport
  const analyzed: boolean
  const stale: boolean
  const generation: integer
  const committed_modules: {string}
  const failed_modules: {string}
  const dirty_modules: {string}
end

local record ProjectState
  module_name: string
  source_files: {SourceFileSnapshot}
  compiler_snapshot: compiler_bridge.ModuleSnapshot?
  diagnostics: {compiler_bridge.Diagnostic}
end

record Service
  local project_root: string
  local installed_binary_modules_root: string
  local analyzer: Analyzer
  local external_resolver: ExternalResolver?
  local header_restater: HeaderRestater?
  local current_config: project_config.ProjectConfig
  local catalog: project_discovery.Discovery
  local graph: project_graph.Graph<compiler_bridge.ModuleSnapshot>
  local projects: {string: ProjectState}
  local project_names: {string}
  local externals: {string: ExternalModule}
  local external_names: {string}
  local external_fingerprints: {string: ExternalFingerprint}
  local external_fingerprint_names: {string}
  local header_fingerprints: {string: HeaderFingerprint}
  local header_fingerprint_names: {string}
  local read_count: integer
  local analysis_count: integer
  local submitted_count: integer
  local analysis_active: boolean
end

local function fail<T>(path: string, message: string): T
  raise Error.new(path, message)
end

local function copy_strings(source: {string}): {string}
  local result: {string} = {}
  for index = 1, #source do result[index] = source[index] end
  return result
end

local function copy_diagnostics(
    source: {compiler_bridge.Diagnostic}): {compiler_bridge.Diagnostic}
  local result: {compiler_bridge.Diagnostic} = {}
  for index = 1, #source do result[index] = source[index] end
  return result
end

local function copy_stamps(
    source: {project_graph.FileStamp}): {project_graph.FileStamp}
  local result: {project_graph.FileStamp} = {}
  for index = 1, #source do
    local stamp = source[index]
    result[index] = project_graph.FileStamp.new(
      stamp.path, stamp.modified_seconds, stamp.modified_nanoseconds,
      stamp.size)
  end
  return result
end

local function header_kind_name(
    kind: compiler_bridge.CHeaderDependencyKind): string
  case kind
  when file then return "file"
  when search then return "search"
  end
end

local function copy_header_dependencies(
    source: {compiler_bridge.CHeaderDependency}):
    {compiler_bridge.CHeaderDependency}
  local result: {compiler_bridge.CHeaderDependency} = {}
  for index = 1, #source do
    local dependency = source[index]
    local kind = compiler_bridge.CHeaderDependencyKind.file()
    case dependency.kind
    when search then kind = compiler_bridge.CHeaderDependencyKind.search()
    when file then
    end
    result[index] = compiler_bridge.CHeaderDependency.new(
      kind, dependency.path, dependency.identity)
  end
  return result
end

local function same_header_dependencies(
    left: {compiler_bridge.CHeaderDependency},
    right: {compiler_bridge.CHeaderDependency}): boolean
  if #left ~= #right then return false end
  for index = 1, #left do
    local before = left[index]
    local after = right[index]
    if header_kind_name(before.kind) ~= header_kind_name(after.kind) or
       before.path ~= after.path or before.identity ~= after.identity then
      return false
    end
  end
  return true
end

local function copy_header_fingerprint(
    source: HeaderFingerprint): HeaderFingerprint
  return HeaderFingerprint.new(
    source.module_name, copy_header_dependencies(source.dependencies))
end

local function header_dependency_digest(
    dependencies: {compiler_bridge.CHeaderDependency}): string
  local output = strings.writer()
  for index = 1, #dependencies do
    local dependency = dependencies[index]
    local kind = header_kind_name(dependency.kind)
    output:write(#kind .. ":" .. kind .. ":")
    output:write(#dependency.path .. ":" .. dependency.path .. ":")
    output:write(#dependency.identity .. ":" .. dependency.identity .. ";")
  end
  return output:drain()
end

local function copy_external_origin(source: ExternalOrigin): ExternalOrigin
  case source
  when source: origin then
    return ExternalOrigin.source(ExternalSource.new(
      origin.main_file, copy_strings(origin.source_files)))
  when dynamic_binary: origin then
    return ExternalOrigin.dynamic_binary(
      ExternalBinary.new(origin.provider_file))
  when static_binary: origin then
    return ExternalOrigin.static_binary(
      ExternalBinary.new(origin.provider_file))
  end
end

local function copy_external_fingerprint(
    source: ExternalFingerprint): ExternalFingerprint
  local origin?: ExternalOrigin = nil
  if source.origin ~= nil then
    origin = copy_external_origin(source.origin as ExternalOrigin)
  end
  return ExternalFingerprint.new(
    source.module_name, source.source_required, source.topology_resolved, origin,
    copy_stamps(source.stamps), source.error)
end

local function origin_identity(origin: ExternalOrigin?): string
  if origin == nil then return "missing" end
  case origin as ExternalOrigin
  when source: source then
    local output = strings.writer()
    output:write("source:" .. #source.main_file .. ":" .. source.main_file)
    for index = 1, #source.source_files do
      local path = source.source_files[index]
      output:write(":" .. #path .. ":" .. path)
    end
    return output:drain()
  when dynamic_binary: binary then
    return "dynamic:" .. #binary.provider_file .. ":" ..
           binary.provider_file
  when static_binary: binary then
    return "static:" .. #binary.provider_file .. ":" ..
           binary.provider_file
  end
end

local function copy_imports(
    source: {project_graph.ImportEdge}): {project_graph.ImportEdge}
  local result: {project_graph.ImportEdge} = {}
  for index = 1, #source do
    local edge = source[index]
    local visibility = project_graph.ImportVisibility.ordinary()
    case edge.visibility
    when source_required then
      visibility = project_graph.ImportVisibility.source_required()
    else
    end
    result[index] = project_graph.ImportEdge.new(
      edge.module_name, visibility)
  end
  return result
end

local function copy_config(source: project_config.ProjectConfig):
    project_config.ProjectConfig
  return project_config.ProjectConfig.new(
    source.project_root, source.config_file, source.source_modules_root,
    source.binary_modules_root, copy_strings(source.extra_ffi_include_dirs),
    source.extra_ffi_cppflags)
end

local function same_stamp(left: project_graph.FileStamp,
                          right: project_graph.FileStamp): boolean
  return left.path == right.path and
         left.modified_seconds == right.modified_seconds and
         left.modified_nanoseconds == right.modified_nanoseconds and
         left.size == right.size
end

local function same_stamps(left: {project_graph.FileStamp},
                           right: {project_graph.FileStamp}): boolean
  if #left ~= #right then return false end
  for index = 1, #left do
    if not same_stamp(left[index], right[index]) then return false end
  end
  return true
end

local function same_external_fingerprint(left: ExternalFingerprint,
                                         right: ExternalFingerprint): boolean
  local same_error = left.error == right.error
  -- Resolver error prose is not physical topology. A failed project seeds an
  -- origin-less baseline before the resolver has produced its own message;
  -- repeated observations of the same missing provider must remain stable.
  if left.origin == nil and right.origin == nil and
     #left.stamps == 0 and #right.stamps == 0 then
    same_error = true
  end
  return left.module_name == right.module_name and
         left.source_required == right.source_required and
         left.topology_resolved == right.topology_resolved and
         same_error and
         origin_identity(left.origin) == origin_identity(right.origin) and
         same_stamps(left.stamps, right.stamps)
end

local function external_matches_fingerprint(
    external: ExternalModule,
    fingerprint: ExternalFingerprint): boolean
  return fingerprint.error == nil and
         origin_identity(external.origin) ==
           origin_identity(fingerprint.origin) and
         same_stamps(external.stamps, fingerprint.stamps)
end

local function stamp_for(path: string): project_graph.FileStamp?
  local metadata? = fs.stat(path)
  if metadata == nil then return nil end
  if metadata.kind ~= "file" then
    return fail<project_graph.FileStamp>(path, "path is not a regular file")
  end
  return project_graph.FileStamp.new(
    path, metadata.modified_seconds, metadata.modified_nanoseconds,
    metadata.size)
end

local function find_file(source: {SourceFileSnapshot},
                         filename: string): SourceFileSnapshot?
  for index = 1, #source do
    if source[index].filename == filename then return source[index] end
  end
  return nil
end

local function Service:read_stable_file(
    filename: string, previous: SourceFileSnapshot?): SourceFileSnapshot
  local observed? = stamp_for(filename)
  if observed == nil then
    return fail<SourceFileSnapshot>(filename, "saved source file disappeared")
  end
  if previous ~= nil and same_stamp(previous.stamp, observed) then
    return previous
  end

  -- fs operations can yield. Re-stat after each read so the bytes and stamp
  -- represent one stable saved-file observation instead of a torn update.
  for _attempt = 1, 3 do
    local before? = stamp_for(filename)
    if before == nil then
      return fail<SourceFileSnapshot>(filename,
        "saved source file disappeared before it could be read")
    end
    self.read_count = self.read_count + 1
    local contents = fs.read_file(filename)
    local after? = stamp_for(filename)
    if after ~= nil and same_stamp(before, after) then
      return SourceFileSnapshot.new(filename, contents, after)
    end
  end
  return fail<SourceFileSnapshot>(filename,
    "saved source file changed repeatedly while it was being read")
end

local function Service:snapshot_discovered_module(
    module: project_discovery.Module): ProjectState
  local previous? = self.projects[module.name]
  local files: {SourceFileSnapshot} = {}
  for index = 1, #module.files do
    local old_file: SourceFileSnapshot? = nil
    if previous ~= nil then
      old_file = find_file(previous.source_files, module.files[index])
    end
    files[index] = self:read_stable_file(module.files[index], old_file)
  end

  if previous ~= nil then
    return ProjectState.new(module.name, files,
                            previous.compiler_snapshot,
                            previous.diagnostics)
  end
  return ProjectState.new(module.name, files, nil, {})
end

local function state_stamps(state: ProjectState): {project_graph.FileStamp}
  local result: {project_graph.FileStamp} = {}
  for index = 1, #state.source_files do
    result[index] = state.source_files[index].stamp
  end
  return result
end

local function same_string_arrays(left: {string}, right: {string}): boolean
  if #left ~= #right then return false end
  for index = 1, #left do
    if left[index] ~= right[index] then return false end
  end
  return true
end

local function same_config(left: project_config.ProjectConfig,
                           right: project_config.ProjectConfig): boolean
  return left.project_root == right.project_root and
         left.config_file == right.config_file and
         left.source_modules_root == right.source_modules_root and
         left.binary_modules_root == right.binary_modules_root and
         same_string_arrays(left.extra_ffi_include_dirs,
                            right.extra_ffi_include_dirs) and
         left.extra_ffi_cppflags == right.extra_ffi_cppflags
end

local function contains_name(names: {string}, name: string): boolean
  for index = 1, #names do
    if names[index] == name then return true end
  end
  return false
end

local function insert_name(names: {string}, name: string)
  if contains_name(names, name) then return end
  local position = #names + 1
  while position > 1 and name < names[position - 1] do
    names[position] = names[position - 1]
    position = position - 1
  end
  names[position] = name
end

local function remove_name(names: {string}, name: string)
  for index = 1, #names do
    if names[index] == name then
      for following = index, #names - 1 do
        names[following] = names[following + 1]
      end
      names[#names] = nil
      return
    end
  end
end

local function Service:forget_header_fingerprint(module_name: string)
  self.header_fingerprints[module_name] = nil
  remove_name(self.header_fingerprint_names, module_name)
end

local function Service:remember_header_fingerprint(
    module_name: string,
    dependencies: {compiler_bridge.CHeaderDependency})
  self.header_fingerprints[module_name] = HeaderFingerprint.new(
    module_name, copy_header_dependencies(dependencies))
  insert_name(self.header_fingerprint_names, module_name)
end

local function Service:restat_header_dependencies(
    module_name: string,
    dependencies: {compiler_bridge.CHeaderDependency}):
    {compiler_bridge.CHeaderDependency}
  if #dependencies == 0 then return {} end
  if self.header_restater == nil then
    return fail<{compiler_bridge.CHeaderDependency}>(module_name,
      "analyzer reported C header dependencies without a header restater")
  end
  local current = (self.header_restater as HeaderRestater)(
    copy_header_dependencies(dependencies))
  if #current ~= #dependencies then
    return fail<{compiler_bridge.CHeaderDependency}>(module_name,
      "header restater returned the wrong number of dependencies")
  end
  for index = 1, #dependencies do
    local before = dependencies[index]
    local after = current[index]
    if header_kind_name(before.kind) ~= header_kind_name(after.kind) or
       before.path ~= after.path then
      return fail<{compiler_bridge.CHeaderDependency}>(module_name,
        "header restater changed dependency kind/path at index " .. index)
    elseif after.identity == "" then
      return fail<{compiler_bridge.CHeaderDependency}>(module_name,
        "header restater returned an empty identity at index " .. index)
    end
  end
  return copy_header_dependencies(current)
end

local function Service:accept_revalidated_headers(
    module_name: string,
    current: {compiler_bridge.CHeaderDependency}): boolean
  local previous? = self.header_fingerprints[module_name]
  if previous ~= nil and
     same_header_dependencies(previous.dependencies, current) then
    return false
  end
  self:remember_header_fingerprint(module_name, current)
  if previous ~= nil then
    if self.projects[module_name] ~= nil then
      self.graph:invalidate_project(module_name)
    elseif self.externals[module_name] ~= nil or
           #self.graph:reverse_imports(module_name) > 0 then
      self.graph:invalidate_external_change(module_name)
    end
  end
  return true
end

-- Refresh the baseline before selecting compiler work. Store the current
-- identity before invalidation so repeated scans of the same filesystem state
-- do not advance the graph revision forever.
local function Service:revalidate_known_headers()
  local names = copy_strings(self.header_fingerprint_names)
  for index = 1, #names do
    local name = names[index]
    local previous? = self.header_fingerprints[name]
    if previous ~= nil then
      local current = self:restat_header_dependencies(
        name, previous.dependencies)
      if not same_header_dependencies(previous.dependencies, current) then
        self:accept_revalidated_headers(name, current)
      end
    end
  end
end

local function Service:invalidate_all_projects()
  for index = 1, #self.project_names do
    self.graph:invalidate_project(self.project_names[index])
  end
end

local function Service:clear_external_cache()
  local names = copy_strings(self.external_names)
  for index = 1, #names do
    self.graph:prune_external(names[index])
    self:forget_header_fingerprint(names[index])
  end
  self.externals = {}
  self.external_names = {}
  self.external_fingerprints = {}
  self.external_fingerprint_names = {}
end

local function Service:source_required_for_external(name: string): boolean
  local remembered? = self.external_fingerprints[name]
  if remembered ~= nil then return remembered.source_required end
  local reverse = self.graph:reverse_imports(name)
  for index = 1, #reverse do
    case reverse[index].visibility
    when source_required then return true
    else
    end
  end
  return false
end

local function fingerprint_from_resolution(
    resolution: compiler_bridge.ExternalResolution,
    source_required: boolean): ExternalFingerprint
  local origin?: ExternalOrigin = nil
  local paths: {string} = {}
  if resolution.provenance ~= nil then
    case resolution.provenance as compiler_bridge.Provenance
    when external_source: source then
      origin = ExternalOrigin.source(ExternalSource.new(
        source.main_file, copy_strings(source.source_files)))
      paths = copy_strings(source.source_files)
    when dynamic_binary: binary then
      origin = ExternalOrigin.dynamic_binary(
        ExternalBinary.new(binary.provider_file))
      paths[1] = binary.provider_file
    when static_binary: binary then
      origin = ExternalOrigin.static_binary(
        ExternalBinary.new(binary.provider_file))
      paths[1] = binary.provider_file
    when project_source then
      return fail<ExternalFingerprint>(resolution.module_name,
        "external resolver returned project-source provenance")
    end
  end

  local stamps: {project_graph.FileStamp} = {}
  local message? = resolution.error
  for index = 1, #paths do
    local stamp? = stamp_for(paths[index])
    if stamp == nil then
      message = "resolved external file disappeared before analysis: " ..
                paths[index]
      stamps = {}
      break
    end
    stamps[index] = stamp
  end
  return ExternalFingerprint.new(
    resolution.module_name, source_required, true, origin, stamps, message)
end

local function restat_external_fingerprint(
    previous: ExternalFingerprint): ExternalFingerprint
  local origin?: ExternalOrigin = nil
  local paths: {string} = {}
  if previous.origin ~= nil then
    origin = copy_external_origin(previous.origin as ExternalOrigin)
    case origin as ExternalOrigin
    when source: source then paths = copy_strings(source.source_files)
    when dynamic_binary: binary then paths[1] = binary.provider_file
    when static_binary: binary then paths[1] = binary.provider_file
    end
  end
  local stamps: {project_graph.FileStamp} = {}
  local message? = previous.error
  if origin ~= nil then message = nil end
  for index = 1, #paths do
    local stamp? = stamp_for(paths[index])
    if stamp == nil then
      message = "resolved external file disappeared before analysis: " ..
                paths[index]
      stamps = {}
      break
    end
    stamps[index] = stamp
  end
  return ExternalFingerprint.new(
    previous.module_name, previous.source_required,
    previous.topology_resolved, origin, stamps, message)
end

local function Service:accept_revalidated_fingerprint(
    current: ExternalFingerprint)
  local previous? = self.external_fingerprints[current.module_name]
  local changed = false
  if previous ~= nil then
    changed = not same_external_fingerprint(previous, current)
  else
    local external? = self.externals[current.module_name]
    changed = external ~= nil and
              not external_matches_fingerprint(external, current)
  end
  self.external_fingerprints[current.module_name] = current
  insert_name(self.external_fingerprint_names, current.module_name)
  if changed then
    self.graph:invalidate_external_change(current.module_name)
  end
end

-- Re-resolve only import names already present in committed or pending
-- external metadata. This sees provider precedence changes and complete folder
-- membership without walking or watching any external source tree. Contextual
-- owners carried by their exposer have fixed physical identity instead; those
-- metadata-only fingerprints are re-statted without inventing an ordinary
-- resolver/import choice.
local function Service:revalidate_external_topology()
  if #self.external_fingerprint_names == 0 then return end
  local requests: {compiler_bridge.ExternalResolutionRequest} = {}
  for index = 1, #self.external_fingerprint_names do
    local name = self.external_fingerprint_names[index]
    local previous? = self.external_fingerprints[name]
    if previous ~= nil then
      if previous.topology_resolved and self.external_resolver ~= nil then
        requests[#requests + 1] =
          compiler_bridge.ExternalResolutionRequest.new(
            name, self:source_required_for_external(name))
      else
        self:accept_revalidated_fingerprint(
          restat_external_fingerprint(previous))
      end
    end
  end
  if #requests == 0 then return end
  local resolver = self.external_resolver as ExternalResolver
  local resolutions = resolver(
    copy_config(self.current_config), copy_strings(self.project_names), requests)
  if #resolutions ~= #requests then
    raise Error.new(self.project_root,
      "external resolver returned the wrong number of results")
  end

  for index = 1, #requests do
    local request = requests[index]
    local resolution = resolutions[index]
    if resolution.module_name ~= request.module_name then
      raise Error.new(self.project_root,
        "external resolver returned '" .. resolution.module_name ..
        "' while resolving '" .. request.module_name .. "'")
    end
    local current = fingerprint_from_resolution(
      resolution, request.source_required)
    self:accept_revalidated_fingerprint(current)
  end
end

local function Service:revalidate_external_files()
  local names = copy_strings(self.external_names)
  for index = 1, #names do
    local name = names[index]
    local external? = self.externals[name]
    if external ~= nil then
      local current: {project_graph.FileStamp} = {}
      local missing = false
      for file_index = 1, #external.stamps do
        local stamp? = stamp_for(external.stamps[file_index].path)
        if stamp == nil then
          missing = true
          break
        end
        current[file_index] = stamp
      end

      if missing then
        self.graph:remove_module(name)
        self.externals[name] = nil
        remove_name(self.external_names, name)
        self:forget_header_fingerprint(name)
      elseif not same_stamps(current, external.stamps) then
        case external.origin
        when source then
          self.graph:upsert_external_source(
            name, current, external.manifest, external.imports)
        when dynamic_binary then
          self.graph:upsert_external_binary(
            name, current, external.manifest, external.imports)
        when static_binary then
          self.graph:upsert_external_binary(
            name, current, external.manifest, external.imports)
        end
        self.externals[name] = ExternalModule.new(
          name, external.origin, external.manifest, current,
          external.analyzed_input_identity,
          external.imports, external.compiler_imports,
          external.c_header_dependencies)
        -- The old manifest cannot prove that changed external bytes kept the
        -- same interface. Cross external metadata nodes to every first project
        -- consumer; those projects' recomputed manifests govern propagation
        -- through the project graph.
        self.graph:invalidate_external_change(name)
      end
    end
  end
end

local function Service:scan_or_raise(): Snapshot
  local started = logging.clock()
  logging.emit("debug", "project.scan.start", {
    json.Member.new("root", json.from_string(self.project_root)),
    json.Member.new("generation", json.from_integer(
      self.graph:generation())),
  })
  local loaded?, config_error? = project_config.load(
    self.project_root, self.installed_binary_modules_root)
  if loaded == nil then
    return fail<Snapshot>(config_error.path, config_error.message)
  end
  local found?, discovery_error? = project_discovery.discover(
    loaded.source_modules_root)
  if found == nil then
    return fail<Snapshot>(discovery_error.path, discovery_error.message)
  end

  local config_changed = not same_config(self.current_config, loaded)
  local next_projects: {string: ProjectState} = {}
  local next_names: {string} = {}
  for index = 1, #found.modules do
    local module = found.modules[index]
    local state = self:snapshot_discovered_module(module)
    next_projects[module.name] = state
    next_names[index] = module.name
  end

  local old_names = copy_strings(self.project_names)
  for index = 1, #old_names do
    local name = old_names[index]
    if next_projects[name] == nil then
      self.graph:remove_module(name)
      self:forget_header_fingerprint(name)
    end
  end
  for index = 1, #next_names do
    local name = next_names[index]
    self.graph:observe_project(name, state_stamps(next_projects[name]))
  end

  self.current_config = loaded
  self.catalog = found
  self.projects = next_projects
  self.project_names = next_names
  if config_changed then
    self:invalidate_all_projects()
    -- Every resolution input is configuration-dependent, including FFI
    -- include paths used while checking external source. Do not carry an old
    -- serialized interface or provider identity across any config change.
    self:clear_external_cache()
    -- Search observations are relative to the configured include path. The
    -- projects are already dirty, so let their next compiler result establish
    -- a fresh closure instead of restatting obsolete candidates.
    self.header_fingerprints = {}
    self.header_fingerprint_names = {}
  end
  if self.external_resolver == nil then
    self:revalidate_external_files()
  end
  self:revalidate_external_topology()
  self:revalidate_known_headers()
  local snapshot = self:latest()
  logging.emit("debug", "project.scan.complete", {
    json.Member.new("generation", json.from_integer(snapshot.generation)),
    json.Member.new("project_modules", json.from_integer(
      #snapshot.project_modules)),
    json.Member.new("project_directories", json.from_integer(
      #snapshot.project_directories)),
    json.Member.new("dirty_modules", logging.summarize_strings(
      snapshot.dirty_modules)),
    json.Member.new("config_changed", json.from_boolean(config_changed)),
    json.Member.new("cpu_ms", json.from_number(
      logging.elapsed_ms(started))),
  })
  return snapshot
end

function Service:scan(): (Snapshot?, Error?)
  do
    return self:scan_or_raise(), nil
  catch
    if error is async.CancellationReason then raise end
    if error is Error then return nil, error as Error end
    return nil, Error.new(self.project_root, strings.tostring(error))
  end
end

local function bridge_project(state: ProjectState):
    compiler_bridge.ProjectModule
  local files: {compiler_bridge.SourceFile} = {}
  for index = 1, #state.source_files do
    local source = state.source_files[index]
    files[index] = compiler_bridge.SourceFile.new(
      source.filename, source.contents)
  end
  return compiler_bridge.ProjectModule.new(state.module_name, files)
end

local function stamp_digest(stamps: {project_graph.FileStamp}): string
  local output = strings.writer()
  for index = 1, #stamps do
    local stamp = stamps[index]
    output:write(#stamp.path .. ":")
    output:write(stamp.path)
    output:write(":" .. stamp.modified_seconds .. ":" ..
                 stamp.modified_nanoseconds .. ":" .. stamp.size .. ";")
  end
  return output:drain()
end

local function analyzed_input_digest(
    source_stamps: string,
    dependencies: {compiler_bridge.CHeaderDependency}): string
  local headers = header_dependency_digest(dependencies)
  return #source_stamps .. ":" .. source_stamps ..
         #headers .. ":" .. headers
end

local function graph_manifest(snapshot: compiler_bridge.ModuleSnapshot):
    project_graph.Manifest?
  if snapshot.manifest == nil then return nil end
  local source? = snapshot.manifest.source_serialized
  if source == nil then return nil end
  return project_graph.Manifest.new(
    snapshot.manifest.serialized, source)
end

local function Service:prepare_work_avoiding(
    blocked_revisions: {string: integer}): AnalysisRequest?
  -- Fixed-point iterations do not necessarily re-enter scan. Revalidate the
  -- exact compiler-observed paths before every token selection as well.
  self:revalidate_known_headers()
  local dirty = self.graph:dirty_modules()
  if #dirty == 0 or #self.project_names == 0 then return nil end

  local selected: {string} = {}
  local tokens: {project_graph.CheckToken} = {}
  for index = 1, #dirty do
    local token? = self.graph:begin_project_check(dirty[index])
    if token ~= nil then
      if blocked_revisions[token.module_name] == token.revision then
        self.graph:abort_project_check(token)
      else
        selected[#selected + 1] = token.module_name
        tokens[#tokens + 1] = token
      end
    end
  end
  if #selected == 0 then return nil end

  local modules: {compiler_bridge.ProjectModule} = {}
  for index = 1, #self.project_names do
    local name = self.project_names[index]
    modules[index] = bridge_project(self.projects[name])
  end

  local cached_sources: {compiler_bridge.CachedSourceInterface} = {}
  for index = 1, #self.external_names do
    local external = self.externals[self.external_names[index]]
    -- A stamp mismatch marks old serialized metadata as untrusted until this
    -- analysis encounters and republishes the external source. Binary provider
    -- resolution is always left to the compiler.
    local trusted = external.analyzed_input_identity ~= nil and
                    external.analyzed_input_identity ==
                      analyzed_input_digest(
                        stamp_digest(external.stamps),
                        external.c_header_dependencies)
    local header_fingerprint? =
      self.header_fingerprints[external.module_name]
    trusted = trusted and header_fingerprint ~= nil and
              same_header_dependencies(
                external.c_header_dependencies,
                header_fingerprint.dependencies)
    if self.external_resolver ~= nil then
      local fingerprint? = self.external_fingerprints[external.module_name]
      trusted = trusted and fingerprint ~= nil and
                external_matches_fingerprint(external, fingerprint)
    end
    if trusted then
      case external.origin
      when source: source then
        cached_sources[#cached_sources + 1] =
          compiler_bridge.CachedSourceInterface.new(
            external.module_name, external.manifest.public_digest,
            external.manifest.source_digest,
            source.main_file, source.source_files,
            external.compiler_imports,
            external.c_header_dependencies)
      else
      end
    end
  end

  local fingerprints: {ExternalFingerprint} = {}
  for index = 1, #self.external_fingerprint_names do
    local fingerprint? =
      self.external_fingerprints[self.external_fingerprint_names[index]]
    if fingerprint ~= nil then
      fingerprints[#fingerprints + 1] =
        copy_external_fingerprint(fingerprint)
    end
  end
  local header_fingerprints: {HeaderFingerprint} = {}
  for index = 1, #self.header_fingerprint_names do
    local fingerprint? =
      self.header_fingerprints[self.header_fingerprint_names[index]]
    if fingerprint ~= nil then
      header_fingerprints[#header_fingerprints + 1] =
        copy_header_fingerprint(fingerprint)
    end
  end
  local request = AnalysisRequest.new(
    self.graph:generation(), copy_config(self.current_config),
    selected[1], modules, selected, cached_sources, fingerprints,
    header_fingerprints, tokens)
  logging.emit("debug", "analysis.workset", {
    json.Member.new("generation", json.from_integer(request.generation)),
    json.Member.new("root_module", json.from_string(request.root_module)),
    json.Member.new("dirty_modules", logging.summarize_strings(
      request.dirty_modules)),
    json.Member.new("cached_sources", json.from_integer(
      #request.cached_sources)),
    json.Member.new("external_fingerprints", json.from_integer(
      #request.external_fingerprints)),
    json.Member.new("header_fingerprints", json.from_integer(
      #request.header_fingerprints)),
  })
  return request
end

function Service:prepare_work(): AnalysisRequest?
  return self:prepare_work_avoiding({})
end

local function graph_imports(snapshot: compiler_bridge.ModuleSnapshot):
    {project_graph.ImportEdge}
  local result: {project_graph.ImportEdge} = {}
  for index = 1, #snapshot.imports do
    local source = snapshot.imports[index]
    local visibility = project_graph.ImportVisibility.ordinary()
    if source.source_required then
      visibility = project_graph.ImportVisibility.source_required()
    end
    result[index] = project_graph.ImportEdge.new(
      source.module_name, visibility)
  end
  return result
end

-- A nil-manifest compiler snapshot can be an explicit transitive-failure
-- result, but the bridge's loader-level fallback has no complete import frame.
-- Retain the last successful frame and merge anything the failed attempt did
-- observe. A later successful commit replaces this conservative union with the
-- exact current imports.
local function failed_project_imports(
    service: Service, module_name: string,
    snapshot: compiler_bridge.ModuleSnapshot?):
    {project_graph.ImportEdge}
  local result = service.graph:direct_imports(module_name)
  if snapshot ~= nil then
    local observed = graph_imports(snapshot as compiler_bridge.ModuleSnapshot)
    for index = 1, #observed do result[#result + 1] = observed[index] end
  end
  return result
end

local function same_header_input(
    left: compiler_bridge.CHeaderDependency,
    right: compiler_bridge.CHeaderDependency): boolean
  return header_kind_name(left.kind) == header_kind_name(right.kind) and
         left.path == right.path
end

-- The same fallback cannot prove that an empty header closure is complete.
-- Preserve the prior closure, replacing identities for paths observed by this
-- attempt and appending newly observed inputs. This keeps edits, restoration,
-- and include-shadow changes capable of scheduling recovery.
local function failed_project_headers(
    service: Service, module_name: string,
    snapshot: compiler_bridge.ModuleSnapshot?):
    ({compiler_bridge.CHeaderDependency}, boolean)
  local result: {compiler_bridge.CHeaderDependency} = {}
  local known = false
  local previous? = service.header_fingerprints[module_name]
  if previous ~= nil then
    result = copy_header_dependencies(previous.dependencies)
    known = true
  end
  if snapshot ~= nil then
    local observed = (snapshot as compiler_bridge.ModuleSnapshot).
      c_header_dependencies
    if #observed > 0 then known = true end
    for observed_index = 1, #observed do
      local dependency = observed[observed_index]
      local replaced = false
      for result_index = 1, #result do
        if same_header_input(result[result_index], dependency) then
          result[result_index] = copy_header_dependencies({dependency})[1]
          replaced = true
          break
        end
      end
      if not replaced then
        result[#result + 1] = copy_header_dependencies({dependency})[1]
      end
    end
  end
  return result, known
end

local function Service:publish_failed_project(
    module_name: string, state: ProjectState,
    token: project_graph.CheckToken,
    snapshot: compiler_bridge.ModuleSnapshot?,
    diagnostics: {compiler_bridge.Diagnostic}): boolean
  local imports = failed_project_imports(self, module_name, snapshot)
  local headers, headers_known = failed_project_headers(
    self, module_name, snapshot)
  if not self.graph:fail_project_check(token, imports) then return false end
  -- Failed results leave the work queue, so an unresolved ordinary import must
  -- acquire a durable missing-provider baseline now. External trees are not
  -- watched; later semantic-request topology probes compare against this
  -- physical absence and dirty the failed importer when a provider appears.
  if self.external_resolver ~= nil then
    for index = 1, #imports do
      local edge = imports[index]
      local name = edge.module_name
      if self.projects[name] == nil and self.externals[name] == nil then
        local requires_source = false
        case edge.visibility
        when source_required then requires_source = true
        when ordinary then
        end
        local previous? = self.external_fingerprints[name]
        if previous == nil then
          self.external_fingerprints[name] = ExternalFingerprint.new(
            name, requires_source, true, nil, {}, nil)
          insert_name(self.external_fingerprint_names, name)
        elseif previous.origin == nil and
               requires_source and not previous.source_required then
          self.external_fingerprints[name] = ExternalFingerprint.new(
            name, true, previous.topology_resolved, nil,
            copy_stamps(previous.stamps), previous.error)
        end
      end
    end
  end
  state.diagnostics = diagnostics
  state.compiler_snapshot = snapshot
  if headers_known then self:remember_header_fingerprint(module_name, headers) end
  return true
end

local function external_candidate(
    snapshot: compiler_bridge.ModuleSnapshot,
    contextual_resolutions: {compiler_bridge.ContextualResolution}):
    ExternalModule?
  if snapshot.manifest == nil then return nil end
  local stamps: {project_graph.FileStamp} = {}
  local origin?: ExternalOrigin
  local analyzed_input_identity: string? = nil
  case snapshot.provenance
  when external_source: source then
    for index = 1, #source.source_files do
      local stamp? = stamp_for(source.source_files[index])
      if stamp == nil then
        return fail<ExternalModule>(source.source_files[index],
          "external source disappeared while compiler results were committed")
      end
      stamps[index] = stamp
    end
    origin = ExternalOrigin.source(ExternalSource.new(
      source.main_file, copy_strings(source.source_files)))
    analyzed_input_identity = analyzed_input_digest(
      stamp_digest(stamps), snapshot.c_header_dependencies)
  when dynamic_binary: binary then
    local stamp? = stamp_for(binary.provider_file)
    if stamp == nil then
      return fail<ExternalModule>(binary.provider_file,
        "external binary disappeared while compiler results were committed")
    end
    stamps[1] = stamp
    origin = ExternalOrigin.dynamic_binary(
      ExternalBinary.new(binary.provider_file))
  when static_binary: binary then
    local stamp? = stamp_for(binary.provider_file)
    if stamp == nil then
      return fail<ExternalModule>(binary.provider_file,
        "external static provider disappeared while compiler results were committed")
    end
    stamps[1] = stamp
    origin = ExternalOrigin.static_binary(
      ExternalBinary.new(binary.provider_file))
  when project_source then
    return nil
  end
  local imports = graph_imports(snapshot)
  for index = 1, #contextual_resolutions do
    local resolution = contextual_resolutions[index]
    if resolution.exposer_module == snapshot.module_name then
      imports[#imports + 1] = project_graph.ImportEdge.new(
        resolution.owner_module,
        project_graph.ImportVisibility.ordinary())
    end
  end
  return ExternalModule.new(
    snapshot.module_name, origin,
    project_graph.Manifest.new(snapshot.manifest.serialized,
      snapshot.manifest.source_serialized or snapshot.manifest.serialized),
    stamps, analyzed_input_identity, imports, snapshot.imports,
    copy_header_dependencies(snapshot.c_header_dependencies))
end

local function project_snapshot_map(
    analysis: compiler_bridge.Analysis):
    {string: compiler_bridge.ModuleSnapshot}
  local result: {string: compiler_bridge.ModuleSnapshot} = {}
  for index = 1, #analysis.modules do
    local snapshot = analysis.modules[index]
    case snapshot.provenance
    when project_source then result[snapshot.module_name] = snapshot
    else
    end
  end
  return result
end

local function diagnostic_owner(service: Service,
                                diagnostic: compiler_bridge.Diagnostic,
                                fallback: string): string
  if diagnostic.location ~= nil then
    local owner? = service.catalog:owner_for_file(
      diagnostic.location.filename)
    if owner ~= nil then return owner end
  end
  if diagnostic.owner_module ~= nil then
    return diagnostic.owner_module
  end
  return fallback
end

local function diagnostics_by_module(
    service: Service, analysis: compiler_bridge.Analysis,
    attempted: {string}):
    {string: {compiler_bridge.Diagnostic}}
  local result: {string: {compiler_bridge.Diagnostic}} = {}
  for index = 1, #attempted do
    result[attempted[index]] = {}
  end
  for index = 1, #analysis.diagnostics do
    local diagnostic = analysis.diagnostics[index]
    local owner = diagnostic_owner(service, diagnostic, analysis.root_module)
    local bucket? = result[owner]
    if bucket == nil then
      bucket = {}
      result[owner] = bucket
    end
    bucket[#bucket + 1] = diagnostic
  end
  return result
end

local function project_commit_order(
    names: {string}, snapshots: {string: compiler_bridge.ModuleSnapshot}):
    {string}
  local pending: {string: boolean} = {}
  local project: {string: boolean} = {}
  for index = 1, #names do
    pending[names[index]] = true
    project[names[index]] = true
  end

  local result: {string} = {}
  while #result < #names do
    local progressed = false
    for index = 1, #names do
      local name = names[index]
      if pending[name] then
        local ready = true
        local snapshot? = snapshots[name]
        if snapshot ~= nil then
          for import_index = 1, #snapshot.imports do
            local dependency = snapshot.imports[import_index].module_name
            if project[dependency] and pending[dependency] then
              ready = false
              break
            end
          end
        end
        if ready then
          pending[name] = nil
          result[#result + 1] = name
          progressed = true
        end
      end
    end
    if not progressed then
      -- The compiler normally rejects import cycles. Preserve deterministic
      -- progress for a malformed injected result; the graph will leave any
      -- re-invalidated cycle member dirty for the next analysis.
      for index = 1, #names do
        local name = names[index]
        if pending[name] then
          pending[name] = nil
          result[#result + 1] = name
        end
      end
    end
  end
  return result
end

local function Service:replace_external(
    external: ExternalModule, satisfied_projects: {string})
  case external.origin
  when source then
    self.graph:publish_external_source(
      external.module_name, external.stamps, external.manifest,
      external.imports, satisfied_projects)
  when dynamic_binary then
    self.graph:publish_external_binary(
      external.module_name, external.stamps, external.manifest,
      external.imports, satisfied_projects)
  when static_binary then
    self.graph:publish_external_binary(
      external.module_name, external.stamps, external.manifest,
      external.imports, satisfied_projects)
  end
  self.externals[external.module_name] = external
  insert_name(self.external_names, external.module_name)
  self:remember_header_fingerprint(
    external.module_name, external.c_header_dependencies)
end

local function request_token(request: AnalysisRequest,
                             module_name: string): project_graph.CheckToken?
  for index = 1, #request.check_tokens do
    local token = request.check_tokens[index]
    if token.module_name == module_name then return token end
  end
  return nil
end

local function request_external_fingerprint(
    request: AnalysisRequest, module_name: string): ExternalFingerprint?
  for index = 1, #request.external_fingerprints do
    local fingerprint = request.external_fingerprints[index]
    if fingerprint.module_name == module_name then return fingerprint end
  end
  return nil
end

local function analysis_source_required(
    service: Service, analysis: compiler_bridge.Analysis,
    module_name: string): boolean
  local replaced_importers: {string: boolean} = {}
  for index = 1, #analysis.modules do
    replaced_importers[analysis.modules[index].module_name] = true
  end

  -- Preserve requirements from clean importers absent from this partial
  -- result, then replace every analyzed importer's old edges with its current
  -- compiler imports.
  local reverse = service.graph:reverse_imports(module_name)
  for index = 1, #reverse do
    local edge = reverse[index]
    if not replaced_importers[edge.importer] then
      case edge.visibility
      when source_required then return true
      else
      end
    end
  end
  for index = 1, #analysis.modules do
    local snapshot = analysis.modules[index]
    for import_index = 1, #snapshot.imports do
      local edge = snapshot.imports[import_index]
      if edge.module_name == module_name and edge.source_required then
        return true
      end
    end
  end
  return false
end

local function candidate_fingerprint(
    service: Service, analysis: compiler_bridge.Analysis,
    external: ExternalModule): ExternalFingerprint
  return ExternalFingerprint.new(
    external.module_name,
    analysis_source_required(service, analysis, external.module_name),
    true, copy_external_origin(external.origin),
    copy_stamps(external.stamps), nil)
end

local function contextual_fingerprint(
    resolution: compiler_bridge.ContextualResolution): ExternalFingerprint
  local raw = compiler_bridge.ExternalResolution.new(
    resolution.owner_module, resolution.provenance, nil)
  local observed = fingerprint_from_resolution(raw, false)
  return ExternalFingerprint.new(
    observed.module_name, false, resolution.ordinary_lookup,
    observed.origin, observed.stamps, observed.error)
end

local function same_provider_identity(
    identity: compiler_io.LstatIdentity): boolean
  local current? = fs.stat(identity.path)
  if current == nil then return false end
  return current.size == identity.size and
         current.kind == identity.kind and
         current.device == identity.device and
         current.inode == identity.inode and
         current.modified_seconds == identity.modified_seconds and
         current.modified_nanoseconds == identity.modified_nanoseconds
end

local function same_provider_identity_claim(
    left: compiler_io.LstatIdentity?,
    right: compiler_io.LstatIdentity?): boolean
  if left == nil or right == nil then return left == nil and right == nil end
  local actual_left = left as compiler_io.LstatIdentity
  local actual_right = right as compiler_io.LstatIdentity
  return actual_left.path == actual_right.path and
         actual_left.size == actual_right.size and
         actual_left.kind == actual_right.kind and
         actual_left.device == actual_right.device and
         actual_left.inode == actual_right.inode and
         actual_left.modified_seconds == actual_right.modified_seconds and
         actual_left.modified_nanoseconds ==
           actual_right.modified_nanoseconds
end

local function binary_provider_key(module_name: string, kind: string,
                                   provider_file: string): string
  return module_name .. "\0" .. kind .. "\0" .. provider_file
end

local function binary_provider_observation_is_current(
    observation: compiler_bridge.BinaryProviderObservation): boolean
  if observation.kind ~= "dynamic" and observation.kind ~= "static" then
    return false
  end
  local identity? = observation.provider_identity
  return identity ~= nil and
         (identity as compiler_io.LstatIdentity).path ==
           observation.provider_file and
         same_provider_identity(identity as compiler_io.LstatIdentity)
end

-- A first-seen contextual owner is safe to publish in the analysis which
-- discovered it only when every compiler observation for that logical owner
-- still names the exact followed provider object. Merely statting provenance
-- after analysis cannot distinguish stable discovery from replacement while
-- package.loadlib was consuming the provider.
local function contextual_provider_is_current(
    analysis: compiler_bridge.Analysis, module_name: string): boolean
  local found = false
  for index = 1, #analysis.contextual_resolutions do
    local resolution = analysis.contextual_resolutions[index]
    if resolution.owner_module == module_name then
      found = true
      local provider_file?: string = nil
      case resolution.provenance
      when dynamic_binary: binary then provider_file = binary.provider_file
      when static_binary: binary then provider_file = binary.provider_file
      else return false
      end
      local identity? = resolution.provider_identity
      if identity == nil or
         (identity as compiler_io.LstatIdentity).path ~= provider_file or
         not same_provider_identity(identity as compiler_io.LstatIdentity) then
        return false
      end
    end
  end
  return found
end

local function same_external_observation(left: ExternalFingerprint,
                                         right: ExternalFingerprint): boolean
  return left.module_name == right.module_name and
         left.error == right.error and
         origin_identity(left.origin) == origin_identity(right.origin) and
         same_stamps(left.stamps, right.stamps)
end

local function merge_observed_fingerprint(
    observed: {string: ExternalFingerprint}, names: {string},
    candidate: ExternalFingerprint)
  local existing? = observed[candidate.module_name]
  if existing == nil then
    observed[candidate.module_name] = candidate
    insert_name(names, candidate.module_name)
    return
  end
  if not same_external_observation(existing, candidate) then
    raise Error.new(candidate.module_name,
      "compiler reported conflicting physical providers for contextual owner")
  end
  local origin?: ExternalOrigin = nil
  if existing.origin ~= nil then
    origin = copy_external_origin(existing.origin as ExternalOrigin)
  end
  observed[candidate.module_name] = ExternalFingerprint.new(
    candidate.module_name,
    existing.source_required or candidate.source_required,
    existing.topology_resolved or candidate.topology_resolved,
    origin, copy_stamps(existing.stamps), existing.error)
end

local function Service:abort_request(request: AnalysisRequest)
  for index = 1, #request.check_tokens do
    self.graph:abort_project_check(request.check_tokens[index])
  end
end

local function Service:commit_or_raise(
    request: AnalysisRequest,
    analysis: compiler_bridge.Analysis): RefreshReport
  if request.generation ~= self.graph:generation() then
    self:abort_request(request)
    return RefreshReport.new(
      true, true, self.graph:generation(), {}, {},
      self.graph:dirty_modules())
  end

  local project_snapshots = project_snapshot_map(analysis)
  local module_diagnostics = diagnostics_by_module(
    self, analysis, request.dirty_modules)

  -- Compiler work may yield while a save is completed before its watcher
  -- callback is dispatched. Re-run the complete
  -- saved-file/config discovery immediately before publication; unchanged
  -- files reuse their captured bytes, while any changed membership or stamp
  -- advances the graph generation and rejects this result.
  self:scan_or_raise()
  if request.generation ~= self.graph:generation() then
    self:abort_request(request)
    return RefreshReport.new(
      true, true, self.graph:generation(), {}, {},
      self.graph:dirty_modules())
  end

  if self.external_resolver ~= nil then
    -- A topology probe performed by the pre-publication scan must still match
    -- every immutable input supplied to this compiler request. External graph
    -- invalidation changes check revisions rather than the saved-file
    -- generation, so make this rejection explicit before any project commit.
    for index = 1, #request.external_fingerprints do
      local before = request.external_fingerprints[index]
      local current? = self.external_fingerprints[before.module_name]
      if current == nil or
         not same_external_fingerprint(before, current) then
        self:abort_request(request)
        return RefreshReport.new(
          true, true, self.graph:generation(), {}, {},
          self.graph:dirty_modules())
      end
    end
  end

  -- Header invalidation changes project revisions (or external consumers), not
  -- necessarily the saved-file generation. The immutable request baseline must
  -- still be the one selected before compiler work began.
  for index = 1, #request.header_fingerprints do
    local before = request.header_fingerprints[index]
    local current? = self.header_fingerprints[before.module_name]
    if current == nil or
       not same_header_dependencies(before.dependencies,
                                    current.dependencies) then
      self:abort_request(request)
      return RefreshReport.new(
        true, true, self.graph:generation(), {}, {},
        self.graph:dirty_modules())
    end
  end

  -- Stat compiler-observed external provenance only after the final topology
  -- probe. Publication is all-or-nothing: a new external or any difference
  -- from the pre-analysis fingerprint establishes the next attempt's baseline
  -- and rejects this attempt before project tokens are committed.
  local external_candidates: {ExternalModule} = {}
  local observed_fingerprints: {string: ExternalFingerprint} = {}
  local observed_names: {string} = {}
  local contextual_names: {string: boolean} = {}
  local snapshot_binary_keys: {string: string} = {}
  local snapshot_binaries:
    {string: compiler_bridge.ModuleSnapshot} = {}
  local snapshot_binary_names: {string} = {}
  local binary_observation_keys: {string: boolean} = {}
  local binary_observations:
    {string: compiler_bridge.BinaryProviderObservation} = {}
  local unstable_external = false
  for index = 1, #analysis.modules do
    local snapshot = analysis.modules[index]
    case snapshot.provenance
    when project_source then
    else
      case snapshot.provenance
      when dynamic_binary: binary then
        snapshot_binary_keys[snapshot.module_name] =
          binary_provider_key(
            snapshot.module_name, "dynamic", binary.provider_file)
        snapshot_binaries[snapshot.module_name] = snapshot
        insert_name(snapshot_binary_names, snapshot.module_name)
      when static_binary: binary then
        snapshot_binary_keys[snapshot.module_name] =
          binary_provider_key(
            snapshot.module_name, "static", binary.provider_file)
        snapshot_binaries[snapshot.module_name] = snapshot
        insert_name(snapshot_binary_names, snapshot.module_name)
      else
      end
      local external? = external_candidate(
        snapshot, analysis.contextual_resolutions)
      if external ~= nil then
        external_candidates[#external_candidates + 1] = external
        merge_observed_fingerprint(
          observed_fingerprints, observed_names,
          candidate_fingerprint(self, analysis, external))
      end
    end
  end
  for index = 1, #analysis.binary_provider_observations do
    local observation = analysis.binary_provider_observations[index]
    local key = binary_provider_key(
      observation.module_name, observation.kind,
      observation.provider_file)
    binary_observation_keys[key] = true
    binary_observations[key] = observation
  end
  for index = 1, #analysis.contextual_resolutions do
    local observed = contextual_fingerprint(
      analysis.contextual_resolutions[index])
    contextual_names[observed.module_name] = true
    merge_observed_fingerprint(
      observed_fingerprints, observed_names, observed)
  end
  for index = 1, #observed_names do
    local name = observed_names[index]
    if self.external_resolver ~= nil or contextual_names[name] then
      local observed = observed_fingerprints[name]
      local before? = request_external_fingerprint(request, name)
      local changed = before == nil or
                      not same_external_fingerprint(before, observed)
      self.external_fingerprints[name] = observed
      insert_name(self.external_fingerprint_names, name)
      if changed then
        local validate_first_seen = false
        if before == nil and contextual_names[name] then
          -- Defer both invalidation and retry until the final provider
          -- postvalidation below. Stable discovery belongs to this exact
          -- compiler result and is not itself an input change.
          validate_first_seen = true
        end
        if before == nil and snapshot_binary_keys[name] ~= nil then
          validate_first_seen = true
        end
        if not validate_first_seen then
          self.graph:invalidate_external_change(name)
          if self.external_resolver ~= nil then unstable_external = true end
        end
      end
    end
  end


  -- All filesystem/provenance work above may yield. Immediately before the
  -- first graph publication, restat both the immutable pre-analysis closure
  -- and every closure the compiler just observed. The first protects clean
  -- cached modules used by this request; the second protects newly discovered
  -- direct/transitive headers and first-seen external source modules.
  local unstable_headers = false
  for index = 1, #request.header_fingerprints do
    local before = request.header_fingerprints[index]
    local current = self:restat_header_dependencies(
      before.module_name, before.dependencies)
    if not same_header_dependencies(before.dependencies, current) then
      self:accept_revalidated_headers(before.module_name, current)
      unstable_headers = true
    end
  end
  for index = 1, #analysis.modules do
    local snapshot = analysis.modules[index]
    local current = self:restat_header_dependencies(
      snapshot.module_name, snapshot.c_header_dependencies)
    if not same_header_dependencies(
        snapshot.c_header_dependencies, current) then
      self:accept_revalidated_headers(snapshot.module_name, current)
      unstable_headers = true
    end
  end
  if unstable_headers then
    self:abort_request(request)
    return RefreshReport.new(
      true, true, self.graph:generation(), {}, {},
      self.graph:dirty_modules())
  end
  local invalid_provider_names: {string} = {}
  for index = 1, #analysis.provider_conflicts do
    insert_name(invalid_provider_names, analysis.provider_conflicts[index])
  end
  for index = 1, #observed_names do
    local name = observed_names[index]
    if contextual_names[name] and
       not contextual_provider_is_current(analysis, name) then
      insert_name(invalid_provider_names, name)
    end
  end
  for index = 1, #analysis.binary_provider_observations do
    local observation = analysis.binary_provider_observations[index]
    if not binary_provider_observation_is_current(observation) then
      insert_name(invalid_provider_names, observation.module_name)
    end
  end
  for index = 1, #snapshot_binary_names do
    local name = snapshot_binary_names[index]
    local expected? = snapshot_binary_keys[name]
    local snapshot? = snapshot_binaries[name]
    local observation?: compiler_bridge.BinaryProviderObservation = nil
    if expected ~= nil then observation = binary_observations[expected] end
    if expected == nil or not binary_observation_keys[expected] or
       snapshot == nil or observation == nil or
       not same_provider_identity_claim(
         snapshot.provider_identity, observation.provider_identity) then
      insert_name(invalid_provider_names, name)
    end
  end
  for index = 1, #invalid_provider_names do
    self.graph:invalidate_external_change(invalid_provider_names[index])
    unstable_external = true
  end
  if unstable_external then
    self:abort_request(request)
    return RefreshReport.new(
      true, true, self.graph:generation(), {}, {},
      self.graph:dirty_modules())
  end

  local committed: {string} = {}
  local failed: {string} = {}
  local order = project_commit_order(
    request.dirty_modules, project_snapshots)
  for index = 1, #order do
    local name = order[index]
    local state? = self.projects[name]
    local snapshot? = project_snapshots[name]
    local token? = request_token(request, name)
    if state ~= nil and token ~= nil then
      local diagnostics? = module_diagnostics[name]
      if diagnostics == nil then diagnostics = {} end
      if snapshot == nil and #diagnostics == 0 then
        -- The compiler bridge emits an explicit nil-manifest snapshot for a
        -- project invalidated transitively by another module's diagnostic.
        -- With neither that snapshot nor an owned diagnostic there is no
        -- evidence of a completed result for this token. Reject the malformed
        -- analysis instead of turning an omission into a terminal failure.
        raise Error.new(
          name, "compiler analysis omitted the attempted project module")
      elseif #diagnostics == 0 and snapshot ~= nil then
        local manifest? = graph_manifest(snapshot)
        if manifest ~= nil then
          case self.graph:commit_project(
              token, manifest, graph_imports(snapshot), snapshot)
          when accepted then
            state.diagnostics = diagnostics
            state.compiler_snapshot = snapshot
            self:remember_header_fingerprint(
              name, snapshot.c_header_dependencies)
            committed[#committed + 1] = name
          when stale then
          end
        else
          if self:publish_failed_project(
              name, state, token, snapshot, diagnostics) then
            failed[#failed + 1] = name
          end
        end
      else
        -- A compiler error is a result for this exact saved revision, but does
        -- not publish an annotated AST or manifest. Record it as current and
        -- retry only after source/dependency/provider/header invalidation.
        if self:publish_failed_project(
            name, state, token, snapshot, diagnostics) then
          failed[#failed + 1] = name
        end
      end
    end
  end

  -- External candidates were observed while producing this exact request.
  -- Publish them after project tokens are resolved, suppressing invalidation of
  -- those same analyzed roots while still reaching other clean consumers.
  for index = 1, #external_candidates do
    self:replace_external(
      external_candidates[index], request.dirty_modules)
  end

  return RefreshReport.new(
    true, false, self.graph:generation(), committed, failed,
    self.graph:dirty_modules())
end

function Service:commit(request: AnalysisRequest,
                        analysis: compiler_bridge.Analysis):
    (RefreshReport?, Error?)
  defer self:abort_request(request)
  do
    return self:commit_or_raise(request, analysis), nil
  catch
    if error is async.CancellationReason then raise end
    if error is Error then return nil, error as Error end
    if error is compiler_bridge.BridgeError then
      local failure = error as compiler_bridge.BridgeError
      return nil, Error.new(failure.module_name, failure.message)
    end
    return nil, Error.new(self.project_root, strings.tostring(error))
  end
end

local function Service:analyze_or_raise(
    request: AnalysisRequest): RefreshReport
  if request.generation ~= self.graph:generation() then
    self:abort_request(request)
    return RefreshReport.new(
      false, true, self.graph:generation(), {}, {},
      self.graph:dirty_modules())
  end
  if self.analysis_active then
    return fail<RefreshReport>(self.project_root,
      "compiler analysis is already active for this project")
  end
  self.analysis_active = true
  defer self.analysis_active = false
  defer self:abort_request(request)
  self.analysis_count = self.analysis_count + 1
  self.submitted_count = self.submitted_count + #request.dirty_modules
  local started = logging.clock()
  logging.emit("debug", "analysis.start", {
    json.Member.new("generation", json.from_integer(request.generation)),
    json.Member.new("root_module", json.from_string(request.root_module)),
    json.Member.new("dirty_modules", logging.summarize_strings(
      request.dirty_modules)),
  })
  local analysis = self.analyzer(request)
  local report = self:commit_or_raise(request, analysis)
  logging.emit("debug", "analysis.complete", {
    json.Member.new("generation", json.from_integer(report.generation)),
    json.Member.new("root_module", json.from_string(request.root_module)),
    json.Member.new("stale", json.from_boolean(report.stale)),
    json.Member.new("committed_modules", logging.summarize_strings(
      report.committed_modules)),
    json.Member.new("failed_modules", logging.summarize_strings(
      report.failed_modules)),
    json.Member.new("remaining_dirty", logging.summarize_strings(
      report.dirty_modules)),
    json.Member.new("cpu_ms", json.from_number(
      logging.elapsed_ms(started))),
  })
  return report
end

function Service:analyze(request: AnalysisRequest):
    (RefreshReport?, Error?)
  do
    return self:analyze_or_raise(request), nil
  catch
    if error is async.CancellationReason then raise end
    if error is Error then return nil, error as Error end
    if error is compiler_bridge.BridgeError then
      local failure = error as compiler_bridge.BridgeError
      return nil, Error.new(failure.module_name, failure.message)
    end
    return nil, Error.new(self.project_root, strings.tostring(error))
  end
end

local function Service:prune_unreachable_externals()
  local reachable_names = self.graph:reachable_external_modules()
  local reachable: {string: boolean} = {}
  for index = 1, #reachable_names do
    reachable[reachable_names[index]] = true
  end
  local old_names = copy_strings(self.external_names)
  for index = 1, #old_names do
    local name = old_names[index]
    if not reachable[name] and self.graph:prune_external(name) then
      self.externals[name] = nil
      remove_name(self.external_names, name)
      self:forget_header_fingerprint(name)
      self.external_fingerprints[name] = nil
      remove_name(self.external_fingerprint_names, name)
    end
  end
  local pending_names = copy_strings(self.external_fingerprint_names)
  for index = 1, #pending_names do
    local name = pending_names[index]
    if self.externals[name] == nil and
       #self.graph:reverse_imports(name) == 0 then
      self.external_fingerprints[name] = nil
      remove_name(self.external_fingerprint_names, name)
    end
  end
  local header_names = copy_strings(self.header_fingerprint_names)
  for index = 1, #header_names do
    local name = header_names[index]
    if self.projects[name] == nil and self.externals[name] == nil and
       #self.graph:reverse_imports(name) == 0 then
      self:forget_header_fingerprint(name)
    end
  end
end

local function Service:analyze_to_fixed_point(): (RefreshReport?, Error?)
  local committed: {string} = {}
  local failed: {string} = {}
  local analyzed = false
  local saw_stale = false
  local iteration_count = 0

  while true do
    local request? = self:prepare_work()
    if request == nil then break end
    iteration_count = iteration_count + 1
    local report?, analysis_error? = self:analyze(request)
    if report == nil then return nil, analysis_error end
    analyzed = true
    if report.stale then saw_stale = true end

    for index = 1, #report.committed_modules do
      local name = report.committed_modules[index]
      insert_name(committed, name)
      remove_name(failed, name)
    end
    for index = 1, #report.failed_modules do
      local name = report.failed_modules[index]
      insert_name(failed, name)
    end
  end

  -- Absence from one partial compiler result says nothing about externals used
  -- by clean modules. Prune only after the graph reaches a fixed point and only
  -- by reachability from every committed project import edge.
  self:prune_unreachable_externals()
  local report = RefreshReport.new(
    analyzed, saw_stale, self.graph:generation(), committed, failed,
    self.graph:dirty_modules())
  logging.emit("debug", "analysis.fixed_point", {
    json.Member.new("generation", json.from_integer(report.generation)),
    json.Member.new("iterations", json.from_integer(iteration_count)),
    json.Member.new("analyzed", json.from_boolean(report.analyzed)),
    json.Member.new("stale", json.from_boolean(report.stale)),
    json.Member.new("committed_modules", logging.summarize_strings(committed)),
    json.Member.new("failed_modules", logging.summarize_strings(failed)),
    json.Member.new("remaining_dirty", logging.summarize_strings(
      report.dirty_modules)),
  })
  return report, nil
end

local function Service:refresh_internal(snapshot_listener: SnapshotListener?):
    (RefreshReport?, Error?)
  local started = logging.clock()
  logging.emit("debug", "project.refresh.start", {
    json.Member.new("generation", json.from_integer(
      self.graph:generation())),
  })
  local scanned?, scan_error? = self:scan()
  if scanned == nil then
    logging.emit("error", "project.refresh.failure", {
      json.Member.new("path", json.from_string(scan_error.path)),
      json.Member.new("message", json.from_string(scan_error.message)),
      json.Member.new("cpu_ms", json.from_number(
        logging.elapsed_ms(started))),
    })
    return nil, scan_error
  end
  if snapshot_listener ~= nil then
    local listener: SnapshotListener = snapshot_listener
    listener(scanned)
  end
  local report?, refresh_error? = self:analyze_to_fixed_point()
  if report == nil then
    logging.emit("error", "project.refresh.failure", {
      json.Member.new("path", json.from_string(refresh_error.path)),
      json.Member.new("message", json.from_string(refresh_error.message)),
      json.Member.new("cpu_ms", json.from_number(
        logging.elapsed_ms(started))),
    })
    return nil, refresh_error
  end
  logging.emit("info", "project.refresh.complete", {
    json.Member.new("generation", json.from_integer(report.generation)),
    json.Member.new("analyzed", json.from_boolean(report.analyzed)),
    json.Member.new("committed", json.from_integer(
      #report.committed_modules)),
    json.Member.new("failed", json.from_integer(#report.failed_modules)),
    json.Member.new("dirty", json.from_integer(#report.dirty_modules)),
    json.Member.new("cpu_ms", json.from_number(
      logging.elapsed_ms(started))),
  })
  return report, nil
end

-- Preserve the long-standing no-argument refresh API for callers which do not
-- own watcher scope. Application uses the notifying variant to reconcile the
-- just-discovered saved tree before compiler work can yield for an extended
-- period.
function Service:refresh(): (RefreshReport?, Error?)
  return self:refresh_internal(nil)
end

function Service:refresh_with_snapshot_listener(
    snapshot_listener: SnapshotListener): (RefreshReport?, Error?)
  return self:refresh_internal(snapshot_listener)
end

function Service:counters(): Counters
  return Counters.new(
    self.read_count, self.analysis_count, self.submitted_count)
end

function Service:direct_imports(module_name: string):
    {project_graph.ImportEdge}
  return self.graph:direct_imports(module_name)
end

function Service:reverse_imports(module_name: string):
    {project_graph.ReverseImport}
  return self.graph:reverse_imports(module_name)
end

function Service:project_ast(module_name: string):
    compiler_bridge.ModuleSnapshot?
  return self.graph:project_ast(module_name)
end

function Service:external_module(module_name: string): ExternalModule?
  return self.externals[module_name]
end

-- Discovery records only directories traversed below the configured project
-- source root. External provenance is intentionally never added here.
function Service:project_directories(): {string}
  return copy_strings(self.catalog.directories)
end

function Service:latest(): Snapshot
  local projects: {ProjectModule} = {}
  for index = 1, #self.project_names do
    local name = self.project_names[index]
    local state = self.projects[name]
    local analysis_state = ProjectAnalysisState.clean()
    if self.graph:is_dirty(name) then
      analysis_state = ProjectAnalysisState.dirty()
    elseif self.graph:is_failed(name) then
      analysis_state = ProjectAnalysisState.failed()
    end
    projects[index] = ProjectModule.new(
      name, state.source_files, state.compiler_snapshot,
      copy_diagnostics(state.diagnostics), analysis_state)
  end
  local externals: {ExternalModule} = {}
  for index = 1, #self.external_names do
    externals[index] = self.externals[self.external_names[index]]
  end
  local issues: {project_discovery.Issue} = {}
  for index = 1, #self.catalog.issues do issues[index] = self.catalog.issues[index] end
  return Snapshot.new(
    self.graph:generation(), copy_config(self.current_config), issues,
    self:project_directories(), projects, externals,
    self.graph:dirty_modules())
end

local function create_or_raise(project_root: string,
                               installed_binary_modules_root: string,
                               analyzer: Analyzer,
                               external_resolver: ExternalResolver?,
                               header_restater: HeaderRestater?): Service
  local loaded?, config_error? = project_config.load(
    project_root, installed_binary_modules_root)
  if loaded == nil then
    return fail<Service>(config_error.path, config_error.message)
  end
  local found?, discovery_error? = project_discovery.discover(
    loaded.source_modules_root)
  if found == nil then
    return fail<Service>(discovery_error.path, discovery_error.message)
  end
  local service = Service.new(
    loaded.project_root, installed_binary_modules_root, analyzer,
    external_resolver, header_restater, loaded, found,
    project_graph.create<compiler_bridge.ModuleSnapshot>(), {}, {}, {}, {},
    {}, {}, {}, {}, 0, 0, 0, false)
  service:scan_or_raise()
  return service
end

function create_with_analyzer(project_root: string,
                              installed_binary_modules_root: string,
                              analyzer: Analyzer,
                              header_restater: HeaderRestater?):
    (Service?, Error?)
  do
    return create_or_raise(
      project_root, installed_binary_modules_root, analyzer, nil,
      header_restater), nil
  catch
    if error is async.CancellationReason then raise end
    if error is Error then return nil, error as Error end
    return nil, Error.new(project_root, strings.tostring(error))
  end
end

function create_with_analyzer_and_resolver(
    project_root: string, installed_binary_modules_root: string,
    analyzer: Analyzer, external_resolver: ExternalResolver,
    header_restater: HeaderRestater?):
    (Service?, Error?)
  do
    return create_or_raise(project_root, installed_binary_modules_root,
                           analyzer, external_resolver,
                           header_restater), nil
  catch
    if error is async.CancellationReason then raise end
    if error is Error then return nil, error as Error end
    return nil, Error.new(project_root, strings.tostring(error))
  end
end

local function load_with_services(
    project_root: string, installed_binary_modules_root: string,
    analyzer: Analyzer, external_resolver: ExternalResolver?,
    header_restater: HeaderRestater?,
    snapshot_listener: SnapshotListener?):
    (Service?, Error?)
  local service?: Service
  local failure?: Error
  if external_resolver == nil then
    service, failure = create_with_analyzer(
      project_root, installed_binary_modules_root, analyzer,
      header_restater)
  else
    service, failure = create_with_analyzer_and_resolver(
      project_root, installed_binary_modules_root, analyzer,
      external_resolver as ExternalResolver, header_restater)
  end
  if service == nil then return nil, failure end

  if snapshot_listener ~= nil then
    local listener: SnapshotListener = snapshot_listener
    do
      -- Register from the first complete discovery before compiler work can
      -- yield for an extended period. A second scan after registration catches
      -- a save in the finite interval between that discovery and the watcher.
      listener(service:latest())
      local rescanned?, scan_error? = service:scan()
      if rescanned == nil then return nil, scan_error end
      listener(rescanned)
    catch
      if error is async.CancellationReason then raise end
      if error is Error then return nil, error as Error end
      return nil, Error.new(project_root, strings.tostring(error))
    end
  end

  local report?, refresh_error? = service:analyze_to_fixed_point()
  if report == nil then return nil, refresh_error end
  return service, nil
end

function load_with_analyzer(project_root: string,
                            installed_binary_modules_root: string,
                            analyzer: Analyzer,
                            header_restater: HeaderRestater?,
                            snapshot_listener: SnapshotListener?):
    (Service?, Error?)
  return load_with_services(
    project_root, installed_binary_modules_root, analyzer, nil,
    header_restater, snapshot_listener)
end

function load_with_analyzer_and_resolver(
    project_root: string, installed_binary_modules_root: string,
    analyzer: Analyzer, external_resolver: ExternalResolver,
    header_restater: HeaderRestater?,
    snapshot_listener: SnapshotListener?):
    (Service?, Error?)
  return load_with_services(
    project_root, installed_binary_modules_root, analyzer,
    external_resolver, header_restater, snapshot_listener)
end

local function load_compiler(project_root: string):
    (compiler_bridge.Compiler?, Error?)
  local compiler?: compiler_bridge.Compiler
  do
    compiler = compiler_bridge.load()
  catch
    if error is async.CancellationReason then raise end
    if error is compiler_bridge.BridgeError then
      local failure = error as compiler_bridge.BridgeError
      return nil, Error.new(failure.module_name, failure.message)
    end
    return nil, Error.new(project_root, strings.tostring(error))
  end
  return compiler, nil
end

local function load_with_compiler(
    project_root: string, installed_binary_modules_root: string,
    compiler: compiler_bridge.Compiler,
    progress_listener: compiler_bridge.ProgressListener?,
    snapshot_listener: SnapshotListener?): (Service?, Error?)
  local analyzer: Analyzer = function (
      request: AnalysisRequest): compiler_bridge.Analysis
    compiler:configure_paths(
      request.config.source_modules_root,
      request.config.binary_modules_root,
      request.config.extra_ffi_include_dirs,
      request.config.extra_ffi_cppflags)
    return compiler:analyze_incremental(
      request.project_modules, request.dirty_modules,
      request.cached_sources, progress_listener)
  end
  local external_resolver: ExternalResolver = function (
      config: project_config.ProjectConfig, project_modules: {string},
      requests: {compiler_bridge.ExternalResolutionRequest}):
      {compiler_bridge.ExternalResolution}
    compiler:configure_paths(
      config.source_modules_root, config.binary_modules_root,
      config.extra_ffi_include_dirs, config.extra_ffi_cppflags)
    return compiler:resolve_external_modules(project_modules, requests)
  end
  local header_restater: HeaderRestater = function (
      dependencies: {compiler_bridge.CHeaderDependency}):
      {compiler_bridge.CHeaderDependency}
    return compiler:restat_c_header_dependencies(dependencies)
  end
  return load_with_services(
    project_root, installed_binary_modules_root, analyzer,
    external_resolver, header_restater, snapshot_listener)
end

function load(project_root: string,
              installed_binary_modules_root: string,
              progress_listener: compiler_bridge.ProgressListener?,
              snapshot_listener: SnapshotListener?):
    (Service?, Error?)
  local compiler?, failure? = load_compiler(project_root)
  if compiler == nil then return nil, failure end
  return load_with_compiler(
    project_root, installed_binary_modules_root, compiler,
    progress_listener, snapshot_listener)
end

function load_default(
    project_root: string,
    progress_listener: compiler_bridge.ProgressListener?,
    snapshot_listener: SnapshotListener?): (Service?, Error?)
  local compiler?, failure? = load_compiler(project_root)
  if compiler == nil then return nil, failure end
  local installed_root?: string
  do
    installed_root = compiler:installed_binary_modules_root()
  catch
    if error is async.CancellationReason then raise end
    if error is compiler_bridge.BridgeError then
      local bridge_error = error as compiler_bridge.BridgeError
      return nil, Error.new(bridge_error.module_name, bridge_error.message)
    end
    return nil, Error.new(project_root, strings.tostring(error))
  end
  return load_with_compiler(
    project_root, installed_root, compiler, progress_listener,
    snapshot_listener)
end
