--- Saved-source definition, references, rename, hover, and folding views.
-- @module server.semantic_features

local strings = import "string"
local bridge = import "server.compiler_bridge"
local lsp = import "server.lsp_types"
local indexer = import "server.semantic_index"
local source_text = import "server.source_text"
local sqlite3 = import "sqlite3"
local workspace_store = import "server.workspace_store"
local completion_types = import "server.completion_types"

record Error
  const message: string
end

record Location
  const uri: string
  const range: source_text.Span
end

record Hover
  const range: source_text.Span
  const inferred_type: bridge.TypeInfo?
  const declared_type: bridge.TypeInfo?
  const original_type: bridge.TypeInfo?
  const coerced_type: bridge.TypeInfo?
  const visibility: bridge.DeclarationVisibility
  const callable_signature: bridge.CallableSignature?
  const summary_markdown: string?
  const documentation: string?
end

local record SavedFile
  const module_name: string
  const contents: string
  const coordinates: source_text.CoordinateIndex
end

type Yield = function (): ()

local record ExtractionState
  const yield_now: Yield?
  work: integer
end

local function account(state: ExtractionState)
  if state.yield_now == nil then return end
  state.work = state.work + 1
  if state.work < 1024 then return end
  state.work = 0
  state.yield_now()
end

local record RenameAnchor
  const filename: string
  const before: source_text.ByteSpan
  const after: source_text.Span
end

local record PendingRenameAnchor
  const filename: string
  const before: source_text.ByteSpan
  const after_start: integer
  const after_finish: integer
end

-- RenameCandidate is intentionally not an encodable workspace edit. Its
-- edited_project_modules method supplies the in-memory saved-file snapshot to
-- the compiler. Only preflight can produce VerifiedRename after that analysis
-- has no diagnostics and every edited occurrence resolves to one declaration.
record RenameCandidate
  local const old_name: string
  local const new_name: string
  local const edited_projects: {bridge.ProjectModule}
  local const documents: {lsp.DocumentEdits}
  local const anchors: {RenameAnchor}
end

record VerifiedRename
  local const documents: {lsp.DocumentEdits}
end

record Features
  local const store: workspace_store.Store
  local const published_generation: integer
  local const index: indexer.Index
  local const owns_store: boolean
end

local record MaterializedHover
  const filename: string
  const byte_start: integer
  const inferred_type: bridge.TypeInfo?
  const declared_type: bridge.TypeInfo?
  const original_type: bridge.TypeInfo?
  const coerced_type: bridge.TypeInfo?
end

local record MaterializedFold
  const filename: string
  const range: lsp.FoldingRange
end

record PreparedView
  local const index: indexer.Prepared
  local const hovers: {MaterializedHover}
  local const folds: {MaterializedFold}
end

local function fail<|T|>(message: string): T
  raise Error.new(message)
end

local function rejected<|T|>(message: string): (T?, Error?)
  return nil, Error.new(message)
end

local function copy_position(position: source_text.Position):
    source_text.Position
  return source_text.Position.new(position.line, position.character)
end

local function copy_span(span: source_text.Span): source_text.Span
  return source_text.Span.new(
    copy_position(span.start), copy_position(span.finish))
end

local function copy_edit(edit: lsp.TextEdit): lsp.TextEdit
  return lsp.TextEdit.new(copy_span(edit.range), edit.new_text)
end

local function copy_documents(source: {lsp.DocumentEdits}):
    {lsp.DocumentEdits}
  local result: {lsp.DocumentEdits} = {}
  for index = 1, #source do
    local edits: {lsp.TextEdit} = {}
    for edit_index = 1, #source[index].edits do
      edits[edit_index] = copy_edit(source[index].edits[edit_index])
    end
    result[index] = lsp.DocumentEdits.new(source[index].uri, edits)
  end
  return result
end

local function copy_projects(source: {bridge.ProjectModule}):
    {bridge.ProjectModule}
  local result: {bridge.ProjectModule} = {}
  for module_index = 1, #source do
    local module = source[module_index]
    local files: {bridge.SourceFile} = {}
    for file_index = 1, #module.files do
      local file = module.files[file_index]
      files[file_index] = bridge.SourceFile.new(file.filename, file.contents)
    end
    result[module_index] = bridge.ProjectModule.new(module.module_name, files)
  end
  return result
end

local function saved_files(projects: {bridge.ProjectModule},
                           index: indexer.Prepared):
    {string: SavedFile}
  local result: {string: SavedFile} = {}
  local modules: {string: boolean} = {}
  for module_index = 1, #projects do
    local module = projects[module_index]
    if modules[module.module_name] then
      return fail<|{string: SavedFile}|>(
        "duplicate saved project module '" .. module.module_name .. "'")
    end
    modules[module.module_name] = true
    for file_index = 1, #module.files do
      local file = module.files[file_index]
      if result[file.filename] ~= nil then
        return fail<|{string: SavedFile}|>(
          "saved source file belongs to more than one project module: " ..
          file.filename)
      end
      local coordinates? = index:coordinate_index(file.filename)
      if coordinates == nil then
        return fail<|{string: SavedFile}|>(
          "semantic index omitted saved source coordinates: " ..
          file.filename)
      end
      result[file.filename] = SavedFile.new(
        module.module_name, file.contents, coordinates)
    end
  end
  return result
end

local function location_for(occurrence: indexer.Occurrence): Location
  local uri?, uri_error? = source_text.path_to_file_uri(occurrence.filename)
  if uri == nil then
    local detail = "invalid project source path"
    if uri_error ~= nil then detail = uri_error.message end
    return fail<|Location|>(
      "cannot encode location for '" .. occurrence.filename .. "': " ..
      detail)
  end
  return Location.new(uri, copy_span(occurrence.span))
end

function Features:definition(filename: string,
                             position: source_text.Position): Location?
  local occurrence? = self.index:occurrence_at(filename, position)
  if occurrence == nil then return nil end
  local definition? = self.index:definition(occurrence.symbol_id)
  if definition == nil then
    -- The symbol is unresolved or declared in external/foreign source. V1
    -- never navigates outside the project snapshot.
    return nil
  end
  return location_for(definition)
end

function Features:references(filename: string, position: source_text.Position,
                             include_declaration: boolean): {Location}
  local occurrence? = self.index:occurrence_at(filename, position)
  if occurrence == nil then return {} end
  local occurrences = self.index:occurrences(
    occurrence.symbol_id, include_declaration)
  local result: {Location} = {}
  for index = 1, #occurrences do
    result[index] = location_for(occurrences[index])
  end
  return result
end

local function same_type(left: bridge.TypeInfo?,
                         right: bridge.TypeInfo?): boolean
  if left == nil or right == nil then return left == nil and right == nil end
  return left.tag == right.tag and left.display == right.display
end

local function compiler_offset(coordinates: source_text.CoordinateIndex,
                               location: bridge.SourceLocation): integer?
  if location.line < 1 or location.column < 1 then return nil end
  local start? = coordinates:lf_line_start(location.line)
  local finish? = coordinates:lf_line_finish(location.line)
  if start == nil or finish == nil then return nil end
  local target = start + location.column - 1
  if target > finish then return nil end
  return target
end

local function hover_key(filename: string, offset: integer, name: string): string
  return #filename .. ":" .. filename .. offset .. ":" .. name
end

local function node_score(node: bridge.Node): integer
  local score = 0
  if node.inferred_type ~= nil then score = score + 1 end
  if node.declared_type ~= nil then score = score + 2 end
  if node.original_type ~= nil and node.coerced_type ~= nil then score = score + 4 end
  return score
end

-- These lookups are local to extraction; a published Features owns no ASTs.
local function hover_nodes(snapshot: bridge.ModuleSnapshot,
                          files: {string: SavedFile}, state: ExtractionState):
    ({string: bridge.Node}, {integer: bridge.Node})
  local selected: {string: bridge.Node} = {}
  local by_id: {integer: bridge.Node} = {}
  for index = 1, #snapshot.nodes do
    account(state)
    local node = snapshot.nodes[index]
    by_id[node.id] = node
    local location? = node.location
    if not node.synthetic and location ~= nil and node.name ~= nil then
      local saved? = files[location.filename]
      if saved ~= nil then
        local offset? = compiler_offset(saved.coordinates, location)
        if offset ~= nil then
          local key = hover_key(location.filename, offset, node.name)
          local old? = selected[key]
          -- Equal richness deliberately prefers the later preorder child.
          if old == nil or node_score(node) >= node_score(old) then selected[key] = node end
        end
      end
    end
  end
  return selected, by_id
end

local function semantic_container(kind: bridge.NodeKind): boolean
  case kind
  when expression() then return true
  when variable() then return true
  when type_syntax() then return true
  else return false
  end
end

local function node_covers_occurrence(node: bridge.Node, saved: SavedFile,
                                      occurrence: indexer.Occurrence): boolean
  local location? = node.location
  if location ~= nil and location.filename == occurrence.filename and
     compiler_offset(saved.coordinates, location) == occurrence.byte_span.start
  then
    return true
  end
  local span? = node.source_span
  if span == nil or not semantic_container(node.kind) or
     span.start.filename ~= occurrence.filename or
     span.finish.filename ~= occurrence.filename then
    return false
  end
  local start? = compiler_offset(saved.coordinates, span.start)
  local finish? = compiler_offset(saved.coordinates, span.finish)
  return start ~= nil and finish ~= nil and
         start <= occurrence.byte_span.start and
         occurrence.byte_span.start < finish
end

local function snapshot_for_module(snapshots: {bridge.ModuleSnapshot},
                                   module_name: string):
    bridge.ModuleSnapshot?
  for index = 1, #snapshots do
    local snapshot = snapshots[index]
    if snapshot.module_name == module_name then
      case snapshot.provenance
      when project_source() then return snapshot
      else return nil
      end
    end
  end
  return nil
end

local function materialize_hover(occurrence: indexer.Occurrence,
                                 saved: SavedFile,
                                 nodes: {string: bridge.Node},
                                 by_id: {integer: bridge.Node},
                                 state: ExtractionState): MaterializedHover
  local inferred: bridge.TypeInfo? = nil
  local declared: bridge.TypeInfo? = nil
  local original: bridge.TypeInfo? = nil
  local coerced: bridge.TypeInfo? = nil
  local current? = nodes[hover_key(
    occurrence.filename, occurrence.byte_span.start, occurrence.name)]
  while current ~= nil and node_covers_occurrence(current, saved, occurrence) do
    account(state)
    if inferred == nil and current.inferred_type ~= nil then inferred = current.inferred_type end
    if declared == nil and current.declared_type ~= nil then declared = current.declared_type end
    if original == nil and coerced == nil and current.original_type ~= nil and
       current.coerced_type ~= nil and not same_type(current.original_type, current.coerced_type) then
      original = current.original_type
      coerced = current.coerced_type
    end
    local parent_id? = current.parent_id
    if parent_id == nil then current = nil else current = by_id[parent_id] end
  end
  if inferred == nil then inferred = occurrence.type_info end
  return MaterializedHover.new(occurrence.filename, occurrence.byte_span.start,
    inferred, declared, original, coerced)
end

function Features:hover(filename: string, position: source_text.Position): Hover?
  local occurrence? = self.index:occurrence_at(filename, position)
  if occurrence == nil then return nil end
  local inferred: bridge.TypeInfo? = nil
  local declared: bridge.TypeInfo? = nil
  local original: bridge.TypeInfo? = nil
  local coerced: bridge.TypeInfo? = nil
  do
    local access = self.store:acquire()
    defer access:release()
    indexer.check_generation(access.connection, self.published_generation)
    local statement = access.connection:prepare(
      "SELECT inferred_tag,inferred_display,declared_tag,declared_display," ..
      "original_tag,original_display,coerced_tag,coerced_display " ..
      "FROM main.semantic_hovers WHERE filename=? AND byte_start=?")
    defer statement:close()
    local cursor = statement:query(indexer.blob(filename), occurrence.byte_span.start)
    defer cursor:close()
    local row? = cursor:fetch()
    if row == nil then return nil end
    inferred = indexer.row_type(row, 1)
    declared = indexer.row_type(row, 3)
    original = indexer.row_type(row, 5)
    coerced = indexer.row_type(row, 7)
  end
  return Hover.new(copy_span(occurrence.span), inferred, declared, original, coerced,
    occurrence.visibility, occurrence.callable_signature, self.index:hover_summary(occurrence),
    occurrence.documentation)
end

local function write_type_line(output: strings.StringWriter, label: string,
                               info: bridge.TypeInfo?)
  if info == nil then return end
  output:write("- ")
  output:write(label)
  output:write(": `")
  output:write(info.display)
  output:write("`\n")
end

function Hover:markdown(): string
  local output = strings.writer()
  local displayed_type? = self.inferred_type
  if displayed_type == nil then displayed_type = self.declared_type end
  if displayed_type == nil then displayed_type = self.original_type end
  if self.summary_markdown ~= nil then
    output:write(self.summary_markdown)
  elseif self.callable_signature ~= nil then
    output:write("- Signature: `")
    output:write(self.callable_signature.display)
    output:write("`\n")
  else
    write_type_line(output, "Type", displayed_type)
  end
  if self.summary_markdown ~= nil then
    output:write("\n")
  end
  if self.coerced_type ~= nil and displayed_type ~= nil and
     not same_type(self.coerced_type, displayed_type) then
    write_type_line(output, "Cast to", self.coerced_type)
  end
  output:write("- Visibility: ")
  case self.visibility
  when block() then output:write("block\n")
  when module() then output:write("module\n")
  when exported() then output:write("exported\n")
  end
  if self.documentation ~= nil then output:write("\n" .. self.documentation) end
  return output:drain()
end

local function foldable_tag(tag: string): boolean
  return tag == "Ast.TopLevelMethod" or
    tag == "Ast.TopLevelStatic" or
    tag == "Ast.TopLevelFunc" or
    tag == "Ast.TopLevelForeignFunc" or
    tag == "Ast.TopLevelRecord" or
    tag == "Ast.TopLevelUnion" or
    tag == "Ast.TopLevelInterface" or
    tag == "Ast.ExpFunction" or
    tag == "Ast.StatBlock" or
    tag == "Ast.StatTry" or
    tag == "Ast.StatIf" or
    tag == "Ast.StatFor" or
    tag == "Ast.StatForIn" or
    tag == "Ast.StatWhile" or
    tag == "Ast.StatRepeat" or
    tag == "Ast.StatCase"
end

local function lsp_span_for_compiler_span(saved: SavedFile,
                                           span: bridge.SourceSpan):
    source_text.Span
  if span.start.filename ~= span.finish.filename then
    return fail<|source_text.Span|>(
      "compiler structural span crosses source files")
  end
  local start? = compiler_offset(saved.coordinates, span.start)
  local finish? = compiler_offset(saved.coordinates, span.finish)
  if start == nil or finish == nil or finish < start then
    return fail<|source_text.Span|>(
      "compiler structural span is outside the saved source")
  end
  local converted?, conversion_error? = saved.coordinates:span_for_offsets(
    start, finish)
  if converted == nil then
    local detail = "invalid UTF-8 boundary"
    if conversion_error ~= nil then detail = conversion_error.message end
    return fail<|source_text.Span|>(
      "cannot convert compiler structural span: " .. detail)
  end
  return converted
end

local function insert_fold(ranges: {lsp.FoldingRange}, range: lsp.FoldingRange)
  -- SQLite deduplicates and orders these during publication/query.
  ranges[#ranges + 1] = range
end

local record LongBracket
  const level: integer
  const contents_start: integer
end

-- Titan's compiler AST intentionally drops comments. Mirror only the lexical
-- long-bracket boundary used by the Titan lexer; all language structures
-- continue to come from compiler source spans.
local function long_bracket(source: string, index: integer,
                            state: ExtractionState): LongBracket?
  if index > #source or strings.byte(source, index) ~= 91 then return nil end
  local cursor = index + 1
  while cursor <= #source and strings.byte(source, cursor) == 61 do
    account(state)
    cursor = cursor + 1
  end
  if cursor > #source or strings.byte(source, cursor) ~= 91 then return nil end
  return LongBracket.new(cursor - index - 1, cursor + 1)
end

local function long_bracket_finish(source: string, bracket: LongBracket,
                                   state: ExtractionState):
    integer?
  local index = bracket.contents_start
  while index <= #source do
    account(state)
    if strings.byte(source, index) == 93 then
      local cursor = index + 1
      local equals = 0
      while equals < bracket.level and cursor <= #source and
          strings.byte(source, cursor) == 61 do
        account(state)
        cursor = cursor + 1
        equals = equals + 1
      end
      if equals == bracket.level and cursor <= #source and
          strings.byte(source, cursor) == 93 then
        return cursor + 1
      end
    end
    index = index + 1
  end
  return nil
end

local function skip_short_string(source: string, index: integer,
                                 state: ExtractionState): integer
  local delimiter: integer = strings.byte(source, index)
  local cursor = index + 1
  while cursor <= #source do
    account(state)
    local byte: integer = strings.byte(source, cursor)
    if byte == delimiter then return cursor + 1 end
    if byte == 92 then
      if cursor == #source then return #source + 1 end
      local escaped: integer = strings.byte(source, cursor + 1)
      if cursor + 2 <= #source then
        local following: integer = strings.byte(source, cursor + 2)
        if (escaped == 10 and following == 13) or
            (escaped == 13 and following == 10) then
          cursor = cursor + 3
        else
          cursor = cursor + 2
        end
      else
        cursor = cursor + 2
      end
    else
      cursor = cursor + 1
    end
  end
  return #source + 1
end

local function insert_comment_fold(coordinates: source_text.CoordinateIndex,
                                   source: string, start_offset: integer,
                                   finish_offset: integer,
                                   ranges: {lsp.FoldingRange},
                                   state: ExtractionState)
  local start?, start_error? = coordinates:position_for_offset(start_offset)
  local finish?, finish_error? = coordinates:position_for_offset(finish_offset)
  if start_error ~= nil or finish_error ~= nil or
      start == nil or finish == nil then
    return
  end
  -- If anything follows the closing delimiter on its line, keep that whole
  -- line visible rather than folding unrelated source text with the comment.
  local end_line = finish.line
  local cursor = finish_offset + 1
  while cursor <= #source do
    account(state)
    local byte: integer = strings.byte(source, cursor)
    if byte == 10 or byte == 13 then break end
    if byte ~= 9 and byte ~= 11 and byte ~= 12 and byte ~= 32 then
      end_line = end_line - 1
      break
    end
    cursor = cursor + 1
  end
  if end_line <= start.line then return end
  insert_fold(ranges, lsp.FoldingRange.new(
    start.line, nil, end_line, nil, "comment"))
end

local function insert_long_comment_folds(saved: SavedFile,
                                         ranges: {lsp.FoldingRange},
                                         state: ExtractionState)
  local source = saved.contents
  local index = 1
  while index <= #source do
    account(state)
    local byte: integer = strings.byte(source, index)
    if byte == 34 or byte == 39 then
      index = skip_short_string(source, index, state)
    elseif byte == 91 then
      local literal? = long_bracket(source, index, state)
      if literal == nil then
        index = index + 1
      else
        local finish? = long_bracket_finish(source, literal, state)
        if finish == nil then return end
        index = finish
      end
    elseif byte == 45 and index < #source and
        strings.byte(source, index + 1) == 45 then
      local comment? = long_bracket(source, index + 2, state)
      if comment == nil then
        index = index + 2
        while index <= #source and strings.byte(source, index) ~= 10 do
          account(state)
          index = index + 1
        end
      else
        local finish? = long_bracket_finish(source, comment, state)
        if finish == nil then return end
        insert_comment_fold(
          saved.coordinates, source, index - 1, finish - 1, ranges, state)
        index = finish
      end
    else
      index = index + 1
    end
  end
end

function Features:folding_ranges(filename: string): {lsp.FoldingRange}
  local access = self.store:acquire()
  defer access:release()
  indexer.check_generation(access.connection, self.published_generation)
  local statement = access.connection:prepare(
    "SELECT start_line,end_line,kind FROM main.semantic_folds WHERE filename=? " ..
    "ORDER BY start_line,end_line DESC")
  defer statement:close()
  local cursor = statement:query(indexer.blob(filename))
  defer cursor:close()
  local result: {lsp.FoldingRange} = {}
  for row in cursor:fetch do
    result[#result + 1] = lsp.FoldingRange.new(row:get(1) as integer, nil,
      row:get(2) as integer, nil, indexer.optional_bytes(row, 3))
  end
  return result
end

function initialize_schema(connection: sqlite3.Connection)
  indexer.initialize_schema(connection)
  indexer.execute(connection, "CREATE TABLE IF NOT EXISTS main.semantic_hovers(" ..
    "filename BLOB NOT NULL,byte_start INTEGER NOT NULL," ..
    "inferred_tag BLOB,inferred_display BLOB,declared_tag BLOB,declared_display BLOB," ..
    "original_tag BLOB,original_display BLOB,coerced_tag BLOB,coerced_display BLOB," ..
    "PRIMARY KEY(filename,byte_start))")
  indexer.execute(connection, "CREATE TABLE IF NOT EXISTS main.semantic_folds(" ..
    "filename BLOB NOT NULL,start_line INTEGER NOT NULL,end_line INTEGER NOT NULL," ..
    "kind BLOB,PRIMARY KEY(filename,start_line,end_line))")
end

local function prepare_internal(projects: {bridge.ProjectModule},
                               snapshots: {bridge.ModuleSnapshot},
                               plan: indexer.PublicationPlan?,
                               yield_now: Yield?): PreparedView
  local state = ExtractionState.new(yield_now, 0)
  local owned_projects = copy_projects(projects)
  local prepared = plan ~= nil and
    indexer.prepare_update(owned_projects, snapshots, plan, yield_now) or
    indexer.prepare(owned_projects, snapshots, yield_now)
  local extracted_projects = owned_projects
  if plan ~= nil then
    extracted_projects = {}
    for index = 1, #owned_projects do
      local project = owned_projects[index]
      if plan:replaces(project.module_name) then
        extracted_projects[#extracted_projects + 1] = project
      end
      account(state)
    end
  end
  local files = saved_files(extracted_projects, prepared)
  local hovers: {MaterializedHover} = {}
  local folds: {MaterializedFold} = {}
  -- Partition once during extraction, avoiding an AST scan for every token.
  local module_occurrences: {string: {indexer.Occurrence}} = {}
  for index = 1, #prepared.occurrences do
    local item = prepared.occurrences[index]
    local bucket? = module_occurrences[item.module_name]
    if bucket == nil then
      bucket = {}
      module_occurrences[item.module_name] = bucket
    end
    bucket[#bucket + 1] = item
    account(state)
  end
  for module_index = 1, #extracted_projects do
    local project = extracted_projects[module_index]
    local snapshot? = snapshot_for_module(snapshots, project.module_name)
    if snapshot ~= nil then
      local nodes, by_id = hover_nodes(snapshot, files, state)
      local occurrences? = module_occurrences[project.module_name]
      if occurrences ~= nil then
        for index = 1, #occurrences do
          local occurrence = occurrences[index]
          local saved = files[occurrence.filename] as SavedFile
          hovers[#hovers + 1] = materialize_hover(occurrence, saved, nodes, by_id, state)
          account(state)
        end
      end
      for index = 1, #snapshot.nodes do
        local node = snapshot.nodes[index]
        local span? = node.source_span
        if not node.synthetic and span ~= nil and foldable_tag(node.tag) then
          local saved? = files[span.start.filename]
          if saved ~= nil and saved.module_name == project.module_name then
            local converted = lsp_span_for_compiler_span(saved, span)
            local end_line = converted.finish.line - 1
            if end_line > converted.start.line then
              folds[#folds + 1] = MaterializedFold.new(span.start.filename,
                lsp.FoldingRange.new(converted.start.line, nil, end_line, nil, nil))
            end
          end
        end
        account(state)
      end
      -- Structural entries precede comments so equal spans retain structure.
      for file_index = 1, #project.files do
        local file = project.files[file_index]
        local saved = files[file.filename] as SavedFile
        local ranges: {lsp.FoldingRange} = {}
        insert_long_comment_folds(saved, ranges, state)
        for index = 1, #ranges do
          folds[#folds + 1] = MaterializedFold.new(file.filename, ranges[index])
        end
      end
    end
  end
  return PreparedView.new(prepared, hovers, folds)
catch
  if error is indexer.Error then
    local failure = error as indexer.Error
    local context = ""
    if failure.module_name ~= nil then context = "Titan module '" .. failure.module_name .. "'" end
    if failure.filename ~= nil then
      if context ~= "" then context = context .. ", " end
      context = context .. "file '" .. failure.filename .. "'"
    end
    if context ~= "" then context = context .. ": " end
    raise Error.new(context .. failure.message)
  end
  raise
end

function prepare(projects: {bridge.ProjectModule}, snapshots: {bridge.ModuleSnapshot},
                 yield_now: Yield?): PreparedView
  return prepare_internal(projects, snapshots, nil, yield_now)
end

function prepare_update(projects: {bridge.ProjectModule},
                        snapshots: {bridge.ModuleSnapshot},
                        plan: indexer.PublicationPlan, yield_now: Yield?): PreparedView
  return prepare_internal(projects, snapshots, plan, yield_now)
end

-- Completion preparation shares the saved hover renderer, but exports only
-- scalar rows. Its caller maps the disposable source spans back to editor
-- text before publishing them in TEMP.
function PreparedView:completion_hovers(yield_now: Yield?): {completion_types.Hover}
  local result: {completion_types.Hover} = {}
  if #self.index.occurrences > completion_types.MAX_HOVER_ROWS then return result end
  local state = ExtractionState.new(yield_now, 0)
  local bytes = 0
  local by_location: {string: MaterializedHover} = {}
  for index = 1, #self.hovers do
    account(state)
    local hover = self.hovers[index]
    by_location[hover_key(hover.filename, hover.byte_start, "")] = hover
  end
  for index = 1, #self.index.occurrences do
    account(state)
    local occurrence = self.index.occurrences[index]
    local materialized = by_location[hover_key(occurrence.filename,
      occurrence.byte_span.start, "")]
    local hover = Hover.new(occurrence.span, materialized.inferred_type,
      materialized.declared_type, materialized.original_type, materialized.coerced_type,
      occurrence.visibility, occurrence.callable_signature,
      self.index:hover_summary(occurrence), occurrence.documentation)
    local markdown = hover:markdown()
    bytes = bytes + #occurrence.filename + #markdown + 64
    if bytes > completion_types.MAX_HOVER_BYTES then return {} end
    result[index] = completion_types.Hover.new(occurrence.filename,
      occurrence.byte_span.start, occurrence.byte_span.finish, markdown)
  end
  return result
end

-- A saved hover's coordinates are safe for an open document only when its
-- complete captured text still matches the committed semantic file.
function Features:matches_source(filename: string, contents: string): boolean
  local access = self.store:acquire()
  defer access:release()
  indexer.check_generation(access.connection, self.published_generation)
  return workspace_store.scalar_integer(access.connection,
    "SELECT COUNT(*) FROM main.semantic_files WHERE filename=? AND contents=?",
    indexer.blob(filename), indexer.blob(contents)) == 1
end

local function prune_module_features(connection: sqlite3.Connection, name: string)
  workspace_store.execute(connection,
    "DELETE FROM main.semantic_hovers WHERE filename IN " ..
    "(SELECT filename FROM main.semantic_files WHERE module_name=?)", indexer.blob(name))
  workspace_store.execute(connection,
    "DELETE FROM main.semantic_folds WHERE filename IN " ..
    "(SELECT filename FROM main.semantic_files WHERE module_name=?)", indexer.blob(name))
end

function PreparedView:publish(connection: sqlite3.Connection)
  self.index:check_publication(connection)
  -- File ownership must be read from the preceding publication. A removed
  -- constituent, or a file transferred to another module, is no longer in the
  -- replacement semantic_files rows after index publication.
  local plan? = self.index.plan
  if plan == nil or plan.rebuild_all then
    indexer.execute(connection, "DELETE FROM main.semantic_hovers")
    indexer.execute(connection, "DELETE FROM main.semantic_folds")
  else
    for index = 1, #plan.replaced_modules do
      prune_module_features(connection, plan.replaced_modules[index])
    end
    for index = 1, #plan.removed_modules do
      prune_module_features(connection, plan.removed_modules[index])
    end
  end
  self.index:publish(connection)
  local offset = 1
  while offset <= #self.hovers do
    local finish = offset + 19
    if finish > #self.hovers then finish = #self.hovers end
    local parameters: {value} = {}
    local sql = "INSERT OR REPLACE INTO main.semantic_hovers VALUES "
    for index = offset, finish do
      if index > offset then sql = sql .. "," end
      local item = self.hovers[index]
      sql = sql .. "(" .. indexer.binding(parameters, indexer.blob(item.filename)) .. "," ..
        indexer.binding(parameters, item.byte_start) .. "," ..
        indexer.binding(parameters, indexer.type_tag(item.inferred_type)) .. "," ..
        indexer.binding(parameters, indexer.type_display(item.inferred_type)) .. "," ..
        indexer.binding(parameters, indexer.type_tag(item.declared_type)) .. "," ..
        indexer.binding(parameters, indexer.type_display(item.declared_type)) .. "," ..
        indexer.binding(parameters, indexer.type_tag(item.original_type)) .. "," ..
        indexer.binding(parameters, indexer.type_display(item.original_type)) .. "," ..
        indexer.binding(parameters, indexer.type_tag(item.coerced_type)) .. "," ..
        indexer.binding(parameters, indexer.type_display(item.coerced_type)) .. ")"
    end
    local statement = connection:prepare(sql)
    defer statement:close()
    statement:execute(...parameters)
    offset = finish + 1
  end
  offset = 1
  while offset <= #self.folds do
    local finish = offset + 49
    if finish > #self.folds then finish = #self.folds end
    local parameters: {value} = {}
    local sql = "INSERT OR IGNORE INTO main.semantic_folds VALUES "
    for index = offset, finish do
      if index > offset then sql = sql .. "," end
      local item = self.folds[index]
      sql = sql .. "(" .. indexer.binding(parameters, indexer.blob(item.filename)) .. "," ..
        indexer.binding(parameters, item.range.start_line) .. "," ..
        indexer.binding(parameters, item.range.end_line) .. "," ..
        indexer.binding(parameters, indexer.blob(item.range.kind)) .. ")"
    end
    local statement = connection:prepare(sql)
    defer statement:close()
    statement:execute(...parameters)
    offset = finish + 1
  end
end

function open(store: workspace_store.Store, published_generation: integer): Features
  return Features.new(store, published_generation, indexer.open(store, published_generation), false)
end

function Features:close()
  if self.owns_store then self.store:close() end
end

local function build_internal(projects: {bridge.ProjectModule}, snapshots: {bridge.ModuleSnapshot},
                             yield_now: Yield?): Features
  local prepared = prepare(projects, snapshots, yield_now)
  local store = workspace_store.open(":memory:")
  local completed = false
  defer do
    if not completed then store:close() end
  end
  do
    local access = store:acquire()
    defer access:release()
    local connection = access.connection
    initialize_schema(connection)
    prepared:publish(connection)
  end
  completed = true
  return Features.new(store, 0, indexer.open(store, 0), true)
end

function build(projects: {bridge.ProjectModule}, snapshots: {bridge.ModuleSnapshot}): Features
  return build_internal(projects, snapshots, nil)
end

function build_with_yield(projects: {bridge.ProjectModule}, snapshots: {bridge.ModuleSnapshot},
                          yield_now: Yield): Features
  return build_internal(projects, snapshots, yield_now)
end

local function edited_file(source: string,
                           occurrences: {indexer.Occurrence},
                           new_name: string):
    (string, {PendingRenameAnchor}, {lsp.TextEdit})
  local output = strings.writer()
  local anchors: {PendingRenameAnchor} = {}
  local edits: {lsp.TextEdit} = {}
  local cursor = 0
  local delta = 0
  for index = 1, #occurrences do
    local occurrence = occurrences[index]
    if occurrence.byte_span.start < cursor then
      raise Error.new("rename occurrences overlap")
    end
    output:write(strings.sub(
      source, cursor + 1, occurrence.byte_span.start))
    local prefix, suffix = "", ""
    if occurrence.shared_case_name ~= nil then
      case occurrence.shared_case_name
      when binding() then suffix = " = " .. occurrence.name
      when part() then prefix = occurrence.name .. " = "
      end
    end
    local replacement = prefix .. new_name .. suffix
    output:write(replacement)
    local after_start = occurrence.byte_span.start + delta + #prefix
    local after_finish = after_start + #new_name
    anchors[index] = PendingRenameAnchor.new(
      occurrence.filename, occurrence.byte_span, after_start, after_finish)
    edits[index] = lsp.TextEdit.new(copy_span(occurrence.span), replacement)
    cursor = occurrence.byte_span.finish
    delta = delta + #replacement -
      (occurrence.byte_span.finish - occurrence.byte_span.start)
  end
  output:write(strings.sub(source, cursor + 1))
  return output:drain(), anchors, edits
end

local function replace_anchor_offsets(anchors: {PendingRenameAnchor},
                                      contents: string): {RenameAnchor}
  local result: {RenameAnchor} = {}
  local coordinates = source_text.coordinate_index(contents)
  for index = 1, #anchors do
    local anchor = anchors[index]
    local span?, failure? = coordinates:span_for_offsets(
      anchor.after_start, anchor.after_finish)
    if span == nil then
      local detail = "invalid post-rename UTF-8 boundary"
      if failure ~= nil then detail = failure.message end
      return fail<|{RenameAnchor}|>(detail)
    end
    result[index] = RenameAnchor.new(anchor.filename, anchor.before, span)
  end
  return result
end

local function append_anchors(target: {RenameAnchor},
                              source: {RenameAnchor})
  for index = 1, #source do target[#target + 1] = source[index] end
end

local function occurrences_for_file(occurrences: {indexer.Occurrence},
                                    filename: string): {indexer.Occurrence}
  local result: {indexer.Occurrence} = {}
  for index = 1, #occurrences do
    if occurrences[index].filename == filename then
      result[#result + 1] = occurrences[index]
    end
  end
  return result
end

function Features:rename(filename: string, position: source_text.Position,
                         new_name: string): (RenameCandidate?, Error?)
  if not lsp.valid_identifier(new_name) then
    return rejected<|RenameCandidate|>(
      "rename target must be a non-keyword Titan identifier")
  end
  local selected? = self.index:occurrence_at(filename, position)
  if selected == nil then return nil, nil end
  local definition? = self.index:definition(selected.symbol_id)
  if definition == nil then
    return rejected<|RenameCandidate|>(
      "cannot rename a symbol declared outside project source")
  end

  local occurrences = self.index:occurrences(selected.symbol_id, true)
  if #occurrences == 0 then
    return rejected<|RenameCandidate|>(
      "cannot rename a symbol with no project occurrences")
  end
  local projects = self.index:project_modules()
  local files: {string: bridge.SourceFile} = {}
  for module_index = 1, #projects do
    for file_index = 1, #projects[module_index].files do
      local file = projects[module_index].files[file_index]
      files[file.filename] = file
    end
  end
  local edited_contents: {string: string} = {}
  local anchors: {RenameAnchor} = {}
  local documents: {lsp.DocumentEdits} = {}
  local filenames = self.index:file_names()
  for file_index = 1, #filenames do
    local current = occurrences_for_file(occurrences, filenames[file_index])
    if #current > 0 then
      local saved? = files[filenames[file_index]]
      if saved == nil then
        return rejected<|RenameCandidate|>(
          "rename occurrence has no saved project source")
      end
      local contents, raw_anchors, edits = edited_file(
        saved.contents, current, new_name)
      edited_contents[filenames[file_index]] = contents
      append_anchors(anchors, replace_anchor_offsets(raw_anchors, contents))
      local uri?, uri_error? = source_text.path_to_file_uri(
        filenames[file_index])
      if uri == nil then
        local detail = "invalid project source path"
        if uri_error ~= nil then detail = uri_error.message end
        return rejected<|RenameCandidate|>(detail)
      end
      documents[#documents + 1] = lsp.DocumentEdits.new(uri, edits)
    end
  end

  local edited_projects: {bridge.ProjectModule} = {}
  for module_index = 1, #projects do
    local module = projects[module_index]
    local files: {bridge.SourceFile} = {}
    for file_index = 1, #module.files do
      local file = module.files[file_index]
      local contents? = edited_contents[file.filename]
      if contents == nil then contents = file.contents end
      files[file_index] = bridge.SourceFile.new(file.filename, contents)
    end
    edited_projects[module_index] = bridge.ProjectModule.new(
      module.module_name, files)
  end
  return RenameCandidate.new(
    definition.name, new_name, edited_projects, documents, anchors), nil
end

function RenameCandidate:edited_project_modules(): {bridge.ProjectModule}
  return copy_projects(self.edited_projects)
end

function RenameCandidate:source_name(): string
  return self.old_name
end

function RenameCandidate:target_name(): string
  return self.new_name
end

local function same_position(left: source_text.Position,
                             right: source_text.Position): boolean
  return left.line == right.line and left.character == right.character
end

local function same_source_span(left: source_text.Span,
                                right: source_text.Span): boolean
  return same_position(left.start, right.start) and
         same_position(left.finish, right.finish)
end

local function contains_anchor(anchors: {RenameAnchor},
                               occurrence: indexer.Occurrence): boolean
  for index = 1, #anchors do
    if anchors[index].filename == occurrence.filename and
       same_source_span(anchors[index].after, occurrence.span) then
      return true
    end
  end
  return false
end

function RenameCandidate:preflight(analysis: bridge.Analysis):
    (VerifiedRename?, Error?)
  if #analysis.diagnostics > 0 then
    return rejected<|VerifiedRename|>(
      "compiler rejected the candidate rename")
  end

  local project_snapshots: {bridge.ModuleSnapshot} = {}
  local seen_projects: {string: boolean} = {}
  for index = 1, #analysis.modules do
    local snapshot = analysis.modules[index]
    case snapshot.provenance
    when project_source() then
      if seen_projects[snapshot.module_name] then
        return rejected<|VerifiedRename|>(
          "compiler returned a duplicate project snapshot")
      end
      seen_projects[snapshot.module_name] = true
      project_snapshots[#project_snapshots + 1] = snapshot
    else
      project_snapshots[#project_snapshots + 1] = snapshot
    end
  end
  for index = 1, #self.edited_projects do
    if not seen_projects[self.edited_projects[index].module_name] then
      return rejected<|VerifiedRename|>(
        "compiler omitted a renamed project module")
    end
  end

  local checked = indexer.build(self.edited_projects, project_snapshots)
  defer checked:close()
  local resolved: indexer.SymbolId? = nil
  for index = 1, #self.anchors do
    local anchor = self.anchors[index]
    local occurrence? = checked:occurrence_at(
      anchor.filename, anchor.after.start)
    if occurrence == nil or occurrence.name ~= self.new_name or
       not same_source_span(occurrence.span, anchor.after) then
      return rejected<|VerifiedRename|>(
        "compiler did not preserve a renamed occurrence")
    end
    if resolved == nil then
      resolved = occurrence.symbol_id
    elseif resolved.declaration_id ~= occurrence.symbol_id.declaration_id then
      return rejected<|VerifiedRename|>(
        "candidate rename would capture or split symbol references")
    end
  end
  if resolved == nil then
    return rejected<|VerifiedRename|>(
      "candidate rename has no compiler-verified occurrences")
  end

  local definition? = checked:definition(resolved)
  if definition == nil or definition.name ~= self.new_name or
     not contains_anchor(self.anchors, definition) then
    return rejected<|VerifiedRename|>(
      "candidate rename did not produce one project declaration")
  end
  local occurrences = checked:occurrences(resolved, true)
  if #occurrences ~= #self.anchors then
    return rejected<|VerifiedRename|>(
      "candidate rename changed the resolved occurrence set")
  end
  for index = 1, #occurrences do
    if occurrences[index].name ~= self.new_name or
       not contains_anchor(self.anchors, occurrences[index]) then
      return rejected<|VerifiedRename|>(
        "candidate rename resolved an unexpected occurrence")
    end
  end
  return VerifiedRename.new(copy_documents(self.documents)), nil
end

function VerifiedRename:document_edits(): {lsp.DocumentEdits}
  return copy_documents(self.documents)
end
