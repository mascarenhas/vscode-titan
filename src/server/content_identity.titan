--- Stable content digests and filesystem observations used to identify saved inputs.
-- @module server.content_identity

foreign import "openssl/sha.h"
local fs = import "fs"
local strings = import "string"

-- OpenSSL is already a static-provider dependency. Hash arbitrary saved bytes
-- through its length-bearing API, with a traced owner for the output buffer.
--- Compute the stable digest used to distinguish exact content bytes.
function digest(contents: string): string
  local output: owned unsigned char[] = foreign unsigned char.new_array(32)
  if ffi.SHA256(contents, #contents, output) == nil then
    raise "cannot hash saved input"
  end
  return output as string
end

local function stamp(metadata: fs.Stat?): string
  if metadata == nil then return "missing" end
  return metadata.kind .. ":" .. metadata.device .. ":" .. metadata.inode ..
    ":" .. metadata.size .. ":" .. metadata.modified_seconds .. ":" ..
    metadata.modified_nanoseconds .. ":" .. metadata.mode
end

--- Capture the filesystem identity of one saved path.
function stat_identity(filename: string): string
  local output = strings.writer()
  output:write(stamp(fs.lstat(filename)))
  output:write("\0")
  output:write(stamp(fs.stat(filename)))
  return digest(output:drain())
end

--- Combine saved path provenance and exact contents into one input identity.
function file(filename: string, contents: string): string
  return digest(digest(contents) .. stat_identity(filename))
end

-- Keep the inexpensive filesystem observation separate from saved content.
-- Timestamp-only changes do not change the followed physical input.
--- Saved filesystem observation used to compare accepted input versions.
record FileObservation
  const kind: string
  const modified_seconds: integer
  const modified_nanoseconds: integer
  const size: integer
  const physical_identity: string
end

local function physical(metadata: fs.Stat): string
  return metadata.kind .. ":" .. metadata.device .. ":" .. metadata.inode ..
    ":" .. metadata.mode
end

--- Read a file observation, returning nil when the path is absent.
function observe(filename: string): FileObservation?
  local link? = fs.lstat(filename)
  local target? = fs.stat(filename)
  if link == nil or target == nil then return nil end
  return FileObservation.new(target.kind, target.modified_seconds,
    target.modified_nanoseconds, target.size,
    physical(link) .. "\0" .. physical(target))
end

--- Compare every observation field used to fence saved-source reuse.
function same_observation(left: FileObservation, right: FileObservation): boolean
  return left.kind == right.kind and
    left.modified_seconds == right.modified_seconds and
    left.modified_nanoseconds == right.modified_nanoseconds and
    left.size == right.size and left.physical_identity == right.physical_identity
end
