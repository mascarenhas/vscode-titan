local test = import "test"
local strings = import "string"
local bridge = import "server.compiler_bridge"
local indexer = import "server.semantic_index.titan"
local source_text = import "server.source_text"

local function location(filename: string, line: integer,
                        column: integer): bridge.SourceLocation
  return bridge.SourceLocation.new(filename, line, column)
end

local function occurrence(filename: string, line: integer,
                          start_column: integer, finish_column: integer,
                          name: string, declaration_id: string?,
                          role: bridge.OccurrenceRole,
                          is_local: boolean): bridge.SymbolOccurrence
  local start = location(filename, line, start_column)
  return bridge.SymbolOccurrence.new(
    name, declaration_id, role, start,
    bridge.SourceSpan.new(start, location(filename, line, finish_column)),
    is_local, nil)
end

local function missing_span(filename: string, line: integer, column: integer,
                            name: string, declaration_id: string):
    bridge.SymbolOccurrence
  return bridge.SymbolOccurrence.new(
    name, declaration_id, bridge.OccurrenceRole.reference(),
    location(filename, line, column), nil, false, nil)
end

local function project(module_name: string, filename: string,
                       contents: string): bridge.ProjectModule
  return bridge.ProjectModule.new(
    module_name, {bridge.SourceFile.new(filename, contents)})
end

local function project_snapshot(module_name: string, filename: string,
                                symbols: {bridge.SymbolOccurrence}):
    bridge.ModuleSnapshot
  return bridge.ModuleSnapshot.new(
    module_name,
    bridge.Provenance.project_source(
      bridge.SourceProvenance.new(filename, {filename})),
    nil, {}, symbols, {}, {})
end

local function assert_role(actual: bridge.OccurrenceRole,
                           expected: string)
  case actual
  when definition then test.assert(expected == "definition", "wrong role")
  when import_alias then test.assert(expected == "import_alias", "wrong role")
  when write then test.assert(expected == "write", "wrong role")
  when reference then test.assert(expected == "reference", "wrong role")
  when type_reference then
    test.assert(expected == "type_reference", "wrong role")
  end
end

local type Action = () -> ()

local function expect_index_error(action: Action, expected: string)
  local rejected = false
  do
    action()
  catch
    rejected = true
    test.assert(error is indexer.Error,
                "semantic index raised an untyped error")
    local failure = error as indexer.Error
    test.assert(strings.find(failure.message, expected) ~= nil,
                failure.message)
  end
  test.assert(rejected, "invalid semantic occurrence was accepted")
end

function test_semantic_index_joins_exported_identities_across_modules(
    _context: test.Context)
  local a_file = "/workspace/a.titan"
  local b_file = "/workspace/b.titan"
  local symbol = "export:app.a:answer"
  local index = indexer.build({
    project("app.b", b_file, "local copy = answer\n"),
    project("app.a", a_file, "answer = 42\n"),
  }, {
    project_snapshot("app.b", b_file, {
      occurrence(b_file, 1, 14, 20, "answer", symbol,
                 bridge.OccurrenceRole.reference(), false),
    }),
    project_snapshot("app.a", a_file, {
      occurrence(a_file, 1, 1, 7, "answer", symbol,
                 bridge.OccurrenceRole.definition(), false),
    }),
  })

  local at_use? = index:occurrence_at(
    b_file, source_text.Position.new(0, 15))
  test.assert(at_use ~= nil and
              at_use.symbol_id.declaration_id == symbol,
              "cross-module use did not resolve to its exported identity")
  local definition? = index:definition(at_use.symbol_id)
  test.assert(definition ~= nil and definition.filename == a_file,
              "exported identity did not resolve to its project definition")

  local references = index:occurrences(at_use.symbol_id, false)
  test.assert(#references == 1 and references[1].filename == b_file,
              "references query did not exclude the declaration")
  local all = index:occurrences(at_use.symbol_id, true)
  test.assert(#all == 2 and all[1].filename == a_file and
              all[2].filename == b_file,
              "symbol occurrences were not complete and deterministic")
end

function test_semantic_index_keeps_shadowed_locals_nominally_distinct(
    _context: test.Context)
  local filename = "/workspace/shadow.titan"
  local outer = "ast:app.shadow:/workspace/shadow.titan:2:9:count"
  local inner = "ast:app.shadow:/workspace/shadow.titan:5:11:count"
  local index = indexer.build({project(
    "app.shadow", filename,
    "function sample()\n" ..
    "  local count = 1\n" ..
    "  count = count\n" ..
    "  do\n" ..
    "    local count = 2\n" ..
    "    count = count\n" ..
    "  end\n" ..
    "end\n")}, {
    project_snapshot("app.shadow", filename, {
      occurrence(filename, 2, 9, 14, "count", outer,
                 bridge.OccurrenceRole.definition(), true),
      occurrence(filename, 3, 3, 8, "count", outer,
                 bridge.OccurrenceRole.write(), true),
      occurrence(filename, 3, 11, 16, "count", outer,
                 bridge.OccurrenceRole.reference(), true),
      occurrence(filename, 5, 11, 16, "count", inner,
                 bridge.OccurrenceRole.definition(), true),
      occurrence(filename, 6, 5, 10, "count", inner,
                 bridge.OccurrenceRole.write(), true),
      occurrence(filename, 6, 13, 18, "count", inner,
                 bridge.OccurrenceRole.reference(), true),
    }),
  })

  local outer_items = index:occurrences(indexer.SymbolId.new(outer), true)
  local inner_items = index:occurrences(indexer.SymbolId.new(inner), true)
  test.assert(#outer_items == 3 and #inner_items == 3,
              "shadowed declarations were merged by identifier text")
  test.assert(index:definition(indexer.SymbolId.new(outer)).span.start.line == 1
              and
              index:definition(indexer.SymbolId.new(inner)).span.start.line == 4,
              "nominal local identities resolved to the wrong declarations")
end

function test_semantic_index_converts_unicode_prefixes_to_utf16(
    _context: test.Context)
  local filename = "/workspace/unicode.titan"
  local contents = "--[[😀]] local count = 1\n"
  local index = indexer.build({project("app.unicode", filename, contents)}, {
    project_snapshot("app.unicode", filename, {
      occurrence(filename, 1, 18, 23, "count", "export:app.unicode:count",
                 bridge.OccurrenceRole.definition(), false),
    }),
  })
  local items = index:file_occurrences(filename)
  test.assert(#items == 1 and items[1].byte_span.start == 17 and
              items[1].byte_span.finish == 22,
              "compiler byte columns did not preserve exact byte offsets")
  test.assert(items[1].span.start.character == 15 and
              items[1].span.finish.character == 20,
              "SourceText did not convert an astral prefix to UTF-16")
  test.assert(index:occurrence_at(
                filename, source_text.Position.new(0, 16)) ~= nil and
              index:occurrence_at(
                filename, source_text.Position.new(0, 20)) == nil,
              "per-file lookup did not use a half-open UTF-16 span")
end

function test_semantic_index_preserves_compiler_columns_across_lone_cr(
    _context: test.Context)
  local filename = "/workspace/cr.titan"
  local index = indexer.build({project(
    "app.cr", filename, "left\rright\n")}, {
    project_snapshot("app.cr", filename, {
      -- titan-compiler.location counts only LF as a source line ending, so
      -- this name remains on compiler line 1 at byte column 6. SourceText
      -- correctly presents it on LSP line 1 at UTF-16 character 0.
      occurrence(filename, 1, 6, 11, "right", "export:app.cr:right",
                 bridge.OccurrenceRole.definition(), false),
    }),
  })
  local items = index:file_occurrences(filename)
  test.assert(#items == 1 and items[1].byte_span.start == 5 and
              items[1].span.start.line == 1 and
              items[1].span.start.character == 0,
              "compiler byte columns and SourceText line rules were conflated")
end

function test_semantic_index_skips_missing_spans_unresolved_and_external_data(
    _context: test.Context)
  local filename = "/workspace/main.titan"
  local external_file = "/external/dep.titan"
  local external = bridge.ModuleSnapshot.new(
    "vendor.dep",
    bridge.Provenance.external_source(
      bridge.SourceProvenance.new(external_file, {external_file})),
    nil, {}, {
      occurrence(external_file, 1, 1, 4, "dep", "export:vendor.dep:dep",
                 bridge.OccurrenceRole.definition(), false),
    }, {}, {})
  local index = indexer.build({project(
    "app.main", filename, "known missing remote\n")}, {
    external,
    project_snapshot("app.main", filename, {
      occurrence(filename, 1, 1, 6, "known", "export:app.main:known",
                 bridge.OccurrenceRole.definition(), false),
      missing_span(filename, 1, 7, "missing", "export:app.main:missing"),
      occurrence(filename, 1, 15, 21, "remote", nil,
                 bridge.OccurrenceRole.reference(), false),
      occurrence(external_file, 1, 1, 4, "dep", "export:vendor.dep:dep",
                 bridge.OccurrenceRole.definition(), false),
    }),
  })
  local files = index:file_names()
  test.assert(#files == 1 and files[1] == filename and
              #index:file_occurrences(filename) == 1 and
              #index:file_occurrences(external_file) == 0,
              "inexact, unresolved, or external entries leaked into the index")
end

function test_semantic_index_deduplicates_and_sorts_each_file(
    _context: test.Context)
  local a_file = "/workspace/a.titan"
  local z_file = "/workspace/z.titan"
  local first = occurrence(a_file, 1, 1, 4, "aaa", "export:m.a:aaa",
                           bridge.OccurrenceRole.definition(), false)
  local index = indexer.build({
    project("m.z", z_file, "zzz aaa\n"),
    project("m.a", a_file, "aaa zzz\n"),
  }, {
    project_snapshot("m.z", z_file, {
      occurrence(z_file, 1, 5, 8, "aaa", "export:m.a:aaa",
                 bridge.OccurrenceRole.reference(), false),
      occurrence(z_file, 1, 1, 4, "zzz", "export:m.z:zzz",
                 bridge.OccurrenceRole.definition(), false),
    }),
    project_snapshot("m.a", a_file, {
      occurrence(a_file, 1, 5, 8, "zzz", "export:m.z:zzz",
                 bridge.OccurrenceRole.reference(), false),
      first,
      first,
    }),
  })
  local files = index:file_names()
  test.assert(#files == 2 and files[1] == a_file and files[2] == z_file,
              "indexed filenames were not bytewise deterministic")
  local a = index:file_occurrences(a_file)
  test.assert(#a == 2 and a[1].name == "aaa" and a[2].name == "zzz",
              "file occurrences were not sorted or deduplicated")
  local z = index:file_occurrences(z_file)
  test.assert(#z == 2 and z[1].name == "zzz" and z[2].name == "aaa",
              "per-file source order was not deterministic")
end

function test_semantic_index_rejects_stale_inexact_and_overlapping_spans(
    _context: test.Context)
  local filename = "/workspace/bad.titan"
  expect_index_error(function ()
    indexer.build({project("bad", filename, "other\n")}, {
      project_snapshot("bad", filename, {
        occurrence(filename, 1, 1, 6, "count", "export:bad:count",
                   bridge.OccurrenceRole.definition(), false),
      }),
    })
  end, "does not contain identifier")

  expect_index_error(function ()
    local start = location(filename, 1, 1)
    local shifted = bridge.SymbolOccurrence.new(
      "count", "export:bad:count", bridge.OccurrenceRole.definition(), start,
      bridge.SourceSpan.new(location(filename, 1, 2),
                            location(filename, 1, 7)), false, nil)
    indexer.build({project("bad", filename, " count\n")}, {
      project_snapshot("bad", filename, {shifted}),
    })
  end, "does not start")

  expect_index_error(function ()
    indexer.build({project("bad", filename, "count\n")}, {
      project_snapshot("bad", filename, {
        occurrence(filename, 1, 1, 6, "count", "export:bad:count",
                   bridge.OccurrenceRole.definition(), false),
        occurrence(filename, 1, 2, 5, "oun", "export:bad:oun",
                   bridge.OccurrenceRole.reference(), false),
      }),
    })
  end, "overlap")
end

function test_semantic_index_treats_import_alias_as_a_declaration(
    _context: test.Context)
  local filename = "/workspace/imports.titan"
  local identity = "ast:app.imports:/workspace/imports.titan:1:7:dep"
  local index = indexer.build({project(
    "app.imports", filename, "local dep = dep\n")}, {
    project_snapshot("app.imports", filename, {
      occurrence(filename, 1, 7, 10, "dep", identity,
                 bridge.OccurrenceRole.import_alias(), true),
      occurrence(filename, 1, 13, 16, "dep", identity,
                 bridge.OccurrenceRole.type_reference(), true),
    }),
  })
  local definition? = index:definition(indexer.SymbolId.new(identity))
  test.assert(definition ~= nil, "import alias was not a definition target")
  assert_role(definition.role, "import_alias")
  local uses = index:occurrences(indexer.SymbolId.new(identity), false)
  test.assert(#uses == 1, "include-declaration omitted the wrong roles")
  assert_role(uses[1].role, "type_reference")
end

function test_semantic_index_large_build_has_bounded_sort_and_yields(
    _context: test.Context)
  -- Deliberately not a power of two: the final merge pass must preserve the
  -- short tail as well as meeting the comparison budget.
  local count = 2053
  local filename = "/workspace/stress.titan"
  local output = strings.writer()
  local in_source_order: {bridge.SymbolOccurrence} = {}
  for line = 1, count do
    local name = "item" .. line
    output:write(name)
    output:write("\n")
    in_source_order[line] = occurrence(
      filename, line, 1, #name + 1, name,
      "export:stress:" .. name,
      bridge.OccurrenceRole.definition(), false)
  end
  local contents = output:drain()
  local reverse_order: {bridge.SymbolOccurrence} = {}
  for index = 1, count do
    reverse_order[index] = in_source_order[count - index + 1]
  end

  local yield_count = 0
  local index = indexer.build_with_yield({
    project("stress", filename, contents),
  }, {
    project_snapshot("stress", filename, reverse_order),
  }, function () yield_count = yield_count + 1 end)
  local items = index:file_occurrences(filename)
  test.assert(#items == count and
              items[1].byte_span.start == 0 and
              items[count].name == "item" .. count,
              "large semantic build did not retain deterministic source order")
  local levels = 0
  local width = 1
  while width < count do
    levels = levels + 1
    width = width * 2
  end
  -- Coordinate decoding, project/file/snapshot collection, each merge-sort
  -- output, normalization, and bucket construction all share one counter.
  -- This exact oracle catches a missing yield account in any large loop.
  local expected_work = #contents + 3 + count * (levels + 3)
  test.assert(yield_count == expected_work // 1024,
              "large semantic build did not account all bounded work")

  local reversed: {indexer.Occurrence} = {}
  for item_index = 1, count do
    reversed[item_index] = items[count - item_index + 1]
  end
  local comparisons = indexer.sort_occurrences(reversed)
  test.assert(comparisons > count and comparisons <= count * levels,
              "occurrence ordering exceeded an n log n comparison budget")
  for item_index = 2, count do
    test.assert(
      reversed[item_index - 1].byte_span.start <
        reversed[item_index].byte_span.start,
      "merge sort did not restore deterministic occurrence order")
  end
end

function test_semantic_index_shares_yield_budget_across_small_files(
    _context: test.Context)
  local projects: {bridge.ProjectModule} = {}
  local snapshots: {bridge.ModuleSnapshot} = {}
  for index = 1, 8 do
    local module_name = "small" .. index
    local filename = "/workspace/small" .. index .. ".titan"
    local name = "item" .. index
    local contents = strings.rep(" ", 900) .. name .. "\n"
    projects[index] = project(module_name, filename, contents)
    snapshots[index] = project_snapshot(module_name, filename, {
      occurrence(filename, 1, 901, 901 + #name, name,
                 "export:" .. module_name .. ":" .. name,
                 bridge.OccurrenceRole.definition(), false),
    })
  end

  local yield_count = 0
  local index = indexer.build_with_yield(
    projects, snapshots, function () yield_count = yield_count + 1 end)
  test.assert(#index:file_names() == 8,
              "small-file semantic build lost indexed files")
  test.assert(yield_count == 7,
              "coordinate work did not share one bounded yield budget")
end
