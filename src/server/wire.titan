--- Native JSON Maps and Arrays with an explicit protocol null sentinel.
-- @module server.wire

local json = import "json"
local peg = import "peg"
local reflect = import "reflect"

-- Native containers are confined to the JSON-RPC and structured-log boundary.
-- Parsed language-server parameters and request ownership remain nominal.
--- String-keyed native JSON object Map.
type Object = {string: value}
--- Native JSON Array retaining protocol null sentinels.
type Array = {value}

local record NullToken
end

local const MAX_INPUT_BYTES = 16 * 1024 * 1024
-- An error response must accommodate any string ID accepted inside an input
-- frame, plus its fixed envelope, even when the original result is too large.
local const MAX_OUTPUT_BYTES = 16 * 1024 * 1024 + 4096
local const MAX_NESTING = 128
local const PEG_MATCH_STACK_LIMIT = 2048

local const null_token: value
local const DECODE_OPTIONS: (const {json.DecodeOption})?
local const ENCODE_OPTIONS: (const {json.EncodeOption})?

--- Return the shared explicit protocol null token.
function null(): value
  return null_token
end

--- Test protocol null without conflating it with absent nil.
function is_null(subject: value): boolean
  return subject == null_token
end

--- Decode JSON while preserving explicit nulls with the protocol sentinel.
function decode(source: string): value
  return json.decode(source, nil, ...DECODE_OPTIONS)
end

--- Encode native protocol JSON values using the explicit null sentinel.
function encode(subject: value): string
  return json.encode(subject, ...ENCODE_OPTIONS)
end

function as_object(subject: value): Object?
  case reflect.inspect(subject)
  when is_map() then return subject as Object
  else return nil
  end
end

function as_array(subject: value): Array?
  case reflect.inspect(subject)
  when is_array{array = value} then return array
  else return nil
  end
end

function as_string(subject: value): string?
  case reflect.inspect(subject)
  when is_string(text) then return text
  else return nil
  end
end

function as_integer(subject: value): integer?
  case reflect.inspect(subject)
  when is_integer(number) then return number
  else return nil
  end
end

function as_boolean(subject: value): boolean?
  case reflect.inspect(subject)
  when is_boolean(flag) then return flag
  else return nil
  end
end

do
  -- Matching frames and JSON containers have different counts. Configure the
  -- application's private PEG engine once with room for 128 nested containers
  -- and their sibling alternatives; JSON itself never changes this setting.
  peg.set_max_stack(PEG_MATCH_STACK_LIMIT)
  null_token = NullToken()
  local decode_options: const {json.DecodeOption} = {
    json.DecodeOption.null_value(null_token),
    json.DecodeOption.max_depth(MAX_NESTING),
    json.DecodeOption.max_bytes(MAX_INPUT_BYTES),
    -- Every source value consumes at least one byte, so this adds no smaller
    -- input limit than framing already imposes.
    json.DecodeOption.max_nodes(MAX_INPUT_BYTES),
  }
  local encode_options: const {json.EncodeOption} = {
    json.EncodeOption.null_value(null_token),
    json.EncodeOption.max_depth(MAX_NESTING),
    json.EncodeOption.max_bytes(MAX_OUTPUT_BYTES),
    json.EncodeOption.max_nodes(MAX_OUTPUT_BYTES),
  }
  DECODE_OPTIONS = decode_options
  ENCODE_OPTIONS = encode_options
end
