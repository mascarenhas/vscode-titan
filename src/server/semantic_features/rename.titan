-- Multi-file rename preparation, identifier validation, and compiler preflight.

local record PendingRenameAnchor
  const filename: string
  const before: source_text.ByteSpan
  const after_start: integer
  const after_finish: integer
end

local function edited_file(source: string,
                           occurrences: const? {indexer.Occurrence},
                           new_name: string):
    (string, {PendingRenameAnchor}, {lsp.TextEdit})
  local output = strings.writer()
  local anchors: {PendingRenameAnchor} = {}
  local edits: {lsp.TextEdit} = {}
  local cursor = 0
  local delta = 0
  for index = 1, #occurrences do
    local occurrence = occurrences[index]
    if occurrence.byte_span.start < cursor then
      raise Error("rename occurrences overlap")
    end
    output:write(strings.sub(
      source, cursor + 1, occurrence.byte_span.start))
    local prefix, suffix = "", ""
    if occurrence.shared_case_name ~= nil then
      case occurrence.shared_case_name
      when binding() then suffix = " = " .. occurrence.name
      when part() then prefix = occurrence.name .. " = "
      end
    end
    local replacement = prefix .. new_name .. suffix
    output:write(replacement)
    local after_start = occurrence.byte_span.start + delta + #prefix
    local after_finish = after_start + #new_name
    anchors[index] = PendingRenameAnchor(
      occurrence.filename, occurrence.byte_span, after_start, after_finish)
    edits[index] = lsp.TextEdit(occurrence.span, replacement)
    cursor = occurrence.byte_span.finish
    delta = delta + #replacement -
      (occurrence.byte_span.finish - occurrence.byte_span.start)
  end
  output:write(strings.sub(source, cursor + 1))
  return output:drain(), anchors, edits
end

local function replace_anchor_offsets(anchors: const? {PendingRenameAnchor},
                                      contents: string): {RenameAnchor}
  local result: {RenameAnchor} = {}
  local coordinates = source_text.coordinate_index(contents)
  for index = 1, #anchors do
    local anchor = anchors[index]
    local span?, failure? = coordinates:span_for_offsets(
      anchor.after_start, anchor.after_finish)
    if span == nil then
      local detail = "invalid post-rename UTF-8 boundary"
      if failure ~= nil then detail = failure.message end
      return fail<|{RenameAnchor}|>(detail)
    end
    result[index] = RenameAnchor(anchor.filename, anchor.before, span)
  end
  return result
end

local function append_anchors(target: {RenameAnchor},
                              source: const? {RenameAnchor})
  for index = 1, #source do target[#target + 1] = source[index] end
end

function Features:rename(filename: string, position: source_text.Position,
                         new_name: string): (RenameCandidate?, Error?)
  if not lsp.valid_identifier(new_name) then
    return rejected<|RenameCandidate|>(
      "rename target must be a non-keyword Titan identifier")
  end
  local selected? = self.index:occurrence_at(filename, position)
  if selected == nil then return nil, nil end
  local definition? = self.index:definition(selected.symbol_id)
  if definition == nil then
    return rejected<|RenameCandidate|>(
      "cannot rename a symbol declared outside project source")
  end

  local occurrences = self.index:occurrences(selected.symbol_id, true)
  if #occurrences == 0 then
    return rejected<|RenameCandidate|>(
      "cannot rename a symbol with no project occurrences")
  end
  local by_file: {string: {indexer.Occurrence}} = {}
  for index = 1, #occurrences do
    local item = occurrences[index]
    local bucket? = by_file[item.filename]
    if bucket == nil then
      bucket = {}
      by_file[item.filename] = bucket
    end
    bucket[#bucket + 1] = item
  end
  local projects = self.index:project_modules()
  local files: {string: bridge.SourceFile} = {}
  for module_index = 1, #projects do
    for file_index = 1, #projects[module_index].files do
      local file = projects[module_index].files[file_index]
      files[file.filename] = file
    end
  end
  local edited_contents: {string: string} = {}
  local anchors: {RenameAnchor} = {}
  local documents: {lsp.DocumentEdits} = {}
  local filenames = self.index:file_names()
  for file_index = 1, #filenames do
    local current? = by_file[filenames[file_index]]
    if current ~= nil then
      local saved? = files[filenames[file_index]]
      if saved == nil then
        return rejected<|RenameCandidate|>(
          "rename occurrence has no saved project source")
      end
      local file_occurrences = current
      local contents, raw_anchors, edits = edited_file(
        saved.contents, file_occurrences, new_name)
      edited_contents[filenames[file_index]] = contents
      append_anchors(anchors, replace_anchor_offsets(raw_anchors, contents))
      local uri?, uri_error? = source_text.path_to_file_uri(
        filenames[file_index])
      if uri == nil then
        local detail = "invalid project source path"
        if uri_error ~= nil then detail = uri_error.message end
        return rejected<|RenameCandidate|>(detail)
      end
      documents[#documents + 1] = lsp.DocumentEdits(uri, edits)
    end
  end

  local edited_projects: {bridge.ProjectModule} = {}
  for module_index = 1, #projects do
    local module = projects[module_index]
    local module_changed = false
    for file_index = 1, #module.files do
      if edited_contents[module.files[file_index].filename] ~= nil then
        module_changed = true
        break
      end
    end
    if not module_changed then
      edited_projects[module_index] = module
    else
      local module_files: {bridge.SourceFile} = {}
      for file_index = 1, #module.files do
        local file = module.files[file_index]
        local contents? = edited_contents[file.filename]
        if contents == nil then
          module_files[file_index] = file
        else
          module_files[file_index] = bridge.SourceFile(file.filename, contents)
        end
      end
      edited_projects[module_index] = bridge.ProjectModule(
        module.module_name, module_files)
    end
  end
  return RenameCandidate {
    old_name = definition.name,
    new_name = new_name,
    edited_projects = edited_projects,
    documents = documents,
    anchors = anchors,
  }, nil
end

function RenameCandidate:edited_project_modules(): {bridge.ProjectModule}
  return {...self.edited_projects}
end

function RenameCandidate:source_name(): string
  return self.old_name
end

function RenameCandidate:target_name(): string
  return self.new_name
end

local function same_position(left: source_text.Position,
                             right: source_text.Position): boolean
  return left.line == right.line and left.character == right.character
end

local function same_source_span(left: source_text.Span,
                                right: source_text.Span): boolean
  return same_position(left.start, right.start) and
         same_position(left.finish, right.finish)
end

local function contains_anchor(anchors: const? {RenameAnchor},
                               occurrence: indexer.Occurrence): boolean
  for index = 1, #anchors do
    if anchors[index].filename == occurrence.filename and
       same_source_span(anchors[index].after, occurrence.span) then
      return true
    end
  end
  return false
end

function RenameCandidate:preflight(analysis: bridge.Analysis):
    (VerifiedRename?, Error?)
  if #analysis.diagnostics > 0 then
    return rejected<|VerifiedRename|>(
      "compiler rejected the candidate rename")
  end

  local project_snapshots: {bridge.ModuleSnapshot} = {}
  local seen_projects: {string: boolean} = {}
  for index = 1, #analysis.modules do
    local snapshot = analysis.modules[index]
    case snapshot.provenance
    when project_source() then
      if seen_projects[snapshot.module_name] then
        return rejected<|VerifiedRename|>(
          "compiler returned a duplicate project snapshot")
      end
      seen_projects[snapshot.module_name] = true
      project_snapshots[#project_snapshots + 1] = snapshot
    else
      project_snapshots[#project_snapshots + 1] = snapshot
    end
  end
  for index = 1, #self.edited_projects do
    if not seen_projects[self.edited_projects[index].module_name] then
      return rejected<|VerifiedRename|>(
        "compiler omitted a renamed project module")
    end
  end

  local checked = indexer.build(self.edited_projects, project_snapshots)
  defer checked:close()
  local resolved: indexer.SymbolId? = nil
  for index = 1, #self.anchors do
    local anchor = self.anchors[index]
    local occurrence? = checked:occurrence_at(
      anchor.filename, anchor.after.start)
    if occurrence == nil or occurrence.name ~= self.new_name or
       not same_source_span(occurrence.span, anchor.after) then
      return rejected<|VerifiedRename|>(
        "compiler did not preserve a renamed occurrence")
    end
    if resolved == nil then
      resolved = occurrence.symbol_id
    elseif resolved.declaration_id ~= occurrence.symbol_id.declaration_id then
      return rejected<|VerifiedRename|>(
        "candidate rename would capture or split symbol references")
    end
  end
  if resolved == nil then
    return rejected<|VerifiedRename|>(
      "candidate rename has no compiler-verified occurrences")
  end

  local definition? = checked:definition(resolved)
  if definition == nil or definition.name ~= self.new_name or
     not contains_anchor(self.anchors, definition) then
    return rejected<|VerifiedRename|>(
      "candidate rename did not produce one project declaration")
  end
  local occurrences = checked:occurrences(resolved, true)
  if #occurrences ~= #self.anchors then
    return rejected<|VerifiedRename|>(
      "candidate rename changed the resolved occurrence set")
  end
  for index = 1, #occurrences do
    if occurrences[index].name ~= self.new_name or
       not contains_anchor(self.anchors, occurrences[index]) then
      return rejected<|VerifiedRename|>(
        "candidate rename resolved an unexpected occurrence")
    end
  end
  return VerifiedRename(self.documents), nil
end

function VerifiedRename:document_edits(): {lsp.DocumentEdits}
  return {...self.documents}
end
