--- Task-aware compiler filesystem and process I/O with exact provenance observations.
-- @module server.compiler_io

local async = import "async"
local fs = import "fs"
local iteration = import "iteration"
local wire = import "server.wire"
local embedded_interfaces = import "server.embedded_interfaces"
local lua = import "lua"
local logging = import "server.logging"
local math = import "math"
local system = import "os"
local strings = import "string"
local paths = import "path"
local content_identity = import "server.content_identity"
foreign import "compiler_io_clock.h"
foreign import "compiler_io_platform.h"

type CheckpointListener = function (string?): ()

local record CompilerProgress
  const attempt: integer
  const root_module: string
  completed_modules: integer
  const timing: boolean
  const started_wall_seconds: integer
  const started_cpu: float
end

-- This is the followed filesystem identity observed when lstat found a
-- provider candidate. Following here matters for a symlinked dynamic provider:
-- later validation must compare the object package.loadlib actually opened,
-- while the compiler still receives unchanged lstat semantics.
--- Exact followed filesystem identity observed during one compiler analysis.
record LstatIdentity
  const path: string
  const size: integer
  const kind: string
  const device: integer?
  const inode: integer?
  const modified_seconds: integer
  const modified_nanoseconds: integer
  const native_identity: string?
end

local record LstatObservation
  identity: LstatIdentity?
  consistent: boolean
end

local record PossibleNativeLoad
  metadata: fs.Stat?
end

-- Native handles outlive Compiler and CompilerIO instances. Keep the first
-- possible mapping, even for topology probes or attempts that fail checking.
-- The compiler lstat's each occupied dynamic candidate before probing it;
-- carried probes can only refer to a provider already selected that way.
local const possible_native_loads: {string: PossibleNativeLoad} = {}

local function dynamic_path_key(path: string): string
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then return strings.lower(paths.to_slash(path)) end
  return path
end

local function dynamic_candidate(path: string): boolean
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then return strings.sub(path, -4) == ".dll" end
  return strings.sub(path, -3) == ".so"
end

local function same_native_file_version(before: fs.Stat?, after: fs.Stat): boolean
  return before ~= nil and before.device == after.device and before.inode == after.inode and
    before.mode == after.mode and before.size == after.size and
    before.modified_seconds == after.modified_seconds and
    before.modified_nanoseconds == after.modified_nanoseconds
end

local function remember_native_candidate(path: string, followed: fs.Stat?)
  local key = dynamic_path_key(path)
  local first? = possible_native_loads[key]
  if followed == nil or followed.kind ~= "file" or followed.inode == 0 then
    if first == nil then possible_native_loads[key] = PossibleNativeLoad(nil)
    else first.metadata = nil end
    return
  end
  if first ~= nil and same_native_file_version(first.metadata, followed) then return end

  -- A different pathname may reach an image already mapped through a
  -- symlink or a hard link. Group by normalized name and followed inode.
  local inode_key = "\0" .. followed.device .. ":" .. followed.inode
  local real_key?: string
  do
    real_key = dynamic_path_key(fs.realpath(path))
  catch
    if error is async.CancellationReason then raise end
  end
  local physical? = possible_native_loads[inode_key]
  local canonical?: PossibleNativeLoad
  if real_key ~= nil then canonical = possible_native_loads[real_key] end
  if real_key == nil or (first ~= nil and not same_native_file_version(first.metadata, followed)) or
      (physical ~= nil and not same_native_file_version(physical.metadata, followed)) or
      (canonical ~= nil and not same_native_file_version(canonical.metadata, followed)) then
    if first ~= nil then first.metadata = nil end
    if physical ~= nil then physical.metadata = nil end
    if canonical ~= nil then canonical.metadata = nil end
    followed = nil
  end
  local observed = first or canonical or physical or PossibleNativeLoad(followed)
  possible_native_loads[key] = observed
  possible_native_loads[inode_key] = observed
  if real_key ~= nil then possible_native_loads[real_key] = observed end
end

function dynamic_provider_witness(path: string): string?
  local observed? = possible_native_loads[dynamic_path_key(path)]
  if observed == nil or observed.metadata == nil then return nil end
  return content_identity.observed_file_version(observed.metadata)
end

-- The compiler sees this record only through its ordinary Lua userdata proxy.
-- Every argument/result crossing that boundary therefore uses Lua-native
-- scalars or Maps; Titan Arrays and records never leak into compiler state.
--- Compiler-compatible I/O strategy backed by Titan Task-aware file and process operations.
record CompilerIO
  -- Empty public records have no Lua-visible userdata member table. This
  -- private inert field gives the strategy the ordinary record proxy that the
  -- compiler validates and invokes; it carries no semantic state.
  local proxy_marker: boolean
  -- The compiler calls yield only after publishing one checked source module.
  -- This state belongs to server observability, remains invisible through the
  -- Lua proxy, and is reset at every bridge attempt boundary.
  local next_attempt: integer
  local progress: CompilerProgress?
  local checkpoint_listener: CheckpointListener?
  -- Provider selection can repeat across the fresh resolver contexts used by
  -- one incremental analysis. Retain an identity only when every lstat of the
  -- same path in that analysis observed the same state. These fields remain
  -- private, so they do not add members or methods to the compiler's Lua
  -- strategy proxy.
  local observing_lstats: boolean
  local lstat_observations: {string: LstatObservation}
end

local function failure_message(failure: value): string
  -- Filesystem/process operations are cancellation points. Do not turn the
  -- Task's authoritative cancellation request into an ordinary compiler I/O
  -- error merely because this strategy normalizes backend failures.
  if failure is async.CancellationReason then raise failure end
  if failure is async.OperationError then
    local operation = failure as async.OperationError
    return operation.operation .. ": " .. operation.name .. ": " ..
           operation.message
  end
  return strings.tostring(failure)
end

--- Create an isolated compiler I/O strategy and its observation state.
function create(): CompilerIO
  return CompilerIO {
    proxy_marker = false,
    next_attempt = 0,
    observing_lstats = false,
    lstat_observations = {},
  }
end

--- Compare all recorded filesystem identity fields without narrowing host bit patterns.
function same_lstat_identity(left: LstatIdentity,
                             right: LstatIdentity): boolean
  return left.path == right.path and
         left.size == right.size and
         left.kind == right.kind and
         left.device == right.device and
         left.inode == right.inode and
         left.modified_seconds == right.modified_seconds and
         left.modified_nanoseconds == right.modified_nanoseconds and
         left.native_identity == right.native_identity
end

local function identity_for(path: string, metadata: fs.Stat): LstatIdentity
  return LstatIdentity {
    path = path,
    size = metadata.size,
    kind = metadata.kind,
    device = metadata.device,
    inode = metadata.inode,
    modified_seconds = metadata.modified_seconds,
    modified_nanoseconds = metadata.modified_nanoseconds,
  }
end

-- Only the Windows embedded provider carries an opaque identity. Its native
-- owner retains a file handle denying writes/deletion, so this snapshot read
-- performs no blocking filesystem work on a Task. All ordinary providers keep
-- the async libuv stat path and Unix integer identities.
function lstat_identity_is_current(identity: LstatIdentity): boolean
  if identity.native_identity ~= nil then
    if ffi.VSCODE_TITAN_WINDOWS == 0 then return false end
    local current = embedded_interfaces.identity()
    local native?: string = current["native_identity"]
    return native ~= nil and native == identity.native_identity and
      current["path"] == identity.path and current["kind"] == identity.kind and
      current["size"] == identity.size and
      current["modified_seconds"] == identity.modified_seconds and
      current["modified_nanoseconds"] == identity.modified_nanoseconds and
      identity.device == nil and identity.inode == nil
  end
  local current? = fs.stat(identity.path)
  if current == nil then return false end
  return same_lstat_identity(identity, identity_for(identity.path, current))
end

local function same_optional_lstat_identity(left: LstatIdentity?,
                                             right: LstatIdentity?): boolean
  if left == nil or right == nil then return left == nil and right == nil end
  return same_lstat_identity(left, right)
end

local function CompilerIO:observe_lstat(path: string,
                                        identity: LstatIdentity?)
  if not self.observing_lstats then return end
  local previous? = self.lstat_observations[path]
  if previous == nil then
    self.lstat_observations[path] = LstatObservation(identity, true)
  elseif previous.consistent and
         not same_optional_lstat_identity(previous.identity, identity) then
    previous.consistent = false
    previous.identity = nil
  end
end

-- Observation lifecycle is a typed bridge concern, not part of the public Lua
-- strategy API. A new analysis always starts empty and terminal cleanup drops
-- the state even when compiler work raises or is cancelled.
function begin_lstat_observations(strategy: CompilerIO)
  strategy.observing_lstats = true
  strategy.lstat_observations = {}
end

function end_lstat_observations(strategy: CompilerIO)
  strategy.observing_lstats = false
  strategy.lstat_observations = {}
end

--- Return one identity only when observations agree throughout the current analysis.
function consistent_lstat_identity(strategy: CompilerIO,
                                   path: string): LstatIdentity?
  if not strategy.observing_lstats then return nil end
  local observation? = strategy.lstat_observations[path]
  if observation == nil or not observation.consistent or
     observation.identity == nil then
    return nil
  end
  return observation.identity
end

-- The bridge installs this only for the lifetime of one incremental analysis.
-- The compiler cannot reach it directly because it is not a record method.
function set_checkpoint_listener(strategy: CompilerIO,
                                 listener: CheckpointListener?)
  strategy.checkpoint_listener = listener
end

local function CompilerIO:begin_attempt(root_module: string): integer
  self.next_attempt = self.next_attempt + 1
  local timing = false
  local started_wall_seconds = 0
  local started_cpu = 0.0
  do
    if logging.enabled("debug") then
      started_wall_seconds = logging.wall_clock()
      started_cpu = logging.clock()
      timing = true
    end
  catch
    -- Optional telemetry cannot prevent a compiler attempt from starting.
  end
  self.progress = CompilerProgress {
    attempt = self.next_attempt,
    root_module = root_module,
    completed_modules = 0,
    timing = timing,
    started_wall_seconds = started_wall_seconds,
    started_cpu = started_cpu,
  }
  return self.next_attempt
end

local function CompilerIO:finish_attempt(attempt: integer): integer
  local progress? = self.progress
  if progress == nil or progress.attempt ~= attempt then return 0 end
  local completed = progress.completed_modules
  self.progress = nil
  return completed
end

-- Bridge-owned attempt lifecycle stays a typed module operation. The compiler
-- receives only CompilerIO's ordinary public I/O methods through its userdata
-- proxy; it cannot start, finish, or inspect server observability state.
function begin_attempt(strategy: CompilerIO, root_module: string): integer
  return strategy:begin_attempt(root_module)
end

function finish_attempt(strategy: CompilerIO, attempt: integer): integer
  return strategy:finish_attempt(attempt)
end

local function checked_path(path: string): (string?, string?)
  local nul? = strings.find(path, "\0")
  if nul then return nil, "path contains a NUL byte" end
  return path, nil
end

function CompilerIO:cwd(): (string?, string?)
  return system.cwd(), nil
catch
  return nil, failure_message(error)
end

function CompilerIO:realpath(path: string): (string?, string?)
  local valid?, path_error? = checked_path(path)
  if not valid then return nil, path_error end
  return fs.realpath(path), nil
catch
  if error is async.OperationError and
     (error as async.OperationError).name == "ENOENT" then
    return nil, "path does not exist: " .. path
  end
  return nil, failure_message(error)
end

local function stat_map(stat: fs.Stat): {string: value}
  return {
    ["size"] = stat.size,
    ["kind"] = stat.kind,
    ["mode"] = stat.mode,
    ["device"] = stat.device,
    ["inode"] = stat.inode,
    ["modified_seconds"] = stat.modified_seconds,
    ["modified_nanoseconds"] = stat.modified_nanoseconds,
    ["time_precision"] = "ns",
  }
end

function CompilerIO:stat(path: string): ({string: value}?, string?)
  local valid?, path_error? = checked_path(path)
  if not valid then return nil, path_error end
  local metadata? = fs.stat(path)
  if not metadata then return nil, nil end
  return stat_map(metadata), nil
catch
  return nil, failure_message(error)
end

function CompilerIO:lstat(path: string): ({string: value}?, string?)
  local valid?, path_error? = checked_path(path)
  if not valid then return nil, path_error end
  local metadata? = fs.lstat(path)
  if not metadata then
    self:observe_lstat(path, nil)
    return nil, nil
  end
  local dynamic = dynamic_candidate(path)
  if self.observing_lstats or dynamic then
    -- Do not change the public lstat result when this validation-only follow
    -- fails. Cancellation remains authoritative because the extra stat is a
    -- real asynchronous operation in the compiler Task.
    do
      local followed? = fs.stat(path)
      if dynamic then remember_native_candidate(path, followed) end
      if followed == nil then self:observe_lstat(path, nil)
      elseif self.observing_lstats then self:observe_lstat(path, identity_for(path, followed)) end
    catch
      if error is async.CancellationReason then raise end
      if dynamic then remember_native_candidate(path, nil) end
      self:observe_lstat(path, nil)
    end
  end
  return stat_map(metadata), nil
catch
  if error is async.CancellationReason then raise end
  return nil, failure_message(error)
end

function CompilerIO:readable(path: string): boolean
  local valid? = checked_path(path)
  if not valid then return false end
  local file = fs.open(path, "r")
  file:close()
  return true
catch
  failure_message(error)
  return false
end

function CompilerIO:executable(path: string): (boolean?, string?)
  local valid?, path_error? = checked_path(path)
  if not valid then return nil, path_error end
  local support: {string: value} = lua.require("titan")
  local check: value = support["_executable_access"]
  if check == nil then
    return nil, "installed Titan native support lacks _executable_access"
  end
  local query = check as function (string): (boolean?, string?)
  return query(path)
end

local function read_bounded_chunks(reader: function (integer?): string?,
                                   max_bytes: integer): string
  local output = strings.writer()
  local remaining = max_bytes + 1
  while remaining > 0 do
    local chunk? = reader(remaining)
    if chunk == nil or #chunk == 0 then return output:drain() end
    output:write(chunk)
    remaining = remaining - #chunk
  end
  return output:drain()
end

function CompilerIO:read_file(path: string,
                              max_bytes: integer?): (string?, string?)
  local valid?, path_error? = checked_path(path)
  if not valid then return nil, path_error end
  if max_bytes ~= nil then
    if max_bytes < 0 or max_bytes >= math.maxinteger then
      return nil, "read limit must be a nonnegative integer"
    end

    -- Read one byte beyond the caller's bound so it can distinguish an exact
    -- fit from a file which grew after stat. A filesystem read may complete
    -- short without reaching EOF, so continue only through the remaining
    -- bounded prefix and never materialize the rest of a large replacement.
    local file = fs.open(path, "r")
    defer file:close()
    return read_bounded_chunks(file:read, max_bytes), nil
  end
  return fs.read_file(path), nil
catch
  return nil, failure_message(error)
end

local function write_atomic(path: string, contents: string,
                            temporary: string): (boolean?, string?)
  fs.write_file(temporary, contents)
  fs.rename(temporary, path)
  return true, nil
catch
  local original = error
  local cancellation = original is async.CancellationReason
  local message = ""
  if not cancellation then message = failure_message(original) end
  if cancellation then
    -- A pending cancellation prevents another cancellation-sensitive unlink
    -- from being submitted by this Task. Transfer cleanup to an uncancelled
    -- child which remains runtime-rooted after the caller unwinds.
    do
      async.run<|nil, value|>(function (): nil
        do fs.unlink(temporary) catch end
        return nil
      end)
    catch
    end
  else
    do fs.unlink(temporary) catch end
  end
  if cancellation then raise original end
  return nil, message
end

local record ReleasedReservation
  const path: string?
  const message: string?
end

local function CompilerIO:release_reservation(): ReleasedReservation
  local reservation?, reservation_error? = self:tmpname()
  if not reservation then
    return ReleasedReservation { message = reservation_error }
  end
  local removed?, remove_error? = self:unlink(reservation)
  if not removed then
    return ReleasedReservation { message = remove_error }
  end
  return ReleasedReservation { path = reservation }
end

function CompilerIO:write_file(path: string,
                               contents: string): (boolean?, string?)
  local valid?, path_error? = checked_path(path)
  if not valid then return nil, path_error end

  -- Reserve the same process-unique identity as the synchronous strategy,
  -- move only its basename beside the destination, and publish by rename
  -- after the complete sibling file has been closed.
  -- Keep creation and removal of the name reservation in a child Task. If the
  -- calling compiler Task is cancelled while joining it, the child still owns
  -- enough state to finish the unlink instead of losing a completed tmpname.
  local release = async.run<|ReleasedReservation, value|>(
    self:release_reservation)
  local reservation?: string = nil
  case async.join(release)
  when succeeded(result) then
    if not result.path then return nil, result.message end
    reservation = result.path
  when failed(failure) then
    return nil, failure_message(failure.error)
  when cancelled() then
    return nil, "temporary-name reservation task was cancelled"
  else
    return nil, "temporary-name reservation task did not finish"
  end
  local temporary = path .. "." ..
    paths.basename(reservation) .. ".tmp"
  return write_atomic(path, contents, temporary)
end

function CompilerIO:list(path: string): ({integer: string}?, string?)
  local valid?, path_error? = checked_path(path)
  if not valid then return nil, path_error end
  local entries = fs.list(path)
  local result: {integer: string} = {}
  for index = 1, #entries do result[index] = entries[index] end
  return result, nil
catch
  return nil, failure_message(error)
end

function CompilerIO:mkdir(path: string,
                          remove_if_cancelled: boolean?): (boolean?, string?)
  local valid?, path_error? = checked_path(path)
  if not valid then return nil, path_error end
  fs.mkdir(path)
  if remove_if_cancelled == true then
    -- Ownership is not transferred until one uncancelled scheduler
    -- checkpoint after the native mkdir completes. This gives cancellation a
    -- deterministic rollback boundary even when the filesystem callback is
    -- delivered before the caller next runs.
    async.yield()
  end
  return true, nil
catch
  if error is async.CancellationReason and remove_if_cancelled == true then
    -- The caller marks only a freshly reserved, previously absent directory.
    -- Complete rollback in an uncancelled child because this Task can no
    -- longer submit another cancellation-sensitive filesystem operation.
    do
      async.run<|nil, value|>(function (): nil
        do fs.rmdir(path) catch end
        return nil
      end)
    catch
    end
    raise
  end
  return nil, failure_message(error)
end

function CompilerIO:unlink(path: string,
                           remove_if_cancelled: boolean?): (boolean?, string?)
  local valid?, path_error? = checked_path(path)
  if not valid then return nil, path_error end
  if remove_if_cancelled == true then
    -- This flag is reserved for a fresh regular file returned by tmpname.
    -- Avoid a second cancellation point before releasing that reservation.
    fs.unlink(path)
    return true, nil
  end
  local metadata? = fs.lstat(path)
  if metadata and metadata.kind == "directory" then
    return nil, "cannot unlink directory '" .. path .. "'"
  end
  fs.unlink(path)
  return true, nil
catch
  if error is async.CancellationReason and remove_if_cancelled == true then
    -- An accepted unlink may have completed before libuv delivers the
    -- authoritative cancellation. Retry in an uncancelled child so both that
    -- case and cancellation before submission leave the owned path absent.
    do
      async.run<|nil, value|>(function (): nil
        do fs.unlink(path) catch end
        return nil
      end)
    catch
    end
    raise
  end
  return nil, failure_message(error)
end

function CompilerIO:rmdir(path: string): (boolean?, string?)
  local valid?, path_error? = checked_path(path)
  if not valid then return nil, path_error end
  fs.rmdir(path)
  return true, nil
catch
  return nil, failure_message(error)
end

function CompilerIO:rename(from: string,
                           to: string): (boolean?, string?)
  local valid_from?, from_error? = checked_path(from)
  if not valid_from then return nil, from_error end
  local valid_to?, to_error? = checked_path(to)
  if not valid_to then return nil, to_error end
  fs.rename(from, to)
  return true, nil
catch
  return nil, failure_message(error)
end

local record TmpnameHandoff
  path: string?
  failure: value
  accepted: boolean
  abandoned: boolean
  finished: boolean
end

function CompilerIO:tmpname(): (string?, string?)
  local handoff = TmpnameHandoff {
    accepted = false,
    abandoned = false,
    finished = false,
  }
  async.run<|nil, value|>(function (): nil
    do
      local path = fs.tmpname()
      handoff.path = path
      while not handoff.accepted and not handoff.abandoned do
        async.yield()
      end
      if handoff.abandoned then do fs.unlink(path) catch end end
    catch
      handoff.failure = error
    end
    handoff.finished = true
    return nil
  end)

  do
    while handoff.path == nil and not handoff.finished do async.yield() end
    if handoff.path == nil then
      return nil, failure_message(handoff.failure)
    end
    handoff.accepted = true
    return handoff.path, nil
  catch
    handoff.abandoned = true
    if error is async.CancellationReason then raise end
    return nil, failure_message(error)
  end
end

--- Publish a compiler checkpoint and cooperatively yield without exposing partial module state.
function CompilerIO:yield(module_name: string?)
  local progress? = self.progress
  if progress ~= nil then
    progress.completed_modules = progress.completed_modules + 1
    -- Enqueue before yielding: a cancellation delivered at this checkpoint
    -- must not hide the fully published module which made the Task yieldable.
    -- Debug-only clocks/serialization are best-effort too: telemetry must not
    -- change compiler control flow even if a platform clock or encoder fails.
    do
      if progress.timing and logging.enabled("debug") then
        local fields: wire.Object = {
          ["attempt"] = progress.attempt,
          ["root_module"] = progress.root_module,
          ["completed_modules"] = progress.completed_modules,
          ["wall_ms"] = logging.elapsed_wall_ms(progress.started_wall_seconds),
          ["cpu_ms"] = logging.elapsed_ms(progress.started_cpu),
        }
        if module_name ~= nil then
          fields["module_name"] = module_name
        end
        logging.emit("debug", "compiler.module.complete", fields)
      end
    catch
    end
  end
  -- Checkpoint observation is intentionally non-yielding and best-effort.
  -- Enqueue it before the cooperative yield so cancellation cannot hide a
  -- source module which the compiler has already fully published.
  local listener? = self.checkpoint_listener
  if listener ~= nil then do listener(module_name) catch end end
  async.yield()
end

local function invalid_run(diagnostic: string): {string: value}
  return {
    ["started"] = false,
    ["ok"] = false,
    ["diagnostic"] = diagnostic,
  }
end

local function quote_word(word: string): string
  local output = strings.writer()
  output:write("'")
  for index = 1, #word do
    local byte = strings.sub(word, index, index)
    if byte == "'" then
      output:write("'\\''")
    else
      output:write(byte)
    end
  end
  output:write("'")
  return output:drain()
end

local function normalize_argv(candidate: value):
    ({string}?, string?)
  if not (candidate is {integer: value}) then
    return nil, "command must be an argument array"
  end
  local source = candidate as {integer: value}
  local length = #source
  local entries = 0
  for key, _ in iteration.pairs(source) do
    entries = entries + 1
    if key < 1 or key > length then
      return nil, "command must be a dense argument array"
    end
  end
  if entries ~= length then
    return nil, "command must be a dense argument array"
  end

  local argv: {string} = {}
  for index = 1, length do
    local raw? = source[index]
    if raw == nil or not (raw is string) then
      return nil, "command argument " .. index .. " must be a string"
    end
    local argument = raw as string
    local nul? = strings.find(argument, "\0")
    if nul then
      return nil, "command argument " .. index .. " contains a NUL byte"
    end
    argv[index] = argument
  end
  return argv, nil
end

local function merge_stderr(candidate: value): (boolean?, string?)
  if candidate == nil then return true, nil end
  if not (candidate is {string: value}) then
    return nil, "command options must be a table"
  end
  local options = candidate as {string: value}
  local configured: value = options["stderr_to_stdout"]
  return configured ~= false, nil
end

local function command_label(argv: {string}, merged: boolean): string
  local output = strings.writer()
  if ffi.VSCODE_TITAN_WINDOWS == 0 then output:write("env ") end
  output:write("LANG=C LC_ALL=C")
  for index = 1, #argv do
    output:write(" ")
    output:write(quote_word(argv[index]))
  end
  if merged then output:write(" 2>&1") end
  return output:drain()
end

local function read_all(input: system.InputStream): string
  defer input:close()
  local output = strings.writer()
  for chunk in input:read do output:write(chunk) end
  return output:drain()
end

local function required_input(candidate: system.InputStream?,
                              subject: string): system.InputStream
  if not candidate then raise subject .. " was not captured" end
  return candidate
end

local function required_output(candidate: system.OutputStream?,
                               subject: string): system.OutputStream
  if not candidate then raise subject .. " was not captured" end
  return candidate
end

local function kill_owned_process(process: system.Process)
  if process:is_running() then process:kill("kill") end
catch
  -- The child may have exited between the OS query and the signal. Its
  -- already-started wait Task below remains the authoritative reaper.
end

local function capture_failure(command: string, diagnostic: string,
                               started: boolean): {string: value}
  return {
    ["started"] = started,
    ["ok"] = false,
    ["command"] = command,
    ["diagnostic"] = diagnostic,
  }
end

local function capture_process(process: system.Process,
                               command: string): {string: value}
  local output = required_input(process.stdout, "captured command stdout")
  local input = required_output(process.stdin, "captured command stdin")

  -- Start every callback-owning Task before the first operation in this
  -- function can suspend. If the caller is cancelled while closing stdin or
  -- joining, the reader still drains/closes its pipe and the waiter still
  -- reaps the process after kill_owned_process terminates it.
  local reader = async.run<|string, value|>(function (): string
    return read_all(output)
  end)
  local waiter = async.run<|system.ExitStatus, value|>(process:wait)

  input:close()
  local read_status, wait_status = async.join_two(reader, waiter)

  local captured = ""
  case read_status
  when succeeded(bytes) then captured = bytes
  when failed(failure) then
    return capture_failure(
      command, "could not capture command output: " ..
      failure_message(failure.error), true)
  when cancelled() then
    return capture_failure(
      command, "captured command reader was cancelled", true)
  else
    return capture_failure(
      command, "captured command reader did not finish", true)
  end

  local status?: system.ExitStatus = nil
  case wait_status
  when succeeded(exit_status) then status = exit_status
  when failed(failure) then
    return capture_failure(
      command, captured ..
      "\nfailed waiting for command: " .. failure_message(failure.error),
      true)
  when cancelled() then
    return capture_failure(
      command, "captured command wait was cancelled", true)
  else
    return capture_failure(
      command, "captured command wait did not finish", true)
  end

  local actual = status
  local signal?: integer = nil
  if actual.signal_number > 0 then signal = actual.signal_number end
  local interrupted = signal ~= nil
  local why = "exit"
  local normalized_status = actual.code
  local shell_status?: integer = nil
  if interrupted then
    why = "signal"
    normalized_status = signal
    if normalized_status >= 1 and normalized_status <= 64 then
      shell_status = 128 + normalized_status
    end
  end
  local missing = not interrupted and
    (actual.code == 126 or actual.code == 127)
  local succeeded = actual.code == 0
  if interrupted then succeeded = false end

  local result: {string: value} = {
    ["started"] = not missing,
    ["ok"] = succeeded,
    ["status"] = normalized_status,
    ["interrupted"] = interrupted,
    ["command"] = command,
    ["diagnostic"] = captured,
    ["output"] = captured,
  }
  if signal then result["signal"] = signal end
  if shell_status then result["shell_status"] = shell_status end
  result["why"] = why
  return result
catch
  kill_owned_process(process)
  raise
end

local function capture_spawned_process(process: system.Process,
                                       command: string): {string: value}
  return capture_process(process, command)
catch
  -- system.spawn already transferred a live child to this scope. Preserve
  -- that physical-launch fact even when pipe setup or capture fails before a
  -- normal exit status can be reported.
  kill_owned_process(process)
  if error is async.CancellationReason then raise end
  return capture_failure(
    command, "could not capture started command: " ..
    failure_message(error), true)
end

local function spawn_and_capture_untimed(
    env_arguments: {string}, command: string,
    merged: boolean): {string: value}
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then
    local first = 3
    local clear_emcc_flags = env_arguments[3] == "env" and
      env_arguments[4] == "EMCC_CFLAGS=" and #env_arguments >= 5
    if clear_emcc_flags then first = 5 end
    local arguments: {string} = {}
    for index = first + 1, #env_arguments do
      arguments[#arguments + 1] = env_arguments[index]
    end
    local output_option = system.with_parent_stderr
    if merged then output_option = system.with_merged_output end
    local program = env_arguments[first]
    local process: system.Process? = nil
    if clear_emcc_flags then
      -- The browser compiler prefixes argv with this fixed env assignment.
      -- Keep the real compiler child under the existing cancellation owner.
      process = system.spawn(program, arguments,
        system.with_env("LANG", "C"), system.with_env("LC_ALL", "C"),
        system.with_env("EMCC_CFLAGS", ""), output_option)
    else
      process = system.spawn(program, arguments,
        system.with_env("LANG", "C"), system.with_env("LC_ALL", "C"),
        output_option)
    end
    local result = capture_spawned_process(process, command)
    -- A directly launched program can legitimately exit with 126 or 127.
    -- There is no env wrapper whose exit status means executable lookup failed.
    result["started"] = true
    return result
  end
  if merged then
    local process = system.spawn(
      "/usr/bin/env", env_arguments, system.with_merged_output)
    return capture_spawned_process(process, command)
  end
  -- This matches io.popen(command, "r"): stdout is captured while stderr
  -- remains the language-server process's diagnostic stream.
  local process = system.spawn(
    "/usr/bin/env", env_arguments, system.with_parent_stderr)
  return capture_spawned_process(process, command)
catch
  if error is async.CancellationReason then raise end
  return capture_failure(
    command, "could not start captured command: " .. failure_message(error),
    false)
end

-- Measure the complete physical-child interval, including spawn, concurrent
-- pipe draining, and the authoritative wait/reap Task. Process CPU time cannot
-- represent this duration because the compiler runs in another process.
local function monotonic_ms(): float
  return ffi.vscode_titan_monotonic_ms()
end

local function elapsed_monotonic_ms(started: float,
                                    finished: float): float?
  if started < 0.0 or started ~= started or started >= math.huge or
     finished < 0.0 or finished ~= finished or finished >= math.huge or
     finished < started then
    return nil
  end
  return finished - started
end

local function spawn_and_capture(env_arguments: {string}, command: string,
                                 merged: boolean): {string: value}
  local started = monotonic_ms()
  local result = spawn_and_capture_untimed(
    env_arguments, command, merged)
  local elapsed? = elapsed_monotonic_ms(started, monotonic_ms())
  if elapsed ~= nil then
    result["wall_ms"] = elapsed
  end
  return result
end

local function run_checked(argv_value: value,
                           options_value: value): {string: value}
  local argv?, argv_error? = normalize_argv(argv_value)
  if not argv then return invalid_run(argv_error) end
  if #argv == 0 then return invalid_run("command is empty") end
  local merged?, options_error? = merge_stderr(options_value)
  if merged == nil then return invalid_run(options_error) end

  local command = command_label(argv, merged)
  local env_arguments: {string} = {"LANG=C", "LC_ALL=C"}
  for index = 1, #argv do
    env_arguments[#env_arguments + 1] = argv[index]
  end

  return spawn_and_capture(env_arguments, command, merged)
catch
  if error is async.CancellationReason then raise end
  return invalid_run("command must be a dense argument array")
end

--- Run compiler child-process work and retain ownership through cancellation cleanup.
function CompilerIO:run(argv: value, options: value): {string: value}
  return run_checked(argv, options)
end
