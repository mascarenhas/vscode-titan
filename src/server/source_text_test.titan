foreign import "compiler_io_platform.h"
local test = import "test"
local strings = import "string"
local source_text = import "server.source_text.titan"

local function expect_position(source: string, offset: integer,
                               line: integer, character: integer)
  local position?, failure? = source_text.position_for_offset(source, offset)
  test.assert(failure == nil and position ~= nil,
              "valid byte offset did not produce an LSP position")
  test.assert(position.line == line and position.character == character,
              "byte offset produced the wrong UTF-16 position")
  local roundtrip?, reverse_failure? =
    source_text.offset_for_position(source, position)
  test.assert(reverse_failure == nil and roundtrip == offset,
              "UTF-16 position did not round-trip to its byte offset")
end

function test_source_text_converts_utf8_bytes_and_utf16_positions(
    _context: test.Context)
  local source = "a😀b\r\nβ\rc\nd"
  expect_position(source, 0, 0, 0)
  expect_position(source, 1, 0, 1)
  expect_position(source, 5, 0, 3)
  expect_position(source, 6, 0, 4)
  expect_position(source, 8, 1, 0)
  expect_position(source, 10, 1, 1)
  expect_position(source, 11, 2, 0)
  expect_position(source, 13, 3, 0)
  expect_position(source, 14, 3, 1)

  local span?, failure? = source_text.span_for_offsets(source, 1, 10)
  test.assert(failure == nil and span ~= nil,
              "valid byte span did not convert")
  test.assert(span.start.line == 0 and span.start.character == 1 and
              span.finish.line == 1 and span.finish.character == 1,
              "byte span produced the wrong LSP endpoints")
  local offsets?, reverse_failure? =
    source_text.offsets_for_span(source, span)
  test.assert(reverse_failure == nil and offsets ~= nil and
              offsets.start == 1 and offsets.finish == 10,
              "LSP span did not round-trip to byte offsets")
end

function test_source_text_rejects_split_scalars_surrogates_and_crlf(
    _context: test.Context)
  local source = "a😀b\r\nc"
  local split_utf8?, split_utf8_error? =
    source_text.position_for_offset(source, 2)
  test.assert(split_utf8 == nil and split_utf8_error ~= nil and
              strings.find(split_utf8_error.message, "UTF-8 scalar") ~= nil,
              "byte offset inside an astral scalar was accepted")

  local split_surrogate?, split_surrogate_error? =
    source_text.offset_for_position(
      source, source_text.Position.new(0, 2))
  test.assert(split_surrogate == nil and split_surrogate_error ~= nil and
              strings.find(split_surrogate_error.message,
                           "surrogate pair") ~= nil,
              "LSP position inside an astral surrogate pair was accepted")

  local split_crlf?, split_crlf_error? =
    source_text.position_for_offset(source, 7)
  test.assert(split_crlf == nil and split_crlf_error ~= nil and
              strings.find(split_crlf_error.message, "CRLF") ~= nil,
              "byte offset inside CRLF was accepted")

  local past_line?, past_line_error? = source_text.offset_for_position(
    source, source_text.Position.new(0, 5))
  test.assert(past_line == nil and past_line_error ~= nil,
              "UTF-16 position past line end was accepted")

  local malformed = "ok" .. strings.char(0xff) .. "tail"
  local before_malformed?, before_malformed_error? =
    source_text.position_for_offset(malformed, 2)
  test.assert(before_malformed_error == nil and
              before_malformed ~= nil and
              before_malformed.character == 2,
              "boundary before malformed UTF-8 did not remain addressable")
  local after_malformed?, malformed_error? =
    source_text.position_for_offset(malformed, 3)
  test.assert(after_malformed == nil and malformed_error ~= nil and
              strings.find(malformed_error.message,
                           "leading byte") ~= nil,
              "coordinate after malformed UTF-8 did not retain decoder error")
end

local record Utf8Boundary
  name: string
  bytes: string
  units: integer
end

function test_source_text_roundtrips_utf8_scalar_boundaries(context: test.Context)
  local cases: {Utf8Boundary} = {
    Utf8Boundary("smallest two-byte scalar", strings.char(0xc2, 0x80), 1),
    Utf8Boundary("largest two-byte scalar", strings.char(0xdf, 0xbf), 1),
    Utf8Boundary("smallest three-byte scalar", strings.char(0xe0, 0xa0, 0x80), 1),
    Utf8Boundary("before surrogate range", strings.char(0xed, 0x9f, 0xbf), 1),
    Utf8Boundary("after surrogate range", strings.char(0xee, 0x80, 0x80), 1),
    Utf8Boundary("largest BMP scalar", strings.char(0xef, 0xbf, 0xbf), 1),
    Utf8Boundary("smallest astral scalar", strings.char(0xf0, 0x90, 0x80, 0x80), 2),
    Utf8Boundary("middle astral plane", strings.char(0xf1, 0x80, 0x80, 0x80), 2),
    Utf8Boundary("largest Unicode scalar", strings.char(0xf4, 0x8f, 0xbf, 0xbf), 2),
  }
  for index = 1, #cases do
    local candidate = cases[index]
    context:run(candidate.name, function(_child: test.Context)
      local source = "x" .. candidate.bytes .. "y"
      expect_position(source, 1, 0, 1)
      expect_position(source, 1 + #candidate.bytes, 0, 1 + candidate.units)
      expect_position(source, #source, 0, 2 + candidate.units)
      for offset = 2, #candidate.bytes do
        local position?, failure? = source_text.position_for_offset(source, offset)
        test.assert(position == nil and failure ~= nil and
                    failure.message == "byte offset splits a UTF-8 scalar" and
                    failure.byte_offset == offset,
                    "interior byte acquired a source position")
      end
    end)
  end
end

local record InvalidUtf8
  name: string
  bytes: string
  message: string
  offset: integer
end

function test_source_text_retains_precise_malformed_utf8_errors(
    context: test.Context)
  local cases: {InvalidUtf8} = {
    InvalidUtf8("truncated two-byte", strings.char(0xc2), "truncated UTF-8 sequence", 2),
    InvalidUtf8("bad two-byte continuation", strings.char(0xc2, 0x20), "invalid UTF-8 continuation byte", 3),
    InvalidUtf8("truncated three-byte", strings.char(0xe0, 0xa0), "truncated UTF-8 sequence", 2),
    InvalidUtf8("bad third byte", strings.char(0xe1, 0x80, 0x20), "invalid UTF-8 continuation byte", 4),
    InvalidUtf8("overlong three-byte", strings.char(0xe0, 0x9f, 0x80), "invalid UTF-8 sequence", 2),
    InvalidUtf8("encoded surrogate", strings.char(0xed, 0xa0, 0x80), "UTF-8 cannot encode a surrogate", 2),
    InvalidUtf8("bad three-byte second", strings.char(0xe1, 0x20, 0x80), "invalid UTF-8 continuation byte", 3),
    InvalidUtf8("truncated four-byte", strings.char(0xf0, 0x90, 0x80), "truncated UTF-8 sequence", 2),
    InvalidUtf8("bad four-byte third", strings.char(0xf0, 0x90, 0x20, 0x80), "invalid UTF-8 continuation byte", 4),
    InvalidUtf8("overlong four-byte", strings.char(0xf0, 0x8f, 0x80, 0x80), "invalid UTF-8 sequence", 2),
    InvalidUtf8("above Unicode maximum", strings.char(0xf4, 0x90, 0x80, 0x80), "UTF-8 scalar is above U+10FFFF", 2),
    InvalidUtf8("bad four-byte second", strings.char(0xf1, 0x20, 0x80, 0x80), "invalid UTF-8 continuation byte", 3),
    InvalidUtf8("overlong leading byte", strings.char(0xc0, 0x80), "invalid UTF-8 leading byte", 2),
    InvalidUtf8("out-of-range leading byte", strings.char(0xf5, 0x80, 0x80, 0x80), "invalid UTF-8 leading byte", 2),
  }
  for index = 1, #cases do
    local candidate = cases[index]
    context:run(candidate.name, function(_child: test.Context)
      local source = "ok" .. candidate.bytes
      expect_position(source, 2, 0, 2)
      local position?, failure? = source_text.position_for_offset(source, #source)
      test.assert(position == nil and failure ~= nil and
                  failure.message == candidate.message and
                  failure.byte_offset == candidate.offset,
                  "malformed UTF-8 lost its precise byte error")
      local offset?, reverse_failure? = source_text.offset_for_position(
        source, source_text.Position(0, 3))
      test.assert(offset == nil and reverse_failure ~= nil and
                  reverse_failure.message == candidate.message and
                  reverse_failure.byte_offset == candidate.offset,
                  "reverse coordinates crossed malformed UTF-8")
    end)
  end
  context:run("bad fourth continuation", function(_child: test.Context)
    local source = "ok" .. strings.char(0xf0, 0x90, 0x80, 0x20)
    local position?, failure? = source_text.position_for_offset(source, #source)
    local offset?, reverse_failure? = source_text.offset_for_position(
      source, source_text.Position(0, 3))
    test.assert(position == nil and failure ~= nil and
                failure.message == "invalid UTF-8 continuation byte" and
                offset == nil and reverse_failure ~= nil and
                reverse_failure.message == failure.message,
                "fourth byte of a UTF-8 sequence was not validated")
  end)
end

function test_source_text_rejects_invalid_span_endpoints(_context: test.Context)
  local coordinates = source_text.coordinate_index("a😀b\nc")
  local invalid_bytes: {source_text.ByteSpan} = {
    source_text.ByteSpan(2, 5), source_text.ByteSpan(1, 2),
    source_text.ByteSpan(5, 1), source_text.ByteSpan(-1, 1),
    source_text.ByteSpan(1, 99),
  }
  for index = 1, #invalid_bytes do
    local bytes = invalid_bytes[index]
    local span?, failure? = coordinates:span_for_offsets(bytes.start, bytes.finish)
    test.assert(span == nil and failure ~= nil,
                "invalid byte endpoint produced a partial LSP span")
  end
  local invalid_positions: {source_text.Position} = {
    source_text.Position(-1, 0), source_text.Position(0, -1),
    source_text.Position(9, 0), source_text.Position(0, 2),
  }
  for index = 1, #invalid_positions do
    local position = invalid_positions[index]
    local start_span = source_text.Span(position, source_text.Position(1, 0))
    local end_span = source_text.Span(source_text.Position(0, 0), position)
    local start?, start_error? = coordinates:offsets_for_span(start_span)
    local finish?, finish_error? = coordinates:offsets_for_span(end_span)
    test.assert(start == nil and start_error ~= nil and
                finish == nil and finish_error ~= nil,
                "invalid LSP endpoint produced a partial byte span")
  end
  local reversed?, reversed_error? = coordinates:offsets_for_span(
    source_text.Span(source_text.Position(1, 0), source_text.Position(0, 0)))
  test.assert(reversed == nil and reversed_error ~= nil and
              reversed_error.message == "span finish precedes its start")
end

function test_source_text_normalizes_file_uris_and_paths(
    _context: test.Context)
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then test.skip("Unix path semantics") end
  local path?, path_error? = source_text.file_uri_to_path(
    "file:///workspace/a%20folder/../caf%C3%A9.titan")
  test.assert(path_error == nil and path == "/workspace/café.titan",
              "encoded file URI did not decode and normalize")

  local local_path?, local_error? = source_text.file_uri_to_path(
    "file://localhost/workspace/a%20b.titan")
  test.assert(local_error == nil and
              local_path == "/workspace/a b.titan",
              "localhost file URI did not normalize")

  local uri?, uri_error? = source_text.path_to_file_uri(
    "/workspace/./a b/../café.titan")
  test.assert(uri_error == nil and
              uri == "file:///workspace/caf%C3%A9.titan",
              "path did not normalize and percent encode")

  local resolved?, resolve_error? = source_text.resolve_path(
    "/workspace/project", "src/../lib/main.titan")
  test.assert(resolve_error == nil and
              resolved == "/workspace/project/lib/main.titan",
              "relative path resolution was not lexical and deterministic")
  test.assert(source_text.relative_path(
                "/workspace/project", resolved) == "lib/main.titan",
              "normalized child path did not become relative to its root")
end

function test_source_text_rejects_malformed_or_nonlocal_file_uris(
    _context: test.Context)
  local malformed?, malformed_error? =
    source_text.file_uri_to_path("file:///workspace/bad%2.titan")
  test.assert(malformed == nil and malformed_error ~= nil and
              strings.find(malformed_error.message, "percent escape") ~= nil,
              "truncated percent escape was accepted")

  local nonhex?, nonhex_error? =
    source_text.file_uri_to_path("file:///workspace/bad%XZ.titan")
  test.assert(nonhex == nil and nonhex_error ~= nil,
              "non-hexadecimal percent escape was accepted")

  local remote?, remote_error? =
    source_text.file_uri_to_path("file://example.com/workspace/main.titan")
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then
    test.assert(remote_error == nil and
                remote == "//example.com/workspace/main.titan",
                "UNC file URI authority was not preserved")
  else
    test.assert(remote == nil and remote_error ~= nil,
                "non-local file URI authority was accepted")
  end
end

function test_source_text_handles_percent_escape_boundaries(context: test.Context)
  context:run("lowercase escapes have canonical uppercase identities",
    function (_child: test.Context)
      if ffi.VSCODE_TITAN_WINDOWS ~= 0 then test.skip("Unix path semantics") end
      local path?, decode_error? = source_text.file_uri_to_path(
        "file:///workspace/caf%c3%a9%23%3f.titan")
      test.assert(decode_error == nil and path == "/workspace/café#?.titan",
                  "lowercase escapes lost exact file path bytes")
      local uri?, encode_error? = source_text.path_to_file_uri(path)
      test.assert(encode_error == nil and
                  uri == "file:///workspace/caf%C3%A9%23%3F.titan",
                  "decoded file identity did not use canonical uppercase escapes")
    end)
  context:run("terminal percent", function (_child: test.Context)
    local path?, failure? = source_text.file_uri_to_path("file:///workspace/bad%")
    test.assert(path == nil and failure ~= nil and
                failure.message == "malformed percent escape in file URI" and
                failure.byte_offset == 14,
                "terminal percent escape did not retain its exact byte error")
  end)
  context:run("terminal percent digit", function (_child: test.Context)
    local path?, failure? = source_text.file_uri_to_path("file:///workspace/bad%2")
    test.assert(path == nil and failure ~= nil and
                failure.message == "malformed percent escape in file URI" and
                failure.byte_offset == 14,
                "one-digit percent escape did not retain its exact byte error")
  end)
end

function test_source_text_rejects_unrepresentable_file_uri_identity(
    _context: test.Context)
  local invalid_uris: {string} = {
    "https://localhost/workspace/main.titan",
    "file://localhost",
    "file:///workspace/main.titan?version=1",
    "file:///workspace/main.titan#definition",
    "file:///workspace/bad%00name.titan",
  }
  for index = 1, #invalid_uris do
    local uri = invalid_uris[index]
    local path?, failure? = source_text.file_uri_to_path(uri)
    test.assert(path == nil and failure ~= nil,
                "invalid URI acquired a filesystem identity: " .. uri)
  end
  local path?, path_error? = source_text.normalize_absolute_path("relative.titan")
  local uri?, uri_error? = source_text.path_to_file_uri("relative.titan")
  local resolved?, resolve_error? = source_text.resolve_path("relative", "main.titan")
  test.assert(path == nil and path_error ~= nil and
              uri == nil and uri_error ~= nil and
              resolved == nil and resolve_error ~= nil,
              "relative base acquired an absolute path or URI identity")
  test.assert(source_text.relative_path("relative", "also-relative") == nil,
              "relative paths were accepted as project containment")
end

function test_source_text_coordinate_index_has_bounded_lookup_work(
    _context: test.Context)
  local line_count = 4096
  local output = strings.writer()
  local starts: {integer} = {}
  local offset = 0
  for line = 1, line_count do
    starts[line] = offset
    output:write("a😀b")
    offset = offset + 6
    if line % 3 == 0 then
      output:write("\r\n")
      offset = offset + 2
    elseif line % 3 == 1 then
      output:write("\r")
      offset = offset + 1
    else
      output:write("\n")
      offset = offset + 1
    end
  end
  local source = output:drain()

  local yield_count = 0
  local coordinates, work = source_text.coordinate_index_with_work(
    source, function () yield_count = yield_count + 1 end)
  local build_steps = source_text.coordinate_work_steps(work)
  test.assert(build_steps <= #source,
              "coordinate construction rescanned source bytes")
  test.assert(yield_count == build_steps // 1024 and yield_count > 0,
              "coordinate construction did not yield at its bounded cadence")

  for line = line_count, 1, -1 do
    local start_offset = starts[line] + 1
    local finish_offset = starts[line] + 5
    local span?, failure? = coordinates:span_for_offsets(
      start_offset, finish_offset)
    test.assert(failure == nil and span ~= nil and
                span.start.line == line - 1 and
                span.start.character == 1 and
                span.finish.line == line - 1 and
                span.finish.character == 3,
                "indexed UTF-16 span conversion produced wrong coordinates")
    local bytes?, reverse_failure? = coordinates:offsets_for_span(span)
    test.assert(reverse_failure == nil and bytes ~= nil and
                bytes.start == start_offset and
                bytes.finish == finish_offset,
                "indexed UTF-16 coordinates did not round-trip")
  end

  local lookup_steps = source_text.coordinate_work_steps(work) - build_steps
  test.assert(lookup_steps <= line_count * 40,
              "coordinate lookup performed full-prefix scans")
end

local function assert_windows_rejected(action: function (): ())
  local rejected = false
  do
    action()
  catch
    rejected = error is source_text.Error
  end
  test.assert(rejected, "ambiguous or unsupported Windows path was accepted")
end

function test_source_text_windows_drive_paths_and_uris(_context: test.Context)
  if ffi.VSCODE_TITAN_WINDOWS == 0 then test.skip("native Windows paths") end
  test.assert(source_text.normalize_absolute_or_raise(
    "c:\\Users\\titan-dev\\a folder\\..\\café.titan") ==
    "C:/Users/titan-dev/café.titan")
  test.assert(source_text.normalize_absolute_or_raise("C:/../../") == "C:/",
              "parent traversal escaped a drive root")
  test.assert(source_text.resolve_path_or_raise(
    "C:\\project", "src\\..\\main.titan") == "C:/project/main.titan")
  test.assert(source_text.resolve_path_or_raise(
    "C:/project", "w:\\live\\main.titan") == "W:/live/main.titan",
              "absolute shared drive path was appended to the project root")
  test.assert(source_text.relative_path_or_raise(
    "c:/", "C:\\project\\main.titan") == "project/main.titan")
  test.assert(source_text.relative_path_or_raise(
    "C:/project", "C:/project-other/main.titan") == nil)
  test.assert(source_text.relative_path_or_raise(
    "C:/", "W:/main.titan") == nil)
  local uri = source_text.path_to_file_uri_or_raise(
    "c:\\a folder\\café#100%.titan")
  test.assert(uri == "file:///C:/a%20folder/caf%C3%A9%23100%25.titan",
              "drive path did not produce a correctly escaped file URI")
  test.assert(source_text.file_uri_to_path_or_raise(uri) ==
              "C:/a folder/café#100%.titan")
  test.assert(source_text.file_uri_to_path_or_raise(
    "file:///c%3A/a%20folder/../main.titan") == "C:/main.titan")
  test.assert(source_text.file_uri_to_path_or_raise(
    "file://LOCALHOST/c:/main.titan") == "C:/main.titan")
  test.assert(source_text.file_uri_to_path_or_raise(
    "file://LOCALHOST/c%3A/main.titan") == "C:/main.titan")
end

function test_source_text_windows_unc_paths_and_uris(_context: test.Context)
  if ffi.VSCODE_TITAN_WINDOWS == 0 then test.skip("native Windows paths") end
  test.assert(source_text.normalize_absolute_or_raise(
    "\\\\server\\share\\folder\\..\\main.titan") ==
    "//server/share/main.titan")
  test.assert(source_text.normalize_absolute_or_raise(
    "//server/share/../../../main.titan") == "//server/share/main.titan",
              "parent traversal escaped a UNC share")
  test.assert(source_text.normalize_absolute_or_raise(
    "//server/share/") == "//server/share")
  test.assert(source_text.resolve_path_or_raise(
    "C:/project", "\\\\server\\share\\main.titan") ==
    "//server/share/main.titan")
  test.assert(source_text.relative_path_or_raise(
    "//server/share", "//server/share/main.titan") == "main.titan")
  test.assert(source_text.relative_path_or_raise(
    "//server/share", "//server/share-other/main.titan") == nil)
  local uri = source_text.path_to_file_uri_or_raise(
    "\\\\server\\share\\café #%.titan")
  test.assert(uri == "file://server/share/caf%C3%A9%20%23%25.titan")
  test.assert(source_text.file_uri_to_path_or_raise(uri) ==
              "//server/share/café #%.titan")
  test.assert(source_text.file_uri_to_path_or_raise(
    "file:////server/share/main.titan") == "//server/share/main.titan")
  local local_share = "//LOCALHOST/share/main.titan"
  local local_uri = source_text.path_to_file_uri_or_raise(local_share)
  test.assert(local_uri == "file://LOCALHOST/share/main.titan" and
              source_text.file_uri_to_path_or_raise(local_uri) == local_share,
              "localhost UNC host was confused with the local URI authority")
end

function test_source_text_windows_rejects_ambiguous_paths(_context: test.Context)
  if ffi.VSCODE_TITAN_WINDOWS == 0 then test.skip("native Windows paths") end
  assert_windows_rejected(function()
    source_text.normalize_absolute_or_raise("C:relative.titan")
  end)
  assert_windows_rejected(function()
    source_text.normalize_absolute_or_raise("\\relative.titan")
  end)
  assert_windows_rejected(function()
    source_text.resolve_path_or_raise("C:/project", "D:relative.titan")
  end)
  assert_windows_rejected(function()
    source_text.resolve_path_or_raise("C:/project", "/relative.titan")
  end)
  assert_windows_rejected(function()
    source_text.normalize_absolute_or_raise("//server")
  end)
  assert_windows_rejected(function()
    source_text.normalize_absolute_or_raise("//server/")
  end)
  assert_windows_rejected(function()
    source_text.normalize_absolute_or_raise("//?/C:/main.titan")
  end)
  assert_windows_rejected(function()
    source_text.normalize_absolute_or_raise("//./pipe/main")
  end)
  assert_windows_rejected(function()
    source_text.file_uri_to_path_or_raise("file://user@server/share/main")
  end)
  assert_windows_rejected(function()
    source_text.file_uri_to_path_or_raise("file://server:80/share/main")
  end)
  assert_windows_rejected(function()
    source_text.file_uri_to_path_or_raise("file:///C:/bad%00.titan")
  end)
end

function test_source_text_native_windows_path_dispatch(_context: test.Context)
  if ffi.VSCODE_TITAN_WINDOWS == 0 then test.skip("native Windows dispatch") end
  local path?, failure? = source_text.normalize_absolute_path("c:\\project")
  test.assert(failure == nil and path == "C:/project")
  local resolved?, resolve_error? = source_text.resolve_path(path, "W:\\live")
  test.assert(resolve_error == nil and resolved == "W:/live")
  local uri?, uri_error? = source_text.path_to_file_uri(resolved .. "/main.titan")
  test.assert(uri_error == nil and uri == "file:///W:/live/main.titan")
  local roundtrip?, decode_error? = source_text.file_uri_to_path(uri)
  test.assert(decode_error == nil and roundtrip == "W:/live/main.titan")
  test.assert(source_text.relative_path("W:/", roundtrip) == "live/main.titan")
  test.assert(source_text.is_absolute_path("C:\\") and
              source_text.is_absolute_path("\\\\server\\share") and
              not source_text.is_absolute_path("C:relative"))
end

function test_source_text_unix_preserves_backslashes_and_colons(
    _context: test.Context)
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then test.skip("Unix filename semantics") end
  local path = "/workspace/c:\\file.titan"
  local normalized?, failure? = source_text.normalize_absolute_path(path)
  test.assert(failure == nil and normalized == path)
  local uri?, uri_error? = source_text.path_to_file_uri(path)
  test.assert(uri_error == nil and uri == "file:///workspace/c:%5Cfile.titan")
  local roundtrip?, decode_error? = source_text.file_uri_to_path(uri)
  test.assert(decode_error == nil and roundtrip == path)
  local collapsed?, collapse_error? = source_text.normalize_absolute_path(
    "//workspace/../workspace//file.titan")
  test.assert(collapse_error == nil and collapsed == "/workspace/file.titan")
  local resolved?, resolve_error? = source_text.resolve_path("/workspace", "c:relative")
  test.assert(resolve_error == nil and resolved == "/workspace/c:relative")
end
