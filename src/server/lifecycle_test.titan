local test = import "test"
local iteration = import "iteration"
local wire = import "server.wire"
local lifecycle = import "server.lifecycle"

local function member_count(object: wire.Object): integer
  local count = 0
  for _, _ in iteration.pairs<|string, value|>(object) do count = count + 1 end
  return count
end

function test_lifecycle_completes_initialize_shutdown_exit(
    _context: test.Context)
  local server = lifecycle.create()
  local empty: wire.Object = {}
  test.assert(server:phase_name() == "before_initialize",
              "lifecycle started in the wrong phase")

  case server:dispatch("initialize", true, empty)
  when result(result) then
    local object? = wire.as_object(result)
    local capabilities? = wire.as_object(object["capabilities"])
    test.assert(capabilities ~= nil and member_count(capabilities) == 7,
                "initialize advertised the wrong capability count")
    test.assert(wire.as_string(capabilities["positionEncoding"]) ==
                  "utf-16" and
                wire.as_boolean(capabilities["definitionProvider"]) and
                wire.as_boolean(capabilities["referencesProvider"]) and
                wire.as_boolean(capabilities["renameProvider"]) and
                wire.as_boolean(capabilities["hoverProvider"]) and
                wire.as_boolean(capabilities["foldingRangeProvider"]),
                "initialize omitted a supported semantic capability")
    local provider? = wire.as_object(capabilities["diagnosticProvider"])
    test.assert(provider ~= nil and
                wire.as_boolean(provider["interFileDependencies"]) and
                wire.as_boolean(provider["workspaceDiagnostics"]) == false,
                "initialize omitted pull diagnostics")
    test.assert(capabilities["completionProvider"] == nil,
                "initialize advertised completion without a configured handler")
  else
    test.assert(false, "initialize did not produce a result")
  end
  test.assert(server:phase_name() == "awaiting_initialized",
              "initialize did not advance the lifecycle")

  case server:dispatch("initialized", false, empty)
  when initialized() then
  else
    test.assert(false, "initialized was not accepted as a notification")
  end
  test.assert(server:phase_name() == "running",
              "initialized did not enter the running phase")

  case server:dispatch("initialized", false, empty)
  when notification() then
  else
    test.assert(false, "duplicate initialized was treated as accepted")
  end
  test.assert(server:phase_name() == "running",
              "duplicate initialized changed lifecycle state")

  case server:dispatch("shutdown", true, nil)
  when result(result) then
    test.assert(wire.is_null(result), "shutdown result was not null")
  else
    test.assert(false, "shutdown did not produce a result")
  end

  case server:dispatch("exit", false, nil)
  when exit(code) then
    test.assert(code == 0, "orderly shutdown/exit returned failure")
  else
    test.assert(false, "exit did not terminate the lifecycle")
  end
  test.assert(server:phase_name() == "exited",
              "exit did not enter the exited phase")
end

function test_lifecycle_advertises_configured_full_sync_completion(_context: test.Context)
  local server = lifecycle.create()
  server:enable_completion()
  local empty: wire.Object = {}
  case server:dispatch("initialize", true, empty)
  when result(result) then
    local object? = wire.as_object(result)
    local capabilities? = wire.as_object(object["capabilities"])
    local synchronization? = wire.as_object(capabilities["textDocumentSync"])
    local save? = wire.as_object(synchronization["save"])
    local completion? = wire.as_object(capabilities["completionProvider"])
    local completion_item? = wire.as_object(completion["completionItem"])
    local triggers? = wire.as_array(completion["triggerCharacters"])
    test.assert(wire.as_boolean(synchronization["openClose"]) == true and
      wire.as_integer(synchronization["change"]) == 1 and
      wire.as_boolean(save["includeText"]) == false,
      "configured completion did not advertise full document synchronization")
    test.assert(wire.as_boolean(completion["resolveProvider"]) == false and
      wire.as_boolean(completion_item["labelDetailsSupport"]) == true and
      #triggers == 2 and wire.as_string(triggers[1]) == "." and
      wire.as_string(triggers[2]) == ":",
      "completion advertised an unsupported trigger or resolve endpoint")
  else
    test.assert(false, "initialize failed with completion configured")
  end
end

function test_lifecycle_enforces_order_and_message_kinds(
    _context: test.Context)
  local server = lifecycle.create()
  local empty: wire.Object = {}
  case server:dispatch("initialized", false, empty)
  when notification() then
  else
    test.assert(false, "early initialized was treated as accepted")
  end
  test.assert(server:phase_name() == "before_initialize",
              "early initialized changed lifecycle state")

  case server:dispatch("workspace/symbol", true, nil)
  when failure{message; code} then
    test.assert(code == -32002 and
                message == "server has not received an initialize request",
                "pre-initialize request lost its error code or message")
  else
    test.assert(false, "pre-initialize request was accepted")
  end

  case server:dispatch("initialize", true, wire.null())
  when failure{code} then
    test.assert(code == -32602,
                "invalid initialize params used the wrong error code")
  else
    test.assert(false, "initialize accepted non-object params")
  end
  test.assert(server:phase_name() == "before_initialize",
              "failed initialize changed lifecycle state")

  case server:dispatch("exit", false, nil)
  when exit(code) then
    test.assert(code == 1, "exit without shutdown returned success")
  else
    test.assert(false, "early exit did not terminate the lifecycle")
  end
end

function test_lifecycle_honors_the_client_pull_opt_out(_context: test.Context)
  local server = lifecycle.create()
  local params = wire.decode(
    [[{"capabilities":{"window":{"workDoneProgress":true}},"initializationOptions":{"pullDiagnostics":false}}]])
  case server:dispatch("initialize", true, params)
  when result(result) then
    local object? = wire.as_object(result)
    local capabilities? = wire.as_object(object["capabilities"])
    test.assert(capabilities["diagnosticProvider"] == nil,
                "client pull opt-out still advertised diagnosticProvider")
    local client? = server:client_capabilities()
    test.assert(client ~= nil and client.work_done_progress and
                client.pull_diagnostics_disabled,
                "accepted capabilities were not retained")
  else
    test.assert(false, "initialize with a pull opt-out failed")
  end
end
