--- Typed LSP parameters and JSON values for semantic and completion responses.
-- @module server.lsp_types

local wire = import "server.wire"
local source_text = import "server.source_text"
local strings = import "string"

record Error
  code: integer
  message: string
end

record TextDocument
  uri: string
  path: string
end

record DocumentPosition
  uri: string
  path: string
  position: source_text.Position
end

record OpenDocument
  document: TextDocument
  version: integer
  text: string
end

record ChangeDocument
  document: TextDocument
  version: integer
  text: string
end

union DocumentNotification
  opened(OpenDocument)
  changed(ChangeDocument)
  closed(TextDocument)
  saved(TextDocument)
end

record CompletionParams
  document: DocumentPosition
  trigger_kind: integer
  trigger_character: string?
end

record CompletionItem
  label: string
  kind: integer
  detail: string
  sort_text: string
  filter_text: string
  edit: TextEdit
  call_snippet: string?
  documentation: string?
end

record CompletionOptions
  const snippet_support: boolean
  const label_details_support: boolean
  const insert_call_snippets: boolean
end

--- Client behavior that changes a server-advertised feature.
record ClientCapabilities
  const work_done_progress: boolean
  const pull_diagnostics_disabled: boolean
end

--- Accessor for the capabilities advertised by the client's initialize.
type CapabilitiesReader = function (): ClientCapabilities?

--- Parameters of one textDocument/diagnostic pull.
record DiagnosticParams
  document: TextDocument
  previous_result_id: string?
end

record CompletionList
  is_incomplete: boolean
  items: {CompletionItem}
end

record ReferencesParams
  document: DocumentPosition
  include_declaration: boolean
end

record RenameParams
  document: DocumentPosition
  new_name: string
end

record TextEdit
  range: source_text.Span
  new_text: string
end

record DocumentEdits
  uri: string
  edits: {TextEdit}
end

record FoldingRange
  start_line: integer
  start_character: integer?
  end_line: integer
  end_character: integer?
  kind: string?
end

local INVALID_PARAMS = -32602

local function invalid<|T|>(message: string): (T?, Error?)
  return nil, Error.new(INVALID_PARAMS, message)
end

local function required_object(candidate: value, subject: string):
    (wire.Object?, Error?)
  if candidate == nil then
    return invalid<|wire.Object|>(subject .. " must be an object")
  end
  local object? = wire.as_object(candidate)
  if object == nil then
    return invalid<|wire.Object|>(subject .. " must be an object")
  end
  return object, nil
end

local function required_member(object: wire.Object, key: string,
                               subject: string): (value, Error?)
  local candidate? = object[key]
  if candidate == nil then
    return invalid<|value|>(subject .. "." .. key .. " is required")
  end
  return candidate, nil
end

local function required_string(object: wire.Object, key: string,
                               subject: string): (string?, Error?)
  local candidate?, failure? = required_member(object, key, subject)
  if candidate == nil then return nil, failure end
  local result? = wire.as_string(candidate)
  if result == nil then
    return invalid<|string|>(subject .. "." .. key .. " must be a string")
  end
  return result, nil
end

local function required_integer(object: wire.Object, key: string,
                                subject: string): (integer?, Error?)
  local candidate?, failure? = required_member(object, key, subject)
  if candidate == nil then return nil, failure end
  local result? = wire.as_integer(candidate)
  if result == nil then
    return invalid<|integer|>(subject .. "." .. key .. " must be an integer")
  end
  return result, nil
end

function parse_document(params: value): (TextDocument?, Error?)
  local object?, object_error? = required_object(params, "params")
  if object == nil then return nil, object_error end

  local raw_document?, document_error? =
    required_member(object, "textDocument", "params")
  if raw_document == nil then return nil, document_error end
  local document?, document_object_error? =
    required_object(raw_document, "params.textDocument")
  if document == nil then return nil, document_object_error end
  local uri?, uri_error? = required_string(
    document, "uri", "params.textDocument")
  if uri == nil then return nil, uri_error end

  local path?, path_error? = source_text.file_uri_to_path(uri)
  if path == nil then
    local detail = "invalid file URI"
    if path_error ~= nil then detail = path_error.message end
    return invalid<|TextDocument|>(
      "params.textDocument.uri is not a local file URI: " .. detail)
  end
  return TextDocument.new(uri, path), nil
end

local function parse_document_position_or_error(params: value):
    (DocumentPosition?, Error?)
  local document?, document_error? = parse_document(params)
  if document == nil then return nil, document_error end
  local object? = wire.as_object(params)

  local raw_position?, position_error? =
    required_member(object, "position", "params")
  if raw_position == nil then return nil, position_error end
  local position?, position_object_error? =
    required_object(raw_position, "params.position")
  if position == nil then return nil, position_object_error end
  local line?, line_error? = required_integer(
    position, "line", "params.position")
  if line == nil then return nil, line_error end
  local character?, character_error? = required_integer(
    position, "character", "params.position")
  if character == nil then return nil, character_error end
  if line < 0 or character < 0 then
    return invalid<|DocumentPosition|>(
      "params.position line and character must be non-negative")
  end

  return DocumentPosition.new(
    document.uri, document.path,
    source_text.Position.new(line, character)), nil
end

function parse_document_position(params: value):
    (DocumentPosition?, Error?)
  return parse_document_position_or_error(params)
end

function parse_diagnostic(params: value): (DiagnosticParams?, Error?)
  local document?, document_error? = parse_document(params)
  if document == nil then return nil, document_error end
  local object? = wire.as_object(params)
  local previous?: string
  if object["previousResultId"] ~= nil then
    local parsed? = wire.as_string(object["previousResultId"])
    if parsed == nil then
      return invalid<|DiagnosticParams|>(
        "params.previousResultId must be a string")
    end
    previous = parsed
  end
  return DiagnosticParams.new(document, previous), nil
end

local function parse_version(params: value): (integer?, Error?)
  local object? = wire.as_object(params)
  local document? = wire.as_object(object["textDocument"])
  local version?, failure? = required_integer(
    document, "version", "params.textDocument")
  if version == nil then return nil, failure end
  if version < -2147483648 or version > 2147483647 then
    return invalid<|integer|>("document version must be a signed 32-bit integer")
  end
  return version, nil
end

function parse_open(params: value): (OpenDocument?, Error?)
  local document?, failure? = parse_document(params)
  if document == nil then return nil, failure end
  local version?, version_error? = parse_version(params)
  if version == nil then return nil, version_error end
  local object? = wire.as_object(params)
  local item? = wire.as_object(object["textDocument"])
  local language?, language_error? = required_string(
    item, "languageId", "params.textDocument")
  if language == nil then return nil, language_error end
  if language ~= "titan" then
    return invalid<|OpenDocument|>("document language must be titan")
  end
  local text?, text_error? = required_string(item, "text", "params.textDocument")
  if text == nil then return nil, text_error end
  return OpenDocument.new(document, version, text), nil
end

function parse_change(params: value): (ChangeDocument?, Error?)
  local document?, failure? = parse_document(params)
  if document == nil then return nil, failure end
  local version?, version_error? = parse_version(params)
  if version == nil then return nil, version_error end
  local object? = wire.as_object(params)
  local changes? = wire.as_array(object["contentChanges"])
  if changes == nil or #changes == 0 then
    return invalid<|ChangeDocument|>("contentChanges must be a nonempty array")
  end
  local text = ""
  for index = 1, #changes do
    local change?, change_error? = required_object(
      changes[index], "params.contentChanges item")
    if change == nil then return nil, change_error end
    if change["range"] ~= nil or change["rangeLength"] ~= nil then
      return invalid<|ChangeDocument|>("only full document changes are supported")
    end
    local current?, text_error? = required_string(
      change, "text", "params.contentChanges item")
    if current == nil then return nil, text_error end
    -- A full-sync batch is ordered; each replacement supersedes the last.
    text = current
  end
  return ChangeDocument.new(document, version, text), nil
end

function parse_completion(params: value): (CompletionParams?, Error?)
  local document?, failure? = parse_document_position(params)
  if document == nil then return nil, failure end
  local object? = wire.as_object(params)
  local kind = 1
  local character?: string
  if object["context"] ~= nil then
    local context?, context_error? = required_object(
      object["context"], "params.context")
    if context == nil then return nil, context_error end
    local parsed?, kind_error? = required_integer(
      context, "triggerKind", "params.context")
    if parsed == nil then return nil, kind_error end
    if parsed < 1 or parsed > 3 then
      return invalid<|CompletionParams|>("completion triggerKind must be 1, 2, or 3")
    end
    kind = parsed
    if context["triggerCharacter"] ~= nil then
      character = wire.as_string(context["triggerCharacter"])
      if character == nil then
        return invalid<|CompletionParams|>("triggerCharacter must be a string")
      end
    end
    if kind == 2 and character ~= "." and character ~= ":" then
      return invalid<|CompletionParams|>("unsupported completion trigger character")
    end
  end
  return CompletionParams.new(document, kind, character), nil
end

function parse_references(params: value): (ReferencesParams?, Error?)
  local document?, document_error? = parse_document_position_or_error(params)
  if document == nil then return nil, document_error end
  local object? = wire.as_object(params)
  local raw_context?, context_error? =
    required_member(object, "context", "params")
  if raw_context == nil then return nil, context_error end
  local context?, context_object_error? =
    required_object(raw_context, "params.context")
  if context == nil then return nil, context_object_error end
  local raw_include?, include_error? =
    required_member(context, "includeDeclaration", "params.context")
  if raw_include == nil then return nil, include_error end
  local include? = wire.as_boolean(raw_include)
  if include == nil then
    return invalid<|ReferencesParams|>(
      "params.context.includeDeclaration must be a boolean")
  end
  return ReferencesParams.new(document, include), nil
end

local function ascii_letter(byte: integer): boolean
  return (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122)
end

local function keyword(name: string): boolean
  return name == "and" or name == "as" or name == "boolean" or
    name == "break" or name == "case" or name == "catch" or
    name == "const" or name == "defer" or name == "do" or
    name == "else" or name == "elseif" or name == "end" or
    name == "false" or name == "finally" or name == "float" or
    name == "for" or name == "foreign" or name == "function" or
    name == "goto" or name == "if" or name == "import" or
    name == "in" or name == "integer" or name == "interface" or
    name == "is" or name == "local" or name == "nil" or
    name == "not" or name == "or" or name == "owned" or
    name == "raise" or name == "record" or name == "repeat" or
    name == "return" or name == "string" or name == "then" or
    name == "true" or name == "type" or name == "union" or
    name == "until" or name == "value" or name == "when" or
    name == "while"
end

function valid_identifier(name: string): boolean
  if name == "" or keyword(name) then return false end
  local first: integer = strings.byte(name, 1)
  if first ~= 95 and not ascii_letter(first) then return false end
  for index = 2, #name do
    local byte: integer = strings.byte(name, index)
    if byte ~= 95 and not ascii_letter(byte) and
       not (byte >= 48 and byte <= 57) then
      return false
    end
  end
  return true
end

function parse_rename(params: value): (RenameParams?, Error?)
  local document?, document_error? = parse_document_position_or_error(params)
  if document == nil then return nil, document_error end
  local object? = wire.as_object(params)
  local name?, name_error? = required_string(object, "newName", "params")
  if name == nil then return nil, name_error end
  if not valid_identifier(name) then
    return invalid<|RenameParams|>(
      "params.newName must be a non-keyword Titan identifier")
  end
  return RenameParams.new(document, name), nil
end

function position_value(position: source_text.Position): wire.Object
  return {["line"] = position.line, ["character"] = position.character}
end

function range_value(span: source_text.Span): wire.Object
  return {["start"] = position_value(span.start), ["end"] = position_value(span.finish)}
end

function location_value(uri: string, span: source_text.Span): wire.Object
  return {["uri"] = uri, ["range"] = range_value(span)}
end

function text_edit_value(edit: TextEdit): wire.Object
  return {["range"] = range_value(edit.range), ["newText"] = edit.new_text}
end

-- Optional initialization members are capability advertisements rather than
-- required request parameters. Absent or malformed capabilities enable nothing.
function completion_options(params: value): CompletionOptions
  local snippets = false
  local label_details = false
  local insert_calls = true
  local object? = wire.as_object(params)
  if object ~= nil then
    local capabilities? = wire.as_object(object["capabilities"])
    if capabilities ~= nil then
      local document? = wire.as_object(capabilities["textDocument"])
      if document ~= nil then
        local completion? = wire.as_object(document["completion"])
        if completion ~= nil then
          local item? = wire.as_object(completion["completionItem"])
          if item ~= nil then
            snippets = wire.as_boolean(item["snippetSupport"]) == true
            label_details = wire.as_boolean(item["labelDetailsSupport"]) == true
          end
        end
      end
    end
    local options? = wire.as_object(object["initializationOptions"])
    if options ~= nil and options["insertCallSnippets"] ~= nil then
      insert_calls = wire.as_boolean(options["insertCallSnippets"]) == true
    end
  end
  return CompletionOptions.new(snippets, label_details, insert_calls)
end

--- Options advertised for textDocument/diagnostic pulls.
-- Reports answer from the completed saved generation, so they declare exact
-- inter-file dependencies without promising workspace-wide enumeration.
function diagnostic_provider(): wire.Object
  return {
    ["interFileDependencies"] = true,
    ["workspaceDiagnostics"] = false,
  }
end

--- Read the client behaviors the server's advertisements depend on.
function client_capabilities(params: value): ClientCapabilities
  local progress = false
  local pull_disabled = false
  local object? = wire.as_object(params)
  if object ~= nil then
    local capabilities? = wire.as_object(object["capabilities"])
    if capabilities ~= nil then
      local window? = wire.as_object(capabilities["window"])
      if window ~= nil then
        progress = wire.as_boolean(window["workDoneProgress"]) == true
      end
    end
    local options? = wire.as_object(object["initializationOptions"])
    if options ~= nil and options["pullDiagnostics"] ~= nil then
      pull_disabled = wire.as_boolean(options["pullDiagnostics"]) == false
    end
  end
  return ClientCapabilities.new(progress, pull_disabled)
end

local function completion_long_string_delimiter(contents: string,
                                                cursor: integer): string?
  if strings.sub(contents, cursor, cursor) ~= "[" then return nil end
  local finish = cursor + 1
  while strings.sub(contents, finish, finish) == "=" do finish = finish + 1 end
  if strings.sub(contents, finish, finish) ~= "[" then return nil end
  return "]" .. strings.sub(contents, cursor + 1, finish - 1) .. "]"
end

-- Offsets are zero-based and finish is exclusive. Replace only the identifier
-- when its existing suffix already supplies call arguments or generic arguments.
-- Titan permits whitespace and comments between the name and those arguments.
function completion_call_snippet(contents: string, replace_finish: integer,
                                 snippet: string?): string?
  if snippet == nil then return nil end
  local cursor = replace_finish + 1
  while cursor <= #contents do
    local byte = strings.byte(contents, cursor)
    if byte == 9 or byte == 10 or byte == 11 or byte == 12 or
        byte == 13 or byte == 32 then
      cursor = cursor + 1
    elseif strings.sub(contents, cursor, cursor + 1) == "--" then
      local delimiter? = completion_long_string_delimiter(contents, cursor + 2)
      if delimiter ~= nil then
        local closing? = strings.find(contents, delimiter, cursor + 2 + #delimiter)
        if closing == nil then return nil end
        cursor = closing + #delimiter
      else
        local finish? = strings.find(contents, "\n", cursor + 2)
        if finish == nil then break end
        cursor = finish + 1
      end
    else
      break
    end
  end
  local suffix = strings.sub(contents, cursor, cursor + 1)
  local first = strings.sub(suffix, 1, 1)
  if first == "(" or first == "{" or first == "\"" or first == "'" or
      suffix == "<|" or completion_long_string_delimiter(contents, cursor) ~= nil then return nil end
  return snippet
end

function completion_list_value(list: CompletionList,
                                options: CompletionOptions?): wire.Object
  local items: wire.Array = {}
  for index = 1, #list.items do
    local item = list.items[index]
    local edit = item.edit
    local insert_format = 1
    if options ~= nil and options.snippet_support and
        options.insert_call_snippets and item.call_snippet ~= nil then
      edit = TextEdit.new(item.edit.range, item.call_snippet)
      insert_format = 2
    end
    local encoded: wire.Object = {
      ["label"] = item.label,
      ["kind"] = item.kind,
      ["detail"] = item.detail,
      ["sortText"] = item.sort_text,
      ["filterText"] = item.filter_text,
      ["insertTextFormat"] = insert_format,
      ["textEdit"] = text_edit_value(edit),
    }
    if item.documentation ~= nil then
      local markup: wire.Object = {["kind"] = "markdown", ["value"] = item.documentation}
      encoded["documentation"] = markup
    end
    if options ~= nil and options.label_details_support and
        strings.sub(item.detail, 1, #item.label) == item.label and
        #item.detail > #item.label then
      local suffix = strings.sub(item.detail, #item.label + 1)
      local first = strings.sub(suffix, 1, 1)
      if first == "(" or strings.sub(suffix, 1, 2) == "<|" then
        local details: wire.Object = {["detail"] = suffix}
        encoded["labelDetails"] = details
      end
    end
    items[index] = encoded
  end
  return {["isIncomplete"] = list.is_incomplete, ["items"] = items}
end

function workspace_edit_value(documents: {DocumentEdits}): wire.Object
  local changes: wire.Object = {}
  for index = 1, #documents do
    local document = documents[index]
    local edits: wire.Array = {}
    for edit_index = 1, #document.edits do
      edits[edit_index] = text_edit_value(document.edits[edit_index])
    end
    changes[document.uri] = edits
  end
  return {["changes"] = changes}
end

function hover_value(markdown: string, span: source_text.Span?): wire.Object
  local contents: wire.Object = {["kind"] = "markdown", ["value"] = markdown}
  local result: wire.Object = {
    ["contents"] = contents,
  }
  if span ~= nil then
    result["range"] = range_value(span)
  end
  return result
end

function folding_range_value(range: FoldingRange): wire.Object
  local result: wire.Object = {
    ["startLine"] = range.start_line,
    ["endLine"] = range.end_line,
  }
  if range.start_character ~= nil then
    result["startCharacter"] = range.start_character
  end
  if range.end_character ~= nil then
    result["endCharacter"] = range.end_character
  end
  if range.kind ~= nil then
    result["kind"] = range.kind
  end
  return result
end
