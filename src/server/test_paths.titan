foreign import "compiler_io_platform.h"
local fs = import "fs"
local source_text = import "server.source_text"

-- Explicit lexical fixture roots. These fake locations are never created.
-- Keep the established Unix bytes while giving Windows fully qualified roots.
function sdk_binary_root(): string
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then return "C:/sdk/lib/titan/0.6" end
  return "/sdk/lib/titan/0.6"
end

function workspace_root(): string
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then return "C:/workspace" end
  return "/workspace"
end

function elsewhere_root(): string
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then return "C:/elsewhere" end
  return "/elsewhere"
end

-- URI prefixes are explicit fixture values, so decoding assertions do not
-- obtain their expected encodings from the implementation under test.
function workspace_uri(): string
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then return "file:///C:/workspace" end
  return "file:///workspace"
end

function elsewhere_uri(): string
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then return "file:///C:/elsewhere" end
  return "file:///elsewhere"
end

function outside_project_file(): string
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then return "C:/outside/project.titan" end
  return "/outside/project.titan"
end

function compiler_source_root(): string
  if ffi.VSCODE_TITAN_WINDOWS ~= 0 then return "C:/compiler/source" end
  return "/compiler/source"
end

local function native_path(path: string): string
  if ffi.VSCODE_TITAN_WINDOWS == 0 then return path end
  local normalized?, failure? = source_text.normalize_absolute_path(path)
  if normalized == nil then raise failure end
  return normalized
end

-- Service configuration and watcher output use normalized path spellings.
-- Select that spelling before fixture paths enter assertions or fake analysis.
function temporary_name(): string
  return native_path(fs.tmpname())
end

function canonical_path(path: string): string
  return native_path(fs.realpath(path))
end
