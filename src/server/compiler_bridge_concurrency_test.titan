local async = import "async"
local fs = import "fs"
local lua = import "lua"
local strings = import "string"
local test = import "test"
local timer = import "timer"
foreign import "utime.h"
local bridge = import "server.compiler_bridge.titan"
local compiler_scheduler = import "server.compiler_scheduler"
local test_runtime = import "server.test_runtime"

local DRIVER_MODULE = "titan-compiler.driver"
local SHARED_MODULE = "bridge_concurrency_shared"
local PROJECT_A = "bridge_concurrency_project_a"

local function temporary_root(): string
  local root = fs.tmpname()
  fs.unlink(root)
  fs.mkdir(root)
  return root
end

local function assert_external_provider(analysis: bridge.Analysis,
                                        expected_file: string,
                                        subject: string)
  test.assert(#analysis.diagnostics == 0,
              subject .. " produced compiler diagnostics")
  local found? = analysis:find_module(SHARED_MODULE)
  test.assert(found ~= nil, subject .. " omitted the external module")
  local snapshot: bridge.ModuleSnapshot = found
  case snapshot.provenance
  when external_source{main_file, source_files} then
    test.assert(main_file == expected_file,
                subject .. " selected another Compiler's source provider")
    test.assert(#source_files == 1 and
                source_files[1] == expected_file,
                subject .. " retained another Compiler's source closure")
  else
    test.assert(false, subject .. " did not resolve an external source provider")
  end
end

local function source_file_of(result: {bridge.ExternalResolution},
                              module_name: string): string
  if #result ~= 1 or result[1].module_name ~= module_name or
     result[1].error ~= nil or result[1].provenance == nil then
    raise "unexpected external resolution for " .. module_name
  end
  case result[1].provenance as bridge.Provenance
  when external_source{main_file} then return main_file
  else raise "external resolution did not select source"
  end
end

local function join_nil(task: async.Task<|nil, value|>, subject: string)
  case async.join<|nil, value|>(task)
  when succeeded() then
  when failed(failure) then
    raise subject .. " failed: " .. strings.tostring(failure.error)
  when cancelled() then raise subject .. " was cancelled"
  else raise subject .. " did not finish"
  end
end

local function join_analysis(task: async.Task<|bridge.Analysis, value|>,
                             subject: string): bridge.Analysis
  case async.join<|bridge.Analysis, value|>(task)
  when succeeded(analysis) then return analysis
  when failed(failure) then
    raise subject .. " failed: " .. strings.tostring(failure.error)
  when cancelled() then raise subject .. " was cancelled"
  else raise subject .. " did not finish"
  end
end

local type RestoreDriverResolver = function (): ()
local type ObserveDriverHandoff = function (): (integer, boolean)
local type ObserveDriverRestoration = function (): boolean
local type InstallDriverHandoffObserver =
  function ({string: value}):
    (RestoreDriverResolver, ObserveDriverHandoff,
     ObserveDriverRestoration)

local function install_driver_handoff_observer(
    driver: {string: value}):
    (RestoreDriverResolver, ObserveDriverHandoff,
     ObserveDriverRestoration)
  local install = lua.load([==[
return function(driver)
  local original_resolver = driver.resolve_external_modules
  local original_cppflags = driver.EXTRA_CPPFLAGS
  local calls = 0
  local configured_at_handoff = false
  driver.resolve_external_modules = function(...)
    calls = calls + 1
    local required, forbidden = false, false
    for _, flag in ipairs(driver.EXTRA_CPPFLAGS or {}) do
      if flag == "-DBRIDGE_CONCURRENCY_CPPFLAGS_B=1" then required = true end
      if flag == "-DBRIDGE_CONCURRENCY_CPPFLAGS_A=1" then forbidden = true end
    end
    configured_at_handoff = required and not forbidden
    return original_resolver(...)
  end
  return function()
    driver.resolve_external_modules = original_resolver
  end, function()
    return calls, configured_at_handoff
  end, function()
    return driver.EXTRA_CPPFLAGS == original_cppflags
  end
end
]==], "=compiler_bridge_cppflags_handoff_observer", nil)() as
    InstallDriverHandoffObserver
  return install(driver)
end

local function cppflags_include_without(
    driver: {string: value}, required: string,
    forbidden: string): boolean
  local raw: value = driver["EXTRA_CPPFLAGS"]
  if not (raw is {integer: value}) then return false end
  local flags = raw as {integer: value}
  local found = false
  for index = 1, #flags do
    local flag: value = flags[index]
    if flag is string then
      if flag == forbidden then return false end
      if flag == required then found = true end
    end
  end
  return found
end

local CPPFLAGS_MODULE_A = "bridge_concurrency_cppflags_a"
local CPPFLAGS_MODULE_B = "bridge_concurrency_cppflags_b"
local CPPFLAGS_A = "-DBRIDGE_CONCURRENCY_CPPFLAGS_A=1"
local CPPFLAGS_B = "-DBRIDGE_CONCURRENCY_CPPFLAGS_B=1"

local function isolates_cppflags_across_yielding_analysis()
  local root = temporary_root()
  local header_a = root .. "/bridge_concurrency_cppflags_a.h"
  local header_b = root .. "/bridge_concurrency_cppflags_b.h"
  fs.write_file(header_a, [[
#ifndef BRIDGE_CONCURRENCY_CPPFLAGS_A
#error Compiler A preprocessing flag is missing
#endif
#ifdef BRIDGE_CONCURRENCY_CPPFLAGS_B
#error Compiler B preprocessing flag leaked into Compiler A
#endif
typedef int bridge_concurrency_cppflags_a_int;
]])
  fs.write_file(header_b, [[
#ifndef BRIDGE_CONCURRENCY_CPPFLAGS_B
#error Compiler B preprocessing flag is missing
#endif
#ifdef BRIDGE_CONCURRENCY_CPPFLAGS_A
#error Compiler A preprocessing flag leaked into Compiler B
#endif
typedef int bridge_concurrency_cppflags_b_int;
]])
  defer do
    do fs.unlink(header_a) catch end
    do fs.unlink(header_b) catch end
    do fs.rmdir(root) catch end
  end

  local project_a = bridge.ProjectModule.new(CPPFLAGS_MODULE_A, {
    bridge.SourceFile.new(
      root .. "/" .. CPPFLAGS_MODULE_A .. ".titan",
      "foreign import \"" .. header_a .. "\"\n" ..
      "function answer(): integer return 41 end\n")
  })
  local project_b = bridge.ProjectModule.new(CPPFLAGS_MODULE_B, {
    bridge.SourceFile.new(
      root .. "/" .. CPPFLAGS_MODULE_B .. ".titan",
      "foreign import \"" .. header_b .. "\"\n" ..
      "function answer(): integer return 42 end\n")
  })
  local compiler_a = bridge.load()
  compiler_a:configure(bridge.CompilerConfiguration.new { cppflags = CPPFLAGS_A })
  local compiler_b = bridge.load()
  compiler_b:configure(bridge.CompilerConfiguration.new { cppflags = CPPFLAGS_B })
  local driver = lua.require(DRIVER_MODULE) as {string: value}
  local restore_resolver, observe_handoff, observe_restoration =
    install_driver_handoff_observer(driver)
  defer restore_resolver()

  local a_finished = false
  local a_checkpoint = false
  local a_checkpoint_flags = false
  local b_started_before_a_finished = false
  local b_started_with_a_flags = false
  local b_handoff_restored = false
  local b_checkpoint = false
  local b_checkpoint_flags = false
  local b_restored_after_analysis = false
  local b_task: async.Task<|bridge.Analysis, value|>? = nil

  local a_task = async.run<|bridge.Analysis, value|>(
    function (): bridge.Analysis
      defer a_finished = true
      return compiler_a:analyze_incremental(
        {project_a}, {CPPFLAGS_MODULE_A}, {},
        function (progress: bridge.AnalysisProgress)
          if progress.completed_files == progress.total_files and
             not a_checkpoint then
            a_checkpoint = true
            a_checkpoint_flags = cppflags_include_without(
              driver, CPPFLAGS_A, CPPFLAGS_B)
            b_task = async.run<|bridge.Analysis, value|>(
              function (): bridge.Analysis
                b_started_before_a_finished = not a_finished
                b_started_with_a_flags = cppflags_include_without(
                  driver, CPPFLAGS_A, CPPFLAGS_B)
                local empty = compiler_b:resolve_external_modules({}, {})
                local handoff_calls, configured = observe_handoff()
                b_handoff_restored = #empty == 0 and
                  handoff_calls == 1 and configured and observe_restoration()
                local analysis = compiler_b:analyze_incremental(
                  {project_b}, {CPPFLAGS_MODULE_B}, {},
                  function (b_progress: bridge.AnalysisProgress)
                    if b_progress.completed_files ==
                         b_progress.total_files and not b_checkpoint then
                      b_checkpoint = true
                      b_checkpoint_flags = cppflags_include_without(
                        driver, CPPFLAGS_B, CPPFLAGS_A)
                    end
                  end)
                b_restored_after_analysis = observe_restoration()
                return analysis
              end)
          end
        end)
    end)

  local analysis_a = join_analysis(a_task, "Compiler A cppflags analysis")
  test.assert(#analysis_a.diagnostics == 0 and
              analysis_a:find_module(CPPFLAGS_MODULE_A) ~= nil,
              "Compiler A rejected its isolated preprocessing flags")
  test.assert(b_task ~= nil,
              "Compiler A did not yield at its published-module checkpoint")
  local analysis_b = join_analysis(
    b_task as async.Task<|bridge.Analysis, value|>,
    "Compiler B cppflags analysis")
  test.assert(#analysis_b.diagnostics == 0 and
              analysis_b:find_module(CPPFLAGS_MODULE_B) ~= nil,
              "Compiler B rejected its isolated preprocessing flags")
  test.assert(a_checkpoint and a_checkpoint_flags and
              b_started_before_a_finished and b_started_with_a_flags,
              "Compiler B did not queue while yielding Compiler A owned " ..
              "its preprocessing flags")
  test.assert(b_handoff_restored,
              "resolver used another compiler's flags or failed to restore the driver")
  test.assert(b_checkpoint and b_checkpoint_flags,
              "Compiler B inherited Compiler A preprocessing flags")
  test.assert(b_restored_after_analysis and observe_restoration(),
              "Compiler B did not restore driver.EXTRA_CPPFLAGS")
end

function test_compiler_bridge_isolates_cppflags_across_yielding_analysis(
    _context: test.Context)
  test_runtime.run(isolates_cppflags_across_yielding_analysis)
end

function test_compiler_bridge_load_waits_for_inherited_driver_configuration(
    _context: test.Context)
  test_runtime.run(function ()
    local inherited_root = temporary_root()
    defer fs.rmdir(inherited_root)
    local source = inherited_root .. "/load_default.titan"
    fs.write_file(source, "function answer(): integer return 42 end\n")
    defer fs.unlink(source)
    local initial = bridge.load()
    local driver = initial.driver
    local previous_source: value = driver["TITAN_SOURCE_PATH"]
    local previous_binary: value = driver["TITAN_BIN_PATH"]
    local previous_flags: value = driver["EXTRA_CPPFLAGS"]
    defer do
      driver["TITAN_SOURCE_PATH"] = previous_source
      driver["TITAN_BIN_PATH"] = previous_binary
      driver["EXTRA_CPPFLAGS"] = previous_flags
    end
    driver["TITAN_SOURCE_PATH"] = inherited_root
    driver["TITAN_BIN_PATH"] = ""
    local inherited_flags: {integer: value} = {[1] = "-DLOAD_BASELINE=1"}
    driver["EXTRA_CPPFLAGS"] = inherited_flags
    local first = bridge.load()
    first:configure(bridge.CompilerConfiguration.new {
      source_roots = {"/other-workspace"}, cppflags = "-DOTHER_WORKSPACE=1",
    })
    local loading: async.Task<|bridge.Compiler, value|>?
    defer do
      if loading ~= nil then
        if not loading:status():has_finished() then loading:cancel() end
        async.join(loading)
      end
    end
    do
      local permit = compiler_scheduler.acquire()
      defer permit:release()
      local previous = first:install_configuration()
      defer previous:apply()
      loading = async.run<|bridge.Compiler, value|>(function (): bridge.Compiler
        return bridge.load()
      end)
      while loading:status():as_string() == "ready" do timer.yield() end
      test.assert(loading:status():as_string() == "waiting",
                  "compiler load captured another workspace's active configuration")
    end
    local second: bridge.Compiler?
    case async.join(loading)
    when succeeded(compiler) then second = compiler
    when failed(failure) then raise failure.error
    else raise "compiler load did not finish"
    end
    local resolution = second:resolve_external_modules({}, {
      bridge.ExternalResolutionRequest.new("load_default", true),
    })
    test.assert(#resolution == 1 and resolution[1].provenance ~= nil,
                "new compiler inherited another workspace's source roots")
    case resolution[1].provenance
    when external_source{main_file} then
      test.assert(main_file == source,
                  "new compiler resolved against the temporary workspace roots")
    else raise "new compiler did not resolve its inherited source provider"
    end
    local permit = compiler_scheduler.acquire()
    defer permit:release()
    local previous = second:install_configuration()
    defer previous:apply()
    local flags = driver["EXTRA_CPPFLAGS"] as {integer: string}
    test.assert(#flags == 1 and flags[1] == "-DLOAD_BASELINE=1",
                "new compiler inherited another workspace's preprocessing flags")
  end)
end

local function serializes_real_compilers_across_cancellation()
  local root_a = temporary_root()
  defer fs.rmdir(root_a)
  local provider_a = root_a .. "/" .. SHARED_MODULE .. ".titan"
  fs.write_file(provider_a,
    "function identity(): string return \"from-a\" end\n")
  defer fs.unlink(provider_a)

  local root_b = temporary_root()
  defer fs.rmdir(root_b)
  local provider_b = root_b .. "/" .. SHARED_MODULE .. ".titan"
  fs.write_file(provider_b,
    "function identity(): integer return 42 end\n")
  defer fs.unlink(provider_b)

  local project_a = bridge.ProjectModule.new(PROJECT_A, {
    bridge.SourceFile.new(
      "/workspace/" .. PROJECT_A .. ".titan",
      "local shared = import \"" .. SHARED_MODULE .. ".titan\"\n" ..
      "function identity(): string return shared.identity() end\n")
  })

  local compiler_a = bridge.load()
  compiler_a:configure(bridge.CompilerConfiguration.new { source_roots = {root_a}, binary_root = "", include_roots = {} })
  local compiler_b = bridge.load()
  compiler_b:configure(bridge.CompilerConfiguration.new { source_roots = {root_b}, binary_root = "", include_roots = {} })
  local driver = lua.require(DRIVER_MODULE) as {string: value}

  local a_started = false
  local a_task = async.run<|bridge.Analysis, value|>(function (): bridge.Analysis
    a_started = true
    return compiler_a:analyze(PROJECT_A, {project_a})
  end)

  while not a_started do async.yield() end
  -- The compiler yields at async filesystem operations before external
  -- resolution. Wait for the semantic state this test needs instead of
  -- assuming that the first cooperative yield has already published it.
  local active_provider?: string = nil
  while active_provider == nil do
    local active_imported: value = driver["imported"]
    if active_imported is {string: value} then
      local raw_external: value =
        (active_imported as {string: value})[SHARED_MODULE]
      if raw_external is {string: value} then
        local raw_filename: value =
          (raw_external as {string: value})["filename"]
        if raw_filename is string then active_provider = raw_filename end
      end
    end
    if active_provider == nil then
      if a_task:status():has_finished() then
        case async.join<|bridge.Analysis, value|>(a_task)
        when succeeded(analysis) then
          local messages = strings.writer()
          for index = 1, #analysis.diagnostics do
            messages:write("\n" .. analysis.diagnostics[index].message)
          end
          raise "Compiler A finished before publishing its external provider" ..
                messages:drain()
        when failed(failure) then
          raise "Compiler A failed before publishing its external provider: " ..
                strings.tostring(failure.error)
        when cancelled() then
          raise "Compiler A was cancelled before the test requested it"
        else
          raise "finished Compiler A analysis had a nonterminal status"
        end
      end
      async.yield()
    end
  end
  test.assert(a_task:status():as_string() == "waiting",
              "Compiler A did not cooperatively yield after publication")

  local active_path: string = driver["TITAN_SOURCE_PATH"]
  test.assert(active_path == root_a,
              "Compiler A did not retain its configured source root")
  test.assert((active_provider as string) == provider_a,
              "Compiler A entered the wrong external source root")

  local b_started = false
  local b_saw_a_status = "not-started"
  local b_saw_source_path = ""
  local b_saw_provider = ""
  local a_status_after_b_resolution = "not-resolved"
  local b_provider?: string = nil
  local b_task = async.run<|nil, value|>(function (): nil
    b_started = true
    b_saw_a_status = a_task:status():as_string()
    b_saw_source_path = driver["TITAN_SOURCE_PATH"]
    local before_imported: value = driver["imported"]
    if before_imported is {string: value} then
      local before_external: value =
        (before_imported as {string: value})[SHARED_MODULE]
      if before_external is {string: value} then
        b_saw_provider =
          (before_external as {string: value})["filename"]
      end
    end
    a_task:cancel(async.CancellationReason.simple(
      "cancel Compiler A while it owns the shared compiler permit"))
    b_provider = source_file_of(
      compiler_b:resolve_external_modules({}, {
        bridge.ExternalResolutionRequest.new(SHARED_MODULE, true),
      }), SHARED_MODULE)
    a_status_after_b_resolution = a_task:status():as_string()
    return nil
  end)

  join_nil(b_task, "Compiler B")
  test.assert(b_started and b_saw_a_status == "waiting" and
              b_saw_source_path == root_a and
              b_saw_provider == provider_a,
              "Compiler B did not start while Compiler A held root-A " ..
              "compiler state (A=" .. b_saw_a_status ..
              ", path=" .. b_saw_source_path ..
              ", provider=" .. b_saw_provider .. ")")
  test.assert(a_status_after_b_resolution == "cancelled",
              "Compiler B entered shared compiler state before Compiler A " ..
              "released it (A after B=" .. a_status_after_b_resolution .. ")")
  test.assert(b_provider == provider_b,
              "Compiler B resolved another Compiler's source provider")

  local a_terminal = async.join<|bridge.Analysis, value|>(a_task)
  test.assert(a_terminal:as_string() == "cancelled",
              "Compiler A did not finish with cancellation")

  local retry_a = compiler_a:analyze(PROJECT_A, {project_a})
  assert_external_provider(retry_a, provider_a, "Compiler A retry")
end

function test_compiler_bridge_serializes_real_compilers_across_cancellation(
    _context: test.Context)
  test_runtime.run(serializes_real_compilers_across_cancellation)
end

local CLEANUP_MODULE = "bridge_concurrency_ffi_cleanup"

local type RestoreProbeProvider = function (): ()
local type ObserveProbeWorkspace = function (): string?
local type InstallProbeWorkspaceObserver =
  function ({string: value}): (RestoreProbeProvider, ObserveProbeWorkspace)

local function tmp_entries(): {string: boolean}
  local result: {string: boolean} = {}
  local entries = fs.list(fs.tmpdir())
  for index = 1, #entries do result[entries[index]] = true end
  return result
end

local function install_probe_workspace_observer(
    driver: {string: value}):
    (RestoreProbeProvider, ObserveProbeWorkspace)
  local install = lua.load([==[
return function(driver)
  local original = driver.get_probe_service
  local workspace_root
  driver.get_probe_service = function(context)
    local service, service_error = original(context)
    if service and not workspace_root then
      local workspace, workspace_error = service:_ensure_workspace()
      assert(workspace, workspace_error)
      workspace_root = workspace.root
    end
    return service, service_error
  end
  return function()
    driver.get_probe_service = original
  end, function()
    return workspace_root
  end
end
]==], "=compiler_bridge_probe_workspace_observer", nil)() as
    InstallProbeWorkspaceObserver
  return install(driver)
end

local function cancels_ffi_analysis_and_transfers_cleanup()
  local root = temporary_root()
  local ffi_header = root .. "/bridge_concurrency_cleanup.h"
  fs.write_file(ffi_header,
    "typedef int bridge_concurrency_cleanup_int;\n" ..
    "typedef struct bridge_cleanup_source { int value; } " ..
    "bridge_cleanup_source;\n" ..
    "typedef struct bridge_cleanup_target { int value; } " ..
    "bridge_cleanup_target;\n")
  defer do
    do fs.unlink(ffi_header) catch end
    do fs.rmdir(root) catch end
  end

  local project = bridge.ProjectModule.new(CLEANUP_MODULE, {
    bridge.SourceFile.new(
      root .. "/" .. CLEANUP_MODULE .. ".titan",
      "foreign import \"bridge_concurrency_cleanup.h\"\n" ..
      "local function probe_pointer(pointer: foreign *bridge_cleanup_source): " ..
      "foreign *bridge_cleanup_target\n" ..
      "  return pointer\n" ..
      "end\n" ..
      "foreign function identity(input: bridge_concurrency_cleanup_int): " ..
      "bridge_concurrency_cleanup_int\n" ..
      "  return input\n" ..
      "end\n")
  })
  local before = tmp_entries()
  local compiler = bridge.load()
  local driver = lua.require(DRIVER_MODULE) as {string: value}
  local restore_probe_provider, observe_probe_workspace =
    install_probe_workspace_observer(driver)
  defer restore_probe_provider()

  local started = false
  local analysis_task = async.run<|bridge.Analysis, value|>(
    function (): bridge.Analysis
      started = true
      return compiler:analyze(CLEANUP_MODULE, {project})
    end)
  defer do
    if not analysis_task:status():has_finished() then
      analysis_task:cancel(async.CancellationReason.simple("FFI cleanup test stopped"))
    end
    async.join(analysis_task)
  end
  while not started do async.yield() end

  -- Analysis retains the generated C include environment and probe workspace,
  -- but does not generate a foreign function body header. The driver publishes
  -- the include filename immediately before its post-module strategy yield.
  -- The absolute source filename avoids an intervening path lookup, so this
  -- observation pins cancellation to the completed module's exact checkpoint.
  local checking_ffi_header?: string = nil
  while checking_ffi_header == nil do
    local raw_imported: value = driver["imported"]
    if raw_imported is {string: value} then
      local raw_module: value =
        (raw_imported as {string: value})[CLEANUP_MODULE]
      if raw_module is {string: value} then
        local raw_header: value =
          (raw_module as {string: value})["checking_foreign_header"]
        test.assert(raw_header == nil,
          "analysis generated a foreign function body header")
        local raw_ffi_header: value =
          (raw_module as {string: value})["checking_ffi_header"]
        if raw_ffi_header is string then checking_ffi_header = raw_ffi_header end
      end
    end
    if checking_ffi_header == nil then
      if analysis_task:status():has_finished() then
        case async.join<|bridge.Analysis, value|>(analysis_task)
        when succeeded(analysis) then
          local messages = strings.writer()
          for index = 1, #analysis.diagnostics do
            messages:write("\n" .. analysis.diagnostics[index].message)
          end
          raise "FFI analysis finished before its post-module yield" ..
                messages:drain()
        when failed(failure) then
          raise "FFI analysis failed before its post-module yield: " ..
                strings.tostring(failure.error)
        when cancelled() then
          raise "FFI analysis was cancelled before the test requested it"
        else
          raise "finished FFI analysis had a nonterminal status"
        end
      end
      async.yield()
    end
  end
  test.assert(analysis_task:status():as_string() == "waiting",
              "FFI analysis was not waiting at its post-module yield")
  test.assert(checking_ffi_header ~= nil and
              fs.lstat(checking_ffi_header as string) ~= nil,
              "module C environment header was absent before cancellation")

  local workspace? = observe_probe_workspace()
  test.assert(workspace ~= nil,
              "real FFI analysis did not create a private probe workspace")
  local workspace_path = workspace as string
  local prefix = fs.tmpdir() .. "/titan-fs-"
  test.assert(strings.sub(workspace_path, 1, #prefix) == prefix and
              not before[strings.sub(workspace_path, #fs.tmpdir() + 2)] and
              fs.lstat(workspace_path) ~= nil,
              "FFI analysis did not retain its newly created titan-fs workspace")
  local workspaces: {string} = {workspace_path}

  analysis_task:cancel(async.CancellationReason.simple(
    "cancel FFI analysis at its post-module yield"))
  local terminal = async.join<|bridge.Analysis, value|>(analysis_task)
  test.assert(terminal:as_string() == "cancelled",
              "FFI analysis did not finish with cancellation")

  -- Context close is retried by an uncancelled Task after the cancelled owner
  -- releases the compiler permit. Wait for that transferred cleanup rather
  -- than deleting either resource from this test Task.
  local cleaned = false
  local attempts = 0
  while not cleaned and attempts < 10000 do
    cleaned = fs.lstat(checking_ffi_header as string) == nil
    for index = 1, #workspaces do
      if fs.lstat(workspaces[index]) ~= nil then cleaned = false end
    end
    if not cleaned then timer.sleep(1) end
    attempts = attempts + 1
  end
  test.assert(cleaned,
              "transferred cancellation cleanup leaked a generated header " ..
              "or private probe workspace")
end

function test_compiler_bridge_cancellation_transfers_real_ffi_cleanup(
    _context: test.Context)
  test_runtime.run(cancels_ffi_analysis_and_transfers_cleanup)
end

-- The compiler I/O strategy planned for the bridge is a plain Lua object in
-- titanc and a Lua-visible Titan record in the language server. Keep this
-- focused regression at that exact boundary: ordinary Lua receives the record
-- userdata, calls its Titan method, and remains suspended while the method
-- yields through the Task runtime and performs Titan filesystem I/O.
record LuaProxyIoStrategy
  path: string
  phase: integer
  observed_while_yielded: boolean
end

function LuaProxyIoStrategy:read_after_yield(): string
  self.phase = 1
  while not self.observed_while_yielded do async.yield() end
  local contents = fs.read_file(self.path)
  self.phase = 2
  return contents
end

local function lua_proxy_resumes_titan_async_method()
  local path = fs.tmpname()
  defer fs.unlink(path)
  fs.write_file(path, "read through Titan async fs")

  local strategy = LuaProxyIoStrategy.new(path, 0, false)
  local observer = async.run<|nil, value|>(function (): nil
    test.assert(strategy.phase == 1,
                "Lua did not remain inside the yielding Titan method")
    strategy.observed_while_yielded = true
    return nil
  end)
  local invoke = lua.load([==[
return function(strategy)
  assert(type(strategy) == "userdata",
         "Titan record did not cross to Lua as its userdata proxy")
  assert(strategy.phase == 0, "Lua received the wrong initial record state")
  local contents = strategy:read_after_yield()
  assert(strategy.phase == 2, "Titan method did not resume before returning")
  return contents
end
]==], "=compiler_bridge_io_strategy_proxy", nil)() as
    function (LuaProxyIoStrategy): string

  local contents = invoke(strategy)
  test.assert(contents == "read through Titan async fs",
              "Lua/Titan proxy call lost the async filesystem result")
  test.assert(observer:status():has_succeeded(),
              "observer did not run while the Lua-to-Titan call was yielded")
end

function test_compiler_bridge_lua_proxy_can_call_yielding_titan_io_strategy(
    _context: test.Context)
  test_runtime.run(lua_proxy_resumes_titan_async_method)
end

local function large_hover_summary_normalization_yields()
  local count = 4096
  local pending: {bridge.PendingSummaryLine} = {}
  for index = 1, count do
    local name = strings.format("member_%05d", count - index + 1)
    pending[index] = bridge.PendingSummaryLine.new(
      0, name, "line " .. name)
  end

  local started = false
  local finished = false
  local normalized: {string} = {}
  local normalization = async.run<|nil, value|>(function (): nil
    started = true
    defer finished = true
    normalized = bridge.summary_lines(
      pending, bridge.NormalizationWork.new(0))
    return nil
  end)

  local observer_turns = 0
  local observer = async.run<|nil, value|>(function (): nil
    while not started do async.yield() end
    while not finished do
      observer_turns = observer_turns + 1
      async.yield()
    end
    return nil
  end)

  join_nil(normalization, "large hover-summary normalization")
  join_nil(observer, "hover-summary normalization observer")
  test.assert(observer_turns >= 10,
              "large hover-summary normalization starved another Task")
  test.assert(#normalized == count and
              normalized[1] == "line member_00001" and
              normalized[count] == "line member_04096",
              "yielding hover-summary normalization changed sort output")
end

function test_compiler_bridge_yields_during_large_hover_summary_normalization(
    _context: test.Context)
  test_runtime.run(large_hover_summary_normalization_yields)
end

local function large_diagnostic_normalization_yields()
  local module_count = 512
  local diagnostic_count = 4096
  local projects: {string: bridge.ProjectModule} = {}
  local entries: {string: value} = {}
  for index = 1, module_count do
    local name = strings.format("module_%05d", index)
    local filename = "/workspace/" .. name .. ".titan"
    projects[name] = bridge.ProjectModule.new(name, {
      bridge.SourceFile.new(filename, "-- fixture\n"),
    })
    entries[name] = true
  end
  local raw: {integer: value} = {}
  for index = 1, diagnostic_count do
    local owner = (index - 1) % module_count + 1
    raw[index] = strings.format(
      "/workspace/module_%05d.titan:1:1: type error: broken", owner)
  end

  local started = false
  local finished = false
  local phase = 0
  local diagnostics: {bridge.Diagnostic} = {}
  local failed: {string: boolean} = {}
  local names: {string} = {}
  local normalization = async.run<|nil, value|>(function (): nil
    started = true
    defer finished = true
    local work = bridge.NormalizationWork.new(0)
    phase = 1
    local normalized = bridge.normalize_diagnostics(raw, work)
    phase = 2
    bridge.append_diagnostics(diagnostics, normalized, work)
    phase = 3
    failed = bridge.failed_projects(
      "module_00001", diagnostics, projects, {}, false, work)
    phase = 4
    names = bridge.sorted_entry_names(entries, work)
    return nil
  end)

  local observer_turns = 0
  local phase_turns: {integer} = {0, 0, 0, 0}
  local observer = async.run<|nil, value|>(function (): nil
    while not started do async.yield() end
    while not finished do
      observer_turns = observer_turns + 1
      if phase >= 1 and phase <= 4 then
        phase_turns[phase] = phase_turns[phase] + 1
      end
      async.yield()
    end
    return nil
  end)
  join_nil(normalization, "large diagnostic normalization")
  join_nil(observer, "diagnostic normalization observer")

  test.assert(observer_turns >= 10,
              "large diagnostic normalization starved another Task")
  test.assert(phase_turns[1] > 0 and phase_turns[2] > 0 and
              phase_turns[3] > 0 and phase_turns[4] > 0,
              "a diagnostic normalization phase did not yield cooperatively")
  test.assert(#diagnostics == diagnostic_count and
              failed["module_00001"] and
              failed["module_00512"],
              "diagnostic ownership indexing changed failed modules")
  test.assert(#names == module_count and
              names[1] == "module_00001" and
              names[module_count] == "module_00512",
              "cooperative entry-name merge sort changed ordering")
end

function test_compiler_bridge_yields_during_large_diagnostic_normalization(
    _context: test.Context)
  test_runtime.run(large_diagnostic_normalization_yields)
end

local type PayloadHookCounts = function (): (integer,integer,integer,integer)
local type PayloadCheckpointBarrier = function (string?): ()
local type InstallPayloadHooks = function ({string: value}):
  (function (): (),PayloadHookCounts,PayloadCheckpointBarrier)

local function observe_payload_hooks(driver: {string: value}):
    (function (): (),PayloadHookCounts,PayloadCheckpointBarrier)
  local install = lua.load([==[
return function(driver)
  local names = {"encode_project_entry", "decode_project_entry",
                 "project_entries_registry", "compact_project_entry"}
  local original, counts = {}, {0, 0, 0, 0}
  local blocked
  for index, name in ipairs(names) do
    original[index] = driver[name]
    driver[name] = function(input, options)
      assert(type(options.yield) == "function", name .. " omitted cooperative work hook")
      local yield = options.yield
      local observed = {}
      for key, item in pairs(options) do observed[key] = item end
      observed.yield = function()
        counts[index] = counts[index] + 1
        if blocked == name then
          -- Hold the actual compiler checkpoint until the observer cancels.
          -- A compact registry may offer only its final cooperative turn;
          -- polling cannot assume that the observer runs before it resumes.
          repeat yield() until blocked ~= name
        else
          yield()
        end
      end
      return original[index](input, observed)
    end
  end
  return function()
    for index, name in ipairs(names) do driver[name] = original[index] end
  end, function() return counts[1], counts[2], counts[3], counts[4] end,
  function(phase)
    local phases = {decode = names[2], registry = names[3]}
    assert(phase == nil or phases[phase], "unknown payload checkpoint phase")
    blocked = phase and phases[phase]
  end
end
]==],"=project_payload_hook_observer",nil)() as InstallPayloadHooks
  return install(driver)
end

local function cancel_project_restore_at_checkpoint(
    projects: {bridge.ProjectModule}, payloads: {bridge.ProjectPayload},
    counts: PayloadHookCounts, barrier: PayloadCheckpointBarrier, phase: string)
  local driver = lua.require(DRIVER_MODULE) as {string: value}
  local types = lua.require("titan-compiler.types") as {string: value}
  local previous_registry: value = types["registry"]
  local previous_imported: value = driver["imported"]
  local previous_source_path: value = driver["TITAN_SOURCE_PATH"]
  local previous_binary_path: value = driver["TITAN_BIN_PATH"]
  local previous_cppflags: value = driver["EXTRA_CPPFLAGS"]
  local _encode, previous_decode, previous_assembly, _compact = counts()
  barrier(phase)
  defer barrier(nil)
  local compiler = bridge.load()
  local task = async.run<|{string},value|>(function (): {string}
    return compiler:restore_projects(projects,payloads)
  end)
  defer do
    if not task:status():has_finished() then
      task:cancel(async.CancellationReason.simple("payload cancellation test cleanup"))
    end
    async.join(task)
  end
  local observed = false
  while not task:status():has_finished() do
    test.assert(types["registry"] == previous_registry and
      driver["imported"] == previous_imported and
      driver["TITAN_SOURCE_PATH"] == previous_source_path and
      driver["TITAN_BIN_PATH"] == previous_binary_path and
      driver["EXTRA_CPPFLAGS"] == previous_cppflags,
      "manifest restoration replaced compiler globals while yielding")
    local _encoded, decoding, assembly, _compacted = counts()
    if (phase == "decode" and decoding > previous_decode) or
       (phase == "registry" and assembly > previous_assembly) then
      observed = true
      task:cancel(async.CancellationReason.simple("cancel payload " .. phase))
      break
    end
    async.yield()
  end
  local cancellation = false
  case async.join(task)
  when cancelled() then cancellation = true
  when failed(failure) then raise failure.error
  else
  end
  local _encoded, final_decode, final_assembly, _compacted = counts()
  test.assert(observed and cancellation,
    "large payload " .. phase .. " offered no cancellable scheduler turn" ..
    "; observed=" .. strings.tostring(observed) ..
    "; terminal=" .. task:status():as_string() ..
    "; decode=" .. (final_decode - previous_decode) ..
    "; registry=" .. (final_assembly - previous_assembly))
  barrier(nil)
  test.assert(types["registry"] == previous_registry and
    driver["imported"] == previous_imported and
    driver["TITAN_SOURCE_PATH"] == previous_source_path and
    driver["TITAN_BIN_PATH"] == previous_binary_path and
    driver["EXTRA_CPPFLAGS"] == previous_cppflags and
    not compiler:has_project_entry(projects[1].module_name),
    "cancelled " .. phase .. " changed compiler globals or installed partial declarations")
  local recovered = bridge.load():restore_projects(projects,payloads)
  test.assert(#recovered == 1 and recovered[1] == projects[1].module_name,
    "cancelled " .. phase .. " did not release the compiler permit for a later restoration")
end

local function large_project_payload_restoration_yields_and_cleans_up()
  local source = strings.writer()
  for index = 1, 384 do
    source:write("record Item_" .. index .. "\n" ..
      "  amount: integer\n  other: integer\nend\n" ..
      "function item_" .. index .. "(item: Item_" .. index .. "): integer\n" ..
      "  local answer = item.amount + " .. index .. "\n  return answer\nend\n")
  end
  local name = "large_restoration"
  local projects = {bridge.ProjectModule.new(name,{
    bridge.SourceFile.new("/workspace/large_restoration.titan",source:drain())})}
  local compiler = bridge.load()
  local driver = lua.require(DRIVER_MODULE) as {string: value}
  local restore_hooks, counts, barrier = observe_payload_hooks(driver)
  defer restore_hooks()
  local analysis = compiler:analyze(name,projects)
  test.assert(#analysis.diagnostics == 0,"large restoration fixture failed analysis")
  local payloads = compiler:export_projects(projects,{name})
  test.assert(#payloads == 1,"large single project payload was not exported")
  local encode_yields, _decode_yields, _registry_yields, compact_yields = counts()
  test.assert(encode_yields > 1,"single project encoding did not yield repeatedly")
  test.assert(compact_yields > 1,"declared-interface compaction did not yield repeatedly")
  local restored = bridge.load()
  local reads = 0
  local rejected = restored:restore_project_cache(projects,{name},
    function (requested: string): (string?,{bridge.CHeaderDependency}?)
      test.assert(requested == name,"restoration read an unselected payload")
      reads = reads + 1
      return payloads[1].payload,nil
    end,
    function (_name: string): boolean
      return false
    end)
  local _encoded, decode_yields, _registry_yields, _compacted = counts()
  test.assert(reads == 1 and #rejected == 0 and not restored:has_project_entry(name),
    "rejected revision installed compiler state or duplicated its BLOB read")
  test.assert(decode_yields > 1,
    "single project decoding did not yield repeatedly")

  cancel_project_restore_at_checkpoint(projects,payloads,counts,barrier,"decode")
  cancel_project_restore_at_checkpoint(projects,payloads,counts,barrier,"registry")
end

function test_compiler_bridge_large_payload_restoration_yields_and_cleans_up(
    _context: test.Context)
  test_runtime.run(large_project_payload_restoration_yields_and_cleans_up)
end

local type HeaderReadCounts = function (): (integer,integer)
local type InstallHeaderReadObserver = function ({string: value}): (function (): (),HeaderReadCounts)

local function observe_header_reads(driver: {string: value}): (function (): (),HeaderReadCounts)
  local install = lua.load([==[
return function(driver)
  local original = driver.new_resolver_context
  local strategy
  driver.new_resolver_context = function(options)
    strategy = options.io
    return original(options)
  end
  return function() driver.new_resolver_context = original end,
    function()
      local headers = driver.compiler_cache_stats({context={io=strategy}}).headers
      return headers.file_reads, headers.file_hashes
    end
end
]==],"=live_project_header_read_observer",nil)() as InstallHeaderReadObserver
  return install(driver)
end

local function live_header_touch_uses_current_analysis_baselines()
  local root = temporary_root()
  local header = root .. "/live_observed.h"
  fs.write_file(header,"typedef long live_observed_word;\n")
  defer do fs.unlink(header); fs.rmdir(root) end
  local times = foreign utimbuf.new()
  times.actime = 1700000000
  times.modtime = 1700000000
  test.assert(ffi.utime(header,times) == 0,"cannot set initial header timestamp")
  local provider = bridge.ProjectModule.new("live_observed_provider",{
    bridge.SourceFile.new(root .. "/live_observed_provider.titan",
      "foreign import \"" .. header .. "\"\n" ..
      "local function cast(item: integer): foreign live_observed_word return item end\n")})
  local consumer_source: function (integer): string = function (amount: integer): string
    return "local provider = import \"live_observed_provider.titan\"\n" ..
      "function answer(): integer return provider.cast(" .. amount .. ") end\n"
  end
  local consumer = bridge.ProjectModule.new("live_observed_consumer",{
    bridge.SourceFile.new(root .. "/live_observed_consumer.titan",consumer_source(41))})
  local compiler = bridge.load()
  local driver = lua.require(DRIVER_MODULE) as {string: value}
  local restore, counts = observe_header_reads(driver)
  defer restore()
  local initial = compiler:analyze("live_observed_consumer",{provider,consumer})
  if #initial.diagnostics > 0 then
    raise "live observed header fixture failed analysis: " .. initial.diagnostics[1].message
  end
  local inputs: {bridge.CHeaderDependency} = {}
  local seen: {string: boolean} = {}
  for module_index = 1, #initial.modules do
    local dependencies = initial.modules[module_index].c_header_dependencies
    for index = 1, #dependencies do
      local input = dependencies[index]
      local kind = "file"
      case input.kind
      when file() then
      when search() then kind = "search"
      end
      local key = kind .. "\0" .. input.path
      if not seen[key] then seen[key] = true; inputs[#inputs + 1] = input end
    end
  end
  times.modtime = 1700000001
  test.assert(ffi.utime(header,times) == 0,"cannot touch live header")
  local current, changed = compiler:restat_c_header_dependencies(inputs)
  test.assert(not changed,"same-content header touch changed semantic identity")
  local before_reads,before_hashes = counts()
  local edited = bridge.ProjectModule.new("live_observed_consumer",{
    bridge.SourceFile.new(root .. "/live_observed_consumer.titan",consumer_source(42))})
  local result = compiler:analyze_incremental({provider,edited},
    {"live_observed_consumer"},{},nil,current)
  test.assert(#result.diagnostics == 0 and
    result:find_module("live_observed_provider") == nil,
    "same-content header touch invalidated the retained source-private provider")
  local after_reads,after_hashes = counts()
  test.assert(after_reads == before_reads and after_hashes == before_hashes,
    "live importer edit reread or rehashed a header already validated after its touch")
end

function test_compiler_bridge_live_header_touch_uses_current_analysis_baselines(
    _context: test.Context)
  test_runtime.run(live_header_touch_uses_current_analysis_baselines)
end
