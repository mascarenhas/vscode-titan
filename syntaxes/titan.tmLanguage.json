{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Titan",
  "scopeName": "source.titan",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#bindings"
    },
    {
      "include": "#type-arguments"
    },
    {
      "include": "#brace-expressions"
    },
    {
      "include": "#foreign-types"
    },
    {
      "include": "#qualified-members"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.titan",
          "begin": "--\\[(=*)\\[",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.titan"
            }
          },
          "end": "\\]\\1\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.titan"
            }
          }
        },
        {
          "name": "comment.line.double-dash.titan",
          "begin": "--",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.titan"
            }
          },
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.other.long.titan",
          "begin": "\\[(=*)\\[",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.titan"
            }
          },
          "end": "\\]\\1\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.titan"
            }
          }
        },
        {
          "name": "string.quoted.double.titan",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.titan"
            }
          },
          "end": "\"|(?=$)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.titan"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.titan",
              "begin": "\\\\z[ \\t]*(?=$)",
              "while": "^[ \\t]*$"
            },
            {
              "name": "constant.character.escape.titan",
              "begin": "\\\\(?=$)",
              "while": "(?!)"
            },
            {
              "name": "constant.character.escape.titan",
              "match": "\\\\(?:[abfnrtv\\\\'\"]|[0-9]{1,3}|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|z\\s*)"
            },
            {
              "name": "invalid.illegal.escape.titan",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.titan",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.titan"
            }
          },
          "end": "'|(?=$)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.titan"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.titan",
              "begin": "\\\\z[ \\t]*(?=$)",
              "while": "^[ \\t]*$"
            },
            {
              "name": "constant.character.escape.titan",
              "begin": "\\\\(?=$)",
              "while": "(?!)"
            },
            {
              "name": "constant.character.escape.titan",
              "match": "\\\\(?:[abfnrtv\\\\'\"]|[0-9]{1,3}|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|z\\s*)"
            },
            {
              "name": "invalid.illegal.escape.titan",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "begin": "\\b(union)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "storage.type.declaration.titan" },
            "3": { "name": "entity.name.type.titan" }
          },
          "end": "\\bend\\b",
          "endCaptures": {
            "0": { "name": "keyword.control.titan" }
          },
          "applyEndPatternLast": true,
          "patterns": [
            { "include": "#comments" },
            { "include": "#type-groups" },
            {
              "begin": "\\b(?:(local)(\\s+))?([A-Za-z_][A-Za-z0-9_]*)(\\s*)(\\()",
              "beginCaptures": {
                "1": { "name": "storage.modifier.titan" },
                "3": { "name": "entity.name.tag.titan" },
                "5": { "name": "punctuation.section.group.begin.titan" }
              },
              "end": "\\)",
              "endCaptures": {
                "0": { "name": "punctuation.section.group.end.titan" }
              },
              "patterns": [
                { "include": "#comments" },
                {
                  "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*:)",
                  "name": "variable.parameter.titan"
                },
                { "include": "#type-content" }
              ]
            },
            { "include": "#operators" },
            { "include": "#punctuation" }
          ]
        },
        {
          "match": "\\b(function)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(?:([.:])([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": {
              "name": "storage.type.function.titan"
            },
            "3": {
              "name": "entity.name.function.titan"
            },
            "4": {
              "name": "punctuation.accessor.titan"
            },
            "5": {
              "name": "entity.name.function.method.titan"
            }
          }
        },
        {
          "match": "\\b(record|union|interface|type)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.declaration.titan"
            },
            "3": {
              "name": "entity.name.type.titan"
            }
          }
        }
      ]
    },
    "qualified-members": {
      "patterns": [
        {
          "match": "(\\.)(\\s*)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.titan"
            },
            "3": {
              "name": "variable.other.member.titan"
            }
          }
        }
      ]
    },
    "bindings": {
      "patterns": [
        {
          "match": "\\b(local|const)(\\s+)(?:(const)(\\s+))?([A-Za-z_][A-Za-z0-9_]*)(?=\\??\\s*[:=,])",
          "captures": {
            "1": { "name": "storage.modifier.titan" },
            "3": { "name": "storage.modifier.titan" },
            "5": { "name": "variable.other.readwrite.titan" }
          }
        },
        {
          "begin": "\\b(when)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(\\s*)(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.titan" },
            "3": { "name": "entity.name.tag.titan" },
            "5": { "name": "punctuation.section.group.begin.titan" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.group.end.titan" }
          },
          "patterns": [
            { "include": "#comments" },
            {
              "begin": "=",
              "beginCaptures": {
                "0": { "name": "keyword.operator.titan" }
              },
              "end": "[A-Za-z_][A-Za-z0-9_]*",
              "endCaptures": {
                "0": { "name": "variable.other.member.titan" }
              },
              "patterns": [{ "include": "#comments" }]
            },
            {
              "match": "[A-Za-z_][A-Za-z0-9_]*",
              "name": "variable.other.readwrite.titan"
            },
            { "include": "#punctuation" }
          ]
        },
        {
          "begin": "\\b(when)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(\\s*)(\\()",
          "beginCaptures": {
            "1": { "name": "keyword.control.titan" },
            "3": { "name": "entity.name.tag.titan" },
            "5": { "name": "punctuation.section.group.begin.titan" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.section.group.end.titan" }
          },
          "patterns": [
            { "include": "#comments" },
            {
              "match": "[A-Za-z_][A-Za-z0-9_]*",
              "name": "variable.other.readwrite.titan"
            },
            { "include": "#punctuation" }
          ]
        }
      ]
    },
    "foreign-types": {
      "patterns": [
        {
          "match": "\\b(foreign)(\\s+)(?!import\\b|type\\b|function\\b)((?:const\\s+)?(?:\\*\\s*)*)([A-Za-z_][A-Za-z0-9_]*(?:\\s+(?:char|short|int|long|double))*)",
          "captures": {
            "1": { "name": "storage.modifier.titan" },
            "3": { "name": "storage.modifier.titan" },
            "4": { "name": "entity.name.type.titan" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "invalid.illegal.reserved.titan",
          "match": "\\bfinally\\b"
        },
        {
          "name": "keyword.operator.logical.titan",
          "match": "\\b(?:and|not|or)\\b"
        },
        {
          "name": "keyword.operator.type.titan",
          "match": "\\b(?:as|is)\\b"
        },
        {
          "name": "constant.language.titan",
          "match": "\\b(?:false|nil|true)\\b"
        },
        {
          "name": "storage.type.primitive.titan",
          "match": "\\b(?:boolean|float|integer|string|value)\\b"
        },
        {
          "name": "storage.type.function.titan",
          "match": "\\bfunction\\b"
        },
        {
          "name": "storage.type.declaration.titan",
          "match": "\\b(?:interface|record|type|union)\\b"
        },
        {
          "name": "storage.modifier.titan",
          "match": "\\b(?:const|foreign|local|owned)\\b"
        },
        {
          "name": "keyword.control.import.titan",
          "match": "\\bimport\\b"
        },
        {
          "name": "keyword.control.titan",
          "match": "\\b(?:break|case|catch|defer|do|else|elseif|end|for|goto|if|in|raise|repeat|return|then|until|when|while)\\b"
        },
        {
          "name": "variable.language.ffi.titan",
          "match": "\\bffi\\b"
        },
        {
          "name": "variable.language.self.titan",
          "match": "\\bself\\b"
        },
        {
          "name": "variable.language.module.titan",
          "match": "\\bM\\b"
        },
        {
          "name": "variable.language.lua-state.titan",
          "match": "\\bL\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.titan",
          "match": "(?<![A-Za-z0-9_])(?:0[xX](?:[0-9A-Fa-f]+(?:\\.[0-9A-Fa-f]*)?|\\.[0-9A-Fa-f]+)(?:[pP][+-]?[0-9]+)?|(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?)(?![A-Za-z0-9_.])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "punctuation.definition.typeparameters.begin.titan",
          "match": "<\\|"
        },
        {
          "name": "punctuation.definition.typeparameters.end.titan",
          "match": "\\|>"
        },
        {
          "name": "invalid.illegal.operator.titan",
          "match": "->"
        },
        {
          "name": "keyword.operator.titan",
          "match": "(?:\\.\\.\\.|\\.\\.|//|<<|>>|==|~=|<=|>=|[+\\-*/%^#&~|<>=?])"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.titan",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.section.group.begin.titan",
          "match": "[({\\[]"
        },
        {
          "name": "punctuation.section.group.end.titan",
          "match": "[)}\\]]"
        },
        {
          "name": "punctuation.accessor.titan",
          "match": "\\."
        }
      ]
    },
    "type-content": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#type-groups" },
        { "include": "#foreign-types" },
        { "include": "#qualified-members" },
        { "include": "#keywords" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },
    "type-groups": {
      "patterns": [
        {
          "begin": "\\(",
          "beginCaptures": {
            "0": { "name": "punctuation.section.group.begin.titan" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.section.group.end.titan" }
          },
          "patterns": [
            { "include": "#type-content" }
          ]
        },
        {
          "begin": "\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.section.group.begin.titan" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.group.end.titan" }
          },
          "patterns": [
            { "include": "#type-content" }
          ]
        },
        { "include": "#type-arguments" }
      ]
    },
    "brace-expressions": {
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.group.begin.titan" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.group.end.titan" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*=(?!=))",
          "name": "variable.other.member.titan"
        },
        {
          "comment": "An unkeyed function starts an array value or a function type, not a named-field list. Keep its contents in ordinary scopes until the enclosing brace.",
          "begin": "\\bfunction\\b",
          "beginCaptures": {
            "0": { "name": "storage.type.function.titan" }
          },
          "end": "(?=\\})",
          "patterns": [
            { "include": "$self" }
          ]
        },
        {
          "begin": "=(?!=)",
          "beginCaptures": {
            "0": { "name": "keyword.operator.titan" }
          },
          "end": "(?=[,;}])",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#expression-members" },
            { "include": "#local-bindings" },
            { "include": "#for-bindings" },
            { "include": "#function-type-annotations" },
            { "include": "#expression-groups" },
            { "include": "#expression-blocks" },
            { "include": "$self" }
          ]
        },
        { "include": "$self" }
      ]
    },
    "expression-groups": {
      "patterns": [
        {
          "begin": "\\(",
          "beginCaptures": {
            "0": { "name": "punctuation.section.group.begin.titan" }
          },
          "end": "(\\))(?:(\\s*)(:)(\\s*)(function|if|case|do|end|for|local|const)\\b)?",
          "endCaptures": {
            "1": { "name": "punctuation.section.group.end.titan" },
            "3": { "name": "punctuation.accessor.titan" },
            "5": { "name": "variable.other.member.titan" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#expression-members" },
            { "include": "#local-bindings" },
            { "include": "#for-bindings" },
            { "include": "#function-type-annotations" },
            { "include": "#expression-groups" },
            { "include": "#expression-blocks" },
            { "include": "$self" }
          ]
        },
        {
          "begin": "\\[",
          "beginCaptures": {
            "0": { "name": "punctuation.section.group.begin.titan" }
          },
          "end": "(\\])(?:(\\s*)(:)(\\s*)(function|if|case|do|end|for|local|const)\\b)?",
          "endCaptures": {
            "1": { "name": "punctuation.section.group.end.titan" },
            "3": { "name": "punctuation.accessor.titan" },
            "5": { "name": "variable.other.member.titan" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#expression-members" },
            { "include": "#local-bindings" },
            { "include": "#for-bindings" },
            { "include": "#function-type-annotations" },
            { "include": "#expression-groups" },
            { "include": "#expression-blocks" },
            { "include": "$self" }
          ]
        }
      ]
    },
    "expression-blocks": {
      "patterns": [
        {
          "begin": "\\b(function)(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "beginCaptures": {
            "1": { "name": "storage.type.function.titan" },
            "2": { "name": "entity.name.function.titan" }
          },
          "end": "\\bend\\b",
          "endCaptures": {
            "0": { "name": "keyword.control.titan" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#expression-members" },
            { "include": "#local-bindings" },
            { "include": "#for-bindings" },
            { "include": "#function-type-annotations" },
            {
              "begin": "\\G(?=\\s*(?:\\(|--|$))",
              "end": "(?<=\\))",
              "patterns": [
                { "include": "#type-content" }
              ]
            },
            { "include": "#expression-groups" },
            { "include": "#expression-blocks" },
            { "include": "$self" }
          ]
        },
        {
          "begin": "\\b(?:if|case|do)\\b",
          "beginCaptures": {
            "0": { "name": "keyword.control.titan" }
          },
          "end": "\\bend\\b",
          "endCaptures": {
            "0": { "name": "keyword.control.titan" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#expression-members" },
            { "include": "#local-bindings" },
            { "include": "#for-bindings" },
            { "include": "#function-type-annotations" },
            { "include": "#expression-groups" },
            { "include": "#expression-blocks" },
            { "include": "$self" }
          ]
        }
      ]
    },
    "function-type-annotations": {
      "begin": "(?:(:)|(\\b(?:as|is)\\b))(\\s*)(function)\\b",
      "beginCaptures": {
        "1": { "name": "punctuation.separator.titan" },
        "2": { "name": "keyword.operator.type.titan" },
        "4": { "name": "storage.type.function.titan" }
      },
      "end": "(?=[,;=}\\)\\]]|\\b(?:end|return|local|const|if|elseif|else|then|while|for|case|catch|defer|raise|break|do|repeat|until)\\b)",
      "patterns": [
        { "include": "#type-content" }
      ]
    },
    "expression-members": {
      "match": "(\\.|\\b)([A-Za-z_][A-Za-z0-9_]*)(\\s*)(:)(\\s*)(function|if|case|do|end|for|local|const)\\b",
      "captures": {
        "1": { "name": "punctuation.accessor.titan" },
        "2": {
          "patterns": [
            { "include": "#keywords" }
          ]
        },
        "4": { "name": "punctuation.accessor.titan" },
        "6": { "name": "variable.other.member.titan" }
      },
      "comment": "Protect contextual selectors that would otherwise open or close a block; do not reinterpret typed bindings as method access."
    },
    "type-arguments": {
      "begin": "<\\|",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.typeparameters.begin.titan" }
      },
      "end": "\\|>",
      "endCaptures": {
        "0": { "name": "punctuation.definition.typeparameters.end.titan" }
      },
      "patterns": [
        { "include": "#type-content" }
      ]
    },
    "for-bindings": {
      "begin": "\\bfor\\b",
      "beginCaptures": {
        "0": { "name": "keyword.control.titan" }
      },
      "end": "(?==|\\bin\\b)",
      "patterns": [
        { "include": "#type-content" }
      ]
    },
    "local-bindings": {
      "begin": "\\b(local|const)(\\s+)(?!function\\b)(?:(const)(\\s+))?([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.titan" },
        "3": { "name": "storage.modifier.titan" },
        "5": { "name": "variable.other.readwrite.titan" }
      },
      "end": "(?==|;|$|\\b(?:return|local|if|while|for|case|do|repeat|raise|defer|break|catch|end)\\b)",
      "patterns": [
        { "include": "#type-content" }
      ]
    }
  }
}
